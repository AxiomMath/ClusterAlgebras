module

public import ClusterAlgebras.LaurentPhenomenon.LaurentSharper

/-!
# Euler's factorisation of the fifth Fermat number

Euler found in 1732 that the fifth Fermat number `F₅ = 2³² + 1` is divisible by `641`. This file
derives that divisibility from the Laurent phenomenon, following FWZ.

Let `Σ = (X̃, B̃_F)` be the labeled seed of `ℚ(X₁, X₂, X₃)` formed by the indeterminates and the
Fermat matrix `B̃_F`, with rows `(0, 4)`, `(-1, 0)` and `(1, -3)`; `X₃` is frozen. Specialise
`(X₁, X₂, X₃)` to `(3, -1, 16)`, that is, let `φ : ℤ[X̃^{±1}] → ℚ` be a ring homomorphism with
these values. By the sharp Laurent phenomenon every cluster variable lies in
`ℤ[X₁^{±1}, X₂^{±1}, X₃]`, so its value has a power of `3` as denominator. Applied to
`μ₁(Σ)`, whose extended cluster `(x'₁, X₂, X₃)` takes the values `(5, -1, 16)`, the same argument
shows the denominator to be a power of `5`; so every cluster variable takes an integer value.
On the other hand, mutating along `(1, 2, 1, 2)` and following the exchange relations under `φ`
produces the value `-(2³² + 1) / 641`.

## Main definitions

* `ClusterAlgebras.fermatMatrix`: the Fermat matrix `B̃_F`.

## Main results

* `ClusterAlgebras.fermat_map_seedMutationSeq_eq_intCast`: every entry of the extended cluster of
  `μ_s(Σ)` takes an integer value under `φ`.
* `ClusterAlgebras.fermat_map_seedMutationSeq_eq`: the entry in position `2` of the extended
  cluster of `μ_{(1,2,1,2)}(Σ)` takes the value `-(2³² + 1) / 641`.
* `ClusterAlgebras.fermat_euler`: `(2³² + 1) / 641` is an integer.

## Implementation notes

FWZ index the extended cluster by `[1, 3]` and the directions by `[1, 2]`; here they
are indexed by `Fin 3` and `Fin 2`, so FWZ's index `i` is index `i - 1`. Thus `X₃` is the
entry `2`, the mutation sequence `(1, 2, 1, 2)` is `[0, 1, 0, 1]`, and the entry in position `2`
is the entry `1`.

The entries of `μ_s(Σ)` are elements of the field `ℚ(X₁, X₂, X₃)`, and `φ` is defined on the
subring `ℤ[X̃^{±1}]`; each entry is fed to `φ` together with the proof, given by the Laurent
phenomenon, that it lies there.

The step from `μ₁(Σ)` back to `Σ` is the following: an element `z` of the subring generated by a
set `G` and `(x'₁)⁻¹` has `(x'₁)^N z` in the subring generated by `G` and `x'₁`. With `G`
consisting of `X₂, X₃, X₂⁻¹` and `x'₁`, this subring lies in `ℤ[X̃^{±1}]` and `φ` sends it to
`ℤ`, so `5^N φ(z) ∈ ℤ`. The same step, with `X₁` in place of `x'₁`, gives `3^N φ(z) ∈ ℤ`.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras.
  Chapters 1–3*][FWZ16]
-/
@[expose] public section

namespace ClusterAlgebras

section Closure

variable {R : Type*} [CommRing R]

/-- **Clearing a denominator in a subring closure.** If `u * v = 1`, then every element `z` of
the subring generated by `v` and a set `s` becomes, after multiplication by a suitable power of
`u`, an element of the subring generated by `u` and `s`. -/
theorem exists_pow_mul_mem_closure_insert_of_mul_eq_one {u v : R} (huv : u * v = 1)
    {s : Set R} {z : R} (hz : z ∈ Subring.closure (insert v s)) :
    ∃ N : ℕ, u ^ N * z ∈ Subring.closure (insert u s) := by
  induction hz using Subring.closure_induction with
  | mem x hx =>
    rcases hx with rfl | hx
    · exact ⟨1, by rw [pow_one, huv]; exact one_mem _⟩
    · exact ⟨0, by
        rw [pow_zero, one_mul]
        exact Subring.subset_closure (Set.mem_insert_of_mem _ hx)⟩
  | zero => exact ⟨0, by simp⟩
  | one => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨N, hN⟩ := hx
    obtain ⟨M, hM⟩ := hy
    have hu : u ∈ Subring.closure (insert u s) := Subring.subset_closure (Set.mem_insert _ _)
    refine ⟨N + M, ?_⟩
    have : u ^ (N + M) * (x + y) = u ^ M * (u ^ N * x) + u ^ N * (u ^ M * y) := by ring
    rw [this]
    exact add_mem (mul_mem (pow_mem hu _) hN) (mul_mem (pow_mem hu _) hM)
  | neg x _ hx =>
    obtain ⟨N, hN⟩ := hx
    exact ⟨N, by rw [mul_neg]; exact neg_mem hN⟩
  | mul x y _ _ hx hy =>
    obtain ⟨N, hN⟩ := hx
    obtain ⟨M, hM⟩ := hy
    refine ⟨N + M, ?_⟩
    have : u ^ (N + M) * (x * y) = (u ^ N * x) * (u ^ M * y) := by ring
    rw [this]
    exact mul_mem hN hM

end Closure

section Map

/-- A ring homomorphism `φ` out of a subring `L` sends every element of `L` lying in the subring
generated by a set `G ⊆ L` into a subring `P`, as soon as it sends the elements of `G` into
`P`. -/
theorem map_mem_of_mem_closure {R A : Type*} [Ring R] [Ring A] {L : Subring R} (φ : L →+* A)
    {P : Subring A} {G : Set R} (hG : ∀ g ∈ G, ∃ hg : g ∈ L, φ ⟨g, hg⟩ ∈ P) {z : R}
    (hz : z ∈ Subring.closure G) (hzL : z ∈ L) : φ ⟨z, hzL⟩ ∈ P := by
  have hle : Subring.closure G ≤ (P.comap φ).map L.subtype := Subring.closure_le.2 fun g hg => by
    obtain ⟨hgL, h⟩ := hG g hg
    exact ⟨⟨g, hgL⟩, h, rfl⟩
  obtain ⟨w, hw, hwz⟩ := hle hz
  obtain rfl : w = ⟨z, hzL⟩ := Subtype.ext hwz
  exact hw

/-- **Bounded denominators under evaluation.** Let `φ` be a ring homomorphism from a subring `L`
of `F` to `ℚ`, and let `y : Fin m → F` be a tuple whose entries lie in `L` and take integer
values under `φ`, as do the inverses of the entries in the positions `i < n` other than `r`,
where `y r ≠ 0`. Then for every element `z` of `L` lying in the mixed ring
`ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]`, some power `φ(y_r)^N` times `φ(z)` is an integer. -/
theorem exists_pow_mul_eq_intCast_of_mem_mixedLaurentSubring {F : Type*} [Field F] {m n : ℕ}
    {L : Subring F} (φ : L →+* ℚ) {y : Fin m → F}
    (hy : ∀ i, ∃ h : y i ∈ L, ∃ a : ℤ, φ ⟨y i, h⟩ = a) {r : Fin m} (hyr : y r ∈ L) (hr : y r ≠ 0)
    (hinv : ∀ i : Fin m, (i : ℕ) < n → i ≠ r → ∃ h : (y i)⁻¹ ∈ L, ∃ a : ℤ, φ ⟨_, h⟩ = a)
    {z : F} (hz : z ∈ mixedLaurentSubring y n) (hzL : z ∈ L) :
    ∃ (N : ℕ) (a : ℤ), φ ⟨y r, hyr⟩ ^ N * φ ⟨z, hzL⟩ = a := by
  set G : Set F := Set.range y ∪ (fun i => (y i)⁻¹) '' {i | (i : ℕ) < n ∧ i ≠ r}
  have hzG : z ∈ Subring.closure (insert (y r)⁻¹ G) := by
    refine Subring.closure_mono ?_ hz
    rintro _ (⟨i, rfl⟩ | ⟨i, hi, rfl⟩)
    · exact Set.mem_insert_of_mem _ (Or.inl ⟨i, rfl⟩)
    · by_cases hir : i = r
      · rw [hir]
        exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Or.inr ⟨i, ⟨hi, hir⟩, rfl⟩)
  obtain ⟨N, hN⟩ := exists_pow_mul_mem_closure_insert_of_mul_eq_one (mul_inv_cancel₀ hr) hzG
  have hmem : y r ^ N * z ∈ L := mul_mem (pow_mem hyr N) hzL
  have h := map_mem_of_mem_closure φ (P := (Int.castRingHom ℚ).range) ?_ hN hmem
  · obtain ⟨a, ha⟩ := h
    refine ⟨N, a, ?_⟩
    rw [eq_intCast] at ha
    rw [← map_pow, ← map_mul]
    exact ha.symm
  rintro g (rfl | (⟨i, rfl⟩ | ⟨i, ⟨hi, hir⟩, rfl⟩))
  · obtain ⟨a, ha⟩ := (hy r).2
    exact ⟨hyr, a, by rw [eq_intCast, ← ha]⟩
  · obtain ⟨h, a, ha⟩ := hy i
    exact ⟨h, a, by rw [eq_intCast, ha]⟩
  · obtain ⟨h, a, ha⟩ := hinv i hi hir
    exact ⟨h, a, by rw [eq_intCast, ha]⟩

end Map

/-- A rational number `q` such that `p ^ N * q` and `p' ^ N' * q` are integers, for coprime
integers `p` and `p'`, is an integer. -/
theorem exists_eq_intCast_of_pow_mul_eq_intCast {p p' : ℤ} (hpp' : IsCoprime p p') {q : ℚ}
    {N N' : ℕ} {a a' : ℤ} (ha : (p : ℚ) ^ N * q = a) (ha' : (p' : ℚ) ^ N' * q = a') :
    ∃ b : ℤ, q = b := by
  wlog hp : p ≠ 0 generalizing p p' N N' a a'
  · have hp' : p' ≠ 0 := by
      rintro rfl
      exact not_isCoprime_zero_zero (not_not.1 hp ▸ hpp')
    exact this hpp'.symm ha' ha hp'
  have hdvd : p ^ N ∣ a * p' ^ N' := ⟨a', by
    have : ((a * p' ^ N' : ℤ) : ℚ) = ((p ^ N * a' : ℤ) : ℚ) := by
      push_cast
      rw [← ha, ← ha']
      ring
    exact_mod_cast this⟩
  obtain ⟨b, hb⟩ := (hpp'.pow (m := N) (n := N')).dvd_of_dvd_mul_right hdvd
  refine ⟨b, mul_left_cancel₀ (pow_ne_zero N (Int.cast_ne_zero.2 hp)) ?_⟩
  rw [ha, hb]
  push_cast
  ring

section Exchange

variable {K F A : Type*} [Field K] [Field F] [Algebra K F] [CharZero K] [CommRing A] {m n : ℕ}

/-- **The exchange relation under a ring homomorphism.** Let `S` be a labeled seed with extended
cluster `x̃`, let `φ : ℤ[x̃^{±1}] → A` be a ring homomorphism, and let `T = μ_s(S)`. The entries of
the extended clusters of `T` and of `μ_k(T) = μ_{s ++ [k]}(S)` lie in `ℤ[x̃^{±1}]` by the Laurent
phenomenon, and `φ` carries the exchange relation `x_k x'_k = M⁺ₖ + M⁻ₖ` of `T` in direction `k`
to `A`. -/
theorem IsLabeledSeed.map_seedMutationSeq_concat_mul (hmn : n ≤ m) {S : SeedData F m n}
    (hS : IsLabeledSeed K hmn S) (φ : laurentSubring S.extCluster →+* A) (s : List (Fin n))
    (k : Fin n) :
    φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring hmn (s ++ [k]) (Fin.castLE hmn k)⟩ *
        φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring hmn s (Fin.castLE hmn k)⟩ =
      ∏ i, φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring hmn s i⟩ ^
          ((ClusterAlgebras.seedMutationSeq hmn S s).extExchangeMatrix i k).toNat +
        ∏ i, φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring hmn s i⟩ ^
          (-(ClusterAlgebras.seedMutationSeq hmn S s).extExchangeMatrix i k).toNat := by
  have hx := hS.seedMutationSeq_extCluster_ne_zero hmn s (Fin.castLE hmn k)
  simp only [← map_mul, ← map_pow, ← map_prod, ← map_add]
  congr 1
  apply Subtype.ext
  simp only [Subring.coe_mul, seedMutationSeq_append, seedMutationSeq_cons,
    seedMutationSeq_nil, ClusterAlgebras.seedMutation, Function.update_self,
    div_mul_cancel₀ _ hx, exchangeMonomialPos_eq_prod, exchangeMonomialNeg_eq_prod]
  push_cast
  rfl

/-- Mutation in direction `k` does not change the entries of the extended cluster away from
position `k`, so neither does it change their images under a ring homomorphism out of
`ℤ[x̃^{±1}]`. -/
theorem IsLabeledSeed.map_seedMutationSeq_concat_of_ne (hmn : n ≤ m) {S : SeedData F m n}
    (hS : IsLabeledSeed K hmn S) (φ : laurentSubring S.extCluster →+* A) (s : List (Fin n))
    (k : Fin n) {i : Fin m} (hi : i ≠ Fin.castLE hmn k) :
    φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring hmn (s ++ [k]) i⟩ =
      φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring hmn s i⟩ := by
  congr 2
  simp only [seedMutationSeq_append, seedMutationSeq_cons, seedMutationSeq_nil,
    ClusterAlgebras.seedMutation, Function.update_of_ne hi]

end Exchange

/-- The **Fermat matrix** `B̃_F`: the `3 × 2` integer matrix with rows `(0, 4)`, `(-1, 0)` and
`(1, -3)`. -/
@[cluster_algebras "def_fermat_matrix"]
def fermatMatrix : Matrix (Fin 3) (Fin 2) ℤ :=
  !![0, 4; -1, 0; 1, -3]

/-- The Fermat matrix is extended skew-symmetrizable: its principal part has the
skew-symmetrizing vector `d = (1, 4)`. -/
theorem extSkewSymmetrizable_fermatMatrix : ExtSkewSymmetrizable (by decide) fermatMatrix :=
  ⟨![1, 4], by decide, by decide⟩

/-- The **Fermat seed** `Σ = (X̃, B̃_F)`, formed by the indeterminates of `ℚ(X₁, X₂, X₃)` and the
Fermat matrix, is a labeled seed over `ℚ`. -/
theorem isLabeledSeed_genericSeed_fermatMatrix :
    IsLabeledSeed ℚ (by decide) (genericSeed fermatMatrix) :=
  isLabeledSeed_genericSeed _ extSkewSymmetrizable_fermatMatrix

/-- The values under `φ` of the extended cluster `(x'₁, X₂, X₃)` of `μ₁(Σ)`, where
`x'₁ = (X₃ + X₂) / X₁`, are `(5, -1, 16)`. -/
theorem fermat_map_seedMutationSeq_singleton
    (φ : laurentSubring (genericSeed fermatMatrix).extCluster →+* ℚ)
    (h₀ : φ ⟨_, mem_laurentSubring _ 0⟩ = 3) (h₁ : φ ⟨_, mem_laurentSubring _ 1⟩ = -1)
    (h₂ : φ ⟨_, mem_laurentSubring _ 2⟩ = 16) (j : Fin 3) :
    φ ⟨_, isLabeledSeed_genericSeed_fermatMatrix.seedMutationSeq_extCluster_mem_laurentSubring
      _ [0] j⟩ = ![5, -1, 16] j := by
  have hS := isLabeledSeed_genericSeed_fermatMatrix
  obtain ⟨v, hv⟩ : ∃ v : List (Fin 2) → Fin 3 → ℚ,
      ∀ s i, φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring _ s i⟩ = v s i :=
    ⟨_, fun _ _ => rfl⟩
  have e := hS.map_seedMutationSeq_concat_mul _ φ [] 0
  have a₀ : v [] 0 = 3 := by rw [← hv]; exact h₀
  have a₁ : v [] 1 = -1 := by rw [← hv]; exact h₁
  have a₂ : v [] 2 = 16 := by rw [← hv]; exact h₂
  simp only [List.nil_append] at e
  simp only [hv] at e
  have hB : (genericSeed fermatMatrix).extExchangeMatrix = !![0, 4; -1, 0; 1, -3] := rfl
  simp [Fin.prod_univ_three, hB, a₀, a₁, a₂] at e
  have n₁ := hS.map_seedMutationSeq_concat_of_ne _ φ [] 0 (i := 1) (by decide)
  have n₂ := hS.map_seedMutationSeq_concat_of_ne _ φ [] 0 (i := 2) (by decide)
  simp only [List.nil_append, hv] at n₁ n₂
  rw [hv]
  fin_cases j
  · simp only [Fin.zero_eta, Matrix.cons_val_zero]
    linarith
  · simp [n₁, a₁]
  · simp [n₂, a₂]

/-- **The Fermat seed pattern produces `F₅ / 641`.** Let `φ : ℤ[X̃^{±1}] → ℚ` be a ring
homomorphism with `φ(X₁) = 3`, `φ(X₂) = -1` and `φ(X₃) = 16`. The entry `z` in position `2` of
the extended cluster of `μ_{(1,2,1,2)}(Σ)` satisfies `φ(z) = -(2³² + 1) / 641`. -/
@[cluster_algebras "lem_fermat_value"]
theorem fermat_map_seedMutationSeq_eq
    (φ : laurentSubring (genericSeed fermatMatrix).extCluster →+* ℚ)
    (h₀ : φ ⟨_, mem_laurentSubring _ 0⟩ = 3) (h₁ : φ ⟨_, mem_laurentSubring _ 1⟩ = -1)
    (h₂ : φ ⟨_, mem_laurentSubring _ 2⟩ = 16) :
    φ ⟨_, isLabeledSeed_genericSeed_fermatMatrix.seedMutationSeq_extCluster_mem_laurentSubring
      _ [0, 1, 0, 1] 1⟩ = -(2 ^ 32 + 1) / 641 := by
  have hS := isLabeledSeed_genericSeed_fermatMatrix
  have hval := fermat_map_seedMutationSeq_singleton φ h₀ h₁ h₂
  obtain ⟨v, hv⟩ : ∃ v : List (Fin 2) → Fin 3 → ℚ,
      ∀ s i, φ ⟨_, hS.seedMutationSeq_extCluster_mem_laurentSubring _ s i⟩ = v s i :=
    ⟨_, fun _ _ => rfl⟩
  simp only [hv] at hval ⊢
  have a₀ : v [0] 0 = 5 := hval 0
  have a₁ : v [0] 1 = -1 := hval 1
  have a₂ : v [0] 2 = 16 := hval 2
  have hB₁ : (seedMutationSeq (by decide) (genericSeed fermatMatrix) [0]).extExchangeMatrix =
      !![0, -4; 1, 0; -1, 1] := by
    change matrixMutation _ fermatMatrix 0 = _
    decide
  have hB₂ : (seedMutationSeq (by decide) (genericSeed fermatMatrix) [0, 1]).extExchangeMatrix =
      !![0, 4; -1, 0; 0, -1] := by
    change matrixMutation _ (matrixMutation _ fermatMatrix 0) 1 = _
    decide
  have hB₃ :
      (seedMutationSeq (by decide) (genericSeed fermatMatrix) [0, 1, 0]).extExchangeMatrix =
        !![0, -4; 1, 0; 0, -1] := by
    change matrixMutation _ (matrixMutation _ (matrixMutation _ fermatMatrix 0) 1) 0 = _
    decide
  -- `μ₂` at `B̃₁`: the new entry in position `2` is `(16 + 5⁴) / (-1) = -641`.
  have e₂ := hS.map_seedMutationSeq_concat_mul _ φ [0] 1
  have n₂₀ := hS.map_seedMutationSeq_concat_of_ne _ φ [0] 1 (i := 0) (by decide)
  simp only [List.cons_append, List.nil_append] at e₂ n₂₀
  simp only [hv] at e₂ n₂₀
  rw [hB₁] at e₂
  simp [Fin.prod_univ_three, a₀, a₁, a₂] at e₂
  have b₁ : v [0, 1] 1 = -641 := by linarith
  have b₀ : v [0, 1] 0 = 5 := n₂₀.trans a₀
  -- `μ₁` at `B̃₂`: the new entry in position `1` is `(1 + (-641)) / 5 = -128`.
  have e₃ := hS.map_seedMutationSeq_concat_mul _ φ [0, 1] 0
  have n₃₁ := hS.map_seedMutationSeq_concat_of_ne _ φ [0, 1] 0 (i := 1) (by decide)
  have n₃₂ := hS.map_seedMutationSeq_concat_of_ne _ φ [0, 1] 0 (i := 2) (by decide)
  have n₂₂ := hS.map_seedMutationSeq_concat_of_ne _ φ [0] 1 (i := 2) (by decide)
  simp only [List.cons_append, List.nil_append] at e₃ n₃₁ n₃₂ n₂₂
  simp only [hv] at e₃ n₃₁ n₃₂ n₂₂
  rw [hB₂] at e₃
  simp [Fin.prod_univ_three, b₀, b₁] at e₃
  have c₀ : v [0, 1, 0] 0 = -128 := by linarith
  have c₁ : v [0, 1, 0] 1 = -641 := n₃₁.trans b₁
  have c₂ : v [0, 1, 0] 2 = 16 := n₃₂.trans (n₂₂.trans a₂)
  -- `μ₂` at `B̃₃`: the new entry in position `2` is `(1 + (-128)⁴ · 16) / (-641)`.
  have e₄ := hS.map_seedMutationSeq_concat_mul _ φ [0, 1, 0] 1
  simp only [List.cons_append, List.nil_append] at e₄
  simp only [hv] at e₄
  rw [hB₃] at e₄
  simp [Fin.prod_univ_three, c₀, c₁, c₂] at e₄
  rw [eq_div_iff (by norm_num)]
  linarith

/-- **Cluster variables of the Fermat seed pattern take integer values.** Let
`φ : ℤ[X̃^{±1}] → ℚ` be a ring homomorphism with `φ(X₁) = 3`, `φ(X₂) = -1` and `φ(X₃) = 16`.
For every sequence `s` of directions, every entry `z` of the extended cluster of `μ_s(Σ)`, which
lies in `ℤ[X̃^{±1}]` by the Laurent phenomenon, has `φ(z) ∈ ℤ`. -/
@[cluster_algebras "lem_fermat_integral_values"]
theorem fermat_map_seedMutationSeq_eq_intCast
    (φ : laurentSubring (genericSeed fermatMatrix).extCluster →+* ℚ)
    (h₀ : φ ⟨_, mem_laurentSubring _ 0⟩ = 3) (h₁ : φ ⟨_, mem_laurentSubring _ 1⟩ = -1)
    (h₂ : φ ⟨_, mem_laurentSubring _ 2⟩ = 16) (s : List (Fin 2)) (i : Fin 3) :
    ∃ a : ℤ, φ ⟨_, isLabeledSeed_genericSeed_fermatMatrix
      |>.seedMutationSeq_extCluster_mem_laurentSubring _ s i⟩ = a := by
  have hS := isLabeledSeed_genericSeed_fermatMatrix
  have hzL := hS.seedMutationSeq_extCluster_mem_laurentSubring _ s i
  have hinv : φ ⟨_, inv_mem_laurentSubring _ 1⟩ = -1 := by
    have h : φ ⟨_, mem_laurentSubring _ 1⟩ * φ ⟨_, inv_mem_laurentSubring _ 1⟩ = 1 := by
      rw [← map_mul, ← map_one φ]
      exact congrArg φ (Subtype.ext (mul_inv_cancel₀ (hS.1.1.ne_zero 1)))
    rw [h₁] at h
    linarith
  -- The denominators of `φ(z)` are powers of `3`.
  obtain ⟨N, a, ha⟩ := exists_pow_mul_eq_intCast_of_mem_mixedLaurentSubring φ (r := 0)
    (fun j => ⟨mem_laurentSubring _ j, by
      fin_cases j
      exacts [⟨3, by push_cast; exact h₀⟩, ⟨-1, by push_cast; exact h₁⟩,
        ⟨16, by push_cast; exact h₂⟩]⟩)
    (mem_laurentSubring _ 0) (hS.1.1.ne_zero 0)
    (fun j hj hj0 => ⟨inv_mem_laurentSubring _ j, by
      obtain rfl : j = 1 := by omega
      exact ⟨-1, by push_cast; exact hinv⟩⟩)
    (hS.seedMutationSeq_extCluster_mem_mixedLaurentSubring _ s i) hzL
  rw [h₀] at ha
  -- The denominators of `φ(z)` are powers of `5`: apply the same argument to `Σ' = μ₁(Σ)`,
  -- using `μ_s(Σ) = μ_{(1, s)}(Σ')`.
  set S' := seedMutation (by decide) (genericSeed fermatMatrix) 0
  have hS' : IsLabeledSeed ℚ (by decide) S' := hS.seedMutation _ 0
  have hval := fermat_map_seedMutationSeq_singleton φ h₀ h₁ h₂
  have hS'L : ∀ j, S'.extCluster j ∈ laurentSubring (genericSeed fermatMatrix).extCluster :=
    hS.seedMutationSeq_extCluster_mem_laurentSubring _ [0]
  have hS'1 : S'.extCluster 1 = (genericSeed fermatMatrix).extCluster 1 := by
    simp only [S', ClusterAlgebras.seedMutation]
    exact Function.update_of_ne (by decide) _ _
  have hz' := hS'.seedMutationSeq_extCluster_mem_mixedLaurentSubring _ (0 :: s) i
  rw [seedMutationSeq_cons, seedMutation_seedMutation _ hS] at hz'
  obtain ⟨N', a', ha'⟩ := exists_pow_mul_eq_intCast_of_mem_mixedLaurentSubring φ (r := 0)
    (fun j => ⟨hS'L j, by
      fin_cases j
      exacts [⟨5, by push_cast; exact hval 0⟩, ⟨-1, by push_cast; exact hval 1⟩,
        ⟨16, by push_cast; exact hval 2⟩]⟩)
    (hS'L 0) (hS'.1.1.ne_zero 0)
    (fun j hj hj0 => by
      obtain rfl : j = 1 := by omega
      rw [hS'1]
      exact ⟨inv_mem_laurentSubring _ 1, -1, by push_cast; exact hinv⟩)
    hz' hzL
  have h5 : φ ⟨S'.extCluster 0, hS'L 0⟩ = 5 := hval 0
  rw [h5] at ha'
  exact exists_eq_intCast_of_pow_mul_eq_intCast (p := 3) (p' := 5) ⟨2, -1, by norm_num⟩
    (by exact_mod_cast ha) (by exact_mod_cast ha')

/-- **Euler: `641` divides `2³² + 1`.** The number `(2³² + 1) / 641` is an integer. The proof is
the cluster-algebraic one: evaluating the Fermat seed pattern at `(X₁, X₂, X₃) = (3, -1, 16)`
produces `-(2³² + 1) / 641` as the value of a cluster variable, and every cluster variable takes
an integer value there. -/
@[cluster_algebras "thm_fermat_euler"]
theorem fermat_euler : ∃ m : ℤ, (m : ℚ) = (2 ^ 32 + 1) / 641 := by
  have hS := isLabeledSeed_genericSeed_fermatMatrix
  obtain ⟨φ, hφ⟩ := exists_ringHom_laurentSubring hS.1.1
    ![Units.mk0 (3 : ℚ) (by norm_num), Units.mk0 (-1 : ℚ) (by norm_num),
      Units.mk0 (16 : ℚ) (by norm_num)]
  have h₀ : φ ⟨_, mem_laurentSubring _ 0⟩ = 3 := hφ 0
  have h₁ : φ ⟨_, mem_laurentSubring _ 1⟩ = -1 := hφ 1
  have h₂ : φ ⟨_, mem_laurentSubring _ 2⟩ = 16 := hφ 2
  obtain ⟨a, ha⟩ := fermat_map_seedMutationSeq_eq_intCast φ h₀ h₁ h₂ [0, 1, 0, 1] 1
  refine ⟨-a, ?_⟩
  rw [fermat_map_seedMutationSeq_eq φ h₀ h₁ h₂] at ha
  push_cast
  rw [← ha]
  ring

end ClusterAlgebras
