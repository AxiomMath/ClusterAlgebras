/-!
# The triple diagram of a normal plabic graph

A *normal plabic pregraph* is the data of a plabic graph satisfying every condition of a normal
plabic graph except two conditions of a disk map: transitivity of the group generated by `σ` and
`d ↦ d̄`, and Euler's relation. To such a `G`, with `K` the set of darts at black vertices, one
attaches the tuple `X(G)` on the symbols `x⁺_k`, `x⁻_k` (`k ∈ K`) and `∂_r`, `∂'_r`
(`r ∈ [1, 2b]`): the involution pairs `x⁺_k` with `x⁻_{σ(k)}` and `∂_r` with `∂'_r`; the rotation
runs `x⁺_k ↦ x⁻_k ↦ x⁺_{\overline{σ(k̄)}}` when `v(k̄)` is internal (white), so that each white
vertex gives a triple point, and has the cycles `(∂'_{2i}, ∂_{2i-1}, x⁺_k)`,
`(∂'_{2i+1}, ∂_{2i}, x⁻_k)` for `k = ḡ_i`; the darts `x⁺` are `out` and the darts `x⁻` are `in`.

`X(G)` is a pre-triple diagram with `b` arcs. Its orbits of `φ_X` are the exterior `{∂_r}`, one
orbit for each black vertex of `G` (through the darts `x⁻_k`, whose first return is
`x⁻_k ↦ x⁻_{σ⁻¹ k}`), and one orbit for each orbit of `φ` other than the exterior (through the
darts `x⁺_k`, whose first return corresponds, under `x⁺_k ↦ σ(k)`, to the first return of `φ` to
`K`). Counting vertices, edges and orbits, `X(G)` and `G` have the same Euler characteristic; and
`X(G)` is connected exactly when `G` is. Hence `X(G)` is a triple diagram exactly when `G` is a
normal plabic graph, and isomorphic normal plabic graphs have isomorphic triple diagrams.

## Main definitions

* `ClusterAlgebras.PlabicData.IsNormalPlabicPregraph`: normal plabic pregraphs.
* `ClusterAlgebras.TripleOfNormalDart`, `ClusterAlgebras.PlabicData.TripleDart`: the darts
  `x⁺_k`, `x⁻_k`, `∂_r`, `∂'_r`.
* `ClusterAlgebras.PlabicData.tripleOfNormal`: the triple diagram `X(G)`, with its involution
  `PlabicData.IsNormalPlabicPregraph.tripleInv`, rotation
  `PlabicData.IsNormalPlabicPregraph.tripleRot` and endpoint darts
  `PlabicData.IsNormalPlabicPregraph.endDart`.
* `ClusterAlgebras.PlabicData.IsNormalPlabicGraph.toTripleDiagram`: `X(G)` as a bundled triple
  diagram.

## Main results

* `ClusterAlgebras.PlabicData.IsNormalPlabicPregraph.isPreTripleDiagram_tripleOfNormal`: `X(G)` is
  a pre-triple diagram.
* `ClusterAlgebras.PlabicData.IsNormalPlabicPregraph.euler_tripleOfNormal`: `X(G)` and `G` have the
  same Euler characteristic.
* `ClusterAlgebras.PlabicData.IsNormalPlabicPregraph.transitive_iff_tripleOfNormal`: `X(G)` is
  connected exactly when `G` is.
* `ClusterAlgebras.PlabicData.IsNormalPlabicGraph.isTripleDiagram_tripleOfNormal`: `X(G)` is a
  triple diagram.
* `ClusterAlgebras.PlabicData.IsNormalPlabicPregraph.isNormalPlabicGraph_of_isTripleDiagram`: a
  pregraph whose triple diagram is a triple diagram is a normal plabic graph.
* `ClusterAlgebras.PlabicData.Iso.tripleOfNormal`: `X(G)` depends on `G` only up to isomorphism.

## Implementation notes

* **Darts.** `K` is the `Finset` `PlabicData.blackDarts` of darts at internal vertices of colour
  black, and the darts of `X(G)` are the inductive type `TripleOfNormalDart K (2 * b)`, with
  constructors `plus`, `minus`, `del`, `del'` for `x⁺_k`, `x⁻_k`, `∂_r`, `∂'_r`.
* **Labels.** Labels are `0`-indexed: `i : Fin b` stands for the label `i + 1` of [FWZ] and
  `r : Fin (2 * b)` for `r + 1`. So `∂_{2i-1}`, `∂_{2i}` are `del (sourceIndex i)`,
  `del (targetIndex i)`, and `∂'_{2i}`, `∂'_{2i+1}` are `del' (targetIndex i)`,
  `del' (finRotate _ (targetIndex i))`; so `σ_X(∂'_r) = ∂_{r-1}` and `σ_X(∂_r) = n_r`, the dart
  `x^±_{ḡ_i}` of `ε(r)` (`IsNormalPlabicPregraph.endDart`).
* **The construction takes the pregraph hypothesis.** The rotation `σ_X` is a permutation only
  because `σ` preserves `K` and `\overline{σ(k̄)} ∈ K` when `v(k̄)` is internal, which use the
  conditions of a normal plabic pregraph; so `tripleOfNormal` takes the proof `hG` as an argument.
  The case `k = ḡ_i` is decided by `PlabicData.legIndex k`, the first label `i`
  with `ḡ_i = k`.
* **Counting.** Vertices and edges are counted by summing the reciprocals of the sizes of the
  orbits (in `ℚ`). The orbits of `φ_X` through the darts `x^±` are compared with orbits of `G`
  through first-return maps written as explicit functions.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 7,
  arXiv:2106.02160.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset

/-! ### Rotations of `Fin n` -/

private theorem val_finRotate {n : ℕ} (r : Fin n) : (finRotate n r : ℕ) = (r + 1) % n := by
  cases n with
  | zero => exact r.elim0
  | succ n =>
    rw [finRotate_apply, Fin.val_add, Fin.val_one']
    simp [Nat.add_mod]

private theorem finRotate_mk_of_succ_lt {n k : ℕ} (hk : k + 1 < n) :
    finRotate n ⟨k, by omega⟩ = ⟨k + 1, hk⟩ :=
  Fin.ext <| by
    rw [val_finRotate]
    exact Nat.mod_eq_of_lt hk

/-- The rotation of the endpoint labels takes the source next to `i` to the target next to `i`. -/
private theorem finRotate_sourceIndex {b : ℕ} (i : Fin b) :
    finRotate (2 * b) (sourceIndex i) = targetIndex i := by
  apply Fin.ext
  rw [val_finRotate, sourceIndex_val, targetIndex_val]
  exact Nat.mod_eq_of_lt (by omega)

/-- The rotation of the endpoint labels takes the target next to `i` to the source next to
`i + 1`. -/
private theorem finRotate_targetIndex {b : ℕ} (i : Fin b) :
    finRotate (2 * b) (targetIndex i) = sourceIndex (finRotate b i) := by
  apply Fin.ext
  rw [val_finRotate, sourceIndex_val, targetIndex_val, val_finRotate]
  have hi := i.2
  rcases Nat.lt_or_ge ((i : ℕ) + 1) b with h | h
  · rw [Nat.mod_eq_of_lt h, Nat.mod_eq_of_lt (by omega)]
    ring
  · rw [show (i : ℕ) + 1 = b by omega, Nat.mod_self,
      show 2 * (i : ℕ) + 1 + 1 = 2 * b by omega, Nat.mod_self]

/-! ### Orbits through a subset, and counting orbits -/

/-- Orbits of a permutation `π` through a subset `P` on which a map `ρ` gives the next point of
`P` on each orbit: two points of `P` lie in one orbit of `π` exactly when one is an iterate of the
other under `ρ`. -/
private theorem sameCycle_iff_exists_iterate {α : Type*} [Finite α] (π : Equiv.Perm α)
    (P : α → Prop) (ρ : α → α)
    (hρ : ∀ y, P y → P (ρ y) ∧
      ∃ m, 0 < m ∧ (π ^ m) y = ρ y ∧ ∀ j, 0 < j → j < m → ¬P ((π ^ j) y))
    {y y' : α} (hy : P y) (hy' : P y') : π.SameCycle y y' ↔ ∃ j, ρ^[j] y = y' := by
  constructor
  · intro h
    obtain ⟨n, hn⟩ := h.exists_nat_pow_eq
    clear h
    induction n using Nat.strong_induction_on generalizing y with
    | _ n ih =>
      obtain ⟨hPρ, m, hm, hmy, hmin⟩ := hρ y hy
      by_cases hnm : n < m
      · rcases Nat.eq_zero_or_pos n with rfl | hn0
        · exact ⟨0, by simpa using hn⟩
        · exact absurd (hn ▸ hy') (hmin n hn0 hnm)
      · have : (π ^ (n - m)) (ρ y) = y' := by
          rw [← hmy, ← Equiv.Perm.mul_apply, ← pow_add, Nat.sub_add_cancel (not_lt.1 hnm), hn]
        obtain ⟨j, hj⟩ := ih (n - m) (by omega) hPρ this
        exact ⟨j + 1, by rw [Function.iterate_succ_apply, hj]⟩
  · rintro ⟨j, rfl⟩
    clear hy'
    induction j generalizing y with
    | zero => exact Equiv.Perm.SameCycle.refl _ _
    | succ j ih =>
      obtain ⟨hPρ, m, -, hmy, -⟩ := hρ y hy
      rw [Function.iterate_succ_apply]
      exact Equiv.Perm.SameCycle.trans (⟨m, by rw [zpow_natCast, hmy]⟩ : π.SameCycle y (ρ y))
        (ih hPρ)

/-- Counting the blocks of a partition of a set `s` by summing the reciprocals of their sizes. -/
private theorem card_image_eq_sum_inv {α : Type*} [DecidableEq α] (f : α → Finset α)
    (hself : ∀ x, x ∈ f x) (hf : ∀ x y, y ∈ f x → f y = f x) (s : Finset α)
    (hs : ∀ x ∈ s, f x ⊆ s) : ((s.image f).card : ℚ) = ∑ x ∈ s, 1 / ((f x).card : ℚ) := by
  rw [card_eq_sum_ones, Nat.cast_sum, Nat.cast_one]
  refine Finset.sum_image' _ fun c hc => ?_
  have hfil : s.filter (fun x => f x = f c) = f c := by
    ext x
    simp only [mem_filter]
    exact ⟨fun ⟨_, hx⟩ => hx ▸ hself x, fun hx => ⟨hs c hc hx, hf c x hx⟩⟩
  have hpos : (0 : ℚ) < (f c).card := mod_cast card_pos.2 ⟨c, hself c⟩
  rw [sum_congr rfl fun x hx => by rw [(mem_filter.1 hx).2], sum_const, hfil, nsmul_eq_mul,
    mul_one_div_cancel hpos.ne']

/-- A pair of maps with the same fibres on `s` have images of the same size. -/
private theorem card_image_eq_of_iff {α β γ : Type*} [DecidableEq β] [DecidableEq γ]
    {f : α → β} {g : α → γ} {s : Finset α} (h : ∀ x ∈ s, ∀ y ∈ s, f x = f y ↔ g x = g y) :
    (s.image f).card = (s.image g).card := by
  have hf : s.image f = (s.image fun x => (f x, g x)).image Prod.fst := by
    rw [image_image]
    rfl
  have hg : s.image g = (s.image fun x => (f x, g x)).image Prod.snd := by
    rw [image_image]
    rfl
  have i1 : Set.InjOn Prod.fst (↑(s.image fun x => (f x, g x)) : Set (β × γ)) := by
    intro p hp q hq hpq
    obtain ⟨x, hx, rfl⟩ := mem_image.1 (mem_coe.1 hp)
    obtain ⟨y, hy, rfl⟩ := mem_image.1 (mem_coe.1 hq)
    simp only at hpq
    rw [Prod.mk.injEq]
    exact ⟨hpq, (h x hx y hy).1 hpq⟩
  have i2 : Set.InjOn Prod.snd (↑(s.image fun x => (f x, g x)) : Set (β × γ)) := by
    intro p hp q hq hpq
    obtain ⟨x, hx, rfl⟩ := mem_image.1 (mem_coe.1 hp)
    obtain ⟨y, hy, rfl⟩ := mem_image.1 (mem_coe.1 hq)
    simp only at hpq
    rw [Prod.mk.injEq]
    exact ⟨(h x hx y hy).2 hpq, hpq⟩
  rw [hf, hg, card_image_of_injOn i1, card_image_of_injOn i2]

/-! ### Orbits given by explicit cycles -/

namespace RotationSystem

variable {H : Type*} [Fintype H] [DecidableEq H] (R : RotationSystem H)

omit [Fintype H] [DecidableEq H] in
/-- A permutation's orbit through `x` stays inside any set containing `x` and closed under it. -/
private theorem mem_of_sameCycle_of_closed [Finite H] {f : Equiv.Perm H} {S : Finset H}
    (hS : ∀ y ∈ S, f y ∈ S) {x y : H} (hx : x ∈ S) (h : f.SameCycle x y) : y ∈ S := by
  obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
  clear h
  induction n with
  | zero => simpa using hx
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    exact hS _ ih

omit [Fintype H] [DecidableEq H] in
private theorem sameCycle_step {f : Equiv.Perm H} {x y z : H} (h : f.SameCycle x y)
    (hz : f y = z) : f.SameCycle x z :=
  hz ▸ Equiv.Perm.sameCycle_apply_right.2 h

/-- The vertex `v(z)` is a set `S ∋ z` closed under `σ` all of whose elements are reached. -/
private theorem vertexOf_eq_of_closed {z : H} {S : Finset H} (hS : ∀ y ∈ S, R.rot y ∈ S)
    (hz : z ∈ S) (hr : ∀ y ∈ S, R.rot.SameCycle z y) : R.vertexOf z = S := by
  ext y
  rw [mem_vertexOf]
  exact ⟨mem_of_sameCycle_of_closed hS hz, hr y⟩

/-- The orbit `f(z)` is a set `S ∋ z` closed under `φ` all of whose elements are reached. -/
private theorem faceOf_eq_of_closed {z : H} {S : Finset H} (hS : ∀ y ∈ S, R.facePerm y ∈ S)
    (hz : z ∈ S) (hr : ∀ y ∈ S, R.facePerm.SameCycle z y) : R.faceOf z = S := by
  ext y
  rw [mem_faceOf]
  exact ⟨mem_of_sameCycle_of_closed hS hz, hr y⟩

/-- A vertex given by a `3`-cycle of the rotation. -/
private theorem vertexOf_eq_three {a₁ a₂ a₃ : H} (h₁ : R.rot a₁ = a₂) (h₂ : R.rot a₂ = a₃)
    (h₃ : R.rot a₃ = a₁) : R.vertexOf a₁ = {a₁, a₂, a₃} := by
  have s₂ := sameCycle_step (Equiv.Perm.SameCycle.refl _ _) h₁
  have s₃ := sameCycle_step s₂ h₂
  refine R.vertexOf_eq_of_closed ?_ (by simp) ?_
  · intro y hy
    simp only [mem_insert, mem_singleton] at hy ⊢
    rcases hy with rfl | rfl | rfl <;> simp [*]
  · intro y hy
    simp only [mem_insert, mem_singleton] at hy
    rcases hy with rfl | rfl | rfl
    exacts [Equiv.Perm.SameCycle.refl _ _, s₂, s₃]

/-- A vertex given by a `6`-cycle of the rotation. -/
private theorem vertexOf_eq_six {a₁ a₂ a₃ a₄ a₅ a₆ : H} (h₁ : R.rot a₁ = a₂)
    (h₂ : R.rot a₂ = a₃) (h₃ : R.rot a₃ = a₄) (h₄ : R.rot a₄ = a₅) (h₅ : R.rot a₅ = a₆)
    (h₆ : R.rot a₆ = a₁) : R.vertexOf a₁ = {a₁, a₂, a₃, a₄, a₅, a₆} := by
  have s₂ := sameCycle_step (Equiv.Perm.SameCycle.refl _ _) h₁
  have s₃ := sameCycle_step s₂ h₂
  have s₄ := sameCycle_step s₃ h₃
  have s₅ := sameCycle_step s₄ h₄
  have s₆ := sameCycle_step s₅ h₅
  refine R.vertexOf_eq_of_closed ?_ (by simp) ?_
  · intro y hy
    simp only [mem_insert, mem_singleton] at hy ⊢
    rcases hy with rfl | rfl | rfl | rfl | rfl | rfl <;> simp [*]
  · intro y hy
    simp only [mem_insert, mem_singleton] at hy
    rcases hy with rfl | rfl | rfl | rfl | rfl | rfl
    exacts [Equiv.Perm.SameCycle.refl _ _, s₂, s₃, s₄, s₅, s₆]

/-- A vertex with three darts is a `3`-cycle of the rotation. -/
private theorem rot_rot_rot_of_card_eq_three {y : H} (h : (R.vertexOf y).card = 3) :
    R.rot (R.rot (R.rot y)) = y ∧ R.rot y ≠ y ∧ R.rot (R.rot y) ≠ y := by
  have h2 : R.rot (R.rot y) ≠ y := fun h' => by
    have := R.card_vertexOf_le_two h'
    omega
  have h1 : R.rot y ≠ y := fun h' => h2 (by rw [h', h'])
  refine ⟨?_, h1, h2⟩
  have hm1 : R.rot y ∈ R.vertexOf y := R.rot_mem_vertexOf y
  have hm2 : R.rot (R.rot y) ∈ R.vertexOf y := by
    rw [← R.vertexOf_rot y]; exact R.rot_mem_vertexOf _
  have hm3 : R.rot (R.rot (R.rot y)) ∈ R.vertexOf y := by
    rw [← R.vertexOf_rot y, ← R.vertexOf_rot (R.rot y)]; exact R.rot_mem_vertexOf _
  have hsub : R.vertexOf y = {y, R.rot y, R.rot (R.rot y)} := by
    symm
    apply eq_of_subset_of_card_le
    · intro x hx
      simp only [mem_insert, mem_singleton] at hx
      rcases hx with rfl | rfl | rfl
      exacts [R.self_mem_vertexOf _, hm1, hm2]
    · rw [h, card_insert_of_notMem, card_pair]
      · exact fun h' => h1 (R.rot.injective h').symm
      · simp only [mem_insert, mem_singleton, not_or]
        exact ⟨Ne.symm h1, Ne.symm h2⟩
  rw [hsub] at hm3
  simp only [mem_insert, mem_singleton] at hm3
  rcases hm3 with h' | h' | h'
  · exact h'
  · exact absurd (R.rot.injective h') h2
  · exact absurd (R.rot.injective (R.rot.injective h')) h1

/-- The number of vertices, as a sum over the darts. -/
private theorem card_vertices_eq_sum :
    (R.vertices.card : ℚ) = ∑ d, 1 / ((R.vertexOf d).card : ℚ) :=
  card_image_eq_sum_inv R.vertexOf R.self_mem_vertexOf (fun _ _ h => R.vertexOf_eq_of_mem h) univ
    (fun _ _ => subset_univ _)

/-- With a fixed-point-free involution, there are half as many edges as darts. -/
private theorem card_edges_eq (hinv : Function.Involutive R.inv) (hne : ∀ d, R.inv d ≠ d) :
    (R.edges.card : ℚ) = Fintype.card H / 2 := by
  have h := card_image_eq_sum_inv R.edgeOf (fun x => by simp) (fun x y hy => ?_) univ
    (fun _ _ => subset_univ _)
  · have h2 : ∀ d, (R.edgeOf d).card = 2 := fun d => card_pair (hne d).symm
    change ((univ.image R.edgeOf).card : ℚ) = _
    rw [h]
    simp only [h2, sum_const, card_univ, nsmul_eq_mul]
    push_cast
    ring
  · rcases (R.mem_edgeOf).1 hy with rfl | rfl
    · rfl
    · ext z
      simp only [mem_edgeOf, hinv x]
      tauto

/-- A dart reaches every dart of its vertex. -/
private theorem reach_of_mem_vertexOf {d e : H} (h : e ∈ R.vertexOf d) : R.Reach d e := by
  obtain ⟨n, rfl⟩ := ((R.mem_vertexOf).1 h).exists_nat_pow_eq
  exact R.reach_pow_apply (fun x => (Reach.refl x).rot) n d

end RotationSystem

/-! ### The darts of the triple diagram -/

/-- The darts of the triple diagram of a normal plabic graph: pairwise distinct symbols `x⁺_k`
(`plus k`) and `x⁻_k` (`minus k`) for `k` in a set `K`, and `∂_r` (`del r`), `∂'_r` (`del' r`) for
`r` in `Fin n`. -/
inductive TripleOfNormalDart (K : Type*) (n : ℕ) : Type _
  /-- The dart `x⁺_k`. -/
  | plus (k : K)
  /-- The dart `x⁻_k`. -/
  | minus (k : K)
  /-- The dart `∂_r` of the boundary circle. -/
  | del (r : Fin n)
  /-- The dart `∂'_r` of the boundary circle. -/
  | del' (r : Fin n)
  deriving DecidableEq

namespace TripleOfNormalDart

variable {K : Type*} {n : ℕ}

/-- The darts of `TripleOfNormalDart K n` as a sum type. -/
def equivSum : TripleOfNormalDart K n ≃ (K ⊕ K) ⊕ (Fin n ⊕ Fin n) where
  toFun
    | plus k => .inl (.inl k)
    | minus k => .inl (.inr k)
    | del r => .inr (.inl r)
    | del' r => .inr (.inr r)
  invFun
    | .inl (.inl k) => plus k
    | .inl (.inr k) => minus k
    | .inr (.inl r) => del r
    | .inr (.inr r) => del' r
  left_inv := by rintro (_ | _ | _ | _) <;> rfl
  right_inv := by rintro ((_ | _) | (_ | _)) <;> rfl

/-- For finite `K`, there are finitely many darts `x⁺_k`, `x⁻_k`, `∂_r`, `∂'_r`. -/
instance [Fintype K] : Fintype (TripleOfNormalDart K n) := Fintype.ofEquiv _ equivSum.symm

/-- A sum over the darts splits into the sums over the four kinds of darts. -/
theorem sum_univ [Fintype K] {M : Type*} [AddCommMonoid M] (f : TripleOfNormalDart K n → M) :
    ∑ z, f z = (∑ k, f (plus k) + ∑ k, f (minus k)) + (∑ r, f (del r) + ∑ r, f (del' r)) := by
  rw [← equivSum.symm.sum_comp, Fintype.sum_sum_type, Fintype.sum_sum_type,
    Fintype.sum_sum_type]
  rfl

/-- Whether a dart is one of the darts `∂_r`, `∂'_r` of the boundary circle. -/
def isDel : TripleOfNormalDart K n → Bool
  | del _ => true
  | del' _ => true
  | _ => false

/-- The dart `x⁺_k` is not a dart of the boundary circle. -/
@[simp] theorem isDel_plus (k : K) : (plus k : TripleOfNormalDart K n).isDel = false := rfl
/-- The dart `x⁻_k` is not a dart of the boundary circle. -/
@[simp] theorem isDel_minus (k : K) : (minus k : TripleOfNormalDart K n).isDel = false := rfl
/-- The dart `∂_r` is a dart of the boundary circle. -/
@[simp] theorem isDel_del (r : Fin n) : (del r : TripleOfNormalDart K n).isDel = true := rfl
/-- The dart `∂'_r` is a dart of the boundary circle. -/
@[simp] theorem isDel_del' (r : Fin n) : (del' r : TripleOfNormalDart K n).isDel = true := rfl

/-- The orientation of a dart: `out` (`true`) for the darts `x⁺_k`, `in` (`false`) otherwise. -/
def isPlus : TripleOfNormalDart K n → Bool
  | plus _ => true
  | _ => false

/-- The dart `x⁺_k` is oriented `out`. -/
@[simp] theorem isPlus_plus (k : K) : (plus k : TripleOfNormalDart K n).isPlus = true := rfl
/-- The dart `x⁻_k` is oriented `in`. -/
@[simp] theorem isPlus_minus (k : K) : (minus k : TripleOfNormalDart K n).isPlus = false := rfl
/-- The dart `∂_r` is oriented `in`. -/
@[simp] theorem isPlus_del (r : Fin n) : (del r : TripleOfNormalDart K n).isPlus = false := rfl
/-- The dart `∂'_r` is oriented `in`. -/
@[simp] theorem isPlus_del' (r : Fin n) : (del' r : TripleOfNormalDart K n).isPlus = false := rfl

/-- A bijection `K ≃ K'` induces a bijection of darts, `x^±_k ↦ x^±_{e k}`, `∂_r ↦ ∂_r`,
`∂'_r ↦ ∂'_r`. -/
def mapEquiv {K' : Type*} (e : K ≃ K') : TripleOfNormalDart K n ≃ TripleOfNormalDart K' n where
  toFun
    | plus k => plus (e k)
    | minus k => minus (e k)
    | del r => del r
    | del' r => del' r
  invFun
    | plus k => plus (e.symm k)
    | minus k => minus (e.symm k)
    | del r => del r
    | del' r => del' r
  left_inv := by rintro (_ | _ | _ | _) <;> simp
  right_inv := by rintro (_ | _ | _ | _) <;> simp

section MapEquiv

variable {K' : Type*} (e : K ≃ K')

/-- The bijection induced by `e` takes `x⁺_k` to `x⁺_{e k}`. -/
@[simp] theorem mapEquiv_plus (k : K) :
    mapEquiv (n := n) e (plus k) = plus (e k) := rfl
/-- The bijection induced by `e` takes `x⁻_k` to `x⁻_{e k}`. -/
@[simp] theorem mapEquiv_minus (k : K) :
    mapEquiv (n := n) e (minus k) = minus (e k) := rfl
/-- The bijection induced by `e` fixes `∂_r`. -/
@[simp] theorem mapEquiv_del (r : Fin n) : mapEquiv e (del r) = del r := rfl
/-- The bijection induced by `e` fixes `∂'_r`. -/
@[simp] theorem mapEquiv_del' (r : Fin n) : mapEquiv e (del' r) = del' r := rfl

end MapEquiv

end TripleOfNormalDart

namespace PlabicData

variable {H : Type} [Fintype H] [DecidableEq H] {b : ℕ} (G : PlabicData H b)

/-! ### Normal plabic pregraphs -/

/-- A **normal plabic pregraph** with `b ≥ 1` boundary vertices: the data of a plabic graph
satisfying every condition of a normal plabic graph, except that of the conditions of a disk map
only the following are required: `H` is nonempty, `d ↦ d̄` is a fixed-point-free involution, `B`
is closed under it, every boundary vertex consists of exactly three darts, two of them in `B`, and
some orbit `f` of `φ` satisfies `f ⊆ B`, `f ∪ f̄ = B` and `f ∩ f̄ = ∅`. (Transitivity and Euler's
relation are not required.) -/
@[cluster_algebras "def_normal_plabic_pregraph"]
structure IsNormalPlabicPregraph : Prop extends G.IsNormal where
  /-- There is at least one boundary vertex. -/
  one_le : 1 ≤ b
  /-- There is a dart. -/
  nonempty : Nonempty H
  /-- `d ↦ d̄` is an involution. -/
  inv_involutive : Function.Involutive G.inv
  /-- `d ↦ d̄` has no fixed point. -/
  inv_ne : ∀ d, G.inv d ≠ d
  /-- `B` is closed under `d ↦ d̄`. -/
  inv_mem_bdry : ∀ d ∈ G.bdry, G.inv d ∈ G.bdry
  /-- Every boundary vertex has three darts, two of them in `B`. -/
  boundaryVertex_card : ∀ v ∈ G.boundaryVertices,
    v.card = 3 ∧ (v.filter (· ∈ G.bdry)).card = 2
  /-- Some orbit of `φ` is half of the boundary. -/
  exists_orbit : ∃ f ∈ G.faceOrbits, f ⊆ G.bdry ∧
    f ∪ f.map G.inv.toEmbedding = G.bdry ∧ Disjoint f (f.map G.inv.toEmbedding)
  /-- The colour is a function of the vertex, at internal vertices. -/
  colour_rot : ∀ d, ¬G.IsBoundaryVertex (G.vertexOf d) → G.colour (G.rot d) = G.colour d
  /-- The chosen dart at `β(i)` is the leg, the dart not in `B`. -/
  leg_notMem_bdry : ∀ i, G.leg i ∉ G.bdry
  /-- Each `β(i)` is a boundary vertex. -/
  bvertex_mem : ∀ i, G.bvertex i ∈ G.boundaryVertices
  /-- `β` is injective. -/
  bvertex_injective : Function.Injective G.bvertex
  /-- `β` is onto the boundary vertices. -/
  exists_bvertex_eq : ∀ v ∈ G.boundaryVertices, ∃ i, G.bvertex i = v
  /-- Some dart of the exterior at `β(i + 1)` runs to `β(i)`. -/
  exists_exterior : ∀ i, ∃ d ∈ G.exterior, d ∈ G.bvertex (finRotate b i) ∧ G.inv d ∈ G.bvertex i

variable {G}

/-- Every normal plabic graph is a normal plabic pregraph. -/
theorem IsNormalPlabicGraph.isNormalPlabicPregraph (hG : G.IsNormalPlabicGraph) :
    G.IsNormalPlabicPregraph :=
  { hG.toIsNormal with
    one_le := hG.one_le
    nonempty := hG.nonempty
    inv_involutive := hG.inv_involutive
    inv_ne := hG.inv_ne
    inv_mem_bdry := hG.inv_mem_bdry
    boundaryVertex_card := hG.boundaryVertex_card
    exists_orbit := hG.exists_orbit
    colour_rot := hG.colour_rot
    leg_notMem_bdry := hG.leg_notMem_bdry
    bvertex_mem := hG.bvertex_mem
    bvertex_injective := hG.bvertex_injective
    exists_bvertex_eq := hG.exists_bvertex_eq
    exists_exterior := hG.exists_exterior }

/-- A normal plabic pregraph whose rotation system is transitive and satisfies Euler's relation is
a normal plabic graph. -/
theorem IsNormalPlabicPregraph.isNormalPlabicGraph (hG : G.IsNormalPlabicPregraph)
    (htrans : ∀ d e : H,
      ∃ g ∈ Subgroup.closure ({G.inv, G.rot} : Set (Equiv.Perm H)), g d = e)
    (heuler : (G.vertices.card : ℤ) - G.edges.card + G.faceOrbits.card = 2) :
    G.IsNormalPlabicGraph :=
  { hG.toIsNormal with
    nonempty := hG.nonempty
    inv_involutive := hG.inv_involutive
    inv_ne := hG.inv_ne
    transitive := htrans
    inv_mem_bdry := hG.inv_mem_bdry
    euler := heuler
    boundaryVertex_card := hG.boundaryVertex_card
    exists_orbit := hG.exists_orbit
    one_le := hG.one_le
    colour_rot := hG.colour_rot
    leg_notMem_bdry := hG.leg_notMem_bdry
    bvertex_mem := hG.bvertex_mem
    bvertex_injective := hG.bvertex_injective
    exists_bvertex_eq := hG.exists_bvertex_eq
    exists_exterior := hG.exists_exterior }

namespace IsNormalPlabicPregraph

variable (hG : G.IsNormalPlabicPregraph)

include hG

/-- In a normal plabic pregraph, `d ↦ d̄` is an involution: `d̄̄ = d`. -/
theorem inv_inv (d : H) : G.inv (G.inv d) = d := hG.inv_involutive d

/-- In a normal plabic pregraph, `d̄ ∈ B` if and only if `d ∈ B`. -/
theorem inv_mem_bdry_iff {d : H} : G.inv d ∈ G.bdry ↔ d ∈ G.bdry := by
  refine ⟨fun h => ?_, hG.inv_mem_bdry d⟩
  have := hG.inv_mem_bdry _ h
  rwa [hG.inv_inv d] at this

/-- In a normal plabic pregraph, the legs `g_i` are pairwise distinct. -/
theorem leg_injective : Function.Injective G.leg := fun i j h =>
  hG.bvertex_injective (by simp only [bvertex, h])

/-- The vertex of the leg `g_i` is a boundary vertex. -/
theorem isBoundaryVertex_leg (i : Fin b) : G.IsBoundaryVertex (G.vertexOf (G.leg i)) :=
  G.vertexOf_mem_boundaryVertices.1 (hG.bvertex_mem i)

/-- A dart at a boundary vertex that is not in `B` is a leg. -/
theorem exists_leg_eq {d : H} (hd : G.IsBoundaryVertex (G.vertexOf d)) (hdB : d ∉ G.bdry) :
    ∃ i, G.leg i = d := by
  obtain ⟨i, hi⟩ := hG.exists_bvertex_eq _ (G.vertexOf_mem_boundaryVertices.2 hd)
  refine ⟨i, DiskMap.eq_of_notMem_bdry hG.boundaryVertex_card hd ?_ (G.self_mem_vertexOf d)
    (hG.leg_notMem_bdry i) hdB⟩
  rw [← hi]
  exact G.leg_mem_bvertex i

/-- At an internal vertex, `σ⁻¹(d)` has the same colour as `d`. -/
theorem colour_rot_symm {d : H} (hd : ¬G.IsBoundaryVertex (G.vertexOf d)) :
    G.colour (G.rot.symm d) = G.colour d := by
  have h : ¬G.IsBoundaryVertex (G.vertexOf (G.rot.symm d)) := by
    rwa [G.vertexOf_eq_of_mem (G.rot_symm_mem_vertexOf d)]
  have := hG.colour_rot _ h
  rw [Equiv.apply_symm_apply] at this
  exact this.symm

/-- The far end of a dart at a white vertex is a black internal vertex. -/
theorem inv_black_of_white {a : H} (ha : ¬G.IsBoundaryVertex (G.vertexOf a))
    (hc : G.colour a = .white) :
    ¬G.IsBoundaryVertex (G.vertexOf (G.inv a)) ∧ G.colour (G.inv a) = .black := by
  have hb : ¬G.IsBoundaryVertex (G.vertexOf (G.inv a)) := by
    intro hb
    have haB : a ∉ G.bdry := notMem_bdry_of_mem_vertexOf ha (G.self_mem_vertexOf a)
    have hiB : G.inv a ∉ G.bdry := fun h => haB (hG.inv_mem_bdry_iff.1 h)
    obtain ⟨i, hi⟩ := hG.exists_leg_eq hb hiB
    have := hG.colour_inv_leg i
    rw [hi, hG.inv_inv a, hc] at this
    exact Shade.noConfusion this
  refine ⟨hb, ?_⟩
  have := hG.colour_inv_ne a ha hb
  rw [hc] at this
  cases h : G.colour (G.inv a)
  · exact absurd h this
  · rfl

/-- The far end of a dart at a black vertex, if internal, is white. -/
theorem inv_white_of_black {k : H} (hk : ¬G.IsBoundaryVertex (G.vertexOf k))
    (hc : G.colour k = .black) (hi : ¬G.IsBoundaryVertex (G.vertexOf (G.inv k))) :
    G.colour (G.inv k) = .white := by
  have := hG.colour_inv_ne k hk hi
  rw [hc] at this
  cases h : G.colour (G.inv k)
  · rfl
  · exact absurd h this

end IsNormalPlabicPregraph

/-! ### The darts at black vertices and the legs -/

variable (G)

/-- The set `K` of darts at black vertices: darts at internal vertices of colour black. -/
def blackDarts : Finset H := {d | ¬G.IsBoundaryVertex (G.vertexOf d) ∧ G.colour d = .black}

/-- The darts at black vertices, as a type. -/
abbrev BlackDart : Type := {k // k ∈ G.blackDarts}

/-- The darts `x^±_k`, `∂_r`, `∂'_r` of the triple diagram of `G`. -/
abbrev TripleDart : Type := TripleOfNormalDart G.BlackDart (2 * b)

/-- The label `i` (if any) of the leg `g_i` with `ḡ_i = k`, found by searching the labels in
order. -/
def legIndex (k : H) : Option (Fin b) := (List.finRange b).find? fun i => G.inv (G.leg i) = k

variable {G}

/-- A dart lies in `K` exactly when its vertex is internal and its colour is black. -/
theorem mem_blackDarts {d : H} :
    d ∈ G.blackDarts ↔ ¬G.IsBoundaryVertex (G.vertexOf d) ∧ G.colour d = .black := by
  simp [blackDarts]

omit [Fintype H] in
/-- If `legIndex k = some i`, then `ḡ_i = k`. -/
theorem inv_leg_of_legIndex_eq_some {k : H} {i : Fin b} (h : G.legIndex k = some i) :
    G.inv (G.leg i) = k := by
  simpa using List.find?_some h

omit [Fintype H] in
/-- `legIndex k = none` exactly when `k` is not the reverse `ḡ_i` of any leg. -/
theorem legIndex_eq_none_iff {k : H} : G.legIndex k = none ↔ ∀ i, G.inv (G.leg i) ≠ k := by
  simp [legIndex, List.find?_eq_none]

/-- A dart of `K` does not lie in `B`. -/
theorem notMem_bdry_of_mem_blackDarts {k : H} (hk : k ∈ G.blackDarts) : k ∉ G.bdry :=
  notMem_bdry_of_mem_vertexOf (mem_blackDarts.1 hk).1 (G.self_mem_vertexOf k)

namespace IsNormalPlabicPregraph

variable (hG : G.IsNormalPlabicPregraph)

include hG

/-- In a normal plabic pregraph, `σ` maps `K` into `K`. -/
theorem rot_mem_blackDarts {k : H} (hk : k ∈ G.blackDarts) : G.rot k ∈ G.blackDarts := by
  rw [mem_blackDarts] at hk ⊢
  rw [G.vertexOf_rot, hG.colour_rot k hk.1]
  exact hk

/-- In a normal plabic pregraph, `σ⁻¹` maps `K` into `K`. -/
theorem rot_symm_mem_blackDarts {k : H} (hk : k ∈ G.blackDarts) :
    G.rot.symm k ∈ G.blackDarts := by
  rw [mem_blackDarts] at hk ⊢
  rw [G.vertexOf_eq_of_mem (G.rot_symm_mem_vertexOf k), hG.colour_rot_symm hk.1]
  exact hk

/-- The reverse `ḡ_i` of a leg lies at a black vertex. -/
theorem inv_leg_mem_blackDarts (i : Fin b) : G.inv (G.leg i) ∈ G.blackDarts :=
  mem_blackDarts.2 ⟨hG.not_isBoundaryVertex_inv_leg i, hG.colour_inv_leg i⟩

/-- The label of the reverse `ḡ_i` of the leg `g_i` is `i`. -/
theorem legIndex_inv_leg (i : Fin b) : G.legIndex (G.inv (G.leg i)) = some i := by
  have hs : (G.legIndex (G.inv (G.leg i))).isSome := by
    unfold legIndex
    exact List.find?_isSome.2 ⟨i, List.mem_finRange i, by simp⟩
  obtain ⟨j, hj⟩ := Option.isSome_iff_exists.1 hs
  rw [hj, hG.leg_injective (G.inv.injective (inv_leg_of_legIndex_eq_some hj))]

/-- A dart `k ∈ K` that is not the reverse of a leg runs to an internal (white) vertex. -/
theorem not_isBoundaryVertex_inv {k : H} (hk : k ∈ G.blackDarts) (h : G.legIndex k = none) :
    ¬G.IsBoundaryVertex (G.vertexOf (G.inv k)) := by
  intro hb
  have hkB := notMem_bdry_of_mem_blackDarts hk
  obtain ⟨i, hi⟩ := hG.exists_leg_eq hb fun h' => hkB (hG.inv_mem_bdry_iff.1 h')
  exact legIndex_eq_none_iff.1 h i (by rw [hi, hG.inv_inv])

/-- For `k ∈ K` not the reverse of a leg, the dart `k̄` has colour white. -/
theorem colour_inv {k : H} (hk : k ∈ G.blackDarts) (h : G.legIndex k = none) :
    G.colour (G.inv k) = .white :=
  hG.inv_white_of_black (mem_blackDarts.1 hk).1 (mem_blackDarts.1 hk).2
    (hG.not_isBoundaryVertex_inv hk h)

/-- A dart at an internal vertex is not the reverse of a leg. -/
theorem legIndex_eq_none_of_internal {k : H} (h : ¬G.IsBoundaryVertex (G.vertexOf (G.inv k))) :
    G.legIndex k = none := by
  rw [legIndex_eq_none_iff]
  intro i hi
  rw [← hi, hG.inv_inv] at h
  exact h (hG.isBoundaryVertex_leg i)

/-- For `k ∈ K` not the reverse of a leg, `ψ(k) = \overline{σ(k̄)}` again lies in `K` and is not
the reverse of a leg. -/
theorem psi_mem {k : H} (hk : k ∈ G.blackDarts) (h : G.legIndex k = none) :
    G.inv (G.rot (G.inv k)) ∈ G.blackDarts ∧ G.legIndex (G.inv (G.rot (G.inv k))) = none := by
  have hi := hG.not_isBoundaryVertex_inv hk h
  have hw := hG.colour_inv hk h
  have hi' : ¬G.IsBoundaryVertex (G.vertexOf (G.rot (G.inv k))) := by rwa [G.vertexOf_rot]
  have hw' : G.colour (G.rot (G.inv k)) = .white := by rw [hG.colour_rot _ hi, hw]
  obtain ⟨h1, h2⟩ := hG.inv_black_of_white hi' hw'
  refine ⟨mem_blackDarts.2 ⟨h1, h2⟩, hG.legIndex_eq_none_of_internal ?_⟩
  rwa [hG.inv_inv]

/-- For `k ∈ K` not the reverse of a leg, `\overline{σ⁻¹(k̄)}` again lies in `K` and is not the
reverse of a leg. -/
theorem psiInv_mem {k : H} (hk : k ∈ G.blackDarts) (h : G.legIndex k = none) :
    G.inv (G.rot.symm (G.inv k)) ∈ G.blackDarts ∧
      G.legIndex (G.inv (G.rot.symm (G.inv k))) = none := by
  have hi := hG.not_isBoundaryVertex_inv hk h
  have hw := hG.colour_inv hk h
  have hi' : ¬G.IsBoundaryVertex (G.vertexOf (G.rot.symm (G.inv k))) := by
    rwa [G.vertexOf_eq_of_mem (G.rot_symm_mem_vertexOf _)]
  have hw' : G.colour (G.rot.symm (G.inv k)) = .white := by rw [hG.colour_rot_symm hi, hw]
  obtain ⟨h1, h2⟩ := hG.inv_black_of_white hi' hw'
  refine ⟨mem_blackDarts.2 ⟨h1, h2⟩, hG.legIndex_eq_none_of_internal ?_⟩
  rwa [hG.inv_inv]

/-! ### The data of the triple diagram -/

omit hG in
/-- The arc label `⌊r / 2⌋` of the endpoint label `r`. -/
def halfIndex (r : Fin (2 * b)) : Fin b := ⟨r / 2, by omega⟩

omit hG in
/-- The arc label of the source label of the arc `i` is `i`. -/
@[simp]
theorem halfIndex_sourceIndex (i : Fin b) : halfIndex (sourceIndex i) = i :=
  Fin.ext (by simp [halfIndex])

omit hG in
/-- The arc label of the target label of the arc `i` is `i`. -/
@[simp]
theorem halfIndex_targetIndex (i : Fin b) : halfIndex (targetIndex i) = i :=
  Fin.ext (by simp [halfIndex]; omega)

/-- The dart `ḡ_i` as an element of `K`. -/
def invLeg (i : Fin b) : G.BlackDart := ⟨G.inv (G.leg i), hG.inv_leg_mem_blackDarts i⟩

/-- The dart `n_r` of the endpoint `ε(r)` outside `B`: `x⁺_{ḡ_i}` at the source `ε(2i - 1)` and
`x⁻_{ḡ_i}` at the target `ε(2i)`. -/
def endDart (r : Fin (2 * b)) : G.TripleDart :=
  if (r : ℕ) % 2 = 0 then .plus (hG.invLeg (halfIndex r)) else .minus (hG.invLeg (halfIndex r))

/-- The endpoint dart at the source of the arc `i` is `x⁺_{ḡ_i}`. -/
@[simp]
theorem endDart_sourceIndex (i : Fin b) : hG.endDart (sourceIndex i) = .plus (hG.invLeg i) := by
  simp [endDart]

/-- The endpoint dart at the target of the arc `i` is `x⁻_{ḡ_i}`. -/
@[simp]
theorem endDart_targetIndex (i : Fin b) : hG.endDart (targetIndex i) = .minus (hG.invLeg i) := by
  simp [endDart, Nat.add_mod]

/-- The involution of `X(G)`: `x⁺_k ↔ x⁻_{σ(k)}` and `∂_r ↔ ∂'_r`. -/
def tripleInv : Equiv.Perm G.TripleDart where
  toFun
    | .plus k => .minus ⟨G.rot k, hG.rot_mem_blackDarts k.2⟩
    | .minus k => .plus ⟨G.rot.symm k, hG.rot_symm_mem_blackDarts k.2⟩
    | .del r => .del' r
    | .del' r => .del r
  invFun
    | .plus k => .minus ⟨G.rot k, hG.rot_mem_blackDarts k.2⟩
    | .minus k => .plus ⟨G.rot.symm k, hG.rot_symm_mem_blackDarts k.2⟩
    | .del r => .del' r
    | .del' r => .del r
  left_inv := by rintro (_ | _ | _ | _) <;> simp
  right_inv := by rintro (_ | _ | _ | _) <;> simp

/-- The involution of `X(G)` takes `x⁺_k` to `x⁻_{σ(k)}`. -/
@[simp] theorem tripleInv_plus (k : G.BlackDart) :
    hG.tripleInv (.plus k) = .minus ⟨G.rot k, hG.rot_mem_blackDarts k.2⟩ := rfl
/-- The involution of `X(G)` takes `x⁻_k` to `x⁺_{σ⁻¹(k)}`. -/
@[simp] theorem tripleInv_minus (k : G.BlackDart) :
    hG.tripleInv (.minus k) = .plus ⟨G.rot.symm k, hG.rot_symm_mem_blackDarts k.2⟩ := rfl
/-- The involution of `X(G)` takes `∂_r` to `∂'_r`. -/
@[simp] theorem tripleInv_del (r : Fin (2 * b)) : hG.tripleInv (.del r) = .del' r := rfl
/-- The involution of `X(G)` takes `∂'_r` to `∂_r`. -/
@[simp] theorem tripleInv_del' (r : Fin (2 * b)) : hG.tripleInv (.del' r) = .del r := rfl

omit hG in
/-- The image of `x⁺_k` under the rotation of `X(G)`. -/
def rotPlus (k : G.BlackDart) : G.TripleDart :=
  match G.legIndex k with
  | some i => .del' (finRotate _ (sourceIndex i))
  | none => .minus k

/-- The image of `x⁻_k` under the rotation of `X(G)`. -/
def rotMinus (k : G.BlackDart) : G.TripleDart :=
  match h : G.legIndex k with
  | some i => .del' (finRotate _ (targetIndex i))
  | none => .plus ⟨G.inv (G.rot (G.inv k)), (hG.psi_mem k.2 h).1⟩

/-- The image of `x⁺_k` under the inverse rotation of `X(G)`. -/
def rotInvPlus (k : G.BlackDart) : G.TripleDart :=
  match h : G.legIndex k with
  | some i => .del (sourceIndex i)
  | none => .minus ⟨G.inv (G.rot.symm (G.inv k)), (hG.psiInv_mem k.2 h).1⟩

omit hG in
/-- The image of `x⁻_k` under the inverse rotation of `X(G)`. -/
def rotInvMinus (k : G.BlackDart) : G.TripleDart :=
  match G.legIndex k with
  | some i => .del (targetIndex i)
  | none => .plus k

/-- The involution of `X(G)` is its own inverse. -/
theorem tripleInv_symm (z : G.TripleDart) : hG.tripleInv.symm z = hG.tripleInv z := by
  rcases z with _ | _ | _ | _ <;> rfl

/-- The rotation of `X(G)` as a function. -/
def tripleRotFun : G.TripleDart → G.TripleDart
  | .plus k => rotPlus k
  | .minus k => hG.rotMinus k
  | .del r => hG.endDart r
  | .del' r => .del ((finRotate _).symm r)

/-- The inverse of the rotation of `X(G)` as a function. -/
def tripleRotInvFun : G.TripleDart → G.TripleDart
  | .plus k => hG.rotInvPlus k
  | .minus k => rotInvMinus k
  | .del r => .del' (finRotate _ r)
  | .del' r => hG.endDart ((finRotate _).symm r)

/-- For `k = ḡ_i`, the rotation of `X(G)` takes `x⁺_k` to `∂'_{2i}`. -/
theorem tripleRotFun_plus_of_some {k : G.BlackDart} {i : Fin b} (h : G.legIndex k = some i) :
    hG.tripleRotFun (.plus k) = .del' (finRotate _ (sourceIndex i)) := by
  simp only [tripleRotFun, rotPlus, h]

/-- For `k` not the reverse of a leg, the rotation of `X(G)` takes `x⁺_k` to `x⁻_k`. -/
theorem tripleRotFun_plus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.tripleRotFun (.plus k) = .minus k := by
  simp only [tripleRotFun, rotPlus, h]

/-- For `k = ḡ_i`, the rotation of `X(G)` takes `x⁻_k` to `∂'_{2i+1}`. -/
theorem tripleRotFun_minus_of_some {k : G.BlackDart} {i : Fin b} (h : G.legIndex k = some i) :
    hG.tripleRotFun (.minus k) = .del' (finRotate _ (targetIndex i)) := by
  simp only [tripleRotFun, rotMinus]
  split
  · simp_all
  · simp_all

/-- For `k` not the reverse of a leg, the rotation of `X(G)` takes `x⁻_k` to
`x⁺_{\overline{σ(k̄)}}`. -/
theorem tripleRotFun_minus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.tripleRotFun (.minus k) = .plus ⟨G.inv (G.rot (G.inv k)), (hG.psi_mem k.2 h).1⟩ := by
  simp only [tripleRotFun, rotMinus]
  split
  · simp_all
  · rfl

/-- For `k = ḡ_i`, the inverse rotation of `X(G)` takes `x⁺_k` to `∂_{2i-1}`. -/
theorem tripleRotInvFun_plus_of_some {k : G.BlackDart} {i : Fin b}
    (h : G.legIndex k = some i) : hG.tripleRotInvFun (.plus k) = .del (sourceIndex i) := by
  simp only [tripleRotInvFun, rotInvPlus]
  split
  · simp_all
  · simp_all

/-- For `k` not the reverse of a leg, the inverse rotation of `X(G)` takes `x⁺_k` to
`x⁻_{\overline{σ⁻¹(k̄)}}`. -/
theorem tripleRotInvFun_plus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.tripleRotInvFun (.plus k) =
      .minus ⟨G.inv (G.rot.symm (G.inv k)), (hG.psiInv_mem k.2 h).1⟩ := by
  simp only [tripleRotInvFun, rotInvPlus]
  split
  · simp_all
  · rfl

/-- For `k = ḡ_i`, the inverse rotation of `X(G)` takes `x⁻_k` to `∂_{2i}`. -/
theorem tripleRotInvFun_minus_of_some {k : G.BlackDart} {i : Fin b}
    (h : G.legIndex k = some i) : hG.tripleRotInvFun (.minus k) = .del (targetIndex i) := by
  simp only [tripleRotInvFun, rotInvMinus, h]

/-- For `k` not the reverse of a leg, the inverse rotation of `X(G)` takes `x⁻_k` to `x⁺_k`. -/
theorem tripleRotInvFun_minus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.tripleRotInvFun (.minus k) = .plus k := by
  simp only [tripleRotInvFun, rotInvMinus, h]

/-- The label of `ḡ_i ∈ K` is `i`. -/
theorem legIndex_invLeg (i : Fin b) : G.legIndex (hG.invLeg i) = some i :=
  hG.legIndex_inv_leg i

/-- A dart `k ∈ K` with label `i` is `ḡ_i`. -/
theorem eq_invLeg_of_legIndex {k : G.BlackDart} {i : Fin b} (h : G.legIndex k = some i) :
    k = hG.invLeg i :=
  Subtype.ext (inv_leg_of_legIndex_eq_some h).symm

/-- The rotation of `X(G)` takes `n_r` to `∂'_{r+1}`. -/
theorem tripleRotFun_endDart (r : Fin (2 * b)) :
    hG.tripleRotFun (hG.endDart r) = .del' (finRotate _ r) := by
  rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩
  · rw [endDart_sourceIndex, hG.tripleRotFun_plus_of_some (hG.legIndex_invLeg i)]
  · rw [endDart_targetIndex, hG.tripleRotFun_minus_of_some (hG.legIndex_invLeg i)]

/-- The inverse rotation of `X(G)` takes `n_r` to `∂_r`. -/
theorem tripleRotInvFun_endDart (r : Fin (2 * b)) :
    hG.tripleRotInvFun (hG.endDart r) = .del r := by
  rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩
  · rw [endDart_sourceIndex, hG.tripleRotInvFun_plus_of_some (hG.legIndex_invLeg i)]
  · rw [endDart_targetIndex, hG.tripleRotInvFun_minus_of_some (hG.legIndex_invLeg i)]

/-- The map `k ↦ \overline{σ⁻¹(k̄)}` is a left inverse of `k ↦ \overline{σ(k̄)}`. -/
theorem psiInv_psi (k : H) : G.inv (G.rot.symm (G.inv (G.inv (G.rot (G.inv k))))) = k := by
  rw [hG.inv_inv, Equiv.symm_apply_apply, hG.inv_inv]

/-- The map `k ↦ \overline{σ⁻¹(k̄)}` is a right inverse of `k ↦ \overline{σ(k̄)}`. -/
theorem psi_psiInv (k : H) : G.inv (G.rot (G.inv (G.inv (G.rot.symm (G.inv k))))) = k := by
  rw [hG.inv_inv, Equiv.apply_symm_apply, hG.inv_inv]

/-- The rotation `σ_X` of `X(G)`: for `k ∈ K` with `v(k̄)` internal, `x⁺_k ↦ x⁻_k` and
`x⁻_k ↦ x⁺_{\overline{σ(k̄)}}`; for `k = ḡ_i`, the cycles `(∂'_{2i}, ∂_{2i-1}, x⁺_k)` and
`(∂'_{2i+1}, ∂_{2i}, x⁻_k)`. -/
def tripleRot : Equiv.Perm G.TripleDart where
  toFun := hG.tripleRotFun
  invFun := hG.tripleRotInvFun
  left_inv := by
    rintro (k | k | r | r)
    · rcases h : G.legIndex k with _ | i
      · rw [hG.tripleRotFun_plus_of_none h, hG.tripleRotInvFun_minus_of_none h]
      · rw [hG.tripleRotFun_plus_of_some h, tripleRotInvFun, Equiv.symm_apply_apply,
          endDart_sourceIndex, hG.eq_invLeg_of_legIndex h]
    · rcases h : G.legIndex k with _ | i
      · rw [hG.tripleRotFun_minus_of_none h,
          hG.tripleRotInvFun_plus_of_none (hG.psi_mem k.2 h).2]
        congr 1
        exact Subtype.ext (hG.psiInv_psi k)
      · rw [hG.tripleRotFun_minus_of_some h, tripleRotInvFun, Equiv.symm_apply_apply,
          endDart_targetIndex, hG.eq_invLeg_of_legIndex h]
    · exact hG.tripleRotInvFun_endDart r
    · simp only [tripleRotFun, tripleRotInvFun, Equiv.apply_symm_apply]
  right_inv := by
    rintro (k | k | r | r)
    · rcases h : G.legIndex k with _ | i
      · rw [hG.tripleRotInvFun_plus_of_none h,
          hG.tripleRotFun_minus_of_none (hG.psiInv_mem k.2 h).2]
        congr 1
        exact Subtype.ext (hG.psi_psiInv k)
      · rw [hG.tripleRotInvFun_plus_of_some h, tripleRotFun, hG.eq_invLeg_of_legIndex h,
          endDart_sourceIndex]
    · rcases h : G.legIndex k with _ | i
      · rw [hG.tripleRotInvFun_minus_of_none h, hG.tripleRotFun_plus_of_none h]
      · rw [hG.tripleRotInvFun_minus_of_some h, tripleRotFun, hG.eq_invLeg_of_legIndex h,
          endDart_targetIndex]
    · simp only [tripleRotFun, tripleRotInvFun, Equiv.symm_apply_apply]
    · exact (hG.tripleRotFun_endDart _).trans (by rw [Equiv.apply_symm_apply])

/-- The dart `ψ(k) = \overline{σ(k̄)}` of `K`, for `k ∈ K` not the reverse of a leg. -/
def psi (k : G.BlackDart) (h : G.legIndex k = none) : G.BlackDart :=
  ⟨G.inv (G.rot (G.inv k)), (hG.psi_mem k.2 h).1⟩

/-- The dart `ψ(k)` is not the reverse of a leg. -/
theorem legIndex_psi (k : G.BlackDart) (h : G.legIndex k = none) :
    G.legIndex (hG.psi k h) = none :=
  (hG.psi_mem k.2 h).2

/-- As a dart of `G`, `ψ(k)` is `\overline{σ(k̄)}`. -/
@[simp]
theorem coe_psi (k : G.BlackDart) (h : G.legIndex k = none) :
    (hG.psi k h : H) = G.inv (G.rot (G.inv k)) := rfl

/-- The rotation `σ_X` takes `∂_r` to `n_r`. -/
@[simp] theorem tripleRot_del (r : Fin (2 * b)) : hG.tripleRot (.del r) = hG.endDart r := rfl

/-- The rotation `σ_X` takes `∂'_r` to `∂_{r-1}`. -/
@[simp] theorem tripleRot_del' (r : Fin (2 * b)) :
    hG.tripleRot (.del' r) = .del ((finRotate _).symm r) := rfl

/-- The rotation `σ_X` takes `n_r` to `∂'_{r+1}`. -/
theorem tripleRot_endDart (r : Fin (2 * b)) :
    hG.tripleRot (hG.endDart r) = .del' (finRotate _ r) :=
  hG.tripleRotFun_endDart r

/-- For `k = ḡ_i`, the rotation `σ_X` takes `x⁺_k` to `∂'_{2i}`. -/
theorem tripleRot_plus_of_some {k : G.BlackDart} {i : Fin b} (h : G.legIndex k = some i) :
    hG.tripleRot (.plus k) = .del' (finRotate _ (sourceIndex i)) :=
  hG.tripleRotFun_plus_of_some h

/-- For `k` not the reverse of a leg, the rotation `σ_X` takes `x⁺_k` to `x⁻_k`. -/
theorem tripleRot_plus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.tripleRot (.plus k) = .minus k :=
  hG.tripleRotFun_plus_of_none h

/-- For `k = ḡ_i`, the rotation `σ_X` takes `x⁻_k` to `∂'_{2i+1}`. -/
theorem tripleRot_minus_of_some {k : G.BlackDart} {i : Fin b} (h : G.legIndex k = some i) :
    hG.tripleRot (.minus k) = .del' (finRotate _ (targetIndex i)) :=
  hG.tripleRotFun_minus_of_some h

/-- For `k` not the reverse of a leg, the rotation `σ_X` takes `x⁻_k` to `x⁺_{ψ(k)}`. -/
theorem tripleRot_minus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.tripleRot (.minus k) = .plus (hG.psi k h) :=
  hG.tripleRotFun_minus_of_none h

/-- The endpoint dart `n_r` is not a dart of the boundary circle. -/
@[simp]
theorem isDel_endDart (r : Fin (2 * b)) : (hG.endDart r).isDel = false := by
  rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩ <;> simp

end IsNormalPlabicPregraph

/-! ### The triple diagram `X(G)` -/

variable (G) in
/-- **The triple diagram `X(G)` of a normal plabic (pre)graph**. Its darts are the symbols
`x⁺_k`, `x⁻_k` for `k ∈ K` (the darts of `G` at black vertices) and `∂_r`, `∂'_r` for
`r ∈ [1, 2b]` (`G.TripleDart`). The involution pairs `x⁺_k` with `x⁻_{σ(k)}` and `∂_r` with
`∂'_r`. The rotation `σ_X` sends, for `k ∈ K` with `v(k̄)` internal, `x⁺_k ↦ x⁻_k` and
`x⁻_k ↦ x⁺_{\overline{σ(k̄)}}`, and for `k = ḡ_i` consists of the cycles
`(∂'_{2i}, ∂_{2i-1}, x⁺_k)` and `(∂'_{2i+1}, ∂_{2i}, x⁻_k)` (indices modulo `2b`). The set `B_X`
is `{∂_r, ∂'_r}`, the endpoints `ε(2i - 1)`, `ε(2i)` are the vertices of `x⁺_{ḡ_i}`, `x⁻_{ḡ_i}`,
and `o(x⁺_k) = out`, `o(x⁻_k) = in`.

Labels are `0`-indexed: the endpoint label `r : Fin (2 * b)` stands for `r + 1`, so `∂_{2i-1}`,
`∂_{2i}` for the arc label `i + 1` are `del (sourceIndex i)`, `del (targetIndex i)`, and `∂'_{2i}`,
`∂'_{2i+1}` are `del' (targetIndex i)`, `del' (finRotate _ (targetIndex i))`. -/
@[cluster_algebras "def_triple_diagram_of_normal"]
def tripleOfNormal (hG : G.IsNormalPlabicPregraph) : TripleData G.TripleDart b where
  inv := hG.tripleInv
  rot := hG.tripleRot
  bdry := univ.filter fun z => z.isDel
  endDart := hG.endDart
  isOut := TripleOfNormalDart.isPlus

/-- The darts at internal vertices which are not white are exactly the black darts. -/
theorem filter_internal_not_white_eq_blackDarts :
    (((univ : Finset H).filter fun d => ¬G.IsBoundaryVertex (G.vertexOf d)).filter
      fun d => ¬G.colour d = .white) = G.blackDarts := by
  ext d
  simp only [mem_filter, mem_univ, true_and, mem_blackDarts]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, ?_⟩
    cases hc : G.colour d
    · exact absurd hc h2
    · rfl
  · rintro ⟨h1, h2⟩
    exact ⟨h1, by rw [h2]; exact Shade.noConfusion⟩

namespace IsNormalPlabicPregraph

variable (hG : G.IsNormalPlabicPregraph)

/-- The involution of `X(G)` is `tripleInv`. -/
@[simp] theorem tripleOfNormal_inv : (G.tripleOfNormal hG).inv = hG.tripleInv := rfl
/-- The rotation of `X(G)` is `tripleRot`. -/
@[simp] theorem tripleOfNormal_rot : (G.tripleOfNormal hG).rot = hG.tripleRot := rfl
/-- The endpoint darts of `X(G)` are the darts `n_r`. -/
@[simp] theorem tripleOfNormal_endDart : (G.tripleOfNormal hG).endDart = hG.endDart := rfl
/-- The darts of `X(G)` oriented `out` are the darts `x⁺_k`. -/
@[simp] theorem tripleOfNormal_isOut :
    (G.tripleOfNormal hG).isOut = TripleOfNormalDart.isPlus := rfl

/-- The set `B_X` of `X(G)` consists of the darts `∂_r`, `∂'_r`. -/
@[simp]
theorem mem_tripleOfNormal_bdry {z : G.TripleDart} :
    z ∈ (G.tripleOfNormal hG).bdry ↔ z.isDel = true := by
  simp [tripleOfNormal]

/-- The vertex of `X(G)` through `∂_r` is the endpoint `{∂_r, n_r, ∂'_{r+1}}`. -/
theorem vertexOf_tripleOfNormal_del (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).vertexOf (.del r) = {.del r, hG.endDart r, .del' (finRotate _ r)} :=
  RotationSystem.vertexOf_eq_three _ rfl (hG.tripleRot_endDart r)
    (by simp only [tripleOfNormal_rot, tripleRot_del', Equiv.symm_apply_apply])

/-- The vertex of `X(G)` through `∂'_r` is the vertex through `∂_{r-1}`. -/
theorem vertexOf_tripleOfNormal_del' (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).vertexOf (.del' r) =
      (G.tripleOfNormal hG).vertexOf (.del ((finRotate _).symm r)) := by
  rw [← RotationSystem.vertexOf_rot]
  rfl

/-- The vertex of `X(G)` through `n_r` is the vertex through `∂_r`. -/
theorem vertexOf_tripleOfNormal_endDart (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).vertexOf (hG.endDart r) =
      (G.tripleOfNormal hG).vertexOf (.del r) := by
  rw [← RotationSystem.vertexOf_rot _ (TripleOfNormalDart.del r)]
  rfl

/-- The map `φ_X` takes `∂_r` to `∂_{r-1}`. -/
theorem facePerm_tripleOfNormal_del (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).facePerm (.del r) = .del ((finRotate _).symm r) := rfl

/-- The orbit of `φ_X` through `∂_r` is `{∂_s : s ∈ [1, 2b]}`. -/
theorem faceOf_tripleOfNormal_del (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).faceOf (.del r) = univ.image TripleOfNormalDart.del := by
  have hb := hG.one_le
  have key : ∀ (n : ℕ) (hn : n < 2 * b), (G.tripleOfNormal hG).facePerm.SameCycle
      (.del ⟨n, hn⟩) (.del ⟨0, by omega⟩) := by
    intro n
    induction n with
    | zero => exact fun _ => Equiv.Perm.SameCycle.refl _ _
    | succ n ih =>
      intro hn
      have h1 : (G.tripleOfNormal hG).facePerm (.del ⟨n + 1, hn⟩) = .del ⟨n, by omega⟩ := by
        rw [facePerm_tripleOfNormal_del]
        congr 1
        rw [Equiv.symm_apply_eq, finRotate_mk_of_succ_lt hn]
      have h2 : (G.tripleOfNormal hG).facePerm.SameCycle (.del ⟨n + 1, hn⟩)
          ((G.tripleOfNormal hG).facePerm (.del ⟨n + 1, hn⟩)) :=
        Equiv.Perm.sameCycle_apply_right.2 (Equiv.Perm.SameCycle.refl _ _)
      rw [h1] at h2
      exact h2.trans (ih (by omega))
  refine RotationSystem.faceOf_eq_of_closed _ ?_ (by simp) ?_
  · intro y hy
    obtain ⟨s, -, rfl⟩ := mem_image.1 hy
    rw [facePerm_tripleOfNormal_del]
    exact mem_image_of_mem _ (mem_univ _)
  · intro y hy
    obtain ⟨s, -, rfl⟩ := mem_image.1 hy
    exact (key r r.2).trans (key s s.2).symm

/-- A boundary vertex of `X(G)` is the vertex of some `∂_r`. -/
theorem exists_vertexOf_tripleOfNormal_eq_del {z : G.TripleDart}
    (hz : (G.tripleOfNormal hG).IsBoundaryVertex ((G.tripleOfNormal hG).vertexOf z)) :
    ∃ r, (G.tripleOfNormal hG).vertexOf z =
      (G.tripleOfNormal hG).vertexOf (TripleOfNormalDart.del r) := by
  obtain ⟨d, hd, hdB⟩ := hz
  rw [← RotationSystem.vertexOf_eq_of_mem _ hd]
  rw [mem_tripleOfNormal_bdry] at hdB
  rcases d with k | k | r | r
  · simp at hdB
  · simp at hdB
  · exact ⟨r, rfl⟩
  · exact ⟨_, vertexOf_tripleOfNormal_del' hG r⟩

/-- The vertex of `X(G)` through `∂_r` is a boundary vertex. -/
theorem isBoundaryVertex_tripleOfNormal_del (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).IsBoundaryVertex ((G.tripleOfNormal hG).vertexOf (.del r)) :=
  ⟨.del r, RotationSystem.self_mem_vertexOf _ _, by simp⟩

/-- A dart `x⁺_k` with `k` the reverse of a leg lies at an endpoint. -/
theorem isBoundaryVertex_tripleOfNormal_plus_of_some {k : G.BlackDart} {i : Fin b}
    (h : G.legIndex k = some i) :
    (G.tripleOfNormal hG).IsBoundaryVertex ((G.tripleOfNormal hG).vertexOf (.plus k)) := by
  refine ⟨_, RotationSystem.rot_mem_vertexOf _ _, ?_⟩
  rw [tripleOfNormal_rot, hG.tripleRot_plus_of_some h, mem_tripleOfNormal_bdry]
  rfl

/-- A dart `x⁻_k` with `k` the reverse of a leg lies at an endpoint. -/
theorem isBoundaryVertex_tripleOfNormal_minus_of_some {k : G.BlackDart} {i : Fin b}
    (h : G.legIndex k = some i) :
    (G.tripleOfNormal hG).IsBoundaryVertex ((G.tripleOfNormal hG).vertexOf (.minus k)) := by
  refine ⟨_, RotationSystem.rot_mem_vertexOf _ _, ?_⟩
  rw [tripleOfNormal_rot, hG.tripleRot_minus_of_some h, mem_tripleOfNormal_bdry]
  rfl

/-- At a white vertex `w` of `G` the darts `ȳ` with `y ∈ w` form a `3`-cycle under `ψ`. -/
theorem psi_psi_psi {k : G.BlackDart} (h : G.legIndex k = none) :
    hG.psi (hG.psi (hG.psi k h) (hG.legIndex_psi k h))
      (hG.legIndex_psi _ (hG.legIndex_psi k h)) = k ∧
    k ≠ hG.psi k h ∧ k ≠ hG.psi (hG.psi k h) (hG.legIndex_psi k h) ∧
    hG.psi k h ≠ hG.psi (hG.psi k h) (hG.legIndex_psi k h) := by
  have hi := hG.not_isBoundaryVertex_inv k.2 h
  have hw := hG.colour_inv k.2 h
  obtain ⟨h3, h1, h2⟩ := RotationSystem.rot_rot_rot_of_card_eq_three _
    (hG.card_vertexOf_of_white _ hi hw)
  refine ⟨Subtype.ext ?_, fun he => h1 ?_, fun he => h2 ?_, fun he => h1 ?_⟩
  · simp only [coe_psi, hG.inv_inv]
    rw [h3, hG.inv_inv]
  · have := congrArg (fun x : G.BlackDart => G.inv (x : H)) he
    simp only [coe_psi, hG.inv_inv] at this
    exact this.symm
  · have := congrArg (fun x : G.BlackDart => G.inv (x : H)) he
    simp only [coe_psi, hG.inv_inv] at this
    exact this.symm
  · have := congrArg (fun x : G.BlackDart => G.inv (x : H)) he
    simp only [coe_psi, hG.inv_inv] at this
    exact (G.rot.injective this).symm

/-- The vertex of `X(G)` through `x⁺_k`, for `k ∈ K` with `v(k̄)` a white vertex, is the `6`-cycle
`(x⁺_k, x⁻_k, x⁺_{ψ k}, x⁻_{ψ k}, x⁺_{ψ² k}, x⁻_{ψ² k})`. -/
theorem vertexOf_tripleOfNormal_plus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    (G.tripleOfNormal hG).vertexOf (.plus k) =
      {.plus k, .minus k, .plus (hG.psi k h), .minus (hG.psi k h),
        .plus (hG.psi (hG.psi k h) (hG.legIndex_psi k h)),
        .minus (hG.psi (hG.psi k h) (hG.legIndex_psi k h))} := by
  have h' := hG.legIndex_psi k h
  have h'' := hG.legIndex_psi _ h'
  refine RotationSystem.vertexOf_eq_six _ (hG.tripleRot_plus_of_none h)
    (hG.tripleRot_minus_of_none h) (hG.tripleRot_plus_of_none h') (hG.tripleRot_minus_of_none h')
    (hG.tripleRot_plus_of_none h'') ?_
  rw [tripleOfNormal_rot, hG.tripleRot_minus_of_none h'', (hG.psi_psi_psi h).1]

/-- For `k` not the reverse of a leg, the vertex of `X(G)` through `x⁺_k` has six darts. -/
theorem card_vertexOf_tripleOfNormal_plus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    ((G.tripleOfNormal hG).vertexOf (.plus k)).card = 6 := by
  obtain ⟨-, h1, h2, h3⟩ := hG.psi_psi_psi h
  rw [hG.vertexOf_tripleOfNormal_plus_of_none h]
  repeat rw [card_insert_of_notMem]
  · rw [card_singleton]
  all_goals simp [h1, h2, h3]

/-- The vertex of `X(G)` through `∂_r` has three darts. -/
theorem card_vertexOf_tripleOfNormal_del (r : Fin (2 * b)) :
    ((G.tripleOfNormal hG).vertexOf (.del r)).card = 3 := by
  rw [vertexOf_tripleOfNormal_del]
  have h1 : hG.endDart r ∉ ({.del' (finRotate _ r)} : Finset G.TripleDart) := by
    intro h'
    have := congrArg TripleOfNormalDart.isDel (mem_singleton.1 h')
    simp at this
  have h2 : (.del r : G.TripleDart) ∉ ({hG.endDart r, .del' (finRotate _ r)} : Finset _) := by
    intro h'
    rcases mem_insert.1 h' with h' | h'
    · have := congrArg TripleOfNormalDart.isDel h'
      simp at this
    · simp at h'
  rw [card_insert_of_notMem h2, card_insert_of_notMem h1, card_singleton]

/-- For `k` not the reverse of a leg, `x⁻_k` and `x⁺_k` lie on the same vertex of `X(G)`. -/
theorem vertexOf_tripleOfNormal_minus_of_none {k : G.BlackDart} (h : G.legIndex k = none) :
    (G.tripleOfNormal hG).vertexOf (.minus k) = (G.tripleOfNormal hG).vertexOf (.plus k) := by
  rw [← RotationSystem.vertexOf_rot _ (TripleOfNormalDart.plus k), tripleOfNormal_rot,
    hG.tripleRot_plus_of_none h]

/-- **`X(G)` is a pre-triple diagram**: for a normal plabic pregraph `G` with `b` boundary
vertices, `X(G)` is a pre-triple diagram with `b` arcs. -/
@[cluster_algebras "lem_triple_of_normal_pre"]
theorem isPreTripleDiagram_tripleOfNormal : (G.tripleOfNormal hG).IsPreTripleDiagram where
  one_le := hG.one_le
  nonempty := ⟨.del ⟨0, by have := hG.one_le; omega⟩⟩
  inv_involutive := by rintro (_ | _ | _ | _) <;> simp
  inv_ne := by rintro (_ | _ | _ | _) <;> simp
  inv_mem_bdry := by rintro (_ | _ | _ | _) <;> simp
  boundaryVertex_card := by
    intro v hv
    obtain ⟨hvV, hvB⟩ := DiskMap.mem_boundaryVertices _ |>.1 hv
    obtain ⟨z, rfl⟩ := RotationSystem.mem_vertices _ |>.1 hvV
    obtain ⟨r, hr⟩ := exists_vertexOf_tripleOfNormal_eq_del hG hvB
    rw [hr]
    refine ⟨hG.card_vertexOf_tripleOfNormal_del r, ?_⟩
    rw [vertexOf_tripleOfNormal_del]
    have : ({.del r, hG.endDart r, .del' (finRotate _ r)} : Finset G.TripleDart).filter
        (· ∈ (G.tripleOfNormal hG).bdry) = {.del r, .del' (finRotate _ r)} := by
      ext z
      simp only [mem_filter, mem_insert, mem_singleton, mem_tripleOfNormal_bdry]
      aesop
    rw [this, card_pair (by simp)]
  exists_orbit := by
    have hb := hG.one_le
    refine ⟨univ.image TripleOfNormalDart.del, ?_, ?_, ?_, ?_⟩
    · rw [← hG.faceOf_tripleOfNormal_del ⟨0, by omega⟩]
      exact RotationSystem.faceOf_mem_faceOrbits _ _
    · intro z hz
      obtain ⟨s, -, rfl⟩ := mem_image.1 hz
      simp
    · ext z
      rcases z with k | k | r | r <;>
        simp [mem_map_equiv, tripleOfNormal_inv, hG.tripleInv_symm]
    · rw [disjoint_left]
      intro z hz hz'
      obtain ⟨s, -, rfl⟩ := mem_image.1 hz
      simp [mem_map_equiv, hG.tripleInv_symm] at hz'
  internalVertex_card := by
    intro v hv
    obtain ⟨hvV, hvB⟩ := DiskMap.mem_internalVertices _ |>.1 hv
    obtain ⟨z, rfl⟩ := RotationSystem.mem_vertices _ |>.1 hvV
    rcases z with k | k | r | r
    · rcases h : G.legIndex k with _ | i
      · exact hG.card_vertexOf_tripleOfNormal_plus_of_none h
      · exact absurd (hG.isBoundaryVertex_tripleOfNormal_plus_of_some h) hvB
    · rcases h : G.legIndex k with _ | i
      · rw [hG.vertexOf_tripleOfNormal_minus_of_none h]
        exact hG.card_vertexOf_tripleOfNormal_plus_of_none h
      · exact absurd (hG.isBoundaryVertex_tripleOfNormal_minus_of_some h) hvB
    · exact absurd ⟨_, RotationSystem.self_mem_vertexOf _ _, by simp⟩ hvB
    · exact absurd ⟨_, RotationSystem.self_mem_vertexOf _ _, by simp⟩ hvB
  endDart_notMem_bdry r := by simp
  endpoint_mem r := by
    rw [TripleData.endpoint, tripleOfNormal_endDart, vertexOf_tripleOfNormal_endDart]
    exact (DiskMap.mem_boundaryVertices _).2 ⟨RotationSystem.vertexOf_mem_vertices _ _,
      isBoundaryVertex_tripleOfNormal_del hG r⟩
  endpoint_injective r s hrs := by
    simp only [TripleData.endpoint, tripleOfNormal_endDart, vertexOf_tripleOfNormal_endDart,
      vertexOf_tripleOfNormal_del] at hrs
    have : (.del r : G.TripleDart) ∈
        ({.del s, hG.endDart s, .del' (finRotate _ s)} : Finset G.TripleDart) := by
      rw [← hrs]; simp
    rcases mem_insert.1 this with h' | h'
    · simpa using h'
    rcases mem_insert.1 h' with h' | h'
    · have := congrArg TripleOfNormalDart.isDel h'
      simp at this
    · simp at h'
  exists_endpoint_eq v hv := by
    obtain ⟨hvV, hvB⟩ := DiskMap.mem_boundaryVertices _ |>.1 hv
    obtain ⟨z, rfl⟩ := RotationSystem.mem_vertices _ |>.1 hvV
    obtain ⟨r, hr⟩ := exists_vertexOf_tripleOfNormal_eq_del hG hvB
    refine ⟨r, ?_⟩
    rw [hr, TripleData.endpoint, tripleOfNormal_endDart, vertexOf_tripleOfNormal_endDart]
  exists_exterior r := by
    refine ⟨.del (finRotate _ r), ?_, ?_, ?_⟩
    · rw [DiskMap.mem_exterior]
      simp
    · rw [TripleData.endpoint, tripleOfNormal_endDart, vertexOf_tripleOfNormal_endDart]
      exact RotationSystem.self_mem_vertexOf _ _
    · rw [TripleData.endpoint, tripleOfNormal_endDart, vertexOf_tripleOfNormal_endDart,
        vertexOf_tripleOfNormal_del]
      simp
  isOut_inv := by rintro (_ | _ | _ | _) h <;> simp at h ⊢
  isOut_rot := by
    rintro (k | k | r | r) hz
    · rcases h : G.legIndex k with _ | i
      · simp [hG.tripleRot_plus_of_none h]
      · exact absurd (hG.isBoundaryVertex_tripleOfNormal_plus_of_some h) hz
    · rcases h : G.legIndex k with _ | i
      · simp [hG.tripleRot_minus_of_none h]
      · exact absurd (hG.isBoundaryVertex_tripleOfNormal_minus_of_some h) hz
    · exact absurd ⟨_, RotationSystem.self_mem_vertexOf _ _, by simp⟩ hz
    · exact absurd ⟨_, RotationSystem.self_mem_vertexOf _ _, by simp⟩ hz
  isOut_source i := by simp
  isOut_target i := by simp

/-! ### Transitivity -/

include hG in
/-- In a normal plabic pregraph, consecutive legs reach each other. -/
private theorem reach_leg_finRotate (i : Fin b) :
    G.Reach (G.leg i) (G.leg (finRotate b i)) := by
  obtain ⟨d, -, hd, hdi⟩ := hG.exists_exterior i
  have h1 : G.Reach (G.leg i) (G.inv d) := RotationSystem.reach_of_mem_vertexOf _ hdi
  have h2 : G.Reach (G.leg (finRotate b i)) d := RotationSystem.reach_of_mem_vertexOf _ hd
  have h3 : G.Reach (G.inv d) d := by
    have := (RotationSystem.Reach.refl (G.inv d)).inv (R := G.toRotationSystem)
    rwa [hG.inv_inv] at this
  exact h1.trans (h3.trans h2.symm)

include hG in
/-- In a normal plabic pregraph, all legs reach each other. -/
private theorem reach_leg (i j : Fin b) : G.Reach (G.leg i) (G.leg j) := by
  have hb := hG.one_le
  have key : ∀ (n : ℕ) (hn : n < b), G.Reach (G.leg ⟨0, by omega⟩) (G.leg ⟨n, hn⟩) := by
    intro n
    induction n with
    | zero => exact fun _ => RotationSystem.Reach.refl _
    | succ n ih =>
      intro hn
      have h := hG.reach_leg_finRotate ⟨n, by omega⟩
      rw [finRotate_mk_of_succ_lt hn] at h
      exact (ih (by omega)).trans h
  exact (key i i.2).symm.trans (key j j.2)

/-- `x⁺_k` and `x⁻_k` are joined in `X(G)`. -/
private theorem reach_plus_minus (k : G.BlackDart) :
    (G.tripleOfNormal hG).Reach (.plus k) (.minus k) := by
  rcases h : G.legIndex k with _ | i
  · have := (RotationSystem.Reach.refl (R := (G.tripleOfNormal hG).toRotationSystem)
      (.plus k)).rot
    rwa [tripleOfNormal_rot, hG.tripleRot_plus_of_none h] at this
  · have h1 := ((RotationSystem.Reach.refl (R := (G.tripleOfNormal hG).toRotationSystem)
      (.plus k)).rot.inv).rot
    rwa [tripleOfNormal_rot, hG.tripleRot_plus_of_some h, finRotate_sourceIndex,
      tripleOfNormal_inv, tripleInv_del', tripleRot_del, endDart_targetIndex,
      ← hG.eq_invLeg_of_legIndex h] at h1

/-- All darts `∂_r` of `X(G)` are joined. -/
private theorem reach_del (r s : Fin (2 * b)) :
    (G.tripleOfNormal hG).Reach (.del r) (.del s) := by
  have hb := hG.one_le
  have key : ∀ (n : ℕ) (hn : n < 2 * b),
      (G.tripleOfNormal hG).Reach (.del ⟨n, hn⟩) (.del ⟨0, by omega⟩) := by
    intro n
    induction n with
    | zero => exact fun _ => RotationSystem.Reach.refl _
    | succ n ih =>
      intro hn
      have h1 := (RotationSystem.Reach.refl (R := (G.tripleOfNormal hG).toRotationSystem)
        (.del ⟨n + 1, hn⟩)).inv.rot
      have he : (finRotate (2 * b)).symm ⟨n + 1, hn⟩ = ⟨n, by omega⟩ := by
        rw [Equiv.symm_apply_eq, finRotate_mk_of_succ_lt hn]
      rw [tripleOfNormal_inv, tripleInv_del, tripleOfNormal_rot, tripleRot_del', he] at h1
      exact h1.trans (ih (by omega))
  exact (key r r.2).trans (key s s.2).symm

private theorem reach_plus_invLeg_del (r : Fin (2 * b)) (i : Fin b) :
    (G.tripleOfNormal hG).Reach (.plus (hG.invLeg i)) (.del r) := by
  have h1 := (RotationSystem.Reach.refl (R := (G.tripleOfNormal hG).toRotationSystem)
    (.del (sourceIndex i))).rot
  rw [tripleOfNormal_rot, tripleRot_del, endDart_sourceIndex] at h1
  exact h1.symm.trans (hG.reach_del _ _)

private theorem reach_del_of_reach (hGt : ∀ d e : H, G.Reach d e) (r : Fin (2 * b)) (d : H) :
    (∀ hk : d ∈ G.blackDarts, (G.tripleOfNormal hG).Reach (.plus ⟨d, hk⟩) (.del r)) ∧
      (∀ hk : G.inv d ∈ G.blackDarts, ¬G.IsBoundaryVertex (G.vertexOf d) →
        (G.tripleOfNormal hG).Reach (.plus ⟨G.inv d, hk⟩) (.del r)) := by
  have hb := hG.one_le
  set i₀ : Fin b := ⟨0, by omega⟩
  induction hGt (G.leg i₀) d with
  | refl =>
    refine ⟨fun hk => ?_, fun _ hi => absurd (hG.isBoundaryVertex_leg i₀) hi⟩
    exact absurd (hG.isBoundaryVertex_leg i₀) (mem_blackDarts.1 hk).1
  | @rot e _ ih =>
    refine ⟨fun hk => ?_, fun hk hi => ?_⟩
    · have hek : e ∈ G.blackDarts := by
        have := hG.rot_symm_mem_blackDarts hk
        rwa [Equiv.symm_apply_apply] at this
      have h2 := (RotationSystem.Reach.refl (R := (G.tripleOfNormal hG).toRotationSystem)
        (.plus (⟨e, hek⟩ : G.BlackDart))).inv
      rw [tripleOfNormal_inv, tripleInv_plus] at h2
      exact (hG.reach_plus_minus _).trans (h2.symm.trans (ih.1 hek))
    · have hi' : ¬G.IsBoundaryVertex (G.vertexOf e) := by rwa [G.vertexOf_rot] at hi
      have hwhite : G.colour e = .white := by
        cases hc : G.colour e
        · rfl
        · exfalso
          have hrb : G.colour (G.rot e) = .black := by rw [hG.colour_rot e hi', hc]
          exact hG.colour_inv_ne (G.rot e) hi (mem_blackDarts.1 hk).1
            (by rw [hrb, (mem_blackDarts.1 hk).2])
      have hek := mem_blackDarts.2 (hG.inv_black_of_white hi' hwhite)
      have h1 := ih.2 hek hi'
      have hnone : G.legIndex (⟨G.inv e, hek⟩ : G.BlackDart) = none :=
        hG.legIndex_eq_none_of_internal (by rwa [hG.inv_inv])
      have h2 := (RotationSystem.Reach.refl (R := (G.tripleOfNormal hG).toRotationSystem)
        (.minus (⟨G.inv e, hek⟩ : G.BlackDart))).rot
      rw [tripleOfNormal_rot, hG.tripleRot_minus_of_none hnone] at h2
      have he : hG.psi ⟨G.inv e, hek⟩ hnone = ⟨G.inv (G.rot e), hk⟩ :=
        Subtype.ext (by simp [hG.inv_inv])
      rw [he] at h2
      exact h2.symm.trans ((hG.reach_plus_minus _).symm.trans h1)
  | @inv e _ ih =>
    refine ⟨fun hk => ?_, fun hk hi => ?_⟩
    · by_cases hb' : G.IsBoundaryVertex (G.vertexOf e)
      · have heB : e ∉ G.bdry := fun h' =>
          notMem_bdry_of_mem_blackDarts hk (hG.inv_mem_bdry e h')
        obtain ⟨i, rfl⟩ := hG.exists_leg_eq hb' heB
        exact hG.reach_plus_invLeg_del r i
      · exact ih.2 hk hb'
    · have hek : e ∈ G.blackDarts := by rwa [hG.inv_inv] at hk
      convert ih.1 hek using 3
      exact hG.inv_inv e

private theorem reach_of_reach_tripleOfNormal
    (hXt : ∀ z z' : G.TripleDart, (G.tripleOfNormal hG).Reach z z') (d e : H) : G.Reach d e := by
  have hb := hG.one_le
  set r₀ : Fin (2 * b) := ⟨0, by omega⟩
  set i₀ : Fin b := ⟨0, by omega⟩
  let g : G.TripleDart → H
    | .plus k => k
    | .minus k => k
    | .del _ => G.leg i₀
    | .del' _ => G.leg i₀
  have hlegk : ∀ i, G.Reach (G.leg i₀) (G.inv (G.leg i)) :=
    fun i => (hG.reach_leg i₀ i).trans (RotationSystem.Reach.refl _).inv
  have hstep : ∀ e : G.TripleDart,
      G.Reach (g e) (g ((G.tripleOfNormal hG).rot e)) ∧
        G.Reach (g e) (g ((G.tripleOfNormal hG).inv e)) := by
    rintro (k | k | r | r)
    · refine ⟨?_, (RotationSystem.Reach.refl _).rot⟩
      rcases h : G.legIndex k with _ | i
      · rw [tripleOfNormal_rot, hG.tripleRot_plus_of_none h]
        exact RotationSystem.Reach.refl _
      · rw [tripleOfNormal_rot, hG.tripleRot_plus_of_some h, hG.eq_invLeg_of_legIndex h]
        exact (hlegk i).symm
    · refine ⟨?_, ?_⟩
      · rcases h : G.legIndex k with _ | i
        · rw [tripleOfNormal_rot, hG.tripleRot_minus_of_none h]
          exact (RotationSystem.Reach.refl _).inv.rot.inv
        · rw [tripleOfNormal_rot, hG.tripleRot_minus_of_some h, hG.eq_invLeg_of_legIndex h]
          exact (hlegk i).symm
      · have := (RotationSystem.Reach.refl (R := G.toRotationSystem) (G.rot.symm k)).rot
        rw [Equiv.apply_symm_apply] at this
        exact this.symm
    · refine ⟨?_, RotationSystem.Reach.refl _⟩
      rw [tripleOfNormal_rot, tripleRot_del]
      rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩
      · rw [endDart_sourceIndex]
        exact hlegk i
      · rw [endDart_targetIndex]
        exact hlegk i
    · exact ⟨RotationSystem.Reach.refl _, RotationSystem.Reach.refl _⟩
  have hg : ∀ z z', (G.tripleOfNormal hG).Reach z z' → G.Reach (g z) (g z') := by
    intro z z' h
    induction h with
    | refl => exact RotationSystem.Reach.refl _
    | rot _ ih => exact ih.trans (hstep _).1
    | inv _ ih => exact ih.trans (hstep _).2
  have hd : ∀ d : H, G.Reach d (G.leg i₀) := by
    intro d
    by_cases hb' : G.IsBoundaryVertex (G.vertexOf d)
    · obtain ⟨i, hi⟩ := hG.exists_bvertex_eq _ (G.vertexOf_mem_boundaryVertices.2 hb')
      have : d ∈ G.vertexOf (G.leg i) := by
        rw [← bvertex, hi]
        exact G.self_mem_vertexOf d
      exact (RotationSystem.reach_of_mem_vertexOf _ this).symm.trans (hG.reach_leg i i₀)
    · cases hc : G.colour d
      · exact (RotationSystem.Reach.refl _).inv.trans <| hg
          (.plus ⟨G.inv d, mem_blackDarts.2 (hG.inv_black_of_white hb' hc)⟩) (.del r₀) (hXt _ _)
      · exact hg (.plus ⟨d, mem_blackDarts.2 ⟨hb', hc⟩⟩) (.del r₀) (hXt _ _)
  exact (hd d).trans (hd e).symm

/-- **`X(G)` is connected exactly when `G` is**: for a normal plabic pregraph `G`, the group
generated by `σ` and `d ↦ d̄` acts transitively on the darts of `G` if and only if the group
generated by `σ_X` and `d ↦ d̄` acts transitively on the darts of `X(G)`. -/
@[cluster_algebras "lem_triple_of_normal_transitive"]
theorem transitive_iff_tripleOfNormal :
    (∀ d e : H, ∃ g ∈ Subgroup.closure ({G.inv, G.rot} : Set (Equiv.Perm H)), g d = e) ↔
      ∀ z z' : G.TripleDart, ∃ g ∈ Subgroup.closure
        ({(G.tripleOfNormal hG).inv, (G.tripleOfNormal hG).rot} :
          Set (Equiv.Perm G.TripleDart)), g z = z' := by
  simp only [← RotationSystem.reach_iff_exists_mem_closure]
  refine ⟨fun hGt z z' => ?_, hG.reach_of_reach_tripleOfNormal⟩
  have hb := hG.one_le
  set r₀ : Fin (2 * b) := ⟨0, by omega⟩
  have hP := hG.reach_del_of_reach hGt r₀
  have hz : ∀ z : G.TripleDart, (G.tripleOfNormal hG).Reach z (.del r₀) := by
    rintro (k | k | r | r)
    · exact (hP k).1 k.2
    · exact (hG.reach_plus_minus k).symm.trans ((hP k).1 k.2)
    · exact hG.reach_del r r₀
    · exact (RotationSystem.Reach.refl (TripleOfNormalDart.del' r)).inv.trans (hG.reach_del r r₀)
  exact (hz z).trans (hz z').symm

/-! ### The faces of `X(G)` -/

include hG in
/-- At the boundary vertex `β(j)`, `σ(g_j) = q̄` and `σ(q) = g_{j+1}`, for the dart `q ∈ B` of the
exterior at `β(j + 1)` running to `β(j)`. -/
private theorem exists_rot_leg (j : Fin b) :
    ∃ q ∈ G.bdry, G.rot (G.leg j) = G.inv q ∧ G.rot q = G.leg (finRotate b j) := by
  obtain ⟨q, hq, hqv, hqi⟩ := hG.exists_exterior j
  obtain ⟨p, hp, hpv, -⟩ := hG.exists_exterior ((finRotate b).symm j)
  rw [Equiv.apply_symm_apply] at hpv
  obtain ⟨q', hq', -, hq'i⟩ := hG.exists_exterior (finRotate b j)
  have h1 := DiskMap.rot_cycle_of_mem_boundaryVertices hG.inv_involutive hG.inv_mem_bdry
    hG.boundaryVertex_card hG.exists_orbit (hG.bvertex_mem j) hp hpv hq hqi
    (G.leg_mem_bvertex j) (hG.leg_notMem_bdry j)
  have h2 := DiskMap.rot_cycle_of_mem_boundaryVertices hG.inv_involutive hG.inv_mem_bdry
    hG.boundaryVertex_card hG.exists_orbit (hG.bvertex_mem (finRotate b j)) hq hqv hq' hq'i
    (G.leg_mem_bvertex _) (hG.leg_notMem_bdry _)
  exact ⟨q, DiskMap.exterior_subset_bdry _ hq, h1.2.2.2, h2.2.2.1⟩

include hG in
/-- The rotation takes a dart of the exterior to a leg. -/
private theorem exists_rot_exterior {h : H} (hh : h ∈ G.exterior) : ∃ i, G.rot h = G.leg i := by
  have hB := DiskMap.exterior_subset_bdry _ hh
  have hv : G.vertexOf h ∈ G.boundaryVertices :=
    G.vertexOf_mem_boundaryVertices.2 (G.isBoundaryVertex_vertexOf_of_mem hB)
  obtain ⟨i, hi⟩ := hG.exists_bvertex_eq _ hv
  obtain ⟨q, hq, -, hqi⟩ := hG.exists_exterior i
  have hhv : h ∈ G.bvertex i := by
    rw [hi]
    exact G.self_mem_vertexOf h
  exact ⟨i, (DiskMap.rot_cycle_of_mem_boundaryVertices hG.inv_involutive hG.inv_mem_bdry
    hG.boundaryVertex_card hG.exists_orbit (hG.bvertex_mem i) hh hhv hq hqi
    (G.leg_mem_bvertex i) (hG.leg_notMem_bdry i)).2.2.1⟩

/-- The first return `ρ` of `φ_X` to the darts `x⁺`: `φ_X` takes `x⁺_k` to `x⁺_{ρ(k)}` in one or
two steps, and `φ` takes `σ(k)` to `σ(ρ(k))` in two or three steps. -/
def plusReturn (k : G.BlackDart) : G.BlackDart :=
  match h : G.legIndex (G.rot k) with
  | some j => hG.invLeg (finRotate b j)
  | none => hG.psi ⟨G.rot k, hG.rot_mem_blackDarts k.2⟩ h

/-- If `σ(k)` is not the reverse of a leg, then `ρ(k) = ψ(σ(k))`. -/
theorem plusReturn_of_none {k : G.BlackDart} (h : G.legIndex (G.rot k) = none) :
    hG.plusReturn k = hG.psi ⟨G.rot k, hG.rot_mem_blackDarts k.2⟩ h := by
  unfold plusReturn
  split
  · simp_all
  · rfl

/-- If `σ(k) = ḡ_j`, then `ρ(k) = ḡ_{j+1}`. -/
theorem plusReturn_of_some {k : G.BlackDart} {j : Fin b} (h : G.legIndex (G.rot k) = some j) :
    hG.plusReturn k = hG.invLeg (finRotate b j) := by
  unfold plusReturn
  split <;> simp_all

/-- The map `φ_X` takes `x⁺_k` to `σ_X(x⁻_{σ(k)})`. -/
theorem facePerm_tripleOfNormal_plus (k : G.BlackDart) :
    (G.tripleOfNormal hG).facePerm (.plus k) =
      hG.tripleRot (.minus ⟨G.rot k, hG.rot_mem_blackDarts k.2⟩) := rfl

/-- The map `φ_X` takes `x⁻_k` to `σ_X(x⁺_{σ⁻¹(k)})`. -/
theorem facePerm_tripleOfNormal_minus (k : G.BlackDart) :
    (G.tripleOfNormal hG).facePerm (.minus k) =
      hG.tripleRot (.plus ⟨G.rot.symm k, hG.rot_symm_mem_blackDarts k.2⟩) := rfl

/-- The map `φ_X` takes `∂'_r` to `n_r`. -/
theorem facePerm_tripleOfNormal_del' (r : Fin (2 * b)) :
    (G.tripleOfNormal hG).facePerm (.del' r) = hG.endDart r := rfl

private theorem plusReturn_spec_tripleOfNormal (k : G.BlackDart) :
    ∃ m, 0 < m ∧ ((G.tripleOfNormal hG).facePerm ^ m) (.plus k) = .plus (hG.plusReturn k) ∧
      ∀ j, 0 < j → j < m →
        ¬∃ k', ((G.tripleOfNormal hG).facePerm ^ j) (.plus k) = .plus k' := by
  rcases h : G.legIndex (G.rot k) with _ | j
  · refine ⟨1, one_pos, ?_, fun j hj hj1 => by omega⟩
    rw [pow_one, facePerm_tripleOfNormal_plus, hG.tripleRot_minus_of_none h,
      hG.plusReturn_of_none h]
  · have h1 : (G.tripleOfNormal hG).facePerm (.plus k) =
        .del' (finRotate _ (targetIndex j)) := by
      rw [facePerm_tripleOfNormal_plus, hG.tripleRot_minus_of_some h]
    refine ⟨2, two_pos, ?_, fun j' hj hj2 => ?_⟩
    · rw [sq, Equiv.Perm.mul_apply, h1, facePerm_tripleOfNormal_del', finRotate_targetIndex,
        endDart_sourceIndex, hG.plusReturn_of_some h]
    · obtain rfl : j' = 1 := by omega
      rw [pow_one, h1]
      rintro ⟨k', hk'⟩
      cases hk'

private theorem plusReturn_spec (k : G.BlackDart) :
    ∃ m, 0 < m ∧ (G.facePerm ^ m) (G.rot k) = G.rot (hG.plusReturn k) ∧
      ∀ j, 0 < j → j < m → (G.facePerm ^ j) (G.rot k) ∉ G.blackDarts := by
  rcases h : G.legIndex (G.rot k) with _ | j
  · have hk := hG.rot_mem_blackDarts k.2
    have hi := hG.not_isBoundaryVertex_inv hk h
    have hw := hG.colour_inv hk h
    refine ⟨2, two_pos, ?_, fun j hj hj2 => ?_⟩
    · rw [sq, Equiv.Perm.mul_apply, RotationSystem.facePerm_apply,
        RotationSystem.facePerm_apply, hG.plusReturn_of_none h]
      rfl
    · obtain rfl : j = 1 := by omega
      rw [pow_one, RotationSystem.facePerm_apply]
      intro hm
      have := (mem_blackDarts.1 hm).2
      rw [hG.colour_rot _ hi, hw] at this
      exact Shade.noConfusion this
  · have hkj := inv_leg_of_legIndex_eq_some h
    obtain ⟨q, hqB, hq1, hq2⟩ := hG.exists_rot_leg j
    have e1 : G.facePerm (G.rot k) = G.inv q := by
      rw [RotationSystem.facePerm_apply, ← hkj, hG.inv_inv, hq1]
    have e2 : G.facePerm (G.inv q) = G.leg (finRotate b j) := by
      rw [RotationSystem.facePerm_apply, hG.inv_inv, hq2]
    refine ⟨3, three_pos, ?_, fun j' hj hj3 => ?_⟩
    · simp only [pow_succ, pow_zero, one_mul, Equiv.Perm.mul_apply]
      rw [e1, e2, RotationSystem.facePerm_apply, hG.plusReturn_of_some h]
      rfl
    · rcases (by omega : j' = 1 ∨ j' = 2) with rfl | rfl
      · rw [pow_one, e1]
        exact fun hm => notMem_bdry_of_mem_blackDarts hm (hG.inv_mem_bdry q hqB)
      · rw [sq, Equiv.Perm.mul_apply, e1, e2]
        exact fun hm => (mem_blackDarts.1 hm).1 (hG.isBoundaryVertex_leg _)

/-- **The orbits of `φ_X` through the darts `x⁺`**: `x⁺_k` and `x⁺_{k'}` lie in one orbit of `φ_X`
exactly when `σ(k)` and `σ(k')` lie in one orbit of `φ`. -/
theorem faceOf_tripleOfNormal_plus_eq_iff (k k' : G.BlackDart) :
    (G.tripleOfNormal hG).faceOf (.plus k) = (G.tripleOfNormal hG).faceOf (.plus k') ↔
      G.faceOf (G.rot k) = G.faceOf (G.rot k') := by
  let ρX : G.TripleDart → G.TripleDart
    | .plus k => .plus (hG.plusReturn k)
    | z => z
  let ρG : H → H := fun d =>
    if h : d ∈ G.blackDarts then G.rot (hG.plusReturn ⟨G.rot.symm d, hG.rot_symm_mem_blackDarts h⟩)
    else d
  have hρG : ∀ k : G.BlackDart, ρG (G.rot k) = G.rot (hG.plusReturn k) := by
    intro k
    have hk : (⟨G.rot.symm (G.rot k), hG.rot_symm_mem_blackDarts (hG.rot_mem_blackDarts k.2)⟩ :
        G.BlackDart) = k := Subtype.ext (Equiv.symm_apply_apply _ _)
    simp only [ρG, dif_pos (hG.rot_mem_blackDarts k.2), hk]
  have hX : ∀ y, (∃ k', y = TripleOfNormalDart.plus k') → (∃ k', ρX y = .plus k') ∧
      ∃ m, 0 < m ∧ ((G.tripleOfNormal hG).facePerm ^ m) y = ρX y ∧
        ∀ j, 0 < j → j < m →
          ¬∃ k', ((G.tripleOfNormal hG).facePerm ^ j) y = .plus k' := by
    rintro y ⟨k, rfl⟩
    exact ⟨⟨_, rfl⟩, hG.plusReturn_spec_tripleOfNormal k⟩
  have hGρ : ∀ d, d ∈ G.blackDarts → ρG d ∈ G.blackDarts ∧
      ∃ m, 0 < m ∧ (G.facePerm ^ m) d = ρG d ∧
        ∀ j, 0 < j → j < m → (G.facePerm ^ j) d ∉ G.blackDarts := by
    intro d hd
    obtain ⟨k, rfl⟩ : ∃ k : G.BlackDart, G.rot k = d :=
      ⟨⟨G.rot.symm d, hG.rot_symm_mem_blackDarts hd⟩, Equiv.apply_symm_apply _ _⟩
    rw [hρG]
    exact ⟨hG.rot_mem_blackDarts (hG.plusReturn k).2, hG.plusReturn_spec k⟩
  have e1 : ∀ j, ρX^[j] (.plus k) = .plus (hG.plusReturn^[j] k) := by
    intro j
    induction j generalizing k with
    | zero => rfl
    | succ j ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply]
      exact ih _
  have e2 : ∀ j (k : G.BlackDart), ρG^[j] (G.rot k) = G.rot (hG.plusReturn^[j] k) := by
    intro j
    induction j with
    | zero => intro k; rfl
    | succ j ih =>
      intro k
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, hρG, ih]
  rw [RotationSystem.faceOf_eq_faceOf_iff, RotationSystem.faceOf_eq_faceOf_iff,
    sameCycle_iff_exists_iterate _ _ ρX hX ⟨k, rfl⟩ ⟨k', rfl⟩,
    sameCycle_iff_exists_iterate _ _ ρG hGρ (hG.rot_mem_blackDarts k.2)
      (hG.rot_mem_blackDarts k'.2)]
  simp only [e1, e2, TripleOfNormalDart.plus.injEq]
  exact exists_congr fun j =>
    ⟨fun h => by rw [h], fun h => Subtype.ext (G.rot.injective h)⟩

/-- **The orbits of `φ_X` through the darts `x⁻`**: `x⁻_k` and `x⁻_{k'}` lie in one orbit of `φ_X`
exactly when `k` and `k'` lie at the same (black) vertex. -/
theorem faceOf_tripleOfNormal_minus_eq_iff (k k' : G.BlackDart) :
    (G.tripleOfNormal hG).faceOf (.minus k) = (G.tripleOfNormal hG).faceOf (.minus k') ↔
      G.vertexOf k = G.vertexOf k' := by
  let μ : G.BlackDart → G.BlackDart := fun k => ⟨G.rot.symm k, hG.rot_symm_mem_blackDarts k.2⟩
  let ρX : G.TripleDart → G.TripleDart
    | .minus k => .minus (μ k)
    | z => z
  have hX : ∀ y, (∃ k', y = TripleOfNormalDart.minus k') → (∃ k', ρX y = .minus k') ∧
      ∃ m, 0 < m ∧ ((G.tripleOfNormal hG).facePerm ^ m) y = ρX y ∧
        ∀ j, 0 < j → j < m →
          ¬∃ k', ((G.tripleOfNormal hG).facePerm ^ j) y = .minus k' := by
    rintro y ⟨k, rfl⟩
    refine ⟨⟨_, rfl⟩, ?_⟩
    rcases h : G.legIndex (μ k) with _ | j
    · refine ⟨1, one_pos, ?_, fun j hj hj1 => by omega⟩
      rw [pow_one, facePerm_tripleOfNormal_minus, hG.tripleRot_plus_of_none h]
    · have h1 : (G.tripleOfNormal hG).facePerm (.minus k) =
          .del' (finRotate _ (sourceIndex j)) := by
        rw [facePerm_tripleOfNormal_minus, hG.tripleRot_plus_of_some h]
      refine ⟨2, two_pos, ?_, fun j' hj hj2 => ?_⟩
      · rw [sq, Equiv.Perm.mul_apply, h1, facePerm_tripleOfNormal_del', finRotate_sourceIndex,
          endDart_targetIndex, ← hG.eq_invLeg_of_legIndex h]
      · obtain rfl : j' = 1 := by omega
        rw [pow_one, h1]
        rintro ⟨k', hk'⟩
        cases hk'
  have hGρ : ∀ d, d ∈ G.blackDarts → G.rot.symm d ∈ G.blackDarts ∧
      ∃ m, 0 < m ∧ (G.rot⁻¹ ^ m) d = G.rot.symm d ∧
        ∀ j, 0 < j → j < m → (G.rot⁻¹ ^ j) d ∉ G.blackDarts :=
    fun d hd => ⟨hG.rot_symm_mem_blackDarts hd, 1, one_pos, by rw [pow_one]; rfl,
      fun j hj hj1 => by omega⟩
  have e1 : ∀ j, ρX^[j] (.minus k) = .minus (μ^[j] k) := by
    intro j
    induction j generalizing k with
    | zero => rfl
    | succ j ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply]
      exact ih _
  have e2 : ∀ j (k : G.BlackDart), ((μ^[j] k : G.BlackDart) : H) = G.rot.symm^[j] k := by
    intro j
    induction j with
    | zero => intro k; rfl
    | succ j ih =>
      intro k
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ih]
  rw [RotationSystem.faceOf_eq_faceOf_iff, RotationSystem.vertexOf_eq_vertexOf_iff,
    ← Equiv.Perm.sameCycle_inv (f := G.rot),
    sameCycle_iff_exists_iterate _ _ ρX hX ⟨k, rfl⟩ ⟨k', rfl⟩,
    sameCycle_iff_exists_iterate _ _ G.rot.symm hGρ k.2 k'.2]
  simp only [e1, TripleOfNormalDart.minus.injEq]
  exact exists_congr fun j =>
    ⟨fun h => by rw [← e2, h], fun h => Subtype.ext (by rw [e2, h])⟩

/-- The kind of the orbit of `φ_X` through a dart: `0` for the exterior `{∂_r}`, `1` for the
orbits through the darts `x⁻_k` and `∂'_{2i}`, `2` for the orbits through the darts `x⁺_k` and
`∂'_{2i+1}`. -/
private def faceKind : G.TripleDart → ℕ
  | .plus _ => 2
  | .minus _ => 1
  | .del _ => 0
  | .del' r => if (r : ℕ) % 2 = 0 then 2 else 1

private theorem faceKind_facePerm (z : G.TripleDart) :
    faceKind ((G.tripleOfNormal hG).facePerm z) = faceKind z := by
  rcases z with k | k | r | r
  · rw [facePerm_tripleOfNormal_plus]
    rcases h : G.legIndex (G.rot k) with _ | j
    · rw [hG.tripleRot_minus_of_none h]; rfl
    · rw [hG.tripleRot_minus_of_some h, finRotate_targetIndex]
      simp [faceKind]
  · rw [facePerm_tripleOfNormal_minus]
    rcases h : G.legIndex (G.rot.symm k) with _ | j
    · rw [hG.tripleRot_plus_of_none h]; rfl
    · rw [hG.tripleRot_plus_of_some h, finRotate_sourceIndex]
      simp [faceKind, Nat.add_mod]
  · rfl
  · rw [facePerm_tripleOfNormal_del']
    rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · simp [faceKind]
    · simp [faceKind, Nat.add_mod]

private theorem faceKind_eq_of_faceOf_eq {z z' : G.TripleDart}
    (h : (G.tripleOfNormal hG).faceOf z = (G.tripleOfNormal hG).faceOf z') :
    faceKind z = faceKind z' := by
  rw [RotationSystem.faceOf_eq_faceOf_iff] at h
  obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
  clear h
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ', Equiv.Perm.mul_apply, hG.faceKind_facePerm, ih]

/-! ### Counting the faces of `X(G)` -/

include hG in
/-- In a normal plabic pregraph the exterior is an orbit of `φ`, and `B` is the exterior together
with its reverse. -/
private theorem exterior_spec :
    G.exterior ∈ G.faceOrbits ∧ G.exterior ∪ G.exterior.map G.inv.toEmbedding = G.bdry := by
  obtain ⟨f, hf, hfB, hu, hd⟩ := hG.exists_orbit
  have := G.eq_exterior_of_mem_faceOrbits hG.inv_involutive hG.inv_mem_bdry
    hG.boundaryVertex_card hf hfB hu hd
  subst this
  exact ⟨hf, hu⟩

include hG in
/-- Every orbit of `φ` other than the exterior meets `K`. -/
private theorem exists_faceOf_eq_of_notMem_exterior {d : H} (hd : d ∉ G.exterior) :
    ∃ k ∈ G.blackDarts, G.faceOf d = G.faceOf k := by
  have hstep : ∀ e, G.facePerm e ∈ G.blackDarts →
      ∃ k ∈ G.blackDarts, G.faceOf e = G.faceOf k :=
    fun e he => ⟨_, he, (G.faceOf_facePerm e).symm⟩
  have hleg : ∀ i, G.facePerm (G.leg i) ∈ G.blackDarts := fun i =>
    hG.rot_mem_blackDarts (hG.inv_leg_mem_blackDarts i)
  by_cases hb : G.IsBoundaryVertex (G.vertexOf d)
  · by_cases hdB : d ∈ G.bdry
    · -- `d = h̄` for a dart `h` of the exterior, and `φ(d) = σ(h)` is a leg
      have hmem : d ∈ G.exterior.map G.inv.toEmbedding := by
        have := hG.exterior_spec.2 ▸ hdB
        rcases mem_union.1 this with h | h
        · exact absurd h hd
        · exact h
      rw [mem_map_equiv] at hmem
      have hinv : G.inv.symm d = G.inv d := by
        rw [Equiv.symm_apply_eq, hG.inv_inv]
      rw [hinv] at hmem
      obtain ⟨i, hi⟩ := hG.exists_rot_exterior hmem
      have h1 : G.facePerm d = G.leg i := by rw [RotationSystem.facePerm_apply, hi]
      obtain ⟨k, hk, hk'⟩ := hstep _ (h1 ▸ hleg i)
      exact ⟨k, hk, (G.faceOf_facePerm d).symm.trans hk'⟩
    · obtain ⟨i, rfl⟩ := hG.exists_leg_eq hb hdB
      exact hstep _ (hleg i)
  · cases hc : G.colour d
    · -- `d` lies at a white vertex: `d = φ(\overline{σ⁻¹ d})`
      have hb' : ¬G.IsBoundaryVertex (G.vertexOf (G.rot.symm d)) := by
        rwa [G.vertexOf_eq_of_mem (G.rot_symm_mem_vertexOf d)]
      have hc' : G.colour (G.rot.symm d) = .white := by rw [hG.colour_rot_symm hb, hc]
      have hk := mem_blackDarts.2 (hG.inv_black_of_white hb' hc')
      refine ⟨_, hk, ?_⟩
      rw [← G.faceOf_facePerm (G.inv (G.rot.symm d)), RotationSystem.facePerm_apply,
        hG.inv_inv, Equiv.apply_symm_apply]
    · exact ⟨d, mem_blackDarts.2 ⟨hb, hc⟩, rfl⟩

include hG in
/-- `Φ` consists of the exterior and the orbits through `K`. -/
private theorem card_faceOrbits :
    G.faceOrbits.card = (G.blackDarts.image G.faceOf).card + 1 := by
  obtain ⟨hext, -⟩ := hG.exterior_spec
  obtain ⟨e₀, he₀⟩ := G.mem_faceOrbits.1 hext
  have hnot : G.exterior ∉ G.blackDarts.image G.faceOf := by
    intro h
    obtain ⟨k, hk, hkf⟩ := mem_image.1 h
    have : k ∈ G.exterior := hkf ▸ G.self_mem_faceOf k
    exact notMem_bdry_of_mem_blackDarts hk (DiskMap.exterior_subset_bdry _ this)
  have heq : G.faceOrbits = insert G.exterior (G.blackDarts.image G.faceOf) := by
    ext f
    simp only [mem_insert, mem_image]
    constructor
    · intro hf
      obtain ⟨d, rfl⟩ := G.mem_faceOrbits.1 hf
      by_cases hd : d ∈ G.exterior
      · left
        rw [← he₀] at hd ⊢
        exact G.faceOf_eq_of_mem hd
      · obtain ⟨k, hk, hkf⟩ := hG.exists_faceOf_eq_of_notMem_exterior hd
        exact Or.inr ⟨k, hk, hkf.symm⟩
    · rintro (rfl | ⟨k, -, rfl⟩)
      · exact hext
      · exact G.faceOf_mem_faceOrbits k
  rw [heq, card_insert_of_notMem hnot]

include hG in
/-- Since `ρ` permutes the black darts, `k ↦ φ(ρ k)` and `φ` have the same image on them. -/
theorem image_faceOf_rot_blackDart :
    ((univ : Finset G.BlackDart).image fun k : G.BlackDart => G.faceOf (G.rot k)) =
      G.blackDarts.image G.faceOf := by
  ext f
  simp only [mem_image, mem_univ, true_and, Subtype.exists]
  constructor
  · rintro ⟨k, hk, rfl⟩
    exact ⟨_, hG.rot_mem_blackDarts hk, rfl⟩
  · rintro ⟨d, hd, rfl⟩
    exact ⟨_, hG.rot_symm_mem_blackDarts hd, by rw [Equiv.apply_symm_apply]⟩

/-- **Counting the orbits of `φ_X`**: `|Φ_X| = |Φ| + |𝓑|`, where `𝓑` is the set of black
vertices of `G`. -/
theorem card_faceOrbits_tripleOfNormal :
    (G.tripleOfNormal hG).faceOrbits.card =
      G.faceOrbits.card + (G.blackDarts.image G.vertexOf).card := by
  have hb := hG.one_le
  set X := G.tripleOfNormal hG
  set r₀ : Fin (2 * b) := ⟨0, by omega⟩
  set Sm := (univ : Finset G.BlackDart).image fun k => X.faceOf (.minus k)
  set Sp := (univ : Finset G.BlackDart).image fun k => X.faceOf (.plus k)
  have hdecomp : X.faceOrbits = insert (X.faceOf (.del r₀)) (Sm ∪ Sp) := by
    ext f
    simp only [RotationSystem.mem_faceOrbits, mem_insert, mem_union, Sm, Sp, mem_image,
      mem_univ, true_and]
    constructor
    · rintro ⟨z, rfl⟩
      rcases z with k | k | r | r
      · exact Or.inr (Or.inr ⟨k, rfl⟩)
      · exact Or.inr (Or.inl ⟨k, rfl⟩)
      · left
        rw [hG.faceOf_tripleOfNormal_del, hG.faceOf_tripleOfNormal_del]
      · rw [← RotationSystem.faceOf_facePerm, facePerm_tripleOfNormal_del']
        rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩
        · exact Or.inr (Or.inr ⟨_, by rw [endDart_sourceIndex]⟩)
        · exact Or.inr (Or.inl ⟨_, by rw [endDart_targetIndex]⟩)
    · rintro (rfl | ⟨k, rfl⟩ | ⟨k, rfl⟩) <;> exact ⟨_, rfl⟩
  have hnot : X.faceOf (.del r₀) ∉ Sm ∪ Sp := by
    intro h
    rcases mem_union.1 h with h | h <;> obtain ⟨k, -, hk⟩ := mem_image.1 h <;>
      exact absurd (hG.faceKind_eq_of_faceOf_eq hk) (by simp [faceKind])
  have hdisj : Disjoint Sm Sp := by
    rw [disjoint_left]
    intro f hf hf'
    obtain ⟨k, -, rfl⟩ := mem_image.1 hf
    obtain ⟨k', -, hk⟩ := mem_image.1 hf'
    exact absurd (hG.faceKind_eq_of_faceOf_eq hk) (by simp [faceKind])
  have hSm : Sm.card = (G.blackDarts.image G.vertexOf).card := by
    rw [card_image_eq_of_iff (g := fun k : G.BlackDart => G.vertexOf k)
      fun k _ k' _ => hG.faceOf_tripleOfNormal_minus_eq_iff k k']
    congr 1
    ext v
    simp
  have hSp : Sp.card = (G.blackDarts.image G.faceOf).card := by
    rw [card_image_eq_of_iff (g := fun k : G.BlackDart => G.faceOf (G.rot k))
      fun k _ k' _ => hG.faceOf_tripleOfNormal_plus_eq_iff k k']
    congr 1
    exact hG.image_faceOf_rot_blackDart
  rw [hdecomp, card_insert_of_notMem hnot, card_union_of_disjoint hdisj, hSm, hSp,
    hG.card_faceOrbits]
  ring

/-! ### Euler's relation -/

/-- The vertex of `X(G)` through `x⁺_k` has six darts if `k` is not the reverse of a leg, and
three otherwise. -/
theorem card_vertexOf_tripleOfNormal_plus (k : G.BlackDart) :
    ((G.tripleOfNormal hG).vertexOf (.plus k)).card = if G.legIndex k = none then 6 else 3 := by
  rcases h : G.legIndex k with _ | i
  · rw [if_pos rfl]
    exact hG.card_vertexOf_tripleOfNormal_plus_of_none h
  · rw [if_neg (Option.some_ne_none i), hG.eq_invLeg_of_legIndex h, ← endDart_sourceIndex,
      vertexOf_tripleOfNormal_endDart, card_vertexOf_tripleOfNormal_del]

/-- The vertex of `X(G)` through `x⁻_k` has six darts if `k` is not the reverse of a leg, and
three otherwise. -/
theorem card_vertexOf_tripleOfNormal_minus (k : G.BlackDart) :
    ((G.tripleOfNormal hG).vertexOf (.minus k)).card = if G.legIndex k = none then 6 else 3 := by
  rcases h : G.legIndex k with _ | i
  · rw [if_pos rfl, hG.vertexOf_tripleOfNormal_minus_of_none h]
    exact hG.card_vertexOf_tripleOfNormal_plus_of_none h
  · rw [if_neg (Option.some_ne_none i), hG.eq_invLeg_of_legIndex h, ← endDart_targetIndex,
      vertexOf_tripleOfNormal_endDart, card_vertexOf_tripleOfNormal_del]

include hG in
/-- Exactly `b` black darts of `G` are reverses of legs. -/
theorem card_filter_legIndex_ne_none :
    (G.blackDarts.filter fun k => ¬G.legIndex k = none).card = b := by
  have : (G.blackDarts.filter fun k => ¬G.legIndex k = none) =
      univ.image fun i => G.inv (G.leg i) := by
    ext k
    simp only [mem_filter, mem_image, mem_univ, true_and]
    constructor
    · rintro ⟨-, h⟩
      obtain ⟨i, hi⟩ := Option.ne_none_iff_exists'.1 h
      exact ⟨i, inv_leg_of_legIndex_eq_some hi⟩
    · rintro ⟨i, rfl⟩
      exact ⟨hG.inv_leg_mem_blackDarts i, by rw [hG.legIndex_inv_leg]; simp⟩
  rw [this, card_image_of_injective _ fun i j hij => hG.leg_injective (G.inv.injective hij),
    card_univ, Fintype.card_fin]

include hG in
/-- The involution `ι` is a bijection between the white darts at internal vertices and the black
darts which are not reverses of legs. -/
theorem card_internal_white_eq :
    (((univ : Finset H).filter fun d => ¬G.IsBoundaryVertex (G.vertexOf d)).filter
      fun d => G.colour d = .white).card =
      (G.blackDarts.filter fun k => G.legIndex k = none).card := by
  refine card_nbij' G.inv G.inv (fun d hd => ?_) (fun k hk => ?_) (fun d _ => hG.inv_inv d)
    (fun k _ => hG.inv_inv k)
  · simp only [mem_coe, mem_filter, mem_univ, true_and] at hd ⊢
    exact ⟨mem_blackDarts.2 (hG.inv_black_of_white hd.1 hd.2),
      hG.legIndex_eq_none_of_internal (by rw [hG.inv_inv]; exact hd.1)⟩
  · simp only [mem_coe, mem_filter, mem_univ, true_and] at hk ⊢
    exact ⟨hG.not_isBoundaryVertex_inv hk.1 hk.2, hG.colour_inv hk.1 hk.2⟩

include hG in
/-- There are `3 b` darts at the boundary vertices of `G`. -/
theorem card_filter_isBoundaryVertex :
    (((univ : Finset H).filter fun d => G.IsBoundaryVertex (G.vertexOf d)).card : ℚ) =
      3 * b := by
  set Bd := (univ : Finset H).filter fun d => G.IsBoundaryVertex (G.vertexOf d) with hBd
  have h3 : ∀ d ∈ Bd, (G.vertexOf d).card = 3 := fun d hd =>
    (hG.boundaryVertex_card _ (G.vertexOf_mem_boundaryVertices.2 (mem_filter.1 hd).2)).1
  have hcl : ∀ d ∈ Bd, G.vertexOf d ⊆ Bd := by
    intro d hd e he
    simp only [hBd, mem_filter, mem_univ, true_and] at hd ⊢
    rwa [G.vertexOf_eq_of_mem he]
  have himg : Bd.image G.vertexOf = univ.image G.bvertex := by
    ext v
    simp only [mem_image, hBd, mem_filter, mem_univ, true_and]
    constructor
    · rintro ⟨d, hd, rfl⟩
      exact hG.exists_bvertex_eq _ (G.vertexOf_mem_boundaryVertices.2 hd)
    · rintro ⟨i, rfl⟩
      exact ⟨G.leg i, hG.isBoundaryVertex_leg i, rfl⟩
  have h := card_image_eq_sum_inv G.vertexOf G.self_mem_vertexOf
    (fun _ _ h => G.vertexOf_eq_of_mem h) Bd hcl
  rw [himg, card_image_of_injective _ hG.bvertex_injective, card_univ, Fintype.card_fin,
    sum_congr rfl fun d hd => by rw [h3 d hd], sum_const, nsmul_eq_mul] at h
  push_cast at h
  linarith

include hG in
/-- Counting the vertices of `G`: the boundary vertices and the internal white vertices are
trivalent, and each black vertex is counted once. -/
theorem card_vertices_eq_card_div_three :
    (G.vertices.card : ℚ) =
      ((univ : Finset H).filter fun d => G.IsBoundaryVertex (G.vertexOf d)).card / 3 +
        (((univ : Finset H).filter fun d => ¬G.IsBoundaryVertex (G.vertexOf d)).filter
          fun d => G.colour d = .white).card / 3 + (G.blackDarts.image G.vertexOf).card := by
  set Bd := (univ : Finset H).filter fun d => G.IsBoundaryVertex (G.vertexOf d)
  set Int := (univ : Finset H).filter fun d => ¬G.IsBoundaryVertex (G.vertexOf d) with hInt
  set W := Int.filter fun d => G.colour d = .white with hW
  have eK : Int.filter (fun d => ¬G.colour d = .white) = G.blackDarts :=
    filter_internal_not_white_eq_blackDarts
  have h3 : ∀ d ∈ Bd, (G.vertexOf d).card = 3 := fun d hd =>
    (hG.boundaryVertex_card _ (G.vertexOf_mem_boundaryVertices.2 (mem_filter.1 hd).2)).1
  have hKcl : ∀ d ∈ G.blackDarts, G.vertexOf d ⊆ G.blackDarts := fun d hd e he =>
    RotationSystem.mem_of_sameCycle_of_closed (fun y hy => hG.rot_mem_blackDarts hy) hd
      ((G.mem_vertexOf).1 he)
  rw [RotationSystem.card_vertices_eq_sum,
    ← sum_filter_add_sum_filter_not univ fun d => G.IsBoundaryVertex (G.vertexOf d), ← hInt,
    ← sum_filter_add_sum_filter_not Int fun d => G.colour d = .white, eK]
  have s1 : ∑ d ∈ Bd, 1 / ((G.vertexOf d).card : ℚ) = Bd.card / 3 := by
    rw [sum_congr rfl fun d hd => by rw [h3 d hd], sum_const, nsmul_eq_mul]
    push_cast
    ring
  have s2 : ∑ d ∈ W, 1 / ((G.vertexOf d).card : ℚ) = W.card / 3 := by
    have hw : ∀ d ∈ W, (G.vertexOf d).card = 3 := by
      intro d hd
      simp only [hW, hInt, mem_filter, mem_univ, true_and] at hd
      exact hG.card_vertexOf_of_white d hd.1 hd.2
    rw [sum_congr rfl fun d hd => by rw [hw d hd], sum_const, nsmul_eq_mul]
    push_cast
    ring
  have s3 : ∑ d ∈ G.blackDarts, 1 / ((G.vertexOf d).card : ℚ) =
      (G.blackDarts.image G.vertexOf).card :=
    (card_image_eq_sum_inv G.vertexOf G.self_mem_vertexOf
      (fun _ _ h => G.vertexOf_eq_of_mem h) G.blackDarts hKcl).symm
  rw [s1, s2, s3]
  ring

/-- Counting the vertices of `X(G)`. -/
theorem card_vertices_tripleOfNormal :
    ((G.tripleOfNormal hG).vertices.card : ℚ) =
      2 * ((G.blackDarts.filter fun k => G.legIndex k = none).card / 6 + (b : ℚ) / 3) +
        4 * b / 3 := by
  set X := G.tripleOfNormal hG with hXdef
  rw [RotationSystem.card_vertices_eq_sum, TripleOfNormalDart.sum_univ]
  have hp : ∀ k : G.BlackDart, 1 / ((X.vertexOf (.plus k)).card : ℚ) =
      if G.legIndex k = none then 1 / 6 else 1 / 3 := by
    intro k
    rw [hXdef, hG.card_vertexOf_tripleOfNormal_plus]
    split_ifs <;> norm_num
  have hm : ∀ k : G.BlackDart, 1 / ((X.vertexOf (.minus k)).card : ℚ) =
      if G.legIndex k = none then 1 / 6 else 1 / 3 := by
    intro k
    rw [hXdef, hG.card_vertexOf_tripleOfNormal_minus]
    split_ifs <;> norm_num
  have hd : ∀ r, 1 / ((X.vertexOf (.del r)).card : ℚ) = 1 / 3 := by
    intro r
    rw [hXdef, hG.card_vertexOf_tripleOfNormal_del]
    norm_num
  have hd' : ∀ r, 1 / ((X.vertexOf (.del' r)).card : ℚ) = 1 / 3 := by
    intro r
    rw [hXdef, vertexOf_tripleOfNormal_del', hG.card_vertexOf_tripleOfNormal_del]
    norm_num
  simp only [hp, hm, hd, hd']
  have hs : ∑ k : G.BlackDart, (if G.legIndex k = none then (1 : ℚ) / 6 else 1 / 3) =
      (G.blackDarts.filter fun k => G.legIndex k = none).card / 6 + b / 3 := by
    rw [sum_coe_sort G.blackDarts fun k => if G.legIndex k = none then (1 : ℚ) / 6 else 1 / 3,
      sum_ite, sum_const, sum_const, hG.card_filter_legIndex_ne_none, nsmul_eq_mul,
      nsmul_eq_mul]
    ring
  rw [hs]
  simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
  push_cast
  ring

/-- Counting the edges of `X(G)`. -/
theorem card_edges_tripleOfNormal :
    ((G.tripleOfNormal hG).edges.card : ℚ) = G.blackDarts.card + 2 * b := by
  have hX := hG.isPreTripleDiagram_tripleOfNormal
  rw [RotationSystem.card_edges_eq _ hX.inv_involutive hX.inv_ne, ← card_univ,
    card_eq_sum_ones, Nat.cast_sum, TripleOfNormalDart.sum_univ]
  simp only [Nat.cast_one, sum_const, card_univ, Fintype.card_coe, Fintype.card_fin,
    nsmul_eq_mul, mul_one]
  push_cast
  ring

/-- **`X(G)` and `G` have the same Euler characteristic**: for a normal plabic pregraph `G`, with
sets `V`, `E`, `Φ` of vertices, edges and orbits of `φ`, and the corresponding sets `V_X`, `E_X`,
`Φ_X` of `X(G)`, `|V_X| - |E_X| + |Φ_X| = |V| - |E| + |Φ|`. -/
@[cluster_algebras "lem_triple_of_normal_euler"]
theorem euler_tripleOfNormal :
    ((G.tripleOfNormal hG).vertices.card : ℤ) - (G.tripleOfNormal hG).edges.card +
        (G.tripleOfNormal hG).faceOrbits.card =
      (G.vertices.card : ℤ) - G.edges.card + G.faceOrbits.card := by
  set X := G.tripleOfNormal hG
  set Bd := (univ : Finset H).filter fun d => G.IsBoundaryVertex (G.vertexOf d)
  set Int := (univ : Finset H).filter fun d => ¬G.IsBoundaryVertex (G.vertexOf d) with hInt
  set W := Int.filter fun d => G.colour d = .white with hW
  set K := G.blackDarts
  set Kn := K.filter fun k => G.legIndex k = none
  set β := (K.image G.vertexOf).card
  have eK : Int.filter (fun d => ¬G.colour d = .white) = K :=
    filter_internal_not_white_eq_blackDarts
  have F1 : (K.filter fun k => ¬G.legIndex k = none).card = b := hG.card_filter_legIndex_ne_none
  have F1' := card_filter_add_card_filter_not (s := K) fun k => G.legIndex k = none
  have F2 : W.card = Kn.card := hG.card_internal_white_eq
  have F3 : (Bd.card : ℚ) = 3 * b := hG.card_filter_isBoundaryVertex
  have F4 : (Fintype.card H : ℚ) = Bd.card + W.card + K.card := by
    have h1 := card_filter_add_card_filter_not (s := (univ : Finset H))
      fun d => G.IsBoundaryVertex (G.vertexOf d)
    have h2 := card_filter_add_card_filter_not (s := Int) fun d => G.colour d = .white
    rw [eK, ← hW] at h2
    rw [← hInt] at h1
    rw [← card_univ, ← h1, ← h2]
    push_cast
    ring
  have F5 : (G.vertices.card : ℚ) = Bd.card / 3 + W.card / 3 + β :=
    hG.card_vertices_eq_card_div_three
  have F6 : (G.edges.card : ℚ) = Fintype.card H / 2 :=
    RotationSystem.card_edges_eq _ hG.inv_involutive hG.inv_ne
  have F7 : (X.vertices.card : ℚ) = 2 * (Kn.card / 6 + (b : ℚ) / 3) + 4 * b / 3 :=
    hG.card_vertices_tripleOfNormal
  have F8 : (X.edges.card : ℚ) = K.card + 2 * b := hG.card_edges_tripleOfNormal
  have F9 : (X.faceOrbits.card : ℚ) = G.faceOrbits.card + β :=
    mod_cast hG.card_faceOrbits_tripleOfNormal
  have hKn : (K.card : ℚ) = Kn.card + b := by
    rw [F1] at F1'
    exact_mod_cast F1'.symm
  have hW' : (W.card : ℚ) = Kn.card := mod_cast F2
  have key : (X.vertices.card : ℚ) - X.edges.card + X.faceOrbits.card =
      (G.vertices.card : ℚ) - G.edges.card + G.faceOrbits.card := by
    rw [F7, F8, F9, F5, F6, F4, F3, hW', hKn]
    ring
  exact_mod_cast key

end IsNormalPlabicPregraph

/-! ### `X(G)` is a triple diagram -/

/-- **`X(G)` is a triple diagram**: if `G` is a normal plabic graph, then `X(G)` is a triple
diagram. -/
@[cluster_algebras "lem_triple_diagram_of_normal"]
theorem IsNormalPlabicGraph.isTripleDiagram_tripleOfNormal (hG : G.IsNormalPlabicGraph) :
    (G.tripleOfNormal hG.isNormalPlabicPregraph).IsTripleDiagram :=
  hG.isNormalPlabicPregraph.isPreTripleDiagram_tripleOfNormal.isTripleDiagram
    (hG.isNormalPlabicPregraph.transitive_iff_tripleOfNormal.1 hG.transitive)
    (by rw [hG.isNormalPlabicPregraph.euler_tripleOfNormal]; exact hG.euler)

/-- **A pregraph whose triple diagram is a triple diagram is a plabic graph**: if `G` is a normal
plabic pregraph and `X(G)` is a triple diagram, then `G` is a normal plabic graph. -/
@[cluster_algebras "lem_normal_pregraph_plabic"]
theorem IsNormalPlabicPregraph.isNormalPlabicGraph_of_isTripleDiagram
    (hG : G.IsNormalPlabicPregraph) (hX : (G.tripleOfNormal hG).IsTripleDiagram) :
    G.IsNormalPlabicGraph :=
  hG.isNormalPlabicGraph (hG.transitive_iff_tripleOfNormal.2 hX.transitive)
    (by rw [← hG.euler_tripleOfNormal]; exact hX.euler)

/-- The triple diagram `X(G)` of a normal plabic graph `G`, bundled with its dart type. -/
def IsNormalPlabicGraph.toTripleDiagram (hG : G.IsNormalPlabicGraph) : TripleDiagram b where
  Dart := G.TripleDart
  data := G.tripleOfNormal hG.isNormalPlabicPregraph
  isTripleDiagram := hG.isTripleDiagram_tripleOfNormal

/-- The data of the bundled triple diagram of `G` is `X(G)`. -/
@[simp]
theorem IsNormalPlabicGraph.toTripleDiagram_data (hG : G.IsNormalPlabicGraph) :
    hG.toTripleDiagram.data = G.tripleOfNormal hG.isNormalPlabicPregraph := rfl

/-! ### Isomorphisms -/

namespace Iso

variable {H' : Type} [Fintype H'] [DecidableEq H'] {G' : PlabicData H' b} (θ : G.Iso G')

/-- An isomorphism maps the darts at black vertices onto the darts at black vertices. -/
theorem mem_blackDarts_iff (d : H) : θ.toEquiv d ∈ G'.blackDarts ↔ d ∈ G.blackDarts := by
  rw [mem_blackDarts, mem_blackDarts, θ.isBoundaryVertex_vertexOf_iff]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨h1, by rwa [θ.map_colour d h1] at h2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨h1, by rw [θ.map_colour d h1]; exact h2⟩

/-- The bijection `K ≃ K'` of darts at black vertices induced by an isomorphism. -/
def blackDartEquiv : G.BlackDart ≃ G'.BlackDart :=
  θ.toEquiv.subtypeEquiv fun d => (θ.mem_blackDarts_iff d).symm

/-- The bijection `K ≃ K'` induced by `θ` acts on darts as `θ`. -/
@[simp]
theorem coe_blackDartEquiv (k : G.BlackDart) : (θ.blackDartEquiv k : H') = θ.toEquiv k := rfl

private theorem map_rot_symm (d : H) : θ.toEquiv (G.rot.symm d) = G'.rot.symm (θ.toEquiv d) := by
  rw [Equiv.eq_symm_apply, ← θ.map_rot, Equiv.apply_symm_apply]

/-- An isomorphism of plabic graphs preserves the labels of the reverses of the legs. -/
theorem legIndex_apply (hG : G.IsPlabicGraph) (hG' : G'.IsPlabicGraph) (k : H) :
    G'.legIndex (θ.toEquiv k) = G.legIndex k := by
  have key : ∀ i, (G'.inv (G'.leg i) = θ.toEquiv k) ↔ (G.inv (G.leg i) = k) := by
    intro i
    rw [← θ.map_leg hG hG' i, ← θ.map_inv, θ.toEquiv.apply_eq_iff_eq]
  simp only [legIndex, key]

/-- An isomorphism of normal plabic graphs takes `ḡ_i` to `ḡ'_i`. -/
theorem blackDartEquiv_invLeg (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph)
    (i : Fin b) :
    θ.blackDartEquiv (hG.isNormalPlabicPregraph.invLeg i) = hG'.isNormalPlabicPregraph.invLeg i :=
  Subtype.ext ((θ.map_inv _).trans (by rw [θ.map_leg hG.toIsPlabicGraph hG'.toIsPlabicGraph]; rfl))

/-- The bijection of darts induced by an isomorphism of normal plabic graphs takes the endpoint
dart `n_r` of `X(G)` to the endpoint dart `n_r` of `X(G')`. -/
theorem mapEquiv_endDart (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph)
    (r : Fin (2 * b)) :
    TripleOfNormalDart.mapEquiv θ.blackDartEquiv (hG.isNormalPlabicPregraph.endDart r) =
      hG'.isNormalPlabicPregraph.endDart r := by
  rcases exists_sourceIndex_or_targetIndex r with ⟨i, rfl⟩ | ⟨i, rfl⟩
  · rw [IsNormalPlabicPregraph.endDart_sourceIndex, IsNormalPlabicPregraph.endDart_sourceIndex,
      TripleOfNormalDart.mapEquiv_plus, θ.blackDartEquiv_invLeg hG hG']
  · rw [IsNormalPlabicPregraph.endDart_targetIndex, IsNormalPlabicPregraph.endDart_targetIndex,
      TripleOfNormalDart.mapEquiv_minus, θ.blackDartEquiv_invLeg hG hG']

/-- **`X(G)` depends on `G` only up to isomorphism**: an isomorphism `θ : G → G'` of normal
plabic graphs induces the isomorphism `X(G) → X(G')`, `x^±_k ↦ x^±_{θ(k)}`, `∂_r ↦ ∂_r`,
`∂'_r ↦ ∂'_r` (`Iso.tripleOfNormal_apply_plus`, `Iso.tripleOfNormal_apply_minus`,
`Iso.tripleOfNormal_apply_del`, `Iso.tripleOfNormal_apply_del'`). Both are triple diagrams
(`IsNormalPlabicGraph.isTripleDiagram_tripleOfNormal`), and this is an isomorphism of triple
diagrams (`Iso.tripleDiagramIso`). -/
@[cluster_algebras "lem_triple_of_normal_isomorphism"]
def tripleOfNormal (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph) :
    (G.tripleOfNormal hG.isNormalPlabicPregraph).Iso
      (G'.tripleOfNormal hG'.isNormalPlabicPregraph) where
  toEquiv := TripleOfNormalDart.mapEquiv θ.blackDartEquiv
  map_inv := by
    rintro (k | k | r | r)
    · simp only [IsNormalPlabicPregraph.tripleOfNormal_inv,
        IsNormalPlabicPregraph.tripleInv_plus, TripleOfNormalDart.mapEquiv_minus,
        TripleOfNormalDart.mapEquiv_plus, TripleOfNormalDart.minus.injEq]
      exact Subtype.ext (θ.map_rot k)
    · simp only [IsNormalPlabicPregraph.tripleOfNormal_inv,
        IsNormalPlabicPregraph.tripleInv_minus, TripleOfNormalDart.mapEquiv_minus,
        TripleOfNormalDart.mapEquiv_plus, TripleOfNormalDart.plus.injEq]
      exact Subtype.ext (θ.map_rot_symm k)
    · rfl
    · rfl
  map_rot := by
    have hP := hG.isNormalPlabicPregraph
    have hP' := hG'.isNormalPlabicPregraph
    have hli : ∀ k : G.BlackDart, G'.legIndex (θ.blackDartEquiv k) = G.legIndex k :=
      fun k => θ.legIndex_apply hG.toIsPlabicGraph hG'.toIsPlabicGraph k
    rintro (k | k | r | r)
    · simp only [IsNormalPlabicPregraph.tripleOfNormal_rot, TripleOfNormalDart.mapEquiv_plus]
      rcases h : G.legIndex k with _ | i
      · rw [hP.tripleRot_plus_of_none h, hP'.tripleRot_plus_of_none ((hli k).trans h)]
        rfl
      · rw [hP.tripleRot_plus_of_some h, hP'.tripleRot_plus_of_some ((hli k).trans h)]
        rfl
    · simp only [IsNormalPlabicPregraph.tripleOfNormal_rot, TripleOfNormalDart.mapEquiv_minus]
      rcases h : G.legIndex k with _ | i
      · rw [hP.tripleRot_minus_of_none h, hP'.tripleRot_minus_of_none ((hli k).trans h),
          TripleOfNormalDart.mapEquiv_plus, TripleOfNormalDart.plus.injEq]
        apply Subtype.ext
        simp only [coe_blackDartEquiv, IsNormalPlabicPregraph.coe_psi, θ.map_inv, θ.map_rot]
      · rw [hP.tripleRot_minus_of_some h, hP'.tripleRot_minus_of_some ((hli k).trans h)]
        rfl
    · exact θ.mapEquiv_endDart hG hG' r
    · rfl
  mem_bdry_iff := by
    rintro (_ | _ | _ | _) <;> simp [IsNormalPlabicPregraph.mem_tripleOfNormal_bdry]
  map_isOut := by rintro (_ | _ | _ | _) _ <;> rfl
  map_endpoint r := by
    simp only [TripleData.endpoint, IsNormalPlabicPregraph.tripleOfNormal_endDart,
      IsNormalPlabicPregraph.vertexOf_tripleOfNormal_endDart,
      IsNormalPlabicPregraph.vertexOf_tripleOfNormal_del, map_insert, map_singleton,
      Equiv.coe_toEmbedding, TripleOfNormalDart.mapEquiv_del, TripleOfNormalDart.mapEquiv_del',
      θ.mapEquiv_endDart hG hG' r]

/-- The isomorphism `X(G) → X(G')` induced by `θ` takes `x⁺_k` to `x⁺_{θ(k)}`. -/
@[simp]
theorem tripleOfNormal_apply_plus (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph)
    (k : G.BlackDart) :
    (θ.tripleOfNormal hG hG').toEquiv (.plus k) = .plus (θ.blackDartEquiv k) := rfl

/-- The isomorphism `X(G) → X(G')` induced by `θ` takes `x⁻_k` to `x⁻_{θ(k)}`. -/
@[simp]
theorem tripleOfNormal_apply_minus (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph)
    (k : G.BlackDart) :
    (θ.tripleOfNormal hG hG').toEquiv (.minus k) = .minus (θ.blackDartEquiv k) := rfl

/-- The isomorphism `X(G) → X(G')` induced by `θ` takes `∂_r` to `∂_r`. -/
@[simp]
theorem tripleOfNormal_apply_del (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph)
    (r : Fin (2 * b)) : (θ.tripleOfNormal hG hG').toEquiv (.del r) = .del r := rfl

/-- The isomorphism `X(G) → X(G')` induced by `θ` takes `∂'_r` to `∂'_r`. -/
@[simp]
theorem tripleOfNormal_apply_del' (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph)
    (r : Fin (2 * b)) : (θ.tripleOfNormal hG hG').toEquiv (.del' r) = .del' r := rfl

/-- The isomorphism `X(G) → X(G')` induced by `θ`, as an isomorphism of triple diagrams. -/
def tripleDiagramIso (hG : G.IsNormalPlabicGraph) (hG' : G'.IsNormalPlabicGraph) :
    TripleDiagram.Iso hG.toTripleDiagram hG'.toTripleDiagram :=
  θ.tripleOfNormal hG hG'

end Iso

/-- Isomorphic normal plabic graphs have isomorphic triple diagrams. -/
theorem Isomorphic.isomorphic_toTripleDiagram {H' : Type} [Fintype H'] [DecidableEq H']
    {G' : PlabicData H' b} (h : G.Isomorphic G') (hG : G.IsNormalPlabicGraph)
    (hG' : G'.IsNormalPlabicGraph) : hG.toTripleDiagram.Isomorphic hG'.toTripleDiagram :=
  h.elim fun θ => ⟨θ.tripleDiagramIso hG hG'⟩

end PlabicData

end ClusterAlgebras
