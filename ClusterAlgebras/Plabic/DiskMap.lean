module

public import ClusterAlgebras.Plabic.Basic

/-!
# Disk maps and plabic graphs

A plabic graph is a planar graph properly embedded in a disk, up to isotopy fixing the boundary.
Following [FWZ, Chapter 7], the embedding is encoded by a *rotation system with a boundary*: a
finite set `H` of darts, a fixed-point-free involution `d ↦ d̄` whose orbits are the edges, a
permutation `σ` whose orbits are the vertices (listing the darts at each vertex
counterclockwise), and a set `B` of darts of the boundary circle. The face
permutation is `φ = σ ∘ (d ↦ d̄)`; its orbits are the faces together with the exterior
`f_∞ = {d ∈ B : σ d ∉ B}`. Planarity is Euler's relation `|V| - |E| + |Φ| = 2`, and connectivity of
the graph together with the boundary circle is transitivity of the group generated by `σ` and the
involution.

This file contains the shared definitions of the chapter and the first facts about them: the
faces of a connected rotation system are linked across darts, the exterior is the unique orbit
of `φ` lying in `B` and containing one dart of each boundary arc, and both sides of a leg are
boundary faces.

## Main definitions

* `ClusterAlgebras.RotationSystem`, `ClusterAlgebras.RotationSystem.IsConnected`: a connected
  rotation system, with its face permutation `RotationSystem.facePerm`, its vertices
  `vertexOf`/`vertices`, edges `edgeOf`/`edges` and orbits of `φ` `faceOf`/`faceOrbits`.
* `ClusterAlgebras.RotationSystem.cycleSpace`: the rational cycle space.
* `ClusterAlgebras.DiskMap`, `ClusterAlgebras.DiskMap.IsDiskMap`: disk maps, with
  `DiskMap.exterior`, `DiskMap.boundaryVertices` and `DiskMap.internalVertices`.
* `ClusterAlgebras.DiskMap.faces`, `internalFaces`, `boundaryFaces`, `rightFace`, `leftFace`:
  faces of a disk map.
* `ClusterAlgebras.PlabicData`, `ClusterAlgebras.PlabicData.IsPlabicGraph`: plabic graphs, with
  the boundary vertices `PlabicData.bvertex` and legs `PlabicData.leg`;
  `ClusterAlgebras.PlabicGraph` bundles the dart type.
* `ClusterAlgebras.PlabicData.Iso`, `ClusterAlgebras.PlabicData.Isomorphic`: isomorphisms of
  plabic graphs.
* `DiskMap.IsInternalLeaf`, `PlabicData.IsLollipop`, `PlabicData.IsLollipopOfColour`,
  `DiskMap.IsHollowDigon`: leaves, lollipops and hollow digons.

## Main results

* `ClusterAlgebras.RotationSystem.IsConnected.exists_face_chain`: the faces of a connected
  rotation system are linked across darts.
* `ClusterAlgebras.DiskMap.eq_exterior_of_mem_faceOrbits`: the exterior is the exterior orbit.
* `ClusterAlgebras.DiskMap.IsDiskMap.rightFace_mem_boundaryFaces`,
  `ClusterAlgebras.DiskMap.IsDiskMap.leftFace_mem_boundaryFaces`: both sides of a leg are boundary
  faces.

## Implementation notes

* **Raw data and predicates.** Each object is a structure of raw data (`RotationSystem`,
  `DiskMap`, `PlabicData`) together with a `Prop`-valued predicate stating its conditions
  (`IsConnected`, `IsDiskMap`, `IsPlabicGraph`). Isomorphisms and the local moves compare a plabic
  graph with the output of a construction before that output is known to satisfy the conditions,
  so the conditions are not fields of the data. `DiskMap` extends `RotationSystem` and
  `PlabicData` extends `DiskMap`, so the whole vocabulary of rotation systems applies to disk maps
  and plabic graphs by dot notation.
* **Darts.** The dart type `H` is a parameter. Relations between graphs on different dart types
  (isomorphism, move equivalence) are heterogeneous in the dart type; `PlabicGraph b` bundles a
  dart type `Dart : Type` with its `Fintype` and `DecidableEq` instances, a `PlabicData` and the
  proof that it is a plabic graph.
* **Orbits as finite sets.** Vertices, edges and orbits of `φ` are represented by the `Finset` of
  their darts (`vertexOf d`, `edgeOf d`, `faceOf d`), and `V`, `E`, `Φ` are the `Finset`s of these.
  Their cardinalities count every orbit, fixed points included: a vertex with one dart is a vertex.
  Euler's relation is stated in `ℤ`.
* **Transitivity.** The condition is stated as in [FWZ], through `Subgroup.closure`; the
  inductive relation `RotationSystem.Reach` (steps `σ` and `d ↦ d̄`) is the form used in proofs,
  and `RotationSystem.reach_iff_exists_mem_closure` identifies the two on a finite dart set.
* **Colours** are a function `colour : H → Shade` on darts, the colour of a dart being that of its
  vertex; for a plabic graph it is required to be constant on internal vertices, and its values at
  boundary vertices are irrelevant.
* **Boundary labels.** The label set `[1, b]` is `Fin b`, `0`-indexed: the element `i : Fin b` is
  the label `i + 1` of [FWZ], and the label `i + 2` modulo `b` of [FWZ] is `finRotate b i`. The
  labelling `β` is recorded by one dart `leg i` at each labelled vertex, with `β(i) = bvertex i`,
  the vertex of `leg i`. Any map to the set of vertices is so represented; for a plabic graph
  `leg i` is required to lie outside `B`, so it is the leg `g_i` of [FWZ], the unique dart of
  `β(i)` not in `B`, and the representative is then unique.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 7,
  arXiv:2106.02160.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset

/-! ### Rotation systems -/

/-- The data of a **rotation system** on a set `H` of darts: an involution `inv` (`d ↦ d̄`), whose
orbits `{d, d̄}` are the edges, and a rotation `rot` (`σ`), whose orbits are the vertices. The
conditions of a connected rotation system are `RotationSystem.IsConnected`. -/
@[cluster_algebras "def_rotation_system"]
structure RotationSystem (H : Type*) where
  /-- The involution `d ↦ d̄` pairing the two darts of an edge. -/
  inv : Equiv.Perm H
  /-- The rotation `σ`, listing the darts at each vertex counterclockwise. -/
  rot : Equiv.Perm H

namespace RotationSystem

variable {H : Type*} (R : RotationSystem H)

/-- **Reachability** under the rotation and the involution: `R.Reach d e` when `e` is obtained
from `d` by applying `σ` and `d ↦ d̄` finitely many times. On a finite set of darts this is the
orbit relation of the group generated by `σ` and the involution
(`RotationSystem.reach_iff_exists_mem_closure`). -/
inductive Reach : H → H → Prop
  /-- Every dart reaches itself. -/
  | refl (d : H) : Reach d d
  /-- Turning at a vertex. -/
  | rot {d e : H} : Reach d e → Reach d (R.rot e)
  /-- Crossing an edge. -/
  | inv {d e : H} : Reach d e → Reach d (R.inv e)

/-- A **connected rotation system**: the set of darts is nonempty, the involution is
fixed-point-free, and the group generated by `σ` and the involution acts transitively on the
darts. -/
@[cluster_algebras "def_rotation_system"]
structure IsConnected : Prop where
  /-- There is a dart. -/
  nonempty : Nonempty H
  /-- `d ↦ d̄` is an involution. -/
  inv_involutive : Function.Involutive R.inv
  /-- `d ↦ d̄` has no fixed point. -/
  inv_ne : ∀ d, R.inv d ≠ d
  /-- The group generated by `σ` and `d ↦ d̄` acts transitively. -/
  transitive : ∀ d e : H,
    ∃ g ∈ Subgroup.closure ({R.inv, R.rot} : Set (Equiv.Perm H)), g d = e

/-- The **face permutation** `φ = σ ∘ (d ↦ d̄)`. -/
def facePerm : Equiv.Perm H := R.rot * R.inv

/-- `φ d = σ d̄`. -/
@[simp]
theorem facePerm_apply (d : H) : R.facePerm d = R.rot (R.inv d) := rfl

/-- A permutation's orbit through `x` stays inside any set containing `x` and closed under it. -/
private theorem mem_of_sameCycle [Finite H] {f : Equiv.Perm H} {S : Finset H}
    (hS : ∀ y ∈ S, f y ∈ S) {x y : H} (hx : x ∈ S) (h : f.SameCycle x y) : y ∈ S := by
  obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
  clear h
  induction n with
  | zero => simpa using hx
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    exact hS _ ih

section Finite

variable [Fintype H] [DecidableEq H]

/-- The **vertex** `v(d)` of a dart: its orbit under the rotation, as a set of darts. -/
def vertexOf (d : H) : Finset H := {e ∈ univ | R.rot.SameCycle d e}

/-- The **edge** `{d, d̄}` of a dart. -/
def edgeOf (d : H) : Finset H := {d, R.inv d}

/-- The **orbit** `f(d)` of a dart under the face permutation, as a set of darts. -/
def faceOf (d : H) : Finset H := {e ∈ univ | R.facePerm.SameCycle d e}

/-- The set `V` of vertices: the orbits of the rotation. -/
def vertices : Finset (Finset H) := univ.image R.vertexOf

/-- The set `E` of edges: the orbits `{d, d̄}`. -/
def edges : Finset (Finset H) := univ.image R.edgeOf

/-- The set `Φ` of orbits of the face permutation. -/
def faceOrbits : Finset (Finset H) := univ.image R.faceOf

/-- The **rational cycle space** `Z(R)`: the functions `c : H → ℚ` with `c(d̄) = -c(d)` for every
dart and `∑_{d ∈ v} c(d) = 0` for every vertex `v`. -/
@[cluster_algebras "def_rotation_system_cycle_space"]
def cycleSpace : Submodule ℚ (H → ℚ) where
  carrier := {c | (∀ d, c (R.inv d) = -c d) ∧ ∀ v ∈ R.vertices, ∑ d ∈ v, c d = 0}
  add_mem' := by
    rintro c c' ⟨hc, hcv⟩ ⟨hc', hcv'⟩
    refine ⟨fun d => ?_, fun v hv => ?_⟩
    · simp only [Pi.add_apply, hc, hc']
      ring
    · simp only [Pi.add_apply, sum_add_distrib, hcv v hv, hcv' v hv, add_zero]
  zero_mem' := by simp
  smul_mem' := by
    rintro a c ⟨hc, hcv⟩
    refine ⟨fun d => ?_, fun v hv => ?_⟩
    · simp [hc]
    · simp [← mul_sum, hcv v hv]

/-- `c ∈ Z(R)` if and only if `c(d̄) = -c(d)` for every dart and `c` sums to zero over every
vertex. -/
theorem mem_cycleSpace {c : H → ℚ} :
    c ∈ R.cycleSpace ↔ (∀ d, c (R.inv d) = -c d) ∧ ∀ v ∈ R.vertices, ∑ d ∈ v, c d = 0 :=
  Iff.rfl

/-- `e ∈ v(d)` if and only if `d` and `e` lie in the same orbit of `σ`. -/
@[simp]
theorem mem_vertexOf {d e : H} : e ∈ R.vertexOf d ↔ R.rot.SameCycle d e := by
  simp [vertexOf]

/-- A dart lies at its own vertex. -/
theorem self_mem_vertexOf (d : H) : d ∈ R.vertexOf d := by
  simpa using Equiv.Perm.SameCycle.refl _ _

/-- `σ d` lies at the vertex `v(d)`. -/
@[simp]
theorem rot_mem_vertexOf (d : H) : R.rot d ∈ R.vertexOf d := by
  simpa [Equiv.Perm.sameCycle_apply_right] using Equiv.Perm.SameCycle.refl _ _

/-- `σ⁻¹ d` lies at the vertex `v(d)`. -/
@[simp]
theorem rot_symm_mem_vertexOf (d : H) : R.rot.symm d ∈ R.vertexOf d := by
  simpa [Equiv.Perm.sameCycle_symm_apply_right] using Equiv.Perm.SameCycle.refl _ _

/-- Two darts have the same vertex if and only if they lie in the same orbit of `σ`. -/
theorem vertexOf_eq_vertexOf_iff {d e : H} :
    R.vertexOf d = R.vertexOf e ↔ R.rot.SameCycle d e := by
  refine ⟨fun h => R.mem_vertexOf.1 (h ▸ R.self_mem_vertexOf e), fun h => ?_⟩
  ext x
  simp only [mem_vertexOf]
  exact ⟨h.symm.trans, h.trans⟩

/-- If `e` lies at the vertex `v(d)`, then `v(e) = v(d)`. -/
theorem vertexOf_eq_of_mem {d e : H} (h : e ∈ R.vertexOf d) : R.vertexOf e = R.vertexOf d :=
  (R.vertexOf_eq_vertexOf_iff).2 ((R.mem_vertexOf).1 h).symm

/-- `v(σ d) = v(d)`. -/
@[simp]
theorem vertexOf_rot (d : H) : R.vertexOf (R.rot d) = R.vertexOf d :=
  R.vertexOf_eq_of_mem (R.rot_mem_vertexOf d)

/-- A set of darts is a vertex if and only if it is `v(d)` for some dart `d`. -/
@[simp]
theorem mem_vertices {v : Finset H} : v ∈ R.vertices ↔ ∃ d, R.vertexOf d = v := by
  simp [vertices]

/-- The vertex `v(d)` of a dart is a vertex. -/
theorem vertexOf_mem_vertices (d : H) : R.vertexOf d ∈ R.vertices := R.mem_vertices.2 ⟨d, rfl⟩

omit [Fintype H] in
/-- The darts of the edge `{d, d̄}` are `d` and `d̄`. -/
@[simp]
theorem mem_edgeOf {d e : H} : e ∈ R.edgeOf d ↔ e = d ∨ e = R.inv d := by
  simp [edgeOf]

/-- A set of darts is an edge if and only if it is `{d, d̄}` for some dart `d`. -/
@[simp]
theorem mem_edges {s : Finset H} : s ∈ R.edges ↔ ∃ d, R.edgeOf d = s := by
  simp [edges]

/-- `e ∈ f(d)` if and only if `d` and `e` lie in the same orbit of `φ`. -/
@[simp]
theorem mem_faceOf {d e : H} : e ∈ R.faceOf d ↔ R.facePerm.SameCycle d e := by
  simp [faceOf]

/-- A dart lies in its own orbit `f(d)`. -/
theorem self_mem_faceOf (d : H) : d ∈ R.faceOf d := by
  simpa using Equiv.Perm.SameCycle.refl _ _

/-- `φ d` lies in the orbit `f(d)`. -/
theorem facePerm_mem_faceOf (d : H) : R.facePerm d ∈ R.faceOf d := by
  rw [mem_faceOf, Equiv.Perm.sameCycle_apply_right]

/-- Two darts have the same orbit under `φ` if and only if they lie in the same cycle of `φ`. -/
theorem faceOf_eq_faceOf_iff {d e : H} : R.faceOf d = R.faceOf e ↔ R.facePerm.SameCycle d e := by
  refine ⟨fun h => R.mem_faceOf.1 (h ▸ R.self_mem_faceOf e), fun h => ?_⟩
  ext x
  simp only [mem_faceOf]
  exact ⟨h.symm.trans, h.trans⟩

/-- If `e` lies in the orbit `f(d)`, then `f(e) = f(d)`. -/
theorem faceOf_eq_of_mem {d e : H} (h : e ∈ R.faceOf d) : R.faceOf e = R.faceOf d :=
  (R.faceOf_eq_faceOf_iff).2 ((R.mem_faceOf).1 h).symm

/-- `f(φ d) = f(d)`. -/
@[simp]
theorem faceOf_facePerm (d : H) : R.faceOf (R.facePerm d) = R.faceOf d :=
  R.faceOf_eq_of_mem (R.facePerm_mem_faceOf d)

/-- A set of darts is an orbit of `φ` if and only if it is `f(d)` for some dart `d`. -/
@[simp]
theorem mem_faceOrbits {f : Finset H} : f ∈ R.faceOrbits ↔ ∃ d, R.faceOf d = f := by
  simp [faceOrbits]

/-- The orbit `f(d)` of a dart is an orbit of `φ`. -/
theorem faceOf_mem_faceOrbits (d : H) : R.faceOf d ∈ R.faceOrbits :=
  R.mem_faceOrbits.2 ⟨d, rfl⟩

/-- A vertex `v(d)` with `σ² d = d` has at most two darts. -/
theorem card_vertexOf_le_two {d : H} (h : R.rot (R.rot d) = d) : (R.vertexOf d).card ≤ 2 := by
  have hsub : R.vertexOf d ⊆ {d, R.rot d} := by
    intro e he
    refine mem_of_sameCycle (f := R.rot) (fun y hy => ?_) (by simp) ((R.mem_vertexOf).1 he)
    simp only [mem_insert, mem_singleton] at hy ⊢
    rcases hy with rfl | rfl
    · exact Or.inr rfl
    · exact Or.inl h
  exact (card_le_card hsub).trans card_le_two

end Finite

/-! ### Reachability and transitivity -/

/-- Reachability is transitive. -/
theorem Reach.trans {R : RotationSystem H} {d e f : H} (h₁ : R.Reach d e) (h₂ : R.Reach e f) :
    R.Reach d f := by
  induction h₂ with
  | refl => exact h₁
  | rot _ ih => exact ih.rot
  | inv _ ih => exact ih.inv

/-- Powers of a permutation all of whose steps are reachable are reachable. -/
theorem reach_pow_apply {g : Equiv.Perm H} (hg : ∀ x, R.Reach x (g x)) (n : ℕ) (d : H) :
    R.Reach d ((g ^ n) d) := by
  induction n with
  | zero => exact Reach.refl d
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    exact ih.trans (hg _)

/-- On a finite set of darts, reachability is symmetric. -/
theorem Reach.symm [Finite H] {R : RotationSystem H} {d e : H} (h : R.Reach d e) : R.Reach e d := by
  have back : ∀ g : Equiv.Perm H, (∀ x, R.Reach x (g x)) → ∀ x, R.Reach (g x) x := by
    intro g hg x
    obtain ⟨n, hn⟩ :=
      (Equiv.Perm.sameCycle_apply_left.2 (Equiv.Perm.SameCycle.refl g x)).exists_nat_pow_eq
    simpa only [hn] using R.reach_pow_apply hg n (g x)
  induction h with
  | refl => exact Reach.refl _
  | rot _ ih => exact (back R.rot (fun x => (Reach.refl x).rot) _).trans ih
  | inv _ ih => exact (back R.inv (fun x => (Reach.refl x).inv) _).trans ih

/-- On a finite set of darts, `R.Reach d e` holds exactly when some element of the group
generated by `σ` and `d ↦ d̄` maps `d` to `e`. -/
theorem reach_iff_exists_mem_closure [Finite H] {d e : H} :
    R.Reach d e ↔ ∃ g ∈ Subgroup.closure ({R.inv, R.rot} : Set (Equiv.Perm H)), g d = e := by
  constructor
  · intro h
    induction h with
    | refl => exact ⟨1, Subgroup.one_mem _, rfl⟩
    | rot _ ih =>
      obtain ⟨g, hg, rfl⟩ := ih
      exact ⟨R.rot * g, Subgroup.mul_mem _ (Subgroup.subset_closure (by simp)) hg, rfl⟩
    | inv _ ih =>
      obtain ⟨g, hg, rfl⟩ := ih
      exact ⟨R.inv * g, Subgroup.mul_mem _ (Subgroup.subset_closure (by simp)) hg, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    induction hg using Subgroup.closure_induction generalizing d with
    | mem g hg =>
      rcases hg with rfl | rfl
      · exact (Reach.refl d).inv
      · exact (Reach.refl d).rot
    | one => exact Reach.refl d
    | mul g h _ _ ihg ihh => exact (ihh (d := d)).trans (ihg (d := h d))
    | inv g _ ih => simpa using (ih (d := g⁻¹ d)).symm

/-- In a connected rotation system every dart reaches every other. -/
theorem IsConnected.reach [Finite H] {R : RotationSystem H} (hR : R.IsConnected) (d e : H) :
    R.Reach d e :=
  R.reach_iff_exists_mem_closure.2 (hR.transitive d e)

/-- A rotation system on a nonempty finite set, with a fixed-point-free involution, in which every
dart reaches every other, is connected. -/
theorem IsConnected.of_reach [Finite H] {R : RotationSystem H} (hne : Nonempty H)
    (hinv : Function.Involutive R.inv) (hfix : ∀ d, R.inv d ≠ d) (h : ∀ d e, R.Reach d e) :
    R.IsConnected :=
  ⟨hne, hinv, hfix, fun d e => R.reach_iff_exists_mem_closure.1 (h d e)⟩

/-! ### The faces are linked across darts -/

section Finite

variable [Fintype H] [DecidableEq H]

/-- The **dual adjacency** of the orbits of `φ`: `f` is linked to `f'` across a dart `d` with
`f(d) = f` and `f(d̄) = f'`. -/
def FaceAdj (f f' : Finset H) : Prop := ∃ d, R.faceOf d = f ∧ R.faceOf (R.inv d) = f'

/-- In a connected rotation system, the orbit of `φ` through any dart is linked to the orbit
through any other by a chain of dual adjacencies. -/
theorem IsConnected.reflTransGen_faceAdj {R : RotationSystem H} (hR : R.IsConnected) (d e : H) :
    Relation.ReflTransGen R.FaceAdj (R.faceOf d) (R.faceOf e) := by
  induction hR.reach d e with
  | refl => exact Relation.ReflTransGen.refl
  | @rot y _ ih =>
    refine ih.tail ⟨y, rfl, ?_⟩
    rw [← R.faceOf_facePerm (R.inv y), facePerm_apply, hR.inv_involutive y]
  | @inv y _ ih => exact ih.tail ⟨y, rfl, rfl⟩

private theorem exists_chain_of_reflTransGen {f f' : Finset H}
    (h : Relation.ReflTransGen R.FaceAdj f f') :
    ∃ (k : ℕ) (F : Fin (k + 1) → Finset H) (d : Fin k → H), F 0 = f ∧ F (Fin.last k) = f' ∧
      ∀ s : Fin k, R.faceOf (d s) = F s.castSucc ∧ R.faceOf (R.inv (d s)) = F s.succ := by
  induction h with
  | refl => exact ⟨0, fun _ => f, Fin.elim0, rfl, rfl, fun s => s.elim0⟩
  | @tail g g' _ hstep ih =>
    obtain ⟨k, F, d, h0, hl, hs⟩ := ih
    obtain ⟨x, hx, hx'⟩ := hstep
    refine ⟨k + 1, Fin.snoc (α := fun _ => Finset H) F g', Fin.snoc (α := fun _ => H) d x,
      ?_, ?_, fun s => ?_⟩
    · rw [← Fin.castSucc_zero, Fin.snoc_castSucc, h0]
    · rw [Fin.snoc_last]
    · induction s using Fin.lastCases with
      | last => simp only [Fin.snoc_last, Fin.snoc_castSucc, Fin.succ_last, hl, hx, hx', and_self]
      | cast t =>
        simp only [Fin.snoc_castSucc, ← Fin.castSucc_succ]
        exact hs t

/-- **The faces of a connected rotation system are linked across darts**: for orbits `f, f'` of
`φ` there are `k ≥ 0` and darts `d₁, …, d_k` such that, with `f₀ = f` and `f_s = f(d̄_s)`, one
has `f(d_s) = f_{s-1}` and `f_k = f'`. Here the darts are `d : Fin k → H` (`d s` is `d_{s+1}`)
and the orbits `F : Fin (k + 1) → Finset H` (`F s` is `f_s`). -/
@[cluster_algebras "lem_rotation_system_dual_connected"]
theorem IsConnected.exists_face_chain {R : RotationSystem H} (hR : R.IsConnected)
    {f f' : Finset H} (hf : f ∈ R.faceOrbits) (hf' : f' ∈ R.faceOrbits) :
    ∃ (k : ℕ) (F : Fin (k + 1) → Finset H) (d : Fin k → H), F 0 = f ∧ F (Fin.last k) = f' ∧
      ∀ s : Fin k, R.faceOf (d s) = F s.castSucc ∧ R.faceOf (R.inv (d s)) = F s.succ := by
  obtain ⟨d, rfl⟩ := R.mem_faceOrbits.1 hf
  obtain ⟨e, rfl⟩ := R.mem_faceOrbits.1 hf'
  exact R.exists_chain_of_reflTransGen (hR.reflTransGen_faceAdj d e)

end Finite

end RotationSystem

/-! ### Disk maps -/

/-- The data `(H, d ↦ d̄, σ, B)` of a **disk map**: a rotation system together with a set `bdry`
(`B`) of darts, the arcs of the boundary circle. The conditions are `DiskMap.IsDiskMap`. -/
@[cluster_algebras "def_disk_map"]
structure DiskMap (H : Type*) extends RotationSystem H where
  /-- The set `B` of boundary arcs. -/
  bdry : Finset H

namespace DiskMap

variable {H : Type*} [Fintype H] [DecidableEq H] (M : DiskMap H)

/-- The **exterior** `f_∞ = {d ∈ B : σ d ∉ B}`. -/
def exterior : Finset H := {d ∈ M.bdry | M.rot d ∉ M.bdry}

/-- A set of darts (in practice a vertex) is a **boundary vertex** if it contains a dart of `B`. -/
def IsBoundaryVertex (v : Finset H) : Prop := ∃ d ∈ v, d ∈ M.bdry

/-- Being a boundary vertex is decidable. -/
instance : DecidablePred M.IsBoundaryVertex := fun _ => by
  unfold IsBoundaryVertex
  infer_instance

/-- The set `V_∂` of **boundary vertices**. -/
def boundaryVertices : Finset (Finset H) := {v ∈ M.vertices | M.IsBoundaryVertex v}

/-- The set of **internal vertices**: the vertices containing no dart of `B`. -/
def internalVertices : Finset (Finset H) := {v ∈ M.vertices | ¬M.IsBoundaryVertex v}

/-- A **disk map**: `(H, d ↦ d̄, σ)` is a connected rotation system (so `H` is nonempty, the
involution is fixed-point-free and the group generated by `σ` and the involution is transitive),
`B` is closed under the involution, Euler's relation `|V| - |E| + |Φ| = 2` holds, every boundary
vertex consists of exactly three darts, exactly two of them in `B`, and some orbit `f` of `φ`
satisfies `f ⊆ B`, `f ∪ f̄ = B` and `f ∩ f̄ = ∅`. -/
@[cluster_algebras "def_disk_map"]
structure IsDiskMap : Prop extends M.toRotationSystem.IsConnected where
  /-- `B` is closed under `d ↦ d̄`. -/
  inv_mem_bdry : ∀ d ∈ M.bdry, M.inv d ∈ M.bdry
  /-- Euler's relation. -/
  euler : (M.vertices.card : ℤ) - M.edges.card + M.faceOrbits.card = 2
  /-- Every boundary vertex has three darts, two of them in `B`. -/
  boundaryVertex_card : ∀ v ∈ M.boundaryVertices,
    v.card = 3 ∧ (v.filter (· ∈ M.bdry)).card = 2
  /-- Some orbit of `φ` is half of the boundary. -/
  exists_orbit : ∃ f ∈ M.faceOrbits, f ⊆ M.bdry ∧
    f ∪ f.map M.inv.toEmbedding = M.bdry ∧ Disjoint f (f.map M.inv.toEmbedding)

/-! ### Faces -/

/-- The **faces** of a disk map: the orbits of `φ` other than the exterior. -/
@[cluster_algebras "def_plabic_face"]
def faces : Finset (Finset H) := M.faceOrbits.erase M.exterior

/-- The **internal faces**: the faces containing no dart of `B`. -/
@[cluster_algebras "def_plabic_face"]
def internalFaces : Finset (Finset H) := {f ∈ M.faces | Disjoint f M.bdry}

/-- The **boundary faces**: the faces containing a dart of `B`. -/
@[cluster_algebras "def_plabic_face"]
def boundaryFaces : Finset (Finset H) := {f ∈ M.faces | ¬Disjoint f M.bdry}

/-- The orbit of `φ` **to the right of** a dart `d`: the orbit of `d`. For `d ∉ B` it is a face. -/
@[cluster_algebras "def_plabic_face"]
abbrev rightFace (d : H) : Finset H := M.faceOf d

/-- The orbit of `φ` **to the left of** a dart `d`: the orbit of `d̄`. For `d ∉ B` it is a face. -/
@[cluster_algebras "def_plabic_face"]
abbrev leftFace (d : H) : Finset H := M.faceOf (M.inv d)

/-! ### Leaves and hollow digons -/

/-- An **internal leaf**: an internal vertex consisting of exactly one dart. -/
@[cluster_algebras "def_plabic_leaf"]
def IsInternalLeaf (v : Finset H) : Prop := v ∈ M.internalVertices ∧ v.card = 1

/-- A **hollow digon**: an internal face consisting of exactly two darts `d₁, d₂` with
`v(d₁) ≠ v(d₂)`. -/
@[cluster_algebras "def_plabic_leaf"]
def IsHollowDigon (f : Finset H) : Prop :=
  f ∈ M.internalFaces ∧ ∃ d₁ d₂, f = {d₁, d₂} ∧ M.vertexOf d₁ ≠ M.vertexOf d₂

/-! ### Basic API -/

omit [Fintype H] in
/-- `d ∈ f_∞` if and only if `d ∈ B` and `σ d ∉ B`. -/
@[simp]
theorem mem_exterior {d : H} : d ∈ M.exterior ↔ d ∈ M.bdry ∧ M.rot d ∉ M.bdry :=
  mem_filter

omit [Fintype H] in
/-- The exterior `f_∞` is contained in `B`. -/
theorem exterior_subset_bdry : M.exterior ⊆ M.bdry := filter_subset _ _

/-- The boundary vertices are the vertices containing a dart of `B`. -/
theorem mem_boundaryVertices {v : Finset H} :
    v ∈ M.boundaryVertices ↔ v ∈ M.vertices ∧ M.IsBoundaryVertex v :=
  mem_filter

/-- The internal vertices are the vertices containing no dart of `B`. -/
theorem mem_internalVertices {v : Finset H} :
    v ∈ M.internalVertices ↔ v ∈ M.vertices ∧ ¬M.IsBoundaryVertex v :=
  mem_filter

/-- The vertex `v(d)` is a boundary vertex if and only if it contains a dart of `B`. -/
theorem vertexOf_mem_boundaryVertices {d : H} :
    M.vertexOf d ∈ M.boundaryVertices ↔ M.IsBoundaryVertex (M.vertexOf d) := by
  simp [mem_boundaryVertices]

/-- The vertex `v(d)` is an internal vertex if and only if it contains no dart of `B`. -/
theorem vertexOf_mem_internalVertices {d : H} :
    M.vertexOf d ∈ M.internalVertices ↔ ¬M.IsBoundaryVertex (M.vertexOf d) := by
  simp [mem_internalVertices]

/-- The vertex of a dart of `B` is a boundary vertex. -/
theorem isBoundaryVertex_vertexOf_of_mem {d : H} (hd : d ∈ M.bdry) :
    M.IsBoundaryVertex (M.vertexOf d) :=
  ⟨d, M.self_mem_vertexOf d, hd⟩

/-- The faces are the orbits of `φ` other than the exterior. -/
theorem mem_faces {f : Finset H} : f ∈ M.faces ↔ f ≠ M.exterior ∧ f ∈ M.faceOrbits :=
  mem_erase

/-- The internal faces are the faces containing no dart of `B`. -/
theorem mem_internalFaces {f : Finset H} :
    f ∈ M.internalFaces ↔ f ∈ M.faces ∧ Disjoint f M.bdry :=
  mem_filter

/-- The boundary faces are the faces containing a dart of `B`. -/
theorem mem_boundaryFaces {f : Finset H} :
    f ∈ M.boundaryFaces ↔ f ∈ M.faces ∧ ¬Disjoint f M.bdry :=
  mem_filter

/-! ### Boundary vertices with three darts

The following facts hold at a boundary vertex `v(x)` as soon as every boundary vertex has three
darts, two of them in `B`; they do not need the other conditions of a disk map. -/

section BoundaryVertex

variable {M}
variable (hdeg : ∀ v ∈ M.boundaryVertices, v.card = 3 ∧ (v.filter (· ∈ M.bdry)).card = 2)
  {x : H} (hv : M.IsBoundaryVertex (M.vertexOf x))

include hdeg hv

/-- At a boundary vertex, `σ² x ≠ x`. -/
theorem rot_rot_ne_of_isBoundaryVertex : M.rot (M.rot x) ≠ x := by
  intro h
  have h2 := M.card_vertexOf_le_two h
  have h3 := (hdeg _ (M.vertexOf_mem_boundaryVertices.2 hv)).1
  omega

/-- At a boundary vertex, `σ x ≠ x`. -/
theorem rot_ne_of_isBoundaryVertex : M.rot x ≠ x := by
  intro h
  exact rot_rot_ne_of_isBoundaryVertex hdeg hv (by rw [h, h])

/-- At a boundary vertex there is only one dart not in `B`. -/
theorem eq_of_notMem_bdry {y z : H} (hy : y ∈ M.vertexOf x) (hz : z ∈ M.vertexOf x)
    (hyB : y ∉ M.bdry) (hzB : z ∉ M.bdry) : y = z := by
  obtain ⟨h3, h2⟩ := hdeg _ (M.vertexOf_mem_boundaryVertices.2 hv)
  have h1 : ((M.vertexOf x).filter (· ∉ M.bdry)).card = 1 := by
    have := card_filter_add_card_filter_not (s := M.vertexOf x) (· ∈ M.bdry)
    omega
  exact card_le_one.1 h1.le y (mem_filter.2 ⟨hy, hyB⟩) z (mem_filter.2 ⟨hz, hzB⟩)

/-- At a boundary vertex there are no three distinct darts in `B`. -/
theorem not_three_mem_bdry {y z w : H} (hy : y ∈ M.vertexOf x) (hz : z ∈ M.vertexOf x)
    (hw : w ∈ M.vertexOf x) (hyB : y ∈ M.bdry) (hzB : z ∈ M.bdry) (hwB : w ∈ M.bdry)
    (hyz : y ≠ z) (hyw : y ≠ w) (hzw : z ≠ w) : False := by
  obtain ⟨-, h2⟩ := hdeg _ (M.vertexOf_mem_boundaryVertices.2 hv)
  have : 2 < ((M.vertexOf x).filter (· ∈ M.bdry)).card :=
    two_lt_card.2 ⟨y, mem_filter.2 ⟨hy, hyB⟩, z, mem_filter.2 ⟨hz, hzB⟩, w,
      mem_filter.2 ⟨hw, hwB⟩, hyz, hyw, hzw⟩
  omega

end BoundaryVertex

/-! ### The exterior -/

/-- If every boundary vertex consists of three darts, two of them in `B`, then the exterior has
at most half the darts of `B`. -/
theorem two_mul_card_exterior_le_card_bdry
    (hdeg : ∀ v ∈ M.boundaryVertices, v.card = 3 ∧ (v.filter (· ∈ M.bdry)).card = 2) :
    2 * M.exterior.card ≤ M.bdry.card := by
  have hd : Disjoint M.exterior (M.exterior.map M.rot.symm.toEmbedding) := by
    rw [disjoint_left]
    intro d hd hd'
    rw [mem_map_equiv, Equiv.symm_symm] at hd'
    exact (M.mem_exterior.1 hd).2 (M.mem_exterior.1 hd').1
  have hs : M.exterior ∪ M.exterior.map M.rot.symm.toEmbedding ⊆ M.bdry := by
    refine union_subset M.exterior_subset_bdry fun y hy => ?_
    rw [mem_map_equiv, Equiv.symm_symm] at hy
    obtain ⟨hryB, hrryB⟩ := M.mem_exterior.1 hy
    by_contra hyB
    have hv := M.isBoundaryVertex_vertexOf_of_mem hryB
    have hyv : y ∈ M.vertexOf (M.rot y) := by
      rw [RotationSystem.mem_vertexOf, Equiv.Perm.sameCycle_apply_left]
    have := eq_of_notMem_bdry hdeg hv hyv (M.rot_mem_vertexOf _) hyB hrryB
    exact rot_rot_ne_of_isBoundaryVertex hdeg hv (by rw [← this])
  calc 2 * M.exterior.card = (M.exterior ∪ M.exterior.map M.rot.symm.toEmbedding).card := by
        rw [card_union_of_disjoint hd, card_map]
        ring
    _ ≤ M.bdry.card := card_le_card hs

/-- **The exterior is the exterior orbit**: if `d ↦ d̄` is an involution, `B` is closed under it,
and every boundary vertex consists of three darts, two of them in `B`, then an orbit `f` of `φ`
with `f ⊆ B`, `f ∪ f̄ = B` and `f ∩ f̄ = ∅` is the exterior `f_∞ = {d ∈ B : σ d ∉ B}`. -/
@[cluster_algebras "lem_disk_map_exterior_unique"]
theorem eq_exterior_of_mem_faceOrbits (hinv : Function.Involutive M.inv)
    (hbdry : ∀ d ∈ M.bdry, M.inv d ∈ M.bdry)
    (hdeg : ∀ v ∈ M.boundaryVertices, v.card = 3 ∧ (v.filter (· ∈ M.bdry)).card = 2)
    {f : Finset H} (hf : f ∈ M.faceOrbits) (hfB : f ⊆ M.bdry)
    (hunion : f ∪ f.map M.inv.toEmbedding = M.bdry)
    (hdisj : Disjoint f (f.map M.inv.toEmbedding)) :
    f = M.exterior := by
  obtain ⟨d₀, rfl⟩ := M.mem_faceOrbits.1 hf
  have hsub : M.faceOf d₀ ⊆ M.exterior := by
    intro x hx
    have hxB := hfB hx
    have hv := M.isBoundaryVertex_vertexOf_of_mem hxB
    set y := M.rot.symm x with hy
    have hφ : M.facePerm (M.inv y) = x := by simp [y, hinv y]
    have hz : M.inv y ∈ M.faceOf d₀ := by
      rw [RotationSystem.mem_faceOf] at hx ⊢
      exact hx.trans (by rw [← hφ, Equiv.Perm.sameCycle_apply_left])
    have hyB : y ∈ M.bdry := by simpa [hinv y] using hbdry _ (hfB hz)
    have hxy : x ≠ y := by
      intro h
      apply rot_ne_of_isBoundaryVertex hdeg hv
      conv_lhs => rw [h, hy, Equiv.apply_symm_apply]
    have hyr : y ≠ M.rot x := by
      intro h
      apply rot_rot_ne_of_isBoundaryVertex hdeg hv
      rw [← h, hy, Equiv.apply_symm_apply]
    exact M.mem_exterior.2 ⟨hxB, fun hr => not_three_mem_bdry hdeg hv (M.self_mem_vertexOf x)
      (M.rot_symm_mem_vertexOf x) (M.rot_mem_vertexOf x) hxB hyB hr hxy
      (rot_ne_of_isBoundaryVertex hdeg hv).symm hyr⟩
  have hcardB : M.bdry.card = 2 * (M.faceOf d₀).card := by
    rw [← hunion, card_union_of_disjoint hdisj, card_map]
    ring
  have := M.two_mul_card_exterior_le_card_bdry hdeg
  exact eq_of_subset_of_card_le hsub (by omega)

/-- An orbit of `φ` through a dart not in `B` is a face. -/
theorem faceOf_mem_faces {d : H} (hd : d ∉ M.bdry) : M.faceOf d ∈ M.faces := by
  refine M.mem_faces.2 ⟨fun h => hd (M.exterior_subset_bdry ?_), M.faceOf_mem_faceOrbits d⟩
  rw [← h]
  exact M.self_mem_faceOf d

namespace IsDiskMap

variable {M} (hM : M.IsDiskMap)

include hM

/-- In a disk map, the exterior `f_∞` is an orbit of `φ` with `f_∞ ⊆ B`, `f_∞ ∪ f̄_∞ = B` and
`f_∞ ∩ f̄_∞ = ∅`. -/
theorem exterior_spec : M.exterior ∈ M.faceOrbits ∧ M.exterior ⊆ M.bdry ∧
    M.exterior ∪ M.exterior.map M.inv.toEmbedding = M.bdry ∧
    Disjoint M.exterior (M.exterior.map M.inv.toEmbedding) := by
  obtain ⟨f, hf, hfB, hu, hd⟩ := hM.exists_orbit
  obtain rfl := M.eq_exterior_of_mem_faceOrbits hM.inv_involutive hM.inv_mem_bdry
    hM.boundaryVertex_card hf hfB hu hd
  exact ⟨hf, hfB, hu, hd⟩

/-- In a disk map the exterior is an orbit of `φ`. -/
theorem exterior_mem_faceOrbits : M.exterior ∈ M.faceOrbits :=
  hM.exterior_spec.1

/-- In a disk map, `B` is the union of the exterior and its image under `d ↦ d̄`. -/
theorem exterior_union_map_inv : M.exterior ∪ M.exterior.map M.inv.toEmbedding = M.bdry :=
  hM.exterior_spec.2.2.1

/-- In a disk map, the exterior is disjoint from its image under `d ↦ d̄`. -/
theorem disjoint_exterior_map_inv : Disjoint M.exterior (M.exterior.map M.inv.toEmbedding) :=
  hM.exterior_spec.2.2.2

/-- In a disk map, the reverse `d̄` of a dart lies in `B` if and only if `d` does. -/
theorem inv_mem_bdry_iff {d : H} : M.inv d ∈ M.bdry ↔ d ∈ M.bdry :=
  ⟨fun h => by simpa [hM.inv_involutive d] using hM.inv_mem_bdry _ h, hM.inv_mem_bdry d⟩

/-- If `x ∉ B` and `v(x)` is a boundary vertex, the face to the right of `x` is a boundary
face. -/
@[cluster_algebras "lem_leg_faces_boundary"]
theorem rightFace_mem_boundaryFaces {x : H} (hx : x ∉ M.bdry)
    (hv : M.IsBoundaryVertex (M.vertexOf x)) : M.rightFace x ∈ M.boundaryFaces := by
  refine M.mem_boundaryFaces.2 ⟨M.faceOf_mem_faces hx, ?_⟩
  set y := M.rot.symm x with hy
  have hyB : y ∈ M.bdry := by
    by_contra hyB
    have := eq_of_notMem_bdry hM.boundaryVertex_card hv (M.rot_symm_mem_vertexOf x)
      (M.self_mem_vertexOf x) hyB hx
    have h2 := congrArg M.rot this
    rw [Equiv.apply_symm_apply] at h2
    exact rot_ne_of_isBoundaryVertex hM.boundaryVertex_card hv h2.symm
  have hφ : M.facePerm (M.inv y) = x := by simp [y, hM.inv_involutive y]
  have hz : M.inv y ∈ M.faceOf x := by
    rw [RotationSystem.mem_faceOf, ← hφ, Equiv.Perm.sameCycle_apply_left]
  exact not_disjoint_iff.2 ⟨_, hz, hM.inv_mem_bdry _ hyB⟩

/-- If `x ∉ B` and `v(x)` is a boundary vertex, the face to the left of `x` is a boundary
face. -/
@[cluster_algebras "lem_leg_faces_boundary"]
theorem leftFace_mem_boundaryFaces {x : H} (hx : x ∉ M.bdry)
    (hv : M.IsBoundaryVertex (M.vertexOf x)) : M.leftFace x ∈ M.boundaryFaces := by
  refine M.mem_boundaryFaces.2 ⟨M.faceOf_mem_faces fun h => hx (hM.inv_mem_bdry_iff.1 h), ?_⟩
  have hrB : M.rot x ∈ M.bdry := by
    by_contra hrB
    exact rot_ne_of_isBoundaryVertex hM.boundaryVertex_card hv
      (eq_of_notMem_bdry hM.boundaryVertex_card hv (M.rot_mem_vertexOf x)
        (M.self_mem_vertexOf x) hrB hx)
  have hz : M.rot x ∈ M.faceOf (M.inv x) := by
    have hφ : M.facePerm (M.inv x) = M.rot x := by simp [hM.inv_involutive x]
    rw [← hφ]
    exact M.facePerm_mem_faceOf _
  exact not_disjoint_iff.2 ⟨_, hz, hrB⟩

end IsDiskMap

end DiskMap

/-! ### Conjugate permutations -/

/-- A bijection intertwining two permutations of finite sets maps their orbits onto each other. -/
private theorem sameCycle_of_semiconj {α β : Type*} [Finite α] {f : Equiv.Perm α}
    {g : Equiv.Perm β} (θ : α ≃ β) (h : ∀ x, θ (f x) = g (θ x)) {x y : α}
    (hxy : f.SameCycle x y) : g.SameCycle (θ x) (θ y) := by
  obtain ⟨n, rfl⟩ := hxy.exists_nat_pow_eq
  exact ⟨n, by simpa only [zpow_natCast, Equiv.Perm.coe_pow] using
    ((Function.Semiconj.iterate_right h n) x).symm⟩

/-! ### Plabic graphs -/

/-- The data `(H, d ↦ d̄, σ, B, κ, β)` of a **plabic graph** with `b` boundary vertices: a disk
map's data together with a colouring `colour : H → Shade` of darts (the colour `κ(v(d))` of the
vertex of `d`) and a dart `leg i` at each labelled boundary vertex `β(i) = v(leg i)`. Labels are
`0`-indexed: `i : Fin b` stands for the label `i + 1`. The conditions are
`PlabicData.IsPlabicGraph`. -/
@[cluster_algebras "def_plabic_graph"]
structure PlabicData (H : Type*) (b : ℕ) extends DiskMap H where
  /-- The colour of the vertex of each dart. -/
  colour : H → Shade
  /-- A dart at the vertex labelled `i`; for a plabic graph, the leg `g_i`. -/
  leg : Fin b → H

namespace PlabicData

variable {H : Type*} [Fintype H] [DecidableEq H] {b : ℕ} (G : PlabicData H b)

/-- The vertex `β(i)` labelled `i` (the label `i + 1` in `1`-indexed labels): the vertex of
`leg i`. -/
def bvertex (i : Fin b) : Finset H := G.vertexOf (G.leg i)

/-- A **plabic graph** with `b ≥ 1` boundary vertices: the underlying data is a disk map, the
colouring is constant on each internal vertex, `β` is a bijection from the labels onto the
boundary vertices, `leg i` is the dart of `β(i)` not in `B`, and for every label `i` some dart of
the exterior at `β(i + 1)` runs to `β(i)` (labels modulo `b`, so the boundary vertices are
labelled clockwise). In `0`-indexed labels, `i + 1` modulo `b` is `finRotate b i`. -/
@[cluster_algebras "def_plabic_graph"]
structure IsPlabicGraph : Prop extends G.toDiskMap.IsDiskMap where
  /-- There is at least one boundary vertex. -/
  one_le : 1 ≤ b
  /-- The colour is a function of the vertex, at internal vertices. -/
  colour_rot : ∀ d, ¬G.IsBoundaryVertex (G.vertexOf d) → G.colour (G.rot d) = G.colour d
  /-- The chosen dart at `β(i)` is the leg, the dart not in `B`. -/
  leg_notMem_bdry : ∀ i, G.leg i ∉ G.bdry
  /-- Each `β(i)` is a boundary vertex. -/
  bvertex_mem : ∀ i, G.bvertex i ∈ G.boundaryVertices
  /-- `β` is injective. -/
  bvertex_injective : Function.Injective G.bvertex
  /-- `β` is onto the boundary vertices. -/
  exists_bvertex_eq : ∀ v ∈ G.boundaryVertices, ∃ i, G.bvertex i = v
  /-- Some dart of the exterior at `β(i + 1)` runs to `β(i)`. -/
  exists_exterior : ∀ i, ∃ d ∈ G.exterior, d ∈ G.bvertex (finRotate b i) ∧ G.inv d ∈ G.bvertex i

/-- A **lollipop** at the label `i`: an internal leaf whose dart runs to `β(i)`. -/
@[cluster_algebras "def_plabic_leaf"]
def IsLollipop (i : Fin b) (v : Finset H) : Prop :=
  G.IsInternalLeaf v ∧ ∃ d ∈ v, G.inv d ∈ G.bvertex i

/-- A lollipop at `i` **of colour** `s`: white or black according to the colour of the leaf. -/
@[cluster_algebras "def_plabic_leaf"]
def IsLollipopOfColour (i : Fin b) (s : Shade) (v : Finset H) : Prop :=
  G.IsLollipop i v ∧ ∀ d ∈ v, G.colour d = s

/-! ### Isomorphisms -/

/-- An **isomorphism** `G → G'` of tuples of the shape of a plabic graph: a bijection
`θ : H ≃ H'` of darts commuting with the involutions and the rotations, mapping `B` onto `B'`,
preserving the colours of internal vertices, and mapping `β(i) \ B` onto `β'(i) \ B'` for every
label `i`. -/
@[cluster_algebras "def_plabic_isomorphism"]
structure Iso {H' : Type*} [Fintype H'] [DecidableEq H'] (G' : PlabicData H' b) where
  /-- The bijection of darts. -/
  toEquiv : H ≃ H'
  /-- `θ(d̄) = θ(d)̄`. -/
  map_inv : ∀ d, toEquiv (G.inv d) = G'.inv (toEquiv d)
  /-- `θ(σ d) = σ'(θ d)`. -/
  map_rot : ∀ d, toEquiv (G.rot d) = G'.rot (toEquiv d)
  /-- `θ(B) = B'`. -/
  mem_bdry_iff : ∀ d, toEquiv d ∈ G'.bdry ↔ d ∈ G.bdry
  /-- `κ'(v(θ d)) = κ(v(d))` whenever `v(d)` is internal. -/
  map_colour : ∀ d, ¬G.IsBoundaryVertex (G.vertexOf d) → G'.colour (toEquiv d) = G.colour d
  /-- `θ(β(i) \ B) = β'(i) \ B'`. -/
  map_bvertex : ∀ i, ((G.bvertex i).filter (· ∉ G.bdry)).map toEquiv.toEmbedding =
    (G'.bvertex i).filter (· ∉ G'.bdry)

/-- Two tuples are **isomorphic** if an isomorphism exists. -/
@[cluster_algebras "def_plabic_isomorphism"]
def Isomorphic {H' : Type*} [Fintype H'] [DecidableEq H'] (G' : PlabicData H' b) : Prop :=
  Nonempty (G.Iso G')

namespace Iso

variable {G} {H' H'' : Type*} [Fintype H'] [DecidableEq H'] [Fintype H''] [DecidableEq H'']
  {G' : PlabicData H' b} {G'' : PlabicData H'' b}

/-- The inverse bijection intertwines the rotations. -/
theorem symm_map_rot (θ : G.Iso G') (d : H') :
    θ.toEquiv.symm (G'.rot d) = G.rot (θ.toEquiv.symm d) := by
  apply θ.toEquiv.injective
  simp [θ.map_rot]

/-- The inverse bijection intertwines the involutions. -/
theorem symm_map_inv (θ : G.Iso G') (d : H') :
    θ.toEquiv.symm (G'.inv d) = G.inv (θ.toEquiv.symm d) := by
  apply θ.toEquiv.injective
  simp [θ.map_inv]

/-- An isomorphism maps each vertex `v(d)` onto the vertex `v(θ d)`. -/
theorem map_vertexOf (θ : G.Iso G') (d : H) :
    (G.vertexOf d).map θ.toEquiv.toEmbedding = G'.vertexOf (θ.toEquiv d) := by
  ext y
  rw [mem_map_equiv, RotationSystem.mem_vertexOf, RotationSystem.mem_vertexOf]
  constructor
  · intro h
    simpa using sameCycle_of_semiconj θ.toEquiv θ.map_rot h
  · intro h
    simpa using sameCycle_of_semiconj θ.toEquiv.symm θ.symm_map_rot h

/-- An isomorphism maps the exterior onto the exterior. -/
theorem map_exterior (θ : G.Iso G') :
    G.exterior.map θ.toEquiv.toEmbedding = G'.exterior := by
  ext y
  rw [mem_map_equiv, DiskMap.mem_exterior, DiskMap.mem_exterior, ← θ.mem_bdry_iff,
    ← θ.mem_bdry_iff (G.rot _), θ.map_rot, Equiv.apply_symm_apply]

/-- An isomorphism maps boundary vertices to boundary vertices and internal vertices to internal
vertices. -/
theorem isBoundaryVertex_vertexOf_iff (θ : G.Iso G') (d : H) :
    G'.IsBoundaryVertex (G'.vertexOf (θ.toEquiv d)) ↔ G.IsBoundaryVertex (G.vertexOf d) := by
  rw [← θ.map_vertexOf]
  simp only [DiskMap.IsBoundaryVertex, mem_map_equiv]
  constructor
  · rintro ⟨e, he, heB⟩
    exact ⟨_, he, by rwa [← θ.mem_bdry_iff, Equiv.apply_symm_apply]⟩
  · rintro ⟨e, he, heB⟩
    exact ⟨θ.toEquiv e, by rwa [Equiv.symm_apply_apply], (θ.mem_bdry_iff e).2 heB⟩

/-- The identity isomorphism. -/
def refl (G : PlabicData H b) : G.Iso G where
  toEquiv := Equiv.refl H
  map_inv _ := rfl
  map_rot _ := rfl
  mem_bdry_iff _ := Iff.rfl
  map_colour _ _ := rfl
  map_bvertex _ := by simp

/-- The inverse of an isomorphism. -/
def symm (θ : G.Iso G') : G'.Iso G where
  toEquiv := θ.toEquiv.symm
  map_inv := θ.symm_map_inv
  map_rot := θ.symm_map_rot
  mem_bdry_iff d := by rw [← θ.mem_bdry_iff, Equiv.apply_symm_apply]
  map_colour d hd := by
    have hd' : ¬G.IsBoundaryVertex (G.vertexOf (θ.toEquiv.symm d)) := by
      rwa [← θ.isBoundaryVertex_vertexOf_iff, Equiv.apply_symm_apply]
    have := θ.map_colour _ hd'
    rw [Equiv.apply_symm_apply] at this
    exact this.symm
  map_bvertex i := by
    rw [← θ.map_bvertex i, map_map]
    ext y
    simp

/-- The composite of two isomorphisms. -/
def trans (θ : G.Iso G') (θ' : G'.Iso G'') : G.Iso G'' where
  toEquiv := θ.toEquiv.trans θ'.toEquiv
  map_inv d := by simp [θ.map_inv, θ'.map_inv]
  map_rot d := by simp [θ.map_rot, θ'.map_rot]
  mem_bdry_iff d := by simp [θ.mem_bdry_iff, θ'.mem_bdry_iff]
  map_colour d hd := by
    have hd' : ¬G'.IsBoundaryVertex (G'.vertexOf (θ.toEquiv d)) := by
      rwa [θ.isBoundaryVertex_vertexOf_iff]
    simp only [Equiv.trans_apply]
    rw [θ'.map_colour _ hd', θ.map_colour _ hd]
  map_bvertex i := by
    rw [← θ'.map_bvertex i, ← θ.map_bvertex i, map_map]
    rfl

/-- The underlying bijection of the identity isomorphism is the identity. -/
@[simp]
theorem refl_toEquiv (G : PlabicData H b) : (Iso.refl G).toEquiv = Equiv.refl H := rfl

/-- The underlying bijection of the inverse isomorphism is the inverse bijection. -/
@[simp]
theorem symm_toEquiv (θ : G.Iso G') : θ.symm.toEquiv = θ.toEquiv.symm := rfl

/-- The underlying bijection of a composite isomorphism is the composite of the bijections. -/
@[simp]
theorem trans_toEquiv (θ : G.Iso G') (θ' : G'.Iso G'') :
    (θ.trans θ').toEquiv = θ.toEquiv.trans θ'.toEquiv := rfl

end Iso

/-- Every plabic graph is isomorphic to itself. -/
theorem Isomorphic.refl : G.Isomorphic G := ⟨Iso.refl G⟩

/-- Isomorphism of plabic graphs is symmetric. -/
theorem Isomorphic.symm {H' : Type*} [Fintype H'] [DecidableEq H'] {G' : PlabicData H' b}
    (h : G.Isomorphic G') : G'.Isomorphic G :=
  h.elim fun θ => ⟨θ.symm⟩

/-- Isomorphism of plabic graphs is transitive. -/
theorem Isomorphic.trans {H' H'' : Type*} [Fintype H'] [DecidableEq H'] [Fintype H'']
    [DecidableEq H''] {G' : PlabicData H' b} {G'' : PlabicData H'' b}
    (h : G.Isomorphic G') (h' : G'.Isomorphic G'') : G.Isomorphic G'' :=
  h.elim fun θ => h'.elim fun θ' => ⟨θ.trans θ'⟩

/-! ### Legs -/

/-- The leg `g_i` lies at the vertex `β(i)`. -/
theorem leg_mem_bvertex (i : Fin b) : G.leg i ∈ G.bvertex i := G.self_mem_vertexOf _

section IsPlabicGraph

variable {G} (hG : G.IsPlabicGraph)

include hG

/-- In a plabic graph, the leg `g_i` is the unique dart of `β(i)` not in `B`. -/
theorem IsPlabicGraph.filter_bvertex_notMem_bdry (i : Fin b) :
    (G.bvertex i).filter (· ∉ G.bdry) = {G.leg i} := by
  have hv : G.IsBoundaryVertex (G.vertexOf (G.leg i)) :=
    G.vertexOf_mem_boundaryVertices.1 (hG.bvertex_mem i)
  ext y
  simp only [mem_filter, mem_singleton]
  constructor
  · rintro ⟨hy, hyB⟩
    exact DiskMap.eq_of_notMem_bdry hG.boundaryVertex_card hv hy (G.self_mem_vertexOf _) hyB
      (hG.leg_notMem_bdry i)
  · rintro rfl
    exact ⟨G.self_mem_vertexOf _, hG.leg_notMem_bdry i⟩

end IsPlabicGraph

/-- For plabic graphs, an isomorphism maps each leg to the corresponding leg:
`θ(β(i) \ B) = β'(i) \ B'` reads `θ(g_i) = g'_i`. -/
theorem Iso.map_leg {H' : Type*} [Fintype H'] [DecidableEq H'] {G : PlabicData H b}
    {G' : PlabicData H' b} (hG : G.IsPlabicGraph) (hG' : G'.IsPlabicGraph) (θ : G.Iso G')
    (i : Fin b) : θ.toEquiv (G.leg i) = G'.leg i := by
  have := θ.map_bvertex i
  rwa [hG.filter_bvertex_notMem_bdry, hG'.filter_bvertex_notMem_bdry, map_singleton,
    singleton_inj] at this

end PlabicData

/-- A **plabic graph** with `b` boundary vertices, bundled with its dart type, so that graphs on
different dart types can be collected in one type. -/
structure PlabicGraph (b : ℕ) where
  /-- The darts. -/
  Dart : Type
  [instFintype : Fintype Dart]
  [instDecidableEq : DecidableEq Dart]
  /-- The data of the graph. -/
  data : PlabicData Dart b
  /-- The conditions of a plabic graph hold. -/
  isPlabicGraph : data.IsPlabicGraph

attribute [instance] PlabicGraph.instFintype PlabicGraph.instDecidableEq

/-- Two bundled plabic graphs are **isomorphic** when their underlying tuples are. -/
def PlabicGraph.Isomorphic {b : ℕ} (G G' : PlabicGraph b) : Prop :=
  G.data.Isomorphic G'.data

end ClusterAlgebras
