/-!
# Rooted trees in plabic graphs and plabic trees

A *rooted tree* `T = (v, W)` of a plabic graph `G` is a vertex `v` (the root) together with a
nonempty set `W` of internal vertices such that every edge at a vertex of `W` runs into
`W ∪ {v}`, the darts of these edges at `v` form an interval `a₁, σ a₁, …, σ^(k-1) a₁` of the
rotation, and the graph on `W ∪ {v}` formed by these edges is a tree. Cutting `T` out of `G`
and closing it off with a loop at a new boundary vertex gives a plabic graph `P_T` with one
boundary vertex and exactly one face. The model case is the *lollipop graph* `L_c`. A *plabic
tree*, a plabic graph with one boundary vertex and exactly one face, is a simple tree: its graph
has no loops and no parallel edges.

The face counts rest on the *Euler inequality* for maps: if the group generated by a permutation
`σ` and an involution `ι` of a finite set `X` is transitive, then
`#orbits(σ ι) + #orbits(σ) + #orbits(ι) ≤ |X| + 2`. For a connected rotation system this reads
`|V| - |E| + |Φ| ≤ 2`. It is proved by removing the edges `{d, ι d}` one at a time: an edge whose
ends lie in different orbits of `σ` is contracted, which leaves `σ ι` unchanged, and any other
edge is deleted, which changes the number of orbits of `σ ι` by one.

## Main definitions

* `ClusterAlgebras.PlabicData.RootedTree`: rooted trees, with `RootedTree.branch`.
* `ClusterAlgebras.lollipopGraph`: the lollipop graph `L_c`.
* `ClusterAlgebras.PlabicData.RootedTree.plabicData`: the plabic graph `P_T` of a rooted tree.
* `ClusterAlgebras.PlabicData.IsNearlyLeafless`: nearly leafless plabic graphs.

## Main results

* `ClusterAlgebras.numOrbits_mul_add_numOrbits_add_numOrbits_le`,
  `ClusterAlgebras.RotationSystem.IsConnected.card_faceOrbits_add_card_vertices_le`: the Euler
  inequality.
* `ClusterAlgebras.isPlabicGraph_lollipopGraph`, `ClusterAlgebras.faces_lollipopGraph`: `L_c` is a
  plabic graph with exactly one face.
* `ClusterAlgebras.PlabicData.RootedTree.exists_isInternalLeaf`: a rooted tree has a leaf.
* `ClusterAlgebras.PlabicData.RootedTree.isPlabicGraph_plabicData`,
  `ClusterAlgebras.PlabicData.RootedTree.card_boundaryVertices_plabicData`,
  `ClusterAlgebras.PlabicData.RootedTree.card_faces_plabicData`: `P_T` is a plabic graph with one
  boundary vertex and exactly one face.
* `ClusterAlgebras.PlabicData.IsPlabicGraph.vertexOf_ne_vertexOf_inv_of_card_faces_eq_one`,
  `ClusterAlgebras.PlabicData.IsPlabicGraph.endpoints_ne_of_card_faces_eq_one`: plabic trees are
  simple trees.

## Implementation notes

* **Rooted trees.** The edges of `T` are given by the set `D_T` of their darts,
  `PlabicData.treeDarts`. The graph on `W ∪ {v}` is connected in the sense that every vertex of
  `W ∪ {v}` is joined to `v` by a chain of edges of `T` (`PlabicData.TreeAdj`). The interval
  `(a₁, …, a_k)` is determined by `(v, W)`; its first dart is `RootedTree.intervalStart`. The
  branch at `a_j` is `RootedTree.branch a_j`.
* **The darts of `P_T`.** The four new darts `e, ē, g, ḡ` are the constructors of
  `LollipopDart`, which is also the dart type of `L_c`. The darts of `P_T` are the elements `x`
  of `H ⊕ LollipopDart` with `RootedTree.IsDart x`: the darts of `D_T`, `e` and `ē`, and, for an
  internal root, `g` and `ḡ`. A single formula gives both of FWZ's cases: the rotation of
  `P_T` sends a dart `d` of `D_T` to `σ d` if `σ d ∈ D_T`, and otherwise to `ē` (boundary root)
  or `ḡ` (internal root), the last dart `a_k` of the interval being the only dart of `D_T` with
  `σ a_k ∉ D_T`; it sends `ḡ` to `a₁`, and `e` to `a₁ = g_i` (boundary root) or to `g`.
* **Junk values.** The rotation and the involution of `P_T` are first defined on
  `H ⊕ LollipopDart` (`RootedTree.rotAux` and `Sum.map G.inv LollipopDart.bar`); they map the
  darts of `P_T` bijectively onto themselves when `G` is a plabic graph, and the permutations of
  `P_T` are these restrictions (`permOfMapsTo`). For other tuples `G` they are the identity, so
  that `P_T` is defined for every rooted tree of every tuple.
* **Labels.** `P_T` has `b = 1`; its unique label is `0 : Fin 1`, FWZ's label `1`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 7,
  arXiv:2106.02160.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset Equiv Equiv.Perm

/-! ### Permutations induced on a subtype -/

section PermOfMapsTo

variable {α : Type*} (p : α → Prop) [Finite {x // p x}] (f : α → α)

/-- The permutation of `{x // p x}` induced by a map `f : α → α` that maps it injectively into
itself; the identity if `f` does not. -/
noncomputable def permOfMapsTo : Equiv.Perm {x // p x} :=
  open scoped Classical in
  if h : (∀ x, p x → p (f x)) ∧ ∀ x y, p x → p y → f x = f y → x = y then
    Equiv.ofBijective (fun x => ⟨f x, h.1 x x.2⟩)
      (Finite.injective_iff_bijective.1 fun x y hxy =>
        Subtype.ext (h.2 x y x.2 y.2 (congrArg Subtype.val hxy)))
  else 1

variable {p f}

/-- If `f` maps `{x // p x}` injectively into itself, `permOfMapsTo p f` acts as `f`. -/
theorem coe_permOfMapsTo (hf : ∀ x, p x → p (f x))
    (hinj : ∀ x y, p x → p y → f x = f y → x = y) (x : {x // p x}) :
    (permOfMapsTo p f x : α) = f x := by
  unfold permOfMapsTo
  rw [dif_pos ⟨hf, hinj⟩]
  simp

end PermOfMapsTo

/-! ### Orbits of involutions and the Euler inequality -/

section Euler

variable {X : Type*}

/-- A permutation of a nonempty finite set has at least one orbit. -/
theorem numOrbits_pos [Finite X] [Nonempty X] (σ : Equiv.Perm X) : 0 < numOrbits σ := by
  unfold numOrbits
  have : Nonempty (Quotient (SameCycle.setoid σ)) := ⟨Quotient.mk _ (Classical.arbitrary X)⟩
  exact Nat.card_pos

/-- The identity permutation has one orbit for each element. -/
theorem numOrbits_one [Fintype X] : numOrbits (1 : Equiv.Perm X) = Fintype.card X := by
  classical
  rw [numOrbits_eq_card_image]
  have : (fun x => ({y | (1 : Equiv.Perm X).SameCycle x y} : Finset X)) = fun x => {x} := by
    funext x
    ext y
    simp [sameCycle_one, eq_comm]
  rw [this, card_image_of_injective _ singleton_injective, card_univ]

/-- A permutation of a nonempty set under which any two elements lie in one cycle has exactly
one orbit. -/
theorem numOrbits_eq_one [Nonempty X] {σ : Equiv.Perm X} (h : ∀ x y, σ.SameCycle x y) :
    numOrbits σ = 1 :=
  Nat.card_eq_one_iff_unique.2
    ⟨⟨fun a b => Quotient.inductionOn₂ a b fun x y => Quotient.sound (h x y)⟩,
      ⟨Quotient.mk _ (Classical.arbitrary X)⟩⟩

/-- Composing with a transposition adds at most one orbit. -/
theorem numOrbits_mul_swap_le [Finite X] [DecidableEq X] (ρ : Equiv.Perm X) {p q : X}
    (hne : p ≠ q) :
    numOrbits (ρ * swap p q) ≤ numOrbits ρ + 1 := by
  by_cases h : ρ.SameCycle p q
  · rw [numOrbits_mul_swap_of_sameCycle ρ hne h]
  · rw [numOrbits_mul_swap_of_not_sameCycle ρ h]
    omega

/-- Two elements lie in one orbit of an involution `ι` iff they are equal or swapped by `ι`. -/
theorem sameCycle_iff_of_involutive [Finite X] {ι : Equiv.Perm X} (hι : Function.Involutive ι)
    {x y : X} :
    ι.SameCycle x y ↔ y = x ∨ y = ι x := by
  constructor
  · intro h
    obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
    induction n with
    | zero => exact Or.inl rfl
    | succ n ih =>
      rw [pow_succ', Equiv.Perm.mul_apply]
      rcases ih (sameCycle_pow_apply_self ι x n) with h | h
      · exact Or.inr (by rw [h])
      · exact Or.inl (by rw [h, hι])
  · rintro (rfl | rfl)
    · exact SameCycle.refl _ _
    · exact sameCycle_apply_right.2 (SameCycle.refl _ _)

namespace RotationSystem

/-- Reachability is inherited by a rotation system in which every step of another one can be
retraced. -/
theorem Reach.of_steps {R R' : RotationSystem X} {d e : X} (h : R.Reach d e)
    (hrot : ∀ x, R'.Reach x (R.rot x)) (hinv : ∀ x, R'.Reach x (R.inv x)) : R'.Reach d e := by
  induction h with
  | refl => exact Reach.refl _
  | rot _ ih => exact ih.trans (hrot _)
  | inv _ ih => exact ih.trans (hinv _)

/-- Darts at one vertex reach each other. -/
theorem reach_of_sameCycle_rot [Finite X] (R : RotationSystem X) {d e : X}
    (h : R.rot.SameCycle d e) :
    R.Reach d e := by
  obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
  exact R.reach_pow_apply (fun x => (Reach.refl x).rot) n d

/-- Connectedness survives changing the involution of a connected rotation system at four darts
`d, ι d, x, ι x`, provided the new system still joins `d` to `ι d` and `x` to `ι x`. -/
theorem reach_of_inv_eq_of_ne [Finite X] {R R' : RotationSystem X} (hrot : R'.rot = R.rot)
    (hR : ∀ y z, R.Reach y z) (hinv : Function.Involutive R.inv) {d x : X}
    (hd : R'.Reach d (R.inv d)) (hx : R'.Reach x (R.inv x))
    (heq : ∀ y, y ≠ d → y ≠ R.inv d → y ≠ x → y ≠ R.inv x → R'.inv y = R.inv y) (y z : X) :
    R'.Reach y z := by
  refine (hR y z).of_steps (fun w => by rw [← hrot]; exact (Reach.refl w).rot) fun w => ?_
  by_cases h1 : w = d
  · exact h1 ▸ hd
  by_cases h2 : w = R.inv d
  · rw [h2, hinv]
    exact hd.symm
  by_cases h3 : w = x
  · exact h3 ▸ hx
  by_cases h4 : w = R.inv x
  · rw [h4, hinv]
    exact hx.symm
  rw [← heq w h1 h2 h3 h4]
  exact (Reach.refl w).inv

end RotationSystem

section SwapSwap

variable [DecidableEq X] {ι : Perm X} {d x : X}

/-- For an involution `ι` and darts with `d, ι d, x, ι x` pairwise distinct,
`ι ∘ (d ι d) ∘ (x ι x)` is again an involution. -/
theorem involutive_mul_swap_mul_swap (hι : Function.Involutive ι) (hxd : x ≠ d)
    (hxid : x ≠ ι d) (hixd : ι x ≠ d) (hixid : ι x ≠ ι d) :
    Function.Involutive (ι * swap d (ι d) * swap x (ι x)) := by
  have hd : (ι * swap d (ι d) * swap x (ι x)) d = d := by
    simp only [Equiv.Perm.mul_apply, swap_apply_of_ne_of_ne hxd.symm hixd.symm,
      swap_apply_left, hι d]
  have hid : (ι * swap d (ι d) * swap x (ι x)) (ι d) = ι d := by
    simp only [Equiv.Perm.mul_apply, swap_apply_of_ne_of_ne hxid.symm hixid.symm,
      swap_apply_right]
  have hx : (ι * swap d (ι d) * swap x (ι x)) x = x := by
    simp only [Equiv.Perm.mul_apply, swap_apply_left, swap_apply_of_ne_of_ne hixd hixid, hι x]
  have hix : (ι * swap d (ι d) * swap x (ι x)) (ι x) = ι x := by
    simp only [Equiv.Perm.mul_apply, swap_apply_right, swap_apply_of_ne_of_ne hxd hxid]
  intro y
  by_cases h1 : y = d
  · rw [h1, hd, hd]
  by_cases h2 : y = ι d
  · rw [h2, hid, hid]
  by_cases h3 : y = x
  · rw [h3, hx, hx]
  by_cases h4 : y = ι x
  · rw [h4, hix, hix]
  have hy : ∀ z, z ≠ d → z ≠ ι d → z ≠ x → z ≠ ι x →
      (ι * swap d (ι d) * swap x (ι x)) z = ι z := fun z h1 h2 h3 h4 => by
    simp only [Equiv.Perm.mul_apply, swap_apply_of_ne_of_ne h3 h4, swap_apply_of_ne_of_ne h1 h2]
  rw [hy y h1 h2 h3 h4, hy _ (fun h' => h2 (by rw [← h', hι]))
    (fun h' => h1 (by rw [← hι y, h', hι])) (fun h' => h4 (by rw [← h', hι]))
    (fun h' => h3 (by rw [← hι y, h', hι])), hι]

/-- Splitting off the two fixed points `d, ι d` and then `x, ι x` raises the number of orbits
by two. -/
theorem numOrbits_mul_swap_mul_swap [Finite X] (hdne : d ≠ ι d) (hxne : x ≠ ι x)
    (hxd : x ≠ d) (hxid : x ≠ ι d) :
    numOrbits (ι * swap d (ι d) * swap x (ι x)) = numOrbits ι + 2 := by
  have hι₁x : (ι * swap d (ι d)) x = ι x := by
    simp only [Equiv.Perm.mul_apply, swap_apply_of_ne_of_ne hxd hxid]
  rw [numOrbits_mul_swap_of_sameCycle _ hxne (hι₁x ▸ sameCycle_apply_right.2 (SameCycle.refl _ _)),
    numOrbits_mul_swap_of_sameCycle _ hdne (sameCycle_apply_right.2 (SameCycle.refl _ _))]

/-- The transposition `(d ι d)` commutes with an involution `ι`. -/
theorem swap_apply_comm (hι : Function.Involutive ι) (y : X) :
    swap d (ι d) (ι y) = ι (swap d (ι d) y) := by
  have h1 := swap_apply_apply ι d (ι d)
  rw [hι d, swap_comm] at h1
  have h2 : (swap d (ι d)) (ι y) = (ι * swap d (ι d) * ι⁻¹) (ι y) := by rw [← h1]
  rw [h2]
  simp

/-- For an involution `ι`, `ι ∘ (d ι d)` is again an involution. -/
theorem involutive_mul_swap (hι : Function.Involutive ι) :
    Function.Involutive (ι * swap d (ι d)) := fun y => by
  simp only [Equiv.Perm.mul_apply]
  rw [← swap_apply_comm hι, hι, swap_apply_self]

/-- Splitting off the non-fixed point `d` of `ι` lowers the number of non-fixed points. -/
theorem card_filter_mul_swap_lt [Fintype X] (hι : Function.Involutive ι) (hd : ι d ≠ d) :
    (univ.filter fun y => (ι * swap d (ι d)) y ≠ y).card < (univ.filter fun y => ι y ≠ y).card := by
  have h₁ : (ι * swap d (ι d)) d = d := by simp [hι d]
  have h₂ : (ι * swap d (ι d)) (ι d) = ι d := by simp
  refine card_lt_card ⟨fun y hy => ?_, fun hsub => ?_⟩
  · simp only [mem_filter, mem_univ, true_and] at hy ⊢
    by_cases h1 : y = d
    · exact absurd (h1 ▸ h₁) hy
    by_cases h2 : y = ι d
    · exact absurd (h2 ▸ h₂) hy
    rwa [Equiv.Perm.mul_apply, swap_apply_of_ne_of_ne h1 h2] at hy
  · have := hsub (mem_filter.2 ⟨mem_univ d, hd⟩)
    simp only [mem_filter, mem_univ, true_and] at this
    exact this h₁

/-- If `⟨ι, σ⟩` is transitive and `d, ι d` lie in one cycle of `σ (d ι d)`, then
`⟨ι (d ι d), σ (d ι d)⟩` is transitive. -/
theorem reach_mul_swap_of_sameCycle [Finite X] {σ : Perm X} (hι : Function.Involutive ι)
    (h : ∀ y z, (⟨ι, σ⟩ : RotationSystem X).Reach y z)
    (hsc : (σ * swap d (ι d)).SameCycle d (ι d)) (y z : X) :
    (⟨ι * swap d (ι d), σ * swap d (ι d)⟩ : RotationSystem X).Reach y z := by
  set s := swap d (ι d)
  have hs : ∀ w, w ≠ d → w ≠ ι d → s w = w := fun w h1 h2 => swap_apply_of_ne_of_ne h1 h2
  refine (h y z).of_steps (fun w => ?_) fun w => ?_
  · change RotationSystem.Reach _ _ (σ w)
    by_cases h1 : w = d
    · subst h1
      have : σ w = (σ * s) (ι w) := by simp [s]
      rw [this]
      exact (RotationSystem.reach_of_sameCycle_rot _ hsc).rot
    by_cases h2 : w = ι d
    · subst h2
      have : σ (ι d) = (σ * s) d := by simp [s]
      rw [this]
      exact (RotationSystem.reach_of_sameCycle_rot _ hsc.symm).rot
    · have := (RotationSystem.Reach.refl
        (R := (⟨ι * s, σ * s⟩ : RotationSystem X)) w).rot
      change RotationSystem.Reach _ _ (σ (s w)) at this
      rwa [hs w h1 h2] at this
  · change RotationSystem.Reach _ _ (ι w)
    by_cases h1 : w = d
    · subst h1
      exact RotationSystem.reach_of_sameCycle_rot _ hsc
    by_cases h2 : w = ι d
    · subst h2
      rw [hι d]
      exact RotationSystem.reach_of_sameCycle_rot _ hsc.symm
    · have := (RotationSystem.Reach.refl
        (R := (⟨ι * s, σ * s⟩ : RotationSystem X)) w).inv
      change RotationSystem.Reach _ _ (ι (s w)) at this
      rwa [hs w h1 h2] at this

end SwapSwap

/-- **The Euler inequality.** If the group generated by a permutation `σ` and an involution `ι`
of a nonempty finite set `X` acts transitively, then
`#orbits(σ ι) + #orbits(σ) + #orbits(ι) ≤ |X| + 2`. Fixed points of `ι` are allowed. -/
theorem numOrbits_mul_add_numOrbits_add_numOrbits_le [Fintype X] [Nonempty X]
    (σ ι : Equiv.Perm X) (hι : Function.Involutive ι)
    (h : ∀ x y, (⟨ι, σ⟩ : RotationSystem X).Reach x y) :
    numOrbits (σ * ι) + numOrbits σ + numOrbits ι ≤ Fintype.card X + 2 := by
  classical
  obtain ⟨n, hn⟩ : ∃ n, (univ.filter fun x => ι x ≠ x).card = n := ⟨_, rfl⟩
  induction n using Nat.strong_induction_on generalizing σ ι with
  | _ n ih =>
  by_cases hfix : ∀ x, ι x = x
  · have hι1 : ι = 1 := Equiv.ext hfix
    subst hι1
    have hσ : ∀ x y, σ.SameCycle x y := by
      intro x y
      induction h x y with
      | refl => exact SameCycle.refl _ _
      | rot _ ih => exact sameCycle_apply_right.2 ih
      | inv _ ih => exact ih
    rw [mul_one, numOrbits_eq_one hσ, numOrbits_one]
    omega
  obtain ⟨d, hd⟩ := not_forall.1 hfix
  set s := swap d (ι d) with hs_def
  have hne : d ≠ ι d := fun h => hd h.symm
  set ι' := ι * s with hι'_def
  have hlt : (univ.filter fun x => ι' x ≠ x).card < n := hn ▸ card_filter_mul_swap_lt hι hd
  have hnι' : numOrbits ι' = numOrbits ι + 1 :=
    numOrbits_mul_swap_of_sameCycle ι hne (sameCycle_apply_right.2 (SameCycle.refl _ _))
  by_cases hsc : σ.SameCycle d (ι d)
  · have hreach := RotationSystem.reach_of_inv_eq_of_ne (R := ⟨ι, σ⟩) (R' := ⟨ι', σ⟩) rfl h hι
      (RotationSystem.reach_of_sameCycle_rot _ hsc) (RotationSystem.reach_of_sameCycle_rot _ hsc)
      fun y h1 h2 _ _ => by simp [ι', s, swap_apply_of_ne_of_ne h1 h2]
    have hih := ih _ hlt σ ι' (involutive_mul_swap hι) hreach rfl
    have h1 : numOrbits (σ * ι) ≤ numOrbits (σ * ι') + 1 := by
      have : σ * ι = σ * ι' * s := by
        simp only [ι', mul_assoc, s, swap_mul_self, mul_one]
      rw [this]
      exact numOrbits_mul_swap_le _ hne
    omega
  · have hφ : σ * s * ι' = σ * ι := by
      ext y
      simp only [ι', Equiv.Perm.mul_apply]
      rw [← swap_apply_comm hι, swap_apply_self]
    have hnσ : numOrbits (σ * s) = numOrbits σ - 1 := numOrbits_mul_swap_of_not_sameCycle σ hsc
    have hpos := numOrbits_pos σ
    have hsc' : (σ * s).SameCycle d (ι d) :=
      (sameCycle_mul_swap_iff σ hsc).2 (Or.inr (Or.inl ⟨SameCycle.refl _ _, SameCycle.refl _ _⟩))
    have hih := ih _ hlt (σ * s) ι' (involutive_mul_swap hι)
      (reach_mul_swap_of_sameCycle hι h hsc') rfl
    rw [hφ] at hih
    omega

namespace RotationSystem

variable [Fintype X] [DecidableEq X] (R : RotationSystem X)

/-- The orbits of the rotation are the vertices. -/
theorem numOrbits_rot : numOrbits R.rot = R.vertices.card := numOrbits_eq_card_image _

/-- The orbits of the face permutation are the face orbits. -/
theorem numOrbits_facePerm : numOrbits R.facePerm = R.faceOrbits.card :=
  numOrbits_eq_card_image _

/-- For an involutive `R.inv`, the orbits of `R.inv` are the edges. -/
theorem numOrbits_inv (hinv : Function.Involutive R.inv) : numOrbits R.inv = R.edges.card := by
  rw [numOrbits_eq_card_image]
  congr 1
  refine image_congr fun x _ => ?_
  ext y
  simp [sameCycle_iff_of_involutive hinv, edgeOf]

omit [Fintype X] in
/-- For an involutive `R.inv`, two darts lie on the same edge iff they are equal or swapped by
`R.inv`. -/
theorem edgeOf_eq_edgeOf_iff (hinv : Function.Involutive R.inv) {d e : X} :
    R.edgeOf e = R.edgeOf d ↔ e = d ∨ e = R.inv d := by
  refine ⟨fun h => R.mem_edgeOf.1 (h ▸ R.mem_edgeOf.2 (Or.inl rfl)), ?_⟩
  rintro (rfl | rfl)
  · rfl
  · simp only [edgeOf, hinv d]
    exact pair_comm _ _

omit [Fintype X] in
/-- A set of darts closed under a fixed-point-free involution has twice as many elements as it
meets edges. -/
theorem card_eq_two_mul_card_image_edgeOf (hinv : Function.Involutive R.inv)
    (hne : ∀ d, R.inv d ≠ d) {S : Finset X} (hS : ∀ d ∈ S, R.inv d ∈ S) :
    S.card = 2 * (S.image R.edgeOf).card := by
  rw [card_eq_sum_card_image R.edgeOf S, mul_comm]
  refine sum_const_nat fun t ht => ?_
  obtain ⟨d, hd, rfl⟩ := mem_image.1 ht
  have : {a ∈ S | R.edgeOf a = R.edgeOf d} = {d, R.inv d} := by
    ext a
    simp only [mem_filter, R.edgeOf_eq_edgeOf_iff hinv, mem_insert, mem_singleton]
    refine ⟨fun h => h.2, ?_⟩
    rintro (rfl | rfl)
    · exact ⟨hd, Or.inl rfl⟩
    · exact ⟨hS d hd, Or.inr rfl⟩
  rw [this, card_pair (hne d).symm]

/-- A fixed-point-free involution has twice as many darts as edges. -/
theorem card_eq_two_mul_card_edges (hinv : Function.Involutive R.inv) (hne : ∀ d, R.inv d ≠ d) :
    Fintype.card X = 2 * R.edges.card :=
  R.card_eq_two_mul_card_image_edgeOf hinv hne (S := univ) fun _ _ => mem_univ _

/-- **The Euler inequality** for a connected rotation system: `|V| - |E| + |Φ| ≤ 2`. -/
theorem IsConnected.card_faceOrbits_add_card_vertices_le {R : RotationSystem X}
    (hR : R.IsConnected) : R.faceOrbits.card + R.vertices.card ≤ R.edges.card + 2 := by
  haveI := hR.nonempty
  have h := numOrbits_mul_add_numOrbits_add_numOrbits_le R.rot R.inv hR.inv_involutive
    fun x y => hR.reach x y
  have h2 := R.card_eq_two_mul_card_edges hR.inv_involutive hR.inv_ne
  rw [← facePerm, numOrbits_facePerm, numOrbits_rot, numOrbits_inv R hR.inv_involutive] at h
  omega

/-- A vertex visited by a `3`-cycle of the rotation consists of the three darts of the cycle. -/
theorem vertexOf_eq_of_rot_three {a b c : X} (hab : R.rot a = b) (hbc : R.rot b = c)
    (hca : R.rot c = a) : R.vertexOf a = {a, b, c} := by
  ext y
  rw [mem_vertexOf]
  constructor
  · intro h
    obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', Equiv.Perm.mul_apply]
      have := ih (sameCycle_pow_apply_self _ a n)
      simp only [mem_insert, mem_singleton] at this ⊢
      rcases this with h | h | h <;> rw [h] <;> simp [hab, hbc, hca]
  · simp only [mem_insert, mem_singleton]
    rintro (rfl | rfl | rfl)
    · exact SameCycle.refl _ _
    · rw [← hab]
      exact sameCycle_apply_right.2 (SameCycle.refl _ _)
    · rw [← hbc, ← hab]
      exact sameCycle_apply_right.2 (sameCycle_apply_right.2 (SameCycle.refl _ _))

/-- Powers of the rotation preserve the vertex of a dart. -/
theorem vertexOf_pow_apply (n : ℕ) (d : X) : R.vertexOf ((R.rot ^ n) d) = R.vertexOf d :=
  R.vertexOf_eq_of_mem ((R.mem_vertexOf).2 (sameCycle_pow_apply_self _ d n))

/-- The orbit of a fixed point of the face permutation is a singleton. -/
theorem faceOf_eq_singleton {a : X} (ha : R.facePerm a = a) : R.faceOf a = {a} := by
  ext y
  rw [mem_faceOf, mem_singleton]
  constructor
  · intro h
    obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
    exact pow_apply_eq_self_of_apply_eq_self ha n
  · rintro rfl
    exact SameCycle.refl _ _

end RotationSystem

end Euler

/-! ### The lollipop graph -/

/-- The four darts `e, ē, g, ḡ` of the lollipop graph `L_c`; they are also the darts that the
plabic graph `P_T` of a rooted tree adds to the darts of the tree. -/
inductive LollipopDart
  /-- The dart `e` of the boundary loop, forming the exterior. -/
  | e
  /-- The dart `ē` of the boundary loop. -/
  | eBar
  /-- The leg `g`, at the boundary vertex. -/
  | g
  /-- The dart `ḡ` of the leg, at the internal vertex. -/
  | gBar
  deriving DecidableEq, Fintype

/-- The involution `e ↔ ē`, `g ↔ ḡ` of the darts of the lollipop graph. -/
def LollipopDart.bar : LollipopDart → LollipopDart
  | .e => .eBar
  | .eBar => .e
  | .g => .gBar
  | .gBar => .g

/-- The map `LollipopDart.bar` is an involution. -/
theorem LollipopDart.bar_involutive : Function.Involutive LollipopDart.bar := fun x => by
  cases x <;> rfl

/-- The **lollipop graph** `L_c` of colour `c`: the darts
`e, ē, g, ḡ`, the involution `e ↔ ē`, `g ↔ ḡ`, the rotation `ē ↦ e ↦ g ↦ ē`, `ḡ ↦ ḡ`, the
boundary arcs `B = {e, ē}`, the colour `c` and the boundary vertex `β(1) = {ē, e, g}`, recorded
by its leg `g`. -/
@[cluster_algebras "def_lollipop_graph"]
def lollipopGraph (c : Shade) : PlabicData LollipopDart 1 where
  inv := LollipopDart.bar_involutive.toPerm
  rot := swap .eBar .g * swap .eBar .e
  bdry := {.e, .eBar}
  colour _ := c
  leg _ := .g

/-- The lollipop graph `L_c` is a plabic graph. -/
theorem isPlabicGraph_lollipopGraph (c : Shade) : (lollipopGraph c).IsPlabicGraph where
  toIsConnected := by
    refine RotationSystem.IsConnected.of_reach ⟨.e⟩ LollipopDart.bar_involutive
      (by cases c <;> decide) fun x y => ?_
    have hg : (lollipopGraph c).Reach .e .g := by
      have h := (RotationSystem.Reach.refl (R := (lollipopGraph c).toRotationSystem) .e).rot
      rwa [show (lollipopGraph c).rot .e = .g by cases c <;> decide] at h
    have h : ∀ x, (lollipopGraph c).Reach .e x := by
      intro x
      cases x
      · exact .refl _
      · exact (RotationSystem.Reach.refl _).inv
      · exact hg
      · exact hg.inv
    exact (h x).symm.trans (h y)
  inv_mem_bdry := by cases c <;> decide
  euler := by
    have h1 : (lollipopGraph c).vertices.card = 2 := by cases c <;> decide
    have h2 : (lollipopGraph c).edges.card = 2 := by cases c <;> decide
    have h3 : (lollipopGraph c).faceOrbits.card = 2 := by cases c <;> decide
    rw [h1, h2, h3]
    rfl
  boundaryVertex_card := by cases c <;> decide
  exists_orbit := by
    refine ⟨{.e}, ?_, ?_, ?_, ?_⟩ <;> cases c <;> decide
  one_le := le_rfl
  colour_rot _ _ := rfl
  leg_notMem_bdry := by cases c <;> decide
  bvertex_mem := by cases c <;> decide
  bvertex_injective i j _ := Subsingleton.elim i j
  exists_bvertex_eq := by cases c <;> decide
  exists_exterior := by cases c <;> decide

/-- The lollipop graph `L_c` has one boundary vertex. -/
theorem card_boundaryVertices_lollipopGraph (c : Shade) :
    (lollipopGraph c).boundaryVertices.card = 1 := by
  cases c <;> decide

/-- The lollipop graph `L_c` has exactly one face, `{ē, g, ḡ}`. -/
theorem faces_lollipopGraph (c : Shade) : (lollipopGraph c).faces = {{.eBar, .g, .gBar}} := by
  cases c <;> decide

/-! ### Plabic trees are simple trees -/

namespace PlabicData

variable {H : Type*} [Fintype H] [DecidableEq H] {b : ℕ} {G : PlabicData H b}

/-- The colour is constant on the darts of an internal vertex. -/
theorem IsPlabicGraph.colour_eq_of_mem_vertexOf (hG : G.IsPlabicGraph) {d y : H}
    (hd : ¬G.IsBoundaryVertex (G.vertexOf d)) (hy : y ∈ G.vertexOf d) :
    G.colour y = G.colour d := by
  obtain ⟨n, rfl⟩ := (RotationSystem.mem_vertexOf _).1 hy |>.exists_nat_pow_eq
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    have hv : G.vertexOf ((G.rot ^ n) d) = G.vertexOf d :=
      G.vertexOf_eq_of_mem ((RotationSystem.mem_vertexOf _).2 (sameCycle_pow_apply_self _ d n))
    rw [hG.colour_rot _ (by rwa [hv]),
      ih ((RotationSystem.mem_vertexOf _).2 (sameCycle_pow_apply_self _ d n))]

/-- In a plabic graph with one boundary vertex and exactly one face, deleting an edge `{d, d̄}`
with `d ∉ B` along which `d` and `d̄` are still joined (through a loop or a parallel edge)
is impossible. -/
private theorem IsPlabicGraph.false_of_reach_of_card_faces_eq_one (hG : G.IsPlabicGraph)
    (hbv : G.boundaryVertices.card = 1) (hf : G.faces.card = 1) {d : H} (hd : d ∉ G.bdry)
    (h : G.rot.SameCycle d (G.inv d) ∨ ∃ d' ∉ G.bdry, G.edgeOf d' ≠ G.edgeOf d ∧
      G.rot.SameCycle d d' ∧ G.rot.SameCycle (G.inv d') (G.inv d)) : False := by
  have hinv := hG.inv_involutive
  have hR : G.toRotationSystem.IsConnected := hG.toIsConnected
  haveI := hR.nonempty
  obtain ⟨u, hu⟩ := card_eq_one.1 hbv
  have hu_mem : u ∈ G.boundaryVertices := hu ▸ mem_singleton_self u
  obtain ⟨x, hxu, hxB⟩ := (G.mem_boundaryVertices.1 hu_mem).2
  have hvB : ∀ y ∈ G.bdry, G.vertexOf y = u := fun y hy =>
    mem_singleton.1 <| hu ▸
      G.vertexOf_mem_boundaryVertices.2 (G.isBoundaryVertex_vertexOf_of_mem hy)
  have hixB : G.inv x ∈ G.bdry := hG.inv_mem_bdry x hxB
  have hxx : G.rot.SameCycle x (G.inv x) :=
    (G.vertexOf_eq_vertexOf_iff).1 ((hvB x hxB).trans (hvB _ hixB).symm)
  have hidB : G.inv d ∉ G.bdry := fun h' => hd (hG.inv_mem_bdry_iff.1 h')
  have hxd : x ≠ d := fun h' => hd (h' ▸ hxB)
  have hxid : x ≠ G.inv d := fun h' => hidB (h' ▸ hxB)
  have hixd : G.inv x ≠ d := fun h' => hd (h' ▸ hixB)
  have hixid : G.inv x ≠ G.inv d := fun h' => hidB (h' ▸ hixB)
  have hdne : d ≠ G.inv d := fun h' => hG.inv_ne d h'.symm
  have hxne : x ≠ G.inv x := fun h' => hG.inv_ne x h'.symm
  set ι₂ := G.inv * swap d (G.inv d) * swap x (G.inv x)
  have hι₂ : ∀ y, y ≠ d → y ≠ G.inv d → y ≠ x → y ≠ G.inv x → ι₂ y = G.inv y :=
    fun y h1 h2 h3 h4 => by
      simp only [ι₂, Equiv.Perm.mul_apply, swap_apply_of_ne_of_ne h3 h4,
        swap_apply_of_ne_of_ne h1 h2]
  set R' : RotationSystem H := ⟨ι₂, G.rot⟩
  have hdd : R'.Reach d (G.inv d) := by
    rcases h with h | ⟨d', hd'B, hd'e, h1, h2⟩
    · exact R'.reach_of_sameCycle_rot h
    · have hd'1 : d' ≠ d := fun h' => hd'e (h' ▸ rfl)
      have hd'2 : d' ≠ G.inv d := fun h' =>
        hd'e ((G.edgeOf_eq_edgeOf_iff hinv).2 (Or.inr h'))
      have hd'3 : d' ≠ x := fun h' => hd'B (h' ▸ hxB)
      have hd'4 : d' ≠ G.inv x := fun h' => hd'B (h' ▸ hixB)
      have := (R'.reach_of_sameCycle_rot h1).inv
      have h3 : R'.inv d' = G.inv d' := hι₂ d' hd'1 hd'2 hd'3 hd'4
      rw [h3] at this
      exact this.trans (R'.reach_of_sameCycle_rot h2)
  have hE := numOrbits_mul_add_numOrbits_add_numOrbits_le G.rot ι₂
    (involutive_mul_swap_mul_swap hinv hxd hxid hixd hixid)
    (RotationSystem.reach_of_inv_eq_of_ne (R := G.toRotationSystem) (R' := R') rfl hR.reach hinv
      hdd (R'.reach_of_sameCycle_rot hxx) hι₂)
  have hpos := numOrbits_pos (G.rot * ι₂)
  have hcard := G.card_eq_two_mul_card_edges hinv hG.inv_ne
  rw [RotationSystem.numOrbits_rot, numOrbits_mul_swap_mul_swap hdne hxne hxd hxid,
    RotationSystem.numOrbits_inv _ hinv] at hE
  have hΦ : G.faceOrbits.card = 2 := by
    have := card_erase_add_one (hG.exterior_mem_faceOrbits)
    rw [← DiskMap.faces, hf] at this
    omega
  have heuler := hG.euler
  rw [hΦ] at heuler
  omega

/-- **Plabic trees are simple trees**, no loops: in a plabic graph with one boundary vertex and
exactly one face, no edge of the graph is a loop. -/
@[cluster_algebras "lem_plabic_tree_simple"]
theorem IsPlabicGraph.vertexOf_ne_vertexOf_inv_of_card_faces_eq_one (hG : G.IsPlabicGraph)
    (hbv : G.boundaryVertices.card = 1) (hf : G.faces.card = 1) {d : H} (hd : d ∉ G.bdry) :
    G.vertexOf d ≠ G.vertexOf (G.inv d) := fun h =>
  hG.false_of_reach_of_card_faces_eq_one hbv hf hd
    (Or.inl ((G.vertexOf_eq_vertexOf_iff).1 h))

/-- **Plabic trees are simple trees**, no parallel edges: in a plabic graph with one boundary
vertex and exactly one face, two distinct edges of the graph do not have the same set of
endpoints. -/
@[cluster_algebras "lem_plabic_tree_simple"]
theorem IsPlabicGraph.endpoints_ne_of_card_faces_eq_one (hG : G.IsPlabicGraph)
    (hbv : G.boundaryVertices.card = 1) (hf : G.faces.card = 1) {d d' : H} (hd : d ∉ G.bdry)
    (hd' : d' ∉ G.bdry) (hdd' : G.edgeOf d ≠ G.edgeOf d') :
    s(G.vertexOf d, G.vertexOf (G.inv d)) ≠ s(G.vertexOf d', G.vertexOf (G.inv d')) := by
  intro h
  rcases Sym2.eq_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact hG.false_of_reach_of_card_faces_eq_one hbv hf hd (Or.inr ⟨d', hd', Ne.symm hdd',
      (G.vertexOf_eq_vertexOf_iff).1 h1, (G.vertexOf_eq_vertexOf_iff).1 h2.symm⟩)
  · have hinv := hG.inv_involutive
    refine hG.false_of_reach_of_card_faces_eq_one hbv hf hd (Or.inr ⟨G.inv d',
      fun h' => hd' (hG.inv_mem_bdry_iff.1 h'), ?_, (G.vertexOf_eq_vertexOf_iff).1 h1, ?_⟩)
    · rw [show G.edgeOf (G.inv d') = G.edgeOf d' from
        (G.edgeOf_eq_edgeOf_iff hinv).2 (Or.inr rfl)]
      exact Ne.symm hdd'
    · rw [hinv]
      exact (G.vertexOf_eq_vertexOf_iff).1 h2.symm

/-! ### Nearly leafless plabic graphs -/

variable (G) in
/-- A plabic graph is **nearly leafless** if each of its internal leaves is a lollipop. -/
@[cluster_algebras "def_nearly_leafless"]
def IsNearlyLeafless : Prop :=
  ∀ v, G.IsInternalLeaf v → ∃ i, G.IsLollipop i v

/-! ### Rooted trees -/

variable (G) in
/-- The darts `D_T` of the **edges of a set `W` of vertices**: the darts `d ∉ B` with `v(d) ∈ W`
or `v(d̄) ∈ W`. -/
def treeDarts (W : Finset (Finset H)) : Finset H :=
  {d | d ∉ G.bdry ∧ (G.vertexOf d ∈ W ∨ G.vertexOf (G.inv d) ∈ W)}

variable (G) in
/-- **Adjacency along the edges of `W`**: `u` and `u'` are the ends `v(d)` and `v(d̄)` of a dart
`d` of `D_T`. -/
def TreeAdj (W : Finset (Finset H)) (u u' : Finset H) : Prop :=
  ∃ d ∈ G.treeDarts W, G.vertexOf d = u ∧ G.vertexOf (G.inv d) = u'

/-- A dart lies in `D_T` iff it is not in `B` and it or its opposite dart lies at a vertex
of `W`. -/
theorem mem_treeDarts {W : Finset (Finset H)} {d : H} :
    d ∈ G.treeDarts W ↔ d ∉ G.bdry ∧ (G.vertexOf d ∈ W ∨ G.vertexOf (G.inv d) ∈ W) := by
  simp [treeDarts]

variable (G) in
/-- A **rooted tree** `T = (v, W)` of `G`: a vertex `v`, the *root*, and a nonempty set `W` of
internal vertices not containing `v`, the *non-root vertices*, such that, with `D_T` the darts
of the edges of `W` (`treeDarts`):
* for every dart `d` with `v(d) ∈ W`, the vertex `v(d̄)` lies in `W ∪ {v}`;
* for some dart `a₁` at `v` and some `1 ≤ k < |v|`, the darts of `D_T` at `v` are exactly
  `a₁, σ a₁, …, σ^(k-1) a₁`, and `σ⁻¹ a₁ ∉ D_T`; this is the *interval* `(a₁, …, a_k)` of `T`;
* the graph on `W ∪ {v}` with the edges `{d, d̄}`, `d ∈ D_T`, is a tree: it has exactly `|W|`
  edges, and every vertex of `W ∪ {v}` is joined to `v` by a chain of these edges. -/
@[cluster_algebras "def_rooted_tree"]
structure RootedTree where
  /-- The root `v`. -/
  root : Finset H
  /-- The set `W` of non-root vertices. -/
  nonRoot : Finset (Finset H)
  /-- The root is a vertex. -/
  root_mem_vertices : root ∈ G.vertices
  /-- `W` is nonempty. -/
  nonRoot_nonempty : nonRoot.Nonempty
  /-- The vertices of `W` are internal. -/
  nonRoot_subset : nonRoot ⊆ G.internalVertices
  /-- `v ∉ W`. -/
  root_notMem_nonRoot : root ∉ nonRoot
  /-- The edges at a vertex of `W` run into `W ∪ {v}`. -/
  vertexOf_inv_mem : ∀ d, G.vertexOf d ∈ nonRoot → G.vertexOf (G.inv d) ∈ insert root nonRoot
  /-- The darts of `D_T` at `v` form an interval `a₁, σ a₁, …, σ^(k-1) a₁` with `1 ≤ k < |v|`
  and `σ⁻¹ a₁ ∉ D_T`. -/
  exists_interval : ∃ a ∈ root, ∃ k : ℕ, 1 ≤ k ∧ k < root.card ∧
    (∀ d ∈ root, d ∈ G.treeDarts nonRoot ↔ ∃ j < k, (G.rot ^ j) a = d) ∧
    G.rot.symm a ∉ G.treeDarts nonRoot
  /-- The tree has exactly `|W|` edges. -/
  card_image_edgeOf : ((G.treeDarts nonRoot).image G.edgeOf).card = nonRoot.card
  /-- The tree is connected. -/
  reflTransGen_treeAdj :
    ∀ u ∈ insert root nonRoot, Relation.ReflTransGen (G.TreeAdj nonRoot) root u

namespace RootedTree

variable (T : G.RootedTree)

/-- The darts `D_T` of the edges of `T`. -/
abbrev darts : Finset H := G.treeDarts T.nonRoot

/-- The first dart `a₁` of the interval of `T`. -/
noncomputable def intervalStart : H := T.exists_interval.choose

/-- The length `k` of the interval of `T`. -/
noncomputable def intervalLength : ℕ := T.exists_interval.choose_spec.2.choose

/-- The first dart `a₁` of the interval lies at the root. -/
theorem intervalStart_mem_root : T.intervalStart ∈ T.root := T.exists_interval.choose_spec.1

/-- The interval of `T` is nonempty. -/
theorem one_le_intervalLength : 1 ≤ T.intervalLength :=
  T.exists_interval.choose_spec.2.choose_spec.1

/-- The interval of `T` is shorter than the root. -/
theorem intervalLength_lt_card : T.intervalLength < T.root.card :=
  T.exists_interval.choose_spec.2.choose_spec.2.1

/-- A dart at the root lies in `D_T` iff it is one of `a₁, σ a₁, …, σ^(k-1) a₁`. -/
theorem mem_darts_iff_of_mem_root {d : H} (hd : d ∈ T.root) :
    d ∈ T.darts ↔ ∃ j < T.intervalLength, (G.rot ^ j) T.intervalStart = d :=
  T.exists_interval.choose_spec.2.choose_spec.2.2.1 d hd

/-- The dart `σ⁻¹ a₁` does not lie in `D_T`. -/
theorem rot_symm_intervalStart_notMem : G.rot.symm T.intervalStart ∉ T.darts :=
  T.exists_interval.choose_spec.2.choose_spec.2.2.2

/-- The first dart `a₁` of the interval lies in `D_T`. -/
theorem intervalStart_mem_darts : T.intervalStart ∈ T.darts :=
  (T.mem_darts_iff_of_mem_root T.intervalStart_mem_root).2 ⟨0, T.one_le_intervalLength, rfl⟩

/-- The root is the vertex of `a₁`. -/
theorem root_eq_vertexOf_intervalStart : T.root = G.vertexOf T.intervalStart := by
  obtain ⟨r, hr⟩ := G.mem_vertices.1 T.root_mem_vertices
  have hA : T.intervalStart ∈ G.vertexOf r := hr ▸ T.intervalStart_mem_root
  rw [← hr, G.vertexOf_eq_of_mem hA]

/-- A dart lies at the root iff its vertex is the root. -/
theorem mem_root_iff {d : H} : d ∈ T.root ↔ G.vertexOf d = T.root := by
  rw [T.root_eq_vertexOf_intervalStart]
  refine ⟨G.vertexOf_eq_of_mem, fun h => ?_⟩
  rw [← h]
  exact G.self_mem_vertexOf d

/-- A dart at a vertex of `W` is not a boundary arc. -/
theorem notMem_bdry_of_vertexOf_mem {d : H} (h : G.vertexOf d ∈ T.nonRoot) : d ∉ G.bdry :=
  fun hB =>
    (G.mem_internalVertices.1 (T.nonRoot_subset h)).2 (G.isBoundaryVertex_vertexOf_of_mem hB)

/-- A dart at a vertex of `W` lies in `D_T`. -/
theorem mem_darts_of_vertexOf_mem {d : H} (h : G.vertexOf d ∈ T.nonRoot) : d ∈ T.darts :=
  G.mem_treeDarts.2 ⟨T.notMem_bdry_of_vertexOf_mem h, Or.inl h⟩

/-- The rotation of a dart at a vertex of `W` lies in `D_T`. -/
theorem rot_mem_darts_of_vertexOf_mem {d : H} (h : G.vertexOf d ∈ T.nonRoot) :
    G.rot d ∈ T.darts :=
  T.mem_darts_of_vertexOf_mem (by rwa [G.vertexOf_rot])

/-- In a plabic graph, `D_T` is closed under the involution. -/
theorem inv_mem_darts (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts) : G.inv d ∈ T.darts := by
  obtain ⟨hB, h⟩ := G.mem_treeDarts.1 hd
  refine G.mem_treeDarts.2 ⟨fun h' => hB (hG.inv_mem_bdry_iff.1 h'), ?_⟩
  rw [hG.inv_involutive d]
  exact h.symm

/-- In a plabic graph, every dart of `D_T` lies at a vertex of `W` or at the root. -/
theorem vertexOf_mem_or_eq_root (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts) :
    G.vertexOf d ∈ T.nonRoot ∨ G.vertexOf d = T.root := by
  rcases (G.mem_treeDarts.1 hd).2 with h | h
  · exact Or.inl h
  · have := T.vertexOf_inv_mem _ h
    rw [hG.inv_involutive d, mem_insert] at this
    exact this.symm

/-- The rotation of a dart of `D_T` is not `a₁`. -/
theorem rot_ne_intervalStart {d : H} (hd : d ∈ T.darts) : G.rot d ≠ T.intervalStart := fun h =>
  T.rot_symm_intervalStart_notMem (by rw [← h, Equiv.symm_apply_apply]; exact hd)

/-- The last dart `a_k` of the interval is the only dart `d` of `D_T` with `σ d ∉ D_T`. -/
theorem eq_of_rot_notMem (hG : G.IsPlabicGraph) {d d' : H} (hd : d ∈ T.darts)
    (hd' : d' ∈ T.darts) (h : G.rot d ∉ T.darts) (h' : G.rot d' ∉ T.darts) : d = d' := by
  have key : ∀ x ∈ T.darts, G.rot x ∉ T.darts →
      x = (G.rot ^ (T.intervalLength - 1)) T.intervalStart := by
    intro x hx hrx
    have hxr : x ∈ T.root := by
      rcases T.vertexOf_mem_or_eq_root hG hx with hW | hR
      · exact absurd (T.rot_mem_darts_of_vertexOf_mem hW) hrx
      · exact T.mem_root_iff.2 hR
    obtain ⟨j, hj, rfl⟩ := (T.mem_darts_iff_of_mem_root hxr).1 hx
    by_cases hj1 : j + 1 < T.intervalLength
    · refine absurd ?_ hrx
      have hmem : G.rot ((G.rot ^ j) T.intervalStart) ∈ T.root := by
        rw [T.mem_root_iff, G.vertexOf_rot]
        exact T.mem_root_iff.1 hxr
      refine (T.mem_darts_iff_of_mem_root hmem).2 ⟨j + 1, hj1, ?_⟩
      rw [pow_succ', Equiv.Perm.mul_apply]
    · rw [show j = T.intervalLength - 1 by omega]
  rw [key d hd h, key d' hd' h']

open scoped Classical in
/-- The **branch** of `T` at a dart `a` of its interval: for `a = a_j`, the set `W_j` of
vertices of the connected component containing `v(ā_j)` of the graph obtained from the tree of
`T` by deleting the root `v`. The branch of `T` at `a_j` is the pair `(v, W_j)`. -/
@[cluster_algebras "def_rooted_tree"]
noncomputable def branch (a : H) : Finset (Finset H) :=
  T.nonRoot.filter fun w => Relation.ReflTransGen
    (fun u u' => u ∈ T.nonRoot ∧ u' ∈ T.nonRoot ∧ G.TreeAdj T.nonRoot u u')
    (G.vertexOf (G.inv a)) w

/-- `T` has twice as many darts as `|W|`. -/
theorem card_darts (hG : G.IsPlabicGraph) : T.darts.card = 2 * T.nonRoot.card := by
  rw [← T.card_image_edgeOf]
  exact G.card_eq_two_mul_card_image_edgeOf hG.inv_involutive hG.inv_ne
    fun d hd => T.inv_mem_darts hG hd

/-- **A rooted tree has a leaf**: some vertex of `W` is an internal leaf of `G`. -/
@[cluster_algebras "lem_rooted_tree_leaf"]
theorem exists_isInternalLeaf (hG : G.IsPlabicGraph) : ∃ w ∈ T.nonRoot, G.IsInternalLeaf w := by
  by_contra hcon
  have hvert : ∀ w ∈ T.nonRoot, ∃ d, G.vertexOf d = w := fun w hw =>
    G.mem_vertices.1 (G.mem_internalVertices.1 (T.nonRoot_subset hw)).1
  have h2 : ∀ w ∈ T.nonRoot, 2 ≤ w.card := by
    intro w hw
    obtain ⟨d, rfl⟩ := hvert w hw
    have h1 : 1 ≤ (G.vertexOf d).card := card_pos.2 ⟨d, G.self_mem_vertexOf d⟩
    by_contra h
    exact hcon ⟨_, hw, T.nonRoot_subset hw, by omega⟩
  have hdisj : (T.nonRoot : Set (Finset H)).PairwiseDisjoint id := by
    intro w₁ hw₁ w₂ hw₂ hne
    obtain ⟨d₁, rfl⟩ := hvert w₁ hw₁
    obtain ⟨d₂, rfl⟩ := hvert w₂ hw₂
    refine Finset.disjoint_left.2 fun x hx1 hx2 => hne ?_
    exact (G.vertexOf_eq_of_mem hx1).symm.trans (G.vertexOf_eq_of_mem hx2)
  have hsum : 2 * T.nonRoot.card ≤ (T.nonRoot.biUnion id).card := by
    rw [card_biUnion hdisj, mul_comm, ← smul_eq_mul, ← sum_const]
    exact sum_le_sum h2
  have hsub : T.nonRoot.biUnion id ⊆ T.darts.erase T.intervalStart := by
    intro x hx
    obtain ⟨w, hw, hxw⟩ := mem_biUnion.1 hx
    obtain ⟨d, rfl⟩ := hvert w hw
    have hvx : G.vertexOf x ∈ T.nonRoot := by rwa [G.vertexOf_eq_of_mem hxw]
    refine mem_erase.2 ⟨fun h => ?_, T.mem_darts_of_vertexOf_mem hvx⟩
    rw [h, ← T.root_eq_vertexOf_intervalStart] at hvx
    exact T.root_notMem_nonRoot hvx
  have := card_le_card hsub
  rw [card_erase_of_mem T.intervalStart_mem_darts, T.card_darts hG] at this
  have := T.nonRoot_nonempty.card_pos
  omega

/-! ### The plabic graph of a rooted tree -/

/-- The darts of `P_T`, inside `H ⊕ LollipopDart`: the darts of `D_T`, the darts `e` and `ē`,
and, when the root is internal, the darts `g` and `ḡ`. -/
def IsDart : H ⊕ LollipopDart → Prop
  | .inl d => d ∈ T.darts
  | .inr .e => True
  | .inr .eBar => True
  | .inr .g => ¬G.IsBoundaryVertex T.root
  | .inr .gBar => ¬G.IsBoundaryVertex T.root

/-- Membership in the darts of `P_T` is decidable. -/
instance : DecidablePred T.IsDart := fun x => by
  rcases x with d | (_ | _ | _ | _) <;> dsimp only [IsDart] <;> infer_instance

/-- The set `H_T` of darts of `P_T`. -/
abbrev Dart : Type _ := {x : H ⊕ LollipopDart // T.IsDart x}

/-- The rotation `σ_T` of `P_T`, on `H ⊕ LollipopDart`: `σ` on the darts of `D_T` whose
successor lies in `D_T`, `a_k ↦ ē` (boundary root) or `a_k ↦ ḡ` (internal root), `ḡ ↦ a₁`,
`ē ↦ e`, `g ↦ ē`, and `e ↦ a₁ = g_i` (boundary root) or `e ↦ g` (internal root). -/
noncomputable def rotAux : H ⊕ LollipopDart → H ⊕ LollipopDart
  | .inl d => if G.rot d ∈ T.darts then .inl (G.rot d)
      else .inr (if G.IsBoundaryVertex T.root then .eBar else .gBar)
  | .inr .e => if G.IsBoundaryVertex T.root then .inl T.intervalStart else .inr .g
  | .inr .eBar => .inr .e
  | .inr .g => .inr .eBar
  | .inr .gBar => .inl T.intervalStart

/-- The colouring of `P_T`, on `H ⊕ LollipopDart`: that of `G` on `D_T`, and the colour of the
root on the new darts (it matters only at `ḡ`). -/
noncomputable def colourAux : H ⊕ LollipopDart → Shade
  | .inl d => G.colour d
  | .inr _ => G.colour T.intervalStart

/-- The dart `e` of `P_T`. -/
def dartE : T.Dart := ⟨.inr .e, trivial⟩

/-- The dart `ē` of `P_T`. -/
def dartEBar : T.Dart := ⟨.inr .eBar, trivial⟩

/-- The leg `g₁` of `P_T`: the leg `g_i = a₁` of `G` if the root is the boundary vertex `β(i)`,
and the new dart `g` if the root is internal. -/
noncomputable def legDart : T.Dart :=
  if h : G.IsBoundaryVertex T.root then ⟨.inl T.intervalStart, T.intervalStart_mem_darts⟩
  else ⟨.inr .g, h⟩

/-- **The plabic graph `P_T` of a rooted tree** `T = (v, W)`, with `b = 1`. Its darts are
`H_T = D_T ∪ {e, ē}` if `v = β(i)` is a boundary vertex and `H_T = D_T ∪ {e, ē, g, ḡ}` if `v`
is internal; the involution is that of `G` on `D_T` and swaps `e, ē` and `g, ḡ`; the rotation
is `σ` at the vertices of `W`, `ē ↦ e ↦ g_i ↦ ē` respectively `ē ↦ e ↦ g ↦ ē`, and, for an
internal root, the cycle `ḡ ↦ a₁ ↦ ⋯ ↦ a_k ↦ ḡ` on `v' = {ḡ, a₁, …, a_k}`; the boundary arcs
are `{e, ē}`; the colours are those of `G` on `W` and `κ(v)` on `v'`; and `β_T(1)` is the
vertex of the leg `g_i`, respectively `g`. See `rotAux`, `LollipopDart.bar`, `colourAux` and
`legDart`. -/
@[cluster_algebras "def_tree_plabic_graph"]
noncomputable def plabicData : PlabicData T.Dart 1 where
  inv := permOfMapsTo T.IsDart (Sum.map G.inv LollipopDart.bar)
  rot := permOfMapsTo T.IsDart T.rotAux
  bdry := {T.dartE, T.dartEBar}
  colour x := T.colourAux x.1
  leg _ := T.legDart

/-! #### The rotation and the involution of `P_T` -/

/-- `rotAux` maps the darts of `P_T` to darts of `P_T`. -/
theorem isDart_rotAux {x : H ⊕ LollipopDart} (hx : T.IsDart x) : T.IsDart (T.rotAux x) := by
  rcases x with d | (_ | _ | _ | _)
  · simp only [rotAux]
    split_ifs with h1 h2
    · exact h1
    · trivial
    · exact h2
  · simp only [rotAux]
    split_ifs with h
    · exact T.intervalStart_mem_darts
    · exact h
  · trivial
  · trivial
  · exact T.intervalStart_mem_darts

/-- In a plabic graph, `rotAux` is injective on the darts of `P_T`. -/
theorem rotAux_injOn (hG : G.IsPlabicGraph) {x y : H ⊕ LollipopDart} (hx : T.IsDart x)
    (hy : T.IsDart y) (h : T.rotAux x = T.rotAux y) : x = y := by
  have key : ∀ d y, d ∈ T.darts → T.IsDart y → T.rotAux (.inl d) = T.rotAux y →
      Sum.inl d = y := by
    intro d y hd hy h
    rcases y with d' | (_ | _ | _ | _)
    · by_cases h1 : G.rot d ∈ T.darts <;> by_cases h2 : G.rot d' ∈ T.darts <;>
        simp only [rotAux, h1, h2, if_true, if_false] at h
      · rw [G.rot.injective (Sum.inl.inj h)]
      · simp at h
      · simp at h
      · rw [T.eq_of_rot_notMem hG hd hy h1 h2]
    · by_cases h1 : G.rot d ∈ T.darts <;> by_cases hb : G.IsBoundaryVertex T.root <;>
        simp only [rotAux, h1, hb, if_true, if_false] at h
      · exact absurd (Sum.inl.inj h) (T.rot_ne_intervalStart hd)
      all_goals simp at h
    · by_cases h1 : G.rot d ∈ T.darts <;> by_cases hb : G.IsBoundaryVertex T.root <;>
        simp [rotAux, h1, hb] at h
    · by_cases h1 : G.rot d ∈ T.darts <;> by_cases hb : G.IsBoundaryVertex T.root <;>
        simp [rotAux, h1, hb] at h
      exact absurd hb hy
    · by_cases h1 : G.rot d ∈ T.darts <;>
        simp only [rotAux, h1, if_true, if_false, Sum.inl.injEq, reduceCtorEq] at h
      exact absurd h (T.rot_ne_intervalStart hd)
  rcases x with d | x
  · exact key d y hx hy h
  rcases y with d' | y
  · exact (key d' _ hy hx h.symm).symm
  by_cases hb : G.IsBoundaryVertex T.root
  · rcases x with _ | _ | _ | _ <;> rcases y with _ | _ | _ | _ <;>
      simp only [rotAux, hb, if_true, Sum.inr.injEq, reduceCtorEq] at h ⊢
    · exact absurd hb hy
    · exact absurd hb hx
  · rcases x with _ | _ | _ | _ <;> rcases y with _ | _ | _ | _ <;>
      simp only [rotAux, hb, if_false, Sum.inr.injEq, reduceCtorEq] at h ⊢

/-- In a plabic graph, `Sum.map G.inv LollipopDart.bar` is an involution. -/
theorem map_inv_bar_map_inv_bar (hG : G.IsPlabicGraph) (x : H ⊕ LollipopDart) :
    Sum.map G.inv LollipopDart.bar (Sum.map G.inv LollipopDart.bar x) = x := by
  rcases x with d | (_ | _ | _ | _)
  · simp [hG.inv_involutive d]
  all_goals rfl

/-- In a plabic graph, `Sum.map G.inv LollipopDart.bar` maps the darts of `P_T` to darts
of `P_T`. -/
theorem isDart_map_inv_bar (hG : G.IsPlabicGraph) {x : H ⊕ LollipopDart} (hx : T.IsDart x) :
    T.IsDart ((Sum.map G.inv LollipopDart.bar) x) := by
  rcases x with d | (_ | _ | _ | _)
  · exact T.inv_mem_darts hG hx
  all_goals exact hx

/-- In a plabic graph, the rotation of `P_T` acts as `rotAux`. -/
theorem coe_rot_plabicData (hG : G.IsPlabicGraph) (x : T.Dart) :
    (T.plabicData.rot x : H ⊕ LollipopDart) = T.rotAux x :=
  coe_permOfMapsTo (p := T.IsDart) (f := T.rotAux) (fun _ => T.isDart_rotAux)
    (fun _ _ hx hy h => T.rotAux_injOn hG hx hy h) x

/-- In a plabic graph, the involution of `P_T` acts as `Sum.map G.inv LollipopDart.bar`. -/
theorem coe_inv_plabicData (hG : G.IsPlabicGraph) (x : T.Dart) :
    (T.plabicData.inv x : H ⊕ LollipopDart) = (Sum.map G.inv LollipopDart.bar) x :=
  coe_permOfMapsTo (p := T.IsDart) (f := Sum.map G.inv LollipopDart.bar)
    (fun _ => T.isDart_map_inv_bar hG)
    (fun x y _ _ h => by
      rw [← map_inv_bar_map_inv_bar hG x, h, map_inv_bar_map_inv_bar hG]) x

/-- The boundary arcs of `P_T` are `e` and `ē`. -/
theorem bdry_plabicData : T.plabicData.bdry = {T.dartE, T.dartEBar} := rfl

/-- A dart of `P_T` is a boundary arc iff it is `e` or `ē`. -/
theorem mem_bdry_plabicData {x : T.Dart} :
    x ∈ T.plabicData.bdry ↔ x = T.dartE ∨ x = T.dartEBar := by
  simp [bdry_plabicData]

/-- In a plabic graph, the rotation of `P_T` sends a dart `d` of `D_T` with `σ d ∈ D_T`
to `σ d`. -/
theorem rot_inl_of_mem (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts)
    (h : G.rot d ∈ T.darts) :
    T.plabicData.rot ⟨.inl d, hd⟩ = ⟨.inl (G.rot d), h⟩ :=
  Subtype.ext (by rw [T.coe_rot_plabicData hG]; simp [rotAux, h])

/-- In a plabic graph, the involution of `P_T` agrees with that of `G` on `D_T`. -/
theorem inv_inl (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts) :
    T.plabicData.inv ⟨.inl d, hd⟩ = ⟨.inl (G.inv d), T.inv_mem_darts hG hd⟩ :=
  Subtype.ext (by rw [T.coe_inv_plabicData hG]; rfl)

/-- In a plabic graph whose root is a boundary vertex, `σ a₁` does not lie in `D_T`. -/
theorem rot_intervalStart_notMem_of_isBoundaryVertex (hG : G.IsPlabicGraph)
    (hb : G.IsBoundaryVertex T.root) : G.rot T.intervalStart ∉ T.darts := by
  intro h
  rw [T.root_eq_vertexOf_intervalStart] at hb
  have := DiskMap.eq_of_notMem_bdry hG.boundaryVertex_card hb (G.rot_mem_vertexOf _)
    (G.self_mem_vertexOf _) (G.mem_treeDarts.1 h).1 (G.mem_treeDarts.1 T.intervalStart_mem_darts).1
  exact DiskMap.rot_ne_of_isBoundaryVertex hG.boundaryVertex_card hb this

/-- In a plabic graph whose root is a boundary vertex, `a₁` is the only dart of `D_T` at the
root. -/
theorem eq_intervalStart_of_isBoundaryVertex (hG : G.IsPlabicGraph)
    (hb : G.IsBoundaryVertex T.root) {d : H} (hd : d ∈ T.darts) (hr : G.vertexOf d = T.root) :
    d = T.intervalStart := by
  rw [T.root_eq_vertexOf_intervalStart] at hb hr
  exact DiskMap.eq_of_notMem_bdry hG.boundaryVertex_card hb (hr ▸ G.self_mem_vertexOf d)
    (G.self_mem_vertexOf _) (G.mem_treeDarts.1 hd).1 (G.mem_treeDarts.1 T.intervalStart_mem_darts).1

/-- In a plabic graph, the rotation of `P_T` sends `e` to the leg `g₁`. -/
theorem rot_dartE (hG : G.IsPlabicGraph) : T.plabicData.rot T.dartE = T.legDart := by
  apply Subtype.ext
  rw [T.coe_rot_plabicData hG]
  by_cases hb : G.IsBoundaryVertex T.root <;> simp [dartE, rotAux, legDart, hb]

/-- In a plabic graph, the rotation of `P_T` sends the leg `g₁` to `ē`. -/
theorem rot_legDart (hG : G.IsPlabicGraph) : T.plabicData.rot T.legDart = T.dartEBar := by
  apply Subtype.ext
  rw [T.coe_rot_plabicData hG]
  by_cases hb : G.IsBoundaryVertex T.root
  · simp [legDart, hb, rotAux, dartEBar, T.rot_intervalStart_notMem_of_isBoundaryVertex hG hb]
  · simp [legDart, hb, rotAux, dartEBar]

/-- In a plabic graph, the rotation of `P_T` sends `ē` to `e`. -/
theorem rot_dartEBar (hG : G.IsPlabicGraph) : T.plabicData.rot T.dartEBar = T.dartE :=
  Subtype.ext (by rw [T.coe_rot_plabicData hG]; rfl)

/-- In a plabic graph, the involution of `P_T` sends `e` to `ē`. -/
theorem inv_dartE (hG : G.IsPlabicGraph) : T.plabicData.inv T.dartE = T.dartEBar :=
  Subtype.ext (by rw [T.coe_inv_plabicData hG]; rfl)

/-- In a plabic graph, the involution of `P_T` sends `ē` to `e`. -/
theorem inv_dartEBar (hG : G.IsPlabicGraph) : T.plabicData.inv T.dartEBar = T.dartE :=
  Subtype.ext (by rw [T.coe_inv_plabicData hG]; rfl)

/-- The darts `e` and `g₁` of `P_T` are distinct. -/
theorem dartE_ne_legDart : T.dartE ≠ T.legDart := fun h => by
  have := congrArg Subtype.val h
  unfold legDart at this
  split_ifs at this <;> simp [dartE] at this

/-- The darts `g₁` and `ē` of `P_T` are distinct. -/
theorem legDart_ne_dartEBar : T.legDart ≠ T.dartEBar := fun h => by
  have := congrArg Subtype.val h
  unfold legDart at this
  split_ifs at this <;> simp [dartEBar] at this

/-- The darts `e` and `ē` of `P_T` are distinct. -/
theorem dartE_ne_dartEBar : T.dartE ≠ T.dartEBar := fun h => by
  simpa [dartE, dartEBar] using congrArg Subtype.val h

/-! #### Vertices and faces of `P_T` -/

/-- In a plabic graph, the vertex of `e` in `P_T` is `{e, g₁, ē}`. -/
theorem vertexOf_dartE (hG : G.IsPlabicGraph) :
    T.plabicData.vertexOf T.dartE = {T.dartE, T.legDart, T.dartEBar} :=
  T.plabicData.vertexOf_eq_of_rot_three (T.rot_dartE hG) (T.rot_legDart hG) (T.rot_dartEBar hG)

/-- In a plabic graph, a dart of `P_T` lies at a boundary vertex of `P_T` iff it lies at the
vertex of `e`. -/
theorem isBoundaryVertex_vertexOf_iff (hG : G.IsPlabicGraph) {x : T.Dart} :
    T.plabicData.IsBoundaryVertex (T.plabicData.vertexOf x) ↔
      x ∈ T.plabicData.vertexOf T.dartE := by
  constructor
  · rintro ⟨y, hy, hyB⟩
    have hy' : y ∈ T.plabicData.vertexOf T.dartE := by
      rcases T.mem_bdry_plabicData.1 hyB with rfl | rfl
      · exact T.plabicData.self_mem_vertexOf _
      · simp [T.vertexOf_dartE hG]
    rw [← T.plabicData.vertexOf_eq_of_mem hy', T.plabicData.vertexOf_eq_of_mem hy]
    exact T.plabicData.self_mem_vertexOf x
  · intro hx
    rw [T.plabicData.vertexOf_eq_of_mem hx]
    exact ⟨T.dartE, T.plabicData.self_mem_vertexOf _, by simp [bdry_plabicData]⟩

/-- In a plabic graph, the only boundary vertex of `P_T` is the vertex of `e`. -/
theorem boundaryVertices_plabicData (hG : G.IsPlabicGraph) :
    T.plabicData.boundaryVertices = {T.plabicData.vertexOf T.dartE} := by
  ext s
  rw [DiskMap.mem_boundaryVertices, mem_singleton, RotationSystem.mem_vertices]
  constructor
  · rintro ⟨⟨x, rfl⟩, hb⟩
    exact T.plabicData.vertexOf_eq_of_mem ((T.isBoundaryVertex_vertexOf_iff hG).1 hb)
  · rintro rfl
    exact ⟨⟨_, rfl⟩, (T.isBoundaryVertex_vertexOf_iff hG).2 (T.plabicData.self_mem_vertexOf _)⟩

/-- In a plabic graph, the boundary vertex `β_T(1)` of `P_T` is the vertex of `e`. -/
theorem bvertex_plabicData (hG : G.IsPlabicGraph) (i : Fin 1) :
    T.plabicData.bvertex i = T.plabicData.vertexOf T.dartE :=
  T.plabicData.vertexOf_eq_of_mem (by rw [T.vertexOf_dartE hG]; simp [plabicData])

/-- In a plabic graph, the orbit of `e` under the face permutation of `P_T` is `{e}`. -/
theorem faceOf_dartE (hG : G.IsPlabicGraph) : T.plabicData.faceOf T.dartE = {T.dartE} :=
  T.plabicData.faceOf_eq_singleton (by
    rw [RotationSystem.facePerm_apply, T.inv_dartE hG, T.rot_dartEBar hG])

/-- In a plabic graph, the exterior of `P_T` is `{e}`. -/
theorem exterior_plabicData (hG : G.IsPlabicGraph) : T.plabicData.exterior = {T.dartE} := by
  ext x
  rw [DiskMap.mem_exterior, T.mem_bdry_plabicData, mem_singleton]
  constructor
  · rintro ⟨rfl | rfl, h⟩
    · rfl
    · rw [T.rot_dartEBar hG] at h
      exact absurd (T.mem_bdry_plabicData.2 (Or.inl rfl)) h
  · rintro rfl
    refine ⟨Or.inl rfl, ?_⟩
    rw [T.rot_dartE hG, T.mem_bdry_plabicData]
    rintro (h | h)
    · exact T.dartE_ne_legDart h.symm
    · exact T.legDart_ne_dartEBar h

/-- In `P_T`, a dart at a non-root vertex reaches every dart in its rotation cycle. -/
theorem reach_inl_of_sameCycle (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts)
    (hdW : G.vertexOf d ∈ T.nonRoot) {y : H} (hy : y ∈ T.darts) (hs : G.rot.SameCycle d y) :
    T.plabicData.Reach ⟨.inl d, hd⟩ ⟨.inl y, hy⟩ := by
  obtain ⟨n, rfl⟩ := hs.exists_nat_pow_eq
  induction n with
  | zero => exact RotationSystem.Reach.refl _
  | succ n ih =>
    have hn : (G.rot ^ n) d ∈ T.darts :=
      T.mem_darts_of_vertexOf_mem (by rwa [G.vertexOf_pow_apply])
    have h' : G.rot ((G.rot ^ n) d) ∈ T.darts := by rwa [pow_succ', Equiv.Perm.mul_apply] at hy
    have := (ih hn (sameCycle_pow_apply_self _ d n)).rot
    rw [T.rot_inl_of_mem hG hn h'] at this
    have heq : (⟨.inl (G.rot ((G.rot ^ n) d)), h'⟩ : T.Dart) =
        ⟨.inl ((G.rot ^ (n + 1)) d), hy⟩ :=
      Subtype.ext (congrArg Sum.inl (by rw [pow_succ', Equiv.Perm.mul_apply]))
    rwa [heq] at this

/-- In `P_T`, every dart of `D_T` at the root is reached from `e`. -/
theorem reach_dartE_inl_of_vertexOf_eq_root (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts)
    (hdr : G.vertexOf d = T.root) : T.plabicData.Reach T.dartE ⟨.inl d, hd⟩ := by
  set P := T.plabicData
  have transport : ∀ {x x' : T.Dart}, (x : H ⊕ LollipopDart) = x' → P.Reach T.dartE x →
      P.Reach T.dartE x' := fun h hx => (Subtype.ext h) ▸ hx
  have hA : P.Reach T.dartE ⟨.inl T.intervalStart, T.intervalStart_mem_darts⟩ := by
    by_cases hb : G.IsBoundaryVertex T.root
    · have := (RotationSystem.Reach.refl (R := P.toRotationSystem) T.dartE).rot
      rw [T.rot_dartE hG] at this
      exact transport (by simp [legDart, hb]) this
    · have := (((RotationSystem.Reach.refl (R := P.toRotationSystem) T.dartE).rot).inv).rot
      refine transport ?_ this
      rw [T.coe_rot_plabicData hG, T.coe_inv_plabicData hG, T.rot_dartE hG]
      simp [legDart, hb, LollipopDart.bar, rotAux]
  have hroot : ∀ j < T.intervalLength, ∀ h : (G.rot ^ j) T.intervalStart ∈ T.darts,
      P.Reach T.dartE ⟨.inl ((G.rot ^ j) T.intervalStart), h⟩ := by
    intro j
    induction j with
    | zero => exact fun _ _ => transport (by simp) hA
    | succ j ih =>
      intro hj h
      have hmem : (G.rot ^ j) T.intervalStart ∈ T.root := by
        rw [T.mem_root_iff, G.vertexOf_pow_apply, ← T.root_eq_vertexOf_intervalStart]
      have hj' : (G.rot ^ j) T.intervalStart ∈ T.darts :=
        (T.mem_darts_iff_of_mem_root hmem).2 ⟨j, by omega, rfl⟩
      have h' : G.rot ((G.rot ^ j) T.intervalStart) ∈ T.darts := by
        rwa [pow_succ', Equiv.Perm.mul_apply] at h
      have := (ih (by omega) hj').rot
      rw [T.rot_inl_of_mem hG hj' h'] at this
      exact transport (congrArg Sum.inl (by rw [pow_succ', Equiv.Perm.mul_apply])) this
  obtain ⟨j, hj, rfl⟩ := (T.mem_darts_iff_of_mem_root (T.mem_root_iff.2 hdr)).1 hd
  exact hroot j hj hd

/-- Every dart of `P_T` is reached from `e`. -/
theorem reach_plabicData (hG : G.IsPlabicGraph) (x : T.Dart) :
    T.plabicData.Reach T.dartE x := by
  set P := T.plabicData
  have transport : ∀ {x x' : T.Dart}, (x : H ⊕ LollipopDart) = x' → P.Reach T.dartE x →
      P.Reach T.dartE x' := fun h hx => (Subtype.ext h) ▸ hx
  have htree : ∀ u, Relation.ReflTransGen (G.TreeAdj T.nonRoot) T.root u →
      ∀ d (hd : d ∈ T.darts), G.vertexOf d = u → P.Reach T.dartE ⟨.inl d, hd⟩ := by
    intro u hu
    induction hu with
    | refl => exact fun d hd => T.reach_dartE_inl_of_vertexOf_eq_root hG hd
    | tail _ hstep ih =>
      obtain ⟨d₀, hd₀, hu, hu'⟩ := hstep
      intro d hd hdu'
      rcases T.vertexOf_mem_or_eq_root hG hd with hdW | hdR
      · have h1 := (ih d₀ hd₀ hu).inv
        rw [T.inv_inl hG hd₀] at h1
        have hW' : G.vertexOf (G.inv d₀) ∈ T.nonRoot := by rwa [hu', ← hdu']
        exact h1.trans (T.reach_inl_of_sameCycle hG _ hW' hd
          ((G.vertexOf_eq_vertexOf_iff).1 (hu'.trans hdu'.symm)))
      · exact T.reach_dartE_inl_of_vertexOf_eq_root hG hd hdR
  rcases x with ⟨d | (_ | _ | _ | _), hx⟩
  · refine htree _ (T.reflTransGen_treeAdj _ ?_) d hx rfl
    rcases T.vertexOf_mem_or_eq_root hG hx with h | h
    · exact mem_insert_of_mem h
    · exact h ▸ mem_insert_self _ _
  · exact RotationSystem.Reach.refl _
  · have := (RotationSystem.Reach.refl (R := P.toRotationSystem) T.dartE).inv
    rwa [T.inv_dartE hG] at this
  · have := (RotationSystem.Reach.refl (R := P.toRotationSystem) T.dartE).rot
    rw [T.rot_dartE hG] at this
    exact transport (by simp [legDart, show ¬G.IsBoundaryVertex T.root from hx]) this
  · have := ((RotationSystem.Reach.refl (R := P.toRotationSystem) T.dartE).rot).inv
    refine transport ?_ this
    rw [T.coe_inv_plabicData hG, T.rot_dartE hG]
    simp [legDart, show ¬G.IsBoundaryVertex T.root from hx, LollipopDart.bar]

/-- In a plabic graph, the involution of `P_T` is an involution. -/
theorem inv_involutive_plabicData (hG : G.IsPlabicGraph) :
    Function.Involutive T.plabicData.inv := fun x =>
  Subtype.ext (by
    rw [T.coe_inv_plabicData hG, T.coe_inv_plabicData hG, map_inv_bar_map_inv_bar hG])

/-- In a plabic graph, the involution of `P_T` has no fixed points. -/
theorem inv_ne_plabicData (hG : G.IsPlabicGraph) (x : T.Dart) : T.plabicData.inv x ≠ x :=
  fun h => by
    have := congrArg Subtype.val h
    rw [T.coe_inv_plabicData hG] at this
    rcases x with ⟨d | (_ | _ | _ | _), hx⟩ <;>
      simp only [Sum.map_inl, Sum.map_inr, LollipopDart.bar, Sum.inl.injEq, Sum.inr.injEq,
        reduceCtorEq] at this
    exact hG.inv_ne d this

/-- In a plabic graph, `P_T` is connected. -/
theorem isConnected_plabicData (hG : G.IsPlabicGraph) : T.plabicData.IsConnected :=
  RotationSystem.IsConnected.of_reach ⟨T.dartE⟩ (T.inv_involutive_plabicData hG)
    (T.inv_ne_plabicData hG) fun x y =>
      (T.reach_plabicData hG x).symm.trans (T.reach_plabicData hG y)

/-! #### Counting -/

/-- `P_T` has `|D_T| + 2` darts if the root is a boundary vertex, and `|D_T| + 4` otherwise. -/
theorem card_dart :
    Fintype.card T.Dart = T.darts.card + if G.IsBoundaryVertex T.root then 2 else 4 := by
  rw [Fintype.card_subtype]
  have : (univ.filter T.IsDart) = T.darts.disjSum (univ.filter fun i => T.IsDart (.inr i)) := by
    ext x
    rcases x with d | i <;> simp [IsDart]
  rw [this, card_disjSum]
  congr 1
  by_cases hb : G.IsBoundaryVertex T.root
  · rw [if_pos hb]
    have : (univ.filter fun i => T.IsDart (.inr i)) = {.e, .eBar} := by
      ext i
      rcases i with _ | _ | _ | _ <;> simp [IsDart, hb]
    rw [this]
    rfl
  · rw [if_neg hb]
    have : (univ.filter fun i => T.IsDart (.inr i)) = univ := by
      ext i
      rcases i with _ | _ | _ | _ <;> simp [IsDart, hb]
    rw [this]
    rfl

/-- In a plabic graph, the powers of the rotation of `P_T` agree with those of `σ` at the darts
of a vertex of `W`. -/
theorem coe_rot_pow_inl (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts)
    (hW : G.vertexOf d ∈ T.nonRoot) (n : ℕ) :
    ((T.plabicData.rot ^ n) ⟨.inl d, hd⟩ : H ⊕ LollipopDart) = .inl ((G.rot ^ n) d) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply, T.coe_rot_plabicData hG, ih]
    have : G.rot ((G.rot ^ n) d) ∈ T.darts :=
      T.rot_mem_darts_of_vertexOf_mem (by rwa [G.vertexOf_pow_apply])
    simp [rotAux, this, pow_succ']

/-- In a plabic graph, every dart of `P_T` at the vertex of a dart `d` with `v(d) ∈ W` is a
dart of `G` at `v(d)`. -/
theorem exists_of_mem_vertexOf_inl (hG : G.IsPlabicGraph) {d : H} (hd : d ∈ T.darts)
    (hW : G.vertexOf d ∈ T.nonRoot) {y : T.Dart} (hy : y ∈ T.plabicData.vertexOf ⟨.inl d, hd⟩) :
    ∃ d', (y : H ⊕ LollipopDart) = .inl d' ∧ G.vertexOf d' = G.vertexOf d := by
  obtain ⟨n, rfl⟩ := ((RotationSystem.mem_vertexOf _).1 hy).exists_nat_pow_eq
  exact ⟨_, T.coe_rot_pow_inl hG hd hW n, G.vertexOf_pow_apply n d⟩

/-- In a plabic graph, the vertices of `W` inject into the vertices of `P_T`, avoiding the
vertices of the darts of `P_T` outside `D_T`. -/
theorem exists_injOn_vertices (hG : G.IsPlabicGraph) :
    ∃ f : Finset H → Finset T.Dart, Set.InjOn f T.nonRoot ∧
      (∀ w ∈ T.nonRoot, f w ∈ T.plabicData.vertices) ∧
      ∀ w ∈ T.nonRoot, ∀ x : T.Dart, (∀ d', (x : H ⊕ LollipopDart) ≠ .inl d') →
        f w ≠ T.plabicData.vertexOf x := by
  classical
  set P := T.plabicData
  let f : Finset H → Finset T.Dart := fun w =>
    if h : ∃ d ∈ T.darts, G.vertexOf d = w then P.vertexOf ⟨.inl h.choose, h.choose_spec.1⟩
    else ∅
  have hf : ∀ w ∈ T.nonRoot, ∃ d, ∃ hd : d ∈ T.darts, G.vertexOf d = w ∧
      f w = P.vertexOf ⟨.inl d, hd⟩ := by
    intro w hw
    have h : ∃ d ∈ T.darts, G.vertexOf d = w := by
      obtain ⟨d, rfl⟩ := G.mem_vertices.1 (G.mem_internalVertices.1 (T.nonRoot_subset hw)).1
      exact ⟨d, T.mem_darts_of_vertexOf_mem hw, rfl⟩
    exact ⟨h.choose, h.choose_spec.1, h.choose_spec.2, by simp only [f, dif_pos h]⟩
  have hfmem : ∀ w ∈ T.nonRoot, ∀ y ∈ f w, ∃ d', (y : H ⊕ LollipopDart) = .inl d' ∧
      G.vertexOf d' = w := by
    intro w hw y hy
    obtain ⟨d, hd, hdw, hfw⟩ := hf w hw
    rw [hfw] at hy
    obtain ⟨d', h1, h2⟩ := T.exists_of_mem_vertexOf_inl hG hd (hdw ▸ hw) hy
    exact ⟨d', h1, h2.trans hdw⟩
  have hinj : Set.InjOn f T.nonRoot := by
    intro w₁ hw₁ w₂ hw₂ h
    obtain ⟨d₂, hd₂, hdw₂, hfw₂⟩ := hf w₂ hw₂
    have : (⟨.inl d₂, hd₂⟩ : T.Dart) ∈ f w₁ := by
      rw [h, hfw₂]
      exact P.self_mem_vertexOf _
    obtain ⟨d', h1, h2⟩ := hfmem w₁ hw₁ _ this
    simp only [Sum.inl.injEq] at h1
    rw [← h2, ← h1, hdw₂]
  have hnot : ∀ w ∈ T.nonRoot, ∀ x : T.Dart, (∀ d', (x : H ⊕ LollipopDart) ≠ .inl d') →
      f w ≠ P.vertexOf x := by
    intro w hw x hx h
    obtain ⟨d', h1, -⟩ := hfmem w hw x (h ▸ P.self_mem_vertexOf x)
    exact hx d' h1
  refine ⟨f, hinj, fun w hw => ?_, hnot⟩
  obtain ⟨d, hd, -, hfw⟩ := hf w hw
  rw [hfw]
  exact P.vertexOf_mem_vertices _

/-- If the root is internal, the vertex of `ḡ` in `P_T` is not that of `e`. -/
theorem vertexOf_gBar_ne_vertexOf_dartE (hG : G.IsPlabicGraph)
    (hb : ¬G.IsBoundaryVertex T.root) :
    T.plabicData.vertexOf ⟨.inr .gBar, hb⟩ ≠ T.plabicData.vertexOf T.dartE := by
  intro h
  have : (⟨.inr .gBar, hb⟩ : T.Dart) ∈ T.plabicData.vertexOf T.dartE :=
    h ▸ T.plabicData.self_mem_vertexOf _
  rw [T.vertexOf_dartE hG] at this
  simp only [mem_insert, mem_singleton] at this
  rcases this with h' | h' | h' <;> have := congrArg Subtype.val h'
  · simp [dartE] at this
  · simp [legDart, hb] at this
  · simp [dartEBar] at this

/-- In a plabic graph, `P_T` has at least `|W| + 1` vertices if the root is a boundary vertex,
and at least `|W| + 2` otherwise. -/
theorem le_card_vertices (hG : G.IsPlabicGraph) :
    T.nonRoot.card + (if G.IsBoundaryVertex T.root then 1 else 2) ≤
      T.plabicData.vertices.card := by
  classical
  set P := T.plabicData
  obtain ⟨f, hinj, hfV, hnot⟩ := T.exists_injOn_vertices hG
  have hS : T.nonRoot.image f ⊆ P.vertices := image_subset_iff.2 hfV
  have hcard : (T.nonRoot.image f).card = T.nonRoot.card := card_image_of_injOn hinj
  have heS : P.vertexOf T.dartE ∉ T.nonRoot.image f := by
    intro h
    obtain ⟨w, hw, hfw⟩ := mem_image.1 h
    exact hnot w hw T.dartE (fun d' h' => by simp [dartE] at h') hfw
  by_cases hb : G.IsBoundaryVertex T.root
  · rw [if_pos hb]
    calc T.nonRoot.card + 1 = (insert (P.vertexOf T.dartE) (T.nonRoot.image f)).card := by
          rw [card_insert_of_notMem heS, hcard]
      _ ≤ P.vertices.card := card_le_card (insert_subset (P.vertexOf_mem_vertices _) hS)
  · rw [if_neg hb]
    set gBar : T.Dart := ⟨.inr .gBar, hb⟩
    have hgS : P.vertexOf gBar ∉ insert (P.vertexOf T.dartE) (T.nonRoot.image f) := by
      rw [mem_insert, not_or]
      refine ⟨T.vertexOf_gBar_ne_vertexOf_dartE hG hb, fun h => ?_⟩
      obtain ⟨w, hw, hfw⟩ := mem_image.1 h
      exact hnot w hw gBar (fun d' h' => by simp [gBar] at h') hfw
    calc T.nonRoot.card + 2 =
        (insert (P.vertexOf gBar) (insert (P.vertexOf T.dartE) (T.nonRoot.image f))).card := by
          rw [card_insert_of_notMem hgS, card_insert_of_notMem heS, hcard]
      _ ≤ P.vertices.card := card_le_card (insert_subset (P.vertexOf_mem_vertices _)
          (insert_subset (P.vertexOf_mem_vertices _) hS))

/-- `P_T` has exactly two orbits of `φ`, and as many vertices as edges. -/
theorem card_faceOrbits_plabicData (hG : G.IsPlabicGraph) :
    T.plabicData.faceOrbits.card = 2 ∧ T.plabicData.vertices.card = T.plabicData.edges.card := by
  have hineq := (T.isConnected_plabicData hG).card_faceOrbits_add_card_vertices_le
  have hE := T.plabicData.card_eq_two_mul_card_edges (T.inv_involutive_plabicData hG)
    (T.inv_ne_plabicData hG)
  rw [T.card_dart, T.card_darts hG] at hE
  have hV := T.le_card_vertices hG
  have hΦ : 2 ≤ T.plabicData.faceOrbits.card := by
    have hne : T.plabicData.faceOf T.dartE ≠ T.plabicData.faceOf T.dartEBar := by
      intro h
      have : T.dartEBar ∈ T.plabicData.faceOf T.dartE := h ▸ T.plabicData.self_mem_faceOf _
      rw [T.faceOf_dartE hG, mem_singleton] at this
      exact T.dartE_ne_dartEBar this.symm
    calc 2 = ({T.plabicData.faceOf T.dartE, T.plabicData.faceOf T.dartEBar} :
          Finset (Finset T.Dart)).card := (card_pair hne).symm
      _ ≤ _ := card_le_card (insert_subset (T.plabicData.faceOf_mem_faceOrbits _)
          (singleton_subset_iff.2 (T.plabicData.faceOf_mem_faceOrbits _)))
  split_ifs at hE hV <;> constructor <;> omega

/-- In a plabic graph, the colouring of `P_T` is invariant under the rotation at internal
vertices. -/
theorem colour_rot_plabicData (hG : G.IsPlabicGraph) (x : T.Dart)
    (hx : ¬T.plabicData.IsBoundaryVertex (T.plabicData.vertexOf x)) :
    T.plabicData.colour (T.plabicData.rot x) = T.plabicData.colour x := by
  rw [T.isBoundaryVertex_vertexOf_iff hG, T.vertexOf_dartE hG] at hx
  simp only [mem_insert, mem_singleton, not_or] at hx
  obtain ⟨hxe, hxl, hxeb⟩ := hx
  change T.colourAux (T.plabicData.rot x : H ⊕ LollipopDart) = T.colourAux x
  rw [T.coe_rot_plabicData hG]
  rcases x with ⟨d | (_ | _ | _ | _), hd⟩
  · rcases T.vertexOf_mem_or_eq_root hG hd with hW | hR
    · have hint : ¬G.IsBoundaryVertex (G.vertexOf d) :=
        (G.mem_internalVertices.1 (T.nonRoot_subset hW)).2
      simp only [rotAux, T.rot_mem_darts_of_vertexOf_mem hW, if_true, colourAux]
      exact hG.colour_rot d hint
    · by_cases hb : G.IsBoundaryVertex T.root
      · exact absurd (Subtype.ext
          (by simp [legDart, hb, T.eq_intervalStart_of_isBoundaryVertex hG hb hd hR])) hxl
      · have hint : ¬G.IsBoundaryVertex (G.vertexOf d) := hR ▸ hb
        by_cases h1 : G.rot d ∈ T.darts
        · simp only [rotAux, h1, if_true, colourAux]
          exact hG.colour_rot d hint
        · simp only [rotAux, h1, if_false, hb, colourAux]
          refine hG.colour_eq_of_mem_vertexOf hint ?_
          rw [hR, T.root_eq_vertexOf_intervalStart]
          exact G.self_mem_vertexOf _
  · exact absurd rfl hxe
  · exact absurd rfl hxeb
  · exact absurd (Subtype.ext (by simp [legDart, show ¬G.IsBoundaryVertex T.root from hd])) hxl
  · simp [rotAux, colourAux]

/-- **The plabic graph of a rooted tree is a plabic tree**: for a rooted tree `T` of a plabic
graph, `P_T` is a plabic graph. -/
@[cluster_algebras "lem_tree_plabic_graph_plabic"]
theorem isPlabicGraph_plabicData (hG : G.IsPlabicGraph) : T.plabicData.IsPlabicGraph where
  toIsConnected := T.isConnected_plabicData hG
  inv_mem_bdry d hd := by
    rcases T.mem_bdry_plabicData.1 hd with rfl | rfl
    · simp [T.inv_dartE hG, bdry_plabicData]
    · simp [T.inv_dartEBar hG, bdry_plabicData]
  euler := by
    obtain ⟨h1, h2⟩ := T.card_faceOrbits_plabicData hG
    rw [h1, h2]
    ring
  boundaryVertex_card v hv := by
    rw [T.boundaryVertices_plabicData hG, mem_singleton] at hv
    subst hv
    rw [T.vertexOf_dartE hG]
    refine ⟨card_eq_three.2 ⟨_, _, _, T.dartE_ne_legDart, T.dartE_ne_dartEBar,
      T.legDart_ne_dartEBar, rfl⟩, ?_⟩
    have : ({T.dartE, T.legDart, T.dartEBar} : Finset T.Dart).filter
        (· ∈ T.plabicData.bdry) = {T.dartE, T.dartEBar} := by
      ext x
      simp only [mem_filter, mem_insert, mem_singleton, T.mem_bdry_plabicData]
      tauto
    rw [this, card_pair T.dartE_ne_dartEBar]
  exists_orbit := by
    refine ⟨{T.dartE}, by rw [← T.faceOf_dartE hG]; exact T.plabicData.faceOf_mem_faceOrbits _,
      by simp [bdry_plabicData], ?_, ?_⟩
    · rw [map_singleton, Equiv.coe_toEmbedding, T.inv_dartE hG, bdry_plabicData]
      rfl
    · rw [map_singleton, Equiv.coe_toEmbedding, T.inv_dartE hG, disjoint_singleton]
      exact T.dartE_ne_dartEBar
  one_le := le_rfl
  colour_rot := T.colour_rot_plabicData hG
  leg_notMem_bdry _ := by
    rw [T.mem_bdry_plabicData, not_or]
    exact ⟨fun h => T.dartE_ne_legDart h.symm, T.legDart_ne_dartEBar⟩
  bvertex_mem i := by
    rw [T.boundaryVertices_plabicData hG, mem_singleton, T.bvertex_plabicData hG]
  bvertex_injective i j _ := Subsingleton.elim i j
  exists_bvertex_eq v hv := by
    rw [T.boundaryVertices_plabicData hG, mem_singleton] at hv
    exact ⟨0, by rw [hv, T.bvertex_plabicData hG]⟩
  exists_exterior i := by
    refine ⟨T.dartE, by rw [T.exterior_plabicData hG]; exact mem_singleton_self _, ?_, ?_⟩
    · rw [T.bvertex_plabicData hG]
      exact T.plabicData.self_mem_vertexOf _
    · rw [T.bvertex_plabicData hG, T.inv_dartE hG, T.vertexOf_dartE hG]
      simp

/-- **The plabic graph of a rooted tree is a plabic tree**: `P_T` has one boundary vertex. -/
@[cluster_algebras "lem_tree_plabic_graph_plabic"]
theorem card_boundaryVertices_plabicData (hG : G.IsPlabicGraph) :
    T.plabicData.boundaryVertices.card = 1 := by
  rw [T.boundaryVertices_plabicData hG, card_singleton]

/-- **The plabic graph of a rooted tree is a plabic tree**: `P_T` has exactly one face. -/
@[cluster_algebras "lem_tree_plabic_graph_plabic"]
theorem card_faces_plabicData (hG : G.IsPlabicGraph) : T.plabicData.faces.card = 1 := by
  have h := (T.card_faceOrbits_plabicData hG).1
  have hmem := (T.isPlabicGraph_plabicData hG).exterior_mem_faceOrbits
  rw [DiskMap.faces, card_erase_of_mem hmem, h]

end RootedTree

end PlabicData

end ClusterAlgebras
