module

public import ClusterAlgebras.SeedPattern

/-!
# Cluster algebras

The *ground ring* of a seed pattern is generated by the ground field and the frozen variables of
its seeds, and its *cluster algebra* is generated over the ground ring by all of its cluster
variables. The cluster algebra of a single labeled seed is generated by the ground field, its
frozen variables and the cluster variables of all its iterated mutations; for the seed at any
vertex of a seed pattern the two agree.

As an example, the seed `((a, b, ac - b), B̃)` in `K(a, b, c)` has cluster algebra the
`K`-subalgebra `K[a, b, c]` generated by `a`, `b` and `c`.

## Main definitions

* `groundRing`: the ground ring of a seed pattern.
* `clusterAlgebra`: the cluster algebra of a seed pattern.
* `clusterAlgebraOfSeed`: the cluster algebra of a labeled seed.
* `unipotentSeed`: the seed `((a, b, ac - b), B̃)` of rank one with two frozen variables.
* `mutatedUnipotentSeed`: the mutation of `unipotentSeed a b c` in direction `0`.

## Main results

* `IsSeedPattern.clusterAlgebra_eq`: the cluster algebra of a seed pattern equals the cluster
  algebra of the seed at any of its vertices.
* `clusterAlgebraOfSeed_unipotentSeed`: for `a ≠ 0` and `c ≠ 0`, the cluster algebra of
  `unipotentSeed a b c` is `Algebra.adjoin K {a, b, c}`.

## Implementation notes

Both constructions are `K`-subalgebras of `F`: the subring of a field generated by the image of
`K` and a set `s` is exactly `Algebra.adjoin K s`. Neither needs the seed data to satisfy the
seed conditions, so neither assumes them.
-/

@[expose] public section

namespace ClusterAlgebras

open MvPolynomial

section Defs

variable (K : Type*) {F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

/-- The **ground ring** of a seed pattern `P`: the subring of `F` generated by `K` and the frozen
variables of the seeds `P t`, `t ∈ 𝕋ₙ`. -/
@[cluster_algebras "def_ground_ring"]
def groundRing (P : RegularTree n → SeedData F m n) : Subalgebra K F :=
  Algebra.adjoin K (⋃ t, frozenVariables (P t))

/-- The **cluster algebra** of a seed pattern `P`: the subring `R[𝒳]` of `F` generated by its
ground ring `R` and the set `𝒳` of cluster variables of the seeds `P t`, `t ∈ 𝕋ₙ`. Its *rank*
is `n`, the number of mutable positions of every seed. -/
@[cluster_algebras "def_cluster_algebra"]
def clusterAlgebra (hmn : n ≤ m) (P : RegularTree n → SeedData F m n) : Subalgebra K F :=
  Algebra.adjoin K ((groundRing K P : Set F) ∪ ⋃ t, clusterVariables hmn (P t))

/-- The **cluster algebra of an initial seed** `S = (x̃, B̃)`, written `𝒜(x̃, B̃)`: the subring of
`F` generated by `K`, the frozen variables of `S`, and the cluster variables of the seeds
`μₛ(S)` for all finite sequences `s` of directions. -/
@[cluster_algebras "def_cluster_algebra_of_seed"]
def clusterAlgebraOfSeed (hmn : n ≤ m) (S : SeedData F m n) : Subalgebra K F :=
  Algebra.adjoin K
    (frozenVariables S ∪ ⋃ s : List (Fin n), clusterVariables hmn (seedMutationSeq hmn S s))

/-- The ground ring is the subring of `F` generated by the image of `K` and the frozen
variables. -/
theorem groundRing_toSubring (P : RegularTree n → SeedData F m n) :
    (groundRing K P).toSubring =
      Subring.closure (Set.range (algebraMap K F) ∪ ⋃ t, frozenVariables (P t)) :=
  Algebra.adjoin_eq_ring_closure _

/-- The cluster algebra of a seed pattern is the subring of `F` generated by its ground ring and
its cluster variables. -/
theorem clusterAlgebra_toSubring (hmn : n ≤ m) (P : RegularTree n → SeedData F m n) :
    (clusterAlgebra K hmn P).toSubring =
      Subring.closure ((groundRing K P : Set F) ∪ ⋃ t, clusterVariables hmn (P t)) := by
  rw [clusterAlgebra, Algebra.adjoin_eq_ring_closure, Set.union_eq_self_of_subset_left]
  exact (Set.range_subset_iff.2 fun r => (groundRing K P).algebraMap_mem r).trans
    Set.subset_union_left

/-- The cluster algebra of a seed is the subring of `F` generated by the image of `K`, its
frozen variables and the cluster variables of its iterated mutations. -/
theorem clusterAlgebraOfSeed_toSubring (hmn : n ≤ m) (S : SeedData F m n) :
    (clusterAlgebraOfSeed K hmn S).toSubring =
      Subring.closure (Set.range (algebraMap K F) ∪ (frozenVariables S ∪
        ⋃ s : List (Fin n), clusterVariables hmn (seedMutationSeq hmn S s))) :=
  Algebra.adjoin_eq_ring_closure _

end Defs

section Frozen

variable {F : Type*} [Field F] {m n : ℕ}

/-- **Seed mutation does not change the frozen variables**: it only replaces an entry in one of
the first `n` positions. -/
@[simp]
theorem frozenVariables_seedMutation (hmn : n ≤ m) (S : SeedData F m n) (k : Fin n) :
    frozenVariables (seedMutation hmn S k) = frozenVariables S := by
  refine Set.image_congr fun i hi => ?_
  have hik : i ≠ Fin.castLE hmn k := by
    rintro rfl
    exact absurd (Set.mem_setOf.1 hi) (not_le.2 k.isLt)
  simp [seedMutation, Function.update_of_ne hik]

/-- **Mutation along a sequence does not change the frozen variables.** -/
@[simp]
theorem frozenVariables_seedMutationSeq (hmn : n ≤ m) (S : SeedData F m n) (s : List (Fin n)) :
    frozenVariables (seedMutationSeq hmn S s) = frozenVariables S := by
  induction s generalizing S with
  | nil => rfl
  | cons k s ih =>
    rw [seedMutationSeq, List.foldl_cons, ← seedMutationSeq, ih, frozenVariables_seedMutation]

end Frozen

section Pattern

variable {K : Type*} {F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

/-- **The ground ring is generated by the frozen variables of any one seed**: every seed of a
seed pattern has the same frozen variables. -/
theorem IsSeedPattern.groundRing_eq (hmn : n ≤ m) {P : RegularTree n → SeedData F m n}
    (hP : IsSeedPattern K hmn P) (t₀ : RegularTree n) :
    groundRing K P = Algebra.adjoin K (frozenVariables (P t₀)) := by
  have h : ∀ t, frozenVariables (P t) = frozenVariables (P t₀) := fun t => by
    obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_eq hmn t₀ t
    rw [hs, frozenVariables_seedMutationSeq]
  have : Nonempty (RegularTree n) := ⟨t₀⟩
  rw [groundRing]
  congr 1
  exact (Set.iUnion_congr h).trans (Set.iUnion_const _)

/-- **The two descriptions of a cluster algebra agree**: the cluster algebra of a seed pattern
is the cluster algebra `𝒜(x̃₀, B̃₀)` of its seed `(x̃₀, B̃₀)` at any vertex `t₀`. -/
@[cluster_algebras "lem_cluster_algebra_of_seed"]
theorem IsSeedPattern.clusterAlgebra_eq (hmn : n ≤ m) {P : RegularTree n → SeedData F m n}
    (hP : IsSeedPattern K hmn P) (t₀ : RegularTree n) :
    clusterAlgebra K hmn P = clusterAlgebraOfSeed K hmn (P t₀) := by
  unfold clusterAlgebra clusterAlgebraOfSeed
  apply le_antisymm
  · refine Algebra.adjoin_le (Set.union_subset ?_ (Set.iUnion_subset fun t => ?_))
    · rw [hP.groundRing_eq hmn t₀]
      exact Algebra.adjoin_le (Set.subset_union_left.trans Algebra.subset_adjoin)
    · obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_eq hmn t₀ t
      rw [hs]
      exact (Set.subset_iUnion (fun s => clusterVariables hmn (seedMutationSeq hmn (P t₀) s))
        s).trans (Set.subset_union_right.trans Algebra.subset_adjoin)
  · refine Algebra.adjoin_le (Set.union_subset ?_ (Set.iUnion_subset fun s => ?_))
    · exact ((Set.subset_iUnion (fun t => frozenVariables (P t)) t₀).trans
        Algebra.subset_adjoin).trans (Set.subset_union_left.trans Algebra.subset_adjoin)
    · obtain ⟨t, ht⟩ := hP.seedMutationSeq_mem_range hmn t₀ s
      rw [← ht]
      exact (Set.subset_iUnion (fun t => clusterVariables hmn (P t)) t).trans
        (Set.subset_union_right.trans Algebra.subset_adjoin)

end Pattern

section FreeGenerating

variable {K : Type*} {F : Type*} [Field K] [Field F] [Algebra K F] {m : ℕ}

/-- A field generated by a set is algebraic over the subalgebra that set generates. -/
theorem isAlgebraic_adjoin_of_adjoin_eq_top {s : Set F}
    (h : IntermediateField.adjoin K s = ⊤) :
    Algebra.IsAlgebraic (Algebra.adjoin K s) F := by
  rw [← IntermediateField.isAlgebraic_adjoin_iff_top]
  refine ⟨fun z => ?_⟩
  exact isAlgebraic_algebraMap
    (⟨z, h ▸ IntermediateField.mem_top⟩ : IntermediateField.adjoin K s)

/-- A free generating `m`-tuple is a transcendence basis, so `F` has transcendence degree
`m` over `K`. -/
theorem IsFreeGeneratingTuple.trdeg_eq {x : Fin m → F} (hx : IsFreeGeneratingTuple K x) :
    Algebra.trdeg K F = m := by
  simpa using (hx.1.isTranscendenceBasis_iff_isAlgebraic.2
    (isAlgebraic_adjoin_of_adjoin_eq_top hx.2)).lift_cardinalMk_eq_trdeg.symm

/-- **A generating `m`-tuple of a field of transcendence degree `m` is free**: if `F` has a free
generating `m`-tuple over `K`, then any `m`-tuple generating `F` as a field over `K` is one. -/
theorem IsFreeGeneratingTuple.of_adjoin_eq_top {x y : Fin m → F} (hx : IsFreeGeneratingTuple K x)
    (hy : IntermediateField.adjoin K (Set.range y) = ⊤) : IsFreeGeneratingTuple K y := by
  have := isAlgebraic_adjoin_of_adjoin_eq_top hy
  refine ⟨(Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite K y ?_).1, hy⟩
  simp [hx.trdeg_eq]

variable (K) in
/-- The indeterminates of the field of rational functions `K(X₁, …, Xₘ)` are a free generating
tuple of it. -/
theorem isFreeGeneratingTuple_X :
    IsFreeGeneratingTuple K fun i : Fin m =>
      algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K)) (X i) := by
  set L := FractionRing (MvPolynomial (Fin m) K)
  refine ⟨(MvPolynomial.algebraicIndependent_X (Fin m) K).map'
    (f := IsScalarTower.toAlgHom K (MvPolynomial (Fin m) K) L)
    (IsFractionRing.injective (MvPolynomial (Fin m) K) L), ?_⟩
  refine eq_top_iff.2 fun z _ => ?_
  have hpoly : ∀ p : MvPolynomial (Fin m) K,
      algebraMap _ L p ∈ IntermediateField.adjoin K (Set.range fun i : Fin m =>
        algebraMap (MvPolynomial (Fin m) K) L (X i)) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
      exact IntermediateField.algebraMap_mem _ a
    | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul]
      exact mul_mem hp (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩)
  obtain ⟨p, q, -, rfl⟩ := IsFractionRing.div_surjective (A := MvPolynomial (Fin m) K) z
  exact div_mem (hpoly p) (hpoly q)

end FreeGenerating

section Unipotent

variable {K : Type*} {F : Type*} [Field K] [Field F] [Algebra K F]

/-- The seed of the **unipotent example**: the extended cluster `(a, b, ac - b)` with `m = 3`
and `n = 1`, and the `3 × 1` extended exchange matrix with entries `b₁₁ = 0`, `b₂₁ = 1` and
`b₃₁ = -1`. -/
@[cluster_algebras "lem_unipotent_seed"]
def unipotentSeed (a b c : F) : SeedData F 3 1 where
  extCluster := ![a, b, a * c - b]
  extExchangeMatrix := !![0; 1; -1]

/-- The mutation of the unipotent seed in direction `0`: the extended cluster `(c, b, ac - b)` with
extended exchange matrix entries `0`, `-1` and `1`. -/
def mutatedUnipotentSeed (a b c : F) : SeedData F 3 1 where
  extCluster := ![c, b, a * c - b]
  extExchangeMatrix := !![0; -1; 1]

/-- **The unipotent example is a labeled seed**, for any free generating triple `(a, b, c)` of
`F`. -/
theorem isLabeledSeed_unipotentSeed {a b c : F} (h : IsFreeGeneratingTuple K ![a, b, c]) :
    IsLabeledSeed K (by norm_num : 1 ≤ 3) (unipotentSeed a b c) := by
  refine ⟨h.of_adjoin_eq_top (eq_top_iff.2 ?_), ⟨fun _ => 1, fun _ => one_pos, ?_⟩⟩
  · have ha : a ≠ 0 := by simpa using h.1.ne_zero 0
    set T := IntermediateField.adjoin K (Set.range (unipotentSeed a b c).extCluster)
    have hmem : ∀ i, (unipotentSeed a b c).extCluster i ∈ T := fun i =>
      IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
    rw [← h.2, IntermediateField.adjoin_le_iff, Set.range_subset_iff]
    intro i
    fin_cases i
    · exact hmem 0
    · exact hmem 1
    · have hc : ![a, b, c] 2 = ((unipotentSeed a b c).extCluster 2 +
          (unipotentSeed a b c).extCluster 1) / (unipotentSeed a b c).extCluster 0 := by
        simp [unipotentSeed, ha]
      change ![a, b, c] 2 ∈ (T : Set F)
      rw [hc]
      exact div_mem (add_mem (hmem 2) (hmem 1)) (hmem 0)
  · intro i j
    fin_cases i
    fin_cases j
    simp [unipotentSeed]

/-- **The unipotent example: a labeled seed.** In the field `K(a, b, c)` of rational functions in
three indeterminates, the extended cluster `(a, b, ac - b)` and the `3 × 1` matrix with entries
`b₁₁ = 0`, `b₂₁ = 1`, `b₃₁ = -1` form a labeled seed over `K`, with `m = 3` and `n = 1`. -/
@[cluster_algebras "lem_unipotent_seed"]
theorem isLabeledSeed_unipotentSeed_fractionRing :
    IsLabeledSeed K (by norm_num : 1 ≤ 3)
      (unipotentSeed
        (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0))
        (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 1))
        (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2))) := by
  refine isLabeledSeed_unipotentSeed ?_
  convert isFreeGeneratingTuple_X (m := 3) K using 1
  ext i
  fin_cases i <;> rfl

/-- Mutating the unipotent seed replaces `a` by `c` and negates the matrix. -/
theorem seedMutation_unipotentSeed {a b c : F} (ha : a ≠ 0) :
    seedMutation (by norm_num : 1 ≤ 3) (unipotentSeed a b c) 0 =
      mutatedUnipotentSeed a b c := by
  simp only [seedMutation, unipotentSeed, mutatedUnipotentSeed, SeedData.mk.injEq]
  constructor
  · funext i
    fin_cases i <;>
      simp [exchangeMonomialPos, exchangeMonomialNeg, Finset.prod_filter, Fin.prod_univ_three, ha]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [matrixMutation]

/-- Mutating the mutated unipotent seed returns the unipotent seed. -/
theorem seedMutation_mutatedUnipotentSeed {a b c : F} (hc : c ≠ 0) :
    seedMutation (by norm_num : 1 ≤ 3) (mutatedUnipotentSeed a b c) 0 = unipotentSeed a b c := by
  simp only [seedMutation, unipotentSeed, mutatedUnipotentSeed, SeedData.mk.injEq]
  constructor
  · funext i
    fin_cases i <;>
      simp [exchangeMonomialPos, exchangeMonomialNeg, Finset.prod_filter, Fin.prod_univ_three, hc]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [matrixMutation]

/-- **The cluster algebra of the unipotent example is `K[a, b, c]`**: for `a, c ≠ 0` in `F`,
`𝒜((a, b, ac - b), B̃)` is the `K`-subalgebra generated by `a`, `b` and `c`. -/
theorem clusterAlgebraOfSeed_unipotentSeed {a b c : F} (ha : a ≠ 0) (hc : c ≠ 0) :
    clusterAlgebraOfSeed K (by norm_num : 1 ≤ 3) (unipotentSeed a b c) =
      Algebra.adjoin K {a, b, c} := by
  set S := unipotentSeed a b c
  set S' := mutatedUnipotentSeed a b c
  have hseq : ∀ (s : List (Fin 1)) (T : SeedData F 3 1), T = S ∨ T = S' →
      seedMutationSeq (by norm_num : 1 ≤ 3) T s = S ∨ seedMutationSeq (by norm_num) T s = S' := by
    intro s
    induction s with
    | nil => exact fun _ hT => hT
    | cons k s ih =>
      intro T hT
      obtain rfl : k = 0 := Subsingleton.elim _ _
      rw [seedMutationSeq, List.foldl_cons, ← seedMutationSeq]
      refine ih _ ?_
      rcases hT with rfl | rfl
      · exact Or.inr (seedMutation_unipotentSeed ha)
      · exact Or.inl (seedMutation_mutatedUnipotentSeed hc)
  have hcv : ∀ T : SeedData F 3 1, T = S ∨ T = S' →
      clusterVariables (by norm_num : 1 ≤ 3) T ⊆ {a, b, c} := by
    rintro T (rfl | rfl) x ⟨i, rfl⟩
    · fin_cases i; simp [S, unipotentSeed, cluster]
    · fin_cases i; simp [S', mutatedUnipotentSeed, cluster]
  apply le_antisymm
  · refine Algebra.adjoin_le (Set.union_subset ?_ (Set.iUnion_subset fun s => ?_))
    · rintro x ⟨i, hi, rfl⟩
      fin_cases i
      · exact absurd hi (by simp)
      · exact Algebra.subset_adjoin (by simp [S, unipotentSeed])
      · simp only [S, unipotentSeed]
        exact sub_mem (mul_mem (Algebra.subset_adjoin (by simp))
          (Algebra.subset_adjoin (by simp))) (Algebra.subset_adjoin (by simp))
    · exact (hcv _ (hseq s S (Or.inl rfl))).trans Algebra.subset_adjoin
  · refine Algebra.adjoin_le ?_
    have hA : ∀ x ∈ clusterVariables (by norm_num : 1 ≤ 3)
        (seedMutationSeq (by norm_num : 1 ≤ 3) S []) ∪ clusterVariables (by norm_num : 1 ≤ 3)
          (seedMutationSeq (by norm_num : 1 ≤ 3) S [0]) ∪ frozenVariables S,
        x ∈ clusterAlgebraOfSeed K (by norm_num : 1 ≤ 3) S := by
      rintro x ((hx | hx) | hx)
      · exact Algebra.subset_adjoin (Or.inr (Set.mem_iUnion.2 ⟨[], hx⟩))
      · exact Algebra.subset_adjoin (Or.inr (Set.mem_iUnion.2 ⟨[0], hx⟩))
      · exact Algebra.subset_adjoin (Or.inl hx)
    have h0 : seedMutationSeq (by norm_num : 1 ≤ 3) S [0] = S' := seedMutation_unipotentSeed ha
    rintro x (rfl | rfl | rfl)
    · exact hA _ (Or.inl (Or.inl ⟨0, rfl⟩))
    · exact hA _ (Or.inr ⟨1, by simp, rfl⟩)
    · refine hA _ (Or.inl (Or.inr ?_))
      rw [h0]
      exact ⟨0, rfl⟩

/-- **The unipotent example: the cluster algebra is generated by `a`, `b`, `c`.** In the field
`K(a, b, c)` of rational functions in three indeterminates, the cluster algebra `𝒜(x̃, B̃)` of the
seed with extended cluster `x̃ = (a, b, ac - b)` and matrix entries `b₁₁ = 0`, `b₂₁ = 1`,
`b₃₁ = -1` is the `K`-subalgebra `K[a, b, c]` generated by `a`, `b` and `c`. -/
@[cluster_algebras "lem_unipotent_cluster_algebra"]
theorem clusterAlgebraOfSeed_unipotentSeed_fractionRing :
    clusterAlgebraOfSeed K (by norm_num : 1 ≤ 3)
        (unipotentSeed
          (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0))
          (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 1))
          (algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2))) =
      Algebra.adjoin K
        {algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0),
          algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 1),
          algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2)} :=
  clusterAlgebraOfSeed_unipotentSeed ((isFreeGeneratingTuple_X K).1.ne_zero 0)
    ((isFreeGeneratingTuple_X K).1.ne_zero 2)

end Unipotent

end ClusterAlgebras
