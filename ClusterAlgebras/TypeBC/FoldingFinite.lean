/-!
# Folding and finite type

Folding of exchange matrices, in matrix form. For a `G`-admissible matrix with skew-symmetric
principal part, mutation at a mutable orbit keeps conditions (2) and (3) of admissibility; when
the only nontrivial orbit is a single mutable pair, condition (4) follows, so every admissible
matrix is globally foldable. Adding `G`-invariant frozen rows keeps global foldability, and
relabelling the orbits permutes the folded matrix. Consequently, if every seed pattern with
exchange matrix `U` is of finite type, so is every seed pattern with exchange matrix `Uᴳ`.

## Main definitions

* `ClusterAlgebras.TypeBC.orbitCols`: the columns of an orbit, the set `K` mutated at.
* `ClusterAlgebras.TypeBC.IsSinglePairAction`: an action whose only nontrivial orbit is a pair
  of mutable indices.
* `ClusterAlgebras.TypeBC.relabelOrbitLabelling`: the orbit labelling `θ ∘ κ`.
* `ClusterAlgebras.TypeBC.orbitLabellingOfReps`: the orbit labelling of an action with all
  indices mutable, given one representative of each orbit.

## Main results

* `ClusterAlgebras.TypeBC.smul_eq_matrixMutationList_orbitCols`,
  `eq_zero_matrixMutationList_orbitCols`, `matrixMutationList_orbitCols_skew`: orbit mutation
  preserves conditions (2), (3) and skew-symmetry.
* `ClusterAlgebras.TypeBC.isGloballyFoldable_of_isSinglePairAction`: an action with one
  nontrivial orbit folds globally.
* `ClusterAlgebras.TypeBC.isGloballyFoldable_extend`: adding invariant frozen rows.
* `ClusterAlgebras.TypeBC.isFiniteType_of_isGloballyFoldable`: folding preserves finite type.
* `ClusterAlgebras.TypeBC.isFiniteType_of_sameCartanType_foldedMatrix`: finite type from a
  globally foldable unfolding.

## Implementation notes

* The conventions are those of `ClusterAlgebras/Folding/Defs.lean`: indices `Fin m`, the
  column `j : Fin n` is the row `Fin.castLE hmn j`, and the action is a `MulAction G (Fin m)`
  that need not preserve the mutable indices; no statement here needs it to.
* A mutable orbit `K` is given as an element `ω` of `MulAction.orbitRel.Quotient G (Fin m)` with
  `IsMutableOrbit n ω`, and the sequence `s_K` is `increasingSeq (orbitCols hmn ω)`. For a label
  `r` of an orbit labelling `θ`, `θ.cols hmn r` is `orbitCols hmn (θ.equiv r)`. The orbit
  mutation lemmas are stated for an arbitrary mutable orbit rather than for a label of some `θ`.
* In `isGloballyFoldable_extend` the extended action and the extended labelling `θ̄` are taken as
  data satisfying their defining conditions (the action restricts to the given one on `[0, N)`
  and fixes `[N, N + f)`; `θ̄` agrees with `θ` on the first `N^G` labels and labels the singleton
  `{N + e}` by `N^G + e`). Such data are unique, and their existence for the labelling, the only
  non-obvious part, is `exists_orbitLabelling_extend`.
* "Every seed pattern of rank `N` over `𝕜` with exchange matrix `U` is of finite type" quantifies
  over all fields `F` in the universe of `𝕜` (the proof uses the rational function field
  `𝕜(X₁, …, X_M)`), all numbers `m ≥ N` of rows and all seed patterns; the conclusion is for a
  field in an arbitrary universe. Taking the hypothesis only in the universe of `𝕜` makes it
  weaker, hence the statement stronger.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Section 5.5][FWZ]
-/

@[expose] public section

namespace ClusterAlgebras

namespace TypeBC

open Matrix MulAction

universe u

/-! ### Actions by involutions, and orbit labellings from representatives -/

/-- The orbits of the group generated by an involution `σ` are the sets `{a, σ a}`. -/
theorem mem_orbit_zpowers_iff {α : Type*} {σ : Equiv.Perm α} (hσ : σ * σ = 1) {a b : α} :
    b ∈ orbit (Subgroup.zpowers σ) a ↔ b = a ∨ b = σ a := by
  constructor
  · rintro ⟨⟨g, hg⟩, rfl⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hg
    have h2 : σ ^ (2 : ℤ) = 1 := by rw [zpow_two, hσ]
    rcases Int.even_or_odd' k with ⟨r, rfl | rfl⟩
    · left
      dsimp only
      rw [Subgroup.mk_smul, _root_.zpow_mul, h2, _root_.one_zpow, one_smul]
    · right
      dsimp only
      rw [Subgroup.mk_smul, _root_.zpow_add_one, _root_.zpow_mul, h2, _root_.one_zpow, one_mul,
        Equiv.Perm.smul_def]
  · rintro (rfl | rfl)
    exacts [mem_orbit_self _, ⟨⟨σ, Subgroup.mem_zpowers σ⟩, rfl⟩]

section Reps

variable {G : Type*} [Group G] {N NG : ℕ} [MulAction G (Fin N)]

/-- The **orbit labelling given by representatives**, for an action on `Fin N` with all indices
mutable: `θ(p)` is the orbit of `r p`, where `r` meets every orbit exactly once. -/
noncomputable def orbitLabellingOfReps (r : Fin NG → Fin N)
    (hinj : ∀ p q, r q ∈ orbit G (r p) → p = q) (hsurj : ∀ i, ∃ p, i ∈ orbit G (r p)) :
    OrbitLabelling G N N NG NG where
  equiv := Equiv.ofBijective (fun p => (Quotient.mk'' (r p) : orbitRel.Quotient G (Fin N)))
    ⟨fun p q h => (hinj q p (orbitRel_apply.1 (Quotient.exact' h))).symm, fun ω => by
      induction ω using Quotient.inductionOn' with
      | h i =>
        obtain ⟨p, hp⟩ := hsurj i
        exact ⟨p, Quotient.sound' (orbitRel_apply.2 (mem_orbit_symm.1 hp))⟩⟩
  le := le_rfl
  lt_iff p := ⟨fun _ i _ => i.isLt, fun _ => p.isLt⟩

/-- The orbit `θ(p)` of the orbit labelling given by representatives is the orbit of `r p`. -/
theorem mem_orbit_orbitLabellingOfReps {r : Fin NG → Fin N}
    {hinj : ∀ p q, r q ∈ orbit G (r p) → p = q} {hsurj : ∀ i, ∃ p, i ∈ orbit G (r p)}
    {p : Fin NG} {i : Fin N} :
    i ∈ (orbitLabellingOfReps r hinj hsurj).orbit p ↔ i ∈ orbit G (r p) := by
  rw [OrbitLabelling.mem_orbit_iff]
  exact Quotient.eq''.trans orbitRel_apply

end Reps

section Action

variable {G : Type*} [Group G] {m n mG nG : ℕ} [MulAction G (Fin m)]

open Classical in
/-- The **columns of an orbit** `ω`: the `j : Fin n` whose row `Fin.castLE hmn j` lies in `ω`.
For a mutable orbit `K` these are its elements, and `increasingSeq (orbitCols hmn ω)` is the
sequence `s_K`. -/
noncomputable def orbitCols (hmn : n ≤ m) (ω : orbitRel.Quotient G (Fin m)) : Finset (Fin n) :=
  Finset.univ.filter fun j => (Quotient.mk'' (Fin.castLE hmn j) : orbitRel.Quotient G (Fin m)) = ω

/-- The columns of the orbit `θ(r)` of an orbit labelling are `θ.cols hmn r`. -/
theorem orbitCols_equiv (θ : OrbitLabelling G m n mG nG) (hmn : n ≤ m) (r : Fin nG) :
    orbitCols hmn (θ.equiv (Fin.castLE θ.le r)) = θ.cols hmn r := by
  ext j
  rw [OrbitLabelling.mem_cols, OrbitLabelling.mem_orbit_iff]
  simp [orbitCols]

/-- Appending a label `r` to `ρ` appends the sequence `s_{θ(r)}` to the orbit sequence. -/
theorem orbitSeq_append_singleton (θ : OrbitLabelling G m n mG nG) (hmn : n ≤ m)
    (ρ : List (Fin nG)) (r : Fin nG) :
    orbitSeq θ hmn (ρ ++ [r]) =
      orbitSeq θ hmn ρ ++ increasingSeq (orbitCols hmn (θ.equiv (Fin.castLE θ.le r))) := by
  simp [orbitSeq, List.flatMap_append, orbitCols_equiv]

private theorem mem_orbitCols {hmn : n ≤ m} {ω : orbitRel.Quotient G (Fin m)} {j : Fin n} :
    j ∈ orbitCols hmn ω ↔
      (Quotient.mk'' (Fin.castLE hmn j) : orbitRel.Quotient G (Fin m)) = ω := by
  classical
  simp [orbitCols]

/-- The orbit of `g • i` is the orbit of `i`. -/
private theorem orbitRel_mk_smul (g : G) (i : Fin m) :
    (Quotient.mk'' (g • i) : orbitRel.Quotient G (Fin m)) = Quotient.mk'' i :=
  Quotient.sound' (orbitRel_apply.2 (mem_orbit i g))

/-- Two indices with the same orbit are related. -/
private theorem mem_orbit_of_orbitRel_mk_eq {i i' : Fin m}
    (h : (Quotient.mk'' i : orbitRel.Quotient G (Fin m)) = Quotient.mk'' i') :
    i ∈ orbit G i' :=
  orbitRel_apply.1 (Quotient.exact' h)

/-- Two columns of an orbit are related. -/
private theorem mem_orbit_of_mem_orbitCols {hmn : n ≤ m} {ω : orbitRel.Quotient G (Fin m)}
    {k k' : Fin n}
    (hk : k ∈ orbitCols hmn ω) (hk' : k' ∈ orbitCols hmn ω) :
    Fin.castLE hmn k' ∈ orbit G (Fin.castLE hmn k) :=
  mem_orbit_of_orbitRel_mk_eq ((mem_orbitCols.1 hk').trans (mem_orbitCols.1 hk).symm)

/-- The entries of an admissible matrix between two columns of one orbit vanish. -/
private theorem eq_zero_of_mem_orbitCols {hmn : n ≤ m} {B : Matrix (Fin m) (Fin n) ℤ}
    (hB : IsGroupAdmissible G hmn B) {ω : orbitRel.Quotient G (Fin m)} :
    ∀ k ∈ orbitCols hmn ω, ∀ k' ∈ orbitCols hmn ω, B (Fin.castLE hmn k) k' = 0 :=
  fun k hk k' hk' => hB.eq_zero k k' (mem_orbit_of_mem_orbitCols hk hk')

/-- An index lies in a mutable orbit `ω` iff it is the row of a column of `ω`. -/
private theorem exists_mem_orbitCols_iff {hmn : n ≤ m} {ω : orbitRel.Quotient G (Fin m)}
    (hω : IsMutableOrbit n ω) (i : Fin m) :
    (∃ k ∈ orbitCols hmn ω, i = Fin.castLE hmn k) ↔
      (Quotient.mk'' i : orbitRel.Quotient G (Fin m)) = ω := by
  refine ⟨?_, fun h => ⟨⟨i, hω i (orbitRel.Quotient.mem_orbit.2 h)⟩, mem_orbitCols.2 h, rfl⟩⟩
  rintro ⟨k, hk, rfl⟩
  exact mem_orbitCols.1 hk

/-- The row `g • castLE k` of a column `k` of a mutable orbit is again the row of a column. -/
private theorem val_smul_lt_of_mem_orbitCols {hmn : n ≤ m} {ω : orbitRel.Quotient G (Fin m)}
    (hω : IsMutableOrbit n ω) (g : G) {k : Fin n} (hk : k ∈ orbitCols hmn ω) :
    (g • Fin.castLE hmn k).val < n :=
  hω _ (orbitRel.Quotient.mem_orbit.2 ((orbitRel_mk_smul g _).trans (mem_orbitCols.1 hk)))

private theorem smul_mem_orbitCols {hmn : n ≤ m} {ω : orbitRel.Quotient G (Fin m)}
    (hω : IsMutableOrbit n ω) (g : G) {k : Fin n} (hk : k ∈ orbitCols hmn ω) :
    (⟨(g • Fin.castLE hmn k).val, val_smul_lt_of_mem_orbitCols hω g hk⟩ : Fin n) ∈
      orbitCols hmn ω := by
  rw [mem_orbitCols]
  exact (orbitRel_mk_smul g _).trans (mem_orbitCols.1 hk)

/-! ### Orbit mutation -/

/-- **Orbit mutation preserves condition (2).** Let `B̃` be a `G`-admissible `m × n` integer
matrix and `K` a mutable orbit. Then `D̃ = μ_{s_K}(B̃)` satisfies condition (2) of admissibility:
`d_{g(i) g(j)} = d_{ij}`. No skew-symmetry of the principal part of `B̃` is assumed. -/
@[cluster_algebras "lem_orbit_mutation_two_three"]
theorem smul_eq_matrixMutationList_orbitCols (hmn : n ≤ m) {B : Matrix (Fin m) (Fin n) ℤ}
    (hB : IsGroupAdmissible G hmn B) {ω : orbitRel.Quotient G (Fin m)} (hω : IsMutableOrbit n ω)
    (g : G) (i : Fin m) (j j' : Fin n) (hj : Fin.castLE hmn j' = g • Fin.castLE hmn j) :
    matrixMutationList hmn B (increasingSeq (orbitCols hmn ω)) (g • i) j' =
      matrixMutationList hmn B (increasingSeq (orbitCols hmn ω)) i j := by
  have hK := eq_zero_of_mem_orbitCols (ω := ω) hB
  have hi : (∃ k ∈ orbitCols hmn ω, g • i = Fin.castLE hmn k) ↔
      ∃ k ∈ orbitCols hmn ω, i = Fin.castLE hmn k := by
    rw [exists_mem_orbitCols_iff hω, exists_mem_orbitCols_iff hω, orbitRel_mk_smul]
  have hj' : j' ∈ orbitCols hmn ω ↔ j ∈ orbitCols hmn ω := by
    rw [mem_orbitCols, mem_orbitCols, hj, orbitRel_mk_smul]
  rw [matrixMutationList_increasingSeq_apply hK, matrixMutationList_increasingSeq_apply hK,
    hB.smul_eq g i j j' hj]
  by_cases h : (∃ k ∈ orbitCols hmn ω, i = Fin.castLE hmn k) ∨ j ∈ orbitCols hmn ω
  · rw [if_pos (by rwa [hi, hj']), if_pos h]
  · rw [if_neg (by rwa [hi, hj']), if_neg h]
    congr 1
    refine Finset.sum_bij' (fun k hk => ⟨(g⁻¹ • Fin.castLE hmn k).val,
        val_smul_lt_of_mem_orbitCols hω g⁻¹ hk⟩)
      (fun k hk => ⟨(g • Fin.castLE hmn k).val, val_smul_lt_of_mem_orbitCols hω g hk⟩)
      (fun k hk => smul_mem_orbitCols hω g⁻¹ hk) (fun k hk => smul_mem_orbitCols hω g hk)
      (fun k _ => Fin.ext (by simp)) (fun k _ => Fin.ext (by simp)) fun k hk => ?_
    generalize hk₀def : (⟨(g⁻¹ • Fin.castLE hmn k).val,
      val_smul_lt_of_mem_orbitCols hω g⁻¹ hk⟩ : Fin n) = k₀
    have hk₀ : Fin.castLE hmn k = g • Fin.castLE hmn k₀ := by
      rw [← hk₀def]
      ext
      simp
    rw [hB.smul_eq g i k₀ k hk₀, hk₀, hB.smul_eq g _ j j' hj]

/-- **Orbit mutation preserves condition (3).** Let `B̃` be a `G`-admissible `m × n` integer
matrix with `b_{ij} = -b_{ji}` for mutable `i, j`, and `K` a mutable orbit. Then
`D̃ = μ_{s_K}(B̃)` satisfies condition (3): `d_{ii'} = 0` for mutable `i ∼ i'`. -/
@[cluster_algebras "lem_orbit_mutation_two_three"]
theorem eq_zero_matrixMutationList_orbitCols (hmn : n ≤ m) {B : Matrix (Fin m) (Fin n) ℤ}
    (hB : IsGroupAdmissible G hmn B)
    (hskew : ∀ i j : Fin n, B (Fin.castLE hmn i) j = -B (Fin.castLE hmn j) i)
    {ω : orbitRel.Quotient G (Fin m)} (_hω : IsMutableOrbit n ω) (i i' : Fin n)
    (hii' : Fin.castLE hmn i' ∈ orbit G (Fin.castLE hmn i)) :
    matrixMutationList hmn B (increasingSeq (orbitCols hmn ω)) (Fin.castLE hmn i) i' = 0 := by
  rw [matrixMutationList_increasingSeq_apply (eq_zero_of_mem_orbitCols hB), hB.eq_zero i i' hii',
    neg_zero, zero_add]
  split_ifs
  · rfl
  refine Finset.sum_eq_zero fun k _ => mutationCorrection_of_mul_nonpos ?_
  rw [hskew k i', mul_neg, neg_nonpos]
  exact hB.mul_nonneg _ _ hii' k

/-- **Orbit mutation preserves skew-symmetry.** If `b_{ij} = -b_{ji}` for mutable `i, j`, then
`D̃ = μ_{s_K}(B̃)` satisfies `d_{ij} = -d_{ji}` for mutable `i, j`. Admissibility is not needed
for this part, so it is not assumed. -/
@[cluster_algebras "lem_orbit_mutation_two_three"]
theorem matrixMutationList_orbitCols_skew (hmn : n ≤ m) {B : Matrix (Fin m) (Fin n) ℤ}
    (hskew : ∀ i j : Fin n, B (Fin.castLE hmn i) j = -B (Fin.castLE hmn j) i)
    (ω : orbitRel.Quotient G (Fin m)) (i j : Fin n) :
    matrixMutationList hmn B (increasingSeq (orbitCols hmn ω)) (Fin.castLE hmn i) j =
      -matrixMutationList hmn B (increasingSeq (orbitCols hmn ω)) (Fin.castLE hmn j) i :=
  matrixMutationList_castLE_apply_eq_neg hskew _ i j

/-! ### An action with a single nontrivial orbit -/

variable (G) in
/-- The action of `G` on `Fin m` has **a single nontrivial orbit**, the pair `{a, b}` of distinct
mutable indices, every other orbit being a singleton. -/
def IsSinglePairAction (hmn : n ≤ m) (a b : Fin n) : Prop :=
  a ≠ b ∧ ∀ i i' : Fin m, i' ∈ orbit G i ↔
    i' = i ∨ (i = Fin.castLE hmn a ∧ i' = Fin.castLE hmn b) ∨
      (i = Fin.castLE hmn b ∧ i' = Fin.castLE hmn a)

/-- **Condition (4) for an action with one nontrivial orbit.** If the only nontrivial orbit is a
pair of mutable indices, every `m × n` integer matrix `D̃` satisfying condition (2) and with
`d_{jj} = 0` for mutable `j` satisfies condition (4): `d_{ij} d_{i'j} ≥ 0` for `i ∼ i'`. -/
@[cluster_algebras "lem_single_pair_condition_four"]
theorem mul_nonneg_of_isSinglePairAction (hmn : n ≤ m) {a b : Fin n}
    (hG : IsSinglePairAction G hmn a b) {D : Matrix (Fin m) (Fin n) ℤ}
    (h2 : ∀ (g : G) (i : Fin m) (j j' : Fin n), Fin.castLE hmn j' = g • Fin.castLE hmn j →
      D (g • i) j' = D i j)
    (hdiag : ∀ j : Fin n, D (Fin.castLE hmn j) j = 0) :
    ∀ i i' : Fin m, i' ∈ orbit G i → ∀ j : Fin n, 0 ≤ D i j * D i' j := by
  intro i i' hii' j
  obtain ⟨g, hg⟩ := mem_orbit_iff.1 hii'
  rcases (hG.2 i i').1 hii' with rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact mul_self_nonneg _
  all_goals
    by_cases hja : j = a
    · subst hja
      simp [hdiag]
    by_cases hjb : j = b
    · subst hjb
      simp [hdiag]
    have hgj : g • Fin.castLE hmn j = Fin.castLE hmn j := by
      rcases (hG.2 _ _).1 (mem_orbit (Fin.castLE hmn j) g) with h | ⟨h, -⟩ | ⟨h, -⟩
      · exact h
      · exact absurd (Fin.castLE_injective hmn h) hja
      · exact absurd (Fin.castLE_injective hmn h) hjb
    rw [← hg, h2 g _ j j hgj.symm]
    exact mul_self_nonneg _

/-- **An action with one nontrivial orbit folds globally.** If the only nontrivial orbit of the
action is a pair of mutable indices, then for every orbit labelling `θ`, every `G`-admissible
`m × n` integer matrix with skew-symmetric principal part is globally foldable. -/
@[cluster_algebras "lem_single_pair_globally_foldable"]
theorem isGloballyFoldable_of_isSinglePairAction (θ : OrbitLabelling G m n mG nG) (hmn : n ≤ m)
    {a b : Fin n} (hG : IsSinglePairAction G hmn a b) {B : Matrix (Fin m) (Fin n) ℤ}
    (hB : IsGroupAdmissible G hmn B)
    (hskew : ∀ i j : Fin n, B (Fin.castLE hmn i) j = -B (Fin.castLE hmn j) i) :
    IsGloballyFoldable θ hmn B := by
  refine ⟨hB, fun ρ => ?_⟩
  induction ρ using List.reverseRecOn with
  | nil => exact hB
  | append_singleton ρ r ih =>
    have hω : IsMutableOrbit n (θ.equiv (Fin.castLE θ.le r)) :=
      (θ.lt_iff _).1 (θ.val_castLE_lt r)
    have hskew' := matrixMutationList_castLE_apply_eq_neg hskew (orbitSeq θ hmn ρ)
    rw [orbitSeq_append_singleton, matrixMutationList_append]
    have h2 := smul_eq_matrixMutationList_orbitCols hmn ih hω
    refine ⟨h2, eq_zero_matrixMutationList_orbitCols hmn ih hskew' hω, ?_⟩
    refine mul_nonneg_of_isSinglePairAction hmn hG h2 fun j => ?_
    have := matrixMutationList_orbitCols_skew hmn hskew' (θ.equiv (Fin.castLE θ.le r)) j j
    omega

/-! ### Relabelling the orbits -/

/-- The **relabelled orbit labelling** `θ ∘ κ`, for a permutation `κ` of the labels that maps the
mutable labels `[0, n^G)` onto themselves. -/
@[cluster_algebras "lem_globally_foldable_relabel"]
def relabelOrbitLabelling (θ : OrbitLabelling G m n mG nG) (κ : Equiv.Perm (Fin mG))
    (hκ : ∀ p : Fin mG, ((κ p : ℕ) < nG ↔ (p : ℕ) < nG)) : OrbitLabelling G m n mG nG where
  equiv := κ.trans θ.equiv
  le := θ.le
  lt_iff p := (hκ p).symm.trans (θ.lt_iff (κ p))

/-- **Relabelling permutes the folded matrix**:
`(B̃^{G, θ ∘ κ})_{pq} = (B̃^{G, θ})_{κ(p) κ(q)}`, where for a mutable label `q` the label `κ(q)` is
again mutable. -/
@[cluster_algebras "lem_globally_foldable_relabel"]
theorem foldedMatrix_relabelOrbitLabelling (θ : OrbitLabelling G m n mG nG)
    (κ : Equiv.Perm (Fin mG)) (hκ : ∀ p : Fin mG, ((κ p : ℕ) < nG ↔ (p : ℕ) < nG))
    (B : Matrix (Fin m) (Fin n) ℤ) (p : Fin mG) (q : Fin nG) :
    foldedMatrix (relabelOrbitLabelling θ κ hκ) B p q =
      foldedMatrix θ B (κ p) ⟨κ (Fin.castLE θ.le q), (hκ _).2 q.isLt⟩ :=
  rfl

/-- **Relabelling preserves global foldability**: a matrix globally foldable for `θ` is globally
foldable for `θ ∘ κ`. -/
@[cluster_algebras "lem_globally_foldable_relabel"]
theorem isGloballyFoldable_relabelOrbitLabelling (θ : OrbitLabelling G m n mG nG)
    (κ : Equiv.Perm (Fin mG)) (hκ : ∀ p : Fin mG, ((κ p : ℕ) < nG ↔ (p : ℕ) < nG))
    (hmn : n ≤ m) {B : Matrix (Fin m) (Fin n) ℤ} (hB : IsGloballyFoldable θ hmn B) :
    IsGloballyFoldable (relabelOrbitLabelling θ κ hκ) hmn B := by
  have hseq : ∀ ρ : List (Fin nG), orbitSeq (relabelOrbitLabelling θ κ hκ) hmn ρ =
      orbitSeq θ hmn (ρ.map fun q => ⟨κ (Fin.castLE θ.le q), (hκ _).2 q.isLt⟩) := by
    intro ρ
    simp only [orbitSeq, List.flatMap_map]
    rfl
  refine ⟨hB.1, fun ρ => ?_⟩
  rw [hseq]
  exact hB.2 _

end Action

/-! ### Adding invariant frozen rows -/

section AddFrozen

variable {G : Type*} [Group G] {N NG f : ℕ} [MulAction G (Fin N)] [MulAction G (Fin (N + f))]

/-- Two indices have the same orbit iff they are related. -/
private theorem orbitRel_mk_eq_mk_iff {α : Type*} [MulAction G α] {a b : α} :
    (Quotient.mk'' a : orbitRel.Quotient G α) = Quotient.mk'' b ↔ a ∈ orbit G b :=
  Quotient.eq''.trans orbitRel_apply

/-- For the extended action, the orbit of `castAdd j` is the image of the orbit of `j`. -/
private theorem mem_orbit_castAdd_iff
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    {j : Fin N} {x : Fin (N + f)} :
    x ∈ orbit G (Fin.castAdd f j) ↔ ∃ j' ∈ orbit G j, x = Fin.castAdd f j' := by
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨g • j, mem_orbit j g, hact g j⟩
  · rintro ⟨j', ⟨g, rfl⟩, rfl⟩
    exact ⟨g, hact g j⟩

omit [MulAction G (Fin N)] in
/-- For the extended action, the orbit of `natAdd N e` is a singleton. -/
private theorem mem_orbit_natAdd_iff
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    {e : Fin f} {x : Fin (N + f)} : x ∈ orbit G (Fin.natAdd N e) ↔ x = Fin.natAdd N e := by
  constructor
  · rintro ⟨g, rfl⟩
    exact hfix g e
  · rintro rfl
    exact mem_orbit_self _

/-- The function from labels to orbits of the extended orbit labelling. -/
noncomputable def extendOrbitFun (θ : OrbitLabelling G N N NG NG) :
    Fin (NG + f) → orbitRel.Quotient G (Fin (N + f)) :=
  Fin.addCases (fun p => Quotient.mk'' (Fin.castAdd f (θ.rep p)))
    (fun e => Quotient.mk'' (Fin.natAdd N e))

omit [MulAction G (Fin N)] in
/-- A frozen singleton orbit is never the orbit of a mutable index. -/
private theorem castAdd_orbit_ne_natAdd_orbit
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (j : Fin N) (e : Fin f) : (Quotient.mk'' (Fin.castAdd f j) :
      orbitRel.Quotient G (Fin (N + f))) ≠ Quotient.mk'' (Fin.natAdd N e) := by
  intro h
  have h' := congrArg Fin.val ((mem_orbit_natAdd_iff hfix).1 (orbitRel_mk_eq_mk_iff.1 h))
  simp only [Fin.val_castAdd, Fin.val_natAdd] at h'
  have := j.isLt
  omega

/-- The orbit map of the extended orbit labelling is injective. -/
theorem extendOrbitFun_injective
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) :
    Function.Injective (extendOrbitFun (f := f) θ) := by
  intro p p' h
  induction p using Fin.addCases with
  | left p =>
    induction p' using Fin.addCases with
    | left p' =>
      simp only [extendOrbitFun, Fin.addCases_left] at h
      obtain ⟨j', hj', hj⟩ := (mem_orbit_castAdd_iff hact).1 (orbitRel_mk_eq_mk_iff.1 h)
      obtain rfl := Fin.castAdd_injective _ _ hj
      have h₁ : θ.rep p ∈ θ.orbit p' := θ.mem_of_mem_orbit (θ.rep_mem p') hj'
      rw [θ.mem_orbit_iff_label_eq, (θ.mem_orbit_iff_label_eq).1 (θ.rep_mem p)] at h₁
      rw [h₁]
    | right e' =>
      simp only [extendOrbitFun, Fin.addCases_left, Fin.addCases_right] at h
      exact absurd h (castAdd_orbit_ne_natAdd_orbit hfix _ e')
  | right e =>
    induction p' using Fin.addCases with
    | left p' =>
      simp only [extendOrbitFun, Fin.addCases_left, Fin.addCases_right] at h
      exact absurd h.symm (castAdd_orbit_ne_natAdd_orbit hfix _ e)
    | right e' =>
      simp only [extendOrbitFun, Fin.addCases_right] at h
      rw [(Fin.natAdd_inj N).1 ((mem_orbit_natAdd_iff hfix).1 (orbitRel_mk_eq_mk_iff.1 h))]

/-- The orbit map of the extended orbit labelling is surjective. -/
theorem extendOrbitFun_surjective
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (θ : OrbitLabelling G N N NG NG) :
    Function.Surjective (extendOrbitFun (f := f) θ) := by
  intro ω
  induction ω using Quotient.inductionOn' with
  | h x =>
    induction x using Fin.addCases with
    | left j =>
      refine ⟨Fin.castAdd f (θ.label j), ?_⟩
      simp only [extendOrbitFun, Fin.addCases_left]
      refine orbitRel_mk_eq_mk_iff.2 ((mem_orbit_castAdd_iff hact).2 ⟨_, ?_, rfl⟩)
      exact θ.mem_orbit_of_mem (θ.mem_orbit_label j) (θ.rep_mem _)
    | right e =>
      exact ⟨Fin.natAdd NG e, by simp [extendOrbitFun]⟩

/-- The orbit map of the extended orbit labelling is a bijection. -/
theorem extendOrbitFun_bijective
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) :
    Function.Bijective (extendOrbitFun (f := f) θ) :=
  ⟨extendOrbitFun_injective hact hfix θ, extendOrbitFun_surjective hact θ⟩

/-- The **extended orbit labelling** `θ̄`: `θ̄(p) = θ(p)` for `p < N^G`, and
`θ̄(N^G + e) = {N + e}`. -/
noncomputable def extendOrbitLabelling
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) : OrbitLabelling G (N + f) N (NG + f) NG where
  equiv := Equiv.ofBijective _ (extendOrbitFun_bijective hact hfix θ)
  le := Nat.le_add_right _ _
  lt_iff p := by
    induction p using Fin.addCases with
    | left p =>
      simp only [Fin.val_castAdd, p.isLt, true_iff, Equiv.ofBijective_apply, extendOrbitFun,
        Fin.addCases_left]
      intro i hi
      rw [orbitRel.Quotient.orbit_mk] at hi
      obtain ⟨j', -, rfl⟩ := (mem_orbit_castAdd_iff hact).1 hi
      simp
    | right e =>
      simp only [Fin.val_natAdd, Equiv.ofBijective_apply, extendOrbitFun, Fin.addCases_right]
      refine ⟨fun h => by omega, fun h => ?_⟩
      have := h (Fin.natAdd N e) (orbitRel.Quotient.mem_orbit.2 rfl)
      simp at this

/-- The orbit of a label `p < NG` of the extended labelling is the orbit of `p` under `θ`, embedded
in `Fin (N + f)`. -/
theorem orbit_extendOrbitLabelling_castAdd
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) (p : Fin NG) :
    (extendOrbitLabelling hact hfix θ).orbit (Fin.castAdd f p) =
      (θ.orbit p).map (Fin.castAddEmb f) := by
  ext i
  rw [OrbitLabelling.mem_orbit_iff]
  simp only [extendOrbitLabelling, Equiv.ofBijective_apply, extendOrbitFun, Fin.addCases_left,
    Finset.mem_map, Fin.castAddEmb_apply]
  rw [orbitRel_mk_eq_mk_iff, mem_orbit_castAdd_iff hact]
  constructor
  · rintro ⟨j', hj', rfl⟩
    exact ⟨j', θ.mem_of_mem_orbit (θ.rep_mem p) hj', rfl⟩
  · rintro ⟨j, hj, rfl⟩
    exact ⟨j, θ.mem_orbit_of_mem (θ.rep_mem p) hj, rfl⟩

/-- The orbit of a label `NG + e` of the extended labelling is the singleton `{N + e}`. -/
theorem orbit_extendOrbitLabelling_natAdd
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) (e : Fin f) :
    (extendOrbitLabelling hact hfix θ).orbit (Fin.natAdd NG e) = {Fin.natAdd N e} := by
  ext i
  rw [OrbitLabelling.mem_orbit_iff]
  simp only [extendOrbitLabelling, Equiv.ofBijective_apply, extendOrbitFun, Fin.addCases_right,
    Finset.mem_singleton]
  rw [orbitRel_mk_eq_mk_iff, mem_orbit_natAdd_iff hfix]

/-- **The extended orbit labelling exists.** If the action of `G` on `Fin (N + f)` restricts to
the given action on `[0, N)` and fixes `[N, N + f)`, and `θ` is an orbit labelling of the action
on `Fin N` (all indices mutable), then there is an orbit labelling `θ̄` of the extended action
with `θ̄(p) = θ(p)` for the labels `p < N^G` and `θ̄(N^G + e) = {N + e}`. -/
@[cluster_algebras "lem_add_frozen_globally_foldable"]
theorem exists_orbitLabelling_extend
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) :
    ∃ θ' : OrbitLabelling G (N + f) N (NG + f) NG,
      (∀ p : Fin NG, θ'.orbit (Fin.castAdd f p) = (θ.orbit p).map (Fin.castAddEmb f)) ∧
        ∀ e : Fin f, θ'.orbit (Fin.natAdd NG e) = {Fin.natAdd N e} :=
  ⟨extendOrbitLabelling hact hfix θ, orbit_extendOrbitLabelling_castAdd hact hfix θ,
    orbit_extendOrbitLabelling_natAdd hact hfix θ⟩

/-- A matrix for the extended action whose principal part is `G`-admissible and whose frozen
rows are invariant is `G`-admissible. -/
private theorem isGroupAdmissible_of_principalPart
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    {V : Matrix (Fin N) (Fin N) ℤ} (hV : IsGroupAdmissible G le_rfl V)
    {C : Matrix (Fin (N + f)) (Fin N) ℤ} (hCV : principalPart (Nat.le_add_right N f) C = V)
    (hrow : ∀ (e : Fin f) (g : G) (j : Fin N),
      C (Fin.natAdd N e) (g • j) = C (Fin.natAdd N e) j) :
    IsGroupAdmissible G (Nat.le_add_right N f) C := by
  have hC : ∀ i j, C (Fin.castAdd f i) j = V i j := fun i j => congrFun (congrFun hCV i) j
  refine ⟨fun g x j j' hj => ?_, fun i i' h => ?_, fun x x' h j => ?_⟩
  · have hj' : j' = g • j := Fin.castAdd_injective _ _ (hj.trans (hact g j))
    induction x using Fin.addCases with
    | left i =>
      rw [hact, hC, hC]
      exact hV.smul_eq g i j j' hj'
    | right e =>
      rw [hfix, hj', hrow]
  · obtain ⟨j', hj', hj⟩ := (mem_orbit_castAdd_iff hact).1 h
    obtain rfl := Fin.castAdd_injective _ _ hj
    change C (Fin.castAdd f i) i' = 0
    rw [hC]
    exact hV.eq_zero i i' hj'
  · induction x using Fin.addCases with
    | left i =>
      obtain ⟨j', hj', rfl⟩ := (mem_orbit_castAdd_iff hact).1 h
      rw [hC, hC]
      exact hV.mul_nonneg i j' hj' j
    | right e =>
      rw [(mem_orbit_natAdd_iff hfix).1 h]
      exact mul_self_nonneg _

/-- The columns of a mutable label of the extended labelling are those of the labelling. -/
private theorem cols_extend (θ : OrbitLabelling G N N NG NG)
    (θ' : OrbitLabelling G (N + f) N (NG + f) NG)
    (hθ₁ : ∀ p : Fin NG, θ'.orbit (Fin.castAdd f p) = (θ.orbit p).map (Fin.castAddEmb f))
    (r : Fin NG) : θ'.cols (Nat.le_add_right N f) r = θ.cols le_rfl r := by
  ext j
  rw [OrbitLabelling.mem_cols, OrbitLabelling.mem_cols]
  change Fin.castAdd f j ∈ θ'.orbit (Fin.castAdd f r) ↔ j ∈ θ.orbit r
  rw [hθ₁, Finset.mem_map]
  exact ⟨fun ⟨j', hj', h⟩ => Fin.castAdd_injective _ _ h ▸ hj', fun h => ⟨j, h, rfl⟩⟩

/-- The column representatives of the extended labelling are those of the labelling. -/
private theorem colRep_extend (θ : OrbitLabelling G N N NG NG)
    (θ' : OrbitLabelling G (N + f) N (NG + f) NG)
    (hθ₁ : ∀ p : Fin NG, θ'.orbit (Fin.castAdd f p) = (θ.orbit p).map (Fin.castAddEmb f))
    (q : Fin NG) : θ'.colRep q = θ.colRep q := by
  have h1 : Fin.castAdd f (θ.rep q) ∈ θ'.orbit (Fin.castAdd f q) := by
    rw [hθ₁]
    exact Finset.mem_map_of_mem _ (θ.rep_mem q)
  have h2 := θ'.rep_mem (Fin.castAdd f q)
  rw [hθ₁, Finset.mem_map] at h2
  obtain ⟨j, hj, hji⟩ := h2
  have h3 : θ'.rep (Fin.castAdd f q) = Fin.castAdd f (θ.rep q) := by
    refine le_antisymm (θ'.rep_le h1) ?_
    rw [← hji, Fin.castAddEmb_apply, Fin.le_iff_val_le_val, Fin.val_castAdd, Fin.val_castAdd]
    exact Fin.le_iff_val_le_val.1 (θ.rep_le hj)
  ext
  change (θ'.rep (Fin.castAdd f q) : ℕ) = θ.rep q
  rw [h3, Fin.val_castAdd]

/-- **Adding invariant frozen rows preserves global foldability.** Let `G` act on `Fin N` with
all indices mutable, `θ` an orbit labelling, and `U` a globally foldable `N × N` integer matrix
with `uᵢⱼ = -uⱼᵢ`. Extend the action to `Fin (N + f)` by fixing the new indices, with extended
labelling `θ̄`, and let `B̃` be an `(N + f) × N` integer matrix with principal part `U` whose
frozen rows are invariant: `b_{i, g(j)} = b_{ij}` for `i ≥ N`. Then `B̃` is globally foldable for
`θ̄`, the folded matrix `B̃ᴳ` has principal part `Uᴳ`, and its row `N^G + e` is
`(b_{N+e, j_q})_q`, `j_q` the least element of `θ(q)`. -/
@[cluster_algebras "lem_add_frozen_globally_foldable"]
theorem isGloballyFoldable_extend
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) (θ' : OrbitLabelling G (N + f) N (NG + f) NG)
    (hθ₁ : ∀ p : Fin NG, θ'.orbit (Fin.castAdd f p) = (θ.orbit p).map (Fin.castAddEmb f))
    (hθ₂ : ∀ e : Fin f, θ'.orbit (Fin.natAdd NG e) = {Fin.natAdd N e})
    {U : Matrix (Fin N) (Fin N) ℤ} (hU : IsGloballyFoldable θ le_rfl U)
    (_hskew : ∀ i j, U i j = -U j i) {B : Matrix (Fin (N + f)) (Fin N) ℤ}
    (hBU : principalPart (Nat.le_add_right N f) B = U)
    (hrow : ∀ (e : Fin f) (g : G) (j : Fin N),
      B (Fin.natAdd N e) (g • j) = B (Fin.natAdd N e) j) :
    IsGloballyFoldable θ' (Nat.le_add_right N f) B ∧
      principalPart θ'.le (foldedMatrix θ' B) = foldedMatrix θ U ∧
      ∀ (e : Fin f) (q : Fin NG),
        foldedMatrix θ' B (Fin.natAdd NG e) q = B (Fin.natAdd N e) (θ.colRep q) := by
  have hseq : ∀ ρ, orbitSeq θ' (Nat.le_add_right N f) ρ = orbitSeq θ le_rfl ρ := fun ρ => by
    simp only [orbitSeq, cols_extend θ θ' hθ₁]
  have hadm : ∀ ρ, IsGroupAdmissible G (Nat.le_add_right N f)
      (matrixMutationList (Nat.le_add_right N f) B (orbitSeq θ' (Nat.le_add_right N f) ρ)) := by
    intro ρ
    induction ρ using List.reverseRecOn with
    | nil => exact isGroupAdmissible_of_principalPart hact hfix hU.1 hBU hrow
    | append_singleton ρ r ih =>
      refine isGroupAdmissible_of_principalPart hact hfix (hU.2 (ρ ++ [r])) ?_ ?_
      · rw [principalPart_matrixMutationList, hBU, hseq]
      · intro e g j
        have hω : IsMutableOrbit N (θ'.equiv (Fin.castLE θ'.le r)) :=
          (θ'.lt_iff _).1 (θ'.val_castLE_lt r)
        have h := smul_eq_matrixMutationList_orbitCols (Nat.le_add_right N f) ih hω g
          (Fin.natAdd N e) j (g • j) (hact g j).symm
        rw [hfix] at h
        rwa [orbitSeq_append_singleton, matrixMutationList_append]
  refine ⟨⟨hadm [], hadm⟩, ?_, fun e q => ?_⟩
  · ext p q
    change ∑ i ∈ θ'.orbit (Fin.castAdd f p), B i (θ'.colRep q) = ∑ i ∈ θ.orbit p, U i (θ.colRep q)
    rw [hθ₁, Finset.sum_map, colRep_extend θ θ' hθ₁, ← hBU]
    rfl
  · rw [foldedMatrix_apply, hθ₂, Finset.sum_singleton, colRep_extend θ θ' hθ₁]

end AddFrozen

/-! ### Folding and finite type -/

section ExtendAction

variable (G : Type*) [Group G] (N f : ℕ) [MulAction G (Fin N)]

/-- The map of the extended action: `g` acts as given on `[0, N)` and fixes `[N, N + f)`. -/
def extendSMul (g : G) : Fin (N + f) → Fin (N + f) :=
  Fin.addCases (fun j => Fin.castAdd f (g • j)) (fun e => Fin.natAdd N e)

/-- `extendSMul` acts on `[0, N)` as the given action. -/
theorem extendSMul_castAdd (g : G) (j : Fin N) :
    extendSMul G N f g (Fin.castAdd f j) = Fin.castAdd f (g • j) :=
  Fin.addCases_left _

/-- `extendSMul` fixes every index of `[N, N + f)`. -/
theorem extendSMul_natAdd (g : G) (e : Fin f) :
    extendSMul G N f g (Fin.natAdd N e) = Fin.natAdd N e :=
  Fin.addCases_right _

/-- The action of `G` on `Fin (N + f)` that acts as the given action on `[0, N)` and fixes every
index of `[N, N + f)`. -/
@[reducible] def extendMulAction : MulAction G (Fin (N + f)) where
  smul := extendSMul G N f
  one_smul x := by
    change extendSMul G N f 1 x = x
    induction x using Fin.addCases with
    | left j => rw [extendSMul_castAdd, one_smul]
    | right e => rw [extendSMul_natAdd]
  mul_smul g h x := by
    change extendSMul G N f (g * h) x = extendSMul G N f g (extendSMul G N f h x)
    induction x using Fin.addCases with
    | left j => rw [extendSMul_castAdd, extendSMul_castAdd, extendSMul_castAdd, mul_smul]
    | right e => rw [extendSMul_natAdd, extendSMul_natAdd, extendSMul_natAdd]

/-- The extended action acts on `[0, N)` as the given action. -/
theorem extendMulAction_castAdd (g : G) (j : Fin N) :
    letI := extendMulAction G N f
    g • Fin.castAdd f j = Fin.castAdd f (g • j) :=
  extendSMul_castAdd G N f g j

/-- The extended action fixes every index of `[N, N + f)`. -/
theorem extendMulAction_natAdd (g : G) (e : Fin f) :
    letI := extendMulAction G N f
    g • Fin.natAdd N e = Fin.natAdd N e :=
  extendSMul_natAdd G N f g e

end ExtendAction

/-- **The unfolded matrix.** Let `G` act on `Fin (N + f)` as on `Fin N` on `[0, N)`, fixing
`[N, N + f)`, with extended labelling `θ̄`, and let `U` be a globally foldable `N × N` integer
matrix with `uᵢⱼ = -uⱼᵢ`. Every `(N^G + f) × N^G` integer matrix `C` with principal part `Uᴳ` is
the folding `B̃ᴳ` of a globally foldable `(N + f) × N` integer matrix `B̃` with principal part `U`;
the frozen row `N + e` of `B̃` is `(c_{N^G + e, θ(j)})_j`. -/
private theorem exists_isGloballyFoldable_foldedMatrix_eq {G : Type*} [Group G] {N NG f : ℕ}
    [MulAction G (Fin N)] [MulAction G (Fin (N + f))]
    (hact : ∀ (g : G) (j : Fin N), g • Fin.castAdd f j = Fin.castAdd f (g • j))
    (hfix : ∀ (g : G) (e : Fin f), g • Fin.natAdd N e = Fin.natAdd N e)
    (θ : OrbitLabelling G N N NG NG) (θ' : OrbitLabelling G (N + f) N (NG + f) NG)
    (hθ₁ : ∀ p : Fin NG, θ'.orbit (Fin.castAdd f p) = (θ.orbit p).map (Fin.castAddEmb f))
    (hθ₂ : ∀ e : Fin f, θ'.orbit (Fin.natAdd NG e) = {Fin.natAdd N e})
    {U : Matrix (Fin N) (Fin N) ℤ} (hskew : ∀ i j, U i j = -U j i)
    (hU : IsGloballyFoldable θ le_rfl U) {C : Matrix (Fin (NG + f)) (Fin NG) ℤ}
    (hC : principalPart (Nat.le_add_right NG f) C = foldedMatrix θ U) :
    ∃ B : Matrix (Fin (N + f)) (Fin N) ℤ, IsGloballyFoldable θ' (Nat.le_add_right N f) B ∧
      foldedMatrix θ' B = C ∧ principalPart (Nat.le_add_right N f) B = U ∧
      ∀ i j : Fin N, B (Fin.castLE (Nat.le_add_right N f) i) j =
        -B (Fin.castLE (Nat.le_add_right N f) j) i := by
  set B : Matrix (Fin (N + f)) (Fin N) ℤ := Matrix.of fun i j =>
    Fin.addCases (motive := fun _ => ℤ) (fun i => U i j)
      (fun e => C (Fin.natAdd NG e) (θ.label j)) i with hBdef
  have hBl : ∀ i j, B (Fin.castAdd f i) j = U i j := fun i j => by
    simp only [hBdef, Matrix.of_apply, Fin.addCases_left]
  have hBr : ∀ e j, B (Fin.natAdd N e) j = C (Fin.natAdd NG e) (θ.label j) := fun e j => by
    simp only [hBdef, Matrix.of_apply, Fin.addCases_right]
  have hBU : principalPart (Nat.le_add_right N f) B = U := Matrix.ext hBl
  have hrow : ∀ (e : Fin f) (g : G) (j : Fin N),
      B (Fin.natAdd N e) (g • j) = B (Fin.natAdd N e) j := fun e g j => by
    rw [hBr, hBr, OrbitLabelling.label, OrbitLabelling.label, orbitRel_mk_smul]
  obtain ⟨hfold, hpp, hfrozen⟩ := isGloballyFoldable_extend hact hfix θ θ' hθ₁ hθ₂ hU hskew hBU hrow
  refine ⟨B, hfold, ?_, hBU, fun i j => by
    rw [show Fin.castLE (Nat.le_add_right N f) i = Fin.castAdd f i from rfl,
      show Fin.castLE (Nat.le_add_right N f) j = Fin.castAdd f j from rfl, hBl, hBl, hskew]⟩
  ext p q
  induction p using Fin.addCases with
  | left p => exact (congrFun (congrFun hpp p) q).trans (congrFun (congrFun hC p) q).symm
  | right e =>
    rw [hfrozen, hBr]
    congr 1
    exact (θ.mem_orbit_iff_label_eq).1 (θ.rep_mem _)

/-- **Folding preserves finite type.** Let `G` act on `Fin N` with all indices mutable, `θ` an
orbit labelling with `N^G` labels, and `U` a globally foldable `N × N` integer matrix with
`uᵢⱼ = -uⱼᵢ`. Suppose every seed pattern of rank `N` over `𝕜` one of whose seeds has exchange
matrix `U` is of finite type. Then every seed pattern of rank `N^G` over `𝕜` one of whose seeds
has exchange matrix `Uᴳ` is of finite type.

The hypothesis quantifies over fields `F` in the universe of `𝕜`, which is all the proof needs;
the conclusion is for a field `F'` in any universe. No hypothesis `N ≥ 1` is needed. -/
@[cluster_algebras "lem_folding_finite_type"]
theorem isFiniteType_of_isGloballyFoldable {K : Type u} [Field K] [CharZero K]
    {G : Type*} [Group G] {N NG : ℕ} [MulAction G (Fin N)] (θ : OrbitLabelling G N N NG NG)
    {U : Matrix (Fin N) (Fin N) ℤ} (hskew : ∀ i j, U i j = -U j i)
    (hU : IsGloballyFoldable θ le_rfl U)
    (hfin : ∀ (F : Type u) [Field F] [Algebra K F] (m : ℕ) (hm : N ≤ m)
      (P : RegularTree N → SeedData F m N), IsSeedPattern K hm P →
        (∃ t, principalPart hm (P t).extExchangeMatrix = U) → IsFiniteType P)
    {F' : Type*} [Field F'] [Algebra K F'] {m' : ℕ} (hm' : NG ≤ m')
    {P : RegularTree NG → SeedData F' m' NG} (hP : IsSeedPattern K hm' P)
    (ht : ∃ t, principalPart hm' (P t).extExchangeMatrix = foldedMatrix θ U) :
    IsFiniteType P := by
  classical
  obtain ⟨t, ht⟩ := ht
  obtain ⟨f, rfl⟩ := Nat.exists_eq_add_of_le hm'
  have : CharZero F' := charZero_of_injective_algebraMap (algebraMap K F').injective
  letI := extendMulAction G N f
  have hact := extendMulAction_castAdd G N f
  have hfix := extendMulAction_natAdd G N f
  obtain ⟨θ', hθ₁, hθ₂⟩ := exists_orbitLabelling_extend hact hfix θ
  have hmn : N ≤ N + f := Nat.le_add_right N f
  obtain ⟨B, hfold, hfoldC, hBU, hskewB⟩ :=
    exists_isGloballyFoldable_foldedMatrix_eq hact hfix θ θ' hθ₁ hθ₂ hskew hU ht
  set L := FractionRing (MvPolynomial (Fin (N + f)) K)
  have : CharZero L := charZero_of_injective_algebraMap (algebraMap K L).injective
  have hX := isFreeGeneratingTuple_X K (m := N + f)
  set S : SeedData L (N + f) N :=
    ⟨fun i => algebraMap (MvPolynomial (Fin (N + f)) K) L (MvPolynomial.X i), B⟩
  have hS : IsLabeledSeed K hmn S := by
    refine ⟨hX, fun _ => 1, fun _ => one_pos, fun i j => ?_⟩
    simp only [Int.cast_one, one_mul, Matrix.submatrix_apply, id]
    exact hskewB i j
  set z := (P t).extCluster
  have hz : IsFreeGeneratingTuple K z := (hP.1 t).1
  -- The default `maxSynthPendingDepth` finds the scalar tower `ℚ → K → L`; the project's 3
  -- does not.
  have : Fact (AlgebraicIndependent ℚ S.extCluster) := by
    set_option maxSynthPendingDepth 1 in
    exact ⟨hX.1.restrictScalars (algebraMap ℚ K).injective⟩
  have : Fact (AlgebraicIndependent ℚ z) := ⟨hz.1.restrictScalars (algebraMap ℚ K).injective⟩
  obtain ⟨ψ, hψ⟩ := universalSemifield.exists_hom (y := S.extCluster)
    (S := universalSemifield z) fun i => ⟨z (θ'.label i), mem_universalSemifield_self z _⟩
  have hψ' : ∀ p, ∀ i ∈ θ'.orbit p,
      (ψ ⟨S.extCluster i, mem_universalSemifield_self _ i⟩ : F') = z p := by
    intro p i hi
    rw [hψ i, (θ'.mem_orbit_iff_label_eq).1 hi]
  obtain ⟨Pat, hPat, hPat₀, hrange⟩ :=
    exists_isSeedPattern_foldedSeed (S := S) θ' ψ (K := K) hfold hskewB hz hψ' t
  have hPatP : Pat = P := by
    refine hPat.eq_of_apply_eq θ'.le hP (t₀ := t) ?_
    rw [hPat₀]
    change (⟨z, foldedMatrix θ' B⟩ : SeedData F' (NG + f) NG) = P t
    rw [hfoldC]
  obtain ⟨Q, hQ, hQ₀⟩ := exists_isSeedPattern hmn (RegularTree.root : RegularTree N) hS
  have hQfin : IsFiniteType Q := hfin L (N + f) hmn Q hQ ⟨_, by rwa [hQ₀]⟩
  rw [← hPatP, IsFiniteType, hrange]
  refine (hQfin.image (foldedSeed θ' ψ)).subset ?_
  rintro _ ⟨ρ, rfl⟩
  have h := hQ.seedMutationSeq_mem_range hmn RegularTree.root (orbitSeq θ' hmn ρ)
  rw [hQ₀] at h
  exact ⟨_, h, rfl⟩

/-- **Finite type from a globally foldable unfolding.** Let `M₀` be a skew-symmetrizable
`n × n` integer matrix whose Cartan counterpart has a finite tree as Coxeter graph, `G` an
action on `Fin N` with all indices mutable and exactly `n` orbits, `θ` an orbit labelling, and
`U` an `N × N` integer matrix with `uᵢⱼ = -uⱼᵢ`, globally foldable for `θ`, with `U^{G,θ} = M₀`.
Suppose every seed pattern of rank `N` over `𝕜` one of whose seeds has exchange matrix `U` is of
finite type. Then every seed pattern `P` of rank `n` over `𝕜` such that, for some `t`, `A(B(t))`
and `A(M₀)` have the same type, is of finite type. No hypothesis `n ≥ 1` or `N ≥ 1` is
needed. -/
@[cluster_algebras "lem_unfold_standard_finite"]
theorem isFiniteType_of_sameCartanType_foldedMatrix {K : Type u} [Field K] [CharZero K]
    {n : ℕ} {M₀ : Matrix (Fin n) (Fin n) ℤ} (hM₀ : SkewSymmetrizable M₀)
    (htree : IsFiniteTree (coxeterGraph (cartanCounterpart M₀)))
    {G : Type*} [Group G] {N : ℕ} [MulAction G (Fin N)] (θ : OrbitLabelling G N N n n)
    {U : Matrix (Fin N) (Fin N) ℤ} (hskew : ∀ i j, U i j = -U j i)
    (hU : IsGloballyFoldable θ le_rfl U) (hUM : foldedMatrix θ U = M₀)
    (hfin : ∀ (F : Type u) [Field F] [Algebra K F] (m : ℕ) (hm : N ≤ m)
      (P : RegularTree N → SeedData F m N), IsSeedPattern K hm P →
        (∃ t, principalPart hm (P t).extExchangeMatrix = U) → IsFiniteType P)
    {F' : Type*} [Field F'] [Algebra K F'] {m' : ℕ} (hm' : n ≤ m')
    {P : RegularTree n → SeedData F' m' n} (hP : IsSeedPattern K hm' P) {t : RegularTree n}
    (ht : SameCartanType (cartanCounterpart (principalPart hm' (P t).extExchangeMatrix))
      (cartanCounterpart M₀)) :
    IsFiniteType P := by
  obtain ⟨t', π, hπ⟩ := exists_principalPart_apply_eq_of_sameCartanType hm' hP hM₀ htree ht
  have hκ : ∀ p : Fin n, (((π⁻¹ : Equiv.Perm (Fin n)) p : ℕ) < n ↔ (p : ℕ) < n) :=
    fun p => iff_of_true (π⁻¹ p).isLt p.isLt
  refine isFiniteType_of_isGloballyFoldable (relabelOrbitLabelling θ π⁻¹ hκ) hskew
    (isGloballyFoldable_relabelOrbitLabelling θ π⁻¹ hκ le_rfl hU) hfin hm' hP ⟨t', ?_⟩
  have hinv : ∀ x, π (π⁻¹ x) = x := π.apply_symm_apply
  ext p q
  rw [foldedMatrix_relabelOrbitLabelling, hUM, ← hπ, hinv]
  congr 1
  exact (hinv q).symm

