/-!
# Folding with arbitrary coefficients, and the `F₄` matrices with their `E₆` lifts

Following [FWZ, Section 5.7], type `F₄` is obtained by folding a quiver of type `E₆` along
`ℤ/2ℤ`. This file states that folding a globally foldable skew-symmetric matrix of finite type
gives seed patterns of finite type for every choice of coefficients, describes the eight exchange
matrices `P_ε` with Cartan counterpart `C(F₄)`, and lifts each of them to a matrix `Q_ε` of type
`E₆` with `Q_εᴳ = P_ε`.

## Main definitions

* `ClusterAlgebras.TypeFG.matrixF₄ ε`: the matrix `P_ε`, `ε ∈ {1, -1}³`.
* `ClusterAlgebras.TypeFG.E₆FoldGroup`: the group `ℤ/2ℤ`, acting on `Fin 6` through the
  involution `ClusterAlgebras.TypeFG.e₆Involution` that exchanges the two long arms of `E₆`.
* `ClusterAlgebras.TypeFG.e₆OrbitLabelling`: the orbit labelling `θ`.
* `ClusterAlgebras.TypeFG.matrixE₆Lift ε`: the lift `Q_ε`.

## Main statements

* `ClusterAlgebras.IsSeedPattern.isFiniteType_of_principalPart_eq_foldedMatrix`: folding
  preserves finite type, for every choice of coefficients.
* `ClusterAlgebras.TypeFG.cartanCounterpart_matrixF₄`,
  `ClusterAlgebras.TypeFG.exists_eq_matrixF₄`: the `P_ε` are exactly the skew-symmetrizable
  matrices with Cartan counterpart `C(F₄)`.
* `ClusterAlgebras.TypeFG.foldedMatrix_matrixE₆Lift`: `Q_εᴳ = P_ε`.

## Implementation notes

* Indices are `Fin`, so the vertex `i` of [FWZ] is `i - 1` here. The involution `g` of [FWZ]
  (`1 ↔ 5`, `2 ↔ 4`, `3`, `6` fixed) is `0 ↔ 4`, `1 ↔ 3`, `2`, `5` fixed; the orbits
  `{6}, {3}, {2, 4}, {1, 5}` labelled `1, 2, 3, 4` are `{5}, {2}, {1, 3}, {0, 4}` labelled
  `0, 1, 2, 3`. The entries of `P_ε` and `Q_ε` are shifted the same way; e.g. the entry
  `p₃₂ = -2ε₂` of [FWZ] is `matrixF₄ ε 2 1 = -2 * ε 1`.
* A sign vector `ε = (ε₁, ε₂, ε₃) ∈ {1, -1}³` is a map `ε : Fin 3 → ℤˣ`, the units of `ℤ` being
  exactly `±1`; `ε₁, ε₂, ε₃` are `ε 0, ε 1, ε 2`, and `(1, 1, 1)` is the constant map `1`.
* The group of permutations of `[1, 6]` generated by `g` is modelled, as for
  `ClusterAlgebras.HexagonGroup`, by a type synonym of
  `Multiplicative (ZMod 2)` whose generator acts by `g`. Every notion of folding (orbits,
  admissibility, orbit labellings, folded matrices, global foldability) depends on the action
  only through the set of permutations it induces, which is the group generated by `g`.
* An orbit labelling is built from one representative of each orbit, by the construction
  `ClusterAlgebras.TypeBC.orbitLabellingOfReps`.
* Folding with arbitrary coefficients is the lemma
  `ClusterAlgebras.TypeBC.isFiniteType_of_isGloballyFoldable`, and is stated as there: the
  hypothesis "every seed pattern with exchange matrix `C` is of finite type" quantifies over
  the fields in the universe of `𝕜` (the proof unfolds into a field of rational functions over
  `𝕜`), which makes it weaker and the statement stronger.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 5][FWZ]
-/

@[expose] public section

namespace ClusterAlgebras

open Matrix MulAction

universe u

/-! ### Folding with arbitrary coefficients -/

/-- **Folding preserves finite type, for every choice of coefficients.** Let `G` act on `Fin N`
(all indices mutable), `θ` an orbit labelling with `n` orbits, and `C` an `N × N` integer
matrix with `cᵢⱼ = -cⱼᵢ` that is globally foldable for `θ`, such that every seed pattern of rank
`N` over `𝕜` in which `C` is the exchange matrix of some seed is of finite type. If `Σ̄` is a
seed pattern of rank `n` over `𝕜` (with arbitrary frozen rows) and the exchange matrix of
`Σ̄(t₁)` is the folded matrix `Cᴳ`, then `Σ̄` is of finite type.

The hypothesis quantifies over fields in the universe of `𝕜`; the conclusion is for a field in
any universe. -/
@[cluster_algebras "lem_fg_folding_finite"]
theorem IsSeedPattern.isFiniteType_of_principalPart_eq_foldedMatrix {K : Type u} [Field K]
    [CharZero K] {G : Type*} [Group G] {N n : ℕ} [MulAction G (Fin N)]
    (θ : OrbitLabelling G N N n n) {C : Matrix (Fin N) (Fin N) ℤ}
    (hskew : ∀ i j, C i j = -C j i) (hC : IsGloballyFoldable θ le_rfl C)
    (hfin : ∀ (F : Type u) [Field F] [Algebra K F] (m : ℕ) (hm : N ≤ m)
      (P : RegularTree N → SeedData F m N), IsSeedPattern K hm P →
        (∃ t, principalPart hm (P t).extExchangeMatrix = C) → IsFiniteType P)
    {F' : Type*} [Field F'] [Algebra K F'] {m' : ℕ} (hm' : n ≤ m')
    {P : RegularTree n → SeedData F' m' n} (hP : IsSeedPattern K hm' P) {t₁ : RegularTree n}
    (ht₁ : principalPart hm' (P t₁).extExchangeMatrix = foldedMatrix θ C) :
    IsFiniteType P :=
  TypeBC.isFiniteType_of_isGloballyFoldable θ hskew hC hfin hm' hP ⟨t₁, ht₁⟩

namespace TypeFG

/-! ### The `F₄` matrices -/

/-- **The `F₄` matrices.** For `ε = (ε₁, ε₂, ε₃) ∈ {1, -1}³`, the `4 × 4` integer matrix `P_ε`
with `p₀₁ = ε₁`, `p₁₀ = -ε₁`, `p₁₂ = ε₂`, `p₂₁ = -2ε₂`, `p₂₃ = ε₃`, `p₃₂ = -ε₃` and all other
entries `0`, indices running over `Fin 4`. -/
@[cluster_algebras "def_fg_F4_matrices"]
def matrixF₄ (ε : Fin 3 → ℤˣ) : Matrix (Fin 4) (Fin 4) ℤ :=
  !![0, (ε 0 : ℤ), 0, 0;
    -(ε 0 : ℤ), 0, (ε 1 : ℤ), 0;
    0, -2 * (ε 1 : ℤ), 0, (ε 2 : ℤ);
    0, 0, -(ε 2 : ℤ), 0]

/-- **The matrices with Cartan counterpart `C(F₄)`**: `(2, 2, 1, 1)` is a skew-symmetrizing vector
of each `P_ε`. -/
@[cluster_algebras "lem_fg_F4_matrices"]
theorem isSkewSymmetrizingVector_matrixF₄ (ε : Fin 3 → ℤˣ) :
    IsSkewSymmetrizingVector (matrixF₄ ε) ![2, 2, 1, 1] := by
  refine ⟨by decide, fun i j => ?_⟩
  fin_cases i <;> fin_cases j <;> simp [matrixF₄]

/-- **The matrices with Cartan counterpart `C(F₄)`**: each `P_ε` is skew-symmetrizable. -/
@[cluster_algebras "lem_fg_F4_matrices"]
theorem skewSymmetrizable_matrixF₄ (ε : Fin 3 → ℤˣ) : SkewSymmetrizable (matrixF₄ ε) :=
  ⟨_, isSkewSymmetrizingVector_matrixF₄ ε⟩

/-- **The matrices with Cartan counterpart `C(F₄)`**: `A(P_ε) = C(F₄)`. -/
@[cluster_algebras "lem_fg_F4_matrices"]
theorem cartanCounterpart_matrixF₄ (ε : Fin 3 → ℤˣ) :
    cartanCounterpart (matrixF₄ ε) = cartanF₄ := by
  have h (k : Fin 3) : |(ε k : ℤ)| = 1 := Int.isUnit_iff_abs_eq.1 (ε k).isUnit
  ext i j
  fin_cases i <;> fin_cases j <;> simp [cartanCounterpart, matrixF₄, cartanF₄, cartanA, h]

/-- If `|x| = 1`, `|y| = k > 0` and `x > 0 ↔ y < 0`, then `y = -(k x)`. -/
private theorem typeF4_eq_neg_mul_of_abs {x y k : ℤ} (hk : 0 < k) (hx : |x| = 1) (hy : |y| = k)
    (h : 0 < x ↔ y < 0) : y = -(k * x) := by
  rcases (abs_eq zero_le_one).1 hx with rfl | rfl <;>
    rcases (abs_eq hk.le).1 hy with rfl | rfl <;> omega

/-- An integer of absolute value `1` is its own sign. -/
private theorem typeF4_sign_of_abs {x : ℤ} (hx : |x| = 1) : x.sign = x := by
  rcases (abs_eq zero_le_one).1 hx with rfl | rfl <;> rfl

/-- **The matrices with Cartan counterpart `C(F₄)`**, converse: every skew-symmetrizable `4 × 4`
integer matrix `P` with `A(P) = C(F₄)` is `P_ε` with `ε = (sgn p₁₂, sgn p₂₃, sgn p₃₄)`. -/
@[cluster_algebras "lem_fg_F4_matrices"]
theorem exists_eq_matrixF₄ {P : Matrix (Fin 4) (Fin 4) ℤ} (hP : SkewSymmetrizable P)
    (hA : cartanCounterpart P = cartanF₄) :
    ∃ ε : Fin 3 → ℤˣ, P = matrixF₄ ε ∧ (ε 0 : ℤ) = (P 0 1).sign ∧ (ε 1 : ℤ) = (P 1 2).sign ∧
      (ε 2 : ℤ) = (P 2 3).sign := by
  obtain ⟨hdiag, hsign⟩ := ExtSkewSymmetrizable.signAntisymmetric le_rfl
    (by simpa [ExtSkewSymmetrizable] using hP)
  simp only [Fin.castLE_rfl, id] at hdiag hsign
  have h (i j : Fin 4) := congr_fun₂ hA i j
  have e01 : |P 0 1| = 1 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 0 1
  have e10 : |P 1 0| = 1 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 1 0
  have e12 : |P 1 2| = 1 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 1 2
  have e21 : |P 2 1| = 2 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 2 1
  have e23 : |P 2 3| = 1 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 2 3
  have e32 : |P 3 2| = 1 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 3 2
  have z02 : P 0 2 = 0 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 0 2
  have z03 : P 0 3 = 0 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 0 3
  have z13 : P 1 3 = 0 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 1 3
  have z20 : P 2 0 = 0 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 2 0
  have z30 : P 3 0 = 0 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 3 0
  have z31 : P 3 1 = 0 := by simpa [cartanCounterpart, cartanF₄, cartanA] using h 3 1
  refine ⟨![(Int.isUnit_iff_abs_eq.2 e01).unit, (Int.isUnit_iff_abs_eq.2 e12).unit,
    (Int.isUnit_iff_abs_eq.2 e23).unit], ?_, ?_, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [matrixF₄, hdiag, z02, z03, z13, z20, z30, z31,
        typeF4_eq_neg_mul_of_abs (k := 1) one_pos e01 e10 (hsign 0 1),
        typeF4_eq_neg_mul_of_abs (k := 2) two_pos e12 e21 (hsign 1 2),
        typeF4_eq_neg_mul_of_abs (k := 1) one_pos e23 e32 (hsign 2 3)]
  · simpa using (typeF4_sign_of_abs e01).symm
  · simpa using (typeF4_sign_of_abs e12).symm
  · simpa using (typeF4_sign_of_abs e23).symm

/-! ### The `E₆` lifts -/

/-- The involution `g` of `Fin 6` exchanging the two long arms `2 — 1 — 0` and `2 — 3 — 4` of the
`E₆` tree and fixing `2` and `5`. -/
@[cluster_algebras "def_fg_E6_lifts"]
def e₆Involution : Fin 6 → Fin 6 :=
  ![4, 3, 2, 1, 0, 5]

/-- The group `ℤ/2ℤ`, written multiplicatively, acting on `Fin 6` through the involution `g`
(`ClusterAlgebras.TypeFG.instMulActionE₆FoldGroup`). -/
@[cluster_algebras "def_fg_E6_lifts"]
def E₆FoldGroup : Type :=
  Multiplicative (ZMod 2)

/-- `E₆FoldGroup` is the group `Multiplicative (ZMod 2)`. -/
instance instGroupE₆FoldGroup : Group E₆FoldGroup :=
  inferInstanceAs (Group (Multiplicative (ZMod 2)))

/-- `E₆FoldGroup` is finite, with two elements. -/
instance instFintypeE₆FoldGroup : Fintype E₆FoldGroup :=
  inferInstanceAs (Fintype (Multiplicative (ZMod 2)))

/-- `E₆FoldGroup` has decidable equality. -/
instance instDecidableEqE₆FoldGroup : DecidableEq E₆FoldGroup :=
  inferInstanceAs (DecidableEq (Multiplicative (ZMod 2)))

/-- The action of `ℤ/2ℤ` on `Fin 6`: the identity fixes every index, the generator acts by the
involution `g`. All indices are mutable (`m = n = 6`). -/
@[cluster_algebras "def_fg_E6_lifts"]
instance instMulActionE₆FoldGroup : MulAction E₆FoldGroup (Fin 6) where
  smul g i := if Multiplicative.toAdd (g : Multiplicative (ZMod 2)) = 0 then i else e₆Involution i
  one_smul := by decide
  mul_smul := by decide

/-- The action of `E₆FoldGroup`: the identity fixes `i`, the generator sends it to `g(i)`. -/
theorem e₆FoldGroup_smul_def (g : E₆FoldGroup) (i : Fin 6) :
    g • i = if Multiplicative.toAdd (g : Multiplicative (ZMod 2)) = 0 then i else e₆Involution i :=
  rfl

/-- The orbits of the action are the sets `{i, g(i)}`: `{5}`, `{2}`, `{1, 3}`, `{0, 4}`. -/
@[cluster_algebras "def_fg_E6_lifts"]
theorem mem_orbit_e₆FoldGroup_iff {i i' : Fin 6} :
    i' ∈ orbit E₆FoldGroup i ↔ i' = i ∨ i' = e₆Involution i := by
  rw [mem_orbit_iff]
  revert i i'
  decide

/-- Membership in an orbit of `E₆FoldGroup` is decidable. -/
instance instDecidableMemOrbitE₆FoldGroup (i i' : Fin 6) :
    Decidable (i' ∈ orbit E₆FoldGroup i) :=
  decidable_of_iff _ mem_orbit_e₆FoldGroup_iff.symm

/-- The orbit labelling `θ` of the `E₆` folding: `θ(0) = {5}`, `θ(1) = {2}`, `θ(2) = {1, 3}`,
`θ(3) = {0, 4}`, all four orbits being mutable. -/
@[cluster_algebras "def_fg_E6_lifts"]
noncomputable def e₆OrbitLabelling : OrbitLabelling E₆FoldGroup 6 6 4 4 :=
  TypeBC.orbitLabellingOfReps ![5, 2, 1, 0] (by decide) (by decide)

/-- The orbits of the labelling `θ` of the `E₆` folding. -/
@[cluster_algebras "def_fg_E6_lifts"]
theorem e₆OrbitLabelling_orbit :
    e₆OrbitLabelling.orbit 0 = {5} ∧ e₆OrbitLabelling.orbit 1 = {2} ∧
      e₆OrbitLabelling.orbit 2 = {1, 3} ∧ e₆OrbitLabelling.orbit 3 = {0, 4} := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> ext i <;>
    simp only [e₆OrbitLabelling, TypeBC.mem_orbit_orbitLabellingOfReps,
      mem_orbit_e₆FoldGroup_iff] <;>
    revert i <;> decide

/-- **The `E₆` lifts.** For `ε ∈ {1, -1}³`, the `6 × 6` integer matrix `Q_ε` with
`q₅₂ = ε₁`, `q₂₅ = -ε₁`, `q₂₁ = q₂₃ = ε₂`, `q₁₂ = q₃₂ = -ε₂`, `q₁₀ = q₃₄ = ε₃`,
`q₀₁ = q₄₃ = -ε₃` and all other entries `0`, indices running over `Fin 6`. -/
@[cluster_algebras "def_fg_E6_lifts"]
def matrixE₆Lift (ε : Fin 3 → ℤˣ) : Matrix (Fin 6) (Fin 6) ℤ :=
  !![0, -(ε 2 : ℤ), 0, 0, 0, 0;
    (ε 2 : ℤ), 0, -(ε 1 : ℤ), 0, 0, 0;
    0, (ε 1 : ℤ), 0, (ε 1 : ℤ), 0, -(ε 0 : ℤ);
    0, 0, -(ε 1 : ℤ), 0, (ε 2 : ℤ), 0;
    0, 0, 0, -(ε 2 : ℤ), 0, 0;
    0, 0, (ε 0 : ℤ), 0, 0, 0]

/-- **The `E₆` lifts fold to the `F₄` matrices**: `Q_ε` is skew-symmetric. -/
@[cluster_algebras "lem_fg_E6_lifts"]
theorem matrixE₆Lift_skew (ε : Fin 3 → ℤˣ) (i j : Fin 6) :
    matrixE₆Lift ε i j = -matrixE₆Lift ε j i := by
  fin_cases i <;> fin_cases j <;> simp [matrixE₆Lift]

/-- **The `E₆` lifts fold to the `F₄` matrices**: `A(Q_ε) = C(E₆)`. -/
@[cluster_algebras "lem_fg_E6_lifts"]
theorem cartanCounterpart_matrixE₆Lift (ε : Fin 3 → ℤˣ) :
    cartanCounterpart (matrixE₆Lift ε) = cartanE 6 := by
  have key : ∀ a b c : ℤˣ, cartanCounterpart (matrixE₆Lift ![a, b, c]) = cartanE 6 := by
    decide
  exact FinVec.etaExpand_eq ε ▸ key (ε 0) (ε 1) (ε 2)

/-- **The `E₆` lifts fold to the `F₄` matrices**: `Q_ε` is `G`-admissible. -/
@[cluster_algebras "lem_fg_E6_lifts"]
theorem isGroupAdmissible_matrixE₆Lift (ε : Fin 3 → ℤˣ) :
    IsGroupAdmissible E₆FoldGroup le_rfl (matrixE₆Lift ε) := by
  have key : ∀ a b c : ℤˣ, IsGroupAdmissible E₆FoldGroup le_rfl (matrixE₆Lift ![a, b, c]) := by
    intro a b c
    refine ⟨?_, ?_, ?_⟩ <;> revert a b c <;> decide
  exact FinVec.etaExpand_eq ε ▸ key (ε 0) (ε 1) (ε 2)

/-- **The `E₆` lifts fold to the `F₄` matrices**: `Q_εᴳ = P_ε` for the orbit labelling `θ`. -/
@[cluster_algebras "lem_fg_E6_lifts"]
theorem foldedMatrix_matrixE₆Lift (ε : Fin 3 → ℤˣ) :
    foldedMatrix e₆OrbitLabelling (matrixE₆Lift ε) = matrixF₄ ε := by
  obtain ⟨h0, h1, h2, h3⟩ := e₆OrbitLabelling_orbit
  have hrep : ∀ (p : Fin 4) (s : Finset (Fin 6)) (hs : s.Nonempty), e₆OrbitLabelling.orbit p = s →
      e₆OrbitLabelling.rep p = s.min' hs := by
    rintro p s hs rfl
    rfl
  have c0 : e₆OrbitLabelling.colRep 0 = 5 := Fin.ext (congrArg Fin.val (hrep 0 _ (by simp) h0))
  have c1 : e₆OrbitLabelling.colRep 1 = 2 := Fin.ext (congrArg Fin.val (hrep 1 _ (by simp) h1))
  have c2 : e₆OrbitLabelling.colRep 2 = 1 := Fin.ext (congrArg Fin.val (hrep 2 _ (by simp) h2))
  have c3 : e₆OrbitLabelling.colRep 3 = 0 := Fin.ext (congrArg Fin.val (hrep 3 _ (by simp) h3))
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [foldedMatrix_apply, h0, h1, h2, h3, c0, c1, c2, c3, matrixE₆Lift, matrixF₄, two_mul]

end TypeFG

end ClusterAlgebras
