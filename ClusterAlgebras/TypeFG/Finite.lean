module

public import ClusterAlgebras.TypeD.Reduction
public import ClusterAlgebras.TypeE.Finite
public import ClusterAlgebras.TypeFG.External

/-!
# Seed patterns of types `F₄` and `G₂` are of finite type

Type `F₄` is of finite type by folding the `E₆` lifts `Q_ε`; type `G₂` by folding a quiver of
type `D₄` along `ℤ/3ℤ` (Fomin–Williams–Zelevinsky, Section 5.7).

## Main definitions

* `ClusterAlgebras.TypeFG.matrixG₂ ε`: the matrix `R_ε`, `ε ∈ {1, -1}`.
* `ClusterAlgebras.TypeFG.D₄FoldGroup`: the group `ℤ/3ℤ`, acting on `Fin 4` through the
  rotation `ClusterAlgebras.TypeFG.d₄Rotation` of the three leaves of `D₄`.
* `ClusterAlgebras.TypeFG.d₄OrbitLabelling`: the orbit labelling `θ`.
* `ClusterAlgebras.TypeFG.matrixD₄Lift ε`: the lift `U_ε`.

## Main statements

* `ClusterAlgebras.IsSeedPattern.isFiniteType_of_isPatternOfType_F₄`: every seed pattern of
  type `F₄` is of finite type.
* `ClusterAlgebras.TypeFG.isGloballyFoldable_matrixD₄Lift`: the `D₄` lifts are globally
  foldable.
* `ClusterAlgebras.IsSeedPattern.isFiniteType_of_isPatternOfType_G₂`: every seed pattern of
  type `G₂` is of finite type.

## Implementation notes

* Indices are `Fin`, so the vertex `i` of FWZ is `i - 1` here. FWZ's generator
  `1 ↦ 3 ↦ 4 ↦ 1`, `2` fixed, is `0 ↦ 2 ↦ 3 ↦ 0`, `1` fixed; the orbits `θ(1) = {1, 3, 4}`,
  `θ(2) = {2}` are `θ(0) = {0, 2, 3}`, `θ(1) = {1}`; the centre of the tree `D₄` is `1`.
* As for `E₆`, the group generated by the rotation is modelled by a type synonym of
  `Multiplicative (ZMod 3)` whose generator acts by the rotation, and a sign `ε ∈ {1, -1}` is a
  unit `ε : ℤˣ`.
* Seed patterns of type `F₄` (resp. `G₂`) are stated for patterns of rank `4` (resp. `2`): a
  pattern of type `[X]` has rank `X.rank` (`IsOfDynkinType` provides an equivalence of the
  index types).
-/

@[expose] public section

namespace ClusterAlgebras

open Matrix MulAction

variable {K : Type*} [Field K] {F : Type*} [Field F] [Algebra K F] {m : ℕ}

/-! ### Patterns of a given type, relabelled -/

/-- The entries of `C([X])`, read through the inclusion `Fin X.rank → Fin (X.rank + 0)`, are
those of `C(X)`. -/
private theorem listCartan_singleton_castAdd (X : DynkinSymbol) (i j : Fin X.rank) :
    DynkinSymbol.listCartan [X] (Fin.castAdd (DynkinSymbol.listRank []) i)
      (Fin.castAdd (DynkinSymbol.listRank []) j) = X.cartan i j := by
  simp only [DynkinSymbol.listCartan, reindex_apply, submatrix_apply,
    finSumFinEquiv_symm_apply_castAdd, fromBlocks_apply₁₁]

/-- `C(X)` is of type `[X]`. -/
private theorem isOfDynkinType_cartan_singleton (X : DynkinSymbol) :
    IsOfDynkinType X.cartan [X] :=
  ⟨finCongr (add_zero _).symm, fun i j => (listCartan_singleton_castAdd X i j).symm⟩

/-- A matrix of type `[X]` is a simultaneous permutation of `C(X)`. -/
private theorem IsOfDynkinType.exists_submatrix_eq_cartan {X : DynkinSymbol}
    {A : Matrix (Fin X.rank) (Fin X.rank) ℤ} (hA : IsOfDynkinType A [X]) :
    ∃ τ : Equiv.Perm (Fin X.rank), A.submatrix τ τ = X.cartan := by
  obtain ⟨σ, hσ⟩ := hA
  refine ⟨(σ.trans (finCongr (add_zero _))).symm, ?_⟩
  ext i j
  rw [submatrix_apply, hσ, ← listCartan_singleton_castAdd]
  congr 1 <;> exact Fin.ext (by simp)

/-- A seed pattern `P` of type `[X]` has a relabelling `P'` that is again a seed pattern, is of
finite type only if `P` is, and has at some vertex a skew-symmetrizable principal part whose
Cartan counterpart is exactly `C(X)`. -/
private theorem IsSeedPattern.exists_relabel_cartanCounterpart_eq [CharZero K]
    {X : DynkinSymbol} (hmn : X.rank ≤ m) {P : RegularTree X.rank → SeedData F m X.rank}
    (hP : IsSeedPattern K hmn P) (hX : IsPatternOfType hmn P [X]) :
    ∃ P' : RegularTree X.rank → SeedData F m X.rank, IsSeedPattern K hmn P' ∧
      (IsFiniteType P' → IsFiniteType P) ∧ ∃ t,
        SkewSymmetrizable (principalPart hmn (P' t).extExchangeMatrix) ∧
        cartanCounterpart (principalPart hmn (P' t).extExchangeMatrix) = X.cartan := by
  obtain ⟨t, hA⟩ := hX
  obtain ⟨τ, hτ⟩ := hA.exists_submatrix_eq_cartan
  obtain ⟨P', hP', hP't⟩ := hP.exists_apply_eq_relabel hmn t τ
  refine ⟨P', hP', (hP.range_eq_of_apply_eq_relabel hmn hP' hP't).2.2.2.1, t, (hP'.1 t).2, ?_⟩
  rw [hP't, SeedData.relabel_extExchangeMatrix, principalPart_relabelMatrix,
    cartanCounterpart_relabelMatrix, relabelMatrix_self, hτ]

/-! ### Type `F₄` -/

/-- **Seed patterns of type `F₄` are of finite type.** -/
@[cluster_algebras "thm_type_F4_finite"]
theorem IsSeedPattern.isFiniteType_of_isPatternOfType_F₄ [CharZero K] (hmn : 4 ≤ m)
    {P : RegularTree 4 → SeedData F m 4} (hP : IsSeedPattern K hmn P)
    (hX : IsPatternOfType hmn P [.F₄]) : IsFiniteType P := by
  obtain ⟨P', hP', hfin, t, hskew, hA⟩ :=
    hP.exists_relabel_cartanCounterpart_eq (X := .F₄) hmn hX
  refine hfin ?_
  obtain ⟨ε, hε, -⟩ := TypeFG.exists_eq_matrixF₄ hskew hA
  refine hP'.isFiniteType_of_principalPart_eq_foldedMatrix TypeFG.e₆OrbitLabelling
    (TypeFG.matrixE₆Lift_skew ε) (TypeFG.isGloballyFoldable_matrixE₆Lift ε) ?_ hmn
    (t₁ := t) (hε.trans (TypeFG.foldedMatrix_matrixE₆Lift ε).symm)
  intro F' _ _ m' hm' Q hQ ⟨t', ht'⟩
  refine hQ.isFiniteType_of_isPatternOfType_E ⟨le_rfl, by norm_num⟩ hm' ⟨t', ?_⟩
  rw [ht', TypeFG.cartanCounterpart_matrixE₆Lift]
  exact isOfDynkinType_cartan_singleton (.E 6 ⟨le_rfl, by norm_num⟩)

namespace TypeFG

/-! ### The `G₂` matrices and their `D₄` lifts -/

/-- **The `G₂` matrices.** For `ε ∈ {1, -1}`, the `2 × 2` matrix `R_ε` with `r₀₁ = 3ε`,
`r₁₀ = -ε` and `r₀₀ = r₁₁ = 0`. -/
@[cluster_algebras "def_fg_G2_D4"]
def matrixG₂ (ε : ℤˣ) : Matrix (Fin 2) (Fin 2) ℤ :=
  !![0, 3 * (ε : ℤ);
    -(ε : ℤ), 0]

/-- The rotation `g` of `Fin 4` with `0 ↦ 2 ↦ 3 ↦ 0`, fixing the centre `1` of `D₄`. -/
@[cluster_algebras "def_fg_G2_D4"]
def d₄Rotation : Fin 4 → Fin 4 :=
  ![2, 1, 3, 0]

/-- The group `ℤ/3ℤ`, written multiplicatively, acting on `Fin 4` through the rotation `g`
(`ClusterAlgebras.TypeFG.instMulActionD₄FoldGroup`). -/
@[cluster_algebras "def_fg_G2_D4"]
def D₄FoldGroup : Type :=
  Multiplicative (ZMod 3)

/-- `D₄FoldGroup` is the group `Multiplicative (ZMod 3)`. -/
instance instGroupD₄FoldGroup : Group D₄FoldGroup :=
  inferInstanceAs (Group (Multiplicative (ZMod 3)))

/-- `D₄FoldGroup` is finite, with three elements. -/
instance instFintypeD₄FoldGroup : Fintype D₄FoldGroup :=
  inferInstanceAs (Fintype (Multiplicative (ZMod 3)))

/-- `D₄FoldGroup` has decidable equality. -/
instance instDecidableEqD₄FoldGroup : DecidableEq D₄FoldGroup :=
  inferInstanceAs (DecidableEq (Multiplicative (ZMod 3)))

/-- The action of `ℤ/3ℤ` on `Fin 4`: the class of `a` acts by `gᵃ`. All indices are mutable
(`m = n = 4`). -/
@[cluster_algebras "def_fg_G2_D4"]
instance instMulActionD₄FoldGroup : MulAction D₄FoldGroup (Fin 4) where
  smul g i := d₄Rotation^[(Multiplicative.toAdd (g : Multiplicative (ZMod 3))).val] i
  one_smul := by decide
  mul_smul := by decide

/-- The class of `a` acts on `Fin 4` by `gᵃ`. -/
theorem d₄FoldGroup_smul_def (g : D₄FoldGroup) (i : Fin 4) :
    g • i = d₄Rotation^[(Multiplicative.toAdd (g : Multiplicative (ZMod 3))).val] i :=
  rfl

/-- `i'` lies in the orbit of `i` iff it is `i`, `g i` or `g (g i)`. -/
@[cluster_algebras "def_fg_G2_D4"]
theorem mem_orbit_d₄FoldGroup_iff {i i' : Fin 4} :
    i' ∈ orbit D₄FoldGroup i ↔ i' = i ∨ i' = d₄Rotation i ∨ i' = d₄Rotation (d₄Rotation i) := by
  rw [mem_orbit_iff]
  revert i i'
  decide

/-- Membership in an orbit of `D₄FoldGroup` is decidable. -/
instance instDecidableMemOrbitD₄FoldGroup (i i' : Fin 4) :
    Decidable (i' ∈ orbit D₄FoldGroup i) :=
  decidable_of_iff _ mem_orbit_d₄FoldGroup_iff.symm

/-- The orbit labelling `θ` of the `D₄` folding: `θ(0) = {0, 2, 3}`, `θ(1) = {1}`, both orbits
being mutable. -/
@[cluster_algebras "def_fg_G2_D4"]
noncomputable def d₄OrbitLabelling : OrbitLabelling D₄FoldGroup 4 4 2 2 :=
  TypeBC.orbitLabellingOfReps ![0, 1] (by decide) (by decide)

/-- The orbits of the labelling `θ` of the `D₄` folding. -/
@[cluster_algebras "def_fg_G2_D4"]
theorem d₄OrbitLabelling_orbit :
    d₄OrbitLabelling.orbit 0 = {0, 2, 3} ∧ d₄OrbitLabelling.orbit 1 = {1} := by
  constructor <;>
  · ext i
    rw [d₄OrbitLabelling, TypeBC.mem_orbit_orbitLabellingOfReps, mem_orbit_d₄FoldGroup_iff]
    revert i
    decide

/-- The least element of `θ(0) = {0, 2, 3}` is `0`. -/
private theorem typeG2_colRep_zero : d₄OrbitLabelling.colRep 0 = 0 := by
  have h : d₄OrbitLabelling.rep 0 = 0 :=
    le_antisymm (d₄OrbitLabelling.rep_le (by rw [d₄OrbitLabelling_orbit.1]; decide))
      (Fin.zero_le _)
  exact Fin.ext (congrArg Fin.val h)

/-- The least element of `θ(1) = {1}` is `1`. -/
private theorem typeG2_colRep_one : d₄OrbitLabelling.colRep 1 = 1 := by
  have h := d₄OrbitLabelling.rep_mem 1
  rw [d₄OrbitLabelling_orbit.2, Finset.mem_singleton] at h
  exact Fin.ext (congrArg Fin.val h)

/-- The columns of the orbit `θ(0)`. -/
private theorem typeG2_cols_zero : d₄OrbitLabelling.cols le_rfl 0 = {0, 2, 3} := by
  ext j
  rw [OrbitLabelling.mem_cols]
  exact Finset.ext_iff.1 d₄OrbitLabelling_orbit.1 j

/-- The columns of the orbit `θ(1)`. -/
private theorem typeG2_cols_one : d₄OrbitLabelling.cols le_rfl 1 = {1} := by
  ext j
  rw [OrbitLabelling.mem_cols]
  exact Finset.ext_iff.1 d₄OrbitLabelling_orbit.2 j

/-- The increasing sequence of `{0, 2, 3}`. -/
private theorem typeG2_increasingSeq_zero :
    increasingSeq ({0, 2, 3} : Finset (Fin 4)) = [0, 2, 3] := by
  rw [increasingSeq, Finset.sort_insert _ (by decide) (by decide),
    Finset.sort_insert _ (by decide) (by decide), Finset.sort_singleton]

/-- **The `D₄` lifts.** For `ε ∈ {1, -1}`, the `4 × 4` integer matrix `U_ε` with `u_{i1} = ε`
and `u_{1i} = -ε` for `i ∈ {0, 2, 3}` and all other entries `0`. -/
@[cluster_algebras "def_fg_G2_D4"]
def matrixD₄Lift (ε : ℤˣ) : Matrix (Fin 4) (Fin 4) ℤ :=
  !![0, (ε : ℤ), 0, 0;
    -(ε : ℤ), 0, -(ε : ℤ), -(ε : ℤ);
    0, (ε : ℤ), 0, 0;
    0, (ε : ℤ), 0, 0]

/-- **The `G₂` matrices and the foldability of their lifts**, (a): `(1, 3)` is a
skew-symmetrizing vector of `R_ε`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem isSkewSymmetrizingVector_matrixG₂ (ε : ℤˣ) :
    IsSkewSymmetrizingVector (matrixG₂ ε) ![1, 3] := by
  obtain rfl | rfl := Int.units_eq_one_or ε <;>
  · refine ⟨by decide, ?_⟩
    simp only [Int.cast_id]
    decide

/-- **The `G₂` matrices and the foldability of their lifts**, (a): `R_ε` is
skew-symmetrizable. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem skewSymmetrizable_matrixG₂ (ε : ℤˣ) : SkewSymmetrizable (matrixG₂ ε) :=
  ⟨_, isSkewSymmetrizingVector_matrixG₂ ε⟩

/-- **The `G₂` matrices and the foldability of their lifts**, (a): `A(R_ε) = C(G₂)`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem cartanCounterpart_matrixG₂ (ε : ℤˣ) : cartanCounterpart (matrixG₂ ε) = cartanG₂ := by
  obtain rfl | rfl := Int.units_eq_one_or ε <;>
  · ext i j
    revert i j
    decide

/-- **The `G₂` matrices and the foldability of their lifts**, (a): every skew-symmetrizable
`2 × 2` integer matrix `P` with `A(P) = C(G₂)` is `R_ε` with `ε = sgn p₁₂`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem exists_eq_matrixG₂ {P : Matrix (Fin 2) (Fin 2) ℤ} (hP : SkewSymmetrizable P)
    (hA : cartanCounterpart P = cartanG₂) :
    ∃ ε : ℤˣ, P = matrixG₂ ε ∧ (ε : ℤ) = (P 0 1).sign := by
  obtain ⟨d, hd0, hd⟩ := hP
  have h00 := hd 0 0
  have h11 := hd 1 1
  have h01 := hd 0 1
  simp only [Int.cast_id] at h00 h11 h01
  have hp01 : |P 0 1| = 3 := by
    simpa [cartanCounterpart, cartanG₂] using congrFun (congrFun hA 0) 1
  have hp10 : |P 1 0| = 1 := by
    simpa [cartanCounterpart, cartanG₂, cartanA] using congrFun (congrFun hA 1) 0
  have hz0 : P 0 0 = 0 :=
    (mul_eq_zero.1 (by linarith : d 0 * P 0 0 = 0)).resolve_left (hd0 0).ne'
  have hz1 : P 1 1 = 0 :=
    (mul_eq_zero.1 (by linarith : d 1 * P 1 1 = 0)).resolve_left (hd0 1).ne'
  have hd0' := hd0 0
  have hd1' := hd0 1
  rcases (abs_eq (by norm_num)).1 hp01 with h | h <;>
    rcases (abs_eq (by norm_num)).1 hp10 with h' | h' <;> rw [h, h'] at h01
  · omega
  · refine ⟨1, ?_, by rw [h]; rfl⟩
    ext i j
    fin_cases i <;> fin_cases j <;> simp [matrixG₂, h, h', hz0, hz1]
  · refine ⟨-1, ?_, by rw [h]; rfl⟩
    ext i j
    fin_cases i <;> fin_cases j <;> simp [matrixG₂, h, h', hz0, hz1]
  · omega

/-- **The `G₂` matrices and the foldability of their lifts**, (b): `U_ε` is skew-symmetric. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem matrixD₄Lift_skew (ε : ℤˣ) (i j : Fin 4) :
    matrixD₄Lift ε i j = -matrixD₄Lift ε j i := by
  obtain rfl | rfl := Int.units_eq_one_or ε <;> revert i j <;> decide

/-- **The `G₂` matrices and the foldability of their lifts**, (b): `A(U_ε) = C(D₄)`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem cartanCounterpart_matrixD₄Lift (ε : ℤˣ) :
    cartanCounterpart (matrixD₄Lift ε) = cartanD 4 := by
  obtain rfl | rfl := Int.units_eq_one_or ε <;>
  · ext i j
    revert i j
    decide

/-- **The `G₂` matrices and the foldability of their lifts**, (b): `U_ε` is `G`-admissible. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem isGroupAdmissible_matrixD₄Lift (ε : ℤˣ) :
    IsGroupAdmissible D₄FoldGroup le_rfl (matrixD₄Lift ε) := by
  obtain rfl | rfl := Int.units_eq_one_or ε <;>
  · constructor <;> decide

/-- **The `G₂` matrices and the foldability of their lifts**, (b): `U_εᴳ = R_ε` for the orbit
labelling `θ`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem foldedMatrix_matrixD₄Lift (ε : ℤˣ) :
    foldedMatrix d₄OrbitLabelling (matrixD₄Lift ε) = matrixG₂ ε := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [foldedMatrix_apply, d₄OrbitLabelling_orbit.1, d₄OrbitLabelling_orbit.2,
      typeG2_colRep_zero, typeG2_colRep_one, matrixD₄Lift, matrixG₂]
  ring

/-- **The `G₂` matrices and the foldability of their lifts**, (c): `μ_{s_K}(U_ε) = U_{-ε}` for
both orbits `K = θ(r)`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem matrixMutationList_matrixD₄Lift (ε : ℤˣ) (r : Fin 2) :
    matrixMutationList le_rfl (matrixD₄Lift ε) (increasingSeq (d₄OrbitLabelling.cols le_rfl r)) =
      matrixD₄Lift (-ε) := by
  fin_cases r
  · rw [show (⟨0, by decide⟩ : Fin 2) = 0 from rfl, typeG2_cols_zero, typeG2_increasingSeq_zero]
    obtain rfl | rfl := Int.units_eq_one_or ε <;>
    · ext i j
      revert i j
      decide
  · rw [show (⟨1, by decide⟩ : Fin 2) = 1 from rfl, typeG2_cols_one, increasingSeq,
      Finset.sort_singleton]
    obtain rfl | rfl := Int.units_eq_one_or ε <;>
    · ext i j
      revert i j
      decide

/-- **The `G₂` matrices and the foldability of their lifts**, (c): `U_ε` is globally foldable
for `θ`. -/
@[cluster_algebras "lem_fg_G2_D4"]
theorem isGloballyFoldable_matrixD₄Lift (ε : ℤˣ) :
    IsGloballyFoldable d₄OrbitLabelling le_rfl (matrixD₄Lift ε) := by
  refine ⟨isGroupAdmissible_matrixD₄Lift ε, fun ρ => ?_⟩
  induction ρ generalizing ε with
  | nil => exact isGroupAdmissible_matrixD₄Lift ε
  | cons r ρ ih =>
    rw [orbitSeq, List.flatMap_cons, matrixMutationList_append, matrixMutationList_matrixD₄Lift]
    exact ih (-ε)

end TypeFG

/-! ### Type `G₂` -/

/-- **Seed patterns of type `G₂` are of finite type.** -/
@[cluster_algebras "thm_type_G2_finite"]
theorem IsSeedPattern.isFiniteType_of_isPatternOfType_G₂ [CharZero K] (hmn : 2 ≤ m)
    {P : RegularTree 2 → SeedData F m 2} (hP : IsSeedPattern K hmn P)
    (hX : IsPatternOfType hmn P [.G₂]) : IsFiniteType P := by
  obtain ⟨P', hP', hfin, t, hskew, hA⟩ :=
    hP.exists_relabel_cartanCounterpart_eq (X := .G₂) hmn hX
  refine hfin ?_
  obtain ⟨ε, hε, -⟩ := TypeFG.exists_eq_matrixG₂ hskew hA
  refine hP'.isFiniteType_of_principalPart_eq_foldedMatrix TypeFG.d₄OrbitLabelling
    (TypeFG.matrixD₄Lift_skew ε) (TypeFG.isGloballyFoldable_matrixD₄Lift ε) ?_ hmn
    (t₁ := t) (hε.trans (TypeFG.foldedMatrix_matrixD₄Lift ε).symm)
  intro F' _ _ m' hm' Q hQ ⟨t', ht'⟩
  refine hQ.isFiniteType_of_isPatternOfType_D le_rfl hm' ⟨t', ?_⟩
  rw [ht', TypeFG.cartanCounterpart_matrixD₄Lift]
  exact isOfDynkinType_cartan_singleton (.D 4 le_rfl)

end ClusterAlgebras
