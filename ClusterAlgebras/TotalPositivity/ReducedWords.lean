module

public import ClusterAlgebras.WiringDiagram.Word

/-!
# Reduced words in the symmetric group and the theorem of Matsumoto and Tits

The symmetric group on `m + 2` points is generated by the adjacent transpositions
`s_i = gapSwap i`, and the length of a permutation `v` in these generators is its inversion
number `inv(v)`, the number of pairs of positions `ℓ < ℓ'` with `v ℓ' < v ℓ`. Multiplying `v` on
the right by `s_i` changes `inv(v)` by exactly one, up at an ascent `v i < v (i + 1)` and down at
a descent. Hence a word of length `k` has a product with at most `k` inversions, every
permutation has a *reduced word* (one of length `inv(v)`), and the last letter of a reduced word
is a descent.

The theorem of Matsumoto and Tits for the symmetric group says that any two reduced words for
the same permutation are connected by a chain of elementary moves: commutations `g h ↦ h g` with
`|g - h| ≥ 2` and braid moves `g h g ↦ h g h` with `|g - h| = 1`. The proof is by induction on
`inv(v)`. Two reduced words with the same last letter `i` are connected because their prefixes
are reduced words for `v s_i`. If the last letters `i ≠ j` differ, both are descents of `v`, and
one builds reduced words `c j i` and `c i j` (if `|i - j| ≥ 2`) or `c e f e` and `c f e f`
(if `{i, j} = {e, f}` with `e + 1 = f`) for `v`, which differ by a single move and end in `i` and
in `j`.

## Main definitions

* `ClusterAlgebras.inversionNumber`: the inversion number of a permutation.
* `ClusterAlgebras.IsReducedWord`: a reduced word for a permutation.
* `ClusterAlgebras.IsWordMove`: one word is obtained from another by an elementary move.

## Main results

* `ClusterAlgebras.inversionNumber_mul_gapSwap_of_lt`,
  `ClusterAlgebras.inversionNumber_mul_gapSwap_of_gt`: `inv(v s_i) = inv(v) ± 1`.
* `ClusterAlgebras.inversionNumber_prod_le`: `inv(s_{i₁} ⋯ s_{iₖ}) ≤ k`.
* `ClusterAlgebras.exists_isReducedWord`: every permutation has a reduced word.
* `ClusterAlgebras.IsReducedWord.lt_of_concat`, `ClusterAlgebras.IsReducedWord.of_concat`: the
  last letter of a reduced word is a descent, and deleting it leaves a reduced word.
* `ClusterAlgebras.IsWordMove.prod_eq`: elementary moves preserve the product.
* `ClusterAlgebras.IsReducedWord.reflTransGen_isWordMove`: the theorem of Matsumoto and Tits for
  the symmetric group.

## Implementation notes

Positions and letters are `0`-based: permutations act on `Fin (m + 2)`, letters are
`Fin (m + 1)`, and FWZ's `s_i` exchanging `i` and `i + 1` is `gapSwap i`, exchanging
`i.castSucc` and `i.succ`; so FWZ's descent `v(i) > v(i + 1)` is
`v i.succ < v i.castSucc`. Restricting to `m + 2 ≥ 2` points loses nothing, since for fewer
points there are no letters. Words are lists, multiplied left to right as
`(w.map gapSwap).prod`. An elementary move is phrased by a common prefix `l` and suffix `r`
rather than by a position `p`; the position is `l.length`. A chain of moves is
`Relation.ReflTransGen IsWordMove`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 1.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset

/-! ### The inversion number -/

/-- The **inversion number** `inv(v)` of a permutation `v` of `Fin m`: the number of pairs of
positions `ℓ < ℓ'` with `v ℓ' < v ℓ`. -/
@[cluster_algebras "def_inversion_number"]
def inversionNumber {m : ℕ} (v : Equiv.Perm (Fin m)) : ℕ :=
  #{p : Fin m × Fin m | p.1 < p.2 ∧ v p.2 < v p.1}

variable {m : ℕ}

/-- The identity has no inversion. -/
@[simp]
theorem inversionNumber_one : inversionNumber (1 : Equiv.Perm (Fin m)) = 0 := by
  rw [inversionNumber, card_eq_zero, filter_eq_empty_iff]
  rintro p - ⟨h1, h2⟩
  exact lt_asymm h1 h2

/-- There are `m.choose 2` pairs of positions `a < b` in `Fin m`. -/
theorem card_filter_fst_lt_snd (m : ℕ) : #{p : Fin m × Fin m | p.1 < p.2} = m.choose 2 := by
  have h := Sym2.card_subtype_not_diag (α := Fin m)
  rw [Fintype.card_fin] at h
  rw [← h, ← Finset.card_univ]
  refine Finset.card_bij (fun p hp => ⟨s(p.1, p.2), ?_⟩) (fun _ _ => Finset.mem_univ _) ?_ ?_
  · simp only [mem_filter, mem_univ, true_and] at hp
    simpa [Sym2.mk_isDiag_iff] using hp.ne
  · rintro ⟨a, b⟩ hab ⟨c, d⟩ hcd h
    simp only [mem_filter, mem_univ, true_and] at hab hcd
    simp only [Subtype.mk.injEq, Sym2.eq_iff] at h
    rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · rfl
    · exact absurd (hab.trans hcd) (lt_irrefl _)
  · rintro ⟨e, he⟩ -
    induction e using Sym2.ind with | _ v w => ?_
    have hvw : v ≠ w := by simpa [Sym2.mk_isDiag_iff] using he
    rcases lt_or_gt_of_ne hvw with hlt | hlt
    · exact ⟨(v, w), by simpa using hlt, rfl⟩
    · exact ⟨(w, v), by simpa using hlt, Subtype.ext Sym2.eq_swap⟩

/-- **The longest permutation inverts every pair**, so `inv(w₀) = m.choose 2`. -/
theorem inversionNumber_revPerm (m : ℕ) :
    inversionNumber (Fin.revPerm : Equiv.Perm (Fin m)) = m.choose 2 := by
  rw [inversionNumber, ← card_filter_fst_lt_snd]
  congr 1
  ext p
  simp [Fin.rev_lt_rev]

/-- **No permutation has more inversions than `w₀`**: `inv(v) ≤ m.choose 2`. -/
theorem inversionNumber_le_choose (v : Equiv.Perm (Fin m)) : inversionNumber v ≤ m.choose 2 := by
  rw [inversionNumber, ← card_filter_fst_lt_snd]
  exact card_le_card fun p hp => by simp_all

/-- An adjacent transposition is an involution. -/
@[simp]
theorem gapSwap_mul_self (i : Fin (m + 1)) : gapSwap i * gapSwap i = 1 :=
  Equiv.swap_mul_self _ _

/-- An adjacent transposition is an involution, in the form used after reassociating. -/
@[simp]
theorem gapSwap_mul_gapSwap_mul (i : Fin (m + 1)) (u : Equiv.Perm (Fin (m + 2))) :
    gapSwap i * (gapSwap i * u) = u := by
  rw [← mul_assoc, gapSwap_mul_self, one_mul]

/-- Multiplying twice on the right by `s_i` changes nothing. -/
@[simp]
theorem mul_gapSwap_mul_gapSwap (v : Equiv.Perm (Fin (m + 2))) (i : Fin (m + 1)) :
    v * gapSwap i * gapSwap i = v := by
  rw [mul_assoc, gapSwap_mul_self, mul_one]

/-- The two levels exchanged by `s_i` are distinct. -/
private theorem castSucc_ne_succ (i : Fin (m + 1)) : (i.castSucc : Fin (m + 2)) ≠ i.succ :=
  Fin.castSucc_lt_succ.ne

/-- **A descent removes one inversion.** If `v` has a descent at `g`, then the pair `g, g + 1`
is an inversion of `v` but not of `v s_g`, and `s_g × s_g` matches the remaining inversions of
`v s_g` with those of `v`. -/
private theorem inversionNumber_eq_mul_gapSwap_add_one (v : Equiv.Perm (Fin (m + 2)))
    {g : Fin (m + 1)} (h : v g.succ < v g.castSucc) :
    inversionNumber v = inversionNumber (v * gapSwap g) + 1 := by
  set e := Equiv.prodCongr (gapSwap g) (gapSwap g) with he
  have hsymm : (gapSwap g).symm = gapSwap g := Equiv.symm_swap _ _
  have hss : ∀ x, gapSwap g (gapSwap g x) = x := fun x => Equiv.swap_apply_self _ _ _
  have hcd : (g.castSucc : Fin (m + 2)) < g.succ := Fin.castSucc_lt_succ
  have key : ({p : Fin (m + 2) × Fin (m + 2) | p.1 < p.2 ∧ v p.2 < v p.1} : Finset _) =
      insert (g.castSucc, g.succ)
        (({p : Fin (m + 2) × Fin (m + 2) | p.1 < p.2 ∧ (v * gapSwap g) p.2 <
          (v * gapSwap g) p.1} : Finset _).map e.toEmbedding) := by
    ext ⟨a, b⟩
    rw [mem_insert, mem_map_equiv]
    simp only [mem_filter, mem_univ, true_and, he, Equiv.prodCongr_symm,
      Equiv.prodCongr_apply, Prod.map_apply, Prod.mk.injEq, Equiv.Perm.mul_apply, hsymm, hss]
    by_cases h1 : (a : ℕ) = g ∧ (b : ℕ) = g + 1
    · obtain rfl : a = g.castSucc := Fin.ext h1.1
      obtain rfl : b = g.succ := Fin.ext (by simp [h1.2])
      simp [h, hcd]
    by_cases h2 : (a : ℕ) = g + 1 ∧ (b : ℕ) = g
    · obtain rfl : a = g.succ := Fin.ext (by simp [h2.1])
      obtain rfl : b = g.castSucc := Fin.ext h2.2
      simp [h.not_gt, hcd.not_gt, hcd.ne']
    · rw [gapSwap_lt_iff h1 h2]
      have : ¬(a = g.castSucc ∧ b = g.succ) := fun ⟨ha, hb⟩ =>
        h1 ⟨by simp [ha], by simp [hb]⟩
      simp [this]
  rw [inversionNumber, inversionNumber, key, card_insert_of_notMem, card_map]
  rw [mem_map_equiv]
  simp [he, hsymm, hcd.not_gt]

/-- **Multiplying by `s_i` at an ascent adds one inversion.** -/
@[cluster_algebras "lem_inversion_number_ascent"]
theorem inversionNumber_mul_gapSwap_of_lt (v : Equiv.Perm (Fin (m + 2))) {i : Fin (m + 1)}
    (h : v i.castSucc < v i.succ) :
    inversionNumber (v * gapSwap i) = inversionNumber v + 1 := by
  have := inversionNumber_eq_mul_gapSwap_add_one (v * gapSwap i) (g := i) (by simpa using h)
  rwa [mul_gapSwap_mul_gapSwap] at this

/-- **Multiplying by `s_i` at a descent removes one inversion.** -/
@[cluster_algebras "lem_inversion_number_descent"]
theorem inversionNumber_mul_gapSwap_of_gt (v : Equiv.Perm (Fin (m + 2))) {i : Fin (m + 1)}
    (h : v i.succ < v i.castSucc) :
    inversionNumber (v * gapSwap i) + 1 = inversionNumber v := by
  have := inversionNumber_mul_gapSwap_of_lt (v * gapSwap i) (i := i) (by simpa using h)
  rwa [mul_gapSwap_mul_gapSwap, eq_comm] at this

/-- **A word of length `k` has a product with at most `k` inversions.** -/
@[cluster_algebras "lem_inversion_number_word_le"]
theorem inversionNumber_prod_le (w : List (Fin (m + 1))) :
    inversionNumber (w.map gapSwap).prod ≤ w.length := by
  induction w using List.reverseRecOn with
  | nil => simp
  | append_singleton w i ih =>
    rw [List.map_append, List.prod_append, List.map_singleton, List.prod_singleton,
      List.length_append, List.length_singleton]
    rcases (((w.map gapSwap).prod).injective.ne (castSucc_ne_succ i)).lt_or_gt with h | h
    · rw [inversionNumber_mul_gapSwap_of_lt _ h]
      omega
    · have := inversionNumber_mul_gapSwap_of_gt _ h
      omega

/-- A permutation other than the identity has a descent. -/
theorem exists_succ_lt_castSucc_of_ne_one {v : Equiv.Perm (Fin (m + 2))} (hv : v ≠ 1) :
    ∃ i : Fin (m + 1), v i.succ < v i.castSucc := by
  by_contra hcon
  push Not at hcon
  exact hv ((Equiv.Perm.monotone_iff v).1 (Fin.monotone_iff_le_succ.2 hcon))

/-! ### Reduced words -/

/-- A **reduced word** for a permutation `v` of `Fin (m + 2)`: a word `w` in the adjacent
transpositions `s_i = gapSwap i` whose product is `v` and whose length is `inv(v)`. -/
@[cluster_algebras "def_reduced_word"]
def IsReducedWord (v : Equiv.Perm (Fin (m + 2))) (w : List (Fin (m + 1))) : Prop :=
  (w.map gapSwap).prod = v ∧ w.length = inversionNumber v

/-- **Every permutation has a reduced word.** -/
@[cluster_algebras "lem_reduced_word_exists"]
theorem exists_isReducedWord (v : Equiv.Perm (Fin (m + 2))) : ∃ w, IsReducedWord v w := by
  induction h : inversionNumber v generalizing v with
  | zero =>
    refine ⟨[], ?_, by simp [h]⟩
    by_contra hne
    obtain ⟨g, hg⟩ := exists_succ_lt_castSucc_of_ne_one (v := v) (fun hv => hne (by simp [hv]))
    have := inversionNumber_mul_gapSwap_of_gt v hg
    omega
  | succ k ih =>
    have hne : v ≠ 1 := by
      rintro rfl
      simp at h
    obtain ⟨g, hg⟩ := exists_succ_lt_castSucc_of_ne_one hne
    have hk := inversionNumber_mul_gapSwap_of_gt v hg
    obtain ⟨w, hw⟩ := ih (v * gapSwap g) (by omega)
    refine ⟨w ++ [g], ?_, ?_⟩
    · simp [hw.1]
    · rw [List.length_append, List.length_singleton, hw.2]
      omega

/-- **The last letter of a reduced word is a descent.** -/
@[cluster_algebras "lem_reduced_word_last_descent"]
theorem IsReducedWord.lt_of_concat {v : Equiv.Perm (Fin (m + 2))} {w : List (Fin (m + 1))}
    {i : Fin (m + 1)} (h : IsReducedWord v (w ++ [i])) : v i.succ < v i.castSucc := by
  obtain ⟨hprod, hlen⟩ := h
  have hu : (w.map gapSwap).prod = v * gapSwap i := by
    rw [← hprod]
    simp [mul_assoc]
  have hle := inversionNumber_prod_le w
  rw [hu] at hle
  refine ((v.injective.ne (castSucc_ne_succ i)).symm.lt_or_gt).resolve_right fun hlt => ?_
  have := inversionNumber_mul_gapSwap_of_lt v hlt
  rw [List.length_append, List.length_singleton] at hlen
  omega

/-- **Deleting the last letter of a reduced word** gives a reduced word for `v s_i`. -/
@[cluster_algebras "lem_reduced_word_prefix"]
theorem IsReducedWord.of_concat {v : Equiv.Perm (Fin (m + 2))} {w : List (Fin (m + 1))}
    {i : Fin (m + 1)} (h : IsReducedWord v (w ++ [i])) : IsReducedWord (v * gapSwap i) w := by
  refine ⟨?_, ?_⟩
  · rw [← h.1]
    simp [mul_assoc]
  · have h1 := inversionNumber_mul_gapSwap_of_gt v h.lt_of_concat
    have h2 := h.2
    rw [List.length_append, List.length_singleton] at h2
    omega

/-- **Two distant descents remove two inversions.** -/
@[cluster_algebras "lem_two_far_descents"]
theorem inversionNumber_mul_gapSwap_mul_gapSwap (v : Equiv.Perm (Fin (m + 2)))
    {i j : Fin (m + 1)} (hij : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i)
    (hi : v i.succ < v i.castSucc) (hj : v j.succ < v j.castSucc) :
    inversionNumber (v * gapSwap i * gapSwap j) + 2 = inversionNumber v := by
  have h1 : gapSwap i j.succ = j.succ := gapSwap_of_ne _
    (by simp only [Ne, Fin.ext_iff, Fin.val_succ, Fin.val_castSucc]; omega)
    (by simp only [Ne, Fin.ext_iff, Fin.val_succ]; omega)
  have h2 : gapSwap i j.castSucc = j.castSucc := gapSwap_of_ne _
    (by simp only [Ne, Fin.ext_iff, Fin.val_castSucc]; omega)
    (by simp only [Ne, Fin.ext_iff, Fin.val_succ, Fin.val_castSucc]; omega)
  have hw : (v * gapSwap i) j.succ < (v * gapSwap i) j.castSucc := by
    simpa [h1, h2] using hj
  have := inversionNumber_mul_gapSwap_of_gt v hi
  have := inversionNumber_mul_gapSwap_of_gt _ hw
  omega

/-- **Two adjacent descents remove three inversions** under `s_e s_{e+1} s_e`. -/
@[cluster_algebras "lem_two_adjacent_descents"]
theorem inversionNumber_mul_braid (v : Equiv.Perm (Fin (m + 2))) {e f : Fin (m + 1)}
    (hef : (e : ℕ) + 1 = f) (he : v e.succ < v e.castSucc) (hf : v f.succ < v f.castSucc) :
    inversionNumber (v * gapSwap e * gapSwap f * gapSwap e) + 3 = inversionNumber v := by
  have hb : e.succ = f.castSucc := Fin.ext (by simpa using hef)
  have hfe1 : f.succ ≠ e.castSucc := by
    simp only [Ne, Fin.ext_iff, Fin.val_succ, Fin.val_castSucc]
    omega
  have hfe2 : f.succ ≠ e.succ := by
    simp only [Ne, Fin.ext_iff, Fin.val_succ]
    omega
  have hef1 : e.castSucc ≠ f.castSucc := by
    simp only [Ne, Fin.ext_iff, Fin.val_castSucc]
    omega
  have hef2 : e.castSucc ≠ f.succ := hfe1.symm
  rw [hb] at he
  have h1 : (v * gapSwap e) f.succ < (v * gapSwap e) f.castSucc := by
    rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, ← hb, gapSwap_succ, gapSwap_of_ne _ hfe1 hfe2]
    exact hf.trans he
  have h2 : (v * gapSwap e * gapSwap f) e.succ < (v * gapSwap e * gapSwap f) e.castSucc := by
    simp only [Equiv.Perm.mul_apply]
    rw [gapSwap_of_ne _ hef1 hef2, gapSwap_castSucc, hb, gapSwap_castSucc,
      gapSwap_of_ne _ hfe1 hfe2]
    exact hf
  have := inversionNumber_mul_gapSwap_of_gt v (by rwa [hb])
  have := inversionNumber_mul_gapSwap_of_gt _ h1
  have := inversionNumber_mul_gapSwap_of_gt _ h2
  omega

/-! ### Elementary moves of words -/

/-- `b` is **obtained from `a` by an elementary move**: either a *commutation*, exchanging two
adjacent letters `g, h` with `|g - h| ≥ 2`, or a *braid move*, replacing three adjacent letters
`g, h, g` with `|g - h| = 1` by `h, g, h`; every other letter is unchanged. The position of the
move is the length of the common prefix `l`. -/
@[cluster_algebras "def_word_move"]
def IsWordMove (a b : List (Fin (m + 1))) : Prop :=
  (∃ (l r : List (Fin (m + 1))) (g h : Fin (m + 1)),
      ((g : ℕ) + 2 ≤ h ∨ (h : ℕ) + 2 ≤ g) ∧ a = l ++ [g, h] ++ r ∧ b = l ++ [h, g] ++ r) ∨
    ∃ (l r : List (Fin (m + 1))) (g h : Fin (m + 1)),
      ((g : ℕ) + 1 = h ∨ (h : ℕ) + 1 = g) ∧ a = l ++ [g, h, g] ++ r ∧ b = l ++ [h, g, h] ++ r

/-- **Elementary moves preserve the product.** -/
@[cluster_algebras "lem_word_move_preserves_product"]
theorem IsWordMove.prod_eq {a b : List (Fin (m + 1))} (h : IsWordMove a b) :
    (b.map gapSwap).prod = (a.map gapSwap).prod := by
  rcases h with ⟨l, r, g, k, hgk, rfl, rfl⟩ | ⟨l, r, g, k, hgk, rfl, rfl⟩
  · simp only [List.map_append, List.prod_append, List.map_cons, List.map_nil, List.prod_cons,
      List.prod_nil, mul_one]
    rw [gapSwap_comm (by omega)]
  · simp only [List.map_append, List.prod_append, List.map_cons, List.map_nil, List.prod_cons,
      List.prod_nil, mul_one]
    congr 2
    simp only [← mul_assoc]
    rcases hgk with hgk | hgk
    · exact (gapSwap_braid hgk).symm
    · exact gapSwap_braid hgk

/-- Elementary moves preserve the length of a word. -/
theorem IsWordMove.length_eq {a b : List (Fin (m + 1))} (h : IsWordMove a b) :
    b.length = a.length := by
  rcases h with ⟨l, r, g, k, -, rfl, rfl⟩ | ⟨l, r, g, k, -, rfl, rfl⟩ <;> simp

/-- An elementary move of `a` is an elementary move of `a ++ c`, the suffix being unchanged. -/
theorem IsWordMove.append_right {a b : List (Fin (m + 1))} (h : IsWordMove a b)
    (c : List (Fin (m + 1))) : IsWordMove (a ++ c) (b ++ c) := by
  rcases h with ⟨l, r, g, k, hgk, rfl, rfl⟩ | ⟨l, r, g, k, hgk, rfl, rfl⟩
  · exact Or.inl ⟨l, r ++ c, g, k, hgk, by simp, by simp⟩
  · exact Or.inr ⟨l, r ++ c, g, k, hgk, by simp, by simp⟩

/-- An elementary move takes a reduced word for `v` to a reduced word for `v`. -/
theorem IsReducedWord.of_isWordMove {v : Equiv.Perm (Fin (m + 2))} {a b : List (Fin (m + 1))}
    (ha : IsReducedWord v a) (h : IsWordMove a b) : IsReducedWord v b :=
  ⟨h.prod_eq.trans ha.1, h.length_eq.trans ha.2⟩

/-- **Two distinct descents give reduced words one move apart**: if `i ≠ j` are descents of `v`,
there are reduced words for `v` ending in `i` and in `j` that differ by an elementary move. -/
theorem exists_isWordMove_of_descents (v : Equiv.Perm (Fin (m + 2))) {i j : Fin (m + 1)}
    (hij : (i : ℕ) ≠ j) (hi : v i.succ < v i.castSucc) (hj : v j.succ < v j.castSucc) :
    ∃ x y, IsReducedWord v (x ++ [i]) ∧ IsReducedWord v (y ++ [j]) ∧
      IsWordMove (x ++ [i]) (y ++ [j]) := by
  rcases (show ((i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) ∨ (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i by
    omega) with h | h | h
  · obtain ⟨c, hc⟩ := exists_isReducedWord (v * gapSwap i * gapSwap j)
    have hn := inversionNumber_mul_gapSwap_mul_gapSwap v h hi hj
    have hx : IsReducedWord v (c ++ [j] ++ [i]) :=
      ⟨by simp [hc.1, mul_assoc], by simp [hc.2]; omega⟩
    have hxy : IsWordMove (c ++ [j] ++ [i]) (c ++ [i] ++ [j]) :=
      Or.inl ⟨c, [], j, i, by omega, by simp, by simp⟩
    exact ⟨c ++ [j], c ++ [i], hx, hx.of_isWordMove hxy, hxy⟩
  · obtain ⟨c, hc⟩ := exists_isReducedWord (v * gapSwap i * gapSwap j * gapSwap i)
    have hn := inversionNumber_mul_braid v h hi hj
    have hx : IsReducedWord v (c ++ [i, j] ++ [i]) :=
      ⟨by simp [hc.1, mul_assoc], by simp [hc.2]; omega⟩
    have hxy : IsWordMove (c ++ [i, j] ++ [i]) (c ++ [j, i] ++ [j]) :=
      Or.inr ⟨c, [], i, j, Or.inl h, by simp, by simp⟩
    exact ⟨c ++ [i, j], c ++ [j, i], hx, hx.of_isWordMove hxy, hxy⟩
  · obtain ⟨c, hc⟩ := exists_isReducedWord (v * gapSwap j * gapSwap i * gapSwap j)
    have hn := inversionNumber_mul_braid v h hj hi
    have hy : IsReducedWord v (c ++ [j, i] ++ [j]) :=
      ⟨by simp [hc.1, mul_assoc], by simp [hc.2]; omega⟩
    exact ⟨c ++ [i, j], c ++ [j, i],
      hy.of_isWordMove (Or.inr ⟨c, [], j, i, Or.inl h, by simp, by simp⟩), hy,
      Or.inr ⟨c, [], i, j, Or.inr h, by simp, by simp⟩⟩

/-- The theorem of Matsumoto and Tits, by induction on the inversion number `n`. -/
private theorem reflTransGen_isWordMove_of_inversionNumber_eq : ∀ (n : ℕ)
    {v : Equiv.Perm (Fin (m + 2))} {a b : List (Fin (m + 1))}, inversionNumber v = n →
    IsReducedWord v a → IsReducedWord v b → Relation.ReflTransGen IsWordMove a b
  | 0, v, a, b, hv, ha, hb => by
    obtain rfl : a = [] := List.length_eq_zero_iff.1 (ha.2.trans hv)
    obtain rfl : b = [] := List.length_eq_zero_iff.1 (hb.2.trans hv)
    exact .refl
  | n + 1, v, a, b, hv, ha, hb => by
    have step1 : ∀ {x y : List (Fin (m + 1))} {i : Fin (m + 1)}, IsReducedWord v (x ++ [i]) →
        IsReducedWord v (y ++ [i]) → Relation.ReflTransGen IsWordMove (x ++ [i]) (y ++ [i]) := by
      intro x y i hx hy
      have hn : inversionNumber (v * gapSwap i) = n := by
        have := inversionNumber_mul_gapSwap_of_gt v hx.lt_of_concat
        omega
      exact (reflTransGen_isWordMove_of_inversionNumber_eq n hn hx.of_concat
        hy.of_concat).lift (· ++ [i]) fun _ _ h => h.append_right _
    have hne : ∀ {c : List (Fin (m + 1))}, IsReducedWord v c → c ≠ [] := by
      rintro c hc rfl
      simpa using hc.2.trans hv
    obtain ⟨a, i, rfl⟩ := (List.eq_nil_or_concat a).resolve_left (hne ha)
    obtain ⟨b, j, rfl⟩ := (List.eq_nil_or_concat b).resolve_left (hne hb)
    simp only [List.concat_eq_append] at ha hb ⊢
    obtain rfl | hij := eq_or_ne i j
    · exact step1 ha hb
    obtain ⟨x, y, hx, hy, hxy⟩ := exists_isWordMove_of_descents v (fun h => hij (Fin.ext h))
      ha.lt_of_concat hb.lt_of_concat
    exact (step1 ha hx).trans ((Relation.ReflTransGen.single hxy).trans (step1 hy hb))

/-- **Matsumoto–Tits for the symmetric group**: any two reduced words for the same permutation
are connected by a chain of elementary moves. `Relation.ReflTransGen IsWordMove a b` says that
there are `r ≥ 0` and words `a = c⁰, c¹, …, cʳ = b` with each `cᵏ` obtained from `cᵏ⁻¹` by an
elementary move. -/
@[cluster_algebras "thm_reduced_words_connected"]
theorem IsReducedWord.reflTransGen_isWordMove {v : Equiv.Perm (Fin (m + 2))}
    {a b : List (Fin (m + 1))} (ha : IsReducedWord v a) (hb : IsReducedWord v b) :
    Relation.ReflTransGen IsWordMove a b :=
  reflTransGen_isWordMove_of_inversionNumber_eq _ rfl ha hb

end ClusterAlgebras
