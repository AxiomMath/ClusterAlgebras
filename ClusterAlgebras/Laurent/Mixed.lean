module

public import ClusterAlgebras.Laurent.Expansion

/-!
# Polynomiality in each frozen variable separately

Let `F` be a field of characteristic zero and `ỹ = (y₁, …, yₘ)` a tuple of elements of `F`
algebraically independent over `ℚ`. An element `z` of `ℤ[ỹ^{±1}]` is a unique `ℤ`-linear
combination of Laurent monomials `ỹᵃ`. This file shows that `z` lies in the subring generated by
a set of Laurent monomials `{ỹᵃ | a ∈ M}`, for `M` closed under addition, exactly when every
exponent vector occurring in `z` lies in `M`: the monomials span that subring over `ℤ`, and the
expansion is unique.

Applied to the exponent vectors whose entries in positions `r ≥ n` are nonnegative, this
describes the mixed ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]` as the set of those `z` whose
monomials have `aᵣ ≥ 0` for every `r ≥ n`. Applied to a single position `r`, it shows that every
element of the subring generated by `ℤ[ỹ_r̂^{±1}]` and `y_r` has only monomials with `aᵣ ≥ 0`.
Together these show that polynomiality in each frozen variable separately suffices: if
`z ∈ ℤ[ỹ^{±1}]` lies, for every `r ≥ n`, in the subring generated by `ℤ[ỹ_r̂^{±1}]` and `y_r`,
then `z ∈ ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]`.

## Main definitions

* `ClusterAlgebras.nonnegExponents`: the exponent vectors whose entries on a given set of
  positions are nonnegative.

## Main results

* `ClusterAlgebras.mem_closure_laurentMonomial_image_iff`: `z` lies in the subring generated by
  the monomials with exponents in an additive submonoid `M` iff its expansion is supported
  in `M`.
* `ClusterAlgebras.mixedLaurentSubring_eq_closure`: the mixed ring is generated by the monomials
  whose exponents in positions `r ≥ n` are nonnegative.
* `ClusterAlgebras.mem_mixedLaurentSubring_iff`: `z ∈ ℤ[ỹ^{±1}]` lies in the mixed ring iff every
  monomial in its expansion has `aᵣ ≥ 0` for `r ≥ n`.
* `ClusterAlgebras.mem_mixedLaurentSubring_of_forall_mem_closure_insert`: polynomiality in each
  frozen variable separately suffices.

## Implementation notes

The tuple is indexed by `Fin m`, whose positions are `0, …, m - 1`, rather than by `[1, m]`, so
the frozen positions are the `r` with `n ≤ r` rather than `[n + 1, m]`. No hypothesis `n ≤ m` is
needed: for `n ≥ m` the mixed ring is the whole of `ℤ[ỹ^{±1}]`. The general statements take an
arbitrary index type.
-/

@[expose] public section

open Finsupp

namespace ClusterAlgebras

variable {ι F : Type*} [Field F]

/-- The exponent vectors `a ∈ ℤ^ι` with `aᵢ ≥ 0` for every position `i ∈ s`, as an additive
submonoid. -/
def nonnegExponents (s : Set ι) : AddSubmonoid (ι →₀ ℤ) where
  carrier := {a | ∀ i ∈ s, 0 ≤ a i}
  add_mem' ha hb i hi := add_nonneg (ha i hi) (hb i hi)
  zero_mem' _ _ := le_rfl

/-- Membership in `nonnegExponents s`: nonnegativity on every position of `s`. -/
@[simp]
theorem mem_nonnegExponents {s : Set ι} {a : ι →₀ ℤ} :
    a ∈ nonnegExponents s ↔ ∀ i ∈ s, 0 ≤ a i :=
  Iff.rfl

/-- The subring of `F` generated by `ℤ[ỹ_r̂^{±1}]` and `y_r` lies inside `ℤ[ỹ^{±1}]`. -/
theorem closure_insert_laurentSubringExcept_le (y : ι → F) (r : ι) :
    Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)) ≤ laurentSubring y :=
  Subring.closure_le.2 <| Set.insert_subset (mem_laurentSubring y r) (laurentSubringExcept_le y r)

/-- Every element of the subring of `F` generated by `ℤ[ỹ_r̂^{±1}]` and `y_r` lies in the subring
generated by the Laurent monomials `ỹᵃ` with `aᵣ ≥ 0`. -/
theorem closure_insert_laurentSubringExcept_le_closure (y : ι → F) (r : ι) :
    Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)) ≤
      Subring.closure (laurentMonomial y '' nonnegExponents {r}) := by
  have hmem : ∀ (i : ι) (k : ℤ), (i ≠ r ∨ 0 ≤ k) →
      y i ^ k ∈ Subring.closure (laurentMonomial y '' nonnegExponents {r}) := fun i k h =>
    Subring.subset_closure ⟨single i k, by
      rintro _ rfl
      rcases h with h | h
      · simp [Ne.symm h]
      · classical
        rw [single_apply]
        split_ifs <;> omega, laurentMonomial_single y i k⟩
  refine Subring.closure_le.2 <| Set.insert_subset (by simpa using hmem r 1 (.inr zero_le_one))
    (laurentSubring_le fun i => ⟨by simpa using hmem i 1 (.inl i.2), by
      simpa using hmem i (-1) (.inl i.2)⟩)

/-- If every `y i` is nonzero and `M` is an additive submonoid of exponent vectors, the subring
generated by the Laurent monomials `ỹᵃ` with `a ∈ M` is their `ℤ`-span. -/
theorem closure_laurentMonomial_image_eq_span {y : ι → F} (hy : ∀ i, y i ≠ 0)
    (M : AddSubmonoid (ι →₀ ℤ)) :
    (Subring.closure (laurentMonomial y '' M) : Set F) =
      Submodule.span ℤ (laurentMonomial y '' M) := by
  have hmon : (Submonoid.closure (laurentMonomial y '' M) : Set F) = laurentMonomial y '' M := by
    refine subset_antisymm (fun x hx => ?_) Submonoid.subset_closure
    induction hx using Submonoid.closure_induction with
    | mem x hx => exact hx
    | one => exact ⟨0, M.zero_mem, laurentMonomial_zero y⟩
    | mul x x' _ _ hx hx' =>
      obtain ⟨a, ha, rfl⟩ := hx
      obtain ⟨b, hb, rfl⟩ := hx'
      exact ⟨a + b, M.add_mem ha hb, laurentMonomial_add hy a b⟩
  ext x
  rw [SetLike.mem_coe, Subring.mem_closure_iff, hmon, SetLike.mem_coe,
    ← Submodule.span_int_eq_addSubgroupClosure, Submodule.mem_toAddSubgroup]

section Mixed

variable {m : ℕ}

/-- The mixed ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]` is the subring generated by the Laurent
monomials `ỹᵃ` with `aᵣ ≥ 0` for every `r ≥ n`. -/
theorem mixedLaurentSubring_eq_closure (y : Fin m → F) (n : ℕ) :
    mixedLaurentSubring y n =
      Subring.closure (laurentMonomial y '' nonnegExponents {r : Fin m | n ≤ (r : ℕ)}) := by
  refine le_antisymm (Subring.closure_le.2 <| Set.union_subset ?_ ?_) (Subring.closure_le.2 ?_)
  · rintro _ ⟨i, rfl⟩
    exact Subring.subset_closure ⟨single i 1, fun r _ => by simp [single_apply]; omega, by simp⟩
  · rintro _ ⟨i, hi, rfl⟩
    refine Subring.subset_closure ⟨single i (-1), fun r hr => ?_, by
      rw [laurentMonomial_single, zpow_neg_one]⟩
    have : i ≠ r := fun h => by subst h; exact absurd (show (i : ℕ) < n from hi) (not_lt.2 hr)
    simp [this]
  · rintro _ ⟨a, ha, rfl⟩
    refine Subring.prod_mem _ fun i _ => ?_
    change y i ^ a i ∈ _
    by_cases hi : (i : ℕ) < n
    · obtain ⟨k, hk | hk⟩ := (a i).eq_nat_or_neg
      · rw [hk, zpow_natCast]
        exact pow_mem (Subring.subset_closure (.inl ⟨i, rfl⟩)) k
      · rw [hk, zpow_neg, zpow_natCast, ← inv_pow]
        exact pow_mem (Subring.subset_closure (.inr ⟨i, hi, rfl⟩)) k
    · rw [← Int.toNat_of_nonneg (ha i (not_lt.1 hi)), zpow_natCast]
      exact pow_mem (Subring.subset_closure (.inl ⟨i, rfl⟩)) _

end Mixed

variable [CharZero F] {y : ι → F}

/-- **Unique expansion and monomial subrings**: for an additive submonoid `M` of exponent
vectors, an element `z ∈ ℤ[ỹ^{±1}]` lies in the subring generated by the Laurent monomials `ỹᵃ`
with `a ∈ M` if and only if every exponent vector occurring in its expansion lies in `M`. -/
theorem mem_closure_laurentMonomial_image_iff (hy : AlgebraicIndependent ℚ y)
    (M : AddSubmonoid (ι →₀ ℤ)) {z : F} (hz : z ∈ laurentSubring y) :
    z ∈ Subring.closure (laurentMonomial y '' M) ↔
      ↑((laurentBasis hy).repr ⟨z, hz⟩).support ⊆ (M : Set (ι →₀ ℤ)) := by
  rw [← SetLike.mem_coe, closure_laurentMonomial_image_eq_span hy.ne_zero M, SetLike.mem_coe,
    ← Module.Basis.mem_span_image]
  have himage : laurentMonomial y '' M =
      ((laurentSubring y).toAddSubgroup.toIntSubmodule.subtype) '' (laurentBasis hy '' M) := by
    rw [Set.image_image]
    exact Set.image_congr fun a _ => (coe_laurentBasis hy a).symm
  rw [himage, Submodule.span_image, Submodule.mem_map]
  refine ⟨fun ⟨x, hx, hxz⟩ => ?_, fun h => ⟨_, h, rfl⟩⟩
  obtain rfl : x = ⟨z, hz⟩ := Subtype.ext hxz
  exact hx

section Mixed

variable {m : ℕ} {y : Fin m → F}

/-- An element `z ∈ ℤ[ỹ^{±1}]` lies in the mixed ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]` if and
only if every Laurent monomial `ỹᵃ` occurring in its expansion has `aᵣ ≥ 0` for every `r ≥ n`. -/
theorem mem_mixedLaurentSubring_iff (hy : AlgebraicIndependent ℚ y) {n : ℕ} {z : F}
    (hz : z ∈ laurentSubring y) :
    z ∈ mixedLaurentSubring y n ↔
      ∀ a ∈ ((laurentBasis hy).repr ⟨z, hz⟩).support, ∀ r : Fin m, n ≤ (r : ℕ) → 0 ≤ a r := by
  rw [mixedLaurentSubring_eq_closure, mem_closure_laurentMonomial_image_iff hy _ hz]
  rfl

/-- **Polynomiality in each frozen variable separately suffices.** Let `ỹ` be algebraically
independent over `ℚ` in a field of characteristic zero. If `z ∈ ℤ[ỹ^{±1}]` lies, for every
position `r ≥ n`, in the subring generated by `ℤ[ỹ_r̂^{±1}]` and `y_r`, then `z` lies in the mixed
ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]`. -/
@[cluster_algebras "lem_mixed_laurent_intersection"]
theorem mem_mixedLaurentSubring_of_forall_mem_closure_insert (hy : AlgebraicIndependent ℚ y)
    {n : ℕ} {z : F} (hz : z ∈ laurentSubring y)
    (h : ∀ r : Fin m, n ≤ (r : ℕ) →
      z ∈ Subring.closure (insert (y r) (laurentSubringExcept y r : Set F))) :
    z ∈ mixedLaurentSubring y n := by
  refine (mem_mixedLaurentSubring_iff hy hz).2 fun a ha r hr => ?_
  simpa using (mem_closure_laurentMonomial_image_iff hy _ hz).1
    (closure_insert_laurentSubringExcept_le_closure y r (h r hr)) ha

end Mixed

end ClusterAlgebras
