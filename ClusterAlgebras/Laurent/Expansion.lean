/-!
# Expansions of integer Laurent polynomials in an algebraically independent tuple

Let `F` be a field of characteristic zero and let `ỹ` be a tuple of elements of `F`
algebraically independent over `ℚ`. This file shows that the ring `ℤ[ỹ^{±1}]` behaves like the
ring of integer Laurent polynomials in indeterminates, in three forms.

* The Laurent monomials `ỹᵃ`, `a ∈ ℤ^ι`, form a basis of the `ℤ`-module `ℤ[ỹ^{±1}]`. The
  monomials span a subring containing the generators; they are independent because multiplying a
  relation among them by a suitable monomial gives a polynomial relation among the `yᵢ`.
  Equivalently, evaluation at `ỹ` is a ring isomorphism from the group algebra
  `ℤ[ℤ^ι] = AddMonoidAlgebra ℤ (ι →₀ ℤ)` onto `ℤ[ỹ^{±1}]`.
* Consequently a ring homomorphism out of `ℤ[ỹ^{±1}]` may send the `yᵢ` to arbitrary units of
  any commutative ring.
* For an index `q`, the ring `ℤ[ỹ^{±1}]` is the ring of Laurent polynomials in one variable over
  `ℤ[ỹ_q̂^{±1}]`, the variable being sent to `y_q`. Evaluation at `y_q` is onto because its image
  contains the generators, and injective because `y_q` is transcendental over
  `ℤ[ỹ_q̂^{±1}]`, which lies in the field `ℚ(ỹ_q̂)`. In particular every element of
  `ℤ[ỹ^{±1}]` is `∑ₑ cₑ y_qᵉ` with coefficients `cₑ ∈ ℤ[ỹ_q̂^{±1}]`, uniquely.

## Main definitions

* `ClusterAlgebras.laurentEval`: evaluation of `AddMonoidAlgebra ℤ (ι →₀ ℤ)` at a family of
  units of a commutative ring.
* `ClusterAlgebras.laurentEquiv`: the ring isomorphism `ℤ[ℤ^ι] ≃+* ℤ[ỹ^{±1}]`.
* `ClusterAlgebras.laurentBasis`: the basis of `ℤ[ỹ^{±1}]` formed by the Laurent monomials.
* `ClusterAlgebras.laurentLift`: the ring homomorphism `ℤ[ỹ^{±1}] → A` sending `yᵢ` to a unit
  `wᵢ`.
* `ClusterAlgebras.laurentEquivOfExcept`: the ring isomorphism
  `ℤ[ỹ_q̂^{±1}][T, T⁻¹] ≃+* ℤ[ỹ^{±1}]` sending `T` to `y_q`.

## Main results

* `ClusterAlgebras.coe_laurentBasis`: the basis vectors of `laurentBasis` are the Laurent
  monomials.
* `ClusterAlgebras.exists_ringHom_laurentSubring`: Laurent polynomials evaluate into any ring.
* `ClusterAlgebras.transcendental_laurentSubringExcept`: `y_q` is transcendental over
  `ℤ[ỹ_q̂^{±1}]`.
* `ClusterAlgebras.exists_sum_mul_zpow`, `ClusterAlgebras.eq_of_sum_mul_zpow_eq`: existence and
  uniqueness of the expansion `∑ₑ cₑ y_qᵉ`.

## Implementation notes

FWZ index the tuple by `[1, m]`; here it is indexed by an arbitrary type `ι`, so that
the results apply verbatim to the subfamily obtained by deleting an entry
(`ClusterAlgebras.algebraicIndependent_except`). Exponent vectors are finitely supported
functions `ι →₀ ℤ`.

FWZ's proof that Laurent polynomials evaluate into any ring defines the map on the basis
of Laurent monomials and checks multiplicativity by hand; here it is the composite of the
inverse of `laurentEquiv` with evaluation of the group algebra, which is a ring homomorphism by
construction.

FWZ obtain the expansion in one variable by grouping Laurent monomials according to
their exponent of `y_q`. Here the one-variable statement is proved directly, from the
transcendence of `y_q` over the field generated by the other entries.
-/

@[expose] public section

open Finsupp LaurentPolynomial

namespace ClusterAlgebras

variable {ι F : Type*} [Field F]

section Eval

variable {A : Type*} [CommRing A]

/-- The Laurent monomial `∏ᵢ wᵢ ^ aᵢ` in a family `w` of units, as a monoid homomorphism in the
exponent vector `a`. -/
noncomputable def laurentMonomialHom (w : ι → Aˣ) : Multiplicative (ι →₀ ℤ) →* Aˣ where
  toFun a := a.toAdd.prod fun i k => w i ^ k
  map_one' := by simp
  map_mul' a b := by simp [Finsupp.prod_add_index', zpow_add]

/-- The value of `laurentMonomialHom w` on an exponent vector. -/
theorem laurentMonomialHom_apply (w : ι → Aˣ) (a : Multiplicative (ι →₀ ℤ)) :
    laurentMonomialHom w a = a.toAdd.prod fun i k => w i ^ k :=
  rfl

/-- Evaluation of integer Laurent polynomials in indeterminates indexed by `ι`, encoded as the
group algebra `AddMonoidAlgebra ℤ (ι →₀ ℤ)`, at a family `w` of units of a commutative ring. -/
noncomputable def laurentEval (w : ι → Aˣ) : AddMonoidAlgebra ℤ (ι →₀ ℤ) →+* A :=
  (AddMonoidAlgebra.lift ℤ A (ι →₀ ℤ) ((Units.coeHom A).comp (laurentMonomialHom w))).toRingHom

/-- `laurentEval w` is the `ℤ`-linear combination of the Laurent monomials in `w`. -/
theorem laurentEval_eq_linearCombination (w : ι → Aˣ) (p : AddMonoidAlgebra ℤ (ι →₀ ℤ)) :
    laurentEval w p = linearCombination ℤ (fun a => (laurentMonomialHom w (.ofAdd a) : A)) p := by
  simp [laurentEval, AddMonoidAlgebra.lift_apply, linearCombination_apply]

/-- `laurentEval w` sends `c` times the basis element of exponent `a` to `c • ∏ᵢ wᵢ ^ aᵢ`. -/
@[simp]
theorem laurentEval_single (w : ι → Aˣ) (a : ι →₀ ℤ) (c : ℤ) :
    laurentEval w (AddMonoidAlgebra.single a c) = c • (laurentMonomialHom w (.ofAdd a) : A) := by
  simp [laurentEval]

end Eval

section Monomial

variable {y : ι → F}

/-- Laurent monomials multiply by adding exponent vectors, when the entries are nonzero. -/
theorem laurentMonomial_add (hy : ∀ i, y i ≠ 0) (a b : ι →₀ ℤ) :
    laurentMonomial y (a + b) = laurentMonomial y a * laurentMonomial y b :=
  Finsupp.prod_add_index' (by simp) fun i k l => zpow_add₀ (hy i) k l

variable (y) in
/-- The Laurent monomial of the zero exponent vector is `1`. -/
@[simp]
theorem laurentMonomial_zero : laurentMonomial y 0 = 1 := by
  simp [laurentMonomial]

variable (y) in
/-- The Laurent monomial of `k` times the `i`-th unit vector is `yᵢ ^ k`. -/
@[simp]
theorem laurentMonomial_single (i : ι) (k : ℤ) : laurentMonomial y (single i k) = y i ^ k := by
  simp [laurentMonomial]

variable (y) in
/-- Negating the exponent vector inverts a Laurent monomial. -/
theorem laurentMonomial_neg (a : ι →₀ ℤ) :
    laurentMonomial y (-a) = (laurentMonomial y a)⁻¹ := by
  simp [laurentMonomial, Finsupp.prod, Finsupp.support_neg, zpow_neg, Finset.prod_inv_distrib]

variable (y) in
/-- A Laurent monomial with nonnegative exponents is an ordinary monomial. -/
theorem laurentMonomial_mapRange_natCast (n : ι →₀ ℕ) :
    laurentMonomial y (n.mapRange Nat.cast Nat.cast_zero) = n.prod fun i k => y i ^ k := by
  simp [laurentMonomial, Finsupp.prod_mapRange_index]

/-- For nonzero entries, the Laurent monomials in the units `yᵢ` are the Laurent monomials
in `ỹ`. -/
@[simp]
theorem coe_laurentMonomialHom_mk0 (hy : ∀ i, y i ≠ 0) (a : ι →₀ ℤ) :
    (laurentMonomialHom (fun i => Units.mk0 (y i) (hy i)) (.ofAdd a) : F) =
      laurentMonomial y a := by
  simp [laurentMonomialHom_apply, laurentMonomial, Finsupp.prod, Units.coe_prod]

/-- Evaluation at nonzero entries `yᵢ` is the `ℤ`-linear combination of the Laurent monomials
in `ỹ`. -/
theorem laurentEval_mk0 (hy : ∀ i, y i ≠ 0) (p : AddMonoidAlgebra ℤ (ι →₀ ℤ)) :
    laurentEval (fun i => Units.mk0 (y i) (hy i)) p =
      linearCombination ℤ (laurentMonomial y) p := by
  simp [laurentEval_eq_linearCombination]

/-- Evaluation at nonzero entries `yᵢ` takes values in `ℤ[ỹ^{±1}]`. -/
theorem laurentEval_mk0_mem (hy : ∀ i, y i ≠ 0) (p : AddMonoidAlgebra ℤ (ι →₀ ℤ)) :
    laurentEval (fun i => Units.mk0 (y i) (hy i)) p ∈ laurentSubring y := by
  rw [laurentEval_mk0, linearCombination_apply]
  exact Subring.sum_mem _ fun a _ => zsmul_mem (laurentMonomial_mem_laurentSubring y a) _

end Monomial

section EvalExcept

variable {y : ι → F}

/-- Evaluation of Laurent polynomials in one variable over `ℤ[ỹ_q̂^{±1}]` at a nonzero entry
`y_q`, as a map to `ℤ[ỹ^{±1}]`. For an algebraically independent tuple it is bijective: see
`laurentEquivOfExcept`. -/
noncomputable def laurentEvalExcept (hy : ∀ i, y i ≠ 0) (q : ι) :
    LaurentPolynomial (laurentSubringExcept y q) →+* laurentSubring y :=
  eval₂ (Subring.inclusion (laurentSubringExcept_le y q)) (isUnit_mem_laurentSubring y (hy q)).unit

/-- `laurentEvalExcept` sends a constant `c` to `c`. -/
@[simp]
theorem coe_laurentEvalExcept_C (hy : ∀ i, y i ≠ 0) (q : ι) (c : laurentSubringExcept y q) :
    (laurentEvalExcept hy q (C c) : F) = c := by
  simp [laurentEvalExcept]

/-- `laurentEvalExcept` sends the monomial `T k` to `y_q ^ k`. -/
@[simp]
theorem coe_laurentEvalExcept_T (hy : ∀ i, y i ≠ 0) (q : ι) (k : ℤ) :
    (laurentEvalExcept hy q (T k) : F) = y q ^ k := by
  let f : laurentSubring y →* F := (laurentSubring y).subtype
  rw [laurentEvalExcept, eval₂_T]
  change f (((_ : (laurentSubring y)ˣ) ^ k : (laurentSubring y)ˣ) : laurentSubring y) = _
  rw [← Units.coe_map, map_zpow, Units.val_zpow_eq_zpow_val, Units.coe_map]
  rfl

/-- On polynomials, `laurentEvalExcept` is evaluation at `y_q`. -/
theorem coe_laurentEvalExcept_toLaurent (hy : ∀ i, y i ≠ 0) (q : ι)
    (P : Polynomial (laurentSubringExcept y q)) :
    (laurentEvalExcept hy q (Polynomial.toLaurent P) : F) = Polynomial.aeval (y q) P := by
  rw [laurentEvalExcept, eval₂_toLaurent, ← Subring.coe_subtype, Polynomial.hom_eval₂,
    Polynomial.aeval_def]
  rfl

/-- `laurentEvalExcept` sends `p = ∑ₖ cₖ Tᵏ` to `∑ₖ cₖ y_qᵏ`. -/
theorem coe_laurentEvalExcept_apply (hy : ∀ i, y i ≠ 0) (q : ι)
    (p : LaurentPolynomial (laurentSubringExcept y q)) :
    (laurentEvalExcept hy q p : F) = p.sum fun k c => (c : F) * y q ^ k := by
  change ((laurentSubring y).subtype.comp (laurentEvalExcept hy q)) p = _
  conv_lhs => rw [← p.sum_single]
  rw [map_finsuppSum]
  refine Finsupp.sum_congr fun k _ => ?_
  rw [single_eq_C_mul_T, map_mul, RingHom.comp_apply, RingHom.comp_apply, Subring.coe_subtype,
    coe_laurentEvalExcept_C, coe_laurentEvalExcept_T]

end EvalExcept

variable [CharZero F] {y : ι → F}

section Basis

/-- A finite family of integer exponent vectors can be shifted into the nonnegative orthant. -/
theorem exists_add_nonneg_of_finset (s : Finset (ι →₀ ℤ)) :
    ∃ e : ι →₀ ℤ, ∀ b ∈ s, ∀ i, 0 ≤ b i + e i := by
  refine ⟨∑ b ∈ s, b.mapRange (|·|) abs_zero, fun b hb i => ?_⟩
  have h₁ : |b i| ≤ (∑ b ∈ s, b.mapRange (|·|) abs_zero) i := by
    simp only [Finsupp.finsetSum_apply, Finsupp.mapRange_apply]
    exact Finset.single_le_sum (f := fun b : ι →₀ ℤ => |b i|) (fun b _ => abs_nonneg _) hb
  have h₂ := neg_abs_le (b i)
  omega

/-- The Laurent monomials in a tuple algebraically independent over `ℚ` are linearly
independent over `ℤ`. -/
theorem linearIndependent_laurentMonomial (hy : AlgebraicIndependent ℚ y) :
    LinearIndependent ℤ (laurentMonomial y) := by
  classical
  rw [linearIndependent_iff']
  intro s g hg a ha
  obtain ⟨e, he⟩ := exists_add_nonneg_of_finset s
  set n : (ι →₀ ℤ) → (ι →₀ ℕ) := fun b => (b + e).mapRange Int.toNat (by simp)
  have hn : ∀ b ∈ s, (n b).mapRange Nat.cast Nat.cast_zero = b + e := fun b hb => by
    ext i
    simp [n, Int.toNat_of_nonneg (he b hb i)]
  set P : MvPolynomial ι ℚ := ∑ b ∈ s, MvPolynomial.monomial (n b) (g b : ℚ)
  have hP : MvPolynomial.aeval y P = 0 := by
    have : MvPolynomial.aeval y P =
        (∑ b ∈ s, g b • laurentMonomial y b) * laurentMonomial y e := by
      simp only [P, map_sum, MvPolynomial.aeval_monomial, Finset.sum_mul]
      refine Finset.sum_congr rfl fun b hb => ?_
      rw [← laurentMonomial_mapRange_natCast, hn b hb, laurentMonomial_add hy.ne_zero,
        zsmul_eq_mul]
      simp [mul_assoc]
    rw [this, hg, zero_mul]
  have := congrArg (MvPolynomial.coeff (n a)) ((injective_iff_map_eq_zero _).1 hy P hP)
  rw [MvPolynomial.coeff_zero, MvPolynomial.coeff_sum, Finset.sum_eq_single a] at this
  · simpa using this
  · intro b hb hba
    rw [MvPolynomial.coeff_monomial, if_neg]
    intro h
    apply hba
    have := congrArg (Finsupp.mapRange (Nat.cast : ℕ → ℤ) Nat.cast_zero) h
    rw [hn b hb, hn a ha] at this
    exact add_right_cancel this
  · exact absurd ha

/-- For a tuple `ỹ` algebraically independent over `ℚ`, the ring `ℤ[ỹ^{±1}]` is isomorphic to
the group algebra of `ι →₀ ℤ` over `ℤ`, the ring of integer Laurent polynomials in
indeterminates indexed by `ι`, with the indeterminates sent to the entries of `ỹ`. -/
noncomputable def laurentEquiv (hy : AlgebraicIndependent ℚ y) :
    AddMonoidAlgebra ℤ (ι →₀ ℤ) ≃+* laurentSubring y :=
  RingEquiv.ofBijective ((laurentEval fun i => Units.mk0 (y i) (hy.ne_zero i)).codRestrict _
      (laurentEval_mk0_mem hy.ne_zero)) <| by
    refine ⟨fun p p' h => linearIndependent_laurentMonomial hy ?_, fun z => ?_⟩
    · simpa [laurentEval_mk0] using congrArg Subtype.val h
    · have : laurentSubring y ≤ (laurentEval fun i => Units.mk0 (y i) (hy.ne_zero i)).range :=
        laurentSubring_le fun i =>
          ⟨⟨AddMonoidAlgebra.single (single i 1) 1, by simp⟩,
            ⟨AddMonoidAlgebra.single (single i (-1)) 1, by simp⟩⟩
      obtain ⟨p, hp⟩ := this z.2
      exact ⟨p, Subtype.ext hp⟩

/-- `laurentEquiv` sends `p = ∑ₐ cₐ Xᵃ` to `∑ₐ cₐ ỹᵃ`. -/
theorem coe_laurentEquiv_apply (hy : AlgebraicIndependent ℚ y)
    (p : AddMonoidAlgebra ℤ (ι →₀ ℤ)) :
    (laurentEquiv hy p : F) = p.sum fun a c => c • laurentMonomial y a := by
  simp [laurentEquiv, laurentEval_mk0, linearCombination_apply]

/-- `laurentEquiv` sends `c` times the basis element of exponent `a` to `c • ỹᵃ`. -/
@[simp]
theorem laurentEquiv_single (hy : AlgebraicIndependent ℚ y) (a : ι →₀ ℤ) (c : ℤ) :
    laurentEquiv hy (AddMonoidAlgebra.single a c) =
      c • ⟨laurentMonomial y a, laurentMonomial_mem_laurentSubring y a⟩ := by
  ext
  simp [coe_laurentEquiv_apply]

/-- `laurentEquiv` sends the basis element of exponent `a` to the Laurent monomial `ỹᵃ`. -/
theorem laurentEquiv_single_one (hy : AlgebraicIndependent ℚ y) (a : ι →₀ ℤ) :
    laurentEquiv hy (AddMonoidAlgebra.single a 1) =
      ⟨laurentMonomial y a, laurentMonomial_mem_laurentSubring y a⟩ := by
  simp

/-- The inverse of `laurentEquiv` sends the Laurent monomial `ỹᵃ` to the basis element of
exponent `a`. -/
@[simp]
theorem laurentEquiv_symm_laurentMonomial (hy : AlgebraicIndependent ℚ y) (a : ι →₀ ℤ) :
    (laurentEquiv hy).symm ⟨laurentMonomial y a, laurentMonomial_mem_laurentSubring y a⟩ =
      AddMonoidAlgebra.single a 1 := by
  rw [RingEquiv.symm_apply_eq, laurentEquiv_single_one]

/-- **The Laurent monomials form a basis** of the `ℤ`-module `ℤ[ỹ^{±1}]`, for a tuple `ỹ`
algebraically independent over `ℚ`: the basis vector of exponent `a` is `ỹᵃ`
(`coe_laurentBasis`). -/
@[cluster_algebras "lem_laurent_expansion"]
noncomputable def laurentBasis (hy : AlgebraicIndependent ℚ y) :
    Module.Basis (ι →₀ ℤ) ℤ (laurentSubring y) :=
  Finsupp.basisSingleOne.map (laurentEquiv hy).toAddEquiv.toIntLinearEquiv

/-- The basis vectors of `laurentBasis` are the Laurent monomials. -/
@[simp, cluster_algebras "lem_laurent_expansion"]
theorem coe_laurentBasis (hy : AlgebraicIndependent ℚ y) (a : ι →₀ ℤ) :
    (laurentBasis hy a : F) = laurentMonomial y a :=
  congrArg Subtype.val (laurentEquiv_single_one hy a)

/-- The basis vector of `laurentBasis` of exponent `a` is `ỹᵃ`, as an element of
`ℤ[ỹ^{±1}]`. -/
theorem laurentBasis_apply (hy : AlgebraicIndependent ℚ y) (a : ι →₀ ℤ) :
    laurentBasis hy a = ⟨laurentMonomial y a, laurentMonomial_mem_laurentSubring y a⟩ :=
  Subtype.ext (coe_laurentBasis hy a)

end Basis

section Lift

variable {A : Type*} [CommRing A]

/-- The ring homomorphism `ℤ[ỹ^{±1}] → A` sending each `yᵢ` to a prescribed unit `wᵢ` of a
commutative ring `A`, for a tuple `ỹ` algebraically independent over `ℚ`. -/
noncomputable def laurentLift (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ) :
    laurentSubring y →+* A :=
  (laurentEval w).comp (laurentEquiv hy).symm.toRingHom

/-- Transported along `laurentEquiv`, `laurentLift` is evaluation of the group algebra. -/
@[simp]
theorem laurentLift_laurentEquiv (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ)
    (p : AddMonoidAlgebra ℤ (ι →₀ ℤ)) : laurentLift hy w (laurentEquiv hy p) = laurentEval w p := by
  simp [laurentLift]

/-- `laurentLift` sends the Laurent monomial `ỹᵃ` to `∏ᵢ wᵢ ^ aᵢ`. -/
theorem laurentLift_laurentMonomial (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ) (a : ι →₀ ℤ) :
    laurentLift hy w ⟨laurentMonomial y a, laurentMonomial_mem_laurentSubring y a⟩ =
      ((a.prod fun i k => w i ^ k : Aˣ) : A) := by
  rw [← laurentEquiv_single_one hy, laurentLift_laurentEquiv, laurentEval_single, one_smul,
    laurentMonomialHom_apply, toAdd_ofAdd]

/-- `laurentLift` sends an integer power `yᵢ ^ k` to `wᵢ ^ k`. -/
theorem laurentLift_zpow (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ) (i : ι) (k : ℤ) :
    laurentLift hy w ⟨y i ^ k, zpow_mem_laurentSubring y i k⟩ = ((w i ^ k : Aˣ) : A) := by
  simpa using laurentLift_laurentMonomial hy w (single i k)

/-- `laurentLift` sends `yᵢ` to `wᵢ`. -/
@[simp]
theorem laurentLift_self (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ) (i : ι) :
    laurentLift hy w ⟨y i, mem_laurentSubring y i⟩ = w i := by
  simpa using laurentLift_zpow hy w i 1

/-- `laurentLift` sends `yᵢ⁻¹` to `wᵢ⁻¹`. -/
@[simp]
theorem laurentLift_inv (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ) (i : ι) :
    laurentLift hy w ⟨(y i)⁻¹, inv_mem_laurentSubring y i⟩ = ((w i)⁻¹ : Aˣ) := by
  simpa using laurentLift_zpow hy w i (-1)

/-- **Laurent polynomials evaluate into any ring**: for a tuple `ỹ` algebraically independent
over `ℚ` and units `wᵢ` of a commutative ring `A`, there is a ring homomorphism
`ℤ[ỹ^{±1}] → A` sending each `yᵢ` to `wᵢ`. -/
@[cluster_algebras "lem_laurent_hom_exists"]
theorem exists_ringHom_laurentSubring (hy : AlgebraicIndependent ℚ y) (w : ι → Aˣ) :
    ∃ φ : laurentSubring y →+* A, ∀ i, φ ⟨y i, mem_laurentSubring y i⟩ = w i :=
  ⟨laurentLift hy w, laurentLift_self hy w⟩

end Lift

section Except

/-- Deleting an entry of an algebraically independent tuple leaves an algebraically independent
tuple, so every result about `ℤ[ỹ^{±1}]` applies to `ℤ[ỹ_q̂^{±1}] = laurentSubringExcept y q`. -/
theorem algebraicIndependent_except (hy : AlgebraicIndependent ℚ y) (q : ι) :
    AlgebraicIndependent ℚ fun i : {i // i ≠ q} => y i :=
  hy.comp _ Subtype.val_injective

/-- The entry `y_q` of a tuple algebraically independent over `ℚ` is transcendental over
`ℤ[ỹ_q̂^{±1}]`. -/
theorem transcendental_laurentSubringExcept (hy : AlgebraicIndependent ℚ y) (q : ι) :
    Transcendental (laurentSubringExcept y q) (y q) := by
  set K := IntermediateField.adjoin ℚ (y '' {i | i ≠ q})
  have hK : Transcendental K (y q) :=
    IntermediateField.transcendental_adjoin_iff.2 (hy.transcendental_adjoin (by simp))
  have hle : laurentSubringExcept y q ≤ K.toSubring := laurentSubring_le fun i =>
    have h : y i ∈ K := IntermediateField.subset_adjoin _ _ ⟨i, i.2, rfl⟩
    ⟨h, K.inv_mem h⟩
  letI : Algebra (laurentSubringExcept y q) K := (Subring.inclusion hle).toAlgebra
  haveI : IsScalarTower (laurentSubringExcept y q) K F := .of_algebraMap_eq fun _ => rfl
  exact hK.restrictScalars (Subring.inclusion_injective hle)

/-- **The expansion in one variable**: for a tuple `ỹ` algebraically independent over `ℚ` and
an index `q`, the ring `ℤ[ỹ^{±1}]` is the ring of Laurent polynomials in one variable over
`ℤ[ỹ_q̂^{±1}]`, the variable being sent to `y_q`. -/
noncomputable def laurentEquivOfExcept (hy : AlgebraicIndependent ℚ y) (q : ι) :
    LaurentPolynomial (laurentSubringExcept y q) ≃+* laurentSubring y :=
  RingEquiv.ofBijective (laurentEvalExcept hy.ne_zero q) <| by
    refine ⟨(injective_iff_map_eq_zero _).2 fun p hp => ?_, fun z => ?_⟩
    · obtain ⟨n, P, hP⟩ := exists_T_pow p
      have : Polynomial.aeval (y q) P = 0 := by
        rw [← coe_laurentEvalExcept_toLaurent hy.ne_zero, hP, map_mul, hp, zero_mul,
          ZeroMemClass.coe_zero]
      rw [(injective_iff_map_eq_zero _).1
        (transcendental_iff_injective.1 (transcendental_laurentSubringExcept hy q)) P this,
        map_zero] at hP
      exact ((isUnit_T _).mul_left_eq_zero).1 hP.symm
    · let ψ := (laurentSubring y).subtype.comp (laurentEvalExcept hy.ne_zero q)
      have hmem : ∀ i, y i ∈ ψ.range ∧ (y i)⁻¹ ∈ ψ.range := fun i => by
        rcases eq_or_ne i q with rfl | hi
        · exact ⟨⟨T 1, by simp [ψ, coe_laurentEvalExcept_T]⟩,
            ⟨T (-1), by simp [ψ, coe_laurentEvalExcept_T]⟩⟩
        · exact ⟨⟨C ⟨y i, mem_laurentSubring (fun j : {j // j ≠ q} => y j) ⟨i, hi⟩⟩,
              by simp [ψ, coe_laurentEvalExcept_C]⟩,
            ⟨C ⟨(y i)⁻¹, inv_mem_laurentSubring (fun j : {j // j ≠ q} => y j) ⟨i, hi⟩⟩,
              by simp [ψ, coe_laurentEvalExcept_C]⟩⟩
      obtain ⟨p, hp⟩ := laurentSubring_le hmem z.2
      exact ⟨p, Subtype.ext hp⟩

/-- The one-variable expansion is `laurentEvalExcept`. -/
theorem laurentEquivOfExcept_apply (hy : AlgebraicIndependent ℚ y) (q : ι)
    (p : LaurentPolynomial (laurentSubringExcept y q)) :
    laurentEquivOfExcept hy q p = laurentEvalExcept hy.ne_zero q p :=
  rfl

/-- The one-variable expansion sends a constant `c ∈ ℤ[ỹ_q̂^{±1}]` to `c`. -/
@[simp]
theorem laurentEquivOfExcept_C (hy : AlgebraicIndependent ℚ y) (q : ι)
    (c : laurentSubringExcept y q) :
    laurentEquivOfExcept hy q (C c) = ⟨c, laurentSubringExcept_le y q c.2⟩ :=
  Subtype.ext (coe_laurentEvalExcept_C hy.ne_zero q c)

/-- The one-variable expansion sends the monomial `T k` to `y_q ^ k`. -/
@[simp]
theorem laurentEquivOfExcept_T (hy : AlgebraicIndependent ℚ y) (q : ι) (k : ℤ) :
    laurentEquivOfExcept hy q (T k) = ⟨y q ^ k, zpow_mem_laurentSubring y q k⟩ :=
  Subtype.ext (coe_laurentEvalExcept_T hy.ne_zero q k)

/-- The one-variable expansion sends `p = ∑ₖ cₖ Tᵏ` to `∑ₖ cₖ y_qᵏ`. -/
theorem coe_laurentEquivOfExcept_apply (hy : AlgebraicIndependent ℚ y) (q : ι)
    (p : LaurentPolynomial (laurentSubringExcept y q)) :
    (laurentEquivOfExcept hy q p : F) = p.sum fun k c => (c : F) * y q ^ k :=
  coe_laurentEvalExcept_apply hy.ne_zero q p

/-- On polynomials, the one-variable expansion is evaluation at `y_q`. -/
@[simp]
theorem coe_laurentEquivOfExcept_toLaurent (hy : AlgebraicIndependent ℚ y) (q : ι)
    (P : Polynomial (laurentSubringExcept y q)) :
    (laurentEquivOfExcept hy q (Polynomial.toLaurent P) : F) = Polynomial.aeval (y q) P :=
  coe_laurentEvalExcept_toLaurent hy.ne_zero q P

/-- The inverse of the one-variable expansion sends `c ∈ ℤ[ỹ_q̂^{±1}]` to the constant `c`. -/
@[simp]
theorem laurentEquivOfExcept_symm_mk (hy : AlgebraicIndependent ℚ y) (q : ι)
    (c : laurentSubringExcept y q) :
    (laurentEquivOfExcept hy q).symm ⟨c, laurentSubringExcept_le y q c.2⟩ = C c := by
  rw [RingEquiv.symm_apply_eq, laurentEquivOfExcept_C]

/-- The inverse of the one-variable expansion sends `y_q ^ k` to the monomial `T k`. -/
@[simp]
theorem laurentEquivOfExcept_symm_zpow (hy : AlgebraicIndependent ℚ y) (q : ι) (k : ℤ) :
    (laurentEquivOfExcept hy q).symm ⟨y q ^ k, zpow_mem_laurentSubring y q k⟩ = T k := by
  rw [RingEquiv.symm_apply_eq, laurentEquivOfExcept_T]

/-- The integer powers of `y_q` are linearly independent over `ℤ[ỹ_q̂^{±1}]`. -/
theorem linearIndependent_zpow_except (hy : AlgebraicIndependent ℚ y) (q : ι) :
    LinearIndependent (laurentSubringExcept y q) fun k : ℤ => y q ^ k := by
  have : ⇑(linearCombination (laurentSubringExcept y q) fun k : ℤ => y q ^ k) =
      fun p => (laurentEquivOfExcept hy q p : F) := by
    ext p
    rw [coe_laurentEquivOfExcept_apply, linearCombination_apply]
    rfl
  rw [LinearIndependent, this]
  exact Subtype.val_injective.comp (laurentEquivOfExcept hy q).injective

/-- **Uniqueness of the expansion in `y_q`**: if `∑_{e ∈ s} cₑ y_qᵉ = 0` with every
`cₑ ∈ ℤ[ỹ_q̂^{±1}]`, then every `cₑ` vanishes. -/
theorem eq_zero_of_sum_mul_zpow_eq_zero (hy : AlgebraicIndependent ℚ y) (q : ι)
    {s : Finset ℤ} {c : ℤ → F} (hc : ∀ e ∈ s, c e ∈ laurentSubringExcept y q)
    (h : ∑ e ∈ s, c e * y q ^ e = 0) : ∀ e ∈ s, c e = 0 := by
  classical
  let g : ℤ → laurentSubringExcept y q := fun e =>
    if he : c e ∈ laurentSubringExcept y q then ⟨c e, he⟩ else 0
  have hg : ∀ e ∈ s, (g e : F) = c e := fun e he => by simp [g, hc e he]
  have := linearIndependent_iff'.1 (linearIndependent_zpow_except hy q) s g <| by
    rw [← h]
    exact Finset.sum_congr rfl fun e he => by rw [Subring.smul_def, smul_eq_mul, hg e he]
  intro e he
  rw [← hg e he, this e he, ZeroMemClass.coe_zero]

/-- **Uniqueness of the expansion in `y_q`**: the coefficients in `ℤ[ỹ_q̂^{±1}]` of equal
expansions `∑_{e ∈ s} cₑ y_qᵉ = ∑_{e ∈ s} dₑ y_qᵉ` agree. -/
theorem eq_of_sum_mul_zpow_eq (hy : AlgebraicIndependent ℚ y) (q : ι)
    {s : Finset ℤ} {c d : ℤ → F} (hc : ∀ e ∈ s, c e ∈ laurentSubringExcept y q)
    (hd : ∀ e ∈ s, d e ∈ laurentSubringExcept y q)
    (h : ∑ e ∈ s, c e * y q ^ e = ∑ e ∈ s, d e * y q ^ e) : ∀ e ∈ s, c e = d e := fun e he =>
  sub_eq_zero.1 <| eq_zero_of_sum_mul_zpow_eq_zero hy q (c := c - d)
    (fun e he => sub_mem (hc e he) (hd e he)) (by simp [sub_mul, Finset.sum_sub_distrib, h]) e he

/-- **Existence of the expansion in `y_q`**: every element of `ℤ[ỹ^{±1}]` is
`∑_{e ∈ s} cₑ y_qᵉ` for a finite set `s` of integers and coefficients `cₑ ∈ ℤ[ỹ_q̂^{±1}]`. -/
theorem exists_sum_mul_zpow (hy : AlgebraicIndependent ℚ y) (q : ι) {z : F}
    (hz : z ∈ laurentSubring y) :
    ∃ (s : Finset ℤ) (c : ℤ → F), (∀ e, c e ∈ laurentSubringExcept y q) ∧
      z = ∑ e ∈ s, c e * y q ^ e := by
  set p := (laurentEquivOfExcept hy q).symm ⟨z, hz⟩
  refine ⟨p.support, fun e => p e, fun e => (p e).2, ?_⟩
  have := coe_laurentEquivOfExcept_apply hy q p
  rwa [RingEquiv.apply_symm_apply] at this

end Except

end ClusterAlgebras
