module

public import ClusterAlgebras.Attr
public import Mathlib.Algebra.BigOperators.Finsupp.Basic
public import Mathlib.Algebra.Ring.Subring.Basic

/-!
# Integer Laurent polynomials in a tuple of elements of a field

For a tuple `ỹ` of elements of a field `F`, this file defines the subring `ℤ[ỹ^{±1}]` of `F`
generated by the entries of `ỹ` and their inverses, its Laurent monomials, the subring
`ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]` in which only the first `n` entries are inverted, and the
`q`-width of an element.

## Main definitions

* `ClusterAlgebras.laurentSubring`: the ring `ℤ[ỹ^{±1}]` of integer Laurent polynomials in `ỹ`.
* `ClusterAlgebras.laurentSubringExcept`: the ring `ℤ[ỹ_q̂^{±1}]` of integer Laurent polynomials
  in the entries of `ỹ` other than `y_q`.
* `ClusterAlgebras.laurentMonomial`: the Laurent monomial `ỹᵃ` of an integer exponent vector.
* `ClusterAlgebras.mixedLaurentSubring`: the ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]`.
* `ClusterAlgebras.HasWidth`: an element has `q`-width `w` with respect to `ỹ`.

## Implementation notes

Tuples are indexed by an arbitrary type `ι` rather than by `[1, m]`, so that the definitions
apply to the subfamily obtained by deleting one entry, which is indexed by a subtype. The
entries are not assumed to be nonzero.
-/

@[expose] public section

namespace ClusterAlgebras

variable {F ι : Type*} [Field F]

/-- The ring `ℤ[ỹ^{±1}]` of **integer Laurent polynomials** in the tuple `y`: the subring of
`F` generated by the entries `yᵢ` and their inverses `yᵢ⁻¹`. -/
@[cluster_algebras "def_laurent_subring"]
def laurentSubring (y : ι → F) : Subring F :=
  Subring.closure (Set.range y ∪ Set.range fun i => (y i)⁻¹)

/-- The ring `ℤ[ỹ_q̂^{±1}]`: the subring of `F` generated by the entries `yᵢ` with `i ≠ q` and
their inverses. It is `laurentSubring` of the subfamily obtained by deleting the entry in
position `q`. -/
@[cluster_algebras "def_laurent_subring"]
def laurentSubringExcept (y : ι → F) (q : ι) : Subring F :=
  laurentSubring fun i : {i // i ≠ q} => y i

/-- The **Laurent monomial** `ỹᵃ = ∏ᵢ yᵢ ^ aᵢ` of an integer exponent vector `a`. Exponent
vectors are finitely supported, so the product is finite for any index type. -/
@[cluster_algebras "def_laurent_subring"]
def laurentMonomial (y : ι → F) (a : ι →₀ ℤ) : F :=
  a.prod fun i k => y i ^ k

/-- The ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]`: the subring of `F` generated by the entries
of `y` and the inverses of its first `n` entries. -/
@[cluster_algebras "def_mixed_laurent_subring"]
def mixedLaurentSubring {m : ℕ} (y : Fin m → F) (n : ℕ) : Subring F :=
  Subring.closure (Set.range y ∪ (fun i => (y i)⁻¹) '' {i | (i : ℕ) < n})

/-- `z` has **`q`-width** `w` with respect to the tuple `y` when
`z = ∑_{e=0}^{w} c_e y_q^{e₀ + e}` for an integer `e₀` and elements `c₀, …, c_w` of
`ℤ[ỹ_q̂^{±1}]` with `c₀ ≠ 0` and `c_w ≠ 0`. -/
@[cluster_algebras "def_variable_width"]
def HasWidth (y : ι → F) (q : ι) (z : F) (w : ℕ) : Prop :=
  ∃ (e₀ : ℤ) (c : ℕ → F), (∀ e ≤ w, c e ∈ laurentSubringExcept y q) ∧ c 0 ≠ 0 ∧ c w ≠ 0 ∧
    z = ∑ e ∈ Finset.range (w + 1), c e * y q ^ (e₀ + e)

section Basic

variable (y : ι → F)

/-- Each entry of the tuple is an integer Laurent polynomial in it. -/
theorem mem_laurentSubring (i : ι) : y i ∈ laurentSubring y :=
  Subring.subset_closure (Or.inl ⟨i, rfl⟩)

/-- The inverse of each entry of the tuple is an integer Laurent polynomial in it. -/
theorem inv_mem_laurentSubring (i : ι) : (y i)⁻¹ ∈ laurentSubring y :=
  Subring.subset_closure (Or.inr ⟨i, rfl⟩)

/-- Every integer power of an entry of the tuple is an integer Laurent polynomial in it. -/
theorem zpow_mem_laurentSubring (i : ι) (k : ℤ) : y i ^ k ∈ laurentSubring y := by
  obtain ⟨k, rfl | rfl⟩ := k.eq_nat_or_neg
  · simpa using pow_mem (mem_laurentSubring y i) k
  · simpa using pow_mem (inv_mem_laurentSubring y i) k

/-- Every Laurent monomial in the tuple is an integer Laurent polynomial in it. -/
theorem laurentMonomial_mem_laurentSubring (a : ι →₀ ℤ) :
    laurentMonomial y a ∈ laurentSubring y :=
  Subring.prod_mem _ fun i _ => zpow_mem_laurentSubring y i _

variable {y} in
/-- A subring contains `ℤ[ỹ^{±1}]` as soon as it contains every entry of the tuple and its
inverse. -/
theorem laurentSubring_le {S : Subring F} (h : ∀ i, y i ∈ S ∧ (y i)⁻¹ ∈ S) :
    laurentSubring y ≤ S :=
  Subring.closure_le.2 <| Set.union_subset (Set.range_subset_iff.2 fun i => (h i).1)
    (Set.range_subset_iff.2 fun i => (h i).2)

/-- Deleting an entry of the tuple gives a smaller ring of Laurent polynomials. -/
theorem laurentSubringExcept_le (q : ι) : laurentSubringExcept y q ≤ laurentSubring y :=
  laurentSubring_le fun i => ⟨mem_laurentSubring y i, inv_mem_laurentSubring y i⟩

/-- A nonzero entry of the tuple is a unit of `ℤ[ỹ^{±1}]`. -/
theorem isUnit_mem_laurentSubring {i : ι} (hi : y i ≠ 0) :
    IsUnit (⟨y i, mem_laurentSubring y i⟩ : laurentSubring y) :=
  IsUnit.of_mul_eq_one (⟨(y i)⁻¹, inv_mem_laurentSubring y i⟩ : laurentSubring y)
    (Subtype.ext (mul_inv_cancel₀ hi))

end Basic

/-- The mixed ring `ℤ[y₁^{±1}, …, yₙ^{±1}, yₙ₊₁, …, yₘ]` lies inside `ℤ[ỹ^{±1}]`. -/
theorem mixedLaurentSubring_le_laurentSubring {m : ℕ} (y : Fin m → F) (n : ℕ) :
    mixedLaurentSubring y n ≤ laurentSubring y :=
  Subring.closure_le.2 <| Set.union_subset
    (Set.range_subset_iff.2 fun i => mem_laurentSubring y i)
    (by rintro _ ⟨i, -, rfl⟩; exact inv_mem_laurentSubring y i)

end ClusterAlgebras
