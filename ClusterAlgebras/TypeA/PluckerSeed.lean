/-!
# The Plücker seeds of the triangulations of a polygon

A labelled triangulation `(T, λ)` of the `(n+3)`-gon numbers the diagonals of `T` by `[1, n]`;
with the labels `n + ℓ` for the sides it gives a `(2n+3) × n` extended exchange matrix
`B̃(T, λ)`, the extended exchange matrix of the quiver `Q(T)` in that numbering. Together with
the Plücker coordinates `P_σ` of the generic `2 × (n+3)` matrix it gives a seed `Σ(T, λ)` in the
Plücker field `𝓕ₙ`, the field generated by the `P_σ`. Flips are seed mutations, by the Ptolemy
relation; every `Σ(T, λ)` is a labeled seed; the seed pattern through one of them has as seeds
exactly the `Σ(T, λ)`, so it is of finite type; and the fan has full `ℤ`-rank.

## Main definitions

* `ClusterAlgebras.TypeA.LabelledTriangulation n`: a triangulation of the `(n+3)`-gon with its
  diagonals numbered.
* `LabelledTriangulation.extLabel`, `LabelledTriangulation.extMatrix`,
  `LabelledTriangulation.matrix`: the extended labelling `λ̂`, `B̃(T, λ)` and `B(T, λ)`.
* `ClusterAlgebras.TypeA.pluckerField K n`: the Plücker field `𝓕ₙ` over `K`.
* `ClusterAlgebras.TypeA.pluckerVar K n σ`: the Plücker coordinate `P_σ ∈ 𝓕ₙ`.
* `ClusterAlgebras.TypeA.pluckerSeed K L`: the Plücker seed `Σ(T, λ)`.

## Main results

* `LabelledTriangulation.exists_labelling`: `λ̂` is a labelling of `Q(T)`.
* `LabelledTriangulation.exists_seedMutation_eq`: a flip is a seed mutation.
* `LabelledTriangulation.isLabeledSeed_pluckerSeed`: `Σ(T, λ)` is a labeled seed.
* `ClusterAlgebras.TypeA.IsSeedPattern.existsUnique_pluckerSeed`: the seed pattern through a
  Plücker seed has exactly one Plücker seed at each vertex.
* `LabelledTriangulation.span_range_extMatrix_eq_top`: the fan has full `ℤ`-rank.

## Implementation notes

* **Indices.** The labels `i ∈ [1, 2n+3]` of [FWZ] are `i - 1 : Fin (2n+3)`; the mutable labels
  `[1, n]` are `Fin n`, embedded by `Fin.castLE`.
* **Vertices.** The vertex `v : ZMod (n+3)` is the vertex `v + 1` of [FWZ] (`vertexRep` reads
  `v` as the column `v.val`, FWZ's representative shifted down by one). So the side
  `{ℓ, ℓ+1}` with label `n + ℓ` (`ℓ ∈ [1, n+3]`) is the side `s(ℓ', ℓ'+1)` with
  `ℓ' = ℓ - 1 ∈ [0, n+2]` at the index `n + ℓ'`; this is `LabelledTriangulation.extLabel`. Under
  this convention `segmentPlucker` is exactly the Plücker coordinate `P_σ` of [FWZ].
* **A labelled triangulation is its labelling.** The pair `(T, λ)` with `λ : [1, n] → T` a
  bijection is stored as an injective `label : Fin n → Sym2 (ZMod (n+3))` whose image is a
  triangulation; `T` is recovered as `triangulation`, the image. So two labelled triangulations
  are equal exactly when their labellings are (`LabelledTriangulation.ext`).
* **`B̃(T, λ)` is read off `polygonArrows T` directly on `Sym2`**, the arrow counts of `Q(T)`
  before restricting to the segments of `T`; `LabelledTriangulation.exists_labelling` identifies
  it with `extExchangeMatrix (polygonQuiver T)`.
* **The Plücker field.** `K(z)` is `FractionRing (MvPolynomial (Fin 2 × Fin (n+3)) K)`; the
  matrix `z` over it is the image of `genericMatrix` under the ring homomorphism `ℤ[z] → K(z)`
  fixing every `z_{ij}`; `P_σ = segmentPlucker z σ`; and `𝓕ₙ` is
  `IntermediateField.adjoin K {P_σ : σ a segment}`, a field in which the seeds live.
  `pluckerVar K n σ` is `P_σ` as an element of `𝓕ₙ` for a segment `σ` and `0` otherwise (where
  `P_σ` is the junk value `0` anyway).
* **Generation.** That `x̃(T, λ)` generates `𝓕ₙ` is the subtraction-free expression of every
  `P_ζ` in the `P_σ`, `σ` a segment of `T`, carried from `ℤ[z]` to `K(z)` by the ring
  homomorphism fixing every `z_{ij}`, which is injective as `K` has characteristic zero.
* **Independence.** For the fan, the `P_σ` are sent to independent indeterminates `Y_σ` by the
  specialization `z_{1,1} = 1`, `z_{2,1} = 0`, `z_{2,j} = Y_{1j}`, `z_{1,j} = α_j`, with
  `α_j = -Y_{1j} ∑_{2 ≤ ℓ < j} Y_{ℓ,ℓ+1} / (Y_{1ℓ} Y_{1,ℓ+1})` given in closed form; every other
  triangulation is reached from the fan by flips, which are seed mutations and so preserve
  algebraic independence.
* The hypothesis `n ≥ 1` of [FWZ] is dropped wherever the statement is true without it (for
  `n = 0` the triangle has the single triangulation `∅`, which is the fan), and the hypothesis
  that `K` has characteristic zero wherever the statement is purely combinatorial or
  polynomial.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*][FWZ]
-/

@[expose] public section

namespace ClusterAlgebras

namespace TypeA

/-- The frozen size `2n + 3` of the Plücker seeds is at least their rank `n`. -/
theorem le_two_mul_add_three (n : ℕ) : n ≤ 2 * n + 3 := by omega

/-! ### Labelled triangulations and their matrices -/

/-- A **labelled triangulation** of the `(n+3)`-gon: a triangulation `T` together with a
bijection `λ : [1, n] → T`, stored as the injective map `label` (indexed by `Fin n`) whose image
is the triangulation `T`. -/
@[cluster_algebras "def_type_A_labelled_triangulation", ext]
structure LabelledTriangulation (n : ℕ) where
  /-- The labelling `λ`, numbering the diagonals of the triangulation. -/
  label : Fin n → Sym2 (ZMod (n + 3))
  /-- `λ` is injective. -/
  injective : Function.Injective label
  /-- The image of `λ` is a triangulation. -/
  isTriangulation : IsTriangulation (Finset.univ.image label)

namespace LabelledTriangulation

variable {n : ℕ} (L : LabelledTriangulation n)

/-- The triangulation `T` of a labelled triangulation `(T, λ)`: the image of `λ`. -/
@[cluster_algebras "def_type_A_labelled_triangulation"]
def triangulation : Finset (Sym2 (ZMod (n + 3))) :=
  Finset.univ.image L.label

/-- The **extended labelling** `λ̂ : [1, 2n+3] → segments of T`: `λ̂(i) = λ(i)` for the mutable
labels, and the side labels `λ̂(n + ℓ) = {ℓ, ℓ+1}` for the others, which in the Lean vertex
and index conventions read `λ̂(n + ℓ') = s(ℓ', ℓ'+1)` for `ℓ' ∈ [0, n+2]`. -/
@[cluster_algebras "def_type_A_labelled_triangulation"]
def extLabel (i : Fin (2 * n + 3)) : Sym2 (ZMod (n + 3)) :=
  if h : (i : ℕ) < n then L.label ⟨i, h⟩
  else s((((i : ℕ) - n : ℕ) : ZMod (n + 3)), (((i : ℕ) - n : ℕ) : ZMod (n + 3)) + 1)

/-- The **extended exchange matrix** `B̃(T, λ)`: the `(2n+3) × n` integer matrix whose `(i, j)`
entry is `β_T(λ̂(i), λ̂(j))`, the signed count of the arrows of `Q(T)`. -/
@[cluster_algebras "def_type_A_labelled_triangulation"]
def extMatrix : Matrix (Fin (2 * n + 3)) (Fin n) ℤ :=
  Matrix.of fun i j => signedCount (polygonArrows L.triangulation) (L.extLabel i)
    (L.extLabel (Fin.castLE (le_two_mul_add_three n) j))

/-- The **exchange matrix** `B(T, λ)`: the principal part of `B̃(T, λ)`. -/
@[cluster_algebras "def_type_A_labelled_triangulation"]
def matrix : Matrix (Fin n) (Fin n) ℤ :=
  principalPart (le_two_mul_add_three n) L.extMatrix

/-- On the mutable labels the extended labelling is the labelling. -/
@[simp]
theorem extLabel_castLE (j : Fin n) :
    L.extLabel (Fin.castLE (le_two_mul_add_three n) j) = L.label j := by
  simp [extLabel]

/-- The sides `{a, a+1}`, `a ∈ [0, n+2]`, of the `(n+3)`-gon are pairwise distinct. -/
private theorem side_natCast_inj {a b : ℕ} (ha : a < n + 3) (hb : b < n + 3)
    (h : (s((a : ZMod (n + 3)), (a : ZMod (n + 3)) + 1) : Sym2 _) =
      s((b : ZMod (n + 3)), (b : ZMod (n + 3)) + 1)) : a = b := by
  rcases Sym2.eq_iff.1 h with ⟨h1, -⟩ | ⟨h1, h2⟩
  · exact (natCast_inj_of_lt ha hb).1 h1
  · exfalso
    have h3 : ((2 : ℕ) : ZMod (n + 3)) = 0 := by
      have : (b : ZMod (n + 3)) + 2 = b + 0 := by linear_combination h2 - h1
      push_cast
      exact add_left_cancel this
    rw [ZMod.natCast_eq_zero_iff] at h3
    have := Nat.le_of_dvd (by norm_num) h3
    omega

private theorem label_mem_triangulation (j : Fin n) : L.label j ∈ L.triangulation :=
  Finset.mem_image_of_mem _ (Finset.mem_univ _)

private theorem isDiagonal_label (j : Fin n) : IsDiagonal (L.label j) :=
  L.isTriangulation.isDiagonal _ (L.label_mem_triangulation j)

private theorem mem_triangulation_iff {σ : Sym2 (ZMod (n + 3))} :
    σ ∈ L.triangulation ↔ ∃ j, L.label j = σ := by
  simp [triangulation]

private theorem extLabel_of_lt {i : Fin (2 * n + 3)} (h : (i : ℕ) < n) :
    L.extLabel i = L.label ⟨i, h⟩ :=
  dif_pos h

private theorem extLabel_of_le {i : Fin (2 * n + 3)} (h : n ≤ (i : ℕ)) :
    L.extLabel i =
      s((((i : ℕ) - n : ℕ) : ZMod (n + 3)), (((i : ℕ) - n : ℕ) : ZMod (n + 3)) + 1) :=
  dif_neg (not_lt.2 h)

private theorem isSide_extLabel_iff (i : Fin (2 * n + 3)) :
    IsSide (L.extLabel i) ↔ n ≤ (i : ℕ) := by
  by_cases h : (i : ℕ) < n
  · rw [L.extLabel_of_lt h]
    exact iff_of_false (L.isDiagonal_label _).2 (by omega)
  · rw [L.extLabel_of_le (by omega)]
    exact iff_of_true ⟨_, rfl⟩ (by omega)

private theorem extLabel_mem_segments (i : Fin (2 * n + 3)) :
    L.extLabel i ∈ segments L.triangulation := by
  by_cases h : (i : ℕ) < n
  · rw [L.extLabel_of_lt h]
    exact mem_segments.2 (Or.inl (L.label_mem_triangulation _))
  · exact mem_segments.2 (Or.inr ((L.isSide_extLabel_iff i).2 (by omega)))

/-- Every value of the extended labelling is a segment. -/
private theorem isSegment_extLabel (i : Fin (2 * n + 3)) : IsSegment (L.extLabel i) := by
  by_cases h : (i : ℕ) < n
  · rw [L.extLabel_of_lt h]
    exact (L.isDiagonal_label _).isSegment
  · rw [L.extLabel_of_le (by omega)]
    intro hd
    rw [Sym2.mk_isDiag_iff] at hd
    have h1 : ((1 : ℕ) : ZMod (n + 3)) = 0 := by
      push_cast
      exact (add_eq_left.1 hd.symm)
    rw [ZMod.natCast_eq_zero_iff] at h1
    have := Nat.le_of_dvd one_pos h1
    omega

private theorem extLabel_injective : Function.Injective L.extLabel := by
  intro i i' h
  by_cases hi : (i : ℕ) < n <;> by_cases hi' : (i' : ℕ) < n
  · rw [L.extLabel_of_lt hi, L.extLabel_of_lt hi'] at h
    exact Fin.ext (Fin.mk.inj_iff.1 (L.injective h))
  · have := (L.isSide_extLabel_iff i').2 (by omega)
    rw [← h, L.isSide_extLabel_iff] at this
    omega
  · have := (L.isSide_extLabel_iff i).2 (by omega)
    rw [h, L.isSide_extLabel_iff] at this
    omega
  · rw [L.extLabel_of_le (by omega), L.extLabel_of_le (by omega)] at h
    have := side_natCast_inj (by omega) (by omega) h
    omega

private theorem exists_extLabel_eq {σ : Sym2 (ZMod (n + 3))} (hσ : σ ∈ segments L.triangulation) :
    ∃ i, L.extLabel i = σ := by
  rcases mem_segments.1 hσ with hσ | ⟨x, rfl⟩
  · obtain ⟨j, rfl⟩ := L.mem_triangulation_iff.1 hσ
    exact ⟨Fin.castLE (le_two_mul_add_three n) j, L.extLabel_castLE j⟩
  · refine ⟨⟨n + x.val, by have := x.val_lt; omega⟩, ?_⟩
    rw [L.extLabel_of_le (by simp)]
    simp

/-- The extended labelling `λ̂`, as a numbering of the vertices of `Q(T)`. -/
private noncomputable def extLabelEquiv : Fin (2 * n + 3) ≃ SegmentType L.triangulation :=
  Equiv.ofBijective (fun i => ⟨L.extLabel i, L.extLabel_mem_segments i⟩)
    ⟨fun _ _ h => L.extLabel_injective (congrArg Subtype.val h), fun σ =>
      (L.exists_extLabel_eq σ.2).imp fun _ h => Subtype.ext h⟩

/-- **The extended labelling is a labelling of the quiver.** `λ̂` is a labelling of `Q(T)`, and
`B̃(T, λ)` and `B(T, λ)` are the extended exchange matrix and the exchange matrix of `Q(T)` in
it. -/
@[cluster_algebras "lem_type_A_extended_labelling"]
theorem exists_labelling :
    ∃ Λ : Labelling (polygonQuiver L.triangulation) (2 * n + 3) n,
      (∀ i, (Λ.equiv i).1 = L.extLabel i) ∧
        extExchangeMatrix (polygonQuiver L.triangulation) Λ = L.extMatrix ∧
        exchangeMatrix (polygonQuiver L.triangulation) Λ = L.matrix := by
  refine ⟨⟨L.extLabelEquiv, le_two_mul_add_three n, fun i => ?_⟩, fun i => rfl, rfl, rfl⟩
  simp only [polygonQuiver, Finset.mem_filter, Finset.mem_univ, true_and]
  exact L.isSide_extLabel_iff i

/-- **`B(T, λ)` is skew-symmetric.** -/
@[cluster_algebras "lem_type_A_extended_labelling"]
theorem matrix_transpose : L.matrix.transpose = -L.matrix := by
  obtain ⟨Λ, -, -, h⟩ := L.exists_labelling
  rw [← h]
  exact exchangeMatrix_transpose _ Λ

/-- **`B̃(T, λ)` is extended skew-symmetrizable.** -/
@[cluster_algebras "lem_type_A_extended_labelling"]
theorem extSkewSymmetrizable_extMatrix :
    ExtSkewSymmetrizable (le_two_mul_add_three n) L.extMatrix := by
  refine ⟨fun _ => 1, fun _ => one_pos, fun i j => ?_⟩
  have h := congrFun (congrFun L.matrix_transpose j) i
  simp only [Matrix.transpose_apply, Matrix.neg_apply, matrix, principalPart] at h
  simp only [Int.cast_one, one_mul, h]

end LabelledTriangulation

/-- A triangle has no diagonals. -/
private theorem not_isDiagonal_zmod_three : ∀ e : Sym2 (ZMod (0 + 3)), ¬IsDiagonal e := by
  decide

/-- A triangulation of the triangle is empty. -/
theorem IsTriangulation.eq_empty_of_zmod_three {U : Finset (Sym2 (ZMod (0 + 3)))}
    (hU : IsTriangulation U) : U = ∅ :=
  Finset.eq_empty_iff_forall_notMem.2 fun e he => not_isDiagonal_zmod_three e (hU.isDiagonal e he)

/-- **Every triangulation admits a labelling**: a triangulation of the `(n+3)`-gon is the
triangulation of a labelled triangulation, since it has `n` elements. -/
private theorem IsTriangulation.exists_labelledTriangulation {n : ℕ}
    {T : Finset (Sym2 (ZMod (n + 3)))} (hT : IsTriangulation T) :
    ∃ L : LabelledTriangulation n, L.triangulation = T := by
  have hcard : T.card = n := by
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact Finset.card_eq_zero.2 (IsTriangulation.eq_empty_of_zmod_three hT)
    · have := IsTriangulation.card_eq (by omega : 4 ≤ n + 3) hT
      omega
  set e := T.equivFinOfCardEq hcard
  have himage : Finset.univ.image (fun i => (e.symm i).1) = T := by
    ext σ
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨fun ⟨i, h⟩ => h ▸ (e.symm i).2, fun hσ => ⟨e ⟨σ, hσ⟩, by simp⟩⟩
  exact ⟨⟨fun i => (e.symm i).1, Subtype.val_injective.comp e.symm.injective,
    by rwa [himage]⟩, himage⟩

/-! ### The arrows at a diagonal -/

/-- The triangles carrying an arrow into `{a, c}`: `{a, b, c}` from `{b, c}` and `{a, c, d}`
from `{d, a}`. -/
private theorem IsFlipQuadrilateral.arrowTriangles_into {m : ℕ} [NeZero m]
    {T : Finset (Sym2 (ZMod m))}
    {a b c d : ZMod m} (hb : sbtw a b c) (hd : sbtw c d a)
    (htri : ∀ t, (IsTriangle T t ∧ a ∈ t ∧ c ∈ t) ↔ t = {a, b, c} ∨ t = {a, c, d})
    (σ : Sym2 (ZMod m)) :
    arrowTriangles T σ s(a, c) =
      (if σ = s(b, c) then {{a, b, c}} else ∅) ∪ (if σ = s(d, a) then {{a, c, d}} else ∅) := by
  ext t
  simp only [mem_arrowTriangles, Finset.mem_union]
  constructor
  · rintro ⟨ht, x, y, z, hxyz, rfl, hyz, hx, hy, hz⟩
    have hxy : x ≠ y := fun h => sbtw_irrefl_left (h ▸ hxyz)
    have hxz : x ≠ z := fun h => sbtw_irrefl_left_right (h ▸ hxyz)
    rcases Sym2.eq_iff.1 hyz with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · rcases (htri t).1 ⟨ht, hy, hz⟩ with rfl | rfl
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl | rfl
        · exact absurd rfl hxy
        · exact absurd (sbtw_cyclic_left (sbtw_cyclic_left hxyz)) (sbtw_asymm hb)
        · exact absurd rfl hxz
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl | rfl
        · exact absurd rfl hxy
        · exact absurd rfl hxz
        · exact Or.inr (by simp)
    · rcases (htri t).1 ⟨ht, hz, hy⟩ with rfl | rfl
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl | rfl
        · exact absurd rfl hxz
        · exact Or.inl (by simp)
        · exact absurd rfl hxy
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl | rfl
        · exact absurd rfl hxz
        · exact absurd rfl hxy
        · exact absurd (sbtw_cyclic_right hxyz) (sbtw_asymm hd)
  · rintro (h | h)
    · split_ifs at h with hσ
      · rw [Finset.mem_singleton] at h
        subst h hσ
        exact ⟨((htri _).2 (Or.inl rfl)).1, b, c, a, sbtw_cyclic_left hb, rfl, Sym2.eq_swap,
          by simp, by simp, by simp⟩
      · simp at h
    · split_ifs at h with hσ
      · rw [Finset.mem_singleton] at h
        subst h hσ
        exact ⟨((htri _).2 (Or.inr rfl)).1, d, a, c, sbtw_cyclic_left hd, rfl, rfl,
          by simp, by simp, by simp⟩
      · simp at h

/-- The triangles carrying an arrow out of `{a, c}`: `{a, b, c}` to `{a, b}` and `{a, c, d}`
to `{c, d}`. -/
private theorem IsFlipQuadrilateral.arrowTriangles_out {m : ℕ} [NeZero m]
    {T : Finset (Sym2 (ZMod m))}
    {a b c d : ZMod m} (hb : sbtw a b c) (hd : sbtw c d a)
    (htri : ∀ t, (IsTriangle T t ∧ a ∈ t ∧ c ∈ t) ↔ t = {a, b, c} ∨ t = {a, c, d})
    (σ : Sym2 (ZMod m)) :
    arrowTriangles T s(a, c) σ =
      (if σ = s(a, b) then {{a, b, c}} else ∅) ∪ (if σ = s(c, d) then {{a, c, d}} else ∅) := by
  ext t
  simp only [mem_arrowTriangles, Finset.mem_union]
  constructor
  · rintro ⟨ht, x, y, z, hxyz, hxy', rfl, hx, hy, hz⟩
    have hzy : z ≠ y := fun h => sbtw_irrefl_right (h ▸ hxyz)
    have hxz : z ≠ x := fun h => sbtw_irrefl_left_right (h ▸ hxyz)
    rcases Sym2.eq_iff.1 hxy' with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · rcases (htri t).1 ⟨ht, hx, hy⟩ with rfl | rfl
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl | rfl
        · exact absurd rfl hxz
        · exact absurd (sbtw_cyclic_right (sbtw_cyclic_right hxyz)) (sbtw_asymm hb)
        · exact absurd rfl hzy
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl | rfl
        · exact absurd rfl hxz
        · exact absurd rfl hzy
        · exact Or.inr (by simp)
    · rcases (htri t).1 ⟨ht, hy, hx⟩ with rfl | rfl
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl | rfl
        · exact absurd rfl hzy
        · exact Or.inl (by simp)
        · exact absurd rfl hxz
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl | rfl
        · exact absurd rfl hzy
        · exact absurd rfl hxz
        · exact absurd (sbtw_cyclic_left hxyz) (sbtw_asymm hd)
  · rintro (h | h)
    · split_ifs at h with hσ
      · rw [Finset.mem_singleton] at h
        subst h hσ
        exact ⟨((htri _).2 (Or.inl rfl)).1, c, a, b, sbtw_cyclic_right hb, Sym2.eq_swap, rfl,
          by simp, by simp, by simp⟩
      · simp at h
    · split_ifs at h with hσ
      · rw [Finset.mem_singleton] at h
        subst h hσ
        exact ⟨((htri _).2 (Or.inr rfl)).1, a, c, d, sbtw_cyclic_right hd, rfl, rfl,
          by simp, by simp, by simp⟩
      · simp at h

/-- The four sides of a quadrilateral with distinct vertices `a, b, c, d` are distinct. -/
theorem sym2_quadrilateral_sides_ne {α : Type*} {a b c d : α} (hab : a ≠ b) (hac : a ≠ c)
    (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    s(b, c) ≠ s(d, a) ∧ s(b, c) ≠ s(a, b) ∧ s(b, c) ≠ s(c, d) ∧ s(d, a) ≠ s(a, b) ∧
      s(d, a) ≠ s(c, d) ∧ s(a, b) ≠ s(c, d) := by
  simp only [Ne, Sym2.eq_iff]
  tauto

/-- **The arrows at a diagonal of a triangulation.** For `γ = {a, c} ∈ T` with apexes `b` and
`d`, `β_T(σ, γ)` is `1` for `σ ∈ {{b, c}, {d, a}}`, `-1` for `σ ∈ {{a, b}, {c, d}}`, and `0`
otherwise, for every `σ`. -/
@[cluster_algebras "lem_type_A_column"]
theorem IsFlipQuadrilateral.signedCount_polygonArrows {m : ℕ} [NeZero m] (hm : 4 ≤ m)
    {T : Finset (Sym2 (ZMod m))} (hT : IsTriangulation T) {a b c d : ZMod m}
    (hγ : s(a, c) ∈ T) (hq : IsFlipQuadrilateral T a b c d) (σ : Sym2 (ZMod m)) :
    signedCount (polygonArrows T) σ s(a, c) =
      if σ = s(b, c) ∨ σ = s(d, a) then 1 else if σ = s(a, b) ∨ σ = s(c, d) then -1 else 0 := by
  have htri := hq.isTriangle_iff hm hT hγ
  obtain ⟨hb, hd, -⟩ := hq
  have hγs : ¬IsSide s(a, c) := (hT.isDiagonal _ hγ).2
  have e1 : polygonArrows T σ s(a, c) = (arrowTriangles T σ s(a, c)).card := by
    unfold polygonArrows
    exact if_neg fun h => hγs h.2
  have e2 : polygonArrows T s(a, c) σ = (arrowTriangles T s(a, c) σ).card := by
    unfold polygonArrows
    exact if_neg fun h => hγs h.1
  rw [signedCount, e1, e2, IsFlipQuadrilateral.arrowTriangles_into hb hd htri,
    IsFlipQuadrilateral.arrowTriangles_out hb hd htri]
  obtain ⟨⟨hab, hac, had, hbc, hbd, hcd⟩, -⟩ := quadrilateral_cross hb hd
  obtain ⟨n1, n2, n3, n4, n5, n6⟩ := sym2_quadrilateral_sides_ne hab hac had hbc hbd hcd
  by_cases h1 : σ = s(b, c)
  · subst h1
    simp [n1, n2, n3]
  by_cases h2 : σ = s(d, a)
  · subst h2
    simp [n1.symm, n4, n5]
  by_cases h3 : σ = s(a, b)
  · subst h3
    simp [n2.symm, n4.symm, n6]
  by_cases h4 : σ = s(c, d)
  · subst h4
    simp [n3.symm, n5.symm, n6.symm]
  simp [h1, h2, h3, h4]

/-! ### The Plücker field and the Plücker seeds -/

section Plucker

variable (K : Type*) [Field K] (n : ℕ)

/-- The field `K(z)` of rational functions in the `2(n+3)` indeterminates `z_{ij}`. -/
abbrev PluckerAmbient : Type _ :=
  FractionRing (MvPolynomial (Fin 2 × Fin (n + 3)) K)

/-- The matrix `z = (z_{ij})` over `K(z)`: the image of the generic `2 × (n+3)` matrix under the
ring homomorphism `ℤ[z] → K(z)` fixing every `z_{ij}`. -/
@[cluster_algebras "def_type_A_plucker_seed"]
noncomputable def pluckerMatrix : Matrix (Fin 2) (Fin (n + 3)) (PluckerAmbient K n) :=
  (genericMatrix (Fin 2) (Fin (n + 3))).map
    ((algebraMap (MvPolynomial (Fin 2 × Fin (n + 3)) K) (PluckerAmbient K n)).comp
      (MvPolynomial.map (Int.castRingHom K)))

/-- The Plücker coordinate `P_σ(z) ∈ K(z)` of a segment `σ` (`segmentPlucker`). -/
@[cluster_algebras "def_type_A_plucker_seed"]
noncomputable def pluckerFn (σ : Sym2 (ZMod (n + 3))) : PluckerAmbient K n :=
  segmentPlucker (pluckerMatrix K n) σ

/-- `P_σ` lies in `K[z]`: it is the image of the Plücker coordinate of the generic matrix over
`K`. -/
@[cluster_algebras "def_type_A_plucker_seed"]
theorem pluckerFn_eq_algebraMap (σ : Sym2 (ZMod (n + 3))) :
    pluckerFn K n σ = algebraMap (MvPolynomial (Fin 2 × Fin (n + 3)) K) (PluckerAmbient K n)
      (segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K) σ) := by
  rw [RingHom.map_segmentPlucker, pluckerFn, pluckerMatrix]
  congr 1
  ext i j
  simp [Matrix.mvPolynomialX_apply]

/-- The **Plücker field** `𝓕ₙ` over `K`: the subfield of `K(z)` generated over `K` by the
Plücker coordinates `P_σ` of all segments `σ` of the `(n+3)`-gon. -/
@[cluster_algebras "def_type_A_plucker_seed"]
noncomputable def pluckerField : IntermediateField K (PluckerAmbient K n) :=
  IntermediateField.adjoin K (pluckerFn K n '' {σ | IsSegment σ})

/-- The Plücker coordinate `P_σ` as an element of the Plücker field, for a segment `σ`; `0` for
a non-segment. -/
@[cluster_algebras "def_type_A_plucker_seed"]
noncomputable def pluckerVar (σ : Sym2 (ZMod (n + 3))) : pluckerField K n :=
  if h : IsSegment σ then
    ⟨pluckerFn K n σ, IntermediateField.subset_adjoin K _ ⟨σ, h, rfl⟩⟩
  else 0

variable {n} in
/-- The **Plücker seed** `Σ(T, λ) = (x̃(T, λ), B̃(T, λ))` of a labelled triangulation, with
`x̃(T, λ) = (P_{λ̂(1)}, …, P_{λ̂(2n+3)})` in the Plücker field. -/
@[cluster_algebras "def_type_A_plucker_seed"]
noncomputable def pluckerSeed (L : LabelledTriangulation n) :
    SeedData (pluckerField K n) (2 * n + 3) n where
  extCluster i := pluckerVar K n (L.extLabel i)
  extExchangeMatrix := L.extMatrix

/-- The Plücker coordinate of a segment, in the Plücker field, is `P_σ`. -/
@[simp]
theorem coe_pluckerVar {σ : Sym2 (ZMod (n + 3))} (hσ : IsSegment σ) :
    (pluckerVar K n σ : PluckerAmbient K n) = pluckerFn K n σ := by
  simp [pluckerVar, hσ]

/-- The evaluation of `P_{a'b'}(z)`, `a' < b'`, at the matrix with entries `1` at `(0, a)` and
`(1, b)` and `0` elsewhere. -/
private theorem eval_pluckerCoord_mvPolynomialX_indicator
    {κ : Type*} [LinearOrder κ] {a b a' b' : κ} (hab : a < b) (hab' : a' < b') :
    MvPolynomial.eval (fun p : Fin 2 × κ => if p = (0, a) ∨ p = (1, b) then (1 : K) else 0)
        (pluckerCoord (Matrix.mvPolynomialX (Fin 2) κ K) {a', b'}) =
      if a' = a ∧ b' = b then 1 else 0 := by
  rw [pluckerCoord_pair _ hab']
  have h1 : ¬(b' = a ∧ a' = b) := fun h => by
    obtain ⟨rfl, rfl⟩ := h
    exact lt_asymm hab hab'
  by_cases h : a' = a ∧ b' = b
  · obtain ⟨rfl, rfl⟩ := h
    simp [Matrix.mvPolynomialX_apply, hab.ne, hab.ne']
  · simp only [Matrix.mvPolynomialX_apply, map_sub, map_mul, MvPolynomial.eval_X, Prod.mk.injEq,
      Fin.isValue, zero_ne_one, false_and, one_ne_zero, true_and, false_or,
      or_false, if_neg h]
    split_ifs <;> simp_all

/-- A Plücker coordinate of the generic matrix over `K` on two distinct columns is nonzero. -/
private theorem pluckerCoord_mvPolynomialX_ne_zero {κ : Type*} [LinearOrder κ]
    {a b : κ} (hab : a ≠ b) : pluckerCoord (Matrix.mvPolynomialX (Fin 2) κ K) {a, b} ≠ 0 := by
  wlog h : a < b generalizing a b
  · rw [Finset.pair_comm]
    exact this hab.symm (lt_of_le_of_ne (not_lt.1 h) hab.symm)
  intro h0
  have := congrArg
    (MvPolynomial.eval fun p : Fin 2 × κ => if p = (0, a) ∨ p = (1, b) then (1 : K) else 0) h0
  rw [eval_pluckerCoord_mvPolynomialX_indicator K h h] at this
  simp at this

/-- A segment is `{u, v}` with the representative of `u` below that of `v`. -/
private theorem exists_eq_mk_vertexRep_lt {m : ℕ} [NeZero m] {σ : Sym2 (ZMod m)}
    (hσ : IsSegment σ) : ∃ u v, σ = s(u, v) ∧ vertexRep u < vertexRep v := by
  induction σ using Sym2.ind with
  | _ u v =>
    have huv : vertexRep u ≠ vertexRep v :=
      vertexRep_injective.ne fun h => hσ (Sym2.mk_isDiag_iff.2 h)
    rcases huv.lt_or_gt with h | h
    · exact ⟨u, v, rfl, h⟩
    · exact ⟨v, u, Sym2.eq_swap, h⟩

/-- **Plücker coordinates of distinct segments are distinct: nonzero in `K[z]`.** -/
@[cluster_algebras "lem_type_A_plucker_injective"]
theorem segmentPlucker_mvPolynomialX_ne_zero {σ : Sym2 (ZMod (n + 3))} (hσ : IsSegment σ) :
    segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K) σ ≠ 0 := by
  induction σ using Sym2.ind with
  | _ u v =>
    rw [segmentPlucker_mk]
    exact pluckerCoord_mvPolynomialX_ne_zero K
      (vertexRep_injective.ne fun h => hσ (Sym2.mk_isDiag_iff.2 h))


/-- **Plücker coordinates of distinct segments are distinct: nonzero.** -/
@[cluster_algebras "lem_type_A_plucker_injective"]
theorem pluckerVar_ne_zero {σ : Sym2 (ZMod (n + 3))} (hσ : IsSegment σ) :
    pluckerVar K n σ ≠ 0 := by
  intro h
  have h' := congrArg Subtype.val h
  rw [coe_pluckerVar K n hσ, pluckerFn_eq_algebraMap, ZeroMemClass.coe_zero,
    map_eq_zero_iff _ (IsFractionRing.injective _ _)] at h'
  exact segmentPlucker_mvPolynomialX_ne_zero K n hσ h'


/-- **Plücker coordinates of distinct segments are distinct.** -/
@[cluster_algebras "lem_type_A_plucker_injective"]
theorem injOn_pluckerVar : Set.InjOn (pluckerVar K n) {σ | IsSegment σ} := by
  intro σ hσ σ' hσ' h
  have h' := congrArg Subtype.val h
  rw [coe_pluckerVar K n hσ, coe_pluckerVar K n hσ', pluckerFn_eq_algebraMap,
    pluckerFn_eq_algebraMap] at h'
  have h'' := IsFractionRing.injective _ _ h'
  obtain ⟨u, v, rfl, huv⟩ := exists_eq_mk_vertexRep_lt hσ
  obtain ⟨u', v', rfl, huv'⟩ := exists_eq_mk_vertexRep_lt hσ'
  rw [segmentPlucker_mk, segmentPlucker_mk] at h''
  have := congrArg (MvPolynomial.eval fun p : Fin 2 × Fin (n + 3) =>
    if p = (0, vertexRep u) ∨ p = (1, vertexRep v) then (1 : K) else 0) h''
  rw [eval_pluckerCoord_mvPolynomialX_indicator K huv huv,
    eval_pluckerCoord_mvPolynomialX_indicator K huv huv', if_pos ⟨rfl, rfl⟩] at this
  split_ifs at this with h1
  · rw [vertexRep_injective h1.1, vertexRep_injective h1.2]
  · simp at this

/-- **The Plücker coordinates of a triangulation generate the Plücker field.** For a
triangulation `T`, every `P_ζ`, `ζ` a segment, lies in the subfield
`K(P_σ : σ a segment of T)` of `K(z)`. -/
@[cluster_algebras "lem_type_A_plucker_generate"]
theorem IsTriangulation.pluckerFn_mem_adjoin [CharZero K] {T : Finset (Sym2 (ZMod (n + 3)))}
    (hT : IsTriangulation T) {ζ : Sym2 (ZMod (n + 3))} (hζ : IsSegment ζ) :
    pluckerFn K n ζ ∈ IntermediateField.adjoin K (pluckerFn K n '' ↑(segments T)) := by
  obtain ⟨P, Q, -, -, hQ, hPQ⟩ := isSubtractionFree_segmentPlucker hT hζ
  set ι : MvPolynomial (Fin 2 × Fin (n + 3)) ℤ →+* PluckerAmbient K n :=
    (algebraMap (MvPolynomial (Fin 2 × Fin (n + 3)) K) (PluckerAmbient K n)).comp
      (MvPolynomial.map (Int.castRingHom K)) with hιdef
  have hι : Function.Injective ι := by
    rw [hιdef, RingHom.coe_comp]
    exact (IsFractionRing.injective _ _).comp
      (MvPolynomial.map_injective _ (Int.cast_injective (α := K)))
  have hfn : ∀ σ, pluckerFn K n σ = ι (segmentPlucker (genericMatrix (Fin 2) (Fin (n + 3))) σ) :=
    fun σ => (RingHom.map_segmentPlucker ι _ σ).symm
  set F' := IntermediateField.adjoin K (pluckerFn K n '' ↑(segments T))
  have hmem : ∀ R : MvPolynomial (SegmentType T) ℕ,
      ι (MvPolynomial.aeval (grassmannExtendedCluster T) R) ∈ F' := by
    intro R
    induction R using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq => simpa using add_mem hp hq
    | mul_X p s hp =>
      rw [map_mul, MvPolynomial.aeval_X, map_mul]
      refine mul_mem hp ?_
      rw [grassmannExtendedCluster, ← hfn]
      exact IntermediateField.subset_adjoin K _ ⟨s.1, s.2, rfl⟩
  have hQ' : ι (MvPolynomial.aeval (grassmannExtendedCluster T) Q) ≠ 0 :=
    (map_ne_zero_iff ι hι).2 hQ
  have h := congrArg ι hPQ
  rw [map_mul] at h
  rw [hfn ζ, eq_div_of_mul_eq hQ' ((mul_comm _ _).trans h)]
  exact div_mem (hmem P) (hmem Q)

variable {n} in
/-- The entries of `x̃(T, λ)`, in `K(z)`, are the `P_σ` for the segments `σ` of `T`. -/
private theorem LabelledTriangulation.image_val_range_pluckerSeed (L : LabelledTriangulation n) :
    Subtype.val '' Set.range (pluckerSeed K L).extCluster =
      pluckerFn K n '' ↑(segments L.triangulation) := by
  ext x
  simp only [Set.mem_image, Set.mem_range, Finset.mem_coe]
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    exact ⟨L.extLabel i, L.extLabel_mem_segments i,
      (coe_pluckerVar K n (L.isSegment_extLabel i)).symm⟩
  · rintro ⟨σ, hσ, rfl⟩
    obtain ⟨i, rfl⟩ := L.exists_extLabel_eq hσ
    exact ⟨_, ⟨i, rfl⟩, coe_pluckerVar K n (L.isSegment_extLabel i)⟩

variable {n} in
/-- **The Plücker coordinates of a triangulation generate the Plücker field**:
`𝓕ₙ = K(x̃(T, λ))` for every labelled triangulation. -/
@[cluster_algebras "lem_type_A_plucker_generate"]
theorem LabelledTriangulation.adjoin_range_pluckerSeed [CharZero K]
    (L : LabelledTriangulation n) :
    IntermediateField.adjoin K (Set.range (pluckerSeed K L).extCluster) = ⊤ := by
  rw [← IntermediateField.lift_inj, IntermediateField.lift_adjoin, IntermediateField.lift_top,
    L.image_val_range_pluckerSeed K]
  refine le_antisymm (IntermediateField.adjoin.mono _ _ _ ?_) ?_
  · rintro _ ⟨σ, hσ, rfl⟩
    obtain ⟨i, rfl⟩ := L.exists_extLabel_eq hσ
    exact ⟨_, L.isSegment_extLabel i, rfl⟩
  · rw [pluckerField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨σ, hσ, rfl⟩
    exact IsTriangulation.pluckerFn_mem_adjoin K n L.isTriangulation hσ

/-! ### The segments of the fan -/

/-- The vertex `n + 2` of the `(n+3)`-gon is followed by the vertex `0`. -/
private theorem natCast_add_two_add_one (n : ℕ) :
    (((n + 2 : ℕ) : ZMod (n + 3)) + 1) = 0 := by
  rw [show ((n + 2 : ℕ) : ZMod (n + 3)) + 1 = ((n + 3 : ℕ) : ZMod (n + 3)) by push_cast; ring,
    ZMod.natCast_self]

/-- The segments of the fan `T∘` of the `(n+3)`-gon are among the `s(0, j)`, `j ∈ [1, n+2]`, and
the sides `s(l, l+1)`, `l ∈ [1, n+1]`. -/
private theorem mem_segments_fanTriangulation_cases {n : ℕ} {σ : Sym2 (ZMod (n + 3))}
    (hσ : σ ∈ segments (fanTriangulation (n + 3))) :
    (∃ j : ℕ, 1 ≤ j ∧ j ≤ n + 2 ∧ σ = s(0, (j : ZMod (n + 3)))) ∨
      ∃ l : ℕ, 1 ≤ l ∧ l ≤ n + 1 ∧ σ = s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) := by
  rcases mem_segments.1 hσ with hσ | ⟨i, rfl⟩
  · simp only [fanTriangulation, Finset.mem_image, Finset.mem_Icc] at hσ
    obtain ⟨j, ⟨h1, h2⟩, rfl⟩ := hσ
    exact Or.inl ⟨j, by omega, by omega, rfl⟩
  · have hv := i.val_lt
    rw [← ZMod.natCast_zmod_val i]
    by_cases h0 : i.val = 0
    · exact Or.inl ⟨1, le_rfl, by omega, by simp [h0]⟩
    by_cases h2 : i.val = n + 2
    · refine Or.inl ⟨n + 2, by omega, le_rfl, ?_⟩
      rw [h2, natCast_add_two_add_one, Sym2.eq_swap]
    · exact Or.inr ⟨i.val, by omega, by omega, rfl⟩

/-- The segments `s(0, j)`, `j ∈ [1, n+2]`, are segments of the fan. -/
private theorem zero_natCast_mem_segments_fanTriangulation {n j : ℕ} (h1 : 1 ≤ j)
    (h2 : j ≤ n + 2) : s(0, (j : ZMod (n + 3))) ∈ segments (fanTriangulation (n + 3)) := by
  rw [mem_segments]
  by_cases hj1 : j = 1
  · subst hj1
    exact Or.inr ⟨0, by simp⟩
  by_cases hj2 : j = n + 2
  · subst hj2
    exact Or.inr ⟨((n + 2 : ℕ) : ZMod (n + 3)), by rw [natCast_add_two_add_one, Sym2.eq_swap]⟩
  · left
    simp only [fanTriangulation, Finset.mem_image, Finset.mem_Icc]
    exact ⟨j, ⟨by omega, by omega⟩, rfl⟩

/-- The representative of the vertex `j < m` is the column `j`. -/
private theorem vertexRep_natCast_of_lt {m j : ℕ} [NeZero m] (hj : j < m) :
    vertexRep (j : ZMod m) = ⟨j, hj⟩ :=
  vertexRep_natCast_val ⟨j, hj⟩

/-- A segment of the fan is a segment. -/
private theorem isSegment_of_mem_segments_fanTriangulation {n : ℕ} {σ : Sym2 (ZMod (n + 3))}
    (hσ : σ ∈ segments (fanTriangulation (n + 3))) : IsSegment σ := by
  rcases mem_segments_fanTriangulation_cases hσ with ⟨j, h1, h2, rfl⟩ | ⟨l, h1, h2, rfl⟩
  · intro hd
    rw [Sym2.mk_isDiag_iff] at hd
    have := congrArg ZMod.val hd
    rw [ZMod.val_zero, ZMod.val_natCast, Nat.mod_eq_of_lt (by omega)] at this
    omega
  · intro hd
    rw [Sym2.mk_isDiag_iff] at hd
    have h3 : ((l + 1 : ℕ) : ZMod (n + 3)) = l := by exact_mod_cast hd.symm
    have := (natCast_inj_of_lt (m := n + 3) (by omega) (by omega)).1 h3
    omega

/-- The point `z_{1,1} = 1`, `z_{2,1} = 0`, `z_{2,j} = G_j`, `z_{1,j} = α_j` of
`E^{2 × (n+3)}`, with `α_j = -G_j ∑_{1 ≤ l < j} S_l / (G_l G_{l+1})` (columns indexed
from `0`). -/
private noncomputable def fanPoint {E : Type*} [Field E] (G S : ℕ → E) :
    Fin 2 × Fin (n + 3) → E := fun p =>
  if p.1 = 0 then
    (if (p.2 : ℕ) = 0 then 1 else -(G p.2 * ∑ l ∈ Finset.Ico 1 (p.2 : ℕ), S l / (G l * G (l + 1))))
  else (if (p.2 : ℕ) = 0 then 0 else G p.2)

/-- At `fanPoint`, the Plücker coordinate of `s(0, j)`, `j ∈ [1, n+2]`, is `G j`. -/
private theorem aeval_fanPoint_zero {E : Type*} [Field E] [Algebra K E] (G S : ℕ → E) {j : ℕ}
    (h1 : 1 ≤ j) (h2 : j ≤ n + 2) :
    MvPolynomial.aeval (fanPoint n G S)
      (segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K) s(0, (j : ZMod (n + 3)))) =
      G j := by
  have h0 : vertexRep (0 : ZMod (n + 3)) = ⟨0, by omega⟩ := by
    rw [← Nat.cast_zero, vertexRep_natCast_of_lt]
  rw [segmentPlucker_mk, h0, vertexRep_natCast_of_lt (by omega : j < n + 3),
    pluckerCoord_pair _ (by simp only [Fin.mk_lt_mk]; omega)]
  have hj : j ≠ 0 := by omega
  simp only [Matrix.mvPolynomialX_apply, map_sub, map_mul, MvPolynomial.aeval_X, fanPoint,
    Fin.isValue, if_true, one_ne_zero, if_false, hj]
  simp

/-- At `fanPoint`, the Plücker coordinate of the side `s(l, l+1)`, `l ∈ [1, n+1]`, is `S l` when
the `G j` are nonzero. -/
private theorem aeval_fanPoint_side {E : Type*} [Field E] [Algebra K E] {G : ℕ → E} (S : ℕ → E)
    (hG : ∀ j, 1 ≤ j → j ≤ n + 2 → G j ≠ 0) {l : ℕ} (h1 : 1 ≤ l) (h2 : l ≤ n + 1) :
    MvPolynomial.aeval (fanPoint n G S)
      (segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K)
        s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1)) = S l := by
  have h0 : vertexRep ((l : ZMod (n + 3)) + 1) = ⟨l + 1, by omega⟩ := by
    rw [← Nat.cast_succ, vertexRep_natCast_of_lt]
  rw [segmentPlucker_mk, h0, vertexRep_natCast_of_lt (by omega : l < n + 3),
    pluckerCoord_pair _ (by simp only [Fin.mk_lt_mk]; omega)]
  have hl : l ≠ 0 := by omega
  have hl' : l + 1 ≠ 0 := by omega
  simp only [Matrix.mvPolynomialX_apply, map_sub, map_mul, MvPolynomial.aeval_X, fanPoint,
    Fin.isValue, if_true, one_ne_zero, if_false, hl, hl']
  rw [Finset.sum_Ico_succ_top h1]
  have hcancel : G (l + 1) * (S l / (G l * G (l + 1))) * G l = S l := by
    calc _ = S l / (G l * G (l + 1)) * (G l * G (l + 1)) := by ring
      _ = S l := div_mul_cancel₀ _ (mul_ne_zero (hG l h1 (by omega)) (hG _ (by omega) (by omega)))
  linear_combination hcancel

/-- **The Plücker coordinates of the fan are algebraically independent**: the `2(n+3) - 3`
coordinates `P_σ`, `σ` a segment of the fan `T∘`, are algebraically independent over `K`. -/
@[cluster_algebras "lem_type_A_fan_independent"]
theorem algebraicIndependent_pluckerVar_fanTriangulation :
    AlgebraicIndependent K
      fun σ : SegmentType (fanTriangulation (n + 3)) => pluckerVar K n σ.1 := by
  classical
  set ι := SegmentType (fanTriangulation (n + 3))
  set E := FractionRing (MvPolynomial ι K)
  have hinjE : Function.Injective (algebraMap (MvPolynomial ι K) E) :=
    IsFractionRing.injective _ _
  set Y : Sym2 (ZMod (n + 3)) → E := fun σ =>
    if h : σ ∈ segments (fanTriangulation (n + 3)) then
      algebraMap (MvPolynomial ι K) E (MvPolynomial.X (⟨σ, h⟩ : ι)) else 0
  have hY : ∀ σ : ι, Y σ.1 = algebraMap (MvPolynomial ι K) E (MvPolynomial.X σ) := fun σ =>
    dif_pos σ.2
  set G : ℕ → E := fun j => Y s(0, (j : ZMod (n + 3)))
  set S : ℕ → E := fun l => Y s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1)
  have hG : ∀ j, 1 ≤ j → j ≤ n + 2 → G j ≠ 0 := fun j h1 h2 => by
    rw [show G j = _ from hY ⟨_, zero_natCast_mem_segments_fanTriangulation h1 h2⟩, Ne,
      map_eq_zero_iff _ hinjE]
    exact MvPolynomial.X_ne_zero _
  set φ := MvPolynomial.aeval (R := K) (fanPoint n G S)
  have key : ∀ σ : ι, φ (segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K) σ.1) =
      algebraMap (MvPolynomial ι K) E (MvPolynomial.X σ) := by
    intro σ
    rw [← hY]
    obtain ⟨σ, hσ⟩ := σ
    rcases mem_segments_fanTriangulation_cases hσ with ⟨j, h1, h2, rfl⟩ | ⟨l, h1, h2, rfl⟩
    · exact aeval_fanPoint_zero K n G S h1 h2
    · exact aeval_fanPoint_side K n S hG h1 h2
  have h1 : AlgebraicIndependent K
      fun σ : ι => segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K) σ.1 := by
    refine AlgebraicIndependent.of_comp φ ?_
    have : (φ ∘ fun σ : ι => segmentPlucker (Matrix.mvPolynomialX (Fin 2) (Fin (n + 3)) K) σ.1) =
        (IsScalarTower.toAlgHom K (MvPolynomial ι K) E) ∘ MvPolynomial.X := funext key
    rw [this]
    exact (MvPolynomial.algebraicIndependent_X ι K).map' hinjE
  have h2 := h1.map' (f := IsScalarTower.toAlgHom K (MvPolynomial (Fin 2 × Fin (n + 3)) K)
    (PluckerAmbient K n)) (IsFractionRing.injective _ _)
  refine AlgebraicIndependent.of_comp (pluckerField K n).val ?_
  convert h2 using 1
  funext σ
  simp only [Function.comp_apply, IntermediateField.coe_val, IsScalarTower.coe_toAlgHom']
  rw [coe_pluckerVar K n (isSegment_of_mem_segments_fanTriangulation σ.2), pluckerFn_eq_algebraMap]

variable {n} in
/-- The flipped labelled triangulation `(T', λ')`: `λ'` replaces `λ(k)` by its replacement `γ'`
and keeps every other label. -/
private theorem LabelledTriangulation.exists_label_eq_update (L : LabelledTriangulation n)
    (k : Fin n) {γ' : Sym2 (ZMod (n + 3))}
    (h : IsFlipReplacement L.triangulation (L.label k) γ') :
    ∃ L' : LabelledTriangulation n, L'.label = Function.update L.label k γ' ∧
      L'.triangulation = flipTriangulation L.triangulation (L.label k) γ' := by
  have hnot : ∀ i, L.label i ≠ γ' := fun i hi => h.2.2.2.1 (hi ▸ L.label_mem_triangulation i)
  have hinj : Function.Injective (Function.update L.label k γ') := by
    intro i j hij
    by_cases hi : i = k <;> by_cases hj : j = k
    · rw [hi, hj]
    · rw [hi, Function.update_self, Function.update_of_ne hj] at hij
      exact absurd hij.symm (hnot j)
    · rw [hj, Function.update_self, Function.update_of_ne hi] at hij
      exact absurd hij (hnot i)
    · rw [Function.update_of_ne hi, Function.update_of_ne hj] at hij
      exact L.injective hij
  have himage : Finset.univ.image (Function.update L.label k γ') =
      flipTriangulation L.triangulation (L.label k) γ' := by
    ext σ
    simp only [Finset.mem_image, Finset.mem_univ, true_and, flipTriangulation,
      Finset.mem_insert, Finset.mem_erase, L.mem_triangulation_iff]
    constructor
    · rintro ⟨i, rfl⟩
      by_cases hi : i = k
      · exact Or.inl (by rw [hi, Function.update_self])
      · right
        rw [Function.update_of_ne hi]
        exact ⟨fun h' => hi (L.injective h'), i, rfl⟩
    · rintro (rfl | ⟨hne, i, rfl⟩)
      · exact ⟨k, Function.update_self _ _ _⟩
      · have hi : i ≠ k := fun h' => hne (h' ▸ rfl)
        exact ⟨i, Function.update_of_ne hi _ _⟩
  exact ⟨⟨_, hinj, himage ▸ h.2.2.2.2⟩, rfl, himage⟩

/-- A product `∏ xᵢ ^ eᵢ` over the rows where `p` holds, when `p` holds at exactly two distinct
rows and `e` is `1` at both: the shape of an exchange monomial of a Plücker seed. -/
private theorem prod_filter_eq_mul_of_iff {F : Type*} [Field F] {M : ℕ} (x : Fin M → F)
    (e : Fin M → ℤ) {p : Fin M → Prop} [DecidablePred p] {i₁ i₂ : Fin M} (h12 : i₁ ≠ i₂)
    (hp : ∀ i, p i ↔ i = i₁ ∨ i = i₂) (h₁ : e i₁ = 1) (h₂ : e i₂ = 1) :
    ∏ i ∈ Finset.univ.filter p, x i ^ e i = x i₁ * x i₂ := by
  have hfilter : Finset.univ.filter p = {i₁, i₂} := by
    ext i
    simp [hp]
  rw [hfilter, Finset.prod_pair h12, h₁, h₂, zpow_one, zpow_one]

variable {n} in
/-- The extended labelling of the flip `(T', λ')` of `(T, λ)` at `λ(k)`: `λ̂'` replaces `λ(k)` by
its replacement `γ'` and keeps every other value of `λ̂`. -/
private theorem LabelledTriangulation.extLabel_eq_ite_of_label_eq_update
    {L L' : LabelledTriangulation n} {k : Fin n} {γ' : Sym2 (ZMod (n + 3))}
    (hL' : L'.label = Function.update L.label k γ') (i : Fin (2 * n + 3)) :
    L'.extLabel i = if L.extLabel i = L.label k then γ' else L.extLabel i := by
  by_cases hi : (i : ℕ) < n
  · rw [L'.extLabel_of_lt hi, L.extLabel_of_lt hi, hL', Function.update_apply]
    by_cases hik : (⟨i, hi⟩ : Fin n) = k
    · rw [if_pos hik, if_pos (congrArg L.label hik)]
    · rw [if_neg hik, if_neg fun h' => hik (L.injective h')]
  · have hs := (L.isSide_extLabel_iff i).2 (by omega)
    rw [if_neg fun h' : L.extLabel i = L.label k => (L.isDiagonal_label k).2 (h' ▸ hs),
      L'.extLabel_of_le (by omega), L.extLabel_of_le (by omega)]

variable {n} in
/-- The extended exchange matrix of the flip `(T', λ')` of `(T, λ)` at `λ(k)` is the mutation of
`B̃(T, λ)` in direction `k`. -/
private theorem LabelledTriangulation.matrixMutation_extMatrix_of_flip
    {L L' : LabelledTriangulation n} {k : Fin n} {γ' : Sym2 (ZMod (n + 3))}
    (h : IsFlipReplacement L.triangulation (L.label k) γ')
    (hL' : L'.label = Function.update L.label k γ')
    (hT' : L'.triangulation = flipTriangulation L.triangulation (L.label k) γ') :
    matrixMutation (le_two_mul_add_three n) L.extMatrix k = L'.extMatrix := by
  obtain ⟨Λ, hΛ, hB, -⟩ := L.exists_labelling
  have hk : (⟨L.label k, mem_segments.2 (Or.inl h.2.1)⟩ : SegmentType L.triangulation) ∉
      (polygonQuiver L.triangulation).frozen := fun h' =>
    (L.isDiagonal_label k).2 (Finset.mem_filter.1 h').2
  obtain ⟨e, he⟩ := polygonQuiver_mutate_iso_flip h hk
  have hv : Λ.equiv (Fin.castLE Λ.le k) = ⟨L.label k, mem_segments.2 (Or.inl h.2.1)⟩ :=
    Subtype.ext (by rw [hΛ, extLabel_castLE])
  rw [← hB, ← extExchangeMatrix_mutate (polygonQuiver L.triangulation) Λ k]
  ext i j
  simp only [extExchangeMatrix, Matrix.of_apply, Labelling.equiv_mutate, Quiver.arrows_mutate]
  have harr : (polygonQuiver L.triangulation).mutationArrows (Λ.equiv (Fin.castLE Λ.le k)) =
      ((polygonQuiver L.triangulation).mutate hk).arrows := by
    rw [Quiver.arrows_mutate, hv]
  rw [harr, signedCount, ← e.arrows_eq, ← e.arrows_eq]
  simp only [extMatrix, Matrix.of_apply, signedCount, hT']
  have hval : ∀ i, (e.equiv (Λ.equiv i)).1 = L'.extLabel i := fun i => by
    rw [he, hΛ, extLabel_eq_ite_of_label_eq_update hL']
  exact congrArg₂ (fun u v : ℤ => u - v)
    (congrArg Nat.cast (congrArg₂ (polygonArrows _) (hval i) (hval _)))
    (congrArg Nat.cast (congrArg₂ (polygonArrows _) (hval _) (hval i)))

variable {n} in
/-- The exchange monomials of `Σ(T, λ)` in direction `k`, for `λ(k) = {a, c}` with apexes `b`
and `d`: `P_{bc} P_{da}` and `P_{ab} P_{cd}`. -/
private theorem LabelledTriangulation.exchangeMonomials_pluckerSeed
    (L : LabelledTriangulation n) {k : Fin n} {a b c d : ZMod (n + 3)}
    (hac : L.label k = s(a, c)) (hq : IsFlipQuadrilateral L.triangulation a b c d) :
    exchangeMonomialPos (pluckerSeed K L).extCluster (pluckerSeed K L).extExchangeMatrix k =
        pluckerVar K n s(b, c) * pluckerVar K n s(d, a) ∧
      exchangeMonomialNeg (pluckerSeed K L).extCluster (pluckerSeed K L).extExchangeMatrix k =
        pluckerVar K n s(a, b) * pluckerVar K n s(c, d) := by
  have hm : 4 ≤ n + 3 := by have := k.isLt; omega
  have hcol : ∀ i, L.extMatrix i k = if L.extLabel i = s(b, c) ∨ L.extLabel i = s(d, a) then 1
      else if L.extLabel i = s(a, b) ∨ L.extLabel i = s(c, d) then -1 else 0 := fun i => by
    change signedCount (polygonArrows L.triangulation) (L.extLabel i)
      (L.extLabel (Fin.castLE _ k)) = _
    rw [extLabel_castLE, hac]
    exact hq.signedCount_polygonArrows hm L.isTriangulation
      (hac ▸ L.label_mem_triangulation k) _
  obtain ⟨⟨hne_ab, hne_ac, hne_ad, hne_bc, hne_bd, hne_cd⟩, -⟩ := quadrilateral_cross hq.1 hq.2.1
  obtain ⟨iab, hiab⟩ := L.exists_extLabel_eq hq.2.2.1
  obtain ⟨ibc, hibc⟩ := L.exists_extLabel_eq hq.2.2.2.1
  obtain ⟨icd, hicd⟩ := L.exists_extLabel_eq hq.2.2.2.2.1
  obtain ⟨ida, hida⟩ := L.exists_extLabel_eq hq.2.2.2.2.2
  obtain ⟨n1, n2, n3, n4, n5, n6⟩ :=
    sym2_quadrilateral_sides_ne hne_ab hne_ac hne_ad hne_bc hne_bd hne_cd
  have hidx : ∀ {i j : Fin (2 * n + 3)} {σ}, L.extLabel j = σ → (L.extLabel i = σ ↔ i = j) :=
    fun hj => ⟨fun hi => L.extLabel_injective (hi.trans hj.symm), fun hi => hi ▸ hj⟩
  constructor
  · rw [exchangeMonomialPos]
    refine (prod_filter_eq_mul_of_iff _ _ (i₁ := ibc) (i₂ := ida)
      (fun h' => n1 (by rw [← hibc, ← hida, h'])) (fun i => ?_)
      ?_ ?_).trans (by simp only [pluckerSeed, hibc, hida])
    · change 0 < L.extMatrix i k ↔ _
      rw [hcol, ← hidx hibc, ← hidx hida]
      split_ifs <;> simp_all
    · change L.extMatrix ibc k = 1
      simp [hcol, hibc]
    · change L.extMatrix ida k = 1
      simp [hcol, hida, n1.symm]
  · rw [exchangeMonomialNeg]
    refine (prod_filter_eq_mul_of_iff _ _ (i₁ := iab) (i₂ := icd)
      (fun h' => n6 (by rw [← hiab, ← hicd, h'])) (fun i => ?_)
      ?_ ?_).trans (by simp only [pluckerSeed, hiab, hicd])
    · change L.extMatrix i k < 0 ↔ _
      rw [hcol, ← hidx hiab, ← hidx hicd]
      by_cases hA : L.extLabel i = s(b, c) ∨ L.extLabel i = s(d, a)
      · rw [if_pos hA]
        rcases hA with hA | hA <;> rw [hA] <;> simp [n2, n3, n4, n5]
      · rw [if_neg hA]
        split_ifs with hB <;> simp [hB]
    · change -L.extMatrix iab k = 1
      simp [hcol, hiab, n2.symm, n4.symm]
    · change -L.extMatrix icd k = 1
      simp [hcol, hicd, n3.symm, n5.symm, n6.symm]

variable {n} in
/-- **The Ptolemy relation for Plücker coordinates.** For a quadrilateral `a, b, c, d` in
clockwise order, `P_{ac} P_{bd} = P_{bc} P_{da} + P_{ab} P_{cd}`. -/
theorem pluckerVar_mul_pluckerVar_eq_add (hm : 4 ≤ n + 3) {a b c d : ZMod (n + 3)}
    (hb : sbtw a b c) (hd : sbtw c d a) :
    pluckerVar K n s(a, c) * pluckerVar K n s(b, d) =
      pluckerVar K n s(b, c) * pluckerVar K n s(d, a) +
        pluckerVar K n s(a, b) * pluckerVar K n s(c, d) := by
  obtain ⟨⟨hne_ab, hne_ac, hne_ad, hne_bc, hne_bd, hne_cd⟩, -⟩ := quadrilateral_cross hb hd
  apply Subtype.ext
  simp only [MulMemClass.coe_mul, AddMemClass.coe_add,
    coe_pluckerVar K n (isSegment_mk_of_ne hne_ac),
    coe_pluckerVar K n (isSegment_mk_of_ne hne_bd),
    coe_pluckerVar K n (isSegment_mk_of_ne hne_ab),
    coe_pluckerVar K n (isSegment_mk_of_ne hne_ad.symm),
    coe_pluckerVar K n (isSegment_mk_of_ne hne_cd),
    coe_pluckerVar K n (isSegment_mk_of_ne hne_bc)]
  have hP := segmentPlucker_ptolemy hm (pluckerMatrix K n) hne_ac hb hd
  rw [Sym2.eq_swap (a := a) (b := d), Sym2.eq_swap (a := c) (b := b)] at hP
  simp only [pluckerFn]
  linear_combination hP

variable {n} in
/-- **A flip of a labelled triangulation is a seed mutation.** Let `γ'` be the replacement of
`γ = λ(k)` in `T`. Then `(T', λ')` with `T' = (T \ {γ}) ∪ {γ'}`, `λ'(k) = γ'` and
`λ'(i) = λ(i)` for `i ≠ k` is a labelled triangulation, `μ_k(B̃(T, λ)) = B̃(T', λ')`, the entry
`P_γ` of `x̃(T, λ)` in position `k` is nonzero (so the seed mutation is defined), and
`μ_k(Σ(T, λ)) = Σ(T', λ')`. -/
@[cluster_algebras "lem_type_A_flip_mutation"]
theorem LabelledTriangulation.exists_seedMutation_eq (L : LabelledTriangulation n) (k : Fin n)
    {γ' : Sym2 (ZMod (n + 3))} (h : IsFlipReplacement L.triangulation (L.label k) γ') :
    ∃ L' : LabelledTriangulation n, L'.label = Function.update L.label k γ' ∧
      L'.triangulation = flipTriangulation L.triangulation (L.label k) γ' ∧
      matrixMutation (le_two_mul_add_three n) L.extMatrix k = L'.extMatrix ∧
      (pluckerSeed K L).extCluster (Fin.castLE (le_two_mul_add_three n) k) ≠ 0 ∧
      seedMutation (le_two_mul_add_three n) (pluckerSeed K L) k = pluckerSeed K L' := by
  obtain ⟨L', hL', hT'⟩ := L.exists_label_eq_update k h
  have hm : 4 ≤ n + 3 := by have := k.isLt; omega
  have hmat := matrixMutation_extMatrix_of_flip h hL' hT'
  have hne : (pluckerSeed K L).extCluster (Fin.castLE (le_two_mul_add_three n) k) ≠ 0 := by
    change pluckerVar K n (L.extLabel _) ≠ 0
    rw [extLabel_castLE]
    exact pluckerVar_ne_zero K n (L.isDiagonal_label k).isSegment
  refine ⟨L', hL', hT', hmat, hne, SeedData.ext ?_ hmat⟩
  obtain ⟨a, c, hac⟩ : ∃ a c, L.label k = s(a, c) := by
    induction L.label k using Sym2.ind with
    | _ a c => exact ⟨a, c, rfl⟩
  have hγT : s(a, c) ∈ L.triangulation := hac ▸ L.label_mem_triangulation k
  obtain ⟨⟨b, hb, -⟩, ⟨d, hd, -⟩⟩ :=
    IsTriangulation.existsUnique_apex_of_mem hm L.isTriangulation hγT
  have hq : IsFlipQuadrilateral L.triangulation a b c d :=
    ⟨hb.1, hd.1, hb.2.1, hb.2.2, hd.2.1, hd.2.2⟩
  have hγ' : γ' = s(b, d) := hq.eq_of_isFlipReplacement L.isTriangulation (hac ▸ h)
  obtain ⟨hpos, hneg⟩ := L.exchangeMonomials_pluckerSeed K hac hq
  have hne_ac := (quadrilateral_cross hb.1 hd.1).1.2.1
  have hptolemy := pluckerVar_mul_pluckerVar_eq_add K hm hb.1 hd.1
  funext i
  simp only [seedMutation]
  by_cases hi : i = Fin.castLE (le_two_mul_add_three n) k
  · subst hi
    rw [Function.update_self, hpos, hneg]
    change _ = pluckerVar K n (L'.extLabel _)
    rw [extLabel_castLE, hL', Function.update_self, hγ']
    change _ / pluckerVar K n (L.extLabel _) = _
    rw [extLabel_castLE, hac, ← hptolemy, mul_div_cancel_left₀]
    exact pluckerVar_ne_zero K n (isSegment_mk_of_ne hne_ac)
  · rw [Function.update_of_ne hi]
    change pluckerVar K n (L.extLabel i) = pluckerVar K n (L'.extLabel i)
    rw [extLabel_eq_ite_of_label_eq_update hL',
      if_neg fun h' => hi (L.extLabel_injective (h'.trans (L.extLabel_castLE k).symm))]

variable {n} in
/-- `x̃(T, λ)` is algebraically independent exactly when the `P_σ`, `σ` a segment of `T`, are. -/
private theorem LabelledTriangulation.algebraicIndependent_extCluster_iff
    (L : LabelledTriangulation n) :
    AlgebraicIndependent K (pluckerSeed K L).extCluster ↔
      AlgebraicIndependent K fun σ : SegmentType L.triangulation => pluckerVar K n σ.1 :=
  algebraicIndependent_equiv L.extLabelEquiv
    (f := fun σ : SegmentType L.triangulation => pluckerVar K n σ.1)

variable {n} in
/-- Algebraic independence of the Plücker coordinates of the segments passes through a flip. -/
private theorem algebraicIndependent_pluckerVar_flipTriangulation [CharZero K]
    {U : Finset (Sym2 (ZMod (n + 3)))} {γ γ' : Sym2 (ZMod (n + 3))}
    (h : IsFlipReplacement U γ γ')
    (hU : AlgebraicIndependent K fun σ : SegmentType U => pluckerVar K n σ.1) :
    AlgebraicIndependent K
      fun σ : SegmentType (flipTriangulation U γ γ') => pluckerVar K n σ.1 := by
  obtain ⟨L, rfl⟩ := IsTriangulation.exists_labelledTriangulation h.1
  obtain ⟨k, rfl⟩ := L.mem_triangulation_iff.1 h.2.1
  obtain ⟨L', -, hT', -, -, hmut⟩ := L.exists_seedMutation_eq K k h
  have hS : IsLabeledSeed K (le_two_mul_add_three n) (pluckerSeed K L) :=
    ⟨⟨(L.algebraicIndependent_extCluster_iff K).2 hU, L.adjoin_range_pluckerSeed K⟩,
      L.extSkewSymmetrizable_extMatrix⟩
  have := (hS.seedMutation (le_two_mul_add_three n) k).1.1
  rwa [hmut, L'.algebraicIndependent_extCluster_iff K, hT'] at this

/-- **The Plücker seeds are labeled seeds: independence.** For every triangulation `T`, the
Plücker coordinates of the segments of `T` are algebraically independent over `K`. -/
@[cluster_algebras "lem_type_A_seed"]
theorem IsTriangulation.algebraicIndependent_pluckerVar [CharZero K]
    {T : Finset (Sym2 (ZMod (n + 3)))} (hT : IsTriangulation T) :
    AlgebraicIndependent K fun σ : SegmentType T => pluckerVar K n σ.1 := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have hT0 : T = fanTriangulation (0 + 3) := by
      rw [IsTriangulation.eq_empty_of_zmod_three hT]
      simp [fanTriangulation]
    subst hT0
    exact algebraicIndependent_pluckerVar_fanTriangulation K 0
  · have hm : 4 ≤ n + 3 := by omega
    have hr := IsTriangulation.reflTransGen_isFlip hm (isTriangulation_fanTriangulation hm) hT
    clear hT
    induction hr with
    | refl => exact algebraicIndependent_pluckerVar_fanTriangulation K n
    | tail _ hflip ih =>
      obtain ⟨γ, γ', hγ, rfl⟩ := hflip
      exact algebraicIndependent_pluckerVar_flipTriangulation K hγ ih

variable {n} in
/-- **The Plücker seeds are labeled seeds: free generation.** `x̃(T, λ)` is a free generating
tuple of `𝓕ₙ` over `K`. -/
@[cluster_algebras "lem_type_A_seed"]
theorem LabelledTriangulation.isFreeGeneratingTuple_pluckerSeed [CharZero K]
    (L : LabelledTriangulation n) : IsFreeGeneratingTuple K (pluckerSeed K L).extCluster :=
  ⟨(L.algebraicIndependent_extCluster_iff K).2
    (IsTriangulation.algebraicIndependent_pluckerVar K n L.isTriangulation),
    L.adjoin_range_pluckerSeed K⟩

variable {n} in
/-- **The Plücker seeds are labeled seeds.** `Σ(T, λ)` is a labeled seed in `𝓕ₙ` over `K`,
with a `(2n+3) × n` extended exchange matrix. -/
@[cluster_algebras "lem_type_A_seed"]
theorem LabelledTriangulation.isLabeledSeed_pluckerSeed [CharZero K]
    (L : LabelledTriangulation n) :
    IsLabeledSeed K (le_two_mul_add_three n) (pluckerSeed K L) :=
  ⟨L.isFreeGeneratingTuple_pluckerSeed K, L.extSkewSymmetrizable_extMatrix⟩

/-! ### The seed pattern of Plücker coordinates -/

variable {n}

/-- **The seed pattern of Plücker coordinates: existence.** Through every Plücker seed
`Σ(T₁, λ₁)`, placed at any vertex `t₁`, there is a seed pattern of rank `n` in `𝓕ₙ` over
`K`. -/
@[cluster_algebras "lem_type_A_plucker_pattern"]
theorem exists_isSeedPattern_pluckerSeed [CharZero K] (L₁ : LabelledTriangulation n)
    (t₁ : RegularTree n) :
    ∃ P : RegularTree n → SeedData (pluckerField K n) (2 * n + 3) n,
      IsSeedPattern K (le_two_mul_add_three n) P ∧ P t₁ = pluckerSeed K L₁ :=
  exists_isSeedPattern _ t₁ (L₁.isLabeledSeed_pluckerSeed K)

/-- **Distinct labelled triangulations have distinct Plücker seeds.** -/
private theorem pluckerSeed_injective : Function.Injective (pluckerSeed K (n := n)) := by
  intro L L' h
  apply LabelledTriangulation.ext
  funext j
  have hj := congrFun (congrArg SeedData.extCluster h) (Fin.castLE (le_two_mul_add_three n) j)
  simp only [pluckerSeed, LabelledTriangulation.extLabel_castLE] at hj
  exact injOn_pluckerVar K n (L.isDiagonal_label j).isSegment (L'.isDiagonal_label j).isSegment hj

/-- There are finitely many labelled triangulations. -/
instance LabelledTriangulation.instFinite : Finite (LabelledTriangulation n) :=
  Finite.of_injective (fun L => L.label) fun _ _ h => LabelledTriangulation.ext h

variable {K} {P : RegularTree n → SeedData (pluckerField K n) (2 * n + 3) n}
  {t₁ : RegularTree n} {L₁ : LabelledTriangulation n}

/-- Along an edge `t —k— t'` of a seed pattern, a Plücker seed `Σ(T, λ)` at `t` is followed by
the Plücker seed of the flip of `(T, λ)` at `λ(k)`. -/
private theorem IsSeedPattern.exists_pluckerSeed_of_adj [CharZero K]
    (hP : IsSeedPattern K (le_two_mul_add_three n) P) {k : Fin n} {t t' : RegularTree n}
    (hadj : RegularTree.Adj k t t') {L : LabelledTriangulation n} (hL : P t = pluckerSeed K L) :
    ∃ (γ' : Sym2 (ZMod (n + 3))) (L' : LabelledTriangulation n),
      IsFlipReplacement L.triangulation (L.label k) γ' ∧
        L'.label = Function.update L.label k γ' ∧
        L'.triangulation = flipTriangulation L.triangulation (L.label k) γ' ∧
        P t' = pluckerSeed K L' := by
  have hm : 4 ≤ n + 3 := by have := k.isLt; omega
  obtain ⟨γ', hγ', -⟩ := IsTriangulation.existsUnique_isFlipReplacement hm L.isTriangulation
    (L.label_mem_triangulation k)
  obtain ⟨L', h1, h2, -, -, h5⟩ := L.exists_seedMutation_eq K k hγ'
  exact ⟨γ', L', hγ', h1, h2, by rw [hP.2 k t t' hadj, hL, h5]⟩

/-- **The seed pattern of Plücker coordinates, (a).** In a seed pattern through a Plücker seed,
every seed is `Σ(T_t, λ_t)` for exactly one labelled triangulation `(T_t, λ_t)`. -/
@[cluster_algebras "lem_type_A_plucker_pattern"]
theorem IsSeedPattern.existsUnique_pluckerSeed [CharZero K]
    (hP : IsSeedPattern K (le_two_mul_add_three n) P) (h₁ : P t₁ = pluckerSeed K L₁)
    (t : RegularTree n) : ∃! L : LabelledTriangulation n, P t = pluckerSeed K L := by
  obtain ⟨d, s, k, hs0, hsd, hadj⟩ := RegularTree.exists_walk t₁ t
  have key : ∀ i : ℕ, (hi : i ≤ d) →
      ∃ L : LabelledTriangulation n, P (s ⟨i, by omega⟩) = pluckerSeed K L := by
    intro i
    induction i with
    | zero => exact fun _ => ⟨L₁, by rw [← h₁, ← hs0]; rfl⟩
    | succ i ih =>
      intro hi
      obtain ⟨L, hL⟩ := ih (by omega)
      obtain ⟨-, L', -, -, -, hL'⟩ :=
        IsSeedPattern.exists_pluckerSeed_of_adj hP (hadj ⟨i, by omega⟩) hL
      exact ⟨L', hL'⟩
  obtain ⟨L, hL⟩ := key d le_rfl
  rw [show (⟨d, _⟩ : Fin (d + 1)) = Fin.last d from rfl, hsd] at hL
  exact ⟨L, hL, fun L' hL' => pluckerSeed_injective K (hL'.symm.trans hL)⟩

/-- **The seed pattern of Plücker coordinates, (b).** If `t —k— t'`, then `λ_{t'}(k)` is the
replacement of `λ_t(k)` in `T_t`, `T_{t'} = (T_t \ {λ_t(k)}) ∪ {λ_{t'}(k)}`, and
`λ_{t'}(i) = λ_t(i)` for `i ≠ k`, whenever `P t = Σ(T_t, λ_t)` and
`P t' = Σ(T_{t'}, λ_{t'})`. -/
@[cluster_algebras "lem_type_A_plucker_pattern"]
theorem IsSeedPattern.isFlipReplacement_of_adj [CharZero K]
    (hP : IsSeedPattern K (le_two_mul_add_three n) P) {k : Fin n} {t t' : RegularTree n}
    (hadj : RegularTree.Adj k t t') {L L' : LabelledTriangulation n} (hL : P t = pluckerSeed K L)
    (hL' : P t' = pluckerSeed K L') :
    IsFlipReplacement L.triangulation (L.label k) (L'.label k) ∧
      L'.triangulation = flipTriangulation L.triangulation (L.label k) (L'.label k) ∧
      L'.label = Function.update L.label k (L'.label k) := by
  obtain ⟨γ', L'', hγ', h1, h2, h3⟩ := IsSeedPattern.exists_pluckerSeed_of_adj hP hadj hL
  obtain rfl : L'' = L' := pluckerSeed_injective K (h3.symm.trans hL')
  obtain rfl : L''.label k = γ' := by rw [h1, Function.update_self]
  exact ⟨hγ', h2, h1⟩

/-- **The seed pattern of Plücker coordinates, (c).** Every triangulation of the `(n+3)`-gon is
`T_t` for some vertex `t`. -/
@[cluster_algebras "lem_type_A_plucker_pattern"]
theorem IsSeedPattern.exists_pluckerSeed_triangulation_eq [CharZero K]
    (hP : IsSeedPattern K (le_two_mul_add_three n) P) (h₁ : P t₁ = pluckerSeed K L₁)
    {T : Finset (Sym2 (ZMod (n + 3)))} (hT : IsTriangulation T) :
    ∃ (t : RegularTree n) (L : LabelledTriangulation n), P t = pluckerSeed K L ∧
      L.triangulation = T := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · refine ⟨t₁, L₁, h₁, ?_⟩
    rw [IsTriangulation.eq_empty_of_zmod_three hT]
    exact IsTriangulation.eq_empty_of_zmod_three L₁.isTriangulation
  have hm : 4 ≤ n + 3 := by omega
  have hr := IsTriangulation.reflTransGen_isFlip hm L₁.isTriangulation hT
  clear hT
  induction hr with
  | refl => exact ⟨t₁, L₁, h₁, rfl⟩
  | tail _ hflip ih =>
    obtain ⟨γ, γ', hγ, rfl⟩ := hflip
    obtain ⟨t, L, hL, rfl⟩ := ih
    obtain ⟨k, rfl⟩ := L.mem_triangulation_iff.1 hγ.2.1
    obtain ⟨t', hadj⟩ := RegularTree.exists_adj t k
    obtain ⟨L', -, h2, -, -, h5⟩ := L.exists_seedMutation_eq K k hγ
    exact ⟨t', L', by rw [hP.2 k t t' hadj, hL, h5], h2⟩

/-- **The seed pattern of Plücker coordinates, (d).** It is of finite type. -/
@[cluster_algebras "lem_type_A_plucker_pattern"]
theorem IsSeedPattern.isFiniteType_of_pluckerSeed [CharZero K]
    (hP : IsSeedPattern K (le_two_mul_add_three n) P) (h₁ : P t₁ = pluckerSeed K L₁) :
    IsFiniteType P := by
  refine (Set.finite_range (pluckerSeed K (n := n))).subset ?_
  rintro _ ⟨t, rfl⟩
  obtain ⟨L, hL, -⟩ := IsSeedPattern.existsUnique_pluckerSeed hP h₁ t
  exact ⟨L, hL.symm⟩

end Plucker

/-! ### Full `ℤ`-rank of the fan -/

/-- **The arrows between a side and a diagonal of the fan.** For `l ∈ [1, n+1]` and
`i ∈ [2, n+1]`, `β_{T∘}(s(l, l+1), s(0, i))` is `1` if `i = l + 1`, `-1` if `i = l`, and `0`
otherwise. -/
private theorem signedCount_fanTriangulation_side {n i l : ℕ} (hi1 : 2 ≤ i) (hi2 : i ≤ n + 1)
    (hl1 : 1 ≤ l) (hl2 : l ≤ n + 1) (hT : IsTriangulation (fanTriangulation (n + 3))) :
    signedCount (polygonArrows (fanTriangulation (n + 3)))
        s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) s(0, (i : ZMod (n + 3))) =
      if i = l + 1 then 1 else if i = l then -1 else 0 := by
  have hm : 4 ≤ n + 3 := by omega
  have hγ : s(0, (i : ZMod (n + 3))) ∈ fanTriangulation (n + 3) := by
    simp only [fanTriangulation, Finset.mem_image, Finset.mem_Icc]
    exact ⟨i, ⟨hi1, by omega⟩, rfl⟩
  have hc : (i : ZMod (n + 3)) = ((i - 1 : ℕ) : ZMod (n + 3)) + 1 := by
    rw [← Nat.cast_succ, Nat.succ_eq_add_one, Nat.sub_add_cancel (by omega : 1 ≤ i)]
  have hq : IsFlipQuadrilateral (fanTriangulation (n + 3)) 0 ((i - 1 : ℕ) : ZMod (n + 3))
      (i : ZMod (n + 3)) ((i + 1 : ℕ) : ZMod (n + 3)) := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [← Nat.cast_zero]
      exact (sbtw_natCast_iff (m := n + 3) (by omega) (by omega) (by omega)).2
        (.inl ⟨by omega, by omega⟩)
    · rw [← Nat.cast_zero (R := ZMod (n + 3))]
      exact sbtw_cyclic_left ((sbtw_natCast_iff (m := n + 3) (by omega) (by omega) (by omega)).2
        (.inl ⟨by omega, by omega⟩))
    · exact zero_natCast_mem_segments_fanTriangulation (by omega) (by omega)
    · rw [hc]
      exact mem_segments.2 (Or.inr ⟨_, rfl⟩)
    · rw [Nat.cast_succ]
      exact mem_segments.2 (Or.inr ⟨_, rfl⟩)
    · rw [Sym2.eq_swap]
      exact zero_natCast_mem_segments_fanTriangulation (by omega) (by omega)
  rw [hq.signedCount_polygonArrows hm hT hγ]
  have hσ : (s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) : Sym2 _) =
      s((l : ZMod (n + 3)), ((l + 1 : ℕ) : ZMod (n + 3))) := by
    rw [Nat.cast_succ]
  have h0 : (0 : ZMod (n + 3)) = ((0 : ℕ) : ZMod (n + 3)) := Nat.cast_zero.symm
  have e1 : (s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) : Sym2 _) =
      s(((i - 1 : ℕ) : ZMod (n + 3)), (i : ZMod (n + 3))) ↔ i = l + 1 := by
    rw [hσ, sym2_natCast_eq_iff (by omega) (by omega) (by omega) (by omega)]
    omega
  have e2 : (s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) : Sym2 _) =
      s(((i + 1 : ℕ) : ZMod (n + 3)), 0) ↔ False := by
    rw [hσ, h0, sym2_natCast_eq_iff (by omega) (by omega) (by omega) (by omega), iff_false]
    omega
  have e3 : (s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) : Sym2 _) =
      s(0, ((i - 1 : ℕ) : ZMod (n + 3))) ↔ False := by
    rw [hσ, h0, sym2_natCast_eq_iff (by omega) (by omega) (by omega) (by omega), iff_false]
    omega
  have e4 : (s((l : ZMod (n + 3)), (l : ZMod (n + 3)) + 1) : Sym2 _) =
      s((i : ZMod (n + 3)), ((i + 1 : ℕ) : ZMod (n + 3))) ↔ i = l := by
    rw [hσ, sym2_natCast_eq_iff (by omega) (by omega) (by omega) (by omega)]
    omega
  simp only [e1, e2, e3, e4, or_false, false_or]

/-- Every label of a labelling of the fan is a diagonal `s(0, i)`, `i ∈ [2, n+1]`. -/
private theorem LabelledTriangulation.exists_label_eq_of_fan {n : ℕ} (L : LabelledTriangulation n)
    (hL : L.triangulation = fanTriangulation (n + 3)) (j : Fin n) :
    ∃ i : ℕ, 2 ≤ i ∧ i ≤ n + 1 ∧ L.label j = s(0, (i : ZMod (n + 3))) := by
  have := L.label_mem_triangulation j
  rw [hL] at this
  simp only [fanTriangulation, Finset.mem_image, Finset.mem_Icc] at this
  obtain ⟨i, ⟨h1, h2⟩, h⟩ := this
  exact ⟨i, h1, by omega, h.symm⟩

/-- Every diagonal `s(0, i)`, `i ∈ [2, n+1]`, of the fan is a label of a labelling of the fan. -/
private theorem LabelledTriangulation.exists_label_eq_of_fan' {n : ℕ}
    (L : LabelledTriangulation n) (hL : L.triangulation = fanTriangulation (n + 3)) {i : ℕ}
    (h1 : 2 ≤ i) (h2 : i ≤ n + 1) : ∃ j, L.label j = s(0, (i : ZMod (n + 3))) :=
  L.mem_triangulation_iff.1 (by
    rw [hL]
    simp only [fanTriangulation, Finset.mem_image, Finset.mem_Icc]
    exact ⟨i, ⟨h1, by omega⟩, rfl⟩)

/-- The diagonals `s(0, i)`, `i ∈ [0, n+1]`, of the `(n+3)`-gon are pairwise distinct. -/
private theorem zero_natCast_sym2_inj {n i i' : ℕ} (h1 : i ≤ n + 1) (h2 : i' ≤ n + 1) :
    (s(0, (i : ZMod (n + 3))) : Sym2 _) = s(0, (i' : ZMod (n + 3))) ↔ i = i' := by
  rw [show (0 : ZMod (n + 3)) = ((0 : ℕ) : ZMod (n + 3)) from Nat.cast_zero.symm,
    sym2_natCast_eq_iff (by omega) (by omega) (by omega) (by omega)]
  omega

/-- The row of `B̃(T∘, λ)` at the side `s(l, l+1)`, `l ∈ [1, n+1]`, in the column of the label
`s(0, i)`: `1` if `i = l + 1`, `-1` if `i = l`, and `0` otherwise. -/
private theorem LabelledTriangulation.extMatrix_side_of_fan {n : ℕ}
    (L : LabelledTriangulation n) (hL : L.triangulation = fanTriangulation (n + 3)) {l : ℕ}
    (h1 : 1 ≤ l) (h2 : l ≤ n + 1) {j : Fin n} {i : ℕ} (hi1 : 2 ≤ i) (hi2 : i ≤ n + 1)
    (hj : L.label j = s(0, (i : ZMod (n + 3)))) :
    L.extMatrix ⟨n + l, by omega⟩ j = if i = l + 1 then 1 else if i = l then -1 else 0 := by
  have := signedCount_fanTriangulation_side hi1 hi2 h1 h2 (hL ▸ L.isTriangulation)
  rw [← hL, ← hj] at this
  rw [← this]
  simp only [extMatrix, Matrix.of_apply, extLabel_castLE]
  rw [L.extLabel_of_le (by simp)]
  simp

/-- For a labelling of the fan, the unit vector at the label `s(0, i)` lies in the `ℤ`-span of
the rows of `B̃(T∘, λ)`: the row of the side `s(i-1, i)` is the difference of the unit vectors
at `s(0, i)` and `s(0, i-1)`. -/
private theorem LabelledTriangulation.single_mem_span_extMatrix_of_fan {n : ℕ}
    (L : LabelledTriangulation n) (hL : L.triangulation = fanTriangulation (n + 3)) {i : ℕ}
    (hi1 : 2 ≤ i) : i ≤ n + 1 → ∀ j, L.label j = s(0, (i : ZMod (n + 3))) →
      Pi.single j (1 : ℤ) ∈ Submodule.span ℤ (Set.range L.extMatrix) := by
  induction i, hi1 using Nat.le_induction with
  | base =>
    intro _ j hj
    have : L.extMatrix ⟨n + 1, by omega⟩ = Pi.single j 1 := by
      funext j'
      obtain ⟨i', hi'1, hi'2, hj'⟩ := L.exists_label_eq_of_fan hL j'
      rw [L.extMatrix_side_of_fan hL le_rfl (by omega) hi'1 hi'2 hj']
      by_cases hjj : j' = j
      · subst hjj
        rw [hj, zero_natCast_sym2_inj (by omega) hi'2] at hj'
        subst hj'
        simp
      · have : i' ≠ 2 := fun h' => hjj (L.injective (by rw [hj, hj', h']))
        rw [Pi.single_apply, if_neg hjj, if_neg this, if_neg (by omega)]
    rw [← this]
    exact Submodule.subset_span ⟨_, rfl⟩
  | succ i hi1 ih =>
    intro hi2 j hj
    obtain ⟨j₀, hj₀⟩ := L.exists_label_eq_of_fan' hL hi1 (by omega)
    have : L.extMatrix ⟨n + i, by omega⟩ = Pi.single j 1 - Pi.single j₀ 1 := by
      funext j'
      obtain ⟨i', hi'1, hi'2, hj'⟩ := L.exists_label_eq_of_fan hL j'
      rw [L.extMatrix_side_of_fan hL (by omega) (by omega) hi'1 hi'2 hj', Pi.sub_apply,
        Pi.single_apply, Pi.single_apply]
      have e1 : j' = j ↔ i' = i + 1 := by
        rw [← L.injective.eq_iff, hj, hj', zero_natCast_sym2_inj hi'2 hi2]
      have e2 : j' = j₀ ↔ i' = i := by
        rw [← L.injective.eq_iff, hj₀, hj', zero_natCast_sym2_inj hi'2 (by omega)]
      simp only [e1, e2]
      split_ifs <;> omega
    rw [show Pi.single j (1 : ℤ) = L.extMatrix ⟨n + i, by omega⟩ + Pi.single j₀ 1 by
      rw [this, sub_add_cancel]]
    exact add_mem (Submodule.subset_span ⟨_, rfl⟩) (ih (by omega) j₀ hj₀)

/-- **The fan has full `ℤ`-rank.** For every labelling `λ` of the fan `T∘`, the rows of
`B̃(T∘, λ)` span `ℤⁿ` as an abelian group. -/
@[cluster_algebras "lem_type_A_fan_full_rank"]
theorem LabelledTriangulation.span_range_extMatrix_eq_top {n : ℕ} (L : LabelledTriangulation n)
    (hL : L.triangulation = fanTriangulation (n + 3)) :
    Submodule.span ℤ (Set.range L.extMatrix) = ⊤ := by
  rw [eq_top_iff, ← (Pi.basisFun ℤ (Fin n)).span_eq, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  rw [Pi.basisFun_apply]
  obtain ⟨i, hi1, hi2, hj⟩ := L.exists_label_eq_of_fan hL j
  exact L.single_mem_span_extMatrix_of_fan hL hi1 hi2 j hj

end TypeA

end ClusterAlgebras
