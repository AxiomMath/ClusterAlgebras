/-!
# The chamber minors of a wiring diagram are algebraically independent

Let `z` be the generic `k × k` matrix over `ℂ`. The `k(k+1)/2` *solid* flag minors
`P_{[a,d]}(z)`, `1 ≤ a ≤ d ≤ k`, are algebraically independent over `ℂ`. For a wiring diagram
`D` on `k` strands, every flag minor of `z` is subtraction-free in the chamber minors
`P_{J(c)}(z)` (FWZ's flag test), so the chamber minors and `det z = P_{[1,k]}(z)` generate a field
containing the solid minors, of transcendence degree at least `k(k+1)/2`; there are exactly
`k(k+1)/2` of them, so they are algebraically independent. In particular distinct chambers have
distinct chamber sets, and the seed `Σ(D, λ)` of a chamber labelling `λ` is a labeled seed in the
field its entries generate, with `m = (k-1)(k+2)/2` and `n = (k-1)(k-2)/2`.

## Main results

* `ClusterAlgebras.algebraicIndependent_flagMinor_Icc`: the solid flag minors are algebraically
  independent; `algebraicIndependent_flagMinor_Icc_mvPolynomialX` is the same statement over any
  integral domain.
* `ClusterAlgebras.algebraicIndependent_det_flagMinor_chamberSet`: the chamber minors of `D`
  together with `det z` are algebraically independent, and
  `ClusterAlgebras.WiringDiagram.chamberSet_injective`: distinct chambers have distinct chamber
  sets.
* `ClusterAlgebras.isLabeledSeed_wiringSeed`: `Σ(D, λ)` is a labeled seed in the field its entries
  generate, and `Labelling.m_eq_wiringQuiver`, `Labelling.n_eq_wiringQuiver`,
  `Labelling.one_le_n_wiringQuiver` give its size.
* `ClusterAlgebras.algebraicIndependent_of_transcendental_adjoin_Iio`: a family indexed by a
  linear order, each member of which is transcendental over the algebra generated by the earlier
  ones, is algebraically independent.
* `ClusterAlgebras.algebraicIndependent_of_algebraicIndependent_mem_adjoin`: a finite family is
  algebraically independent when the field it generates contains an algebraically independent
  family with at least as many members.
* `ClusterAlgebras.WiringDiagram.card_chamber`, `WiringDiagram.card_not_bounded`: a wiring
  diagram on `k` strands has `(k choose 2) + k - 1` chambers, `2(k - 1)` of them unbounded.

## Implementation notes

* **The solid minors are triangular in the entries of `z` itself.** FWZ specialize `z` to
  a generic upper triangular matrix and compare transcendence degrees. Here no specialization is
  needed: order the entries `z_{ij}` column by column, and by row within a column. Expanding
  `P_{[a,d]}(z)` along its last column gives `P_{[a,d]}(z) = z_{d-a+1,d} P_{[a,d-1]}(z) + h`, where
  `P_{[a,d-1]}(z) ≠ 0` (read as `1` when `a = d`) and `h` only involve entries earlier than
  `z_{d-a+1,d}`, and `(a, d) ↦ (d - a + 1, d)` is injective. So each solid minor is transcendental
  over the algebra generated by the earlier ones, which is
  `algebraicIndependent_of_transcendental_adjoin_Iio`.
* **The count.** FWZ conclude from the fact that a generating `m`-tuple of a field of
  transcendence degree `m` is free, after computing `trdeg L` exactly. Only the lower bound
  `trdeg L ≥ k(k+1)/2`, coming from the solid minors, is needed: a finite family generating `L`
  with at most `trdeg L` members is a transcendence basis of `L` (Mathlib's
  `Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite`). This is
  `algebraicIndependent_of_algebraicIndependent_mem_adjoin`, stated for any finite index type, so
  that it applies to the family indexed by `Option D.Chamber` without renumbering it by `Fin m`.
* **Indexing.** The chamber minors and `det z` form the family `Option D.Chamber → ℂ[z]`,
  `none ↦ det z` and `some c ↦ P_{J(c)}(z)`. Through a chamber labelling the chamber minors are
  indexed by `Fin m`, and with `det z` appended (the dummy frozen variable of FWZ) by
  `Fin (m + 1)`, as `Fin.append`; both forms are recorded, in `ℂ[z]` and in `ℂ(z)`.
* **Sizes.** A wiring diagram of `WiringDiagram n'` has `k = n' + 2` strands, so
  `m = (k-1)(k+2)/2 = (n'+1)(n'+4)/2`, `n = (k-1)(k-2)/2 = (n'+1)n'/2`, and FWZ's `k ≥ 3`
  is `1 ≤ n'`. The labeled-seed property itself holds for every `k ≥ 2`; only `n ≥ 1` uses
  `k ≥ 3`, so only `Labelling.one_le_n_wiringQuiver` assumes it.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

universe u

namespace ClusterAlgebras

open MvPolynomial

/-! ### Triangular families -/

section Triangular

variable {R A ι : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- **Triangular families are algebraically independent.** If `ι` is linearly ordered and each
`y i` is transcendental over the subalgebra generated by the earlier `y j`, `j < i`, then `y` is
algebraically independent (provided `R → A` is injective, which the empty family needs). -/
theorem algebraicIndependent_of_transcendental_adjoin_Iio [LinearOrder ι] {y : ι → A}
    (hinj : Function.Injective (algebraMap R A))
    (h : ∀ i, Transcendental (Algebra.adjoin R (y '' Set.Iio i)) (y i)) :
    AlgebraicIndependent R y := by
  refine algebraicIndependent_of_finite_type fun t ht => ?_
  obtain ⟨s, rfl⟩ := ht.exists_finset_coe
  change AlgebraicIndepOn R y (s : Set ι)
  refine Finset.induction_on_max s ?_ fun a s ha ih => ?_
  · rw [Finset.coe_empty]
    exact algebraicIndependent_empty_type_iff.2 hinj
  rw [Finset.coe_insert]
  exact ih.insert ((h a).of_tower_top_of_subalgebra_le
    (Algebra.adjoin_mono (Set.image_mono fun x hx => ha x hx)))

/-- If `x` is transcendental over a subalgebra `S` of a domain, so is `x g + h` for `g, h ∈ S`
with `g ≠ 0`. -/
private theorem transcendental_mul_add {S : Subalgebra R A} [IsDomain A] {x g h : A}
    (hx : Transcendental S x) (hg : g ∈ S) (hg0 : g ≠ 0) (hh : h ∈ S) :
    Transcendental S (x * g + h) := by
  have hg0' : (⟨g, hg⟩ : S) ≠ 0 := fun h0 => hg0 (congrArg Subtype.val h0)
  have hdeg : (Polynomial.C (⟨h, hh⟩ : S)).degree <
      (Polynomial.C (⟨g, hg⟩ : S) * Polynomial.X).degree := by
    rw [Polynomial.degree_C_mul_X hg0']
    exact Polynomial.degree_C_le.trans_lt (by decide)
  have key := hx.aeval_of_transcendental (f := Polynomial.C (⟨h, hh⟩ : S) +
    Polynomial.C (⟨g, hg⟩ : S) * Polynomial.X) (Polynomial.transcendental _ ?_ ?_)
  · convert key using 1
    rw [map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_C, Polynomial.aeval_X]
    change x * g + h = h + g * x
    ring
  · rw [Polynomial.natDegree_C_add, Polynomial.natDegree_C_mul_X _ hg0']
    exact one_ne_zero
  · rw [Polynomial.leadingCoeff_add_of_degree_lt hdeg, Polynomial.leadingCoeff_C_mul_X]
    exact mem_nonZeroDivisors_of_ne_zero hg0'

/-- A determinant whose entries lie in a subalgebra lies in it. -/
private theorem det_mem_of_forall_mem {n : Type*} [Fintype n] [DecidableEq n]
    {S : Subalgebra R A} (N : Matrix n n A) (h : ∀ i j, N i j ∈ S) : N.det ∈ S := by
  have : N = (Matrix.of fun i j => (⟨N i j, h i j⟩ : S)).map S.val :=
    Matrix.ext fun _ _ => rfl
  rw [this, ← AlgHom.coe_toRingHom, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
  exact Subtype.mem _

/-- **Expansion along the last column.** If every entry of `M` but the bottom right one lies in
`S`, then `det M = M_{last,last} · det M' + g` with `g ∈ S`, where `M'` deletes the last row and
column. -/
private theorem det_eq_mul_add_of_mem {r : ℕ} {S : Subalgebra R A}
    (M : Matrix (Fin (r + 1)) (Fin (r + 1)) A)
    (h : ∀ i j, (i, j) ≠ (Fin.last r, Fin.last r) → M i j ∈ S) :
    ∃ g ∈ S, M.det =
      M (Fin.last r) (Fin.last r) * (M.submatrix Fin.castSucc Fin.castSucc).det + g := by
  refine ⟨∑ i : Fin r, (-1) ^ ((i.castSucc : ℕ) + (Fin.last r : ℕ)) * M i.castSucc (Fin.last r) *
    (M.submatrix i.castSucc.succAbove Fin.castSucc).det, ?_, ?_⟩
  · refine Subalgebra.sum_mem _ fun i _ => Subalgebra.mul_mem _ (Subalgebra.mul_mem _
      (Subalgebra.pow_mem _ (Subalgebra.neg_mem _ (Subalgebra.one_mem _)) _)
      (h _ _ (by simp [Fin.castSucc_ne_last]))) (det_mem_of_forall_mem _ fun _ j => h _ _ ?_)
    simp [Fin.castSucc_ne_last]
  · rw [M.det_succ_column (Fin.last r), Fin.sum_univ_castSucc, add_comm, Fin.succAbove_last]
    congr 1
    rw [← two_mul, pow_mul]
    simp

end Triangular

/-- A square submatrix of the generic matrix along injective row and column maps has nonzero
determinant. -/
private theorem det_submatrix_mvPolynomialX_ne_zero {m m' n R : Type*} [Fintype n]
    [DecidableEq n] [CommRing R] [Nontrivial R] {e₁ : n → m} {e₂ : n → m'}
    (h₁ : Function.Injective e₁) (h₂ : Function.Injective e₂) :
    ((Matrix.mvPolynomialX m m' R).submatrix e₁ e₂).det ≠ 0 := by
  have : (Matrix.mvPolynomialX m m' R).submatrix e₁ e₂ =
      (rename (R := R) (Prod.map e₁ e₂)).toRingHom.mapMatrix (Matrix.mvPolynomialX n n R) := by
    ext i j
    simp [Matrix.mvPolynomialX_apply]
  rw [this, ← RingHom.map_det]
  exact (map_ne_zero_iff _ (rename_injective _ (h₁.prodMap h₂))).2
    (Matrix.det_mvPolynomialX_ne_zero n R)

/-! ### The solid flag minors -/

section Solid

variable {S : Type*} [CommRing S] {k : ℕ}

/-- The solid flag minor `P_{[a,d]}(z)` is the determinant of the first `d - a + 1` rows and the
columns `a, …, d` (0-based). -/
private theorem flagMinor_Icc (z : Matrix (Fin k) (Fin k) S) {a d : Fin k} (h : a ≤ d) :
    flagMinor z (Finset.Icc a d) =
      (z.submatrix (fun s : Fin ((d : ℕ) - a + 1) => (⟨s, by omega⟩ : Fin k))
        (fun t : Fin ((d : ℕ) - a + 1) => (⟨a + t, by omega⟩ : Fin k))).det := by
  have hle : (d : ℕ) - a + 1 ≤ k := by omega
  have hcard : (Finset.Icc a d).card = (d : ℕ) - a + 1 := by
    rw [Fin.card_Icc]
    omega
  have hemb : ∀ t, (Finset.Icc a d).orderEmbOfFin hcard t = ⟨a + t, by omega⟩ := fun t =>
    (congrFun (Finset.orderEmbOfFin_unique hcard
      (f := fun t : Fin ((d : ℕ) - a + 1) => (⟨a + t, by omega⟩ : Fin k))
      (fun t => by simp only [Finset.mem_Icc, Fin.le_def]; omega)
      (fun t t' htt' => Fin.mk_lt_mk.2 (by have := Fin.lt_def.1 htt'; omega))) t).symm
  have hrows : ∀ s, (initialRows k ((d : ℕ) - a + 1)).orderEmbOfFin (card_initialRows hle) s =
      Fin.castLE hle s := fun s =>
    (congrFun (Finset.orderEmbOfFin_unique (card_initialRows hle) (f := Fin.castLE hle)
      (fun l => by have := l.isLt; simp [initialRows]; omega)
      (Fin.castLEOrderEmb hle).strictMono) s).symm
  rw [flagMinor, hcard, minor_of_card_eq z (card_initialRows hle) hcard]
  congr 1
  ext s t
  rw [Matrix.submatrix_apply, Matrix.submatrix_apply, hemb, hrows]
  rfl

variable {R : Type*} [CommRing R] [IsDomain R]

/-- The position of the entry `z_{ij}` in the column-major order: column first, then row. -/
private def varKey (u : Fin k × Fin k) : ℕ ×ₗ ℕ := toLex ((u.2 : ℕ), (u.1 : ℕ))

/-- The position of the leading entry `z_{d-a+1,d}` of the solid minor `P_{[a,d]}(z)`. -/
private def solidKey (p : {p : Fin k × Fin k // p.1 ≤ p.2}) : ℕ ×ₗ ℕ :=
  toLex ((p.1.2 : ℕ), (p.1.2 : ℕ) - p.1.1)

private theorem solidKey_injective : Function.Injective (solidKey (k := k)) := by
  rintro ⟨⟨a, d⟩, had⟩ ⟨⟨a', d'⟩, had'⟩ h
  simp only [solidKey, toLex_inj, Prod.mk.injEq] at h
  simp only [Fin.le_def] at had had'
  obtain ⟨h1, h2⟩ := h
  obtain rfl : d = d' := Fin.ext h1
  obtain rfl : a = a' := Fin.ext (by omega)
  rfl

/-- **The solid minors are triangular.** `P_{[a,d]}(z) = z_{d-a+1,d} g + h` with `g ≠ 0`, and `g`,
`h` polynomials in the entries earlier than `z_{d-a+1,d}`. -/
private theorem exists_flagMinor_Icc_eq (p : {p : Fin k × Fin k // p.1 ≤ p.2}) :
    ∃ g ∈ supported R {u | varKey u < solidKey p}, g ≠ 0 ∧
    ∃ h ∈ supported R {u | varKey u < solidKey p},
      flagMinor (Matrix.mvPolynomialX (Fin k) (Fin k) R) (Finset.Icc p.1.1 p.1.2) =
        X (⟨(p.1.2 : ℕ) - p.1.1, by omega⟩, p.1.2) * g + h := by
  obtain ⟨⟨a, d⟩, had⟩ := p
  have had' : (a : ℕ) ≤ d := had
  rw [flagMinor_Icc _ had]
  set M := (Matrix.mvPolynomialX (Fin k) (Fin k) R).submatrix
    (fun s : Fin ((d : ℕ) - a + 1) => (⟨s, by omega⟩ : Fin k))
    (fun t : Fin ((d : ℕ) - a + 1) => (⟨a + t, by omega⟩ : Fin k)) with hM
  have hmem : ∀ i j, (i, j) ≠ (Fin.last _, Fin.last _) →
      M i j ∈ supported R {u | varKey u < solidKey ⟨(a, d), had⟩} := by
    intro i j hij
    rw [hM, Matrix.submatrix_apply, Matrix.mvPolynomialX_apply, X_mem_supported]
    simp only [Set.mem_setOf_eq, varKey, solidKey, Prod.Lex.toLex_lt_toLex]
    have hi := i.isLt
    have hj := j.isLt
    rw [Ne, Prod.mk.injEq, Fin.ext_iff, Fin.ext_iff, Fin.val_last] at hij
    omega
  obtain ⟨h, hh, he⟩ := det_eq_mul_add_of_mem M hmem
  refine ⟨_, det_mem_of_forall_mem (M.submatrix Fin.castSucc Fin.castSucc)
    fun i j => hmem _ _ ?_, ?_, h, hh, he.trans ?_⟩
  · simp [Fin.castSucc_ne_last]
  · rw [hM, Matrix.submatrix_submatrix]
    refine det_submatrix_mvPolynomialX_ne_zero (fun s s' hs => ?_) (fun t t' ht => ?_)
    · simpa [Fin.ext_iff] using hs
    · simpa [Fin.ext_iff] using ht
  · rw [hM, Matrix.submatrix_apply, Matrix.mvPolynomialX_apply]
    congr 3
    ext <;> simp
    omega

/-- **The solid flag minors are algebraically independent**, over any integral domain `R`: the
flag minors `P_{[a,d]}(z)`, `a ≤ d`, of the generic `k × k` matrix over `R`. -/
theorem algebraicIndependent_flagMinor_Icc_mvPolynomialX (R : Type*) [CommRing R] [IsDomain R]
    (k : ℕ) :
    AlgebraicIndependent R (fun p : {p : Fin k × Fin k // p.1 ≤ p.2} =>
      flagMinor (Matrix.mvPolynomialX (Fin k) (Fin k) R) (Finset.Icc p.1.1 p.1.2)) := by
  letI : LinearOrder {p : Fin k × Fin k // p.1 ≤ p.2} :=
    LinearOrder.lift' solidKey solidKey_injective
  refine algebraicIndependent_of_transcendental_adjoin_Iio (MvPolynomial.C_injective _ _)
    fun p => ?_
  obtain ⟨g, hg, hg0, h, hh, he⟩ := exists_flagMinor_Icc_eq (R := R) p
  rw [he]
  refine (transcendental_mul_add (transcendental_supported_X R ?_) hg hg0 hh)
    |>.of_tower_top_of_subalgebra_le ?_
  · simp [varKey, solidKey]
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨q, hq, rfl⟩
    obtain ⟨g', hg', -, h', hh', he'⟩ := exists_flagMinor_Icc_eq (R := R) q
    have hqp : solidKey q < solidKey p := hq
    have hsub : supported R {u : Fin k × Fin k | varKey u < solidKey q} ≤
        supported R {u : Fin k × Fin k | varKey u < solidKey p} :=
      supported_mono fun u hu => lt_trans hu hqp
    simp only [he']
    refine add_mem (mul_mem ((X_mem_supported (R := R)).2 ?_) (hsub hg')) (hsub hh')
    simpa [varKey, solidKey] using hqp

/-- **The solid flag minors are algebraically independent.** For the generic `k × k` matrix `z`
over `ℂ`, the `k(k+1)/2` flag minors `P_{[a,d]}(z)`, `1 ≤ a ≤ d ≤ k`, are algebraically
independent over `ℂ`. -/
@[cluster_algebras "lem_solid_minors_independent"]
theorem algebraicIndependent_flagMinor_Icc (k : ℕ) :
    AlgebraicIndependent ℂ (fun p : {p : Fin k × Fin k // p.1 ≤ p.2} =>
      flagMinor (complexGenericMatrix k k) (Finset.Icc p.1.1 p.1.2)) := by
  rw [complexGenericMatrix_eq_mvPolynomialX]
  exact algebraicIndependent_flagMinor_Icc_mvPolynomialX ℂ k

/-- `∑_{d < k} (d + 1) = (k+1 choose 2)`. -/
private theorem sum_fin_succ (k : ℕ) : ∑ d : Fin k, ((d : ℕ) + 1) = (k + 1).choose 2 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Fin.sum_univ_castSucc, Nat.choose_succ_succ' (k + 1), Nat.choose_one_right]
    simp only [Fin.val_castSucc, Fin.val_last, ih]
    ring

/-- There are `k(k+1)/2` solid flag minors. -/
private theorem card_solid (k : ℕ) :
    Fintype.card {p : Fin k × Fin k // p.1 ≤ p.2} = (k + 1).choose 2 := by
  let e : {p : Fin k × Fin k // p.1 ≤ p.2} ≃ (d : Fin k) × Fin ((d : ℕ) + 1) :=
    { toFun := fun p => ⟨p.1.2, ⟨p.1.1, Nat.lt_succ_of_le p.2⟩⟩
      invFun := fun q => ⟨(⟨q.2, by omega⟩, q.1), Fin.le_def.2 (Nat.le_of_lt_succ q.2.isLt)⟩
      left_inv := fun p => rfl
      right_inv := fun q => rfl }
  rw [Fintype.card_congr e, Fintype.card_sigma]
  simpa only [Fintype.card_fin] using sum_fin_succ k

end Solid

/-! ### Counting chambers -/

section Count

variable {n' : ℕ}

namespace WiringDiagram

/-- The multiplicities of the gaps sum to the number of crossings, each crossing being at one
gap. -/
theorem sum_multiplicity (D : WiringDiagram n') : ∑ g, D.multiplicity g = D.word.length := by
  classical
  simp only [multiplicity]
  rw [← List.sum_toFinset_count_eq_length D.word]
  exact (Finset.sum_subset (Finset.subset_univ _) fun g _ hg =>
    List.count_eq_zero.2 fun hm => hg (List.mem_toFinset.2 hm)).symm

/-- **The number of chambers.** A wiring diagram on `k = n' + 2` strands has
`∑_g (m_g + 1) = N + k - 1 = (k choose 2) + k - 1` chambers. -/
theorem card_chamber (D : WiringDiagram n') :
    Fintype.card D.Chamber = (n' + 2).choose 2 + (n' + 1) := by
  rw [Fintype.card_congr D.chamberEquiv, Fintype.card_sigma]
  simp only [Fintype.card_fin]
  rw [Finset.sum_add_distrib, D.sum_multiplicity, D.length_eq]
  simp

/-- **A wiring diagram on `n' + 2` strands has `2 (n' + 1)` unbounded chambers**: two, the first
and the last, in each of its `n' + 1` gaps. -/
theorem card_not_bounded (D : WiringDiagram n') :
    Fintype.card {c : D.Chamber // ¬c.Bounded} = 2 * (n' + 1) := by
  let e : {c : D.Chamber // ¬c.Bounded} ≃ Fin (n' + 1) × Bool :=
    { toFun := fun c => (c.1.gap, decide (c.1.idx = 0))
      invFun := fun p => ⟨⟨p.1, if p.2 then 0 else D.multiplicity p.1, by
          split_ifs <;> simp⟩, by
        rw [Chamber.not_bounded_iff]
        split_ifs <;> simp⟩
      left_inv := by
        rintro ⟨c, hc⟩
        rw [Chamber.not_bounded_iff] at hc
        refine Subtype.ext (Chamber.ext' rfl ?_)
        by_cases h : c.idx = 0
        · simp [h]
        · simp [h]
          omega
      right_inv := by
        rintro ⟨g, b⟩
        have := D.one_le_multiplicity g
        cases b
        · simp
          omega
        · simp }
  rw [Fintype.card_congr e, Fintype.card_prod, Fintype.card_fin, Fintype.card_bool, mul_comm]

end WiringDiagram

end Count

/-! ### Counting transcendence degrees -/

section Transcendence

/-- **A family no larger than an independent family in the field it generates is independent.**
If the subfield `L` of `K` generated over `k` by a finite family `w` contains an algebraically
independent family `u` with at least as many members, then `w` is algebraically independent. -/
theorem algebraicIndependent_of_algebraicIndependent_mem_adjoin {k : Type*} {K ι κ : Type u}
    [Field k] [Field K] [Algebra k K] [Fintype ι] [Fintype κ] {w : ι → K} {u : κ → K}
    (hu : AlgebraicIndependent k u) (hmem : ∀ j, u j ∈ IntermediateField.adjoin k (Set.range w))
    (hcard : Fintype.card ι ≤ Fintype.card κ) : AlgebraicIndependent k w := by
  set L := IntermediateField.adjoin k (Set.range w)
  let y : ι → L := fun i => ⟨w i, IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩⟩
  have hy : L.val ∘ y = w := rfl
  rw [← hy]
  refine AlgebraicIndependent.map' ?_ L.val.injective
  have htop : IntermediateField.adjoin k (Set.range y) = ⊤ := by
    apply IntermediateField.map_injective L.val
    rw [IntermediateField.adjoin_map, ← Set.range_comp, ← AlgHom.fieldRange_eq_map,
      IntermediateField.fieldRange_val, hy]
  have : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range y)) L := by
    rw [← IntermediateField.isAlgebraic_adjoin_iff_top]
    exact ⟨fun z => isAlgebraic_algebraMap
      (⟨z, htop ▸ IntermediateField.mem_top⟩ : IntermediateField.adjoin k (Set.range y))⟩
  have hs : AlgebraicIndependent k fun j => (⟨u j, hmem j⟩ : L) :=
    AlgebraicIndependent.of_comp L.val hu
  refine (Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite k y ?_).1
  refine le_trans ?_ (Cardinal.lift_le.2 hs.cardinalMk_le_trdeg)
  simpa using hcard

end Transcendence

/-! ### The chamber minors and the determinant -/

section Wiring

variable {n' m n : ℕ}

/-- `P_{[1,k]}(z) = det z`. -/
private theorem flagMinor_univ_eq_det {S : Type*} [CommRing S] {k : ℕ}
    (z : Matrix (Fin k) (Fin k) S) : flagMinor z Finset.univ = z.det := by
  rw [flagMinor_eq_pluckerCoord z (Finset.card_fin k), pluckerCoord_eq_det z (Finset.card_fin k)]
  congr 1
  ext i j
  simp [orderEmbOfFin_univ_fin]

/-- **Every flag minor lies in the field generated by the chamber minors and the determinant.**
For a wiring diagram `D` and a nonempty `J ⊆ [1, k]`, `P_J(z)` lies in the subfield of `ℂ(z)`
generated by `det z` and the chamber minors `P_{J(c)}(z)`. -/
theorem WiringDiagram.algebraMap_flagMinor_mem_adjoin (D : WiringDiagram n')
    {J : Finset (Fin (n' + 2))} (hJ : J.Nonempty) :
    algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
        (flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) J) ∈
      IntermediateField.adjoin ℂ (Set.range fun o : Option D.Chamber =>
        algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
          (o.elim (complexGenericMatrix (n' + 2) (n' + 2)).det
            fun c => flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) c.chamberSet)) := by
  set L := IntermediateField.adjoin ℂ (Set.range fun o : Option D.Chamber =>
        algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
          (o.elim (complexGenericMatrix (n' + 2) (n' + 2)).det
            fun c => flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) c.chamberSet))
  by_cases hJ' : J = Finset.univ
  · subst hJ'
    rw [flagMinor_univ_eq_det]
    exact IntermediateField.subset_adjoin _ _ ⟨none, rfl⟩
  obtain ⟨P, Q, -, -, hQ, he⟩ := D.isSubtractionFree_flagMinor hJ hJ'
  let φ : MvPolynomial (Fin (n' + 2) × Fin (n' + 2)) ℤ →+*
      FractionRing (ComplexPoly (n' + 2) (n' + 2)) :=
    (algebraMap _ _).comp (MvPolynomial.map (Int.castRingHom ℂ))
  have hφ : Function.Injective φ := by
    rw [RingHom.coe_comp]
    exact (IsFractionRing.injective (ComplexPoly (n' + 2) (n' + 2)) _).comp
      (MvPolynomial.map_injective _ Int.cast_injective)
  have hφJ : ∀ J, φ (flagMinor (genericMatrix (Fin (n' + 2)) (Fin (n' + 2))) J) =
      algebraMap _ _ (flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) J) := fun J => by
    simp only [φ, RingHom.map_flagMinor]
    rfl
  have hx : ∀ c, φ (wiringExtendedCluster D c) ∈ L := fun c => by
    rw [wiringExtendedCluster, hφJ]
    exact IntermediateField.subset_adjoin _ _ ⟨some c, rfl⟩
  have heval : ∀ (f : ℕ →+* MvPolynomial (Fin (n' + 2) × Fin (n' + 2)) ℤ)
      (R : MvPolynomial D.Chamber ℕ), φ (eval₂ f (wiringExtendedCluster D) R) ∈ L := by
    intro f R
    induction R using MvPolynomial.induction_on with
    | C a =>
      rw [eval₂_C, eq_natCast f, map_natCast]
      exact natCast_mem L a
    | add p q hp hq =>
      rw [eval₂_add, map_add]
      exact add_mem hp hq
    | mul_X p c hp =>
      rw [eval₂_mul, eval₂_X, map_mul]
      exact mul_mem hp (hx c)
  rw [aeval_def, aeval_def] at he
  rw [aeval_def] at hQ
  have he' := congrArg φ he
  rw [map_mul, mul_comm] at he'
  rw [← hφJ, eq_div_of_mul_eq ((map_ne_zero_iff φ hφ).2 hQ) he']
  exact div_mem (heval _ P) (heval _ Q)

/-- **The chamber minors and the determinant are algebraically independent.** For a wiring
diagram `D` on `k = n' + 2` strands and the generic `k × k` matrix `z` over `ℂ`, the family
`det z`, `P_{J(c)}(z)` (`c` a chamber of `D`), indexed by `Option D.Chamber` with `none ↦ det z`,
is algebraically independent over `ℂ`. -/
@[cluster_algebras "lem_wiring_minors_independent"]
theorem algebraicIndependent_det_flagMinor_chamberSet (D : WiringDiagram n') :
    AlgebraicIndependent ℂ (fun o : Option D.Chamber =>
      o.elim (complexGenericMatrix (n' + 2) (n' + 2)).det
        fun c => flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) c.chamberSet) := by
  refine AlgebraicIndependent.of_comp (IsScalarTower.toAlgHom ℂ (ComplexPoly (n' + 2) (n' + 2))
    (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) ?_
  refine algebraicIndependent_of_algebraicIndependent_mem_adjoin
    (w := fun o : Option D.Chamber =>
      algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
        (o.elim (complexGenericMatrix (n' + 2) (n' + 2)).det
          fun c => flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) c.chamberSet))
    (u := fun p : {p : Fin (n' + 2) × Fin (n' + 2) // p.1 ≤ p.2} =>
      algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
        (flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) (Finset.Icc p.1.1 p.1.2)))
    ((algebraicIndependent_flagMinor_Icc (n' + 2)).map'
      (f := IsScalarTower.toAlgHom ℂ (ComplexPoly (n' + 2) (n' + 2))
        (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) (IsFractionRing.injective _ _))
    (fun p => D.algebraMap_flagMinor_mem_adjoin ⟨p.1.1, Finset.mem_Icc.2 ⟨le_rfl, p.2⟩⟩) ?_
  rw [Fintype.card_option, D.card_chamber, card_solid, Nat.choose_succ_succ' (n' + 2) 1,
    Nat.choose_one_right]
  simp only [Nat.reduceAdd]
  omega

/-- The chamber minors `P_{J(c)}(z)` of a wiring diagram are algebraically independent. -/
theorem algebraicIndependent_flagMinor_chamberSet (D : WiringDiagram n') :
    AlgebraicIndependent ℂ fun c : D.Chamber =>
      flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) c.chamberSet :=
  (algebraicIndependent_det_flagMinor_chamberSet D).comp some (Option.some_injective _)

/-- **Distinct chambers have distinct chamber sets.** -/
@[cluster_algebras "lem_wiring_minors_independent"]
theorem WiringDiagram.chamberSet_injective (D : WiringDiagram n') :
    Function.Injective fun c : D.Chamber => c.chamberSet := fun _ _ h =>
  (algebraicIndependent_flagMinor_chamberSet D).injective
    (congrArg (flagMinor (complexGenericMatrix (n' + 2) (n' + 2))) h)

/-- Through a chamber labelling `λ`, the chamber minors `P_{J(λ(i))}(z)` are algebraically
independent. -/
theorem algebraicIndependent_flagMinor_labelling (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    AlgebraicIndependent ℂ fun i : Fin m =>
      flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) (L.equiv i).chamberSet :=
  (algebraicIndependent_flagMinor_chamberSet D).comp _ L.equiv.injective

/-- Through a chamber labelling `λ`, the `m + 1` polynomials `P_{J(λ(1))}(z), …, P_{J(λ(m))}(z),
det z` are algebraically independent. -/
theorem algebraicIndependent_flagMinor_labelling_append_det (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    AlgebraicIndependent ℂ (Fin.append (fun i : Fin m =>
      flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) (L.equiv i).chamberSet)
        ![(complexGenericMatrix (n' + 2) (n' + 2)).det]) := by
  let e : Fin (m + 1) → Option D.Chamber := Fin.append (fun i => some (L.equiv i)) ![none]
  have he : Function.Injective e := by
    intro i j hij
    induction i using Fin.addCases <;> induction j using Fin.addCases <;>
      simp_all [e, Fin.append_left, Fin.append_right, Fin.fin_one_eq_zero]
  convert (algebraicIndependent_det_flagMinor_chamberSet D).comp e he using 2
  ext i
  induction i using Fin.addCases <;> simp [e, Fin.append_left, Fin.append_right]

/-- The entries of `Σ(D, λ)` are algebraically independent over `ℂ`. -/
theorem algebraicIndependent_wiringSeed_extCluster (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    AlgebraicIndependent ℂ (wiringSeed D L).extCluster :=
  (algebraicIndependent_flagMinor_labelling D L).map'
    (f := IsScalarTower.toAlgHom ℂ (ComplexPoly (n' + 2) (n' + 2))
      (FractionRing (ComplexPoly (n' + 2) (n' + 2))))
    (IsFractionRing.injective _ _)

/-- The entries of `Σ(D, λ)` together with `det z` are algebraically independent over `ℂ`: the
extended cluster of the extension of `Σ(D, λ)` by the dummy frozen variable `det z`. -/
theorem algebraicIndependent_wiringSeed_extCluster_append_det (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    AlgebraicIndependent ℂ (Fin.append (wiringSeed D L).extCluster
      ![algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
        (complexGenericMatrix (n' + 2) (n' + 2)).det]) := by
  convert (algebraicIndependent_flagMinor_labelling_append_det D L).map'
    (f := IsScalarTower.toAlgHom ℂ (ComplexPoly (n' + 2) (n' + 2))
      (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) (IsFractionRing.injective _ _) using 1
  ext i
  induction i using Fin.addCases <;> simp [wiringSeed, Fin.append_left, Fin.append_right]

end Wiring

/-! ### The seed of a wiring diagram -/

section Seed

variable {n' m n : ℕ}

/-- A chamber labelling of `D` numbers all `(k choose 2) + k - 1` chambers, `k = n' + 2`. -/
theorem Labelling.card_wiringQuiver {D : WiringDiagram n'} (L : Labelling D.wiringQuiver m n) :
    m = (n' + 2).choose 2 + (n' + 1) := by
  rw [← D.card_chamber, ← Fintype.card_fin m]
  exact Fintype.card_congr L.equiv

/-- A chamber labelling of `D` has `2(k - 1)` frozen indices, two per gap. -/
theorem Labelling.sub_eq_wiringQuiver {D : WiringDiagram n'} (L : Labelling D.wiringQuiver m n) :
    m - n = 2 * (n' + 1) := by
  rw [← D.card_not_bounded]
  have e : {i : Fin m // ¬((i : ℕ) < n)} ≃ {c : D.Chamber // ¬c.Bounded} :=
    L.equiv.subtypeEquiv fun i => by
      rw [not_lt, ← L.mem_frozen_iff, WiringDiagram.mem_frozen_wiringQuiver]
  rw [← Fintype.card_congr e, Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_subtype,
    Fin.card_filter_val_lt, min_eq_right L.le]

/-- `2 (k+1 choose 2) = (k + 1) k`. -/
private theorem choose_two_mul_two (k : ℕ) : (k + 1).choose 2 * 2 = (k + 1) * k := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Nat.choose_succ_succ' (k + 1) 1, Nat.choose_one_right, add_mul]
    simp only [Nat.reduceAdd]
    rw [ih]
    ring

/-- **The size of `Σ(D, λ)`**: `m = (k-1)(k+2)/2` for `k = n' + 2` strands. -/
@[cluster_algebras "lem_wiring_seed_is_seed"]
theorem Labelling.m_eq_wiringQuiver {D : WiringDiagram n'} (L : Labelling D.wiringQuiver m n) :
    m = (n' + 1) * (n' + 4) / 2 := by
  have h : (n' + 2).choose 2 * 2 = (n' + 2) * (n' + 1) := choose_two_mul_two (n' + 1)
  refine (Nat.div_eq_of_eq_mul_left two_pos ?_).symm
  rw [L.card_wiringQuiver, add_mul ((n' + 2).choose 2), h]
  ring

/-- **The rank of `Σ(D, λ)`**: `n = (k-1)(k-2)/2` for `k = n' + 2` strands. -/
@[cluster_algebras "lem_wiring_seed_is_seed"]
theorem Labelling.n_eq_wiringQuiver {D : WiringDiagram n'} (L : Labelling D.wiringQuiver m n) :
    n = (n' + 1) * n' / 2 := by
  have h : (n' + 2).choose 2 * 2 = (n' + 2) * (n' + 1) := choose_two_mul_two (n' + 1)
  have hm := L.card_wiringQuiver
  have hmn := L.sub_eq_wiringQuiver
  have hle := L.le
  refine (Nat.div_eq_of_eq_mul_left two_pos ?_).symm
  have hn : n + (n' + 1) = (n' + 2).choose 2 := by omega
  rw [← hn] at h
  nlinarith [h]

/-- For `k = n' + 2 ≥ 3` strands, `Σ(D, λ)` has rank `n ≥ 1`. -/
@[cluster_algebras "lem_wiring_seed_is_seed"]
theorem Labelling.one_le_n_wiringQuiver {D : WiringDiagram n'}
    (L : Labelling D.wiringQuiver m n) (hn' : 1 ≤ n') : 1 ≤ n := by
  rw [L.n_eq_wiringQuiver]
  exact (Nat.le_div_iff_mul_le two_pos).2 (by nlinarith)

/-- **The seed of a wiring diagram is a labeled seed.** For a wiring diagram `D` and a chamber
labelling `λ`, `Σ(D, λ)` is a labeled seed over `ℂ` in the subfield of `ℂ(z)` generated by its
entries: the chamber minors are algebraically independent, and the principal part of
`B̃(D, λ)`, with entries the signed counts `β(λ(i), λ(j))`, is skew-symmetric. -/
@[cluster_algebras "lem_wiring_seed_is_seed"]
theorem isLabeledSeed_wiringSeed (D : WiringDiagram n') (L : Labelling D.wiringQuiver m n) :
    IsLabeledSeed ℂ L.le ((wiringSeed D L).adjoinSelf ℂ) := by
  rw [isLabeledSeed_adjoinSelf_iff]
  refine ⟨algebraicIndependent_wiringSeed_extCluster D L, fun _ => 1, fun _ => one_pos,
    fun i j => ?_⟩
  simp only [wiringSeed, extExchangeMatrix, Matrix.submatrix_apply, Matrix.of_apply, id,
    Int.cast_id, one_mul]
  exact (neg_signedCount _ _ _).symm

end Seed

end ClusterAlgebras
