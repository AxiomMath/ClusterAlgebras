/-!
# The Starfish lemma

Let `𝕜` be a field of characteristic zero and `R` a `𝕜`-algebra that is a Noetherian integral
domain, integrally closed in its fraction field `Frac(R)`. Two elements of `R` are coprime if no
prime ideal of height one contains both. The Starfish lemma says that the cluster algebra
`𝒜(x̃, B̃)` of a labeled seed in a subfield `F ⊆ Frac(R)` lies in `R` as soon as the extended
cluster `x̃` and the exchanged entries `x'ₖ` of its `n` neighbours `μₖ(x̃, B̃)` lie in `R`, the
cluster variables of `x̃` are pairwise coprime, and each `xₖ` is coprime to `x'ₖ`.

A height-one prime `P` contains at most one cluster variable `xₖ` of `x̃`, and then not `x'ₖ`, so
the product of the cluster variables of one of the seeds `x̃, μ₁(x̃), …, μₙ(x̃)` avoids `P`. By
the Laurent phenomenon every cluster variable then lies in the localization `R_P`, and a normal
Noetherian domain is the intersection of its localizations at height-one primes.

## Main definitions

* `ClusterAlgebras.IsHeightOneCoprime`: `r, r' ∈ R` are coprime if no prime ideal of height one
  contains both.

## Main results

* `ClusterAlgebras.prod_notMem_or_exists_prod_update_notMem`: a height-one prime misses the
  product of the cluster variables of `x̃` or of one of its neighbours.
* `ClusterAlgebras.mem_range_algebraMap_of_mem_clusterAlgebraOfSeed_of_isIntegrallyClosed`: the
  Starfish lemma.

## Implementation notes

* The conventions are those of the factorial version
  (`ClusterAlgebras.mem_range_algebraMap_of_mem_clusterAlgebraOfSeed`): "`y ∈ R`", for
  `y ∈ Frac(R)`, is `y ∈ Set.range (algebraMap R (Frac R))`; the entries of `x̃` and the exchanged
  entries `x'ₖ` of `μₖ(x̃, B̃)` are given by their (unique) preimages in `R`.
* `IsHeightOneCoprime` is defined for any commutative ring. Elements generating the unit ideal
  are coprime in this sense (`IsCoprime.isHeightOneCoprime`). As FWZ remark, in a factorial
  domain the height-one primes are the ideals generated by prime elements, and the notion is
  "no common prime factor", the hypothesis of the factorial version.
* The avoidance lemma `ClusterAlgebras.prod_notMem_or_exists_prod_update_notMem` uses nothing
  about the seed: it is stated for arbitrary families `x, x' : ι → R` of a finite index type,
  `x'ₖ` replacing `xₖ` in the `k`-th product.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to cluster algebras*, Chapter 6,
  Section 6.4.
-/

@[expose] public section

namespace ClusterAlgebras

/-! ### Coprime elements -/

section Coprime

variable {R : Type*} [CommRing R]

/-- Two elements `r, r'` of a commutative ring `R` are *coprime* if no prime ideal of `R` of
height one contains both of them. -/
@[cluster_algebras "def_coprime_height_one"]
def IsHeightOneCoprime (r r' : R) : Prop :=
  ∀ P : Ideal R, P.IsPrime → P.height = 1 → r ∈ P → r' ∉ P

namespace IsHeightOneCoprime

variable {r r' s : R}

/-- A height-one prime containing `r` does not contain an element coprime to `r`. -/
theorem notMem (h : IsHeightOneCoprime r r') {P : Ideal R} [hP : P.IsPrime] (hP1 : P.height = 1)
    (hr : r ∈ P) : r' ∉ P :=
  h P hP hP1 hr

/-- Coprimality is symmetric. -/
theorem symm (h : IsHeightOneCoprime r r') : IsHeightOneCoprime r' r :=
  fun P hP hP1 hr' hr => h P hP hP1 hr hr'

/-- `IsHeightOneCoprime r r'` holds if and only if `IsHeightOneCoprime r' r` does. -/
theorem comm : IsHeightOneCoprime r r' ↔ IsHeightOneCoprime r' r :=
  ⟨symm, symm⟩

/-- A divisor of an element coprime to `r'` is coprime to `r'`. -/
theorem of_dvd_left (h : IsHeightOneCoprime s r') (hrs : r ∣ s) : IsHeightOneCoprime r r' :=
  fun P hP hP1 hr => h P hP hP1 (P.mem_of_dvd hrs hr)

/-- A divisor of an element coprime to `r` is coprime to `r`. -/
theorem of_dvd_right (h : IsHeightOneCoprime r s) (hrs : r' ∣ s) : IsHeightOneCoprime r r' :=
  (h.symm.of_dvd_left hrs).symm

/-- A unit is coprime to every element. -/
theorem of_isUnit_left (hr : IsUnit r) : IsHeightOneCoprime r r' :=
  fun P hP _ h _ => hP.ne_top (P.eq_top_of_isUnit_mem h hr)

/-- Every element is coprime to a unit. -/
theorem of_isUnit_right (hr' : IsUnit r') : IsHeightOneCoprime r r' :=
  (of_isUnit_left hr').symm

end IsHeightOneCoprime

/-- Elements generating the unit ideal are coprime: no proper ideal contains both. -/
theorem _root_.IsCoprime.isHeightOneCoprime {r r' : R} (h : IsCoprime r r') :
    IsHeightOneCoprime r r' := fun P hP _ hr hr' =>
  let ⟨a, b, hab⟩ := h
  hP.ne_top <| (Ideal.eq_top_iff_one P).2 <|
    hab ▸ P.add_mem (P.mul_mem_left a hr) (P.mul_mem_left b hr')

end Coprime

/-! ### The Starfish lemma -/

section Starfish

/-- **A height-one prime misses one of `n + 1` clusters.** Let `x, x' : ι → R` be families of
elements of a commutative ring indexed by a finite type, such that `xᵢ` and `xⱼ` are coprime for
`i ≠ j` and `xₖ` is coprime to `x'ₖ` for every `k`, and let `P` be a prime ideal of `R` of height
one. Then `∏ᵢ xᵢ ∉ P`, or there is `k` such that the product `∏ᵢ xᵢ` with `xₖ` replaced by `x'ₖ`
is not in `P`. -/
@[cluster_algebras "lem_starfish_avoid"]
theorem prod_notMem_or_exists_prod_update_notMem {R ι : Type*} [CommRing R] [Fintype ι]
    [DecidableEq ι] {x x' : ι → R} (hcop : Pairwise fun i j => IsHeightOneCoprime (x i) (x j))
    (hcop' : ∀ k, IsHeightOneCoprime (x k) (x' k)) {P : Ideal R} [P.IsPrime]
    (hP1 : P.height = 1) :
    ∏ i, x i ∉ P ∨ ∃ k, ∏ i, Function.update x k (x' k) i ∉ P := by
  rw [or_iff_not_imp_left, not_not]
  intro hprod
  obtain ⟨k, -, hk⟩ := Ideal.IsPrime.prod_mem_iff.1 hprod
  refine ⟨k, fun hk' => ?_⟩
  obtain ⟨j, -, hj⟩ := Ideal.IsPrime.prod_mem_iff.1 hk'
  rcases eq_or_ne j k with rfl | hjk
  · exact (hcop' _).notMem hP1 hk (by simpa using hj)
  · rw [Function.update_of_ne hjk] at hj
    exact (hcop (Ne.symm hjk)).notMem hP1 hk hj

variable {𝕜 R : Type*} [Field 𝕜] [CommRing R] [IsDomain R] [Algebra 𝕜 R] {m n : ℕ}

/-- **The Starfish lemma.** Let `R` be a `𝕜`-algebra that is a Noetherian integral domain,
integrally closed in its fraction field, `𝕜` of characteristic zero, and let `(x̃, B̃)` be a
labeled seed in a subfield `F ⊆ Frac(R)` over `𝕜`, `x̃ = (x₁, …, xₘ)`, such that
1. `x₁, …, xₘ ∈ R` (they are the images of `x i ∈ R`);
2. `xᵢ` and `xⱼ` are coprime for all `i ≠ j` in `[1, n]`;
3. for each `k ∈ [1, n]`, the entry `x'ₖ` of `μₖ(x̃, B̃)` in position `k` lies in `R` (it is the
   image of `x' k ∈ R`) and is coprime to `xₖ`.

Then `𝒜(x̃, B̃) ⊆ R`. -/
@[cluster_algebras "prop_starfish"]
theorem mem_range_algebraMap_of_mem_clusterAlgebraOfSeed_of_isIntegrallyClosed [CharZero 𝕜]
    [IsNoetherianRing R] [IsIntegrallyClosed R] (hmn : n ≤ m)
    {F : IntermediateField 𝕜 (FractionRing R)} {S : SeedData F m n} (hS : IsLabeledSeed 𝕜 hmn S)
    (x : Fin m → R) (hx : ∀ i, algebraMap R (FractionRing R) (x i) = S.extCluster i)
    (hcop : ∀ i j : Fin n, i ≠ j →
      IsHeightOneCoprime (x (Fin.castLE hmn i)) (x (Fin.castLE hmn j)))
    (x' : Fin n → R) (hx' : ∀ k, algebraMap R (FractionRing R) (x' k) =
      (seedMutation hmn S k).extCluster (Fin.castLE hmn k))
    (hcop' : ∀ k : Fin n, IsHeightOneCoprime (x (Fin.castLE hmn k)) (x' k))
    {y : F} (hy : y ∈ clusterAlgebraOfSeed 𝕜 hmn S) :
    (y : FractionRing R) ∈ Set.range (algebraMap R (FractionRing R)) := by
  classical
  obtain ⟨P, hP, rfl⟩ := exists_isSeedPattern hmn RegularTree.root hS
  refine hP.mem_range_algebraMap_of_forall_mem_range hmn x hx (fun z hz => ?_) hy
  refine mem_range_algebraMap_of_forall_height_eq_one _ fun p hp hp1 => ?_
  rcases prod_notMem_or_exists_prod_update_notMem (x := x ∘ Fin.castLE hmn) (x' := x')
    (fun i j hij => hcop i j hij) hcop' hp1 with h | ⟨k, hk⟩
  · exact hP.exists_mul_eq_of_prod_notMem hmn (t₁ := .root) x hx h hz
  · obtain ⟨t, ht⟩ := (RegularTree.root : RegularTree n).exists_adj k
    refine hP.exists_mul_eq_of_prod_notMem hmn (t₁ := t) _
      (hP.algebraMap_update_eq_extCluster hmn ht hx (hx' k)) ?_ hz
    rwa [← Function.update_comp_eq_of_injective _ (Fin.castLE_injective hmn)] at hk

end Starfish

end ClusterAlgebras
