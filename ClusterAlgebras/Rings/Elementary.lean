module

public import ClusterAlgebras.Rings.Defs
public import Mathlib.LinearAlgebra.Matrix.Transvection

/-!
# Elementary matrices generate `SL_p` and `U_p`

The elementary matrix `E_{ij}(s) = 1 + s e_{ij}`, `i ≠ j`, is Mathlib's
`Matrix.transvection i j s`. This file shows that the matrices of determinant `1` over a field
are exactly the finite products of elementary matrices, and that the lower unitriangular complex
matrices `U_p` are exactly the finite products of elementary matrices `E_{ij}(s)` with `i > j`.

For `SL`, Gaussian elimination writes a matrix as `L D L'` with `L`, `L'` products of
transvections and `D` diagonal, and a diagonal matrix of determinant `1` is a product of the
matrices `diag(1, …, c, …, c⁻¹, …, 1)`, each a product of six elementary matrices. For `U_p`,
the entries below the diagonal are cleared one at a time, always in the leftmost column that
still has one.

## Main results

* `ClusterAlgebras.det_eq_one_iff_exists_list_transvection`: a square matrix over a field has
  determinant `1` iff it is a product of transvections.
* `ClusterAlgebras.mem_lowerUnitriangular_iff_exists_list_transvection`: `u ∈ U_p` iff `u` is a
  product of transvections `E_{ij}(s)` with `j < i`.
* `ClusterAlgebras.one_mem_lowerUnitriangular`, `ClusterAlgebras.mul_mem_lowerUnitriangular`,
  `ClusterAlgebras.transvection_mem_lowerUnitriangular`: `U_p` is closed under products and
  contains the identity and the `E_{ij}(s)` with `j < i`.

## Implementation notes

* A finite product of elementary matrices is written
  `(l.map fun t => transvection t.1 t.2.1 t.2.2).prod` for a list `l` of triples `(i, j, s)`.
* [FWZ] states the generation of `SL_p` for complex matrices and `p ≥ 2`; it holds over any field
  and for any finite index type, `p ≤ 1` included (there the only matrix of determinant `1` is
  the empty product). Both statements are given as equivalences: the converse directions, that
  elementary matrices have determinant `1` and that products of the `E_{ij}(s)`, `i > j`, lie in
  `U_p`, are closure statements also used in [FWZ]. Neither needs `p ≥ 2`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

open Matrix

section Field

variable {n 𝕜 : Type*} [Fintype n] [DecidableEq n] [Field 𝕜]

/-- Membership in the submonoid generated by the elementary matrices `E_{ij}(s)` with `P i j`
means being a finite product of such matrices. -/
private theorem exists_list_of_mem_closure {R : Type*} [CommRing R] {P : n → n → Prop}
    {M : Matrix n n R}
    (hM : M ∈ Submonoid.closure {A | ∃ i j c, P i j ∧ transvection i j c = A}) :
    ∃ l : List (n × n × R), (∀ t ∈ l, P t.1 t.2.1) ∧
      M = (l.map fun t => transvection t.1 t.2.1 t.2.2).prod := by
  induction hM using Submonoid.closure_induction with
  | mem A hA =>
    obtain ⟨i, j, c, h, rfl⟩ := hA
    exact ⟨[(i, j, c)], by simpa using h, by simp⟩
  | one => exact ⟨[], by simp, by simp⟩
  | mul A B _ _ hA hB =>
    obtain ⟨l, hl, rfl⟩ := hA
    obtain ⟨l', hl', rfl⟩ := hB
    refine ⟨l ++ l', fun t ht => ?_, by simp⟩
    rcases List.mem_append.1 ht with h | h
    exacts [hl t h, hl' t h]

/-- `diag(1, …, c, …, c⁻¹, …, 1)` is a product of six elementary matrices. -/
private theorem diagonal_mem_closure_transvection {i j : n} (hij : i ≠ j) {c : 𝕜} (hc : c ≠ 0) :
    diagonal (fun k => if k = i then c else if k = j then c⁻¹ else 1) ∈
      Submonoid.closure {A : Matrix n n 𝕜 | ∃ i j c, i ≠ j ∧ transvection i j c = A} := by
  have key : diagonal (fun k => if k = i then c else if k = j then c⁻¹ else 1) =
      transvection i j c * transvection j i (-c⁻¹) * transvection i j c *
        transvection i j (-1) * transvection j i 1 * transvection i j (-1) := by
    refine Matrix.ext fun a b => ?_
    simp only [Matrix.mul_assoc]
    by_cases ha : a = i
    · subst ha
      simp only [transvection_mul_apply_same, transvection_mul_apply_of_ne, ne_eq, hij,
        Ne.symm hij, not_false_eq_true]
      simp only [transvection, one_apply, single_apply, diagonal_apply, add_apply]
      split_ifs <;> simp_all
    · by_cases haj : a = j
      · subst haj
        simp only [transvection_mul_apply_same, transvection_mul_apply_of_ne, ne_eq, hij,
          Ne.symm hij, not_false_eq_true]
        simp only [transvection, one_apply, single_apply, diagonal_apply, add_apply]
        split_ifs <;> simp_all
      · simp only [transvection_mul_apply_of_ne, ne_eq, ha, haj, not_false_eq_true]
        simp only [transvection, one_apply, single_apply, diagonal_apply, add_apply]
        split_ifs <;> simp_all
  rw [key]
  refine mul_mem (mul_mem (mul_mem (mul_mem (mul_mem ?_ ?_) ?_) ?_) ?_) ?_ <;>
    exact Submonoid.subset_closure ⟨_, _, _, by first | exact hij | exact hij.symm, rfl⟩

/-- A diagonal matrix of determinant `1` is a product of elementary matrices. -/
private theorem diagonal_mem_closure_transvection_of_prod_eq_one {D : n → 𝕜}
    (hD : ∏ k, D k = 1) :
    diagonal D ∈
      Submonoid.closure {A : Matrix n n 𝕜 | ∃ i j c, i ≠ j ∧ transvection i j c = A} := by
  rcases isEmpty_or_nonempty n with hn | ⟨⟨i₀⟩⟩
  · rw [Subsingleton.elim (diagonal D) 1]
    exact one_mem _
  have hD0 : ∀ k, D k ≠ 0 := fun k h => by
    simp [Finset.prod_eq_zero (Finset.mem_univ k) h] at hD
  have key : D = ∏ k ∈ Finset.univ.erase i₀,
      fun a => if a = k then D k else if a = i₀ then (D k)⁻¹ else 1 := by
    funext a
    rw [Finset.prod_apply]
    by_cases ha : a = i₀
    · subst ha
      rw [Finset.prod_congr rfl (g := fun k => (D k)⁻¹) fun k hk => by
        simp [(Finset.ne_of_mem_erase hk).symm], Finset.prod_inv_distrib]
      refine eq_inv_of_mul_eq_one_left ?_
      rw [Finset.mul_prod_erase _ _ (Finset.mem_univ a), hD]
    · rw [Finset.prod_eq_single a (fun k _ hka => by simp [Ne.symm hka, ha])
        (fun h => absurd (Finset.mem_erase.2 ⟨ha, Finset.mem_univ a⟩) h)]
      simp
  rw [key]
  exact Submonoid.prod_mem ((Submonoid.closure
      {A : Matrix n n 𝕜 | ∃ i j c, i ≠ j ∧ transvection i j c = A}).comap
        (diagonalRingHom n 𝕜).toMonoidHom) fun k hk =>
    diagonal_mem_closure_transvection (Finset.ne_of_mem_erase hk) (hD0 k)

/-- A finite product of elementary matrices has determinant `1`. -/
private theorem det_list_prod_transvection {R : Type*} [CommRing R] (l : List (n × n × R))
    (hl : ∀ t ∈ l, t.1 ≠ t.2.1) :
    (l.map fun t => transvection t.1 t.2.1 t.2.2).prod.det = 1 := by
  induction l with
  | nil => simp
  | cons t l ih =>
    rw [List.map_cons, List.prod_cons, det_mul, det_transvection_of_ne (h := hl t (by simp)),
      ih fun t' h => hl t' (List.mem_cons_of_mem _ h), one_mul]

/-- **Elementary matrices generate `SL`.** A square matrix over a field has determinant `1` iff
it is a finite product of elementary matrices `E_{ij}(s) = 1 + s e_{ij}`, `i ≠ j`. -/
@[cluster_algebras "lem_elementary_generate_sl"]
theorem det_eq_one_iff_exists_list_transvection {M : Matrix n n 𝕜} :
    M.det = 1 ↔ ∃ l : List (n × n × 𝕜), (∀ t ∈ l, t.1 ≠ t.2.1) ∧
      M = (l.map fun t => transvection t.1 t.2.1 t.2.2).prod := by
  refine ⟨fun hM => exists_list_of_mem_closure ?_, fun ⟨l, hl, hM⟩ => hM ▸
    det_list_prod_transvection l hl⟩
  obtain ⟨L, L', D, rfl⟩ := Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec M
  have hT : ∀ L : List (TransvectionStruct n 𝕜), (L.map TransvectionStruct.toMatrix).prod ∈
      Submonoid.closure {A : Matrix n n 𝕜 | ∃ i j c, i ≠ j ∧ transvection i j c = A} := by
    refine fun L => Submonoid.list_prod_mem _ fun A hA => ?_
    obtain ⟨t, -, rfl⟩ := List.mem_map.1 hA
    exact Submonoid.subset_closure ⟨t.i, t.j, t.c, t.hij, rfl⟩
  have hD : ∏ k, D k = 1 := by
    simpa [det_mul, TransvectionStruct.det_toMatrix_prod, det_diagonal] using hM
  exact mul_mem (mul_mem (hT L) (diagonal_mem_closure_transvection_of_prod_eq_one hD)) (hT L')

end Field

/-! ### Lower unitriangular matrices -/

section Unitriangular

variable {p : ℕ}

/-- The identity matrix is lower unitriangular. -/
theorem one_mem_lowerUnitriangular : (1 : Matrix (Fin p) (Fin p) ℂ) ∈ lowerUnitriangular p :=
  ⟨fun _ => one_apply_eq _, fun _ _ h => one_apply_ne h.ne⟩

/-- The product of two lower unitriangular matrices is lower unitriangular. -/
theorem mul_mem_lowerUnitriangular {u v : Matrix (Fin p) (Fin p) ℂ}
    (hu : u ∈ lowerUnitriangular p) (hv : v ∈ lowerUnitriangular p) :
    u * v ∈ lowerUnitriangular p := by
  refine ⟨fun i => ?_, fun i j hij => ?_⟩
  · rw [mul_apply, Finset.sum_eq_single i]
    · rw [hu.1 i, hv.1 i, one_mul]
    · intro k _ hki
      rcases lt_or_gt_of_ne hki with h | h
      · rw [hv.2 k i h, mul_zero]
      · rw [hu.2 i k h, zero_mul]
    · simp
  · rw [mul_apply]
    refine Finset.sum_eq_zero fun k _ => ?_
    rcases lt_or_ge i k with h | h
    · rw [hu.2 i k h, zero_mul]
    · rw [hv.2 k j (h.trans_lt hij), mul_zero]

/-- The elementary matrix `E_{ij}(s)` with `j < i` is lower unitriangular. -/
theorem transvection_mem_lowerUnitriangular {i j : Fin p} (hji : j < i) (s : ℂ) :
    transvection i j s ∈ lowerUnitriangular p := by
  refine ⟨fun k => ?_, fun a b hab => ?_⟩
  · simp only [transvection, add_apply, one_apply_eq, single_apply, add_eq_left]
    rw [if_neg]
    rintro ⟨rfl, rfl⟩
    exact lt_irrefl _ hji
  · simp only [transvection, add_apply, one_apply_ne hab.ne, single_apply, zero_add]
    rw [if_neg]
    rintro ⟨rfl, rfl⟩
    exact absurd hab (not_lt.2 hji.le)

/-- An element of `U_p` with no nonzero entry below the diagonal is the identity. -/
private theorem eq_one_of_mem_lowerUnitriangular {u : Matrix (Fin p) (Fin p) ℂ}
    (hu : u ∈ lowerUnitriangular p) (h : ∀ a b, b < a → u a b = 0) : u = 1 := by
  refine Matrix.ext fun a b => ?_
  rcases lt_trichotomy a b with hab | rfl | hab
  · rw [hu.2 a b hab, one_apply_ne hab.ne]
  · rw [hu.1 a, one_apply_eq]
  · rw [h a b hab, one_apply_ne hab.ne']

/-- The matrix `u` with its entry `(i, j)` cleared. -/
private theorem sub_single_apply (u : Matrix (Fin p) (Fin p) ℂ) (i j a b : Fin p) :
    (u - single i j (u i j)) a b = if a = i ∧ b = j then 0 else u a b := by
  by_cases hab : a = i ∧ b = j
  · obtain ⟨rfl, rfl⟩ := hab
    simp
  · simp only [sub_apply, single_apply, if_neg hab,
      if_neg fun h : i = a ∧ j = b => hab ⟨h.1.symm, h.2.symm⟩, sub_zero]

/-- Clearing an entry `(i, j)`, `j < i`, of an element of `U_p` gives an element of `U_p`. -/
private theorem sub_single_mem_lowerUnitriangular {u : Matrix (Fin p) (Fin p) ℂ}
    (hu : u ∈ lowerUnitriangular p) {i j : Fin p} (hji : j < i) :
    u - single i j (u i j) ∈ lowerUnitriangular p :=
  ⟨fun k => by rw [sub_single_apply, if_neg fun h => hji.ne (h.2.symm.trans h.1), hu.1],
    fun a b hab => by rw [sub_single_apply, hu.2 a b hab, ite_self]⟩

/-- If row `j` of `u` is the `j`-th standard basis row and `j < i`, then `u = E_{ij}(u_{ij}) u'`,
where `u'` is `u` with its entry `(i, j)` cleared. -/
private theorem transvection_mul_sub_single {u : Matrix (Fin p) (Fin p) ℂ} {i j : Fin p}
    (hji : j < i) (hrow : ∀ b, u j b = if j = b then 1 else 0) :
    transvection i j (u i j) * (u - single i j (u i j)) = u := by
  refine Matrix.ext fun a b => ?_
  by_cases ha : a = i
  · subst ha
    rw [transvection_mul_apply_same, sub_single_apply, sub_single_apply,
      if_neg (show ¬(j = a ∧ b = j) from fun h => hji.ne h.1), hrow]
    by_cases hb : b = j
    · simp [hb]
    · simp [hb, Ne.symm hb]
  · rw [transvection_mul_apply_of_ne (ha := ha), sub_single_apply, if_neg fun h => ha h.1]

/-- An element of `U_p` with `N` nonzero entries below the diagonal is a product of elementary
matrices `E_{ij}(c)` with `j < i`. By strong induction on `N`: if `(i, j)` is such an entry with
`j` least, row `j` of `u` is the `j`-th standard basis row, so `u = E_{ij}(u_{ij}) u'` where `u'`
is `u` with the entry `(i, j)` cleared. -/
private theorem exists_list_of_mem_lowerUnitriangular_aux (N : ℕ) :
    ∀ u ∈ lowerUnitriangular p,
      (Finset.univ.filter fun ij : Fin p × Fin p => ij.2 < ij.1 ∧ u ij.1 ij.2 ≠ 0).card = N →
      ∃ l : List (Fin p × Fin p × ℂ), (∀ t ∈ l, t.2.1 < t.1) ∧
        u = (l.map fun t => transvection t.1 t.2.1 t.2.2).prod := by
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro u hu hN
  set s := Finset.univ.filter fun ij : Fin p × Fin p => ij.2 < ij.1 ∧ u ij.1 ij.2 ≠ 0 with hs
  rcases s.eq_empty_or_nonempty with h | h
  · refine ⟨[], by simp, eq_one_of_mem_lowerUnitriangular hu fun a b hab => ?_⟩
    by_contra hne
    have : (a, b) ∈ s := by simp [hs, hab, hne]
    simp [h] at this
  obtain ⟨⟨i, j⟩, hmem, hmin⟩ := s.exists_min_image (fun ij => ij.2) h
  simp only [hs, Finset.mem_filter, Finset.mem_univ, true_and] at hmem
  have hrow : ∀ b, u j b = if j = b then 1 else 0 := by
    intro b
    rcases lt_trichotomy j b with hjb | rfl | hjb
    · rw [hu.2 j b hjb, if_neg hjb.ne]
    · rw [hu.1 j, if_pos rfl]
    · rw [if_neg hjb.ne']
      by_contra hne
      exact absurd (hmin (j, b) (by simp [hs, hjb, hne])) (not_le.2 hjb)
  have hcard : (Finset.univ.filter fun ij : Fin p × Fin p =>
      ij.2 < ij.1 ∧ (u - single i j (u i j)) ij.1 ij.2 ≠ 0).card < N := by
    rw [← hN]
    refine Finset.card_lt_card ((Finset.ssubset_iff_of_subset fun ab hab => ?_).2
      ⟨(i, j), ?_, by simp⟩)
    · simp only [hs, Finset.mem_filter, Finset.mem_univ, true_and, sub_single_apply] at hab ⊢
      refine ⟨hab.1, fun h0 => hab.2 ?_⟩
      rw [h0, ite_self]
    · rw [hs]
      exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hmem.1, hmem.2⟩
  obtain ⟨l, hl, hl'⟩ := ih _ hcard _ (sub_single_mem_lowerUnitriangular hu hmem.1) rfl
  refine ⟨(i, j, u i j) :: l, by simpa [hmem.1] using hl, ?_⟩
  rw [List.map_cons, List.prod_cons, ← hl', transvection_mul_sub_single hmem.1 hrow]

/-- **Elementary matrices generate `U_p`.** A complex `p × p` matrix is lower unitriangular iff
it is a finite product of elementary matrices `E_{ij}(s) = 1 + s e_{ij}` with `i > j`. -/
@[cluster_algebras "lem_elementary_generate_unitriangular"]
theorem mem_lowerUnitriangular_iff_exists_list_transvection {u : Matrix (Fin p) (Fin p) ℂ} :
    u ∈ lowerUnitriangular p ↔ ∃ l : List (Fin p × Fin p × ℂ), (∀ t ∈ l, t.2.1 < t.1) ∧
      u = (l.map fun t => transvection t.1 t.2.1 t.2.2).prod := by
  refine ⟨fun hu => exists_list_of_mem_lowerUnitriangular_aux _ u hu rfl, ?_⟩
  rintro ⟨l, hl, rfl⟩
  induction l with
  | nil => exact one_mem_lowerUnitriangular
  | cons t l ih =>
    rw [List.map_cons, List.prod_cons]
    exact mul_mem_lowerUnitriangular (transvection_mem_lowerUnitriangular (hl t (by simp)) _)
      (ih fun t' h => hl t' (List.mem_cons_of_mem _ h))

end Unitriangular

end ClusterAlgebras
