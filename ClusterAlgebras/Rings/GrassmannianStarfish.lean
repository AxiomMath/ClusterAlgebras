module

public import ClusterAlgebras.Rings.FlagInvariance
public import ClusterAlgebras.Rings.MatUInclusion
public import ClusterAlgebras.Rings.MinorIrreducible
public import ClusterAlgebras.Rings.PolynomialInvariants
public import ClusterAlgebras.Rings.RectanglesExchange
public import ClusterAlgebras.Rings.RectanglesSeed
public import ClusterAlgebras.Rings.StarfishUFD

/-!
# The cluster algebra of the rectangles seed lies in the Plücker ring

Let `z` be the generic `a × b` matrix over `ℂ` and `λ` a rectangle labelling. The cluster algebra
`𝒜(Σ_{a,b}(λ))` of the rectangles seed, a subalgebra of `ℂ(z)`, lies in the Plücker ring
`R_{a,b} = ℂ[z]^{SL_a(ℂ)}`.

The proof is FWZ's: `R = R_{a,b}` is factorial, every entry of `Σ_{a,b}(λ)` is a Plücker coordinate
and so lies in `R`, and the conditions of the Starfish lemma for factorial rings are checked on
the cluster variables and their exchanged partners. The cluster variables are Plücker coordinates
`P_{J(v)}` with pairwise distinct column sets, since the rectangles coordinates are algebraically
independent. The exchanged partner of `P_J` at a vertex of degree four is a Plücker coordinate with
a different column set, and at a vertex of degree six it is the polynomial `Ω_{p,q}` in Plücker
coordinates, which `P_J` does not divide in `ℂ[z]`. As `P_J` is a minor of `z`, no prime factor of
`P_J` in `R` divides a polynomial of `R` that `P_J` does not divide in `ℂ[z]`.

## Main results

* `ClusterAlgebras.card_rectLabel_sdiff_union`: the new label `(J ∖ {V, W}) ∪ {X, Y}` at a
  rectangle `(p, q)` with `p + 1 < a` and `q + 1 < b - a` has `a` elements.
* `ClusterAlgebras.clusterAlgebraOfSeed_rectanglesSeed_le_pluckerRing`: `𝒜(Σ_{a,b}(λ)) ⊆ R_{a,b}`,
  read in `ℂ(z)`.
* `ClusterAlgebras.exists_mem_pluckerRing_of_mem_clusterAlgebraOfSeed_rectanglesSeed`: the same,
  for the seed read in the subfield of `ℂ(z)` generated by its entries.

## Implementation notes

* The seed `Σ_{a,b}(λ)` lives in `ℂ(z) = FractionRing ℂ[z]`, while the Starfish lemma is stated
  for seeds in the fraction field of the factorial ring `R = R_{a,b}`. The inclusion `R ⊆ ℂ[z]`
  extends to an embedding `Frac(R) → ℂ(z)`; the seed with the same entries, read in `Frac(R)`, is
  carried by it to `Σ_{a,b}(λ)`, and with it its cluster algebra (`clusterAlgebraOfSeed_map`).
* "`y ∈ R_{a,b}`", for `y ∈ ℂ(z)`, is `y = f` for a polynomial `f ∈ R_{a,b}`, read in `ℂ(z)`.
* FWZ assume `2 ≤ a ≤ b - 2`. The inclusion holds for `1 ≤ a ≤ b`, the hypotheses under
  which `Σ_{a,b}(λ)` is a labeled seed: for `a = 1` or `b ≤ a + 1` there are no mutable indices.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset

variable {a b m n : ℕ}

/-- For a rectangle `(p, q)` with `p + 1 < a` and `q + 1 < b - a`, the set
`(J ∖ {rectColV, rectColW}) ∪ {rectColX, rectColY}`, where `J` is the label of `(p, q)`, has `a`
elements. -/
theorem card_rectLabel_sdiff_union {p : Fin a} {q : Fin (b - a)} (hp : (p : ℕ) + 1 < a)
    (hq : (q : ℕ) + 1 < b - a) :
    (rectLabel a b (some (p, q)) \ {rectColV (p, q), rectColW (p, q) hp} ∪
      {rectColX (p, q), rectColY (p, q)}).card = a := by
  have hsub : ({rectColV (p, q), rectColW (p, q) hp} : Finset (Fin b)) ⊆
      rectLabel a b (some (p, q)) := by
    intro c hc
    simp only [mem_insert, mem_singleton] at hc
    rcases hc with rfl | rfl <;>
      simp only [rectLabel, mem_filter, mem_univ, true_and, val_rectColV, val_rectColW] <;> omega
  have hdisj : Disjoint (rectLabel a b (some (p, q)) \ {rectColV (p, q), rectColW (p, q) hp})
      {rectColX (p, q), rectColY (p, q)} := by
    rw [disjoint_right]
    intro c hc
    simp only [mem_insert, mem_singleton] at hc
    rcases hc with rfl | rfl <;>
      simp [rectLabel, Fin.ext_iff] <;> omega
  have hxy : rectColX (p, q) ≠ rectColY (p, q) := by
    simp only [ne_eq, Fin.ext_iff, val_rectColX, val_rectColY]
    omega
  have hvw : rectColV (p, q) ≠ rectColW (p, q) hp := by
    simp only [ne_eq, Fin.ext_iff, val_rectColV, val_rectColW]
    omega
  rw [card_union_of_disjoint hdisj, card_sdiff_of_subset hsub, card_pair hxy, card_pair hvw,
    card_rectLabel_some]
  omega

/-- A mutable index of a rectangle labelling names a rectangle `(p, q)`. -/
private theorem exists_equiv_castLE_eq_some (L : RectangleLabelling a b m n) (k : Fin n) :
    ∃ pq : Fin a × Fin (b - a), L.equiv (Fin.castLE L.le k) = some pq :=
  Option.ne_none_iff_exists'.1 fun h => L.not_rectFrozen_castLE k (by rw [h]; trivial)

/-- The label of a mutable vertex has `a` elements. -/
private theorem card_univ_eq_card_rectLabel (L : RectangleLabelling a b m n) (k : Fin n) :
    (univ : Finset (Fin a)).card = (rectLabel a b (L.equiv (Fin.castLE L.le k))).card := by
  obtain ⟨pq, hpq⟩ := exists_equiv_castLE_eq_some L k
  rw [hpq, card_rectLabel_some, card_univ, Fintype.card_fin]

/-- Distinct cluster variables `P_{J(i)}`, `P_{J(j)}` of the rectangles seed share no prime factor
in `R_{a,b}`. -/
private theorem not_dvd_of_prime_dvd_pluckerCoord_rectLabel (ha : 1 ≤ a) (hab : a ≤ b)
    (L : RectangleLabelling a b m n) {i j : Fin n} (hij : i ≠ j) {p : pluckerRing a b}
    (hp : Prime p) (hpi : p ∣ ⟨_, pluckerCoord_mem_pluckerRing
      (rectLabel a b (L.equiv (Fin.castLE L.le i)))⟩) :
    ¬p ∣ ⟨_, pluckerCoord_mem_pluckerRing (rectLabel a b (L.equiv (Fin.castLE L.le j)))⟩ := by
  refine not_dvd_of_prime_dvd_minor_complexGenericMatrix (card_univ_eq_card_rectLabel L i) _ _
    (not_minor_complexGenericMatrix_dvd (univ_nonempty_iff.2 ⟨⟨0, ha⟩⟩)
      (card_univ_eq_card_rectLabel L i) (card_univ_eq_card_rectLabel L j) fun he => hij ?_) hp hpi
  exact Fin.castLE_injective L.le (L.equiv.injective
    ((algebraicIndependent_pluckerCoord_rectLabel ha hab).injective
      (congrArg (pluckerCoord (complexGenericMatrix a b)) (Prod.ext_iff.1 he).2)))

/-- At a mutable vertex `k` of the rectangles seed, the exchanged entry is a polynomial of
`R_{a,b}` which the old cluster variable `P_{J(k)}` does not divide in `ℂ[z]`. -/
private theorem exists_mem_pluckerRing_seedMutation_rectanglesSeed
    (L : RectangleLabelling a b m n) (k : Fin n) :
    ∃ f ∈ pluckerRing a b, algebraMap (ComplexPoly a b) _ f =
      (seedMutation L.le (rectanglesSeed L) k).extCluster (Fin.castLE L.le k) ∧
        ¬pluckerCoord (complexGenericMatrix a b) (rectLabel a b (L.equiv (Fin.castLE L.le k))) ∣
          f := by
  obtain ⟨⟨p, q⟩, hk⟩ := exists_equiv_castLE_eq_some L k
  obtain ⟨hp, hq⟩ := L.lt_of_equiv_castLE_eq_some k hk
  rw [hk]
  by_cases hdeg : (p : ℕ) = 0 ∨ (q : ℕ) = 0
  · refine ⟨_, pluckerCoord_mem_pluckerRing _,
      (seedMutation_rectanglesSeed_of_degree_four L k hk hp hdeg).symm, ?_⟩
    refine not_minor_complexGenericMatrix_dvd (univ_nonempty_iff.2 ⟨⟨0, by omega⟩⟩) ?_ ?_
      fun he => rectLabel_sdiff_union_ne hp hq (Prod.ext_iff.1 he).2.symm
    · rw [card_rectLabel_some, card_univ, Fintype.card_fin]
    · rw [card_rectLabel_sdiff_union hp hq, card_univ, Fintype.card_fin]
  obtain ⟨hp1, hq1⟩ : 1 ≤ (p : ℕ) ∧ 1 ≤ (q : ℕ) := by omega
  have hP : ∀ J, pluckerCoord (complexGenericMatrix a b) J ∈ pluckerRing a b :=
    pluckerCoord_mem_pluckerRing
  refine ⟨_, sub_mem (mul_mem (hP _) (hP _)) (mul_mem (hP _) (hP _)),
    (seedMutation_rectanglesSeed_of_degree_six L k hk hp hp1 hq1).symm, ?_⟩
  have hJ : rectLabel a b (some (p, q)) =
      rectBase (p, q) hp ∪ {rectColU (p, q), rectColV (p, q), rectColW (p, q) hp} := by
    refine (sdiff_union_of_subset fun c hc => ?_).symm
    simp only [mem_insert, mem_singleton] at hc
    rcases hc with rfl | rfl | rfl <;> simp [rectLabel] <;> omega
  rw [hJ]
  exact not_pluckerCoord_dvd_rectOmega hp hq hp1 hq1

/-- **`𝒜(Σ_{a,b}(λ)) ⊆ R_{a,b}`, read in `ℂ(z)`.** For `1 ≤ a ≤ b` and a rectangle labelling `λ`,
the cluster algebra of the rectangles seed `Σ_{a,b}(λ)`, a subalgebra of `ℂ(z)`, lies in the
image of the Plücker ring `R_{a,b} = ℂ[z]^{SL_a(ℂ)}`. -/
theorem clusterAlgebraOfSeed_rectanglesSeed_le_pluckerRing (ha : 1 ≤ a) (hab : a ≤ b)
    (L : RectangleLabelling a b m n) :
    clusterAlgebraOfSeed ℂ L.le (rectanglesSeed L) ≤
      (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) := by
  classical
  set R := pluckerRing a b
  have hι : Function.Injective ((IsScalarTower.toAlgHom ℂ _ _).comp R.val :
      R →ₐ[ℂ] FractionRing (ComplexPoly a b)) :=
    (IsFractionRing.injective (ComplexPoly a b) _).comp Subtype.val_injective
  let φ : FractionRing R →ₐ[ℂ] FractionRing (ComplexPoly a b) :=
    IsFractionRing.liftAlgHom hι
  have hφ : ∀ r : R, φ (algebraMap R (FractionRing R) r) =
      algebraMap _ _ (r : ComplexPoly a b) := fun r => by
    simp only [φ, IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
    rfl
  let x : Fin m → R := fun i =>
    ⟨pluckerCoord (complexGenericMatrix a b) (rectLabel a b (L.equiv i)),
      pluckerCoord_mem_pluckerRing _⟩
  let S : SeedData (FractionRing R) m n :=
    ⟨algebraMap R _ ∘ x, (rectanglesSeed L).extExchangeMatrix⟩
  have hSφ : S.map φ = rectanglesSeed L := by
    refine SeedData.ext (funext fun i => ?_) rfl
    simp [S, x, hφ, rectanglesSeed_extCluster]
  have hval : (S.adjoinSelf ℂ).map (φ.comp (IntermediateField.val _)) = rectanglesSeed L := hSφ
  have hS : IsLabeledSeed ℂ L.le (S.adjoinSelf ℂ) := by
    rw [isLabeledSeed_adjoinSelf_iff]
    have hD := (isLabeledSeed_adjoinSelf_iff ℂ _ _).1 (isLabeledSeed_rectanglesSeed ha hab L)
    refine ⟨AlgebraicIndependent.of_comp φ ?_, hD.2⟩
    rw [show φ ∘ S.extCluster = _ from congrArg SeedData.extCluster hSφ]
    exact hD.1
  have hnew : ∀ k : Fin n, ∃ r : R, algebraMap R (FractionRing R) r =
      (seedMutation L.le (S.adjoinSelf ℂ) k).extCluster (Fin.castLE L.le k) ∧
        ∀ p : R, Prime p → p ∣ x (Fin.castLE L.le k) → ¬p ∣ r := fun k => by
    obtain ⟨f, hf, hfe, hfd⟩ := exists_mem_pluckerRing_seedMutation_rectanglesSeed L k
    refine ⟨⟨f, hf⟩, φ.toRingHom.injective ?_, fun p hp hpx =>
      not_dvd_of_prime_dvd_minor_complexGenericMatrix (card_univ_eq_card_rectLabel L k) _ hf
        hfd hp hpx⟩
    change φ _ = φ _
    rw [hφ, hfe, ← hval, ← seedMutation_map]
    rfl
  choose x' hx' hcop' using hnew
  intro y hy
  rw [← hval, ← clusterAlgebraOfSeed_map] at hy
  obtain ⟨w, hw, rfl⟩ := hy
  obtain ⟨r, hr⟩ := mem_range_algebraMap_of_mem_clusterAlgebraOfSeed L.le hS x (fun _ => rfl)
    (fun _ _ hij _ hp => not_dvd_of_prime_dvd_pluckerCoord_rectLabel ha hab L hij hp) x' hx'
    hcop' hw
  refine ⟨r, r.2, ?_⟩
  change _ = φ (w : FractionRing R)
  rw [← hr, hφ]
  rfl

/-- **The cluster algebra of the rectangles seed lies in the Plücker ring.** For `1 ≤ a ≤ b` and a
rectangle labelling `λ`, every element `y` of `𝒜(Σ_{a,b}(λ))`, the seed read in the subfield of
`ℂ(z)` generated by its entries, is a polynomial `f ∈ R_{a,b}`, read in `ℂ(z)`. -/
theorem exists_mem_pluckerRing_of_mem_clusterAlgebraOfSeed_rectanglesSeed (ha : 1 ≤ a)
    (hab : a ≤ b) (L : RectangleLabelling a b m n)
    {y : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)}
    (hy : y ∈ clusterAlgebraOfSeed ℂ L.le ((rectanglesSeed L).adjoinSelf ℂ)) :
    ∃ f ∈ pluckerRing a b,
      algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b)) f = y := by
  have h : (y : FractionRing (ComplexPoly a b)) ∈
      (clusterAlgebraOfSeed ℂ L.le ((rectanglesSeed L).adjoinSelf ℂ)).map
        (IntermediateField.val _) := ⟨y, hy, rfl⟩
  rw [clusterAlgebraOfSeed_map, SeedData.map_val_adjoinSelf] at h
  exact clusterAlgebraOfSeed_rectanglesSeed_le_pluckerRing ha hab L h

end ClusterAlgebras
