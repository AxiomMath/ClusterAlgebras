module

public import ClusterAlgebras.Rings.Relations.Defs
public import ClusterAlgebras.LaurentPhenomenon.SharperStep

/-!
# Relations among the cluster variables of a finite subtree

Let `Σ` be a seed pattern of rank `n` in `F` over a field `K`, with `m × n` matrices, and let `T`
be a finite subtree of `𝕋ₙ`. Along a component of the forest `T[i]` the cluster variable in
position `i` does not change, so the evaluation `ev_T` sends `ζ(t)` to the extended cluster
`x̃(t)` for every `t ∈ T`, and its image is the subalgebra `𝒜_T` generated by these clusters.
The exchange relations of the edges of `T` say that the exchange polynomials vanish under `ev_T`.

Conversely, every relation among the cluster variables of `T` comes from the exchange relations
up to a monomial in the mutable formal variables. The proof, a double induction from [FWZ],
measures formal variables by their depth from a root `t₀ ∈ T`: the variables of depth `0` are the
entries of `ζ(t₀)`, whose images are algebraically independent, and every deeper variable `z` has
an exchange relation `z z' - N₁ - N₂ ∈ I_T` towards the root. Multiplying a relation `f` by `z'`
and reducing modulo this one lowers the degree of `f` in the deepest variables. The upshot is that
the kernel of `ev_T` is the saturated exchange ideal `J_T`, so `K[z_T]/J_T ≅ 𝒜_T`.

## Main results

* `ClusterAlgebras.subtreeEval_formalCluster`, `ClusterAlgebras.range_subtreeEval`:
  `ev_T(ζ(t)) = x̃(t)` and `ev_T(K[z_T]) = 𝒜_T`.
* `ClusterAlgebras.subtreeEval_exchangePolynomial`: `ev_T(E_{t,t'}) = 0`.
* `ClusterAlgebras.eq_zero_of_subtreeEval_eq_zero`: a relation among the depth-`0` variables is
  trivial.
* `ClusterAlgebras.exists_mul_sub_sub_mem_exchangeIdeal`: the exchange relation of a deeper
  variable towards the root.
* `ClusterAlgebras.exists_monomial_mul_mem_exchangeIdeal`: a relation times a monomial in the
  mutable variables lies in `I_T`.
* `ClusterAlgebras.subtreeEval_eq_zero_iff`: `ev_T(f) = 0 ↔ f ∈ J_T`.
* `ClusterAlgebras.subtreeQuotientEquiv`: `K[z_T]/J_T ≃ₐ[K] 𝒜_T`.

## Implementation notes

* FWZ take `K` of characteristic zero; nothing here uses it, so it is not assumed.
* The double induction on `(D(f), e(f))` is run as an induction on a bound `δ` for the depths of
  the variables occurring in `f`, and inside it a strong induction on the sum `e(f)` of the
  degrees of `f` in the variables of depth exactly `δ`; this is FWZ's lexicographic
  induction. The polynomials `g` and `h` with `f = z g + h` are the quotient and the remainder
  of `f` on division by the monomial `z` (`MvPolynomial.divMonomial`, `MvPolynomial.modMonomial`).

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to cluster algebras. Chapter 6*,
  Section 6.8.
-/

@[expose] public section

namespace ClusterAlgebras

open MvPolynomial RegularTree

variable {K : Type*} {F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

section Constant

variable {hmn : n ≤ m} {P : RegularTree n → SeedData F m n}

/-- The frozen variables of a seed pattern are the same at every vertex. -/
theorem IsSeedPattern.extCluster_eq_of_le (hP : IsSeedPattern K hmn P) (t t' : RegularTree n)
    {r : Fin m} (hr : n ≤ (r : ℕ)) : (P t).extCluster r = (P t').extCluster r := by
  rw [hP.apply_eq_seedMutationSeq_root hmn t, hP.apply_eq_seedMutationSeq_root hmn t',
    seedMutationSeq_extCluster_of_le hmn _ _ hr, seedMutationSeq_extCluster_of_le hmn _ _ hr]

/-- The cluster variable in position `i` is the same at any two vertices of `T` joined by a walk
in the forest `T[i]`. -/
theorem IsSeedPattern.extCluster_castLE_eq_of_reachable (hP : IsSeedPattern K hmn P)
    {T : Finset (RegularTree n)} {i : Fin n} {t t' : T} (h : (subtreeForest T i).Reachable t t') :
    (P t).extCluster (Fin.castLE hmn i) = (P t').extCluster (Fin.castLE hmn i) := by
  rw [SimpleGraph.reachable_iff_reflTransGen] at h
  induction h with
  | refl => rfl
  | tail _ hadj ih =>
    rw [ih]
    obtain ⟨k, hki, hk⟩ := subtreeForest_adj.1 hadj
    rw [hP.2 k _ _ hk]
    exact (Function.update_of_ne (fun h => hki (Fin.castLE_injective hmn h).symm) _ _).symm

/-- `ev_T(z_r) = x_r`, the entry in the frozen position `r` of the seed at the root. -/
@[simp]
theorem subtreeEval_X_inl (T : Finset (RegularTree n)) (r : FrozenIndex m n) :
    subtreeEval K hmn P T (X (.inl r)) = (P .root).extCluster r := by
  simp [subtreeEval]

/-- `ev_T(z_{i,C_i(t)}) = x_{i;t}`: the image of a mutable formal variable is the cluster variable
in position `i` of any seed of its component, whichever vertex the evaluation chose. -/
theorem subtreeEval_X_inr_subtreeComponent (hP : IsSeedPattern K hmn P)
    (T : Finset (RegularTree n)) (i : Fin n) (t : T) :
    subtreeEval K hmn P T (X (.inr ⟨i, subtreeComponent T i t⟩)) =
      (P t).extCluster (Fin.castLE hmn i) := by
  simp only [subtreeEval, aeval_X, Sum.elim_inr]
  exact hP.extCluster_castLE_eq_of_reachable
    (SimpleGraph.ConnectedComponent.exact (Quot.out_eq (subtreeComponent T i t)))

/-- **A cluster variable is constant on a component**: `ev_T(ζ(t)) = x̃(t)` entrywise for every
`t ∈ T`. -/
@[cluster_algebras "lem_component_constant"]
theorem subtreeEval_formalCluster (hP : IsSeedPattern K hmn P) (T : Finset (RegularTree n))
    (t : T) (r : Fin m) : subtreeEval K hmn P T (formalCluster K T t r) = (P t).extCluster r := by
  unfold formalCluster formalVarOf
  split_ifs with h
  · exact subtreeEval_X_inr_subtreeComponent hP T ⟨r, h⟩ t
  · rw [subtreeEval_X_inl]
    exact hP.extCluster_eq_of_le _ _ (not_lt.1 h)

/-- **The image of the evaluation is `𝒜_T`**: `ev_T(K[z_T]) = 𝒜_T` for a nonempty set `T` of
vertices. -/
@[cluster_algebras "lem_component_constant"]
theorem range_subtreeEval (hP : IsSeedPattern K hmn P) {T : Finset (RegularTree n)}
    (hT : T.Nonempty) : (subtreeEval K hmn P T).range = subtreeAlgebra K P T := by
  rw [subtreeEval, aeval_range, subtreeAlgebra]
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_iUnion, exists_prop]
  constructor
  · rintro ⟨v, rfl⟩
    rcases v with r | ⟨i, C⟩
    · obtain ⟨t, ht⟩ := hT
      exact ⟨t, ht, r.1, hP.extCluster_eq_of_le _ _ r.2⟩
    · exact ⟨_, (Quot.out C).2, _, rfl⟩
  · rintro ⟨t, ht, r, rfl⟩
    refine ⟨formalVarOf T ⟨t, ht⟩ r, ?_⟩
    simpa [subtreeEval, formalCluster] using subtreeEval_formalCluster hP T ⟨t, ht⟩ r

end Constant

section Vanish

variable {hmn : n ≤ m} {P : RegularTree n → SeedData F m n}

/-- **The exchange polynomials vanish**: `ev_T(E_{t,t'}) = 0` for vertices `t, t' ∈ T` joined by
an edge labelled `k`. -/
@[cluster_algebras "lem_exchange_polynomial_vanishes"]
theorem subtreeEval_exchangePolynomial (hP : IsSeedPattern K hmn P) (T : Finset (RegularTree n))
    {t t' : T} {k : Fin n} (h : RegularTree.Adj k t t') :
    subtreeEval K hmn P T (exchangePolynomial K P T t t' k) = 0 := by
  have hne : (P t).extCluster (Fin.castLE hmn k) ≠ 0 := (hP.1 t).1.1.ne_zero _
  simp only [exchangePolynomial, map_sub, map_mul, map_prod, map_pow,
    subtreeEval_X_inr_subtreeComponent hP, subtreeEval_formalCluster hP]
  rw [← exchangeMonomialPos_eq_prod, ← exchangeMonomialNeg_eq_prod, hP.2 k _ _ h]
  simp only [seedMutation, Function.update_self]
  field_simp
  ring

/-- The exchange ideal lies in the kernel of the evaluation. -/
theorem exchangeIdeal_le_ker (hP : IsSeedPattern K hmn P) (T : Finset (RegularTree n)) :
    exchangeIdeal K P T ≤ RingHom.ker (subtreeEval K hmn P T) := by
  rw [exchangeIdeal, Ideal.span_le]
  rintro _ ⟨t, t', k, h, rfl⟩
  exact RingHom.mem_ker.2 (subtreeEval_exchangePolynomial hP T h)

end Vanish

section Root

/-- A formal variable of depth `0` is an entry of `ζ(t₀)`. -/
theorem mem_range_formalVarOf_of_formalVarDepth_eq_zero (hmn : n ≤ m)
    {T : Finset (RegularTree n)} (hT : IsFiniteSubtree T) (t₀ : T) {v : FormalVar m T}
    (hv : formalVarDepth T t₀ v = 0) : v ∈ Set.range (formalVarOf T t₀) := by
  rcases v with r | ⟨i, C⟩
  · exact ⟨r.1, formalVarOf_of_le T t₀ r.2⟩
  · obtain ⟨s, hs, hd⟩ := exists_mem_supp_dist_eq_formalVarDepth (m := m) T t₀ C
    rw [hv, hT.dist_eq_zero_iff] at hd
    subst hd
    refine ⟨Fin.castLE hmn i, ?_⟩
    rw [formalVarOf_castLE, show subtreeComponent T i t₀ = C from (C.mem_supp_iff _).1 hs]

variable {hmn : n ≤ m} {P : RegularTree n → SeedData F m n}

/-- **The root variables are algebraically independent**: a polynomial involving only formal
variables of depth `0` and vanishing under `ev_T` is zero. -/
@[cluster_algebras "lem_root_variables_independent"]
theorem eq_zero_of_subtreeEval_eq_zero (hP : IsSeedPattern K hmn P) {T : Finset (RegularTree n)}
    (hT : IsFiniteSubtree T) (t₀ : T) {f : MvPolynomial (FormalVar m T) K}
    (hf : ∀ v ∈ f.vars, formalVarDepth T t₀ v = 0) (h : subtreeEval K hmn P T f = 0) : f = 0 := by
  obtain ⟨g, rfl⟩ := exists_rename_eq_of_vars_subset_range f (formalVarOf T t₀)
    (formalVarOf_injective T t₀) fun v hv =>
      mem_range_formalVarOf_of_formalVarDepth_eq_zero hmn hT t₀ (hf v hv)
  have hcomp : (subtreeEval K hmn P T).comp (rename (formalVarOf T t₀)) =
      aeval (P t₀).extCluster := by
    ext r
    simpa [formalCluster] using subtreeEval_formalCluster hP T t₀ r
  rw [(injective_iff_map_eq_zero _).1 (hP.1 t₀).1.1 g (by rwa [← hcomp]), map_zero]

end Root

section Parent

omit [Field F] [Algebra K F] in
/-- **Each deeper variable has an exchange relation towards the root**: for a mutable formal
variable `z` of depth `δ > 0` there are a mutable formal variable `z'` and monomials `N₁`, `N₂`,
all in variables of depth less than `δ`, with `z z' - N₁ - N₂ ∈ I_T`. -/
@[cluster_algebras "lem_exchange_ideal_parent"]
theorem exists_mul_sub_sub_mem_exchangeIdeal (P : RegularTree n → SeedData F m n)
    {T : Finset (RegularTree n)} (hT : IsFiniteSubtree T) (t₀ : T)
    (z : Σ i : Fin n, (subtreeForest T i).ConnectedComponent)
    (hz : 0 < formalVarDepth T t₀ (.inr z : FormalVar m T)) :
    ∃ (z' : Σ i : Fin n, (subtreeForest T i).ConnectedComponent) (a b : FormalVar m T →₀ ℕ),
      formalVarDepth T t₀ (.inr z' : FormalVar m T) <
        formalVarDepth T t₀ (.inr z : FormalVar m T) ∧
      (∀ v ∈ a.support, formalVarDepth T t₀ v < formalVarDepth T t₀ (.inr z : FormalVar m T)) ∧
      (∀ v ∈ b.support, formalVarDepth T t₀ v < formalVarDepth T t₀ (.inr z : FormalVar m T)) ∧
      X (.inr z) * X (.inr z') - monomial a (1 : K) - monomial b 1 ∈ exchangeIdeal K P T := by
  classical
  obtain ⟨k, C⟩ := z
  obtain ⟨s, hs, hds⟩ := exists_mem_supp_dist_eq_formalVarDepth (m := m) T t₀ C
  set δ := formalVarDepth T t₀ (.inr ⟨k, C⟩ : FormalVar m T)
  obtain ⟨p, hp⟩ := hT.exists_walk_length_eq_dist s t₀
  rw [SimpleGraph.dist_comm, hds] at hp
  cases p with
  | nil =>
    simp only [SimpleGraph.Walk.length_nil] at hp
    omega
  | @cons _ s' _ hadj p' =>
    have hd' : (subtreeGraph T).dist t₀ s' < δ := by
      rw [SimpleGraph.dist_comm]
      have := SimpleGraph.dist_le p'
      simp only [SimpleGraph.Walk.length_cons] at hp
      omega
    obtain ⟨j, hj⟩ := subtreeGraph_adj.1 hadj
    have hCs : subtreeComponent T k s = C := (C.mem_supp_iff s).1 hs
    obtain rfl : j = k := by
      by_contra hjk
      exact not_le.2 hd' (formalVarDepth_inr_le T t₀ ((C.mem_supp_iff s').2
        ((SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj
          (subtreeForest_adj.2 ⟨j, hjk, hj⟩)).symm.trans hCs)))
    have hsupp : ∀ (e : Fin m → ℕ),
        ∀ v ∈ (∑ i, Finsupp.single (formalVarOf T s' i) (e i)).support,
          formalVarDepth T t₀ v < δ := by
      intro e v hv
      obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.1 (Finsupp.support_finsetSum hv)
      rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hi)]
      exact (formalVarDepth_formalVarOf_le T t₀ s' i).trans_lt hd'
    refine ⟨⟨j, subtreeComponent T j s'⟩,
      ∑ i, Finsupp.single (formalVarOf T s' i) ((P s').extExchangeMatrix i j).toNat,
      ∑ i, Finsupp.single (formalVarOf T s' i) (-(P s').extExchangeMatrix i j).toNat,
      (formalVarDepth_inr_le T t₀ rfl).trans_lt hd', hsupp _, hsupp _, ?_⟩
    convert mem_exchangeIdeal_of_adj (K := K) P T hj.symm using 1
    rw [exchangePolynomial, hCs]
    simp only [formalCluster, X_pow_eq_monomial, ← monomial_sum_one]
    ring

end Parent

section Division

variable {σ R : Type*} [CommSemiring R] (f : MvPolynomial σ R) (z w : σ)

/-- Dividing by a variable does not raise the degree in any variable. -/
theorem degreeOf_divMonomial_single_le :
    degreeOf w (f.divMonomial (Finsupp.single z 1)) ≤ degreeOf w f := by
  refine degreeOf_le_iff.2 fun s hs => ?_
  rw [mem_support_iff, coeff_divMonomial] at hs
  have := monomial_le_degreeOf w (mem_support_iff.2 hs)
  rw [Finsupp.add_apply] at this
  omega

/-- Dividing by a variable `z` lowers the degree in `z`, when `z` occurs. -/
theorem degreeOf_divMonomial_single_self_lt (hz : 0 < degreeOf z f) :
    degreeOf z (f.divMonomial (Finsupp.single z 1)) < degreeOf z f := by
  refine (degreeOf_lt_iff hz).2 fun s hs => ?_
  rw [mem_support_iff, coeff_divMonomial] at hs
  have := monomial_le_degreeOf z (mem_support_iff.2 hs)
  rw [Finsupp.add_apply, Finsupp.single_eq_same] at this
  omega

/-- The remainder on division by a variable does not raise the degree in any variable. -/
theorem degreeOf_modMonomial_single_le :
    degreeOf w (f.modMonomial (Finsupp.single z 1)) ≤ degreeOf w f := by
  refine degreeOf_le_iff.2 fun s hs => ?_
  rw [mem_support_iff] at hs
  by_cases hle : Finsupp.single z 1 ≤ s
  · exact absurd (coeff_modMonomial_of_le f hle) hs
  · rw [coeff_modMonomial_of_not_le f hle] at hs
    exact monomial_le_degreeOf w (mem_support_iff.2 hs)

/-- The remainder on division by a variable `z` does not involve `z`. -/
theorem degreeOf_modMonomial_single_self :
    degreeOf z (f.modMonomial (Finsupp.single z 1)) = 0 := by
  refine Nat.eq_zero_of_le_zero (degreeOf_le_iff.2 fun s hs => ?_)
  rw [mem_support_iff] at hs
  by_cases hle : Finsupp.single z 1 ≤ s
  · exact absurd (coeff_modMonomial_of_le f hle) hs
  · rw [Finsupp.single_le_iff] at hle
    omega

end Division

section Reduction

omit [Field F] [Algebra K F] in
/-- One step of the reduction: multiplying `f` by the partner `z'` of a variable `z` of depth
`δ + 1` and reducing modulo the exchange relation of `z` lowers the degree of `f` in the variables
of depth `δ + 1`, without creating deeper variables. -/
private theorem exists_reduction_step (P : RegularTree n → SeedData F m n)
    {T : Finset (RegularTree n)} (hT : IsFiniteSubtree T) (t₀ : T) {δ : ℕ}
    {S : Finset (FormalVar m T)} (hS : ∀ v ∈ S, formalVarDepth T t₀ v = δ + 1)
    {f : MvPolynomial (FormalVar m T) K}
    (hdeg : ∀ v, δ + 1 < formalVarDepth T t₀ v → degreeOf v f = 0) {z : FormalVar m T}
    (hzS : z ∈ S) (hz : degreeOf z f ≠ 0) :
    ∃ (z' : Σ i : Fin n, (subtreeForest T i).ConnectedComponent)
      (f' : MvPolynomial (FormalVar m T) K),
      (∀ v, δ + 1 < formalVarDepth T t₀ v → degreeOf v f' = 0) ∧
      ∑ v ∈ S, degreeOf v f' < ∑ v ∈ S, degreeOf v f ∧
      X (.inr z') * f - f' ∈ exchangeIdeal K P T := by
  classical
  have hdz := hS z hzS
  rcases z with r | z₀
  · simp at hdz
  obtain ⟨z', a, b, hz', ha, hb, hE⟩ :=
    exists_mul_sub_sub_mem_exchangeIdeal (K := K) P hT t₀ z₀ (by omega)
  rw [hdz] at hz' ha hb
  obtain ⟨g, hg⟩ : ∃ g, g = f.divMonomial (Finsupp.single (Sum.inr z₀) 1) := ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h, h = f.modMonomial (Finsupp.single (Sum.inr z₀) 1) := ⟨_, rfl⟩
  have hlow : ∀ w, δ + 1 ≤ formalVarDepth T t₀ w → w ≠ Sum.inr z' ∧ a w = 0 ∧ b w = 0 :=
    fun w hw => ⟨by rintro rfl; omega,
      Finsupp.notMem_support_iff.1 fun hw' => (ha w hw').not_ge hw,
      Finsupp.notMem_support_iff.1 fun hw' => (hb w hw').not_ge hw⟩
  have hf'deg : ∀ w, δ + 1 ≤ formalVarDepth T t₀ w →
      degreeOf w (X (Sum.inr z') * h + (monomial a 1 + monomial b 1) * g) ≤
        max (degreeOf w h) (degreeOf w g) := fun w hw => by
    obtain ⟨hwz, haw, hbw⟩ := hlow w hw
    refine (degreeOf_add_le _ _ _).trans (max_le_max ?_ ?_)
    · refine (degreeOf_mul_le _ _ _).trans ?_
      rw [degreeOf_X, if_neg hwz, zero_add]
    · refine (degreeOf_mul_le _ _ _).trans ?_
      have hN0 : degreeOf w (monomial a (1 : K) + monomial b 1) = 0 := by
        refine Nat.eq_zero_of_le_zero ((degreeOf_add_le _ _ _).trans ?_)
        rw [degreeOf_monomial_eq _ _ one_ne_zero, degreeOf_monomial_eq _ _ one_ne_zero, haw, hbw,
          max_self]
      rw [hN0, zero_add]
  have hh_le : ∀ w, degreeOf w h ≤ degreeOf w f := fun w =>
    hh ▸ degreeOf_modMonomial_single_le f _ w
  have hg_le : ∀ w, degreeOf w g ≤ degreeOf w f := fun w =>
    hg ▸ degreeOf_divMonomial_single_le f _ w
  refine ⟨z', X (Sum.inr z') * h + (monomial a 1 + monomial b 1) * g,
    fun v hv => Nat.eq_zero_of_le_zero ((hf'deg v hv.le).trans
      (max_le ((hh_le v).trans (hdeg v hv).le) ((hg_le v).trans (hdeg v hv).le))),
    Finset.sum_lt_sum (fun v hv => (hf'deg v (hS v hv).ge).trans (max_le (hh_le v) (hg_le v)))
      ⟨Sum.inr z₀, hzS, (hf'deg _ hdz.ge).trans_lt (max_lt ?_ ?_)⟩, ?_⟩
  · rw [hh, degreeOf_modMonomial_single_self]
    exact Nat.pos_of_ne_zero hz
  · rw [hg]
    exact degreeOf_divMonomial_single_self_lt f _ (Nat.pos_of_ne_zero hz)
  · convert Ideal.mul_mem_right g _ hE using 1
    rw [← divMonomial_add_modMonomial_single f (Sum.inr z₀), ← hg, ← hh]
    ring

variable {hmn : n ≤ m} {P : RegularTree n → SeedData F m n}

/-- The inductive step on the depth bound `δ`, by strong induction on the total degree in the
variables of depth `δ + 1`: if every polynomial vanishing under `ev_T` and involving no variable
of depth more than `δ` has a multiple `M f ∈ I_T` by a monomial `M` in the mutable variables, then
so does every such polynomial involving no variable of depth more than `δ + 1`. -/
private theorem exists_monomial_mul_mem_exchangeIdeal_succ (hP : IsSeedPattern K hmn P)
    {T : Finset (RegularTree n)} (hT : IsFiniteSubtree T) (t₀ : T) {δ : ℕ}
    (ih : ∀ f : MvPolynomial (FormalVar m T) K,
      (∀ v, δ < formalVarDepth T t₀ v → degreeOf v f = 0) → subtreeEval K hmn P T f = 0 →
        ∃ a : FormalVar m T →₀ ℕ, (∀ v ∈ a.support, v.isRight) ∧
          monomial a 1 * f ∈ exchangeIdeal K P T)
    (f : MvPolynomial (FormalVar m T) K)
    (hdeg : ∀ v, δ + 1 < formalVarDepth T t₀ v → degreeOf v f = 0)
    (hf : subtreeEval K hmn P T f = 0) :
    ∃ a : FormalVar m T →₀ ℕ, (∀ v ∈ a.support, v.isRight) ∧
      monomial a 1 * f ∈ exchangeIdeal K P T := by
  classical
  haveI : Fintype (FormalVar m T) := Fintype.ofFinite _
  set S := Finset.univ.filter fun v => formalVarDepth (m := m) T t₀ v = δ + 1
  obtain ⟨N, hN⟩ : ∃ N, ∑ v ∈ S, degreeOf v f = N := ⟨_, rfl⟩
  induction N using Nat.strong_induction_on generalizing f with
  | _ N IH =>
  by_cases hS : ∀ v ∈ S, degreeOf v f = 0
  · refine ih f (fun v hv => ?_) hf
    rcases (Nat.succ_le_of_lt hv).eq_or_lt with h | h
    · exact hS v (Finset.mem_filter.2 ⟨Finset.mem_univ _, h.symm⟩)
    · exact hdeg v h
  push Not at hS
  obtain ⟨z, hzS, hz⟩ := hS
  obtain ⟨z', f', hdeg', hlt, hE⟩ := exists_reduction_step P hT t₀
    (fun v hv => (Finset.mem_filter.1 hv).2) hdeg hzS hz
  have hev : subtreeEval K hmn P T f' = 0 := by
    have := RingHom.mem_ker.1 (exchangeIdeal_le_ker hP T hE)
    rwa [map_sub, map_mul, hf, mul_zero, zero_sub, neg_eq_zero] at this
  obtain ⟨a', ha', hM'⟩ := IH _ (hlt.trans_eq hN) f' hdeg' hev rfl
  refine ⟨a' + Finsupp.single (Sum.inr z') 1, fun v hv => ?_, ?_⟩
  · rcases Finset.mem_union.1 (Finsupp.support_add hv) with hv | hv
    · exact ha' v hv
    · rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hv)]
      rfl
  · rw [show monomial (a' + Finsupp.single (Sum.inr z') 1) (1 : K) =
        monomial a' 1 * X (Sum.inr z') by rw [X, monomial_mul, mul_one], mul_assoc,
      ← sub_add_cancel (X (Sum.inr z') * f) f', mul_add]
    exact add_mem (Ideal.mul_mem_left _ _ hE) hM'

/-- **Polynomials vanishing on the cluster variables reduce into the exchange ideal**: if
`ev_T(f) = 0` then `M f ∈ I_T` for a monomial `M` in the mutable formal variables. -/
@[cluster_algebras "lem_exchange_ideal_reduction"]
theorem exists_monomial_mul_mem_exchangeIdeal (hP : IsSeedPattern K hmn P)
    {T : Finset (RegularTree n)} (hT : IsFiniteSubtree T) {f : MvPolynomial (FormalVar m T) K}
    (hf : subtreeEval K hmn P T f = 0) :
    ∃ a : FormalVar m T →₀ ℕ, (∀ v ∈ a.support, v.isRight) ∧
      monomial a 1 * f ∈ exchangeIdeal K P T := by
  obtain ⟨t₀⟩ := SimpleGraph.Connected.nonempty hT
  haveI : Fintype (FormalVar m T) := Fintype.ofFinite _
  suffices key : ∀ δ : ℕ, ∀ f : MvPolynomial (FormalVar m T) K,
      (∀ v, δ < formalVarDepth T t₀ v → degreeOf v f = 0) → subtreeEval K hmn P T f = 0 →
        ∃ a : FormalVar m T →₀ ℕ, (∀ v ∈ a.support, v.isRight) ∧
          monomial a 1 * f ∈ exchangeIdeal K P T from
    key (Finset.univ.sup (formalVarDepth T t₀)) f
      (fun v hv => absurd (Finset.le_sup (Finset.mem_univ v)) (not_le.2 hv)) hf
  intro δ
  induction δ with
  | zero =>
    intro f hdeg hf
    rw [eq_zero_of_subtreeEval_eq_zero hP hT t₀ (fun v hv => Nat.eq_zero_of_not_pos fun h =>
      mem_vars_iff_degreeOf_ne_zero.1 hv (hdeg v h)) hf]
    exact ⟨0, by simp, by simp⟩
  | succ δ ih => exact exists_monomial_mul_mem_exchangeIdeal_succ hP hT t₀ ih

end Reduction

section Radical

omit [Field F] [Algebra K F] in
/-- Every mutable formal variable divides `M_T`. -/
theorem X_inr_dvd_mutableVarProd (T : Finset (RegularTree n))
    (v : Σ i : Fin n, (subtreeForest T i).ConnectedComponent) :
    (X (.inr v) : MvPolynomial (FormalVar m T) K) ∣ mutableVarProd K m T :=
  Finset.dvd_prod_of_mem _ (@Finset.mem_univ _ (Fintype.ofFinite _) v)

omit [Field F] [Algebra K F] in
/-- A monomial in the mutable formal variables divides a power of `M_T`. -/
theorem monomial_dvd_mutableVarProd_pow {T : Finset (RegularTree n)}
    {a : FormalVar m T →₀ ℕ} (ha : ∀ v ∈ a.support, v.isRight) :
    monomial a (1 : K) ∣ mutableVarProd K m T ^ (∑ v ∈ a.support, a v) := by
  rw [monomial_eq, C_1, one_mul, Finsupp.prod, ← Finset.prod_pow_eq_pow_sum]
  refine Finset.prod_dvd_prod_of_dvd _ _ fun v hv => pow_dvd_pow_of_dvd ?_ _
  rcases v with r | v₀
  · exact absurd (ha _ hv) (by simp)
  · exact X_inr_dvd_mutableVarProd T v₀

variable {hmn : n ≤ m} {P : RegularTree n → SeedData F m n}

/-- The product `M_T` of the mutable formal variables does not vanish under `ev_T`. -/
theorem subtreeEval_mutableVarProd_ne_zero (hP : IsSeedPattern K hmn P)
    (T : Finset (RegularTree n)) : subtreeEval K hmn P T (mutableVarProd K m T) ≠ 0 := by
  rw [mutableVarProd, map_prod]
  exact Finset.prod_ne_zero_iff.2 fun v _ => by
    simpa [subtreeEval] using (hP.1 _).1.1.ne_zero _

/-- **Relations among cluster variables form the saturated exchange ideal**: `ev_T(f) = 0` if and
only if `f ∈ J_T`. -/
@[cluster_algebras "thm_cluster_radical"]
theorem subtreeEval_eq_zero_iff (hP : IsSeedPattern K hmn P) {T : Finset (RegularTree n)}
    (hT : IsFiniteSubtree T) (f : MvPolynomial (FormalVar m T) K) :
    subtreeEval K hmn P T f = 0 ↔ f ∈ saturatedExchangeIdeal K P T := by
  refine ⟨fun hf => ?_, fun hf => ?_⟩
  · obtain ⟨a, ha, hmem⟩ := exists_monomial_mul_mem_exchangeIdeal hP hT hf
    obtain ⟨c, hc⟩ := monomial_dvd_mutableVarProd_pow (K := K) ha
    refine mem_saturatedExchangeIdeal.2 ⟨∑ v ∈ a.support, a v, ?_⟩
    rw [hc, mul_right_comm]
    exact Ideal.mul_mem_right _ _ hmem
  · obtain ⟨e, he⟩ := mem_saturatedExchangeIdeal.1 hf
    have h := RingHom.mem_ker.1 (exchangeIdeal_le_ker hP T he)
    rw [map_mul, map_pow] at h
    exact (mul_eq_zero.1 h).resolve_left (pow_ne_zero _ (subtreeEval_mutableVarProd_ne_zero hP T))

/-- The kernel of `ev_T` is the saturated exchange ideal `J_T`. -/
theorem ker_subtreeEval (hP : IsSeedPattern K hmn P) {T : Finset (RegularTree n)}
    (hT : IsFiniteSubtree T) : RingHom.ker (subtreeEval K hmn P T) = saturatedExchangeIdeal K P T :=
  Ideal.ext fun f => RingHom.mem_ker.trans (subtreeEval_eq_zero_iff hP hT f)

/-- **The subalgebra of a subtree as a quotient**: `ev_T` induces a `K`-algebra isomorphism
`K[z_T]/J_T ≃ 𝒜_T`. -/
@[cluster_algebras "prop_cluster_radical_iso"]
noncomputable def subtreeQuotientEquiv (hP : IsSeedPattern K hmn P) {T : Finset (RegularTree n)}
    (hT : IsFiniteSubtree T) :
    (MvPolynomial (FormalVar m T) K ⧸ saturatedExchangeIdeal K P T) ≃ₐ[K] subtreeAlgebra K P T :=
  (Ideal.quotientEquivAlgOfEq K (ker_subtreeEval hP hT).symm).trans
    ((Ideal.quotientKerEquivRange (subtreeEval K hmn P T)).trans
      (Subalgebra.equivOfEq _ _ (range_subtreeEval hP hT.nonempty)))

/-- The isomorphism `K[z_T]/J_T ≃ 𝒜_T` is induced by `ev_T`. -/
@[cluster_algebras "prop_cluster_radical_iso"]
theorem subtreeQuotientEquiv_mk (hP : IsSeedPattern K hmn P) {T : Finset (RegularTree n)}
    (hT : IsFiniteSubtree T) (f : MvPolynomial (FormalVar m T) K) :
    (subtreeQuotientEquiv hP hT (Ideal.Quotient.mk _ f) : F) = subtreeEval K hmn P T f :=
  rfl

end Radical

end ClusterAlgebras
