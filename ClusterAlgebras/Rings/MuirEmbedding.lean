/-!
# The Muir embedding

Let `z` be the generic `a × b` matrix over `ℂ` and `z'` the generic `(a - 1) × (b - 1)` matrix,
with `2 ≤ a ≤ b`. The Muir embedding is the injective `ℂ`-algebra homomorphism
`μ : R_{a-1,b-1} → R_{a,b}` of Plücker rings with `μ(P_I(z')) = P_{I ∪ {b}}(z)` for every
`(a - 1)`-element set `I ⊆ [1, b - 1]` of columns.

The Schur complement `S = z/({a}, {b})` of the corner entry `z_{ab}` is an `(a - 1) × (b - 1)`
matrix over the fraction field of `ℂ[z]`, and the formula for minors through a Schur complement
gives `P_{I ∪ {b}}(z) = z_{ab} P_I(S)`. Let `λ` be an `(a - 1)`-st root of `z_{ab}` in an
algebraic closure of `ℂ(z)`, and `ψ : ℂ[z'] → \overline{ℂ(z)}` the `ℂ`-algebra homomorphism with
`ψ(z'_{ij}) = λ S_{ij}`. Then `ψ(P_I(z')) = λ^{a-1} P_I(S) = P_{I ∪ {b}}(z)`. By the First
Fundamental Theorem the `P_I(z')` generate `R_{a-1,b-1}`, so `ψ` maps `R_{a-1,b-1}` into the
image of the subalgebra of `ℂ[z]` generated by the `P_{I ∪ {b}}(z)`, which lies in `R_{a,b}`; this
defines `μ`. For injectivity, the specialization `ϑ : ℂ[z] → ℂ[z']` keeping `z'` in the top left
corner, sending `z_{ab}` to `1` and the other entries of row `a` and column `b` to `0`, satisfies
`ϑ(P_{I ∪ {b}}(z)) = P_I(z')`, so `ϑ ∘ μ` is the inclusion of `R_{a-1,b-1}` into `ℂ[z']`.

Being an injective homomorphism of domains, `μ` extends to the fraction field: there is a
`ℂ`-algebra homomorphism `ι` from the subfield of `ℂ(z')` generated by the `P_I(z')` to `ℂ(z)`
with `ι(P_I(z')) = P_{I ∪ {b}}(z)`.

## Main definitions

* `ClusterAlgebras.muirSubst k m`: the homomorphism `ψ : ℂ[z'] → \overline{ℂ(z)}`, for `z'` the
  generic `k × m` and `z` the generic `(k + 1) × (m + 1)` matrix.
* `ClusterAlgebras.muirEmbedding k m`: the Muir embedding `R_{k,m} → R_{k+1,m+1}`.
* `ClusterAlgebras.muirSpecialization k m`: the specialization `ϑ : ℂ[z] → ℂ[z']`.

## Main results

* `ClusterAlgebras.pluckerCoord_map_castSucc_union_last`: `P_{I ∪ {b}}(x) = x_{ab} P_I(S)` for a
  matrix `x` over a field with `x_{ab} ≠ 0` and `S` the Schur complement of `x_{ab}`.
* `ClusterAlgebras.muirEmbedding_pluckerCoord`, `ClusterAlgebras.muirEmbedding_injective`: the
  values and the injectivity of the Muir embedding.
* `ClusterAlgebras.exists_pluckerRing_algHom_injective`: the Muir embedding
  `R_{a-1,b-1} → R_{a,b}` for `2 ≤ a ≤ b`.
* `ClusterAlgebras.exists_algHom_adjoin_pluckerCoord`: its extension `ι` to the subfield of
  `ℂ(z')` generated by the Plücker coordinates.

## Implementation notes

* Existence of `μ` can be proved by a homogeneity argument: a polynomial relation `G` among the
  `P_I(z')` may be taken homogeneous of some degree `e`, and then
  `G((P_{I ∪ {b}}(z))_I) = z_{ab}^e ψ₀(G((P_I(z'))_I)) = 0`, with `ψ₀(z'_{ij}) = S_{ij}`. Scaling
  `ψ₀` by an `(a - 1)`-st root `λ` of `z_{ab}` removes the factor `z_{ab}` altogether, since a
  maximal minor of `λ S` is `λ^{a-1} = z_{ab}` times that of `S`; so `ψ` itself carries `P_I(z')`
  to `P_{I ∪ {b}}(z)` and no homogeneity argument is needed. The root lives in the algebraic
  closure of `ℂ(z)`, into which `ℂ[z]` embeds.
* The construction is made for `z'` of size `k × m` and `z` of size `(k + 1) × (m + 1)`, where the
  last row and column are `Fin.last`; the sizes `a - 1`, `b - 1` are recovered in
  `exists_pluckerRing_algHom_injective`, the columns `[1, b - 1]` being read in `[1, b]` through
  `Fin.castLEEmb` and the column `b` being `⟨b - 1, _⟩`.
* The values `μ(P_I(z')) = P_{I ∪ {b}}(z)` hold for every set `I` of columns, not only those with
  `a - 1` elements: otherwise both sides are the junk value `0` of `minor`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset MvPolynomial

/-! ### Plücker coordinates through the Schur complement of a corner entry -/

/-- The shuffle count `ν(A, R)` vanishes when every element of `A` is below every element
of `R`. -/
theorem shuffleCount_eq_zero_of_forall_lt {ι : Type*} [LinearOrder ι] {A R : Finset ι}
    (h : ∀ a ∈ A, ∀ r ∈ R, a < r) : shuffleCount A R = 0 := by
  rw [shuffleCount, card_eq_zero, filter_eq_empty_iff]
  rintro ⟨a, r⟩ hp
  rw [mem_product] at hp
  exact (h a hp.1 r hp.2).not_gt

/-- The Schur complement of a single entry `x_{rc}` agrees with `x` on every row `i` with
`x_{ic} = 0`. -/
theorem schurComplement_singleton_apply_of_eq_zero {K : Type*} [Field K] {ι κ : Type*}
    [LinearOrder ι] [LinearOrder κ] (x : Matrix ι κ K) (r : ι) (c : κ) {i : ι} (hi : x i c = 0)
    (j : κ) : schurComplement x {r} {c} i j = x i j := by
  rw [schurComplement, dif_pos (by simp), sub_eq_self]
  refine sum_eq_zero fun s _ => sum_eq_zero fun t _ => ?_
  rw [mem_singleton.1 (orderEmbOfFin_mem _ _ t), hi, zero_mul, zero_mul]

/-- **Plücker coordinates through the Schur complement of the corner entry.** For a
`(k + 1) × (m + 1)` matrix `x` over a field with `x_{ab} ≠ 0` at the last row `a` and the last
column `b`, and any set `I` of the first `m` columns,
`P_{I ∪ {b}}(x) = x_{ab} P_I(S)`, where `S` is the Schur complement `x/({a}, {b})` restricted to
the first `k` rows and `m` columns. -/
theorem pluckerCoord_map_castSucc_union_last {K : Type*} [Field K] {k m : ℕ}
    (x : Matrix (Fin (k + 1)) (Fin (m + 1)) K) (hx : x (Fin.last k) (Fin.last m) ≠ 0)
    (I : Finset (Fin m)) :
    pluckerCoord x (I.map Fin.castSuccEmb ∪ {Fin.last m}) =
      x (Fin.last k) (Fin.last m) *
        pluckerCoord ((schurComplement x {Fin.last k} {Fin.last m}).submatrix
          Fin.castSucc Fin.castSucc) I := by
  by_cases hI : I.card = k
  · have hA : Disjoint ((univ : Finset (Fin k)).map Fin.castSuccEmb) {Fin.last k} := by
      simp [Fin.castSucc_ne_last]
    have hB : Disjoint (I.map Fin.castSuccEmb) {Fin.last m} := by
      simp [Fin.castSucc_ne_last]
    have huniv : (univ : Finset (Fin (k + 1))) =
        (univ : Finset (Fin k)).map Fin.castSuccEmb ∪ {Fin.last k} := by
      rw [Fin.univ_castSuccEmb, cons_eq_insert, union_comm, ← insert_eq]
    rw [pluckerCoord, huniv, minor_union_eq_schurComplement x (by simp)
      (by rwa [minor_singleton]) hA hB (by simpa using hI), minor_singleton,
      shuffleCount_eq_zero_of_forall_lt (by simp [Fin.castSucc_lt_last]),
      shuffleCount_eq_zero_of_forall_lt (by simp [Fin.castSucc_lt_last]), pluckerCoord, pow_zero,
      one_mul]
    erw [minor_submatrix_orderEmbedding _ Fin.castSuccOrderEmb Fin.castSuccOrderEmb]
    rfl
  · have h1 : (I.map Fin.castSuccEmb ∪ {Fin.last m}).card ≠
        (univ : Finset (Fin (k + 1))).card := by
      rw [card_union_of_disjoint (by simp [Fin.castSucc_ne_last])]
      simpa using hI
    have h2 : I.card ≠ (univ : Finset (Fin k)).card := by simpa using hI
    rw [pluckerCoord, pluckerCoord, minor, minor, dif_neg h1, dif_neg h2, mul_zero]

/-- Scaling a `k × m` matrix by `c` multiplies its Plücker coordinates by `c ^ k`. -/
theorem pluckerCoord_const_mul {R : Type*} [CommRing R] {κ : Type*} [LinearOrder κ] {k : ℕ}
    (c : R) (M : Matrix (Fin k) κ R) (I : Finset κ) :
    pluckerCoord (Matrix.of fun i j => c * M i j) I = c ^ k * pluckerCoord M I := by
  have := minor_of_mul_mul (fun _ => c) (fun _ => (1 : R)) M univ I
  simp only [mul_one, prod_const, card_univ, Fintype.card_fin, one_pow] at this
  exact this

/-! ### The homomorphism `ψ` -/

section Subst

variable (k m : ℕ)

/-- The algebraic closure of `ℂ(z)`, for `z` the generic `(k + 1) × (m + 1)` matrix. -/
abbrev MuirField : Type :=
  AlgebraicClosure (FractionRing (ComplexPoly (k + 1) (m + 1)))

/-- `ℂ[z]` embeds into the algebraic closure of its fraction field. -/
theorem algebraMap_muirField_injective :
    Function.Injective (algebraMap (ComplexPoly (k + 1) (m + 1)) (MuirField k m)) := by
  rw [IsScalarTower.algebraMap_eq _ (FractionRing (ComplexPoly (k + 1) (m + 1))) _]
  exact (algebraMap (FractionRing (ComplexPoly (k + 1) (m + 1))) (MuirField k m)).injective.comp
    (IsFractionRing.injective _ _)

/-- The generic `(k + 1) × (m + 1)` matrix `z`, with entries read in the algebraic closure of
`ℂ(z)`. -/
noncomputable def muirMatrix : Matrix (Fin (k + 1)) (Fin (m + 1)) (MuirField k m) :=
  (complexGenericMatrix (k + 1) (m + 1)).map (algebraMap _ _)

/-- The corner entry `z_{ab}` is nonzero. -/
theorem muirMatrix_last_ne_zero : muirMatrix k m (Fin.last k) (Fin.last m) ≠ 0 := by
  rw [muirMatrix, Matrix.map_apply, complexGenericMatrix_apply, ne_eq,
    map_eq_zero_iff _ (algebraMap_muirField_injective k m)]
  exact X_ne_zero _

/-- A `k`-th root of the corner entry `z_{ab}` in the algebraic closure of `ℂ(z)`. -/
noncomputable def muirRoot (hk : 0 < k) : MuirField k m :=
  Classical.choose (IsAlgClosed.exists_pow_nat_eq (muirMatrix k m (Fin.last k) (Fin.last m)) hk)

/-- `λ^k = z_{ab}`. -/
@[simp]
theorem muirRoot_pow (hk : 0 < k) :
    muirRoot k m hk ^ k = muirMatrix k m (Fin.last k) (Fin.last m) :=
  Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq _ hk)

/-- The homomorphism `ψ : ℂ[z'] → \overline{ℂ(z)}`, `z'` the generic `k × m` matrix, with
`ψ(z'_{ij}) = λ S_{ij}`, where `S` is the Schur complement of the corner entry `z_{ab}` of the
generic `(k + 1) × (m + 1)` matrix `z` and `λ` is a `k`-th root of `z_{ab}`. -/
noncomputable def muirSubst (hk : 0 < k) : ComplexPoly k m →ₐ[ℂ] MuirField k m :=
  aeval fun ij => muirRoot k m hk *
    schurComplement (muirMatrix k m) {Fin.last k} {Fin.last m} ij.1.castSucc ij.2.castSucc

variable {k m}

/-- `ψ(P_I(z')) = P_{I ∪ {b}}(z)`. -/
theorem muirSubst_pluckerCoord (hk : 0 < k) (I : Finset (Fin m)) :
    muirSubst k m hk (pluckerCoord (complexGenericMatrix k m) I) =
      algebraMap _ _
        (pluckerCoord (complexGenericMatrix (k + 1) (m + 1)) (I.map Fin.castSuccEmb ∪
          {Fin.last m})) := by
  have h1 := RingHom.map_pluckerCoord (muirSubst k m hk).toRingHom (complexGenericMatrix k m) I
  have h2 := RingHom.map_pluckerCoord (algebraMap (ComplexPoly (k + 1) (m + 1)) (MuirField k m))
    (complexGenericMatrix (k + 1) (m + 1)) (I.map Fin.castSuccEmb ∪ {Fin.last m})
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1
  rw [h1, h2, ← muirMatrix, pluckerCoord_map_castSucc_union_last _ (muirMatrix_last_ne_zero k m),
    ← muirRoot_pow k m hk, ← pluckerCoord_const_mul]
  congr 1
  ext i j
  simp [muirSubst]

end Subst

/-! ### The Muir embedding -/

section Embedding

variable {k m : ℕ}

/-- `ψ` maps the Plücker ring `R_{k,m}` into the image of `R_{k+1,m+1}`: by the First
Fundamental Theorem `R_{k,m}` is generated by the `P_I(z')`, and `ψ(P_I(z')) = P_{I ∪ {b}}(z)`. -/
theorem muirSubst_mem_map (hk : 1 ≤ k) (hkm : k ≤ m) {x : ComplexPoly k m}
    (hx : x ∈ pluckerRing k m) :
    muirSubst k m hk x ∈ (pluckerRing (k + 1) (m + 1)).map
      (IsScalarTower.toAlgHom ℂ (ComplexPoly (k + 1) (m + 1)) (MuirField k m)) := by
  rw [pluckerRing_eq_adjoin_pluckerCoord k m hk hkm] at hx
  refine (Algebra.adjoin_le (S := ((pluckerRing (k + 1) (m + 1)).map
    (IsScalarTower.toAlgHom ℂ (ComplexPoly (k + 1) (m + 1)) (MuirField k m))).comap
      (muirSubst k m hk)) ?_) hx
  rintro _ ⟨J, -, rfl⟩
  exact ⟨_, pluckerCoord_mem_pluckerRing _, (muirSubst_pluckerCoord hk J).symm⟩

variable (k m) in
/-- The **Muir embedding** `μ : R_{k,m} → R_{k+1,m+1}` of Plücker rings, with
`μ(P_I(z')) = P_{I ∪ {b}}(z)` (`muirEmbedding_pluckerCoord`): the restriction of `ψ` to
`R_{k,m}`, read back in `ℂ[z]`. -/
noncomputable def muirEmbedding (hk : 1 ≤ k) (hkm : k ≤ m) :
    pluckerRing k m →ₐ[ℂ] pluckerRing (k + 1) (m + 1) :=
  (Subalgebra.equivMapOfInjective (pluckerRing (k + 1) (m + 1))
      (IsScalarTower.toAlgHom ℂ (ComplexPoly (k + 1) (m + 1)) (MuirField k m))
      (algebraMap_muirField_injective k m)).symm.toAlgHom.comp
    (((muirSubst k m hk).comp (pluckerRing k m).val).codRestrict _
      fun x => muirSubst_mem_map hk hkm x.2)

/-- `μ` is `ψ` followed by reading back in `ℂ[z]`. -/
theorem algebraMap_muirEmbedding (hk : 1 ≤ k) (hkm : k ≤ m) (x : pluckerRing k m) :
    algebraMap (ComplexPoly (k + 1) (m + 1)) (MuirField k m) (muirEmbedding k m hk hkm x) =
      muirSubst k m hk x :=
  congrArg Subtype.val ((Subalgebra.equivMapOfInjective (pluckerRing (k + 1) (m + 1))
    (IsScalarTower.toAlgHom ℂ (ComplexPoly (k + 1) (m + 1)) (MuirField k m))
    (algebraMap_muirField_injective k m)).apply_symm_apply
      ((((muirSubst k m hk).comp (pluckerRing k m).val).codRestrict _
        fun x => muirSubst_mem_map hk hkm x.2) x))

/-- **The values of the Muir embedding**: `μ(P_I(z')) = P_{I ∪ {b}}(z)`, the columns of `z'`
being the first `m` columns of `z` and `b` the last one. -/
theorem muirEmbedding_pluckerCoord (hk : 1 ≤ k) (hkm : k ≤ m) (I : Finset (Fin m)) :
    (muirEmbedding k m hk hkm ⟨_, pluckerCoord_mem_pluckerRing I⟩ :
      ComplexPoly (k + 1) (m + 1)) =
      pluckerCoord (complexGenericMatrix (k + 1) (m + 1)) (I.map Fin.castSuccEmb ∪
        {Fin.last m}) :=
  algebraMap_muirField_injective k m <|
    (algebraMap_muirEmbedding hk hkm _).trans (muirSubst_pluckerCoord hk I)

variable (k m) in
/-- The specialization `ϑ : ℂ[z] → ℂ[z']`, `z` the generic `(k + 1) × (m + 1)` and `z'` the
generic `k × m` matrix: `ϑ(z_{ij}) = z'_{ij}` for `i ≤ k`, `j ≤ m`, `ϑ(z_{ab}) = 1` at the last
row `a` and column `b`, and `ϑ` sends the other entries of row `a` and column `b` to `0`. -/
noncomputable def muirSpecialization : ComplexPoly (k + 1) (m + 1) →ₐ[ℂ] ComplexPoly k m :=
  aeval fun ij => Fin.lastCases (Fin.lastCases 1 (fun _ => 0) ij.2)
    (fun i => Fin.lastCases 0 (fun j => X (i, j)) ij.2) ij.1

/-- `ϑ(P_{I ∪ {b}}(z)) = P_I(z')`: the submatrix of `ϑ(z)` on the columns `I ∪ {b}` is block
diagonal with blocks `z'_{[1,k],I}` and `(1)`. -/
theorem muirSpecialization_pluckerCoord (I : Finset (Fin m)) :
    muirSpecialization k m (pluckerCoord (complexGenericMatrix (k + 1) (m + 1))
      (I.map Fin.castSuccEmb ∪ {Fin.last m})) = pluckerCoord (complexGenericMatrix k m) I := by
  let φ := (algebraMap (ComplexPoly k m) (FractionRing (ComplexPoly k m))).comp
    (muirSpecialization k m).toRingHom
  have hlast : (complexGenericMatrix (k + 1) (m + 1)).map φ (Fin.last k) (Fin.last m) = 1 := by
    simp [φ, muirSpecialization]
  apply IsFractionRing.injective (ComplexPoly k m) (FractionRing (ComplexPoly k m))
  have h1 := RingHom.map_pluckerCoord φ (complexGenericMatrix (k + 1) (m + 1))
    (I.map Fin.castSuccEmb ∪ {Fin.last m})
  change φ _ = _
  rw [h1, pluckerCoord_map_castSucc_union_last _ (by rw [hlast]; exact one_ne_zero), hlast,
    one_mul, RingHom.map_pluckerCoord]
  congr 1
  ext i j
  rw [Matrix.submatrix_apply, schurComplement_singleton_apply_of_eq_zero _ _ _
    (by simp [φ, muirSpecialization])]
  simp [φ, muirSpecialization]

/-- **`ϑ ∘ μ` is the inclusion** of `R_{k,m}` into `ℂ[z']`: both are `ℂ`-algebra homomorphisms
agreeing on the Plücker coordinates `P_I(z')`, which generate `R_{k,m}`. -/
theorem muirSpecialization_muirEmbedding (hk : 1 ≤ k) (hkm : k ≤ m) (x : pluckerRing k m) :
    muirSpecialization k m (muirEmbedding k m hk hkm x) = x := by
  have hP := pluckerRing_eq_adjoin_pluckerCoord k m hk hkm
  have key : ∀ y (hy : y ∈ Algebra.adjoin ℂ {f | ∃ J : Finset (Fin m), J.card = k ∧
      pluckerCoord (complexGenericMatrix k m) J = f}),
      muirSpecialization k m (muirEmbedding k m hk hkm ⟨y, hP ▸ hy⟩) = y := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨J, -, rfl⟩ := hy
      rw [muirEmbedding_pluckerCoord, muirSpecialization_pluckerCoord]
    | algebraMap r =>
      have := (muirEmbedding k m hk hkm).commutes r
      rw [Subtype.ext_iff] at this
      erw [this]
      exact (muirSpecialization k m).commutes r
    | add y y' hy hy' ih ih' =>
      have := map_add (muirEmbedding k m hk hkm) ⟨y, hP ▸ hy⟩ ⟨y', hP ▸ hy'⟩
      erw [this]
      rw [Subalgebra.coe_add, map_add, ih, ih']
    | mul y y' hy hy' ih ih' =>
      have := map_mul (muirEmbedding k m hk hkm) ⟨y, hP ▸ hy⟩ ⟨y', hP ▸ hy'⟩
      erw [this]
      rw [Subalgebra.coe_mul, map_mul, ih, ih']
  obtain ⟨x, hx⟩ := x
  exact key x (hP ▸ hx)

/-- **The Muir embedding is injective**: `ϑ ∘ μ` is the inclusion. -/
theorem muirEmbedding_injective (hk : 1 ≤ k) (hkm : k ≤ m) :
    Function.Injective (muirEmbedding k m hk hkm) := fun x y h => Subtype.ext <| by
  rw [← muirSpecialization_muirEmbedding hk hkm x, h, muirSpecialization_muirEmbedding]

end Embedding

/-! ### Indexing by `a × b`, and the extension to fraction fields -/

/-- **The Muir embedding.** Let `2 ≤ a ≤ b`, `z` the generic `a × b` and `z'` the generic
`(a - 1) × (b - 1)` matrix over `ℂ`. There is an injective `ℂ`-algebra homomorphism
`μ : R_{a-1,b-1} → R_{a,b}` with `μ(P_I(z')) = P_{I ∪ {b}}(z)` for every set `I ⊆ [1, b - 1]` of
columns; the columns of `z'` are read in `[1, b]` through `Fin.castLEEmb`, and `b` is the last
column `⟨b - 1, _⟩`.

For a set `I` that does not have `a - 1` elements both sides are `0`. -/
@[cluster_algebras "lem_muir_embedding"]
theorem exists_pluckerRing_algHom_injective {a b : ℕ} (ha : 2 ≤ a) (hab : a ≤ b) :
    ∃ μ : pluckerRing (a - 1) (b - 1) →ₐ[ℂ] pluckerRing a b, Function.Injective μ ∧
      ∀ I : Finset (Fin (b - 1)),
        (μ ⟨_, pluckerCoord_mem_pluckerRing I⟩ : ComplexPoly a b) =
          pluckerCoord (complexGenericMatrix a b)
            (I.map (Fin.castLEEmb (Nat.sub_le b 1)) ∪ {⟨b - 1, by omega⟩}) := by
  obtain ⟨k, rfl⟩ : ∃ k, a = k + 1 := ⟨a - 1, by omega⟩
  obtain ⟨m, rfl⟩ : ∃ m, b = m + 1 := ⟨b - 1, by omega⟩
  exact ⟨muirEmbedding k m (by omega) (by omega), muirEmbedding_injective _ _,
    muirEmbedding_pluckerCoord _ _⟩

open scoped IntermediateField.algebraAdjoinAdjoin in
/-- **The Muir embedding on fraction fields.** Let `2 ≤ a ≤ b`. There is a `ℂ`-algebra
homomorphism `ι` from the subfield of `ℂ(z')` generated by the Plücker coordinates `P_I(z')`,
`|I| = a - 1`, to `ℂ(z)` with `ι(P_I(z')) = P_{I ∪ {b}}(z)`: the subfield is the fraction field
of the subalgebra the `P_I(z')` generate, which is `R_{a-1,b-1}`, and the injective `μ` extends
to it. -/
theorem exists_algHom_adjoin_pluckerCoord {a b : ℕ} (ha : 2 ≤ a) (hab : a ≤ b) :
    ∃ ι : IntermediateField.adjoin ℂ {y : FractionRing (ComplexPoly (a - 1) (b - 1)) |
        ∃ I : Finset (Fin (b - 1)), I.card = a - 1 ∧
          algebraMap _ _ (pluckerCoord (complexGenericMatrix (a - 1) (b - 1)) I) = y} →ₐ[ℂ]
        FractionRing (ComplexPoly a b),
      ∀ (I : Finset (Fin (b - 1))) (hI : I.card = a - 1),
        ι ⟨_, IntermediateField.subset_adjoin ℂ _ ⟨I, hI, rfl⟩⟩ =
          algebraMap _ _ (pluckerCoord (complexGenericMatrix a b)
            (I.map (Fin.castLEEmb (Nat.sub_le b 1)) ∪ {⟨b - 1, by omega⟩})) := by
  obtain ⟨k, rfl⟩ : ∃ k, a = k + 1 := ⟨a - 1, by omega⟩
  obtain ⟨m, rfl⟩ : ∃ m, b = m + 1 := ⟨b - 1, by omega⟩
  have hk : 1 ≤ k := by omega
  have hkm : k ≤ m := by omega
  let S : Set (FractionRing (ComplexPoly k m)) := {y | ∃ I : Finset (Fin m), I.card = k ∧
    algebraMap _ _ (pluckerCoord (complexGenericMatrix k m) I) = y}
  change ∃ ι : IntermediateField.adjoin ℂ S →ₐ[ℂ] FractionRing (ComplexPoly (k + 1) (m + 1)),
    ∀ (I : Finset (Fin m)) (hI : I.card = k),
      ι ⟨_, IntermediateField.subset_adjoin ℂ _ ⟨I, hI, rfl⟩⟩ =
        algebraMap _ _ (pluckerCoord (complexGenericMatrix (k + 1) (m + 1))
          (I.map Fin.castSuccEmb ∪ {Fin.last m}))
  let j := IsScalarTower.toAlgHom ℂ (ComplexPoly k m) (FractionRing (ComplexPoly k m))
  have hj : Function.Injective j := IsFractionRing.injective _ _
  have hA : Algebra.adjoin ℂ S = (pluckerRing k m).map j := by
    rw [pluckerRing_eq_adjoin_pluckerCoord k m hk hkm, ← Algebra.adjoin_image]
    congr 1
    ext y
    simp [S, j]
  let e : pluckerRing k m ≃ₐ[ℂ] Algebra.adjoin ℂ S :=
    (Subalgebra.equivMapOfInjective _ j hj).trans (Subalgebra.equivOfEq _ _ hA.symm)
  let g : Algebra.adjoin ℂ S →ₐ[ℂ] FractionRing (ComplexPoly (k + 1) (m + 1)) :=
    (IsScalarTower.toAlgHom ℂ (ComplexPoly (k + 1) (m + 1)) _).comp
      ((pluckerRing (k + 1) (m + 1)).val.comp
        ((muirEmbedding k m hk hkm).comp e.symm.toAlgHom))
  have hg : Function.Injective g := (IsFractionRing.injective _ _).comp
    (Subtype.val_injective.comp ((muirEmbedding_injective hk hkm).comp e.symm.injective))
  refine ⟨IsFractionRing.liftAlgHom (K := IntermediateField.adjoin ℂ S) hg, fun I hI => ?_⟩
  have he : e.symm ⟨_, Algebra.subset_adjoin ⟨I, hI, rfl⟩⟩ =
      ⟨_, pluckerCoord_mem_pluckerRing I⟩ := by
    rw [AlgEquiv.symm_apply_eq]
    rfl
  have h1 : (⟨_, IntermediateField.subset_adjoin ℂ _ ⟨I, hI, rfl⟩⟩ :
      IntermediateField.adjoin ℂ S) = algebraMap (Algebra.adjoin ℂ S) _
        ⟨_, Algebra.subset_adjoin ⟨I, hI, rfl⟩⟩ := rfl
  rw [h1, IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
  change algebraMap _ _
    ((muirEmbedding k m hk hkm (e.symm _) : ComplexPoly (k + 1) (m + 1))) = _
  rw [he, muirEmbedding_pluckerCoord]

end ClusterAlgebras
