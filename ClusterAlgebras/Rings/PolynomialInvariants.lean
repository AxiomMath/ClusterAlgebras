module

public import ClusterAlgebras.Rings.Elementary
public import ClusterAlgebras.Rings.InvariantUFD
public import Mathlib.Algebra.CharZero.Infinite
public import Mathlib.RingTheory.Polynomial.UniqueFactorization

/-!
# Polynomial invariants of sets generated by elementary matrices

Let `z` be the generic `p × q` complex matrix, let `P` be a set of pairs `(i, j)` of indices,
and let `G` be a set of complex `p × p` matrices containing every elementary matrix
`E_{ij}(s)`, `(i, j) ∈ P`, `s ∈ ℂ`, each of whose elements is a finite product of such matrices.
Evaluating the one-parameter substitution `Θ_{ij}(f) ∈ ℂ[z][t]` at `t = s` gives
`σ_{E_{ij}(s)}(f)`, and a polynomial in `t` over the domain `ℂ[z]` vanishing at infinitely many
points is zero; so the invariants `ℂ[z]^G` are exactly the polynomials fixed by every `Θ_{ij}`,
`(i, j) ∈ P`. As the `Θ_{ij}` are the identity at `t = 0` and `ℂ[z]` is factorial, `ℂ[z]^G` is
factorial. This applies to the Plücker ring `R_{a,b} = ℂ[z]^{SL_a(ℂ)}`, with `P` all pairs of
distinct indices, and to `ℂ[z]^{U_p}`, with `P` the pairs `(i, j)` with `i > j`.

## Main results

* `ClusterAlgebras.leftSubst_mul`: `σ_{gh} = σ_h ∘ σ_g`.
* `ClusterAlgebras.eval_oneParamSubst`: `Θ_{ij}(f)` at `t = s` is `σ_{E_{ij}(s)}(f)`.
* `ClusterAlgebras.invariants_eq_fixedSubalgebra`: `ℂ[z]^G` is the subalgebra of polynomials
  fixed by every `Θ_{ij}`, `(i, j) ∈ P`.
* `ClusterAlgebras.uniqueFactorizationMonoid_invariants`: `ℂ[z]^G` is a unique factorization
  domain.
* `ClusterAlgebras.uniqueFactorizationMonoid_pluckerRing`: the Plücker ring `R_{a,b}` is a
  unique factorization domain.
* `ClusterAlgebras.uniqueFactorizationMonoid_invariants_lowerUnitriangular`: `ℂ[z]^{U_p}` is a
  unique factorization domain.

## Implementation notes

* FWZ assume `p ≥ 2` and that the pairs in `P` consist of distinct indices; neither is
  used, since `Θ_{ii}` at `t = s` is still `σ_{E_{ii}(s)}`, where `E_{ii}(s) = 1 + s e_{ii}`.
* A finite product of elementary matrices is written
  `(l.map fun t => transvection t.1 t.2.1 t.2.2).prod` for a list `l` of triples `(i, j, s)`, as
  in `ClusterAlgebras.det_eq_one_iff_exists_list_transvection`.
* That `ℂ[z]^G` is a subring of `ℂ[z]` containing `ℂ` is its being a `ℂ`-subalgebra, which is
  how it is defined; the content of `uniqueFactorizationMonoid_invariants` and
  `uniqueFactorizationMonoid_pluckerRing` is the factoriality.
* The Plücker ring is factorial for all `a` and `b`, not only for `1 ≤ a ≤ b`: the matrices of
  determinant `1` are the products of elementary matrices `E_{ij}(s)`, `i ≠ j`, for every `a`
  (for `a ≤ 1` there are none, and the identity is the empty product), so FWZ's case
  distinction between `a = 1` and `a ≥ 2` is not needed.
* The two factoriality statements for `R_{a,b}` and `ℂ[z]^{U_p}` are instances.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

open MvPolynomial Matrix

variable {p q : ℕ}

/-! ### Left substitutions and one-parameter substitutions -/

/-- `σ_1` is the identity. -/
@[simp]
theorem leftSubst_one : leftSubst q (1 : Matrix (Fin p) (Fin p) ℂ) = AlgHom.id ℂ _ := by
  refine MvPolynomial.algHom_ext fun ij => ?_
  simp [leftSubst, Matrix.one_apply]

/-- `σ_{gh} = σ_h ∘ σ_g`: left substitution reverses the order of products. -/
theorem leftSubst_mul (g h : Matrix (Fin p) (Fin p) ℂ) :
    leftSubst q (g * h) = (leftSubst q h).comp (leftSubst q g) := by
  refine MvPolynomial.algHom_ext fun ij => ?_
  obtain ⟨i, j⟩ := ij
  simp only [leftSubst_X, AlgHom.comp_apply, map_sum, map_mul, algHom_C, Matrix.mul_apply,
    Finset.mul_sum, Finset.sum_mul, mul_assoc]
  exact Finset.sum_comm

/-- Evaluating the one-parameter substitution `Θ_{ij}(f)` at `t = s` gives the left substitution
`σ_{E_{ij}(s)}(f)` by the elementary matrix `E_{ij}(s) = 1 + s e_{ij}`. -/
theorem eval_oneParamSubst (i j : Fin p) (s : ℂ) (f : ComplexPoly p q) :
    (oneParamSubst q i j f).eval (C s) = leftSubst q (transvection i j s) f := by
  have : ((Polynomial.aeval (C s : ComplexPoly p q)).restrictScalars ℂ).comp
      (oneParamSubst q i j) = leftSubst q (transvection i j s) := by
    refine MvPolynomial.algHom_ext fun al => ?_
    obtain ⟨a, l⟩ := al
    simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, oneParamSubst, aeval_X,
      leftSubst_X]
    by_cases h : a = i
    · subst h
      simp only [if_true, Polynomial.aeval_def, Polynomial.eval₂_add, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_X, Algebra.algebraMap_self, RingHom.id_apply]
      simp [transvection, Matrix.one_apply, Matrix.single_apply, add_mul, Finset.sum_add_distrib,
        apply_ite C, ite_mul, mul_comm (C s)]
    · simp [h, Ne.symm h, transvection, Matrix.one_apply]
  simpa [Polynomial.aeval_def] using congrArg (fun φ => φ f) this

/-- `Θ_{ij}` is the identity at `t = 0`. -/
@[simp]
theorem eval_zero_oneParamSubst (i j : Fin p) (f : ComplexPoly p q) :
    (oneParamSubst q i j f).eval 0 = f := by
  simpa using eval_oneParamSubst i j 0 f

/-- A polynomial fixed by `σ_{E_{ij}(s)}` for every `(i, j) ∈ P` and `s ∈ ℂ` is fixed by
`σ_g` for every finite product `g` of such elementary matrices. -/
theorem leftSubst_list_prod_transvection {P : Set (Fin p × Fin p)} {f : ComplexPoly p q}
    (hf : ∀ ij ∈ P, ∀ s : ℂ, leftSubst q (transvection ij.1 ij.2 s) f = f)
    (l : List (Fin p × Fin p × ℂ)) (hl : ∀ t ∈ l, (t.1, t.2.1) ∈ P) :
    leftSubst q (l.map fun t => transvection t.1 t.2.1 t.2.2).prod f = f := by
  induction l with
  | nil => simp
  | cons t l ih =>
    rw [List.map_cons, List.prod_cons, leftSubst_mul, AlgHom.comp_apply,
      hf _ (hl t List.mem_cons_self) t.2.2, ih fun t' h => hl t' (List.mem_cons_of_mem _ h)]

/-! ### Invariants of sets generated by elementary matrices -/

/-- **Invariants under elementary matrices are the invariants of the one-parameter
substitutions.** If `G` contains every elementary matrix `E_{ij}(s)`, `(i, j) ∈ P`, `s ∈ ℂ`, and
each element of `G` is a finite product of such matrices, then `ℂ[z]^G` is the subalgebra of the
`f ∈ ℂ[z]` with `Θ_{ij}(f) = f` for every `(i, j) ∈ P`. -/
@[cluster_algebras "lem_invariants_elementary"]
theorem invariants_eq_fixedSubalgebra {P : Set (Fin p × Fin p)}
    {G : Set (Matrix (Fin p) (Fin p) ℂ)}
    (hPG : ∀ ij ∈ P, ∀ s : ℂ, transvection ij.1 ij.2 s ∈ G)
    (hG : ∀ g ∈ G, ∃ l : List (Fin p × Fin p × ℂ), (∀ t ∈ l, (t.1, t.2.1) ∈ P) ∧
      g = (l.map fun t => transvection t.1 t.2.1 t.2.2).prod) :
    invariants q G = fixedSubalgebra fun ij : P => oneParamSubst q ij.1.1 ij.1.2 := by
  ext f
  rw [mem_invariants, mem_fixedSubalgebra]
  refine ⟨fun hf ij => ?_, fun hf g hg => ?_⟩
  · rw [← sub_eq_zero]
    apply Polynomial.eq_zero_of_infinite_isRoot
    refine (Set.infinite_range_of_injective (C_injective (Fin p × Fin q) ℂ)).mono ?_
    rintro _ ⟨s, rfl⟩
    simp [eval_oneParamSubst, hf _ (hPG _ ij.2 s)]
  · obtain ⟨l, hl, rfl⟩ := hG g hg
    exact leftSubst_list_prod_transvection (fun ij hij s => by
      rw [← eval_oneParamSubst, hf ⟨ij, hij⟩, Polynomial.eval_C]) l hl

/-- **Polynomial invariants of a set generated by elementary matrices are factorial.** If `G`
contains every elementary matrix `E_{ij}(s)`, `(i, j) ∈ P`, `s ∈ ℂ`, and each element of `G` is a
finite product of such matrices, then the subalgebra `ℂ[z]^G` (a subring of `ℂ[z]` containing
`ℂ`) is a unique factorization domain. -/
@[cluster_algebras "lem_polynomial_invariants_ufd"]
theorem uniqueFactorizationMonoid_invariants {P : Set (Fin p × Fin p)}
    {G : Set (Matrix (Fin p) (Fin p) ℂ)}
    (hPG : ∀ ij ∈ P, ∀ s : ℂ, transvection ij.1 ij.2 s ∈ G)
    (hG : ∀ g ∈ G, ∃ l : List (Fin p × Fin p × ℂ), (∀ t ∈ l, (t.1, t.2.1) ∈ P) ∧
      g = (l.map fun t => transvection t.1 t.2.1 t.2.2).prod) :
    UniqueFactorizationMonoid (invariants q G) := by
  rw [invariants_eq_fixedSubalgebra hPG hG]
  exact uniqueFactorizationMonoid_fixedSubalgebra fun _ f => eval_zero_oneParamSubst _ _ f

/-- **The Plücker ring is factorial.** The Plücker ring `R_{a,b} = ℂ[z]^{SL_a(ℂ)}` (a subring of
`ℂ[z]` containing `ℂ`) is a unique factorization domain. -/
@[cluster_algebras "prop_plucker_ring_factorial"]
instance uniqueFactorizationMonoid_pluckerRing (a b : ℕ) :
    UniqueFactorizationMonoid (pluckerRing a b) :=
  uniqueFactorizationMonoid_invariants (P := {ij | ij.1 ≠ ij.2})
    (fun _ hij s => det_transvection_of_ne _ _ hij s)
    fun _ hg => det_eq_one_iff_exists_list_transvection.mp hg

/-- The invariants `ℂ[z]^{U_p}` of the lower unitriangular matrices form a unique factorization
domain. -/
instance uniqueFactorizationMonoid_invariants_lowerUnitriangular :
    UniqueFactorizationMonoid (invariants q (lowerUnitriangular p)) :=
  uniqueFactorizationMonoid_invariants (P := {ij | ij.2 < ij.1})
    (fun _ hij s => transvection_mem_lowerUnitriangular hij s)
    fun _ hg => mem_lowerUnitriangular_iff_exists_list_transvection.mp hg

end ClusterAlgebras
