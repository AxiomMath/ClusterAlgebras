module

public import ClusterAlgebras.Rings.RectanglesSeed
public import ClusterAlgebras.Subpattern.Subpattern
public import ClusterAlgebras.Subpattern.Factorization

/-!
# The Muir embedding sends the rectangles pattern to a subpattern

Let `z` be the generic `a × b` matrix and `z'` the generic `(a - 1) × (b - 1)` matrix over `ℂ`,
and let `λ'`, `λ` be rectangle labellings for `(a - 1, b - 1)` and `(a, b)`. Let `F'` be the
subfield of `ℂ(z')` generated by the entries of the rectangles seed `Σ_{a-1,b-1}(λ')`, `F` the
subfield of `ℂ(z)` generated by the entries of `Σ_{a,b}(λ)`, and `ι : F' → ℂ(z)` a `ℂ`-algebra
homomorphism with `ι(P_{J_{a-1,b-1}(v)}(z')) = P_{J_{a-1,b-1}(v) ∪ {b}}(z)` for every rectangle
`v ∈ V_{a-1,b-1}`, such as the Muir embedding. If `Π` is a seed pattern in `F'` through
`Σ_{a-1,b-1}(λ')` and `Σ` is a seed pattern in `F` through `Σ_{a,b}(λ)`, then `ι ∘ Π` is a seed
subpattern of `Σ`.

Since `J_{a,b}(v) = J_{a-1,b-1}(v) ∪ {b}` for `v ∈ V_{a-1,b-1}`, `ι` sends the entry of
`Σ_{a-1,b-1}(λ')` in position `ℓ` to the entry of `Σ_{a,b}(λ)` in position `r(ℓ)`, where
`r = λ⁻¹ ∘ λ'` is the reindexing map of the restriction of `Q_{a,b}` to its top `a - 1` rows.
That restriction also identifies the matrices, so `ι(Σ_{a-1,b-1}(λ')) = Σ_{a,b}(λ)^r` with `r`
closed for the matrix of `Σ_{a,b}(λ)`; in particular `ι` takes values in `F`. Factoring `r` as a
freezing, a restriction and a bijective relabelling gives the seed subpattern.

## Main results

* `ClusterAlgebras.map_adjoinSelf_rectanglesSeed_eq_reindex`: `ι(Σ_{a-1,b-1}(λ')) = Σ_{a,b}(λ)^r`,
  read in `ℂ(z)`.
* `ClusterAlgebras.apply_mem_adjoin_rectanglesSeed`: `ι` takes values in `F`.
* `ClusterAlgebras.exists_isSeedSubpattern_rectanglesSeed`: `ι` restricts to a homomorphism
  `ι' : F' → F`, along which `Π` is a seed subpattern of `Σ`.

## Implementation notes

* A seed subpattern (`ClusterAlgebras.IsSeedSubpattern`) is a seed pattern in a field `E`
  together with a `K`-algebra embedding of `E` into the field of the ambient pattern. FWZ's
  subpattern `ι ∘ Π` in the subfield `ι(F')` is therefore the pattern `Π` in `F'`
  itself, with the embedding `ι' : F' → F` obtained by restricting the codomain of `ι` to `F`.
  The statement asserts that this restriction exists, that it agrees with `ι` read in `ℂ(z)`,
  and that `Π` is a seed subpattern of `Σ` along it. In particular FWZ's appeal to the
  transport of seed patterns
  (`ClusterAlgebras.IsSeedPattern.exists_isSeedPattern_trivialize_map`), which makes `ι ∘ Π` a
  seed pattern in `ι(F')`, is not needed: that `Π` is a seed pattern in `F'` is the hypothesis.
* FWZ assume `3 ≤ a ≤ b - 2`. The argument uses only `1 ≤ a`, for the label identity
  `J_{a,b}(v) = J_{a-1,b-1}(v) ∪ {b}`, and `1 ≤ b`, for the column `b` to exist; the column `b`
  is `⟨b - 1, _⟩ : Fin b`, and the columns `[1, b - 1]` of `z'` are read in `[1, b]` through
  `Fin.castLEEmb`, as in `ClusterAlgebras.exists_algHom_adjoin_pluckerCoord`.
* The hypothesis on `ι` is stated for every `v ∈ V_{a-1,b-1}` and every proof `hv` that
  `P_{J_{a-1,b-1}(v)}(z')` lies in `F'`, so that `ι` can be applied to it; such a proof exists,
  `P_{J_{a-1,b-1}(v)}(z')` being the entry of `Σ_{a-1,b-1}(λ')` in position `λ'⁻¹(v)`.
* Of `Σ`, only its seed `Σ(t₀) = Σ_{a,b}(λ)` is used, as in FWZ's proof; that `Σ` is a
  seed pattern is not assumed.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras.
  Chapter 6*][FWZ]
-/

@[expose] public section

namespace ClusterAlgebras

variable {a b m n m' n' : ℕ}

/-- The entry of `Σ_{a,b}(λ)` in position `i` is `P_{J(λ(i))}(z)`. -/
private theorem rectanglesSeed_extCluster_eq (L : RectangleLabelling a b m n) (i : Fin m) :
    (rectanglesSeed L).extCluster i =
      algebraMap _ _ (pluckerCoord (complexGenericMatrix a b) (rectLabel a b (L.equiv i))) := by
  simp [rectanglesSeed, rectanglesSeedShift]

/-! ### The Muir embedding on the rectangles seed -/

section Muir

variable (ha : 1 ≤ a) (hb : 1 ≤ b) (L' : RectangleLabelling (a - 1) (b - 1) m' n')
  (L : RectangleLabelling a b m n)
  (ι : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster) →ₐ[ℂ]
    FractionRing (ComplexPoly a b))
  (hι : ∀ (v : RectVertex (a - 1) (b - 1))
    (hv : algebraMap (ComplexPoly (a - 1) (b - 1)) (FractionRing (ComplexPoly (a - 1) (b - 1)))
      (pluckerCoord (complexGenericMatrix (a - 1) (b - 1)) (rectLabel (a - 1) (b - 1) v)) ∈
        IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster)),
    ι ⟨_, hv⟩ = algebraMap _ _ (pluckerCoord (complexGenericMatrix a b)
      ((rectLabel (a - 1) (b - 1) v).map (Fin.castLEEmb (Nat.sub_le b 1)) ∪
        {⟨b - 1, Nat.sub_lt hb Nat.one_pos⟩})))

include ha hb hι

/-- **`ι` on the entries of the rectangles seed**: if `ι(P_{J_{a-1,b-1}(v)}(z')) =
P_{J_{a-1,b-1}(v) ∪ {b}}(z)` for every `v ∈ V_{a-1,b-1}`, then `ι` sends the entry of
`Σ_{a-1,b-1}(λ')` in position `ℓ` to the entry of `Σ_{a,b}(λ)` in position `r(ℓ)`, where
`r = λ⁻¹ ∘ λ'`. -/
theorem apply_adjoinSelf_rectanglesSeed_extCluster (ℓ : Fin m') :
    ι (((rectanglesSeed L').adjoinSelf ℂ).extCluster ℓ) =
      (rectanglesSeed L).extCluster (rectRestrictReindex L' L ℓ) := by
  have hmem : algebraMap (ComplexPoly (a - 1) (b - 1)) (FractionRing (ComplexPoly (a - 1) (b - 1)))
      (pluckerCoord (complexGenericMatrix (a - 1) (b - 1)) (rectLabel (a - 1) (b - 1)
        (L'.equiv ℓ))) ∈ IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster) :=
    rectanglesSeed_extCluster_eq L' ℓ ▸ IntermediateField.subset_adjoin ℂ _ ⟨ℓ, rfl⟩
  have h : ((rectanglesSeed L').adjoinSelf ℂ).extCluster ℓ = ⟨_, hmem⟩ :=
    Subtype.ext (rectanglesSeed_extCluster_eq L' ℓ)
  rw [h, hι, rectanglesSeed_extCluster_eq L, rectRestrictReindex_apply, Equiv.apply_symm_apply,
    rectLabel_rectVertexEmbedding ha hb]

/-- **`ι(Σ_{a-1,b-1}(λ')) = Σ_{a,b}(λ)^r`**, read in `ℂ(z)`, where `r = λ⁻¹ ∘ λ'` is the
reindexing map of the restriction of `Q_{a,b}` to its top `a - 1` rows. -/
theorem map_adjoinSelf_rectanglesSeed_eq_reindex :
    ((rectanglesSeed L').adjoinSelf ℂ).map ι =
      (rectanglesSeed L).reindex L'.le (rectRestrictReindex L' L) :=
  SeedData.ext (funext (apply_adjoinSelf_rectanglesSeed_extCluster ha hb L' L ι hι))
    (matrixReindex_rectRestrictReindex L' L).symm

/-- **`ι` takes values in the field of `Σ_{a,b}(λ)`**: `ι` maps the generators of `F'`, the
entries of `Σ_{a-1,b-1}(λ')`, to entries of `Σ_{a,b}(λ)`, so it maps `F'` into the subfield of
`ℂ(z)` they generate. -/
theorem apply_mem_adjoin_rectanglesSeed
    (x : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster)) :
    ι x ∈ IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster) := by
  obtain ⟨x, hx⟩ := x
  induction hx using IntermediateField.adjoin_induction with
  | mem x hx =>
    obtain ⟨ℓ, rfl⟩ := hx
    rw [show (⟨_, _⟩ : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster)) =
      ((rectanglesSeed L').adjoinSelf ℂ).extCluster ℓ from rfl,
      apply_adjoinSelf_rectanglesSeed_extCluster ha hb L' L ι hι ℓ]
    exact IntermediateField.subset_adjoin ℂ _ ⟨_, rfl⟩
  | algebraMap c =>
    rw [show (⟨_, _⟩ : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster)) =
      algebraMap ℂ _ c from rfl, ι.commutes c]
    exact IntermediateField.algebraMap_mem _ c
  | add x y hx hy ihx ihy =>
    have := add_mem ihx ihy
    rwa [← map_add] at this
  | inv x hx ihx =>
    have := inv_mem ihx
    rwa [← map_inv₀] at this
  | mul x y hx hy ihx ihy =>
    have := mul_mem ihx ihy
    rwa [← map_mul] at this

/-- **The Muir embedding sends the pattern to a subpattern.** Let `λ'`, `λ` be rectangle
labellings for `(a - 1, b - 1)` and `(a, b)`, `F'` the subfield of `ℂ(z')` generated by the entries
of `Σ_{a-1,b-1}(λ')`, `F` the subfield of `ℂ(z)` generated by those of `Σ_{a,b}(λ)`, and
`ι : F' → ℂ(z)` a `ℂ`-algebra homomorphism with `ι(P_{J_{a-1,b-1}(v)}(z')) =
P_{J_{a-1,b-1}(v) ∪ {b}}(z)` for every `v ∈ V_{a-1,b-1}`. Let `P'` be a seed pattern in `F'` with
`P'(t'₀) = Σ_{a-1,b-1}(λ')`, and `P` a family of seeds in `F` with `P(t₀) = Σ_{a,b}(λ)`. Then `ι`
restricts to a homomorphism `ι' : F' → F`, and `P'` is a seed subpattern of `P` along `ι'`: it is
FWZ's `ι ∘ P'`, a seed subpattern of `P`.

FWZ assume `3 ≤ a ≤ b - 2` and that `P` is a seed pattern; neither is used. -/
@[cluster_algebras "lem_muir_subpattern"]
theorem exists_isSeedSubpattern_rectanglesSeed
    {P' : RegularTree n' → SeedData
      (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster)) m' n'}
    (hP' : IsSeedPattern ℂ L'.le P') {t'₀ : RegularTree n'}
    (hP'₀ : P' t'₀ = (rectanglesSeed L').adjoinSelf ℂ)
    {P : RegularTree n → SeedData
      (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m n}
    {t₀ : RegularTree n} (hP₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ) :
    ∃ ι' : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster) →ₐ[ℂ]
        IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster),
      (∀ x, (ι' x : FractionRing (ComplexPoly a b)) = ι x) ∧
        IsSeedSubpattern L.le L'.le ι' P P' := by
  have hmem := apply_mem_adjoin_rectanglesSeed ha hb L' L ι hι
  let ι' : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster) →ₐ[ℂ]
      IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster) :=
    ι.codRestrict _ hmem
  refine ⟨ι', fun _ => rfl, ?_⟩
  obtain ⟨S, I, hI, hIn, π, hπ, hπb, hcl, hr⟩ :=
    ReindexingMap.exists_freeze_restrict_factorization L.le L'.le
      (isClosedFor_rectRestrictReindex L' L)
  refine isSeedSubpattern_of_map_eq_reindex hP' t₀ t'₀ S I hI hIn π hπ hπb
    (by rw [hP₀]; exact hcl) ?_
  rw [← hr, hP'₀, hP₀]
  exact SeedData.ext (funext fun ℓ => Subtype.ext
    (apply_adjoinSelf_rectanglesSeed_extCluster ha hb L' L ι hι ℓ))
    (matrixReindex_rectRestrictReindex L' L).symm

end Muir

end ClusterAlgebras
