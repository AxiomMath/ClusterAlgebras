/-!
# Cluster structures in `ℂ[Mat_{k×k}]` and `ℂ[SL_k]`

Let `k ≥ 2`, let `y` be the generic `k × k` matrix and `z` the generic `k × 2k` matrix over `ℂ`,
and let `φ : ℂ[z] → ℂ[y]` substitute `[y | W]` for `z` (`matSpecialization`), so that every
Plücker coordinate `P_J(z)` is sent to a minor of `y`, `P_{[k+1,2k]}` to `1` and `P_{[1,k]}` to
`det y`. Applying `φ` to the rectangles seed `Σ_{k,2k}(λ)` of the Plücker ring `R_{k,2k}` and
deleting the frozen variable of the empty rectangle gives a labeled seed in `ℂ(y)` whose `k²`
entries are minors of `y`; its seed pattern is a cluster structure on `ℂ[y] = ℂ[Mat_{k×k}]`
containing every minor of `y` among its cluster and coefficient variables. Deleting also the
frozen variable `det y` of the `k × k` rectangle and passing to `ℂ[SL_k] = ℂ[y]/⟨det y - 1⟩`
gives a cluster structure on `ℂ[SL_k]` containing the images of all the other minors.

## Main definitions

* `ClusterAlgebras.specRectanglesSeed ψ L`: the seed `ψ(φ(Σ_{k,2k}(λ)))`, for a `ℂ`-algebra
  homomorphism `ψ` out of `ℂ[y]`.
* `ClusterAlgebras.matSeed L`: the seed `Tr_I(φ(Σ_{k,2k}(λ)))` in `ℂ(y)`, `I = {λ⁻¹(∅)}`.
* `ClusterAlgebras.slSeed hk L`: the seed `Tr_I(π(φ(Σ_{k,2k}(λ))))` in `Frac(ℂ[SL_k])`,
  `I = {λ⁻¹(∅), λ⁻¹(k × k)}`.

## Main results

* `ClusterAlgebras.isLabeledSeed_matSeed`,
  `ClusterAlgebras.RectangleLabelling.card_univ_sdiff_singleton_symm_none`,
  `ClusterAlgebras.exists_matSeed_extCluster_eq_minor`,
  `ClusterAlgebras.RectangleLabelling.n_eq_sq`:
  `Tr_I(φ(Σ_{k,2k}(λ)))` is a labeled seed in `ℂ(y)` with `k²` entries, all minors of `y`, and
  rank `(k - 1)²`.
* `ClusterAlgebras.exists_clusterStructure_complexPoly`: `ℂ[Mat_{k×k}]` has a cluster structure
  whose cluster and coefficient variables include every minor.
* `ClusterAlgebras.exists_clusterStructure_slCoord`: `ℂ[SL_k]` has a cluster structure whose
  cluster and coefficient variables include the image of every minor other than `det y`.

## Implementation notes

* The seed pattern `Σ` through `Σ_{k,2k}(λ)` lives in the subfield `E ⊆ ℂ(z)` generated by the
  entries of `Σ_{k,2k}(λ)`. All its entries lie in `R_{k,2k}`, hence are polynomials, and `ψ ∘ φ`
  is applied to them as a ring homomorphism on the polynomial elements of `E`
  (`polySpecialization`); the transport of seed patterns along it is
  `IsSeedPattern.exists_isSeedPattern_trivialize_map`.
* `ℂ[y]` and `ℂ[SL_k]` are read in their fraction fields, as the images of `⊤` under `algebraMap`.
  The cluster algebra of the transported pattern is generated by the images of the entries of
  `Σ`, all of which lie in the image of `ℂ[y]`, and it contains the entries `y_{ij} = Δ_{i,j}(y)`;
  so it is the image of `ℂ[y]`. This avoids the First Fundamental Theorem used by FWZ.
* A minor `Δ_{K,L}(y)` with `K ≠ ∅` is neither `1` nor, unless `K = L = [1, k]`, `det y`, by
  homogeneity; this shows that the Plücker coordinate `P_J` with `φ(P_J) = Δ_{K,L}(y)` does not
  sit in a deleted position.
* FWZ state `ℂ[SL_k]`'s cluster structure using that `ℂ[SL_k]` is factorial; the proof
  here does not need it.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6,
  Section 6.6.
-/

@[expose] public section

namespace ClusterAlgebras

open Finset MvPolynomial

/-! ### Specializing Laurent polynomials -/

section Laurent

variable {F K ι : Type*} [Field F] [Field K]

/-- An integer Laurent polynomial `y` in a family `x` of nonzero elements of a subring `R ⊆ F` can
be cleared of denominators inside `R`: `y d = g` for a product `d` of entries of `x` and an
element `g` of the subring generated by `x`. -/
theorem exists_mul_eq_of_mem_laurentSubring {R : Subring F} {x : ι → R}
    (hx : ∀ i, (x i : F) ≠ 0) {y : F} (hy : y ∈ laurentSubring fun i => (x i : F)) :
    ∃ d ∈ Submonoid.closure (Set.range x), ∃ g ∈ Subring.closure (Set.range x),
      y * (d : F) = (g : F) := by
  have hle : ∀ d ∈ Submonoid.closure (Set.range x), d ∈ Subring.closure (Set.range x) :=
    fun d hd => (Submonoid.closure_le (S := (Subring.closure (Set.range x)).toSubmonoid)).2
      Subring.subset_closure hd
  rw [laurentSubring] at hy
  induction hy using Subring.closure_induction with
  | mem z hz =>
    rcases hz with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact ⟨1, one_mem _, x i, Subring.subset_closure ⟨i, rfl⟩, by simp⟩
    · exact ⟨x i, Submonoid.subset_closure ⟨i, rfl⟩, 1, one_mem _, by simp [hx i]⟩
  | zero => exact ⟨1, one_mem _, 0, zero_mem _, by simp⟩
  | one => exact ⟨1, one_mem _, 1, one_mem _, by simp⟩
  | add a b _ _ ha hb =>
    obtain ⟨d, hd, g, hg, h⟩ := ha
    obtain ⟨d', hd', g', hg', h'⟩ := hb
    refine ⟨d * d', mul_mem hd hd', g * d' + d * g',
      add_mem (mul_mem hg (hle _ hd')) (mul_mem (hle _ hd) hg'), ?_⟩
    push_cast
    linear_combination (d' : F) * h + (d : F) * h'
  | neg a _ ha =>
    obtain ⟨d, hd, g, hg, h⟩ := ha
    refine ⟨d, hd, -g, neg_mem hg, ?_⟩
    push_cast
    linear_combination -h
  | mul a b _ _ ha hb =>
    obtain ⟨d, hd, g, hg, h⟩ := ha
    obtain ⟨d', hd', g', hg', h'⟩ := hb
    refine ⟨d * d', mul_mem hd hd', g * g', mul_mem hg hg', ?_⟩
    push_cast
    linear_combination (b * d') * h + (g : F) * h'

/-- **Specializing a Laurent polynomial.** Let `R ⊆ F` be a subring, `φ : R → K` a ring
homomorphism to a field and `x` a family in `R` with every `φ(xᵢ) ≠ 0`. If `w ∈ R` is an integer
Laurent polynomial in `x`, then `φ(w)` lies in the subfield of `K` generated by the `φ(xᵢ)`. -/
theorem map_mem_closure_of_mem_laurentSubring {R : Subring F} (φ : R →+* K) {x : ι → R}
    (hx : ∀ i, φ (x i) ≠ 0) {w : R} (hw : (w : F) ∈ laurentSubring fun i => (x i : F)) :
    φ w ∈ Subfield.closure (Set.range (φ ∘ x)) := by
  have hx' : ∀ i, (x i : F) ≠ 0 := fun i h =>
    hx i (by rw [show x i = 0 from Subtype.ext h, map_zero])
  have hne : ∀ d ∈ Submonoid.closure (Set.range x), φ d ≠ 0 := by
    intro d hd
    induction hd using Submonoid.closure_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact hx i
    | one => simp
    | mul a b _ _ ha hb => simpa using mul_ne_zero ha hb
  obtain ⟨d, hd, g, hg, h⟩ := exists_mul_eq_of_mem_laurentSubring hx' hw
  have hwdg : w * d = g := Subtype.ext (by simpa using h)
  have hcl : ∀ g ∈ Subring.closure (Set.range x), φ g ∈ Subfield.closure (Set.range (φ ∘ x)) := by
    intro g hg
    induction hg using Subring.closure_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact Subfield.subset_closure ⟨i, rfl⟩
    | zero => simp
    | one => simp
    | add a b _ _ ha hb => simpa using add_mem ha hb
    | neg a _ ha => simpa using neg_mem ha
    | mul a b _ _ ha hb => simpa using mul_mem ha hb
  rw [show φ w = φ g / φ d by rw [eq_div_iff (hne d hd), ← map_mul, hwdg]]
  exact div_mem (hcl g hg) (hcl d ((Submonoid.closure_le
    (S := (Subring.closure (Set.range x)).toSubmonoid)).2 Subring.subset_closure hd))

end Laurent

/-! ### Specializing elements of `ℂ[z]` inside a subfield of `ℂ(z)` -/

section Specialization

variable {k : ℕ}

/-- The elements of a subfield `E ⊆ ℂ(z)` which are polynomials, that is, lie in the image of
`ℂ[z]`. -/
noncomputable def polySubring (p q : ℕ)
    (E : IntermediateField ℂ (FractionRing (ComplexPoly p q))) : Subring E :=
  (IsScalarTower.toAlgHom ℂ (ComplexPoly p q)
    (FractionRing (ComplexPoly p q))).range.toSubring.comap E.val.toRingHom

/-- Membership in `polySubring`. -/
theorem mem_polySubring {p q : ℕ} {E : IntermediateField ℂ (FractionRing (ComplexPoly p q))}
    {x : E} : x ∈ polySubring p q E ↔
      ∃ f, algebraMap (ComplexPoly p q) (FractionRing (ComplexPoly p q)) f = x :=
  Iff.rfl

/-- The embedding `ℂ[z] → ℂ(z)`, as an isomorphism onto its image. -/
noncomputable def polyEquiv (p q : ℕ) :
    ComplexPoly p q ≃ₐ[ℂ]
      (IsScalarTower.toAlgHom ℂ (ComplexPoly p q) (FractionRing (ComplexPoly p q))).range :=
  AlgEquiv.ofInjective _ (IsFractionRing.injective _ _)

/-- The ring homomorphism `x ↦ ψ(φ(x))` on the polynomial elements of a subfield `E ⊆ ℂ(z)`, for
`z` the generic `k × 2k` matrix, `φ = matSpecialization k` and a `ℂ`-algebra homomorphism
`ψ : ℂ[y] → A`. -/
noncomputable def polySpecialization
    (E : IntermediateField ℂ (FractionRing (ComplexPoly k (2 * k))))
    {A : Type*} [CommRing A] [Algebra ℂ A] (ψ : ComplexPoly k k →ₐ[ℂ] A) :
    polySubring k (2 * k) E →+* A :=
  RingHom.comp (ψ.comp (matSpecialization k)).toRingHom
    (RingHom.comp (polyEquiv k (2 * k)).symm.toRingEquiv.toRingHom
      ((E.val.toRingHom.comp (polySubring k (2 * k) E).subtype).codRestrict
        (IsScalarTower.toAlgHom ℂ (ComplexPoly k (2 * k))
          (FractionRing (ComplexPoly k (2 * k)))).range fun x => x.2))

/-- `polySpecialization E ψ` sends the image of a polynomial `f` to `ψ(φ(f))`. -/
theorem polySpecialization_apply
    {E : IntermediateField ℂ (FractionRing (ComplexPoly k (2 * k)))}
    {A : Type*} [CommRing A] [Algebra ℂ A] (ψ : ComplexPoly k k →ₐ[ℂ] A)
    {x : polySubring k (2 * k) E} {f : ComplexPoly k (2 * k)}
    (hf : algebraMap _ (FractionRing (ComplexPoly k (2 * k))) f = ((x : E) : _)) :
    polySpecialization E ψ x = ψ (matSpecialization k f) := by
  have : (polyEquiv k (2 * k)).symm
      ⟨((x : E) : FractionRing (ComplexPoly k (2 * k))), x.2⟩ = f := by
    rw [AlgEquiv.symm_apply_eq]
    exact Subtype.ext (by simp [polyEquiv, hf])
  simp only [polySpecialization, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, AlgHom.coe_comp, Function.comp_apply]
  rw [← this]
  rfl

end Specialization

/-! ### Minors of the generic matrix -/

section Minors

/-- A square minor of the generic matrix is homogeneous, of degree its size. -/
theorem isHomogeneous_minor_complexGenericMatrix {p q : ℕ} {I : Finset (Fin p)}
    {J : Finset (Fin q)} (h : I.card = J.card) :
    (minor (complexGenericMatrix p q) I J).IsHomogeneous I.card := by
  rw [minor_of_card_eq _ rfl h.symm]
  simpa using isHomogeneous_det_of_isHomogeneous
    (M := (complexGenericMatrix p q).submatrix (I.orderEmbOfFin rfl) (J.orderEmbOfFin h.symm))
    fun a b => by simpa using isHomogeneous_X ℂ _

/-- A nonempty square minor of the generic matrix is not `1`. -/
theorem minor_complexGenericMatrix_ne_one {p q : ℕ} {I : Finset (Fin p)} {J : Finset (Fin q)}
    (h : I.card = J.card) (hI : I.Nonempty) : minor (complexGenericMatrix p q) I J ≠ 1 := by
  intro h1
  have := (isHomogeneous_minor_complexGenericMatrix h).inj_right
    (by rw [h1]; exact isHomogeneous_one _ _) (minor_complexGenericMatrix_ne_zero h)
  exact hI.card_pos.ne' this

/-- A square minor of the generic `k × k` matrix other than the determinant is not the
determinant. -/
theorem minor_complexGenericMatrix_ne_det {k : ℕ} {I J : Finset (Fin k)} (h : I.card = J.card)
    (hIJ : ¬(I = univ ∧ J = univ)) :
    minor (complexGenericMatrix k k) I J ≠ (complexGenericMatrix k k).det := by
  intro he
  have hdeg := (isHomogeneous_minor_complexGenericMatrix h).inj_right
    (by rw [he]; exact isHomogeneous_det_complexGenericMatrix k)
    (minor_complexGenericMatrix_ne_zero h)
  exact hIJ ⟨eq_univ_of_card I (by rw [Fintype.card_fin]; exact hdeg),
    eq_univ_of_card J (by rw [Fintype.card_fin, ← h]; exact hdeg)⟩

/-- `π(det y) = 1` in `ℂ[SL_k]`. -/
theorem slQuot_det_complexGenericMatrix (k : ℕ) :
    slQuot k (complexGenericMatrix k k).det = 1 := by
  have : slQuot k (complexGenericMatrix k k).det = slQuot k 1 := by
    simp only [slQuot, Ideal.Quotient.mkₐ_eq_mk]
    exact Ideal.Quotient.eq.2 (Ideal.mem_span_singleton_self (detSubOne k))
  rwa [map_one] at this

/-- A subfield of `K(x)` containing every indeterminate is everything. -/
theorem eq_top_of_algebraMap_X_mem {K σ : Type*} [Field K]
    {E : IntermediateField K (FractionRing (MvPolynomial σ K))}
    (h : ∀ s, algebraMap (MvPolynomial σ K) (FractionRing (MvPolynomial σ K)) (X s) ∈ E) :
    E = ⊤ := by
  have hR : ∀ f : MvPolynomial σ K, algebraMap _ (FractionRing (MvPolynomial σ K)) f ∈ E := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C a =>
      rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
      exact E.algebraMap_mem a
    | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
    | mul_X p s hp =>
      rw [map_mul]
      exact mul_mem hp (h s)
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := MvPolynomial σ K) z
  exact div_mem (hR a) (hR b)

/-- `ℂ(y)` has transcendence degree `k²` over `ℂ`. -/
theorem trdeg_fractionRing_complexPoly (k : ℕ) :
    Algebra.trdeg ℂ (FractionRing (ComplexPoly k k)) = ((k * k : ℕ) : Cardinal) := by
  set e : Fin (k * k) ≃ Fin k × Fin k := finProdFinEquiv.symm
  have hx : IsFreeGeneratingTuple ℂ fun a : Fin (k * k) =>
      algebraMap (ComplexPoly k k) (FractionRing (ComplexPoly k k)) (X (e a)) := by
    refine ⟨((MvPolynomial.algebraicIndependent_X (Fin k × Fin k) ℂ).comp e
      e.injective).map' (f := IsScalarTower.toAlgHom ℂ (ComplexPoly k k) _)
      (IsFractionRing.injective _ _), eq_top_of_algebraMap_X_mem fun s => ?_⟩
    exact IntermediateField.subset_adjoin _ _ ⟨e.symm s, by simp⟩
  exact hx.trdeg_eq

end Minors

/-! ### Seed patterns -/

section Pattern

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

/-- An entry of a seed of a cluster structure is a cluster or coefficient variable. -/
theorem ClusterStructure.coe_extCluster_mem {L : Type*} [Field L] [Algebra K L]
    {R : Subalgebra K L} (C : ClusterStructure K R) (t : RegularTree C.n) (a : Fin C.m) :
    ((C.pattern t).extCluster a : L) ∈ C.clusterVariables ∪ C.coefficientVariables := by
  unfold ClusterStructure.clusterVariables ClusterStructure.coefficientVariables
    patternClusterVariables
  by_cases ha : (a : ℕ) < C.n
  · exact Or.inl ⟨_, Set.mem_iUnion.2 ⟨t, ⟨a, ha⟩, rfl⟩, rfl⟩
  · exact Or.inr ⟨_, Set.mem_iUnion.2 ⟨t, a, not_lt.1 ha, rfl⟩, rfl⟩

omit [Field F] in
/-- Trivializing frozen positions keeps the matrix extended skew-symmetrizable: its principal part
is unchanged. -/
theorem ExtSkewSymmetrizable.trivialize {hmn : n ≤ m} {S : SeedData F m n}
    (hS : ExtSkewSymmetrizable hmn S.extExchangeMatrix) {I : Finset (Fin m)}
    (hI : ∀ i ∈ I, n ≤ (i : ℕ)) :
    ExtSkewSymmetrizable (le_card_univ_sdiff hmn hI) (S.trivialize I).extExchangeMatrix := by
  have h : restrictionEnumeration n (univ \ I) ∘ Fin.castLE (le_card_univ_sdiff hmn hI) =
      Fin.castLE hmn :=
    funext (restrictionEnumeration_univ_sdiff_castLE hmn hI _)
  simp only [ExtSkewSymmetrizable, SeedData.trivialize_extExchangeMatrix,
    Matrix.submatrix_submatrix, h, Function.comp_id]
  exact hS

end Pattern

section Rectangles

variable {k m n : ℕ}

/-- The label of the empty rectangle of `Q_{k,2k}` is the top half `[k + 1, 2k]`. -/
theorem rectLabel_none_eq_topHalf :
    rectLabel k (2 * k) none = univ.filter fun c : Fin (2 * k) => k ≤ (c : ℕ) := by
  ext c
  simp only [rectLabel, mem_filter, mem_univ, true_and]
  omega

/-- `φ(P_{J(∅)}) = 1`. -/
theorem matSpecialization_pluckerCoord_rectLabel_none :
    matSpecialization k (pluckerCoord (complexGenericMatrix k (2 * k))
      (rectLabel k (2 * k) none)) = 1 := by
  rw [rectLabel_none_eq_topHalf]
  exact matSpecialization_pluckerCoord_topHalf

/-- The `k × k` rectangle of `Q_{k,2k}`. -/
def fullRect (hk : 1 ≤ k) : RectVertex k (2 * k) :=
  some (⟨k - 1, by omega⟩, ⟨k - 1, by omega⟩)

/-- The label of the `k × k` rectangle of `Q_{k,2k}` is the bottom half `[1, k]`. -/
theorem rectLabel_fullRect (hk : 1 ≤ k) :
    rectLabel k (2 * k) (fullRect hk) = univ.filter fun c : Fin (2 * k) => (c : ℕ) < k := by
  ext c
  simp only [rectLabel, fullRect, mem_filter, mem_univ, true_and]
  omega

/-- `φ(P_{J(k × k)}) = det y`. -/
theorem matSpecialization_pluckerCoord_rectLabel_fullRect (hk : 1 ≤ k) :
    matSpecialization k (pluckerCoord (complexGenericMatrix k (2 * k))
      (rectLabel k (2 * k) (fullRect hk))) = (complexGenericMatrix k k).det := by
  rw [rectLabel_fullRect]
  exact matSpecialization_pluckerCoord_bottomHalf

/-- The empty rectangle is frozen. -/
theorem RectangleLabelling.le_symm_none (L : RectangleLabelling k (2 * k) m n) :
    n ≤ (L.equiv.symm none : ℕ) :=
  (L.frozen_iff _).1 (by rw [Equiv.apply_symm_apply]; trivial)

/-- The `k × k` rectangle is frozen. -/
theorem RectangleLabelling.le_symm_fullRect (L : RectangleLabelling k (2 * k) m n)
    (hk : 1 ≤ k) : n ≤ (L.equiv.symm (fullRect hk) : ℕ) :=
  (L.frozen_iff _).1 (by
    rw [Equiv.apply_symm_apply]
    exact Or.inl (show k - 1 + 1 = k by omega))

/-- **The specialized rectangles seed has rank `(k - 1)²`**: a rectangle labelling of `Q_{k,2k}`
has `n = (k - 1)²` mutable indices. -/
@[cluster_algebras "lem_mat_seed_is_seed"]
theorem RectangleLabelling.n_eq_sq (L : RectangleLabelling k (2 * k) m n) :
    n = (k - 1) ^ 2 := by
  rw [L.n_eq, sq]
  congr 1
  omega

end Rectangles

/-! ### The specialized rectangles seed and its pattern -/

section Transport

variable {k m n : ℕ} {A : Type*} [Field A] [Algebra ℂ A]

/-- The entry of `Σ_{a,b}(λ)` in position `ℓ` is `P_{J(λ(ℓ))}(z)`. -/
theorem rectanglesSeed_extCluster_apply {a b : ℕ} (L : RectangleLabelling a b m n) (ℓ : Fin m) :
    (rectanglesSeed L).extCluster ℓ =
      algebraMap _ _ (pluckerCoord (complexGenericMatrix a b) (rectLabel a b (L.equiv ℓ))) := by
  simp [rectanglesSeed, rectanglesSeedShift, cyclicShift_zero]

/-- The rectangles seed `Σ_{k,2k}(λ)` specialized along `ψ ∘ φ`, for `φ = matSpecialization k`
and a `ℂ`-algebra homomorphism `ψ : ℂ[y] → A` to a field: its entry in position `ℓ` is
`ψ(φ(P_{J(λ(ℓ))}(z)))`, and its matrix is that of `Σ_{k,2k}(λ)`. -/
noncomputable def specRectanglesSeed (ψ : ComplexPoly k k →ₐ[ℂ] A)
    (L : RectangleLabelling k (2 * k) m n) : SeedData A m n where
  extCluster ℓ := ψ (matSpecialization k
    (pluckerCoord (complexGenericMatrix k (2 * k)) (rectLabel k (2 * k) (L.equiv ℓ))))
  extExchangeMatrix := (rectanglesSeed L).extExchangeMatrix

/-- The entry of `specRectanglesSeed ψ L` at `λ⁻¹(∅)` is `ψ(φ(1)) = 1`. -/
theorem specRectanglesSeed_extCluster_symm_none (ψ : ComplexPoly k k →ₐ[ℂ] A)
    (L : RectangleLabelling k (2 * k) m n) :
    (specRectanglesSeed ψ L).extCluster (L.equiv.symm none) = 1 := by
  change ψ _ = 1
  rw [Equiv.apply_symm_apply, matSpecialization_pluckerCoord_rectLabel_none, map_one]

/-- Every entry of a seed pattern through `Σ_{k,2k}(λ)` lies in `R_{k,2k}`, so is a polynomial. -/
private theorem extCluster_mem_polySubring (hk : 2 ≤ k) (L : RectangleLabelling k (2 * k) m n)
    {P : RegularTree n →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m n}
    (hP : IsSeedPattern ℂ L.le P) (hP₀ : P RegularTree.root = (rectanglesSeed L).adjoinSelf ℂ)
    (t : RegularTree n) (i : Fin m) :
    (P t).extCluster i ∈ polySubring k (2 * k)
      (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) := by
  have h1 := extCluster_mem_clusterAlgebra ℂ L.le P t i
  rw [hP.clusterAlgebra_eq L.le RegularTree.root, hP₀] at h1
  have h2 : ((P t).extCluster i : FractionRing (ComplexPoly k (2 * k))) ∈
      (clusterAlgebraOfSeed ℂ L.le ((rectanglesSeed L).adjoinSelf ℂ)).map
        (IntermediateField.val _) := ⟨_, h1, rfl⟩
  rw [map_val_clusterAlgebraOfSeed_rectanglesSeed (by omega) (by omega) L] at h2
  obtain ⟨f, -, hf⟩ := h2
  exact mem_polySubring.2 ⟨f, hf⟩

/-- **Transporting the Grassmannian seed pattern along `ψ ∘ φ`.** Let `Σ` be a seed pattern
through `Σ_{k,2k}(λ)`, `ψ : ℂ[y] → A` a `ℂ`-algebra homomorphism to a field, and `I` a set of
frozen positions whose entries `ψ(φ(P_{J(λ(i))}))` are `1`. If `Tr_I(ψ(φ(Σ_{k,2k}(λ))))` is a
labeled seed in a subfield `F' ⊆ A`, there is a seed pattern `Π` in `F'` such that every entry
of every `Π(t)` is some `ψ(φ(f))`, and for every `|J| = k` either `ψ(φ(P_J))` is an entry of some
`Π(t)`, or `P_J` is the Plücker coordinate in a position of `I`. -/
theorem exists_isSeedPattern_specRectanglesSeed (hk : 2 ≤ k)
    (L : RectangleLabelling k (2 * k) m n) (ψ : ComplexPoly k k →ₐ[ℂ] A)
    {I : Finset (Fin m)} (hI : ∀ i ∈ I, n ≤ (i : ℕ))
    (hψI : ∀ i ∈ I, (specRectanglesSeed ψ L).extCluster i = 1) (F' : IntermediateField ℂ A)
    (hF' : ∃ S₀ : SeedData F' (univ \ I).card n,
      IsLabeledSeed ℂ (le_card_univ_sdiff L.le hI) S₀ ∧
        S₀.map ((↑) : F' → A) = (specRectanglesSeed ψ L).trivialize I) :
    ∃ P' : RegularTree n → SeedData F' (univ \ I).card n,
      IsSeedPattern ℂ (le_card_univ_sdiff L.le hI) P' ∧
      (∀ t a, ((P' t).extCluster a : A) ∈ Set.range (ψ.comp (matSpecialization k))) ∧
      ∀ J : Finset (Fin (2 * k)), J.card = k →
        (∃ t a, ((P' t).extCluster a : A) =
          ψ (matSpecialization k (pluckerCoord (complexGenericMatrix k (2 * k)) J))) ∨
        ∃ i ∈ I, pluckerCoord (complexGenericMatrix k (2 * k)) J =
          pluckerCoord (complexGenericMatrix k (2 * k)) (rectLabel k (2 * k) (L.equiv i)) := by
  classical
  set E := IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)
  obtain ⟨P, hP, hP₀⟩ := exists_isSeedPattern (K := ℂ) L.le RegularTree.root
    (isLabeledSeed_rectanglesSeed (by omega) (by omega) L)
  have hpoly := extCluster_mem_polySubring hk L hP hP₀
  let Q : RegularTree n → SeedData (polySubring k (2 * k) E) m n := fun t =>
    ⟨fun i => ⟨(P t).extCluster i, hpoly t i⟩, (P t).extExchangeMatrix⟩
  have hQP : (fun t => (Q t).map ((↑) : polySubring k (2 * k) E → E)) = P := rfl
  have hφ : ∀ t i f, algebraMap (ComplexPoly k (2 * k)) (FractionRing (ComplexPoly k (2 * k))) f =
      ((P t).extCluster i : FractionRing (ComplexPoly k (2 * k))) →
      polySpecialization E ψ ((Q t).extCluster i) = ψ (matSpecialization k f) :=
    fun t i f hf => polySpecialization_apply ψ hf
  have hroot : ∀ i, ((P RegularTree.root).extCluster i : FractionRing (ComplexPoly k (2 * k))) =
      algebraMap _ _ (pluckerCoord (complexGenericMatrix k (2 * k))
        (rectLabel k (2 * k) (L.equiv i))) := by
    intro i
    rw [hP₀]
    exact rectanglesSeed_extCluster_apply L i
  have hQ₀ : (Q RegularTree.root).map (polySpecialization E ψ) = specRectanglesSeed ψ L := by
    refine SeedData.ext (funext fun i => hφ _ i _ (hroot i).symm) ?_
    change (P RegularTree.root).extExchangeMatrix = _
    rw [hP₀]
    rfl
  obtain ⟨P', hP', hP'Q⟩ := IsSeedPattern.exists_isSeedPattern_trivialize_map (𝕜 := ℂ) L.le
    (Q := Q) (by rwa [hQP]) (polySpecialization E ψ) hI RegularTree.root
    (fun i hi => by rw [← hψI i hi, ← hQ₀]; rfl) F' (by rwa [hQ₀])
  have hentry : ∀ t a, ((P' t).extCluster a : A) =
      polySpecialization E ψ ((Q t).extCluster (restrictionEnumeration n (univ \ I) a)) :=
    fun t a => congrFun (congrArg SeedData.extCluster (hP'Q t)) a
  refine ⟨P', hP', fun t a => ?_, fun J hJ => ?_⟩
  · obtain ⟨f, hf⟩ := mem_polySubring.1 (hpoly t (restrictionEnumeration n (univ \ I) a))
    exact ⟨f, by rw [hentry, hφ _ _ f hf]; rfl⟩
  · obtain ⟨t, i, hti⟩ := L.exists_extCluster_eq_pluckerCoord (by omega) (by omega) hP hP₀ hJ
    by_cases hiI : i ∈ I
    · refine Or.inr ⟨i, hiI, IsFractionRing.injective (ComplexPoly k (2 * k))
        (FractionRing (ComplexPoly k (2 * k))) ?_⟩
      obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_eq L.le RegularTree.root t
      rw [← hti, ← hroot, hs, seedMutationSeq_extCluster_of_le L.le _ s (hI i hiI)]
    · obtain ⟨a, rfl⟩ : i ∈ Set.range (restrictionEnumeration n (univ \ I)) := by
        rw [range_restrictionEnumeration]
        simpa using hiI
      exact Or.inl ⟨t, a, (hentry t a).trans (hφ _ _ _ hti.symm)⟩

end Transport

/-! ### The specialized rectangles seed is a labeled seed in `ℂ(y)` -/

section MatSeed

variable {k m n : ℕ} {A : Type*} [Field A] [Algebra ℂ A]

/-- **Every specialized Plücker coordinate lies in the field generated by the specialized
rectangles seed.** If `ψ ∘ φ` sends no entry of `Σ_{k,2k}(λ)` to `0`, then `ψ(φ(P_J))` lies in
the subfield generated by the entries of `specRectanglesSeed ψ L`, for every `|J| = k`. -/
theorem mem_closure_specRectanglesSeed (hk : 2 ≤ k) (L : RectangleLabelling k (2 * k) m n)
    (ψ : ComplexPoly k k →ₐ[ℂ] A) (hψ : ∀ ℓ, (specRectanglesSeed ψ L).extCluster ℓ ≠ 0)
    {J : Finset (Fin (2 * k))} (hJ : J.card = k) :
    ψ (matSpecialization k (pluckerCoord (complexGenericMatrix k (2 * k)) J)) ∈
      Subfield.closure (Set.range (specRectanglesSeed ψ L).extCluster) := by
  set E := IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)
  obtain ⟨P, hP, hP₀⟩ := exists_isSeedPattern (K := ℂ) L.le RegularTree.root
    (isLabeledSeed_rectanglesSeed (by omega) (by omega) L)
  obtain ⟨t, i, hti⟩ := L.exists_extCluster_eq_pluckerCoord (by omega) (by omega) hP hP₀ hJ
  have hx : ∀ ℓ, ((rectanglesSeed L).adjoinSelf ℂ).extCluster ℓ ∈ polySubring k (2 * k) E :=
    fun ℓ => mem_polySubring.2 ⟨_, (rectanglesSeed_extCluster_apply L ℓ).symm⟩
  let x : Fin m → polySubring k (2 * k) E := fun ℓ => ⟨_, hx ℓ⟩
  have hφx : polySpecialization E ψ ∘ x = (specRectanglesSeed ψ L).extCluster :=
    funext fun ℓ => polySpecialization_apply ψ (rectanglesSeed_extCluster_apply L ℓ).symm
  have hlaur : ((⟨_, mem_polySubring.2 ⟨_, hti.symm⟩⟩ : polySubring k (2 * k) E) : E) ∈
      laurentSubring fun ℓ => (x ℓ : E) := by
    obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_eq L.le RegularTree.root t
    have := (hP.1 RegularTree.root).seedMutationSeq_extCluster_mem_laurentSubring L.le s i
    rwa [← hs, hP₀] at this
  have h := map_mem_closure_of_mem_laurentSubring (polySpecialization E ψ) (x := x)
    (fun ℓ => by rw [← Function.comp_apply (f := polySpecialization E ψ), hφx]; exact hψ ℓ)
    hlaur
  rwa [polySpecialization_apply ψ hti.symm, hφx] at h

/-- The positions `I = {λ⁻¹(∅)}` are frozen. -/
theorem RectangleLabelling.forall_mem_singleton_none (L : RectangleLabelling k (2 * k) m n) :
    ∀ i ∈ ({L.equiv.symm none} : Finset (Fin m)), n ≤ (i : ℕ) := by
  intro i hi
  rw [mem_singleton.1 hi]
  exact L.le_symm_none

/-- The seed `Tr_I(φ(Σ_{k,2k}(λ)))` in `ℂ(y)`, for `I = {λ⁻¹(∅)}`: its entries are the
specialized Plücker coordinates `φ(P_{J(v)})`, `v ≠ ∅`, read in `ℂ(y)`, and its matrix is that of
`Σ_{k,2k}(λ)` with the row of the empty rectangle removed. -/
noncomputable def matSeed (L : RectangleLabelling k (2 * k) m n) :
    SeedData (FractionRing (ComplexPoly k k)) (univ \ {L.equiv.symm none}).card n :=
  (specRectanglesSeed (IsScalarTower.toAlgHom ℂ (ComplexPoly k k)
    (FractionRing (ComplexPoly k k))) L).trivialize {L.equiv.symm none}

/-- The specialized Plücker coordinate of a rectangle is a nonzero minor of `y`. -/
theorem matSpecialization_pluckerCoord_rectLabel_ne_zero (v : RectVertex k (2 * k)) :
    matSpecialization k (pluckerCoord (complexGenericMatrix k (2 * k)) (rectLabel k (2 * k) v))
      ≠ 0 := by
  have hJ := card_rectLabel (by omega : k ≤ 2 * k) v
  rw [matSpecialization_pluckerCoord hJ]
  exact minor_complexGenericMatrix_ne_zero (card_matRowSet_eq_card_matColSet hJ)

/-- **The entries of `matSeed` generate `ℂ(y)`.** -/
theorem adjoin_range_matSeed (hk : 2 ≤ k) (L : RectangleLabelling k (2 * k) m n) :
    IntermediateField.adjoin ℂ (Set.range (matSeed L).extCluster) = ⊤ := by
  classical
  set ψ := IsScalarTower.toAlgHom ℂ (ComplexPoly k k) (FractionRing (ComplexPoly k k))
  set F := IntermediateField.adjoin ℂ (Set.range (matSeed L).extCluster)
  have hψ : ∀ ℓ, (specRectanglesSeed ψ L).extCluster ℓ ≠ 0 := fun ℓ =>
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2
      (matSpecialization_pluckerCoord_rectLabel_ne_zero _)
  have hcl : Subfield.closure (Set.range (specRectanglesSeed ψ L).extCluster) ≤
      F.toSubfield := by
    rw [Subfield.closure_le]
    rintro _ ⟨ℓ, rfl⟩
    by_cases hℓ : ℓ = L.equiv.symm none
    · rw [hℓ, specRectanglesSeed_extCluster_symm_none]
      exact F.one_mem
    · obtain ⟨a, rfl⟩ : ℓ ∈ Set.range (restrictionEnumeration n (univ \ {L.equiv.symm none})) := by
        rw [range_restrictionEnumeration]
        simpa using hℓ
      exact IntermediateField.subset_adjoin ℂ _ ⟨a, rfl⟩
  apply eq_top_of_algebraMap_X_mem
  rintro ⟨r, c⟩
  obtain ⟨J, ⟨hJ, -, hK, hL⟩, -⟩ := existsUnique_matRowSet_matColSet (k := k) (K := {r})
    (L := {c}) (by simp) (singleton_nonempty c)
  have h := hcl (mem_closure_specRectanglesSeed hk L ψ hψ hJ)
  rwa [matSpecialization_pluckerCoord hJ, hK, hL, minor_singleton,
    complexGenericMatrix_apply] at h

/-- **The specialized rectangles seed has `k²` entries**: deleting the index `λ⁻¹(∅)` from the
`k² + 1` indices of a rectangle labelling of `Q_{k,2k}` leaves `k²` indices. -/
@[cluster_algebras "lem_mat_seed_is_seed"]
theorem RectangleLabelling.card_univ_sdiff_singleton_symm_none
    (L : RectangleLabelling k (2 * k) m n) :
    (univ \ {L.equiv.symm none}).card = k * k := by
  rw [card_univ_sdiff, Fintype.card_fin, card_singleton, L.m_eq,
    show 2 * k - k = k by omega, Nat.add_sub_cancel]

end MatSeed

/-! ### The specialized rectangles seed is a labeled seed -/

section MatSeedIsSeed

variable {k m n : ℕ}

/-- **The specialized rectangles seed is a labeled seed**. Let `k ≥ 2`, let `λ` be a rectangle
labelling of `Q_{k,2k}` and `I = {λ⁻¹(∅)}`. Then `Tr_I(φ(Σ_{k,2k}(λ)))` is a labeled seed over `ℂ`
in `ℂ(y)` itself: its entries are a free generating tuple of `ℂ(y)`. -/
@[cluster_algebras "lem_mat_seed_is_seed"]
theorem isLabeledSeed_matSeed (hk : 2 ≤ k) (L : RectangleLabelling k (2 * k) m n) :
    IsLabeledSeed ℂ (le_card_univ_sdiff L.le L.forall_mem_singleton_none) (matSeed L) := by
  refine ⟨isFreeGeneratingTuple_of_trdeg_eq ?_ (adjoin_range_matSeed hk L), ?_⟩
  · rw [L.card_univ_sdiff_singleton_symm_none, trdeg_fractionRing_complexPoly]
  · exact (isLabeledSeed_rectanglesSeed (by omega) (by omega) L).2.trivialize
      L.forall_mem_singleton_none

/-- **The entries of the specialized rectangles seed are minors of `y`**: each entry of
`Tr_I(φ(Σ_{k,2k}(λ)))` is a minor `Δ_{K,L}(y)` with `K, L` nonempty of the same size. -/
@[cluster_algebras "lem_mat_seed_is_seed"]
theorem exists_matSeed_extCluster_eq_minor (hk : 2 ≤ k) (L : RectangleLabelling k (2 * k) m n)
    (a : Fin (univ \ {L.equiv.symm none}).card) :
    ∃ K L' : Finset (Fin k), K.Nonempty ∧ K.card = L'.card ∧
      (matSeed L).extCluster a = algebraMap _ _ (minor (complexGenericMatrix k k) K L') := by
  set J := rectLabel k (2 * k) (L.equiv (restrictionEnumeration n (univ \ {L.equiv.symm none}) a))
  have hJ : J.card = k := card_rectLabel (by omega) _
  have he : (matSeed L).extCluster a =
      algebraMap _ _ (minor (complexGenericMatrix k k) (matRowSet k J) (matColSet k J)) := by
    rw [← matSpecialization_pluckerCoord hJ]
    rfl
  refine ⟨_, _, ?_, card_matRowSet_eq_card_matColSet hJ, he⟩
  rw [nonempty_iff_ne_empty]
  intro h0
  have hL0 : matColSet k J = ∅ :=
    card_eq_zero.1 (by rw [← card_matRowSet_eq_card_matColSet hJ, h0, card_empty])
  have := (isLabeledSeed_matSeed hk L).1.1.transcendental a
  rw [he, h0, hL0, minor_of_card_eq _ card_empty card_empty, Matrix.det_isEmpty, map_one] at this
  exact this isAlgebraic_one

end MatSeedIsSeed

/-! ### A cluster structure on `ℂ[Mat_{k×k}]` -/

section MatClusterStructure

variable {k m n : ℕ}

/-- The cluster algebra of a seed pattern in a subfield `F'` of `Frac(B)`, where `π : ℂ[y] → B`
is a surjection onto a domain, is the image of `B` as soon as every entry of every seed is the
image of an element of `B` and every image `π(y_{rc})` of an indeterminate is an entry of some
seed. -/
theorem map_val_clusterAlgebra_eq_of_surjective {B : Type*} [CommRing B] [IsDomain B]
    [Algebra ℂ B] (π : ComplexPoly k k →ₐ[ℂ] B) (hπ : Function.Surjective π) {m' : ℕ}
    (hmn : n ≤ m') {F' : IntermediateField ℂ (FractionRing B)}
    {P' : RegularTree n → SeedData F' m' n}
    (h1 : ∀ t a, ∃ f, ((P' t).extCluster a : FractionRing B) = algebraMap B _ (π f))
    (h2 : ∀ s, ∃ t a, ((P' t).extCluster a : FractionRing B) = algebraMap B _ (π (X s))) :
    (clusterAlgebra ℂ hmn P').map F'.val =
      (⊤ : Subalgebra ℂ B).map (IsScalarTower.toAlgHom ℂ B (FractionRing B)) := by
  set ψ := (IsScalarTower.toAlgHom ℂ B (FractionRing B)).comp π
  rw [clusterAlgebra_eq_adjoin_extCluster, AlgHom.map_adjoin]
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨x, hx, rfl⟩
    simp only [Set.mem_iUnion, Set.mem_range] at hx
    obtain ⟨t, a, rfl⟩ := hx
    obtain ⟨f, hf⟩ := h1 t a
    exact ⟨π f, Algebra.mem_top, hf.symm⟩
  · rintro _ ⟨b, -, rfl⟩
    obtain ⟨f, rfl⟩ := hπ b
    have hf : f ∈ Algebra.adjoin ℂ (Set.range (X : Fin k × Fin k → ComplexPoly k k)) := by
      rw [MvPolynomial.adjoin_range_X]
      exact Algebra.mem_top
    have h : ψ f ∈ (Algebra.adjoin ℂ (Set.range (X : Fin k × Fin k → ComplexPoly k k))).map ψ :=
      Subalgebra.mem_map.2 ⟨f, hf, rfl⟩
    rw [AlgHom.map_adjoin] at h
    refine Algebra.adjoin_mono ?_ h
    rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
    obtain ⟨t, a, hta⟩ := h2 s
    exact ⟨(P' t).extCluster a, Set.mem_iUnion.2 ⟨t, a, rfl⟩, hta⟩

/-- **A cluster structure on `ℂ[Mat_{k×k}]`**. Let `k ≥ 2`. Then `ℂ[y]`, read in `ℂ(y)`, has a
cluster structure, in a subfield of `ℂ(y)`, whose cluster and coefficient variables include every
minor `Δ_{K,L}(y)`, `K, L ⊆ [1, k]` nonempty with `|K| = |L|`. -/
@[cluster_algebras "thm_mat_cluster_structure"]
theorem exists_clusterStructure_complexPoly (hk : 2 ≤ k) :
    ∃ C : ClusterStructure ℂ ((⊤ : Subalgebra ℂ (ComplexPoly k k)).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly k k) (FractionRing (ComplexPoly k k)))),
      ∀ K L : Finset (Fin k), K.Nonempty → K.card = L.card →
        algebraMap (ComplexPoly k k) (FractionRing (ComplexPoly k k))
            (minor (complexGenericMatrix k k) K L) ∈
          C.clusterVariables ∪ C.coefficientVariables := by
  obtain ⟨m, n, ⟨L⟩⟩ := exists_rectangleLabelling k (2 * k)
  set ψ := IsScalarTower.toAlgHom ℂ (ComplexPoly k k) (FractionRing (ComplexPoly k k))
  have hI := L.forall_mem_singleton_none
  have hS := isLabeledSeed_matSeed hk L
  obtain ⟨P', hP', h1, h2⟩ := exists_isSeedPattern_specRectanglesSeed hk L ψ hI
    (fun i hi => by
      rw [mem_singleton.1 hi]
      exact specRectanglesSeed_extCluster_symm_none ψ L)
    (IntermediateField.adjoin ℂ (Set.range (matSeed L).extCluster))
    ⟨(matSeed L).adjoinSelf ℂ, (isLabeledSeed_adjoinSelf_iff ℂ _ _).2 ⟨hS.1.1, hS.2⟩, rfl⟩
  have hmin : ∀ K L' : Finset (Fin k), K.Nonempty → K.card = L'.card →
      ∃ t a, ((P' t).extCluster a : FractionRing (ComplexPoly k k)) =
        algebraMap _ _ (minor (complexGenericMatrix k k) K L') := by
    intro K L' hK hKL
    obtain ⟨J, ⟨hJ, -, hJK, hJL⟩, -⟩ :=
      existsUnique_matRowSet_matColSet hKL (card_pos.1 (hKL ▸ card_pos.2 hK))
    rcases h2 J hJ with ⟨t, a, hta⟩ | ⟨i, hi, hiJ⟩
    · refine ⟨t, a, ?_⟩
      rw [hta, matSpecialization_pluckerCoord hJ, hJK, hJL]
      rfl
    · rw [mem_singleton.1 hi, Equiv.apply_symm_apply] at hiJ
      have h := congrArg (matSpecialization k) hiJ
      rw [matSpecialization_pluckerCoord hJ, hJK, hJL,
        matSpecialization_pluckerCoord_rectLabel_none] at h
      exact absurd h (minor_complexGenericMatrix_ne_one hKL hK)
  let C : ClusterStructure ℂ ((⊤ : Subalgebra ℂ (ComplexPoly k k)).map ψ) :=
    { m := _, n := n, le := le_card_univ_sdiff L.le hI, field := _, pattern := P',
      isSeedPattern := hP'
      clusterAlgebra_eq := by
        refine map_val_clusterAlgebra_eq_of_surjective (AlgHom.id ℂ (ComplexPoly k k))
          (fun b => ⟨b, rfl⟩) _ (fun t a => ?_) fun s => ?_
        · obtain ⟨f, hf⟩ := h1 t a
          exact ⟨matSpecialization k f, hf.symm⟩
        · obtain ⟨t, a, hta⟩ := hmin {s.1} {s.2} (singleton_nonempty _) (by simp)
          rw [minor_singleton, complexGenericMatrix_apply] at hta
          exact ⟨t, a, hta⟩ }
  refine ⟨C, fun K L' hK hKL => ?_⟩
  obtain ⟨t, a, hta⟩ := hmin K L' hK hKL
  rw [← hta]
  exact C.coe_extCluster_mem t a

end MatClusterStructure

/-! ### A cluster structure on `ℂ[SL_k]` -/

section SLClusterStructure

variable {k m n : ℕ}

/-- If `x ∘ f₁` is algebraically independent, `f₁` and `f₂` are injective and every value of `f₂`
is a value of `f₁`, then `x ∘ f₂` is algebraically independent. -/
theorem _root_.AlgebraicIndependent.comp_of_range_subset {R A ι ι₁ ι₂ : Type*} [CommRing R]
    [CommRing A] [Algebra R A] {x : ι → A} {f₁ : ι₁ → ι} {f₂ : ι₂ → ι}
    (h : AlgebraicIndependent R (x ∘ f₁)) (hf₁ : Function.Injective f₁)
    (hf₂ : Function.Injective f₂) (hr : Set.range f₂ ⊆ Set.range f₁) :
    AlgebraicIndependent R (x ∘ f₂) := by
  let g : ι₂ → ι₁ := fun c => (Equiv.ofInjective f₁ hf₁).symm ⟨f₂ c, hr ⟨c, rfl⟩⟩
  have hg : ∀ c, f₁ (g c) = f₂ c := fun c => Equiv.apply_ofInjective_symm hf₁ _
  rw [show x ∘ f₂ = (x ∘ f₁) ∘ g from funext fun c => by simp [hg]]
  exact h.comp g fun a b hab => hf₂ (by rw [← hg, ← hg, hab])

/-- The positions `I = {λ⁻¹(∅), λ⁻¹(k × k)}` are frozen. -/
theorem RectangleLabelling.forall_mem_pair_none_fullRect (L : RectangleLabelling k (2 * k) m n)
    (hk : 1 ≤ k) :
    ∀ i ∈ ({L.equiv.symm none, L.equiv.symm (fullRect hk)} : Finset (Fin m)), n ≤ (i : ℕ) := by
  intro i hi
  rcases mem_insert.1 hi with rfl | hi
  · exact L.le_symm_none
  · rw [mem_singleton.1 hi]
    exact L.le_symm_fullRect hk

/-- The seed `Tr_I(π(φ(Σ_{k,2k}(λ))))` in `Frac(ℂ[SL_k])`, for `I = {λ⁻¹(∅), λ⁻¹(k × k)}`. -/
noncomputable def slSeed (hk : 1 ≤ k) (L : RectangleLabelling k (2 * k) m n) :
    SeedData (FractionRing (SLCoord k))
      (univ \ {L.equiv.symm none, L.equiv.symm (fullRect hk)}).card n :=
  (specRectanglesSeed ((IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k))).comp
    (slQuot k)) L).trivialize {L.equiv.symm none, L.equiv.symm (fullRect hk)}

/-- The entries of `slSeed hk L` are algebraically independent over `ℂ`. -/
theorem algebraicIndependent_slSeed (hk : 2 ≤ k) (L : RectangleLabelling k (2 * k) m n) :
    AlgebraicIndependent ℂ (slSeed (by omega) L).extCluster := by
  classical
  have hk1 : 1 ≤ k := by omega
  set I₁ : Finset (Fin m) := {L.equiv.symm none}
  set I₂ : Finset (Fin m) := {L.equiv.symm none, L.equiv.symm (fullRect hk1)}
  set x : Fin m → ComplexPoly k k := fun ℓ => matSpecialization k
    (pluckerCoord (complexGenericMatrix k (2 * k)) (rectLabel k (2 * k) (L.equiv ℓ)))
  set ι₁ := restrictionEnumeration n (univ \ I₁)
  set ι₂ := restrictionEnumeration n (univ \ I₂)
  have hx₁ : AlgebraicIndependent ℂ (x ∘ ι₁) :=
    AlgebraicIndependent.of_comp
      (IsScalarTower.toAlgHom ℂ (ComplexPoly k k) (FractionRing (ComplexPoly k k)))
      (isLabeledSeed_matSeed hk L).1.1
  set ℓ₀ := L.equiv.symm (fullRect hk1)
  have hℓ₀ : ℓ₀ ∉ Set.range ι₂ := by
    rw [range_restrictionEnumeration]
    simp [I₂, ℓ₀]
  set f₂ : Fin ((univ \ I₂).card + 1) → Fin m := Fin.snoc ι₂ ℓ₀
  have hf₂ : Function.Injective f₂ :=
    Fin.snoc_injective_iff.2 ⟨restrictionEnumeration_injective n _, hℓ₀⟩
  have hr : Set.range f₂ ⊆ Set.range ι₁ := by
    rintro _ ⟨a, rfl⟩
    rw [range_restrictionEnumeration]
    cases a using Fin.lastCases with
    | last =>
      simp [f₂, ℓ₀, I₁, fullRect]
    | cast a =>
      simp only [f₂, Fin.snoc_castSucc]
      have := restrictionEnumeration_mem n (univ \ I₂) a
      simp only [I₂, I₁, mem_sdiff, mem_univ, mem_insert, mem_singleton, true_and, not_or,
        coe_sdiff, coe_univ, coe_singleton, Set.mem_sdiff, Set.mem_univ,
        Set.mem_singleton_iff] at this ⊢
      exact this.1
  have hx₂ := hx₁.comp_of_range_subset (restrictionEnumeration_injective n _) hf₂ hr
  have hsnoc : x ∘ f₂ = Fin.snoc (x ∘ ι₂) (complexGenericMatrix k k).det := by
    rw [Fin.comp_snoc]
    congr 1
    simp only [x, ℓ₀, Equiv.apply_symm_apply]
    exact matSpecialization_pluckerCoord_rectLabel_fullRect hk1
  rw [hsnoc] at hx₂
  have h := algebraicIndependent_slQuot_comp (f := x ∘ ι₂)
    (fun a => ⟨_, _, matSpecialization_pluckerCoord (card_rectLabel (by omega) _)⟩) hx₂
  exact h.map' (f := IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k)))
    (IsFractionRing.injective _ _)

/-- The entries of `π(φ(Σ_{k,2k}(λ)))` at `λ⁻¹(∅)` and `λ⁻¹(k × k)` are `π(1) = 1` and
`π(det y) = 1`. -/
private theorem specRectanglesSeed_slQuot_extCluster_eq_one (hk : 1 ≤ k)
    (L : RectangleLabelling k (2 * k) m n) :
    ∀ i ∈ ({L.equiv.symm none, L.equiv.symm (fullRect hk)} : Finset (Fin m)),
      (specRectanglesSeed ((IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k))).comp
        (slQuot k)) L).extCluster i = 1 := by
  intro i hi
  rcases mem_insert.1 hi with rfl | hi
  · exact specRectanglesSeed_extCluster_symm_none _ L
  · change (IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k))).comp
      (slQuot k) _ = 1
    rw [mem_singleton.1 hi, Equiv.apply_symm_apply,
      matSpecialization_pluckerCoord_rectLabel_fullRect hk]
    change algebraMap (SLCoord k) _ (slQuot k _) = 1
    rw [slQuot_det_complexGenericMatrix, map_one]

/-- For `k ≥ 2`, a `1 × 1` minor is not the determinant. -/
private theorem not_singleton_eq_univ_and (hk : 2 ≤ k) (r c : Fin k) :
    ¬(({r} : Finset (Fin k)) = univ ∧ ({c} : Finset (Fin k)) = univ) := fun h => by
  have := congrArg card h.1
  rw [card_singleton, card_univ, Fintype.card_fin] at this
  omega

/-- **A cluster structure on `ℂ[SL_k]`**. Let `k ≥ 2` and `ℂ[SL_k] = ℂ[y]/⟨det y - 1⟩` with
quotient map `π`. Then `ℂ[SL_k]`, read in its fraction field, has a cluster structure, in a
subfield of that fraction field, whose cluster and coefficient variables include `π(Δ_{K,L}(y))`
for every minor `Δ_{K,L}(y)` other than `det y` (`K, L ⊆ [1, k]` nonempty with `|K| = |L|`). -/
@[cluster_algebras "thm_sl_cluster_structure"]
theorem exists_clusterStructure_slCoord (hk : 2 ≤ k) :
    ∃ C : ClusterStructure ℂ ((⊤ : Subalgebra ℂ (SLCoord k)).map
        (IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k)))),
      ∀ K L : Finset (Fin k), K.Nonempty → K.card = L.card → ¬(K = univ ∧ L = univ) →
        algebraMap (SLCoord k) (FractionRing (SLCoord k))
            (slQuot k (minor (complexGenericMatrix k k) K L)) ∈
          C.clusterVariables ∪ C.coefficientVariables := by
  obtain ⟨m, n, ⟨L⟩⟩ := exists_rectangleLabelling k (2 * k)
  have hk1 : 1 ≤ k := by omega
  set ψ := (IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k))).comp (slQuot k)
  have hI := L.forall_mem_pair_none_fullRect hk1
  obtain ⟨P', hP', h1, h2⟩ := exists_isSeedPattern_specRectanglesSeed hk L ψ hI
    (specRectanglesSeed_slQuot_extCluster_eq_one hk1 L)
    (IntermediateField.adjoin ℂ (Set.range (slSeed hk1 L).extCluster))
    ⟨(slSeed hk1 L).adjoinSelf ℂ, (isLabeledSeed_adjoinSelf_iff ℂ _ _).2
      ⟨algebraicIndependent_slSeed hk L,
        (isLabeledSeed_rectanglesSeed (by omega) (by omega) L).2.trivialize hI⟩, rfl⟩
  have hmin : ∀ K L' : Finset (Fin k), K.Nonempty → K.card = L'.card →
      ¬(K = univ ∧ L' = univ) →
      ∃ t a, ((P' t).extCluster a : FractionRing (SLCoord k)) =
        algebraMap _ _ (slQuot k (minor (complexGenericMatrix k k) K L')) := by
    intro K L' hK hKL hKL'
    obtain ⟨J, ⟨hJ, -, hJK, hJL⟩, -⟩ :=
      existsUnique_matRowSet_matColSet hKL (card_pos.1 (hKL ▸ card_pos.2 hK))
    rcases h2 J hJ with ⟨t, a, hta⟩ | ⟨i, hi, hiJ⟩
    · refine ⟨t, a, ?_⟩
      rw [hta, matSpecialization_pluckerCoord hJ, hJK, hJL]
      rfl
    · have h := congrArg (matSpecialization k) hiJ
      rw [matSpecialization_pluckerCoord hJ, hJK, hJL] at h
      rcases mem_insert.1 hi with rfl | hi
      · rw [Equiv.apply_symm_apply, matSpecialization_pluckerCoord_rectLabel_none] at h
        exact absurd h (minor_complexGenericMatrix_ne_one hKL hK)
      · rw [mem_singleton.1 hi, Equiv.apply_symm_apply,
          matSpecialization_pluckerCoord_rectLabel_fullRect hk1] at h
        exact absurd h (minor_complexGenericMatrix_ne_det hKL hKL')
  let C : ClusterStructure ℂ ((⊤ : Subalgebra ℂ (SLCoord k)).map
      (IsScalarTower.toAlgHom ℂ (SLCoord k) (FractionRing (SLCoord k)))) :=
    { m := _, n := n, le := le_card_univ_sdiff L.le hI, field := _, pattern := P',
      isSeedPattern := hP'
      clusterAlgebra_eq := by
        refine map_val_clusterAlgebra_eq_of_surjective (slQuot k)
          (Ideal.Quotient.mkₐ_surjective ℂ _) _ (fun t a => ?_) fun s => ?_
        · obtain ⟨f, hf⟩ := h1 t a
          exact ⟨matSpecialization k f, hf.symm⟩
        · obtain ⟨t, a, hta⟩ := hmin {s.1} {s.2} (singleton_nonempty _) (by simp)
            (not_singleton_eq_univ_and hk s.1 s.2)
          rw [minor_singleton, complexGenericMatrix_apply] at hta
          exact ⟨t, a, hta⟩ }
  refine ⟨C, fun K L' hK hKL hKL' => ?_⟩
  obtain ⟨t, a, hta⟩ := hmin K L' hK hKL hKL'
  rw [← hta]
  exact C.coe_extCluster_mem t a

end SLClusterStructure

end ClusterAlgebras
