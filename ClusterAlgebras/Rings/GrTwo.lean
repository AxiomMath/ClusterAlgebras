/-!
# For `a = 2` every Plücker coordinate is a cluster or frozen variable

Let `b ≥ 4`, let `λ` be a rectangle labelling for `(2, b)`, and let `Σ` be a seed pattern over
`ℂ` through the rectangles seed `Σ_{2,b}(λ)` at `t₀`, in the field generated by its entries.
Then every Plücker coordinate `P_J`, `J ⊆ [1, b]` with two elements, is a cluster variable or a
frozen variable of `Σ`.

This is the type `A_n` pattern of Chapter 5, with ground field `ℂ` and `n = b - 3`. The
rectangles quiver `Q_{2,b}` is the quiver of the fan `T_b` at the last vertex, by
`v ↦ J(v) mod b` (`ClusterAlgebras.twoFanIso`). So `λ_5 = J ∘ λ|_{[1,n]}` numbers the diagonals
of `T_b`, giving a labelled triangulation `(T_b, λ_5)`, and with `λ̂_5` its extended labelling
the map `π = λ̂_5⁻¹ ∘ J ∘ λ` is a permutation of `[1, m]` preserving `[1, n]` under which
`Σ_{2,b}(λ) = Σ(T_b, λ_5)^π`: the entries agree as `P_{J(v) mod b} = P_{J(v)}`, and the
matrices agree as `J` is a quiver isomorphism. Mutation commutes with reindexing along `π`, so
every seed of the type `A` pattern through `Σ(T_b, λ_5)`, reindexed by `π`, is a seed of `Σ`
read in `ℂ(z)`. Every two-element subset of `[1, b]` is a segment of the `b`-gon, hence a segment
of some triangulation `T` (a diagonal extends to a triangulation), and `T` is the triangulation
of some seed of the type `A` pattern, which has `P_σ` among its entries.

## Main definitions

* `ClusterAlgebras.RectangleLabelling.twoFanTriangulation`: the labelled triangulation
  `(T_b, J ∘ λ|_{[1,n]})` of a rectangle labelling `λ` for `(2, b)`.

## Main results

* `ClusterAlgebras.RectangleLabelling.exists_rectanglesSeed_eq_reindex`:
  `Σ_{2,b}(λ) = Σ(T_b, λ_5)^π` for a bijective reindexing map `π`.
* `ClusterAlgebras.RectangleLabelling.exists_extCluster_eq_pluckerCoord_of_card_eq_two`: every
  `P_J`, `|J| = 2`, is an entry of some seed of `Σ`.
* `ClusterAlgebras.RectangleLabelling.algebraMap_pluckerCoord_mem_of_card_eq_two`: every `P_J`,
  `|J| = 2`, is a cluster variable or a frozen variable of `Σ`.

## Implementation notes

* **The size of the polygon.** FWZ's `b ≥ 4` is written `b = n + 3`. The hypothesis
  `n ≥ 1` is not needed: for `n = 0` every pair of vertices of the triangle is a side, a
  segment of its unique triangulation `∅`.
* **The ranks.** A rectangle labelling for `(2, n + 3)` has `m = 2n + 3` indices of which `n`
  are mutable (`RectangleLabelling.m_eq`, `RectangleLabelling.n_eq`). The main results take
  `m` and the rank as variables, which `λ` determines, so that they apply to every rectangle
  labelling as it is given.
* **Ambient field.** The field of the seed pattern is the subfield of `ℂ(z)` generated by the
  entries of `Σ_{2,b}(λ)`, and the type `A` pattern lives in the Plücker field `𝓕ₙ`; both are
  intermediate fields of `ℂ(z) = FractionRing (ComplexPoly 2 (n + 3))`, which is Chapter 5's
  `TypeA.PluckerAmbient ℂ n`. The comparison is made there, after reading every seed in `ℂ(z)`;
  this replaces FWZ's appeal to pattern relabelling and uniqueness of patterns by the
  underlying fact that reindexing along a permutation commutes with mutation.
* **Vertices.** The column `x : Fin (n + 3)` is the polygon vertex `(x : ZMod (n + 3))`, the
  convention of `ClusterAlgebras.segmentPlucker`; so `P_{{x, y}}` is `P_σ` for
  `σ = s(x, y)`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

open TypeA

section GrTwo

variable {n m : ℕ}

/-- A segment of a triangulation of the `(n + 3)`-gon is a segment: its diagonals are, and so are
the sides of the polygon. -/
private theorem isSegment_of_mem_segments {T : Finset (Sym2 (ZMod (n + 3)))}
    (hT : IsTriangulation T) {σ : Sym2 (ZMod (n + 3))} (hσ : σ ∈ segments T) : IsSegment σ := by
  rcases mem_segments.1 hσ with h | ⟨i, rfl⟩
  · exact (hT.isDiagonal σ h).isSegment
  · have : Fact (1 < n + 3) := ⟨by omega⟩
    exact isSegment_mk_of_ne (left_ne_add.2 one_ne_zero)

/-- **Every segment of the `(n + 3)`-gon is a segment of some triangulation**: a side is a
segment of every triangulation, and a diagonal extends to a triangulation. -/
private theorem exists_isTriangulation_mem_segments {σ : Sym2 (ZMod (n + 3))}
    (hσ : IsSegment σ) : ∃ T, IsTriangulation T ∧ σ ∈ segments T := by
  by_cases hs : IsSide σ
  · exact ⟨_, isTriangulation_lastFanTriangulation n, mem_segments.2 (Or.inr hs)⟩
  obtain ⟨T, hT, hσT⟩ := exists_isTriangulation_superset (S := {σ})
    (fun e he => Finset.mem_singleton.1 he ▸ ⟨hσ, hs⟩)
    (fun e he f hf =>
      Finset.mem_singleton.1 he ▸ Finset.mem_singleton.1 hf ▸ TypeA.not_cross_self σ)
  exact ⟨T, hT, mem_segments.2 (Or.inl (hσT (Finset.mem_singleton_self σ)))⟩

/-- Over `ℂ`, Chapter 5's `P_σ ∈ ℂ(z)` is the image of the Plücker coordinate of the segment `σ`
of the generic matrix `z`. -/
theorem pluckerFn_complex_eq_algebraMap (σ : Sym2 (ZMod (n + 3))) :
    pluckerFn ℂ n σ = algebraMap (ComplexPoly 2 (n + 3)) (FractionRing (ComplexPoly 2 (n + 3)))
      (segmentPlucker (complexGenericMatrix 2 (n + 3)) σ) := by
  rw [pluckerFn_eq_algebraMap, complexGenericMatrix_eq_mvPolynomialX]

/-- The labels `J(λ(j)) mod b`, `j ∈ [1, n]`, of the mutable rectangles are the diagonals of the
fan `T_b`. -/
private theorem image_twoFanSegment (L : RectangleLabelling 2 (n + 3) m n) :
    Finset.univ.image (fun j : Fin n => twoFanSegment n (L.equiv (Fin.castLE L.le j))) =
      lastFanTriangulation (n + 3) := by
  ext e
  simp only [Finset.mem_image, Finset.mem_univ, true_and]
  refine ⟨?_, fun he => ?_⟩
  · rintro ⟨j, rfl⟩
    refine (twoFanSegment_mem_lastFanTriangulation_iff _).2 fun h => ?_
    have := (L.frozen_iff _).1 h
    simp only [Fin.val_castLE] at this
    omega
  obtain ⟨v, rfl⟩ := exists_twoFanSegment_eq (mem_segments.2 (Or.inl he))
  have hv := (twoFanSegment_mem_lastFanTriangulation_iff v).1 he
  have hlt : ((L.equiv.symm v : Fin m) : ℕ) < n := by
    by_contra h
    exact hv (by simpa using (L.frozen_iff (L.equiv.symm v)).2 (not_lt.1 h))
  exact ⟨⟨_, hlt⟩, by simp [Fin.castLE]⟩

/-- The **labelled triangulation `(T_b, J ∘ λ|_{[1,n]})`** of a rectangle labelling `λ` for
`(2, b)`, `b = n + 3`: the diagonal with label `j ∈ [1, n]` is `J(λ(j)) mod b`. Its triangulation
is the fan `T_b` (`RectangleLabelling.triangulation_twoFanTriangulation`). -/
def RectangleLabelling.twoFanTriangulation (L : RectangleLabelling 2 (n + 3) m n) :
    LabelledTriangulation n where
  label j := twoFanSegment n (L.equiv (Fin.castLE L.le j))
  injective _ _ h := Fin.castLE_injective L.le (L.equiv.injective (twoFanSegment_injective h))
  isTriangulation := by
    rw [image_twoFanSegment]
    exact isTriangulation_lastFanTriangulation n

/-- The diagonal of `(T_b, J ∘ λ|_{[1,n]})` with label `j` is `J(λ(j)) mod b`. -/
@[simp]
theorem RectangleLabelling.twoFanTriangulation_label (L : RectangleLabelling 2 (n + 3) m n)
    (j : Fin n) : L.twoFanTriangulation.label j = twoFanSegment n (L.equiv (Fin.castLE L.le j)) :=
  rfl

/-- The triangulation of `(T_b, J ∘ λ|_{[1,n]})` is the fan `T_b`. -/
theorem RectangleLabelling.triangulation_twoFanTriangulation
    (L : RectangleLabelling 2 (n + 3) m n) :
    L.twoFanTriangulation.triangulation = lastFanTriangulation (n + 3) :=
  image_twoFanSegment L

/-- **The rectangles seed is a reindexed Plücker seed.** For a rectangle labelling `λ` for
`(2, b)`, `b = n + 3`, there is a bijective reindexing map `π` (namely `π = λ̂_5⁻¹ ∘ J ∘ λ`, with
`λ̂_5` the extended labelling of `(T_b, λ_5) = (T_b, J ∘ λ|_{[1,n]})`) such that `Σ_{2,b}(λ)` is
the reindexing `Σ(T_b, λ_5)^π`, read in `ℂ(z)`. -/
theorem RectangleLabelling.exists_rectanglesSeed_eq_reindex
    (L : RectangleLabelling 2 (n + 3) (2 * n + 3) n) :
    ∃ π : ReindexingMap (2 * n + 3) n (2 * n + 3) n, Function.Bijective π ∧
      rectanglesSeed L = ((pluckerSeed ℂ L.twoFanTriangulation).map
        (IntermediateField.val (pluckerField ℂ n))).reindex L.le π := by
  set LT := L.twoFanTriangulation
  obtain ⟨Λ, hΛ, -, -⟩ := LT.exists_labelling
  have hT := L.triangulation_twoFanTriangulation
  have hseg : ∀ i, twoFanSegment n (L.equiv i) ∈ segments LT.triangulation := fun i => by
    rw [hT]
    exact twoFanSegment_mem_segments _
  let f : Fin (2 * n + 3) → Fin (2 * n + 3) := fun i => Λ.equiv.symm ⟨_, hseg i⟩
  have hf : ∀ i, LT.extLabel (f i) = twoFanSegment n (L.equiv i) := fun i => by
    rw [← hΛ]
    simp [f]
  have hfinj : Function.Injective f := fun i i' h => by
    have := congrArg LT.extLabel h
    rw [hf, hf] at this
    exact L.equiv.injective (twoFanSegment_injective this)
  let π : ReindexingMap (2 * n + 3) n (2 * n + 3) n := ⟨f, hfinj, fun i hi => by
    by_contra h
    have h1 := (Λ.mem_frozen_iff (f i)).2 (not_lt.1 h)
    simp only [polygonQuiver, Finset.mem_filter, Finset.mem_univ, true_and, hΛ, hf,
      isSide_twoFanSegment_iff, L.frozen_iff] at h1
    omega⟩
  have hπ : ∀ i, LT.extLabel (π i) = twoFanSegment n (L.equiv i) := hf
  refine ⟨π, Finite.injective_iff_bijective.1 hfinj, SeedData.ext ?_ ?_⟩
  · funext ℓ
    simp only [rectanglesSeed, rectanglesSeedShift, cyclicShift_zero, SeedData.reindex_extCluster,
      SeedData.map_extCluster, Function.comp_apply, pluckerSeed, IntermediateField.coe_val]
    have hσ : IsSegment (LT.extLabel (π ℓ)) := by
      rw [hπ]
      exact isSegment_of_mem_segments (isTriangulation_lastFanTriangulation n)
        (twoFanSegment_mem_segments _)
    rw [coe_pluckerVar ℂ n hσ, pluckerFn_complex_eq_algebraMap, hπ,
      segmentPlucker_twoFanSegment]
  · ext ℓ ℓ'
    simp only [rectanglesSeed, rectanglesSeedShift, SeedData.reindex_extExchangeMatrix,
      SeedData.map_extExchangeMatrix, pluckerSeed, matrixReindex, Matrix.submatrix_apply,
      Matrix.of_apply, LabelledTriangulation.extMatrix]
    rw [ReindexingMap.castLE_col, hπ, hπ, hT, signedCount, signedCount,
      polygonArrows_twoFanSegment, polygonArrows_twoFanSegment]

/-- **For `a = 2` every Plücker coordinate is an entry of a seed of the pattern.** Let `λ` be a
rectangle labelling for `(2, b)`, `b = n + 3`, and `Σ` a seed pattern over `ℂ` through
`Σ_{2,b}(λ)` at `t₀`, in the field generated by its entries. Then every Plücker coordinate
`P_J`, `J ⊆ [1, b]` with two elements, read in `ℂ(z)`, is an entry of `Σ(t)` for some `t`. -/
@[cluster_algebras "lem_gr2_plucker_variables"]
theorem RectangleLabelling.exists_extCluster_eq_pluckerCoord_of_card_eq_two {k : ℕ}
    (L : RectangleLabelling 2 (n + 3) m k)
    {P : RegularTree k →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m k}
    (hP : IsSeedPattern ℂ L.le P) {t₀ : RegularTree k}
    (h₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ) {J : Finset (Fin (n + 3))}
    (hJ : J.card = 2) :
    ∃ t i, ((P t).extCluster i : FractionRing (ComplexPoly 2 (n + 3))) =
      algebraMap (ComplexPoly 2 (n + 3)) (FractionRing (ComplexPoly 2 (n + 3)))
        (pluckerCoord (complexGenericMatrix 2 (n + 3)) J) := by
  obtain rfl : n = k := by simpa using L.n_eq.symm
  obtain rfl : m = 2 * n + 3 := by have := L.m_eq; omega
  obtain ⟨π, hπ, hseed⟩ := L.exists_rectanglesSeed_eq_reindex
  obtain ⟨x, y, hxy, rfl⟩ := Finset.card_eq_two.1 hJ
  set σ : Sym2 (ZMod (n + 3)) := s(((x : ℕ) : ZMod (n + 3)), ((y : ℕ) : ZMod (n + 3)))
  have hvr : ∀ z : Fin (n + 3), vertexRep ((z : ℕ) : ZMod (n + 3)) = z := fun z =>
    Fin.ext (ZMod.val_natCast_of_lt z.isLt)
  have hσ : IsSegment σ := isSegment_mk_of_ne fun h => by
    have := congrArg vertexRep h
    rw [hvr, hvr] at this
    exact hxy this
  have hval : pluckerFn ℂ n σ = algebraMap (ComplexPoly 2 (n + 3))
      (FractionRing (ComplexPoly 2 (n + 3)))
        (pluckerCoord (complexGenericMatrix 2 (n + 3)) {x, y}) := by
    rw [pluckerFn_complex_eq_algebraMap, segmentPlucker_mk, hvr, hvr]
  -- A seed of the type `A` pattern through `Σ(T_b, λ_5)` with `P_σ` among its entries.
  obtain ⟨T, hT, hσT⟩ := exists_isTriangulation_mem_segments hσ
  obtain ⟨P₅, hP₅, h₅⟩ := exists_isSeedPattern_pluckerSeed ℂ L.twoFanTriangulation t₀
  obtain ⟨t₅, LT, h₅', rfl⟩ :=
    TypeA.IsSeedPattern.exists_pluckerSeed_triangulation_eq hP₅ h₅ hT
  obtain ⟨Λ, hΛ, -, -⟩ := LT.exists_labelling
  obtain ⟨i, hi⟩ : ∃ i, LT.extLabel i = σ :=
    ⟨Λ.equiv.symm ⟨σ, hσT⟩, by simp [← hΛ]⟩
  obtain ⟨s, hs⟩ :=
    IsSeedPattern.exists_seedMutationSeq_eq (le_two_mul_add_three n) hP₅ t₀ t₅
  -- The corresponding seed of `Σ`, along the directions `π⁻¹(s)`.
  have hcol : Function.Surjective (π.col L.le) := Finite.injective_iff_surjective.1
    fun q q' h => Fin.castLE_injective L.le (hπ.1 (by
      simpa only [ReindexingMap.castLE_col] using congrArg (Fin.castLE L.le) h))
  obtain ⟨s', hmap⟩ := hcol.list_map s
  obtain ⟨t, ht⟩ := hP.seedMutationSeq_mem_range L.le t₀ s'
  have key : (P t).map (IntermediateField.val _) =
      ((P₅ t₅).map (IntermediateField.val (pluckerField ℂ n))).reindex L.le π := by
    rw [ht, seedMutationSeq_map, h₀, SeedData.map_val_adjoinSelf, hseed,
      seedMutationSeq_reindex (le_two_mul_add_three n) L.le _
        (ReindexingMap.isClosedFor_of_surjective hπ.2 _ _), hmap, ← h₅, ← seedMutationSeq_map,
      ← hs]
  obtain ⟨i', rfl⟩ := hπ.2 i
  refine ⟨t, i', ?_⟩
  have := congrFun (congrArg SeedData.extCluster key) i'
  simp only [SeedData.map_extCluster, SeedData.reindex_extCluster, Function.comp_apply,
    IntermediateField.coe_val] at this
  rw [this, h₅']
  simp only [pluckerSeed]
  rw [hi, coe_pluckerVar ℂ n hσ, hval]

/-- Let `λ` be a rectangle labelling for `(2, b)`, `b = n + 3`, and `Σ` a seed pattern over `ℂ`
through `Σ_{2,b}(λ)` at `t₀`, in the field generated by its entries. Then every Plücker
coordinate `P_J`, `J ⊆ [1, b]` with two elements, read in `ℂ(z)`, is a cluster variable or a
frozen variable of `Σ`. -/
@[cluster_algebras "lem_gr2_plucker_variables"]
theorem RectangleLabelling.algebraMap_pluckerCoord_mem_of_card_eq_two {k : ℕ}
    (L : RectangleLabelling 2 (n + 3) m k)
    {P : RegularTree k →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m k}
    (hP : IsSeedPattern ℂ L.le P) {t₀ : RegularTree k}
    (h₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ) {J : Finset (Fin (n + 3))}
    (hJ : J.card = 2) :
    algebraMap (ComplexPoly 2 (n + 3)) (FractionRing (ComplexPoly 2 (n + 3)))
        (pluckerCoord (complexGenericMatrix 2 (n + 3)) J) ∈
      ((↑) : _ → FractionRing (ComplexPoly 2 (n + 3))) ''
        (patternClusterVariables L.le P ∪ ⋃ t, frozenVariables (P t)) := by
  obtain ⟨t, i, hi⟩ := L.exists_extCluster_eq_pluckerCoord_of_card_eq_two hP h₀ hJ
  refine ⟨(P t).extCluster i, ?_, hi⟩
  by_cases hik : (i : ℕ) < k
  · exact Or.inl (Set.mem_iUnion.2 ⟨t, ⟨⟨i, hik⟩, rfl⟩⟩)
  · exact Or.inr (Set.mem_iUnion.2 ⟨t, ⟨i, not_lt.1 hik, rfl⟩⟩)

end GrTwo

end ClusterAlgebras
