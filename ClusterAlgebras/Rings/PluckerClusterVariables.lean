/-!
# Every Plücker coordinate is a cluster or frozen variable

Let `2 ≤ a ≤ b - 2`, let `λ` be a rectangle labelling for `(a, b)`, and let `Σ` be a seed
pattern over `ℂ` through the rectangles seed `Σ_{a,b}(λ)` at `t₀`, in the field generated by
its entries. Then every Plücker coordinate `P_J`, `J ⊆ [1, b]` with `a` elements, is a cluster
variable or a frozen variable of `Σ`; in fact it is an entry of some seed `Σ(t)`.

The proof is by induction on `a`, the case `a = 2` being the type `A` analysis of
`ClusterAlgebras.RectangleLabelling.exists_extCluster_eq_pluckerCoord_of_card_eq_two`. For
`a ≥ 3`, take a rectangle labelling `λ'` for `(a - 1, b - 1)` and a seed pattern `Π` through
`Σ_{a-1,b-1}(λ')`. By induction every `P_I(z')` is an entry of a seed of `Π`; the Muir embedding
`ι` sends it to `P_{I ∪ {b}}(z)`, and `Π` is a seed subpattern of `Σ` along `ι`, so every seed of
`Π`, read along `ι`, is a reindexed seed of `Σ`. Hence every `P_K` with `b ∈ K` is an entry of a
seed of `Σ`. For an arbitrary `J`, choose `e ∈ J` and `j = b - e`, so that `K = (J + j) mod b`
contains `b`. If `P_K` is an entry of `μ_s(Σ_{a,b}(λ))`, then applying the rotation `ρ^j`, a
field automorphism of `ℂ(z)` commuting with mutation, `P_J = ρ^j(P_K)` is an entry of
`μ_s(Σ^{-j}_{a,b}(λ))`. The cyclic shift mutation sequence
(`ClusterAlgebras.rectanglesSeedShift_cyclicShift_mutation`), applied `j` times, shows that
`Σ^{-j}_{a,b}(λ)` is a mutation of `Σ_{a,b}(λ)` up to a permutation of the frozen indices, and
such a permutation commutes with mutation; so `P_J` is an entry of a mutation of `Σ_{a,b}(λ)`,
which is a seed of `Σ`.

## Main definitions

* `ClusterAlgebras.rotationFieldEquiv`: the rotation `ρ^j`, extended to an automorphism of `ℂ(z)`.

## Main results

* `ClusterAlgebras.exists_rectangleLabelling`: every `V_{a,b}` has a rectangle labelling.
* `ClusterAlgebras.RectangleLabelling.exists_map_eq_cyclicShiftOrder`: the mutable vertices in
  the order `cyclicShiftOrder a b` are the image of a sequence of mutable indices.
* `ClusterAlgebras.rectanglesSeedShift_map_rotation`: `ρ^j(Σ^i_{a,b}(λ)) = Σ^{i-j}_{a,b}(λ)`.
* `ClusterAlgebras.RectangleLabelling.exists_extCluster_eq_pluckerCoord`: every `P_J`, `|J| = a`,
  is an entry of some seed of `Σ`.
* `ClusterAlgebras.RectangleLabelling.algebraMap_pluckerCoord_mem`: every `P_J`, `|J| = a`, is a
  cluster variable or a frozen variable of `Σ`.

## Implementation notes

* **Ambient fields.** The seeds of `Σ` live in the subfield `F` of `ℂ(z)` generated by the
  entries of `Σ_{a,b}(λ)`, those of `Π` in the corresponding subfield of `ℂ(z')`. All comparisons
  are made in `ℂ(z)`, reading the seeds of `Σ` through the inclusion `F → ℂ(z)`
  (`SeedData.map`): there a seed of `Σ` is a mutation of `Σ_{a,b}(λ)` and conversely, and the
  rotation acts as a field automorphism. This replaces FWZ's transport of seed mutation
  along `ρ^j`.
* **The rotation.** With `0`-based columns, `ρ^j(P_J) = P_{(J - j) mod b}`
  (`rotationEquiv_zpow_pluckerCoord`), and the cyclic shift mutation sequence takes `Σ^i` to
  `Σ^{i-1}`; so the shifts reached from `Σ^0` are the `Σ^{-j}`, `j ≥ 0`, and `P_J` is reached
  from `P_K`, `K = (J + j) mod b`, by `ρ^j`.
* **The Muir embedding on the rectangles seed.**
  `ClusterAlgebras.exists_algHom_adjoin_pluckerCoord` gives `ι` on the subfield of `ℂ(z')`
  generated by all `P_I(z')`, `|I| = a - 1`; it is restricted to the subfield generated by the
  entries of `Σ_{a-1,b-1}(λ')`, which is contained in it as every label has `a - 1` elements.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras.
  Chapter 6*][FWZ]
-/

@[expose] public section

namespace ClusterAlgebras

variable {a b m n : ℕ}

/-! ### Rectangle labellings -/

section Labelling

/-- The label `J(∅) = [b - a + 1, b]` of the empty rectangle has `a` elements, for `a ≤ b`. -/
theorem card_rectLabel_none (hab : a ≤ b) : (rectLabel a b none).card = a := by
  have h : (rectLabel a b none).map Fin.valEmbedding = Finset.Ico (b - a) b := by
    ext c
    simp only [rectLabel, Finset.mem_map, Finset.mem_filter, Finset.mem_univ, true_and,
      Fin.valEmbedding_apply, Finset.mem_Ico]
    exact ⟨fun ⟨x, hx, h⟩ => by subst h; exact ⟨hx, x.isLt⟩, fun ⟨h1, h2⟩ => ⟨⟨c, h2⟩, h1, rfl⟩⟩
  rw [← Finset.card_map Fin.valEmbedding, h, Nat.card_Ico]
  omega

/-- Every label `J(v)` of a vertex of `Q_{a,b}` has `a` elements, for `a ≤ b`. -/
theorem card_rectLabel (hab : a ≤ b) (v : RectVertex a b) : (rectLabel a b v).card = a := by
  rcases v with _ | pq
  · exact card_rectLabel_none hab
  · exact card_rectLabel_some pq

/-- **Every `V_{a,b}` has a rectangle labelling**: number the mutable rectangles first and the
frozen ones after them. -/
theorem exists_rectangleLabelling (a b : ℕ) :
    ∃ m n, Nonempty (RectangleLabelling a b m n) := by
  let e₁ := Fintype.equivFin {v : RectVertex a b // ¬RectFrozen a b v}
  let e₂ := Fintype.equivFin {v : RectVertex a b // RectFrozen a b v}
  let e : Fin (Fintype.card {v : RectVertex a b // ¬RectFrozen a b v} +
      Fintype.card {v : RectVertex a b // RectFrozen a b v}) ≃ RectVertex a b :=
    finSumFinEquiv.symm.trans ((e₁.symm.sumCongr e₂.symm).trans
      ((Equiv.sumComm _ _).trans (Equiv.sumCompl (RectFrozen a b))))
  refine ⟨_, _, ⟨{ equiv := e, le := Nat.le_add_right _ _, frozen_iff := fun i => ?_ }⟩⟩
  induction i using Fin.addCases with
  | left j =>
    simp only [e, Equiv.trans_apply, finSumFinEquiv_symm_apply_castAdd, Equiv.sumCongr_apply,
      Sum.map_inl, Equiv.sumComm_apply, Sum.swap_inl, Equiv.sumCompl_apply_inr, Fin.val_castAdd]
    exact iff_of_false (e₁.symm j).2 (by omega)
  | right j =>
    simp only [e, Equiv.trans_apply, finSumFinEquiv_symm_apply_natAdd, Equiv.sumCongr_apply,
      Sum.map_inr, Equiv.sumComm_apply, Sum.swap_inr, Equiv.sumCompl_apply_inl, Fin.val_natAdd]
    exact iff_of_true (e₂.symm j).2 (by omega)

/-- **The cyclic shift order is a sequence of mutable indices**: for a rectangle labelling `λ`
there is a sequence `s` of mutable indices with `λ(s) = cyclicShiftOrder a b`. -/
theorem RectangleLabelling.exists_map_eq_cyclicShiftOrder (L : RectangleLabelling a b m n) :
    ∃ s : List (Fin n), s.map (fun k => L.equiv (Fin.castLE L.le k)) = cyclicShiftOrder a b := by
  have key : ∀ l : List (RectVertex a b), (∀ v ∈ l, ¬RectFrozen a b v) →
      ∃ s : List (Fin n), s.map (fun k => L.equiv (Fin.castLE L.le k)) = l := by
    intro l hl
    induction l with
    | nil => exact ⟨[], rfl⟩
    | cons v l ih =>
      obtain ⟨s, hs⟩ := ih fun w hw => hl w (List.mem_cons_of_mem _ hw)
      have hv : ((L.equiv.symm v : Fin m) : ℕ) < n := by
        by_contra h
        exact hl v List.mem_cons_self
          (by simpa using (L.frozen_iff (L.equiv.symm v)).2 (not_lt.1 h))
      refine ⟨⟨_, hv⟩ :: s, ?_⟩
      rw [List.map_cons, hs]
      exact congrArg (· :: l) ((congrArg L.equiv (Fin.ext rfl)).trans (L.equiv.apply_symm_apply v))
  refine key _ fun v hv => ?_
  simp only [cyclicShiftOrder, List.mem_flatMap, List.mem_filter, List.mem_reverse,
    List.mem_finRange, true_and, List.mem_map, decide_eq_true_eq] at hv
  obtain ⟨p, hp, q, hq, rfl⟩ := hv
  simp only [RectFrozen, not_or]
  omega

end Labelling

/-! ### Seeds of a pattern through `S.adjoinSelf K`, read in the ambient field -/

section Ambient

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- Every entry of a mutation of `S` is an entry of a seed of a seed pattern through
`S.adjoinSelf K`, read in the ambient field. -/
theorem IsSeedPattern.exists_coe_extCluster_eq_seedMutationSeq (hmn : n ≤ m)
    {S : SeedData F m n}
    {P : RegularTree n → SeedData (IntermediateField.adjoin K (Set.range S.extCluster)) m n}
    (hP : IsSeedPattern K hmn P) {t₀ : RegularTree n} (h₀ : P t₀ = S.adjoinSelf K)
    (s : List (Fin n)) (i : Fin m) :
    ∃ t i', ((P t).extCluster i' : F) = (seedMutationSeq hmn S s).extCluster i := by
  obtain ⟨t, ht⟩ := hP.seedMutationSeq_mem_range hmn t₀ s
  have key : (P t).map (IntermediateField.val _) = seedMutationSeq hmn S s := by
    rw [ht, seedMutationSeq_map, h₀, SeedData.map_val_adjoinSelf]
  exact ⟨t, i, congrFun (congrArg SeedData.extCluster key) i⟩

/-- Every entry of a seed of a seed pattern through `S.adjoinSelf K`, read in the ambient field,
is an entry of a mutation of `S`. -/
theorem IsSeedPattern.exists_seedMutationSeq_extCluster_eq_coe (hmn : n ≤ m)
    {S : SeedData F m n}
    {P : RegularTree n → SeedData (IntermediateField.adjoin K (Set.range S.extCluster)) m n}
    (hP : IsSeedPattern K hmn P) {t₀ : RegularTree n} (h₀ : P t₀ = S.adjoinSelf K)
    (t : RegularTree n) (i : Fin m) :
    ∃ s, ((P t).extCluster i : F) = (seedMutationSeq hmn S s).extCluster i := by
  obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_eq hmn t₀ t
  have key : (P t).map (IntermediateField.val _) = seedMutationSeq hmn S s := by
    rw [hs, seedMutationSeq_map, h₀, SeedData.map_val_adjoinSelf]
  exact ⟨s, congrFun (congrArg SeedData.extCluster key) i⟩

end Ambient

/-! ### The rotation and the cyclic shifts -/

section Rotation

/-- The rotation `ρ^j`, extended to the field `ℂ(z)`. -/
noncomputable abbrev rotationFieldEquiv (a b : ℕ) (j : ℤ) :
    FractionRing (ComplexPoly a b) ≃ₐ[ℂ] FractionRing (ComplexPoly a b) :=
  IsFractionRing.fieldEquivOfAlgEquiv ℂ _ _ (rotationEquiv a b ^ j)

/-- **The rotation shifts the cyclic shifts**: `ρ^j(Σ^i_{a,b}(λ)) = Σ^{i-j}_{a,b}(λ)`, with `ρ^j`
applied entrywise in `ℂ(z)`. -/
theorem rectanglesSeedShift_map_rotation (L : RectangleLabelling a b m n) (i j : ℤ) :
    (rectanglesSeedShift L i).map (rotationFieldEquiv a b j) = rectanglesSeedShift L (i - j) := by
  refine SeedData.ext (funext fun ℓ => ?_) rfl
  simp only [SeedData.map_extCluster, Function.comp_apply, rectanglesSeedShift]
  rw [IsFractionRing.fieldEquivOfAlgEquiv_algebraMap, rotationEquiv_zpow_pluckerCoord,
    cyclicShift_cyclicShift, neg_add_eq_sub]

/-- The cyclic shift `(e + j) mod b` of a column `e` with `e + j < b` is `e + j`. -/
private theorem val_finRotate_pow {e j : ℕ} (he : e < b) (h : e + j < b) :
    (((finRotate b ^ j) ⟨e, he⟩ : Fin b) : ℕ) = e + j := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ', Equiv.Perm.mul_apply, val_finRotate, ih (by omega)]
    split_ifs with h' <;> omega

/-- **The shifts reached from `Σ_{a,b}(λ)`**: for `j ≥ 0`, every entry of every mutation of
`Σ^{-j}_{a,b}(λ)` is an entry of a mutation of `Σ_{a,b}(λ)`. -/
theorem exists_seedMutationSeq_rectanglesSeedShift_extCluster_eq (ha : 2 ≤ a)
    (hab : a + 2 ≤ b) (L : RectangleLabelling a b m n) (j : ℕ) (s : List (Fin n)) (i : Fin m) :
    ∃ (s' : List (Fin n)) (i' : Fin m),
      (seedMutationSeq L.le (rectanglesSeedShift L (-j)) s).extCluster i =
        (seedMutationSeq L.le (rectanglesSeed L) s').extCluster i' := by
  induction j generalizing s i with
  | zero => exact ⟨s, i, by simp [rectanglesSeed]⟩
  | succ j ih =>
    obtain ⟨s₀, hs₀⟩ := L.exists_map_eq_cyclicShiftOrder
    obtain ⟨-, π, -, hπb, hπ, heq⟩ :=
      rectanglesSeedShift_cyclicShift_mutation ha hab L s₀ hs₀ (-j)
    have hcol : s.map (π.col L.le) = s := by
      conv_rhs => rw [← List.map_id s]
      refine List.map_congr_left fun q _ => Fin.ext ?_
      have := hπ (Fin.castLE L.le q) (by simp)
      simp [ReindexingMap.col, this]
    obtain ⟨ℓ, rfl⟩ := hπb.2 i
    obtain ⟨s', i', h⟩ := ih (s₀ ++ s) ℓ
    refine ⟨s', i', ?_⟩
    rw [← h, seedMutationSeq_append, heq,
      seedMutationSeq_reindex L.le L.le _ (ReindexingMap.isClosedFor_of_surjective hπb.2 _ _),
      hcol, show (-(j : ℤ) - 1) = -((j + 1 : ℕ) : ℤ) by push_cast; ring]
    rfl

end Rotation

/-! ### Every Plücker coordinate is an entry of a seed -/

section Plucker

/-- For fixed `(a, b)`: for every rectangle labelling `λ` and seed pattern `Σ` through
`Σ_{a,b}(λ)`, every `P_J`, `|J| = a`, is an entry of some `Σ(t)`, read in `ℂ(z)`. -/
private def PluckerEntries (a b : ℕ) : Prop :=
  ∀ {m k : ℕ} (L : RectangleLabelling a b m k)
    {P : RegularTree k →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m k},
    IsSeedPattern ℂ L.le P → ∀ {t₀ : RegularTree k}, P t₀ = (rectanglesSeed L).adjoinSelf ℂ →
    ∀ {J : Finset (Fin b)}, J.card = a →
    ∃ t i, ((P t).extCluster i : FractionRing (ComplexPoly a b)) =
      algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b))
        (pluckerCoord (complexGenericMatrix a b) J)

/-- A set `K` of `a` columns containing the last column `b` is `I ∪ {b}` for a set `I` of `a - 1`
columns among the first `b - 1`. -/
private theorem exists_eq_map_castLE_union_last (hb0 : 0 < b) {K : Finset (Fin b)}
    (hK : K.card = a) (hb : (⟨b - 1, by omega⟩ : Fin b) ∈ K) :
    ∃ I : Finset (Fin (b - 1)), I.card = a - 1 ∧
      K = I.map (Fin.castLEEmb (Nat.sub_le b 1)) ∪ {⟨b - 1, by omega⟩} := by
  set I : Finset (Fin (b - 1)) := Finset.univ.filter fun x => Fin.castLE (by omega) x ∈ K
  have hKI : K = I.map (Fin.castLEEmb (Nat.sub_le b 1)) ∪ {⟨b - 1, by omega⟩} := by
    ext x
    simp only [I, Finset.mem_union, Finset.mem_map, Finset.mem_filter, Finset.mem_univ,
      true_and, Finset.mem_singleton, Fin.castLEEmb_apply]
    refine ⟨fun hx => ?_, ?_⟩
    · by_cases h : (x : ℕ) = b - 1
      · exact Or.inr (Fin.ext h)
      · exact Or.inl ⟨⟨x, by omega⟩, by simpa [Fin.castLE] using hx, Fin.ext rfl⟩
    · rintro (⟨y, hy, rfl⟩ | rfl) <;> assumption
  refine ⟨I, ?_, hKI⟩
  rw [hKI, Finset.card_union_of_disjoint, Finset.card_map, Finset.card_singleton] at hK
  · omega
  · simp only [Finset.disjoint_singleton_right, Finset.mem_map, Fin.castLEEmb_apply, not_exists,
      not_and]
    intro y _ h
    have := y.isLt
    simp only [Fin.ext_iff, Fin.val_castLE] at h
    omega

/-- **The induction step through the Muir embedding**: if the statement holds for
`(a - 1, b - 1)`, then every `P_K` with `b ∈ K` is an entry of a seed of `Σ`. -/
private theorem exists_extCluster_eq_pluckerCoord_of_last_mem (ha : 3 ≤ a) (hab : a + 2 ≤ b)
    (ih : PluckerEntries (a - 1) (b - 1)) (L : RectangleLabelling a b m n)
    {P : RegularTree n →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m n}
    (hP : IsSeedPattern ℂ L.le P) {t₀ : RegularTree n}
    (h₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ) {K : Finset (Fin b)} (hK : K.card = a)
    (hb : (⟨b - 1, by omega⟩ : Fin b) ∈ K) :
    ∃ t i, ((P t).extCluster i : FractionRing (ComplexPoly a b)) =
      algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b))
        (pluckerCoord (complexGenericMatrix a b) K) := by
  obtain ⟨m', n', ⟨L'⟩⟩ := exists_rectangleLabelling (a - 1) (b - 1)
  obtain ⟨P', hP', hP'₀⟩ := exists_isSeedPattern (K := ℂ) L'.le RegularTree.root
    (isLabeledSeed_rectanglesSeed (by omega) (by omega) L')
  obtain ⟨ι, hι⟩ := exists_algHom_adjoin_pluckerCoord (by omega : 2 ≤ a) (by omega : a ≤ b)
  have hle : IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L').extCluster) ≤
      IntermediateField.adjoin ℂ {y : FractionRing (ComplexPoly (a - 1) (b - 1)) |
        ∃ I : Finset (Fin (b - 1)), I.card = a - 1 ∧
          algebraMap _ _ (pluckerCoord (complexGenericMatrix (a - 1) (b - 1)) I) = y} := by
    refine IntermediateField.adjoin_le_iff.2 ?_
    rintro _ ⟨ℓ, rfl⟩
    exact IntermediateField.subset_adjoin ℂ _
      ⟨rectLabel _ _ (L'.equiv ℓ), card_rectLabel (by omega) _,
        by simp [rectanglesSeed, rectanglesSeedShift]⟩
  let ιF := ι.comp (IntermediateField.inclusion hle)
  obtain ⟨ι', hι', hsub⟩ := exists_isSeedSubpattern_rectanglesSeed (by omega) (by omega) L' L ιF
    (fun v _ => (AlgHom.comp_apply _ _ _).trans
      ((congrArg ι (Subtype.ext rfl)).trans (hι _ (card_rectLabel (by omega) v)))) hP' hP'₀ h₀
  obtain ⟨r, hr⟩ := hsub.exists_map_eq_reindex hP
  obtain ⟨I, hI, hKI⟩ := exists_eq_map_castLE_union_last (by omega) hK hb
  obtain ⟨t', i, hi⟩ := ih L' hP' hP'₀ hI
  obtain ⟨u, -, hu⟩ := hr t'
  refine ⟨u, r i, ?_⟩
  have h1 := congrFun (congrArg SeedData.extCluster hu) i
  simp only [SeedData.map_extCluster, SeedData.reindex_extCluster, Function.comp_apply] at h1
  rw [← h1, hι', hKI]
  have h2 : IntermediateField.inclusion hle ((P' t').extCluster i) =
      ⟨_, IntermediateField.subset_adjoin ℂ _ ⟨I, hI, rfl⟩⟩ :=
    Subtype.ext ((IntermediateField.coe_inclusion hle _).trans hi)
  rw [AlgHom.comp_apply, h2]
  exact hι I hI

/-- **The rotation step**: if every `P_K` with `b ∈ K` is an entry of a seed of `Σ`, then so is
every `P_J`. With `e ∈ J` and `j = b - e`, `K = (J + j) mod b` contains `b`; if `P_K` is an entry
of `μ_s(Σ_{a,b}(λ))`, then `P_J = ρ^j(P_K)` is an entry of `μ_s(Σ^{-j}_{a,b}(λ))`, hence of a
mutation of `Σ_{a,b}(λ)`. -/
private theorem exists_extCluster_eq_pluckerCoord_of_forall_last_mem (ha : 2 ≤ a)
    (hab : a + 2 ≤ b) (L : RectangleLabelling a b m n)
    {P : RegularTree n →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m n}
    (hP : IsSeedPattern ℂ L.le P) {t₀ : RegularTree n}
    (h₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ)
    (hlast : ∀ K : Finset (Fin b), K.card = a → (⟨b - 1, by omega⟩ : Fin b) ∈ K →
      ∃ t i, ((P t).extCluster i : FractionRing (ComplexPoly a b)) =
        algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b))
          (pluckerCoord (complexGenericMatrix a b) K))
    {J : Finset (Fin b)} (hJ : J.card = a) :
    ∃ t i, ((P t).extCluster i : FractionRing (ComplexPoly a b)) =
      algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b))
        (pluckerCoord (complexGenericMatrix a b) J) := by
  obtain ⟨e, he⟩ : J.Nonempty := Finset.card_pos.1 (by omega)
  set j : ℕ := b - 1 - e
  have hK : (⟨b - 1, by omega⟩ : Fin b) ∈ cyclicShift (j : ℤ) J := by
    simp only [cyclicShift, zpow_natCast, Finset.mem_map]
    refine ⟨e, he, Fin.ext ?_⟩
    rw [Equiv.toEmbedding_apply, val_finRotate_pow (e := e) e.isLt (by omega)]
    change (e : ℕ) + (b - 1 - e) = b - 1
    omega
  obtain ⟨t, i, hti⟩ := hlast _ (by rw [card_cyclicShift, hJ]) hK
  obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_extCluster_eq_coe L.le h₀ t i
  have h1 : rotationFieldEquiv a b j ((seedMutationSeq L.le (rectanglesSeed L) s).extCluster i) =
      algebraMap _ _ (pluckerCoord (complexGenericMatrix a b) J) := by
    rw [← hs, hti, IsFractionRing.fieldEquivOfAlgEquiv_algebraMap,
      rotationEquiv_zpow_pluckerCoord, cyclicShift_cyclicShift, neg_add_cancel, cyclicShift_zero]
  have h2 : rotationFieldEquiv a b j ((seedMutationSeq L.le (rectanglesSeed L) s).extCluster i) =
      (seedMutationSeq L.le (rectanglesSeedShift L (-j)) s).extCluster i := by
    have := seedMutationSeq_map L.le (rotationFieldEquiv a b j) (rectanglesSeed L) s
    rw [rectanglesSeed, rectanglesSeedShift_map_rotation, zero_sub] at this
    rw [← this]
    rfl
  obtain ⟨s', i', h3⟩ := exists_seedMutationSeq_rectanglesSeedShift_extCluster_eq ha hab L j s i
  obtain ⟨t', i'', h4⟩ := hP.exists_coe_extCluster_eq_seedMutationSeq L.le h₀ s' i'
  exact ⟨t', i'', by rw [h4, ← h3, ← h2, h1]⟩

/-- The statement holds for every `2 ≤ a ≤ b - 2`, by induction on `a`. -/
private theorem pluckerEntries_of_two_le (a : ℕ) : ∀ b, 2 ≤ a → a + 2 ≤ b → PluckerEntries a b := by
  induction a using Nat.strong_induction_on with
  | _ a ih =>
    intro b ha hab m k L P hP t₀ h₀ J hJ
    rcases Nat.lt_or_ge a 3 with h | h
    · obtain rfl : a = 2 := by omega
      obtain ⟨n, rfl⟩ : ∃ n, b = n + 3 := ⟨b - 3, by omega⟩
      exact L.exists_extCluster_eq_pluckerCoord_of_card_eq_two hP h₀ hJ
    · exact exists_extCluster_eq_pluckerCoord_of_forall_last_mem ha hab L hP h₀
        (fun K hK hKb => exists_extCluster_eq_pluckerCoord_of_last_mem h hab
          (ih (a - 1) (by omega) (b - 1) (by omega) (by omega)) L hP h₀ hK hKb) hJ

/-- **Every Plücker coordinate is an entry of a seed of the pattern.** Let `2 ≤ a ≤ b - 2`, let
`λ` be a rectangle labelling for `(a, b)`, and `Σ` a seed pattern over `ℂ` through `Σ_{a,b}(λ)`
at `t₀`, in the field generated by its entries. Then every Plücker coordinate `P_J`,
`J ⊆ [1, b]` with `a` elements, read in `ℂ(z)`, is an entry of `Σ(t)` for some `t`. -/
@[cluster_algebras "lem_plucker_cluster_variables"]
theorem RectangleLabelling.exists_extCluster_eq_pluckerCoord (ha : 2 ≤ a) (hab : a + 2 ≤ b)
    {k : ℕ} (L : RectangleLabelling a b m k)
    {P : RegularTree k →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m k}
    (hP : IsSeedPattern ℂ L.le P) {t₀ : RegularTree k}
    (h₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ) {J : Finset (Fin b)} (hJ : J.card = a) :
    ∃ t i, ((P t).extCluster i : FractionRing (ComplexPoly a b)) =
      algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b))
        (pluckerCoord (complexGenericMatrix a b) J) :=
  pluckerEntries_of_two_le a b ha hab L hP h₀ hJ

/-- **Every Plücker coordinate is a cluster or frozen variable.** Let `2 ≤ a ≤ b - 2`, let `λ`
be a rectangle labelling for `(a, b)`, and `Σ` a seed pattern over `ℂ` through `Σ_{a,b}(λ)` at
`t₀`, in the field generated by its entries. Then every Plücker coordinate `P_J`, `J ⊆ [1, b]`
with `a` elements, read in `ℂ(z)`, is a cluster variable or a frozen variable of `Σ`. -/
@[cluster_algebras "lem_plucker_cluster_variables"]
theorem RectangleLabelling.algebraMap_pluckerCoord_mem (ha : 2 ≤ a) (hab : a + 2 ≤ b)
    {k : ℕ} (L : RectangleLabelling a b m k)
    {P : RegularTree k →
      SeedData (IntermediateField.adjoin ℂ (Set.range (rectanglesSeed L).extCluster)) m k}
    (hP : IsSeedPattern ℂ L.le P) {t₀ : RegularTree k}
    (h₀ : P t₀ = (rectanglesSeed L).adjoinSelf ℂ) {J : Finset (Fin b)} (hJ : J.card = a) :
    algebraMap (ComplexPoly a b) (FractionRing (ComplexPoly a b))
        (pluckerCoord (complexGenericMatrix a b) J) ∈
      ((↑) : _ → FractionRing (ComplexPoly a b)) ''
        (patternClusterVariables L.le P ∪ ⋃ t, frozenVariables (P t)) := by
  obtain ⟨t, i, hi⟩ := L.exists_extCluster_eq_pluckerCoord ha hab hP h₀ hJ
  refine ⟨(P t).extCluster i, ?_, hi⟩
  by_cases hik : (i : ℕ) < k
  · exact Or.inl (Set.mem_iUnion.2 ⟨t, ⟨⟨i, hik⟩, rfl⟩⟩)
  · exact Or.inr (Set.mem_iUnion.2 ⟨t, ⟨i, not_lt.1 hik, rfl⟩⟩)

end Plucker

