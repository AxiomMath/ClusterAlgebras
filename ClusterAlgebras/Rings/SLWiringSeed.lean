/-!
# The seeds of wiring diagrams on `SL_k`

Let `D` be a wiring diagram on `k ≥ 3` strands and `λ` a chamber labelling of `D`. The seed
`Σ_SL(D, λ)` has entries the images `π(P_{J(λ(i))}(z))` of the chamber minors in the coordinate
ring `ℂ[SL_k] = ℂ[z]/⟨det z - 1⟩`, which is a domain, and the matrix `B̃(D, λ)`. Read in the
fraction field of `ℂ[SL_k]`, it is a labeled seed in the subfield its entries generate, since the
chamber minors together with `det z` are algebraically independent; its entries are flag minors,
hence lie in `ℂ[SL_k]^U`.

For `k ≥ 3`, any two such seeds are mutation equivalent. The seeds `Σ(D, λ)` of any two wiring
diagrams are related by a mutation sequence through seeds of wiring diagrams, followed by a
bijective restriction map. Applying `π` entrywise commutes with each of these mutations: an
exchange relation `xₖ x'ₖ = M⁺ₖ + M⁻ₖ` among polynomials is carried by `π` to one among their
images, and the images of flag minors are nonzero.

## Main results

* `ClusterAlgebras.map_eq_seedMutation_map`: a ring homomorphism `φ : A → K` commutes with
  mutation of seeds with entries in `A`, as long as the mutated entry, computed in a field
  containing `A`, lies in `A` and `φ(xₖ) ≠ 0`.
* `ClusterAlgebras.isMutationSeqDefined_map_and_seedMutationSeq_map`: the same along a mutation
  sequence all of whose partial mutations have entries in `A` sent to nonzero elements by `φ`.
* `ClusterAlgebras.IsMutationEquivalent.exists_adjoinSelf`: a seed mutation equivalent to `S₁`
  has entries in the subfield generated by those of `S₁`, and is mutation equivalent there to
  `S₁` read in that subfield.
* `ClusterAlgebras.isLabeledSeed_slWiringSeed`,
  `ClusterAlgebras.slWiringSeed_extCluster_mem_slUInvariants`:
  `Σ_SL(D, λ)` is a labeled seed over `ℂ` in the subfield of `Frac(ℂ[SL_k])` generated by its
  entries, and its entries lie in `ℂ[SL_k]^U`.
* `ClusterAlgebras.isMutationEquivalent_slWiringSeed`: for `k ≥ 3`, `Σ_SL(D', λ')` is mutation
  equivalent to `Σ_SL(D, λ)` as pairs over `Frac(ℂ[SL_k])`.

## Implementation notes

* `slWiringSeed D L` has entries in the ring `ℂ[SL_k]`; it is read in the fraction field
  `FractionRing (SLCoord k)` as `(slWiringSeed D L).map (algebraMap _ _)`.
* FWZ transport each mutation step with their lemma on transport and trivialization, with
  `I = ∅`. With no frozen variable deleted, trivialization is only a reindexing, so the transport
  of a single mutation is proved here directly (`map_eq_seedMutation_map`), for any injective ring
  homomorphism `ι : A → F` playing the role of the inclusion of `A = ℂ[z]` in `F = ℂ(z)`.
* A wiring diagram of `WiringDiagram n'` has `n' + 2` strands, so `k ≥ 3` is `1 ≤ n'`. That
  `Σ_SL(D, λ)` is a labeled seed holds for every `k`, so `k ≥ 3` is not assumed there.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

/-! ### Transporting seed mutation along a ring homomorphism -/

section Transport

variable {A F K : Type*} [CommRing A] [Field F] [Field K] {m n : ℕ}

omit [CommRing A] [Field F] in
/-- Mapping seeds along an injective function is injective. -/
theorem SeedData.map_injective {f : A → F} (hf : Function.Injective f) :
    Function.Injective (SeedData.map (m := m) (n := n) f) := fun S T h => by
  have hB : (S.map f).extExchangeMatrix = (T.map f).extExchangeMatrix :=
    congrArg SeedData.extExchangeMatrix h
  exact SeedData.ext (funext fun i => hf (congrFun (congrArg SeedData.extCluster h) i)) hB

/-- **Seed mutation commutes with a ring homomorphism.** Let `ι : A → F` be an injective ring
homomorphism to a field, `φ : A → K` a ring homomorphism to a field, and `S`, `T` seeds with
entries in `A` such that `T`, read in `F`, is the mutation in direction `k` of `S` read in `F`.
If `φ(xₖ) ≠ 0`, then `T`, read in `K` along `φ`, is the mutation in direction `k` of `S` read in
`K` along `φ`. -/
theorem map_eq_seedMutation_map (hmn : n ≤ m) {ι : A →+* F} (hι : Function.Injective ι)
    (φ : A →+* K) {S T : SeedData A m n} {k : Fin n}
    (hT : T.map ι = seedMutation hmn (S.map ι) k)
    (hφ : φ (S.extCluster (Fin.castLE hmn k)) ≠ 0) :
    T.map φ = seedMutation hmn (S.map φ) k := by
  have hx := congrArg SeedData.extCluster hT
  have hB : (T.map ι).extExchangeMatrix = (seedMutation hmn (S.map ι) k).extExchangeMatrix :=
    congrArg SeedData.extExchangeMatrix hT
  have hne : ι (S.extCluster (Fin.castLE hmn k)) ≠ 0 := fun h => hφ (by
    rw [(map_eq_zero_iff ι hι).1 h, map_zero])
  have hrel : S.extCluster (Fin.castLE hmn k) * T.extCluster (Fin.castLE hmn k) =
      (∏ i, S.extCluster i ^ (S.extExchangeMatrix i k).toNat) +
        ∏ i, S.extCluster i ^ (-S.extExchangeMatrix i k).toNat := by
    apply hι
    have h := congrFun hx (Fin.castLE hmn k)
    simp only [SeedData.map_extCluster, Function.comp_apply, seedMutation, Function.update_self,
      SeedData.map_extExchangeMatrix, exchangeMonomialPos_eq_prod,
      exchangeMonomialNeg_eq_prod] at h
    rw [map_mul, h, map_add, map_prod, map_prod]
    simp only [map_pow]
    field_simp
  refine SeedData.ext (funext fun a => ?_) hB
  by_cases ha : a = Fin.castLE hmn k
  · subst ha
    simp only [SeedData.map_extCluster, Function.comp_apply, seedMutation, Function.update_self,
      SeedData.map_extExchangeMatrix, exchangeMonomialPos_eq_prod, exchangeMonomialNeg_eq_prod]
    rw [eq_div_iff hφ, mul_comm, ← map_mul, hrel, map_add, map_prod, map_prod]
    simp only [map_pow]
  · have h := congrFun hx a
    simp only [SeedData.map_extCluster, Function.comp_apply, seedMutation,
      Function.update_of_ne ha] at h ⊢
    rw [hι h]

/-- **Mutation along a sequence commutes with a ring homomorphism.** Let `ι : A → F` be an
injective ring homomorphism to a field and `φ : A → K` a ring homomorphism to a field. Let `S` be
a seed with entries in `A` and `s` a sequence of directions such that every partial mutation
`μ_{(q₁, …, q_e)}(S)`, computed in `F`, has entries in `A` sent to nonzero elements by `φ`. Then
mutation of `S` read in `K` along `φ` is defined along `s`, and `μ_s` commutes with `φ`. -/
theorem isMutationSeqDefined_map_and_seedMutationSeq_map (hmn : n ≤ m) {ι : A →+* F}
    (hι : Function.Injective ι) (φ : A →+* K) (S : SeedData A m n) (s : List (Fin n))
    (hs : ∀ e ≤ s.length, ∃ T : SeedData A m n,
      seedMutationSeq hmn (S.map ι) (s.take e) = T.map ι ∧ ∀ i, φ (T.extCluster i) ≠ 0)
    {T : SeedData A m n} (hT : seedMutationSeq hmn (S.map ι) s = T.map ι) :
    IsMutationSeqDefined hmn (S.map φ) s ∧ seedMutationSeq hmn (S.map φ) s = T.map φ := by
  induction s generalizing S with
  | nil =>
    obtain rfl : S = T := SeedData.map_injective hι hT
    exact ⟨trivial, rfl⟩
  | cons k s ih =>
    obtain ⟨T₀, hT₀, hT₀φ⟩ := hs 0 (Nat.zero_le _)
    obtain rfl : S = T₀ := SeedData.map_injective hι hT₀
    obtain ⟨T₁, hT₁, -⟩ := hs 1 (by simp)
    have hT₁' : T₁.map ι = seedMutation hmn (S.map ι) k := by
      simpa using hT₁.symm
    have hstep := map_eq_seedMutation_map hmn hι φ hT₁' (hT₀φ _)
    have hT' : seedMutationSeq hmn (T₁.map ι) s = T.map ι := by
      rwa [hT₁', ← seedMutationSeq_cons]
    obtain ⟨hdef, heq⟩ := ih T₁ (fun e he => by
      obtain ⟨T', h1, h2⟩ := hs (e + 1) (Nat.succ_le_succ he)
      refine ⟨T', ?_, h2⟩
      rwa [List.take_succ_cons, seedMutationSeq_cons, ← hT₁'] at h1) hT'
    refine ⟨⟨hT₀φ _, ?_⟩, ?_⟩
    · rwa [← hstep]
    · rwa [seedMutationSeq_cons, ← hstep]

end Transport

/-! ### Mutation equivalence read in a subfield -/

section Subfield

variable {F F' : Type*} [Field F] [Field F'] {m n : ℕ}

/-- Mutation along `s` is defined at the image of `S` under a ring homomorphism of fields
exactly when it is defined at `S`. -/
theorem isMutationSeqDefined_map_iff (hmn : n ≤ m) {G : Type*} [FunLike G F F']
    [RingHomClass G F F'] (f : G) (S : SeedData F m n) (s : List (Fin n)) :
    IsMutationSeqDefined hmn (S.map f) s ↔ IsMutationSeqDefined hmn S s := by
  induction s generalizing S with
  | nil => simp
  | cons k s ih =>
    rw [isMutationSeqDefined_cons, isMutationSeqDefined_cons, ← seedMutation_map, ih,
      SeedData.map_extCluster, Function.comp_apply, map_ne_zero]

/-- **Mutation equivalence read in the field generated by the first seed.** If `S₂` is
mutation equivalent to `S₁` in `F`, then `S₂` has entries in the subfield `K(x̃)` of `F`
generated by the entries of `S₁`, and read there it is mutation equivalent to
`S₁.adjoinSelf K`. -/
theorem IsMutationEquivalent.exists_adjoinSelf (K : Type*) [Field K] [Algebra K F]
    (hmn : n ≤ m) {S₁ S₂ : SeedData F m n} (h : IsMutationEquivalent hmn S₁ S₂) :
    ∃ S₂' : SeedData (IntermediateField.adjoin K (Set.range S₁.extCluster)) m n,
      S₂'.map (IntermediateField.val _) = S₂ ∧
        IsMutationEquivalent hmn (S₁.adjoinSelf K) S₂' := by
  obtain ⟨s, π, hπ, hbij, hdef, rfl⟩ := h
  refine ⟨(seedMutationSeq hmn (S₁.adjoinSelf K) s).reindex hmn π, ?_, s, π, hπ, hbij, ?_, rfl⟩
  · rw [SeedData.map_reindex, seedMutationSeq_map, SeedData.map_val_adjoinSelf]
  · rwa [← isMutationSeqDefined_map_iff hmn (IntermediateField.val _),
      SeedData.map_val_adjoinSelf]

end Subfield

/-! ### The seeds of wiring diagrams on `SL_k` -/

section SL

variable {n' m n : ℕ}

/-- The seed of a wiring diagram with its entries, the chamber minors, read in `ℂ[z]`. Both
`Σ(D, λ)` and `Σ_SL(D, λ)` are obtained from it by applying a ring homomorphism entrywise. -/
noncomputable def polyWiringSeed (D : WiringDiagram n') (L : Labelling D.wiringQuiver m n) :
    SeedData (ComplexPoly (n' + 2) (n' + 2)) m n where
  extCluster i := flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) (L.equiv i).chamberSet
  extExchangeMatrix := extExchangeMatrix D.wiringQuiver L

/-- The `i`-th entry of `polyWiringSeed D λ` is the flag minor of the generic matrix on the
chamber set of `λ(i)`. -/
@[simp]
theorem polyWiringSeed_extCluster (D : WiringDiagram n') (L : Labelling D.wiringQuiver m n)
    (i : Fin m) :
    (polyWiringSeed D L).extCluster i =
      flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) (L.equiv i).chamberSet :=
  rfl

/-- The extended exchange matrix of `polyWiringSeed D λ` is `B̃(D, λ)`. -/
@[simp]
theorem polyWiringSeed_extExchangeMatrix (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    (polyWiringSeed D L).extExchangeMatrix = extExchangeMatrix D.wiringQuiver L :=
  rfl

/-- `Σ(D, λ)` is `polyWiringSeed D λ` read in `ℂ(z)`. -/
theorem wiringSeed_eq_map_polyWiringSeed (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    wiringSeed D L = (polyWiringSeed D L).map (algebraMap _ _) :=
  rfl

/-- `Σ_SL(D, λ)` is the image of `polyWiringSeed D λ` under `π`. -/
theorem slWiringSeed_eq_map_polyWiringSeed (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    slWiringSeed D L = (polyWiringSeed D L).map (slQuot (n' + 2)) :=
  rfl

/-- The image in `ℂ[SL_k]`, hence in its fraction field, of a flag minor of the generic
matrix is nonzero. -/
theorem algebraMap_slQuot_flagMinor_ne_zero {k : ℕ} (J : Finset (Fin k)) :
    algebraMap (SLCoord k) (FractionRing (SLCoord k))
      (slQuot k (flagMinor (complexGenericMatrix k k) J)) ≠ 0 :=
  (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2
    (slQuot_minor_ne_zero (card_initialRows (by simpa using Finset.card_le_univ J)))

/-- The entries of `Σ_SL(D, λ)` are algebraically independent over `ℂ` in `ℂ[SL_k]`. -/
theorem algebraicIndependent_slWiringSeed_extCluster (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    AlgebraicIndependent ℂ (slWiringSeed D L).extCluster := by
  set z := complexGenericMatrix (n' + 2) (n' + 2)
  let f : Fin m → ComplexPoly (n' + 2) (n' + 2) := fun i => flagMinor z (L.equiv i).chamberSet
  let e : Fin (m + 1) ≃ Option D.Chamber := finSuccEquivLast.trans (Equiv.optionCongr L.equiv)
  have hcomp : (Fin.snoc f z.det : Fin (m + 1) → ComplexPoly (n' + 2) (n' + 2)) =
      (fun o : Option D.Chamber => o.elim z.det fun c => flagMinor z c.chamberSet) ∘ e := by
    funext j
    refine Fin.lastCases ?_ (fun i => ?_) j <;> simp [e, f]
  have hind := (algebraicIndependent_det_flagMinor_chamberSet D).comp e e.injective
  rw [← hcomp] at hind
  exact algebraicIndependent_slQuot_comp (f := f) (fun i => ⟨_, _, rfl⟩) hind

/-- **The seeds on `SL_k` are labeled seeds.** For a wiring diagram `D` and a chamber
labelling `λ`, `Σ_SL(D, λ)`, read in the fraction field of the domain `ℂ[SL_k]`, is a labeled
seed over `ℂ` in the subfield generated by its entries. -/
@[cluster_algebras "lem_sl_wiring_seed_is_seed"]
theorem isLabeledSeed_slWiringSeed (D : WiringDiagram n') (L : Labelling D.wiringQuiver m n) :
    IsLabeledSeed ℂ L.le
      (((slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2))))).adjoinSelf ℂ) := by
  rw [isLabeledSeed_adjoinSelf_iff]
  refine ⟨?_, ((isLabeledSeed_adjoinSelf_iff ℂ L.le _).1 (isLabeledSeed_wiringSeed D L)).2⟩
  exact (algebraicIndependent_slWiringSeed_extCluster D L).map'
    (f := IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2))))
    (IsFractionRing.injective _ _)

/-- **The entries of `Σ_SL(D, λ)` lie in `ℂ[SL_k]^U`**: they are images of flag minors, which
are fixed by every `σ_u`, `u` lower unitriangular. -/
@[cluster_algebras "lem_sl_wiring_seed_is_seed"]
theorem slWiringSeed_extCluster_mem_slUInvariants (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) (i : Fin m) :
    (slWiringSeed D L).extCluster i ∈ slUInvariants (n' + 2) :=
  mem_slUInvariants.2 ⟨_, rfl, fun _ hu => by
    rw [leftSubst_flagMinor hu, sub_self]
    exact zero_mem _⟩

/-- **The seeds of wiring diagrams on `SL_k` are mutation equivalent.** Let `k = n' + 2 ≥ 3`,
let `D` and `D'` be wiring diagrams on `k` strands, and `λ`, `λ'` chamber labellings of `D` and
`D'`. Then `Σ_SL(D', λ')` is mutation equivalent to `Σ_SL(D, λ)`, as pairs over the fraction
field of `ℂ[SL_k]`. -/
@[cluster_algebras "thm_sl_u_mutation_equivalent"]
theorem isMutationEquivalent_slWiringSeed (hk : 1 ≤ n') (D D' : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) (L' : Labelling D'.wiringQuiver m n) :
    IsMutationEquivalent L.le
      ((slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2)))))
      ((slWiringSeed D' L').map (algebraMap _ (FractionRing (SLCoord (n' + 2))))) := by
  obtain ⟨s, π, hπ, hbij, hW, hpre⟩ :=
    WiringDiagram.exists_seedMutationSeq_wiringSeed_eq hk D D' L L'
  let ι := algebraMap (ComplexPoly (n' + 2) (n' + 2))
    (FractionRing (ComplexPoly (n' + 2) (n' + 2)))
  have hι : Function.Injective ι := IsFractionRing.injective _ _
  let φ : ComplexPoly (n' + 2) (n' + 2) →+* FractionRing (SLCoord (n' + 2)) :=
    (algebraMap (SLCoord (n' + 2)) _).comp (slQuot (n' + 2)).toRingHom
  have hpre' : ∀ e ≤ s.length, ∃ T : SeedData (ComplexPoly (n' + 2) (n' + 2)) m n,
      seedMutationSeq L.le ((polyWiringSeed D L).map ι) (s.take e) = T.map ι ∧
        ∀ i, φ (T.extCluster i) ≠ 0 := fun e he => by
    obtain ⟨E, LE, h⟩ := hpre e he
    exact ⟨polyWiringSeed E LE, h, fun _ => algebraMap_slQuot_flagMinor_ne_zero _⟩
  obtain ⟨E, LE, hE⟩ := hpre s.length le_rfl
  rw [List.take_length] at hE
  obtain ⟨hdef, heq⟩ := isMutationSeqDefined_map_and_seedMutationSeq_map L.le hι φ
    (polyWiringSeed D L) s hpre' (T := polyWiringSeed E LE) hE
  refine ⟨s, π, hπ, hbij, hdef, ?_⟩
  have hD' : polyWiringSeed D' L' = (polyWiringSeed E LE).reindex L.le π := by
    apply SeedData.map_injective hι
    change wiringSeed D' L' = _
    rw [hW, wiringSeed_eq_map_polyWiringSeed D L]
    exact congrArg (SeedData.reindex L.le · π) hE
  change (polyWiringSeed D' L').map φ = _
  change _ = (seedMutationSeq L.le ((polyWiringSeed D L).map φ) s).reindex L.le π
  rw [heq, hD']
  rfl

end SL

end ClusterAlgebras
