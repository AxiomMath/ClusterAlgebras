/-!
# Seeds in the field they generate, mutation equivalence, cluster structures

The general vocabulary of [FWZ], Chapter 6, *Cluster structures in commutative rings*: the seeds
of that chapter are written down as tuples of elements of some big field (a field of rational
functions), and are labeled seeds in the subfield their entries generate; two seeds are
*mutation equivalent* when a mutation sequence followed by a relabelling takes one to the other;
and a *cluster structure* in a ring is a seed pattern whose cluster algebra is that ring.

## Main definitions

* `ClusterAlgebras.SeedData.adjoinSelf K S`: the seed `S`, whose entries lie in a field `F`, read
  as a seed in the subfield `K(x̃)` of `F` generated by its extended cluster.
* `ClusterAlgebras.IsMutationSeqDefined hmn S s`: every successive mutation along `s` is defined,
  that is, mutates at a nonzero entry.
* `ClusterAlgebras.IsMutationEquivalent hmn S₁ S₂`: `S₂ = (μₛ(S₁))^π` for a sequence `s` along
  which mutation is defined and a bijective restriction map `π`.
* `ClusterAlgebras.ClusterStructure K R`: a cluster structure in a subring `R` of a field
  containing `K`, with its cluster and coefficient variables.

## Implementation notes

* Seed mutation (`seedMutation`) is total, through Lean's division; [FWZ] defines `μₖ` only when
  the entry in position `k` is nonzero. "`μₛ(Σ)` is defined" is `IsMutationSeqDefined`.
* A subring of a field `K` containing `K`'s subfield `𝕜` is a `Subalgebra 𝕜 K`.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6][FWZ]
-/

@[expose] public section

namespace ClusterAlgebras

/-! ### A seed read in the field its entries generate -/

section AdjoinSelf

variable (K : Type*) {F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

/-- The seed `S` read as a seed in the subfield `K(x₁, …, xₘ)` of `F` generated by its extended
cluster. The statement that `S` is a labeled seed in the subfield generated by its entries is
`IsLabeledSeed K hmn (S.adjoinSelf K)`. -/
def SeedData.adjoinSelf (S : SeedData F m n) :
    SeedData (IntermediateField.adjoin K (Set.range S.extCluster)) m n where
  extCluster a := ⟨S.extCluster a, IntermediateField.subset_adjoin K _ ⟨a, rfl⟩⟩
  extExchangeMatrix := S.extExchangeMatrix

/-- The entries of `SeedData.adjoinSelf`, read in `F`. -/
@[simp]
theorem SeedData.coe_adjoinSelf_extCluster (S : SeedData F m n) (a : Fin m) :
    ((S.adjoinSelf K).extCluster a : F) = S.extCluster a :=
  rfl

/-- The extended exchange matrix of `SeedData.adjoinSelf`. -/
@[simp]
theorem SeedData.adjoinSelf_extExchangeMatrix (S : SeedData F m n) :
    (S.adjoinSelf K).extExchangeMatrix = S.extExchangeMatrix :=
  rfl

/-- Read in `F`, the seed `SeedData.adjoinSelf` is `S`. -/
theorem SeedData.map_val_adjoinSelf (S : SeedData F m n) :
    (S.adjoinSelf K).map (IntermediateField.val _) = S :=
  rfl

/-- **A seed is a labeled seed in the field its entries generate** exactly when its entries are
algebraically independent over `K` and its matrix is extended skew-symmetrizable. -/
theorem isLabeledSeed_adjoinSelf_iff (hmn : n ≤ m) (S : SeedData F m n) :
    IsLabeledSeed K hmn (S.adjoinSelf K) ↔
      AlgebraicIndependent K S.extCluster ∧ ExtSkewSymmetrizable hmn S.extExchangeMatrix := by
  have hcomp : (IntermediateField.val _ : _ →ₐ[K] F) ∘ (S.adjoinSelf K).extCluster =
      S.extCluster := rfl
  refine ⟨fun h => ⟨?_, h.2⟩, fun h => ⟨⟨?_, ?_⟩, h.2⟩⟩
  · rw [← hcomp]
    exact h.1.1.map' Subtype.val_injective
  · exact AlgebraicIndependent.of_comp (IntermediateField.val _) (by rw [hcomp]; exact h.1)
  · apply IntermediateField.map_injective (IntermediateField.val _)
    rw [IntermediateField.adjoin_map, ← Set.range_comp, hcomp, ← AlgHom.fieldRange_eq_map,
      IntermediateField.fieldRange_val]

end AdjoinSelf

/-! ### Mutation equivalence -/

section MutationEquivalence

variable {F : Type*} [Field F] {m n : ℕ}

/-- **Mutation along `s` is defined** at `S`: each successive mutation in the sequence `s` is
taken at a nonzero entry. -/
@[cluster_algebras "def_mutation_equivalent_seeds"]
def IsMutationSeqDefined (hmn : n ≤ m) : SeedData F m n → List (Fin n) → Prop
  | _, [] => True
  | S, k :: s => S.extCluster (Fin.castLE hmn k) ≠ 0 ∧
      IsMutationSeqDefined hmn (seedMutation hmn S k) s

/-- Mutation along the empty sequence is defined. -/
@[simp]
theorem isMutationSeqDefined_nil (hmn : n ≤ m) (S : SeedData F m n) :
    IsMutationSeqDefined hmn S [] :=
  trivial

/-- Mutation along `k :: s` is defined when the entry in position `k` is nonzero and mutation
along `s` is defined at `μₖ(S)`. -/
@[simp]
theorem isMutationSeqDefined_cons (hmn : n ≤ m) (S : SeedData F m n) (k : Fin n)
    (s : List (Fin n)) :
    IsMutationSeqDefined hmn S (k :: s) ↔ S.extCluster (Fin.castLE hmn k) ≠ 0 ∧
      IsMutationSeqDefined hmn (seedMutation hmn S k) s :=
  Iff.rfl

/-- `S₂` is **mutation equivalent** to `S₁` when there are a finite sequence `s` of directions
along which mutation of `S₁` is defined and a bijective restriction map `π` from `(m, n)` to
`(m, n)` with `S₂ = (μₛ(S₁))^π`. No seed condition is assumed on `S₁` or `S₂`. -/
@[cluster_algebras "def_mutation_equivalent_seeds"]
def IsMutationEquivalent (hmn : n ≤ m) (S₁ S₂ : SeedData F m n) : Prop :=
  ∃ (s : List (Fin n)) (π : ReindexingMap m n m n), π.IsRestriction ∧ Function.Bijective π ∧
    IsMutationSeqDefined hmn S₁ s ∧ S₂ = (seedMutationSeq hmn S₁ s).reindex hmn π

end MutationEquivalence

/-! ### Cluster structures -/

section ClusterStructure

variable (K : Type*) {L : Type*} [Field K] [Field L] [Algebra K L]

/-- A **cluster structure** in a subring `R ⊆ L` containing `K`: a seed pattern `P` of rank `n`
in a subfield `F ⊆ L` over `K`, with matrices of size `m × n`, whose cluster algebra is `R`. -/
@[cluster_algebras "def_cluster_structure"]
structure ClusterStructure (R : Subalgebra K L) where
  /-- The number of entries of each extended cluster. -/
  m : ℕ
  /-- The rank. -/
  n : ℕ
  /-- The rank is at most the number of entries. -/
  le : n ≤ m
  /-- The field the seed pattern lives in. -/
  field : IntermediateField K L
  /-- The seed pattern. -/
  pattern : RegularTree n → SeedData field m n
  /-- It is a seed pattern. -/
  isSeedPattern : IsSeedPattern K le pattern
  /-- Its cluster algebra, read in `L`, is `R`. -/
  clusterAlgebra_eq : (clusterAlgebra K le pattern).map field.val = R

variable {K}

/-- The **cluster variables** of a cluster structure: the elements of `𝒳(Σ)`, read in `L`. -/
@[cluster_algebras "def_cluster_structure"]
def ClusterStructure.clusterVariables {R : Subalgebra K L} (C : ClusterStructure K R) : Set L :=
  C.field.val '' patternClusterVariables C.le C.pattern

/-- The **coefficient variables** of a cluster structure: the frozen variables of its seed
pattern, read in `L`. -/
@[cluster_algebras "def_cluster_structure"]
def ClusterStructure.coefficientVariables {R : Subalgebra K L} (C : ClusterStructure K R) :
    Set L :=
  C.field.val '' ⋃ t, frozenVariables (C.pattern t)

end ClusterStructure

end ClusterAlgebras
