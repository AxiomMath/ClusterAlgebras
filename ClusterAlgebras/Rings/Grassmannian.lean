module

public import ClusterAlgebras.Rings.PluckerClusterVariables
public import ClusterAlgebras.Rings.GrassmannianStarfish
public import ClusterAlgebras.Rings.SLUClusterAlgebra

/-!
# The Plücker ring is a cluster algebra

Let `2 ≤ a ≤ b - 2`, let `z` be the generic `a × b` matrix over `ℂ` and `λ` a rectangle labelling.
The cluster algebra `𝒜(Σ_{a,b}(λ))` of the rectangles seed is the Plücker ring
`R_{a,b} = ℂ[z]^{SL_a(ℂ)}` (Scott's theorem), and so is the cluster algebra of every cyclic shift
`Σ^i_{a,b}(λ)`.

The inclusion `R_{a,b} ⊆ 𝒜(Σ_{a,b}(λ))` holds because, by the First Fundamental Theorem, `R_{a,b}`
is generated by the Plücker coordinates `P_J`, `|J| = a`, each of which is an entry of an iterated
mutation of `Σ_{a,b}(λ)` (`ClusterAlgebras.RectangleLabelling.exists_extCluster_eq_pluckerCoord`),
hence lies in its cluster algebra. The reverse inclusion is the Starfish argument of
`ClusterAlgebras.clusterAlgebraOfSeed_rectanglesSeed_le_pluckerRing`.

## Main results

* `ClusterAlgebras.pluckerRing_map_le_map_val_clusterAlgebraOfSeed_rectanglesSeed`:
  `R_{a,b} ⊆ 𝒜(Σ_{a,b}(λ))`.
* `ClusterAlgebras.map_val_clusterAlgebraOfSeed_rectanglesSeed`: `𝒜(Σ_{a,b}(λ)) = R_{a,b}`.
* `ClusterAlgebras.isLabeledSeed_rectanglesSeedShift_and_map_val_clusterAlgebraOfSeed`: every
  cyclic shift `Σ^i_{a,b}(λ)` is a labeled seed with `𝒜(Σ^i_{a,b}(λ)) = R_{a,b}`.
* `ClusterAlgebras.clusterAlgebraOfSeed_rectanglesSeed`,
  `ClusterAlgebras.clusterAlgebraOfSeed_rectanglesSeedShift`: the same equalities for the seeds
  read in `ℂ(z)`.
* `ClusterAlgebras.pluckerRing_map_rotationEquiv_zpow`: the rotation `ρ^j` maps `R_{a,b}` onto
  itself.

## Implementation notes

* A labeled seed lives in the field its entries generate, so `Σ_{a,b}(λ)` is read as
  `SeedData.adjoinSelf ℂ` and its cluster algebra, a subalgebra of that subfield of `ℂ(z)`, is
  compared with `R_{a,b} ⊆ ℂ[z]` inside `ℂ(z)`: the former through the inclusion of the subfield,
  the latter through `algebraMap`. Since a field homomorphism carries the cluster algebra of a seed
  onto that of its image (`clusterAlgebraOfSeed_map`), this is the same as the cluster algebra of
  the seed read in `ℂ(z)`.
* For the cyclic shifts FWZ show `Σ^i_{a,b}(λ)` mutation equivalent to `Σ_{a,b}(λ)`, by the
  cyclic shift mutation sequence. Here the rotation is used instead: `ρ^{-i}`, extended to `ℂ(z)`,
  carries `Σ_{a,b}(λ)` entrywise to `Σ^i_{a,b}(λ)` with the same exchange matrix
  (`rectanglesSeedShift_map_rotation`), hence carries `𝒜(Σ_{a,b}(λ))` onto `𝒜(Σ^i_{a,b}(λ))`; and
  it maps `R_{a,b}` onto itself, since it permutes the Plücker coordinates up to sign, which
  generate `R_{a,b}`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

variable {a b m n : ℕ}

/-! ### `R_{a,b} ⊆ 𝒜(Σ_{a,b}(λ))` -/

/-- **`R_{a,b} ⊆ 𝒜(Σ_{a,b}(λ))`, read in `ℂ(z)`.** For `2 ≤ a ≤ b - 2` and a rectangle labelling
`λ`, the image of the Plücker ring in `ℂ(z)` lies in the cluster algebra of the rectangles seed. -/
theorem pluckerRing_map_le_clusterAlgebraOfSeed_rectanglesSeed (ha : 2 ≤ a) (hab : a + 2 ≤ b)
    (L : RectangleLabelling a b m n) :
    (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) ≤
      clusterAlgebraOfSeed ℂ L.le (rectanglesSeed L) := by
  rw [pluckerRing_eq_adjoin_pluckerCoord a b (by omega) (by omega), AlgHom.map_adjoin]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨_, ⟨J, hJ, rfl⟩, rfl⟩
  obtain ⟨P, hP, hP₀⟩ := exists_isSeedPattern (K := ℂ) L.le RegularTree.root
    (isLabeledSeed_rectanglesSeed (by omega) (by omega) L)
  obtain ⟨t, i, hti⟩ := L.exists_extCluster_eq_pluckerCoord ha hab hP hP₀ hJ
  obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_extCluster_eq_coe L.le hP₀ t i
  have h := extCluster_seedMutationSeq_mem_clusterAlgebraOfSeed ℂ L.le (rectanglesSeed L) s i
  rwa [← hs, hti] at h

/-- Let `2 ≤ a ≤ b - 2` and let `λ` be a rectangle labelling. Then `R_{a,b} ⊆ 𝒜(Σ_{a,b}(λ))`.

Here `Σ_{a,b}(λ)` is read as a labeled seed in the subfield of `ℂ(z)` generated by its entries,
and both sides are compared inside `ℂ(z)`. -/
@[cluster_algebras "lem_plucker_in_cluster"]
theorem pluckerRing_map_le_map_val_clusterAlgebraOfSeed_rectanglesSeed (ha : 2 ≤ a)
    (hab : a + 2 ≤ b) (L : RectangleLabelling a b m n) :
    (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) ≤
      (clusterAlgebraOfSeed ℂ L.le ((rectanglesSeed L).adjoinSelf ℂ)).map
        (IntermediateField.val _) := by
  rw [clusterAlgebraOfSeed_map, SeedData.map_val_adjoinSelf]
  exact pluckerRing_map_le_clusterAlgebraOfSeed_rectanglesSeed ha hab L

/-! ### `𝒜(Σ_{a,b}(λ)) = R_{a,b}` -/

/-- **`𝒜(Σ_{a,b}(λ)) = R_{a,b}`, read in `ℂ(z)`.** For `2 ≤ a ≤ b - 2` and a rectangle labelling
`λ`, the cluster algebra of the rectangles seed, a subalgebra of `ℂ(z)`, is the image of the
Plücker ring. -/
theorem clusterAlgebraOfSeed_rectanglesSeed (ha : 2 ≤ a) (hab : a + 2 ≤ b)
    (L : RectangleLabelling a b m n) :
    clusterAlgebraOfSeed ℂ L.le (rectanglesSeed L) =
      (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) :=
  le_antisymm (clusterAlgebraOfSeed_rectanglesSeed_le_pluckerRing (by omega) (by omega) L)
    (pluckerRing_map_le_clusterAlgebraOfSeed_rectanglesSeed ha hab L)

/-- Let `2 ≤ a ≤ b - 2` and let `λ` be a rectangle labelling. Then `𝒜(Σ_{a,b}(λ)) = R_{a,b}`.

Here `Σ_{a,b}(λ)` is read as a labeled seed in the subfield of `ℂ(z)` generated by its entries
(`isLabeledSeed_rectanglesSeed`), and its cluster algebra is compared with `R_{a,b}` inside
`ℂ(z)`. -/
@[cluster_algebras "thm_grassmannian_cluster_algebra"]
theorem map_val_clusterAlgebraOfSeed_rectanglesSeed (ha : 2 ≤ a) (hab : a + 2 ≤ b)
    (L : RectangleLabelling a b m n) :
    (clusterAlgebraOfSeed ℂ L.le ((rectanglesSeed L).adjoinSelf ℂ)).map
        (IntermediateField.val _) =
      (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) := by
  rw [clusterAlgebraOfSeed_map, SeedData.map_val_adjoinSelf]
  exact clusterAlgebraOfSeed_rectanglesSeed ha hab L

/-! ### The cyclic shifts -/

/-- The rotation `ρ^j` maps the Plücker ring into itself, for `1 ≤ a ≤ b`: it sends each
generator `P_J` to the Plücker coordinate `P_{(J - j) mod b}`. -/
theorem pluckerRing_map_rotationEquiv_zpow_le (ha : 1 ≤ a) (hab : a ≤ b) (j : ℤ) :
    (pluckerRing a b).map ((rotationEquiv a b ^ j : ComplexPoly a b ≃ₐ[ℂ] ComplexPoly a b) :
      ComplexPoly a b →ₐ[ℂ] ComplexPoly a b) ≤ pluckerRing a b := by
  rw [pluckerRing_eq_adjoin_pluckerCoord a b ha hab, AlgHom.map_adjoin]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨_, ⟨J, hJ, rfl⟩, rfl⟩
  refine Algebra.subset_adjoin ⟨cyclicShift (-j) J, by rw [card_cyclicShift, hJ], ?_⟩
  exact (rotationEquiv_zpow_pluckerCoord a b j J).symm

/-- **The rotation preserves the Plücker ring**: `ρ^j(R_{a,b}) = R_{a,b}` for every `j ∈ ℤ`
and `1 ≤ a ≤ b`. -/
theorem pluckerRing_map_rotationEquiv_zpow (ha : 1 ≤ a) (hab : a ≤ b) (j : ℤ) :
    (pluckerRing a b).map ((rotationEquiv a b ^ j : ComplexPoly a b ≃ₐ[ℂ] ComplexPoly a b) :
      ComplexPoly a b →ₐ[ℂ] ComplexPoly a b) = pluckerRing a b := by
  refine le_antisymm (pluckerRing_map_rotationEquiv_zpow_le ha hab j) fun f hf => ?_
  refine ⟨(rotationEquiv a b ^ (-j)) f,
    pluckerRing_map_rotationEquiv_zpow_le ha hab (-j) ⟨f, hf, rfl⟩, ?_⟩
  change (rotationEquiv a b ^ j) ((rotationEquiv a b ^ (-j)) f) = f
  rw [← AlgEquiv.mul_apply, ← zpow_add, add_neg_cancel, zpow_zero, AlgEquiv.one_apply]

/-- `ρ^j(R_{a,b}) = R_{a,b}`, for `ρ^j` extended to `ℂ(z)` and `R_{a,b}` read in `ℂ(z)`. -/
theorem pluckerRing_map_map_rotationFieldEquiv (ha : 1 ≤ a) (hab : a ≤ b) (j : ℤ) :
    ((pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b)))).map
        (rotationFieldEquiv a b j : FractionRing (ComplexPoly a b) →ₐ[ℂ]
          FractionRing (ComplexPoly a b)) =
      (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) := by
  conv_rhs => rw [← pluckerRing_map_rotationEquiv_zpow ha hab j]
  rw [Subalgebra.map_map, Subalgebra.map_map]
  congr 1
  exact AlgHom.ext fun f => IsFractionRing.fieldEquivOfAlgEquiv_algebraMap ℂ _ _ _ f

/-- **`𝒜(Σ^i_{a,b}(λ)) = R_{a,b}`, read in `ℂ(z)`.** For `2 ≤ a ≤ b - 2`, a rectangle labelling
`λ` and `i ∈ ℤ`, the cluster algebra of the cyclic shift `Σ^i_{a,b}(λ)`, a subalgebra of `ℂ(z)`,
is the image of the Plücker ring. The rotation `ρ^{-i}` carries `Σ_{a,b}(λ)` to `Σ^i_{a,b}(λ)` and
the Plücker ring onto itself. -/
theorem clusterAlgebraOfSeed_rectanglesSeedShift (ha : 2 ≤ a) (hab : a + 2 ≤ b)
    (L : RectangleLabelling a b m n) (i : ℤ) :
    clusterAlgebraOfSeed ℂ L.le (rectanglesSeedShift L i) =
      (pluckerRing a b).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) := by
  have h := rectanglesSeedShift_map_rotation L 0 (-i)
  rw [zero_sub, neg_neg] at h
  have h' := clusterAlgebraOfSeed_map (K := ℂ) L.le
    (rotationFieldEquiv a b (-i) : FractionRing (ComplexPoly a b) →ₐ[ℂ]
      FractionRing (ComplexPoly a b)) (rectanglesSeedShift L 0)
  rw [AlgEquiv.coe_algHom, h] at h'
  rw [← h', ← rectanglesSeed, clusterAlgebraOfSeed_rectanglesSeed ha hab L]
  exact pluckerRing_map_map_rotationFieldEquiv (by omega) (by omega) (-i)

/-- Let `2 ≤ a ≤ b - 2`, let `λ` be a rectangle labelling and `i ∈ ℤ`. Then `Σ^i_{a,b}(λ)` is a
labeled seed over `ℂ` in the subfield of `ℂ(z)` generated by its entries, and
`𝒜(Σ^i_{a,b}(λ)) = R_{a,b}`, compared inside `ℂ(z)`. -/
@[cluster_algebras "thm_grassmannian_cyclic_shifts"]
theorem isLabeledSeed_rectanglesSeedShift_and_map_val_clusterAlgebraOfSeed (ha : 2 ≤ a)
    (hab : a + 2 ≤ b) (L : RectangleLabelling a b m n) (i : ℤ) :
    IsLabeledSeed ℂ L.le ((rectanglesSeedShift L i).adjoinSelf ℂ) ∧
      (clusterAlgebraOfSeed ℂ L.le ((rectanglesSeedShift L i).adjoinSelf ℂ)).map
          (IntermediateField.val _) =
        (pluckerRing a b).map
          (IsScalarTower.toAlgHom ℂ (ComplexPoly a b) (FractionRing (ComplexPoly a b))) := by
  refine ⟨isLabeledSeed_rectanglesSeedShift (by omega) (by omega) L i, ?_⟩
  rw [clusterAlgebraOfSeed_map, SeedData.map_val_adjoinSelf]
  exact clusterAlgebraOfSeed_rectanglesSeedShift ha hab L i

end ClusterAlgebras
