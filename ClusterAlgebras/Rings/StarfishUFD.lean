/-!
# The Starfish lemma for factorial rings

Let `𝕜` be a field of characteristic zero and `R` a `𝕜`-algebra that is an integral domain, with
fraction field `Frac(R)`. A seed "in the fraction field" is a labeled seed in a subfield
`F ⊆ Frac(R)` containing `𝕜`. The Starfish lemma gives a criterion for the cluster algebra
`𝒜(x̃, B̃)` of such a seed to lie in `R`, by checking the seed and its `n` neighbours only.

The Laurent phenomenon, in its sharp form, places every cluster variable in the localization
`R_P` of `R` at any prime ideal `P` not containing the product of the cluster variables of one
seed whose entries lie in `R`. In a factorial ring an element of `Frac(R)` lying in `R_(p)` for
every prime element `p` lies in `R`. The two together give the Starfish lemma for factorial rings,
and its corollary for seeds whose cluster variables and their exchanged partners are irreducible.

## Main results

* `ClusterAlgebras.IsSeedPattern.exists_mul_eq_of_prod_notMem`: if the entries of `x̃(t₁)` lie in
  `R` and `x_{1;t₁} ⋯ x_{n;t₁} ∉ P`, every cluster variable of the pattern lies in `R_P`.
* `ClusterAlgebras.mem_range_algebraMap_of_forall_prime`: a factorial ring is the intersection of
  its localizations at the ideals generated by prime elements.
* `ClusterAlgebras.mem_range_algebraMap_of_mem_clusterAlgebraOfSeed`: the Starfish lemma for
  factorial rings.
* `ClusterAlgebras.mem_range_algebraMap_of_mem_clusterAlgebraOfSeed_of_irreducible`: the Starfish
  lemma with irreducible cluster variables.
* `ClusterAlgebras.exists_finite_adjoin_eq_clusterAlgebra`: a finitely generated cluster algebra
  is generated by finitely many of its cluster and frozen variables.

## Implementation notes

* "`y ∈ R`", for `y ∈ Frac(R)`, is `y ∈ Set.range (algebraMap R (Frac R))`. "`y ∈ R_P`", for a
  prime ideal `P`, is `y = a / b` with `a, b ∈ R` and `b ∉ P`, written `y * b = a`; for a prime
  element `p` the ideal is `(p) = Ideal.span {p}`.
* "The entries of a tuple `x̃` of elements of `F` lie in `R`" is stated by giving their preimages:
  a tuple `x` of elements of `R` with `x i = x̃ i` in `Frac(R)`. As `R → Frac(R)` is injective
  these preimages are unique, and divisibility and primality conditions on the entries are stated
  for them. Likewise the entries `x'_k` of the mutated seeds `μ_k(x̃, B̃)` in position `k` are
  given by preimages `x' k ∈ R`.
* The conclusion `𝒜(x̃, B̃) ⊆ R` reads every element of `𝒜(x̃, B̃) ⊆ F` in `Frac(R)`.
* `mem_range_algebraMap_of_mem_clusterAlgebraOfSeed_of_irreducible` carries two hypotheses
  absent from the cluster criterion of [FWZ]: that the frozen variables lie in `R`, and that
  every unit of `R` is a scalar. It needs no finite generation.
* `exists_finite_adjoin_eq_clusterAlgebra` is stated for any assignment of seeds to the vertices
  of `𝕋ₙ`; the seed pattern condition is not used.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to cluster algebras*, Chapter 6,
  Section 6.4.
-/

@[expose] public section

namespace ClusterAlgebras

/-! ### Localizations at primes, and the factorial case -/

section Localization

variable {R : Type*} [CommRing R] [IsDomain R]

/-- The localization `R_p` of `R` at a prime ideal `p`, as a subring of `Frac(R)`: the elements
`a / b` with `a, b ∈ R` and `b ∉ p`. -/
private def primeLocalizationSubring (p : Ideal R) [hp : p.IsPrime] :
    Subring (FractionRing R) where
  carrier := {y | ∃ a b : R, b ∉ p ∧
    y * algebraMap R (FractionRing R) b = algebraMap R (FractionRing R) a}
  zero_mem' := ⟨0, 1, hp.one_notMem, by simp⟩
  one_mem' := ⟨1, 1, hp.one_notMem, by simp⟩
  add_mem' := by
    rintro y y' ⟨a, b, hb, h⟩ ⟨a', b', hb', h'⟩
    refine ⟨a * b' + a' * b, b * b', fun h => (hp.mem_or_mem h).elim hb hb', ?_⟩
    simp only [map_add, map_mul, ← h, ← h']
    ring
  mul_mem' := by
    rintro y y' ⟨a, b, hb, h⟩ ⟨a', b', hb', h'⟩
    refine ⟨a * a', b * b', fun h => (hp.mem_or_mem h).elim hb hb', ?_⟩
    simp only [map_mul, ← h, ← h']
    ring
  neg_mem' := by
    rintro y ⟨a, b, hb, h⟩
    exact ⟨-a, b, hb, by simp [← h]⟩

/-- **A factorial ring is the intersection of its localizations at primes.** Let `R` be a
unique factorization domain, and let `y ∈ Frac(R)` lie in `R_(p)` for every prime element `p` of
`R`. Then `y ∈ R`. -/
@[cluster_algebras "lem_ufd_intersection"]
theorem mem_range_algebraMap_of_forall_prime [UniqueFactorizationMonoid R] (y : FractionRing R)
    (hy : ∀ p : R, Prime p → ∃ a b : R, b ∉ Ideal.span {p} ∧
      y * algebraMap R (FractionRing R) b = algebraMap R (FractionRing R) a) :
    y ∈ Set.range (algebraMap R (FractionRing R)) := by
  by_cases hd : IsUnit (IsFractionRing.den R y : R)
  · exact IsFractionRing.isInteger_of_isUnit_den hd
  exfalso
  obtain ⟨p, hp, hpd⟩ :=
    WfDvdMonoid.exists_irreducible_factor hd (nonZeroDivisors.coe_ne_zero _)
  have hp' : Prime p := UniqueFactorizationMonoid.irreducible_iff_prime.1 hp
  obtain ⟨a, b, hb, hab⟩ := hy p hp'
  rw [Ideal.mem_span_singleton] at hb
  have hyd := IsLocalization.mk'_spec (FractionRing R) (IsFractionRing.num R y)
    (IsFractionRing.den R y)
  rw [IsFractionRing.mk'_num_den] at hyd
  have hcb : IsFractionRing.num R y * b = (IsFractionRing.den R y : R) * a := by
    apply IsFractionRing.injective R (FractionRing R)
    rw [map_mul, map_mul, ← hyd, ← hab]
    ring
  have hpc : p ∣ IsFractionRing.num R y :=
    (hp'.dvd_or_dvd (hcb ▸ dvd_mul_of_dvd_left hpd a)).resolve_right hb
  exact hp'.not_unit (IsFractionRing.num_den_reduced R y hpc hpd)

end Localization

/-! ### The Starfish lemma -/

section Starfish

variable {𝕜 R : Type*} [Field 𝕜] [CommRing R] [IsDomain R] [Algebra 𝕜 R] {m n : ℕ}

/-- **Cluster variables lie in a localization avoiding one seed.** Let `P` be a seed pattern of
rank `n` in a subfield `F ⊆ Frac(R)` over a field `𝕜` of characteristic zero, let `t₁ ∈ 𝕋ₙ` be
such that every entry of `x̃(t₁)` lies in `R` (it is the image of `x i ∈ R`), and let `p` be a
prime ideal of `R` with `x_{1;t₁} ⋯ x_{n;t₁} ∉ p`. Then every cluster variable `z` of `P` lies in
`R_p`: `z = a / b` with `a, b ∈ R` and `b ∉ p`. -/
@[cluster_algebras "lem_cluster_variables_local"]
theorem IsSeedPattern.exists_mul_eq_of_prod_notMem [CharZero 𝕜] (hmn : n ≤ m)
    {F : IntermediateField 𝕜 (FractionRing R)} {P : RegularTree n → SeedData F m n}
    (hP : IsSeedPattern 𝕜 hmn P) {t₁ : RegularTree n} (x : Fin m → R)
    (hx : ∀ i, algebraMap R (FractionRing R) (x i) = (P t₁).extCluster i)
    {p : Ideal R} [hp : p.IsPrime] (hprod : ∏ i : Fin n, x (Fin.castLE hmn i) ∉ p)
    {z : F} (hz : z ∈ patternClusterVariables hmn P) :
    ∃ a b : R, b ∉ p ∧
      (z : FractionRing R) * algebraMap R (FractionRing R) b =
        algebraMap R (FractionRing R) a := by
  obtain ⟨_, ⟨t, rfl⟩, hzt⟩ := hz
  have hle : mixedLaurentSubring (P t₁).extCluster n ≤
      (primeLocalizationSubring p).comap (F.val : F →+* FractionRing R) := by
    refine Subring.closure_le.2 (Set.union_subset ?_ ?_)
    · rintro _ ⟨i, rfl⟩
      refine ⟨x i, 1, hp.one_notMem, ?_⟩
      simp [hx]
    · rintro _ ⟨i, hi, rfl⟩
      have hxi : x i ∉ p := fun h => hprod <| p.mem_of_dvd
        (Finset.dvd_prod_of_mem (fun j : Fin n => x (Fin.castLE hmn j))
          (Finset.mem_univ ⟨i, hi⟩)) (by exact h)
      have hx0 : algebraMap R (FractionRing R) (x i) ≠ 0 := by
        rw [Ne, IsFractionRing.to_map_eq_zero_iff]
        exact fun h0 => hxi (h0 ▸ p.zero_mem)
      refine ⟨1, x i, hxi, ?_⟩
      simp [← hx, hx0]
  exact hle (hP.clusterVariables_subset_mixedLaurentSubring hmn t₁ t hzt)

/-- Let `P` be a seed pattern in a subfield `F ⊆ Frac(R)`, let `t₀ —k— t` be an edge of `𝕋ₙ`,
let the entries of `x̃(t₀)` be the images of `x i ∈ R`, and let the entry of `μₖ(x̃(t₀))` in
position `k` be the image of `y ∈ R`. Then the entries of `x̃(t)` are the images of the entries of
`x` with `y` in position `k`. -/
theorem IsSeedPattern.algebraMap_update_eq_extCluster (hmn : n ≤ m)
    {F : IntermediateField 𝕜 (FractionRing R)} {P : RegularTree n → SeedData F m n}
    (hP : IsSeedPattern 𝕜 hmn P) {k : Fin n} {t₀ t : RegularTree n} (ht : RegularTree.Adj k t₀ t)
    {x : Fin m → R} (hx : ∀ i, algebraMap R (FractionRing R) (x i) = (P t₀).extCluster i) {y : R}
    (hy : algebraMap R (FractionRing R) y =
      (seedMutation hmn (P t₀) k).extCluster (Fin.castLE hmn k)) (i : Fin m) :
    algebraMap R (FractionRing R) (Function.update x (Fin.castLE hmn k) y i) =
      (P t).extCluster i := by
  rw [hP.2 k _ _ ht]
  rcases eq_or_ne i (Fin.castLE hmn k) with rfl | hi
  · simp [hy]
  · simp [Function.update_of_ne hi, seedMutation, hx]

/-- Let `P` be a seed pattern in a subfield `F ⊆ Frac(R)` whose seed `(x̃, B̃)` at `t₀` has its
extended cluster `x̃` in `R` (the images of `x i ∈ R`). If every cluster variable of `P` lies in
`R`, then `𝒜(x̃, B̃) ⊆ R`. -/
theorem IsSeedPattern.mem_range_algebraMap_of_forall_mem_range (hmn : n ≤ m)
    {F : IntermediateField 𝕜 (FractionRing R)} {P : RegularTree n → SeedData F m n}
    (hP : IsSeedPattern 𝕜 hmn P) {t₀ : RegularTree n} (x : Fin m → R)
    (hx : ∀ i, algebraMap R (FractionRing R) (x i) = (P t₀).extCluster i)
    (hcl : ∀ z ∈ patternClusterVariables hmn P,
      (z : FractionRing R) ∈ Set.range (algebraMap R (FractionRing R)))
    {y : F} (hy : y ∈ clusterAlgebraOfSeed 𝕜 hmn (P t₀)) :
    (y : FractionRing R) ∈ Set.range (algebraMap R (FractionRing R)) := by
  rw [← hP.clusterAlgebra_eq hmn t₀] at hy
  suffices h : clusterAlgebra 𝕜 hmn P ≤
      (IsScalarTower.toAlgHom 𝕜 R (FractionRing R)).range.comap F.val from h hy
  refine Algebra.adjoin_le (Set.union_subset ?_ hcl)
  rw [hP.groundRing_eq hmn t₀]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨i, -, rfl⟩
  exact ⟨x i, hx i⟩

/-- **The Starfish lemma for factorial rings.** Let `R` be a `𝕜`-algebra that is a unique
factorization domain, `𝕜` of characteristic zero, and let `(x̃, B̃)` be a labeled seed in a
subfield `F ⊆ Frac(R)` over `𝕜`, `x̃ = (x₁, …, xₘ)`, such that
1. `x₁, …, xₘ ∈ R` (they are the images of `x i ∈ R`);
2. for all `i ≠ j` in `[1, n]`, no prime element of `R` divides both `xᵢ` and `xⱼ`;
3. for each `k ∈ [1, n]`, the entry `x'ₖ` of `μₖ(x̃, B̃)` in position `k` lies in `R` (it is the
   image of `x' k ∈ R`), and no prime element of `R` divides both `xₖ` and `x'ₖ`.

Then `𝒜(x̃, B̃) ⊆ R`. -/
@[cluster_algebras "prop_starfish_ufd"]
theorem mem_range_algebraMap_of_mem_clusterAlgebraOfSeed [CharZero 𝕜]
    [UniqueFactorizationMonoid R] (hmn : n ≤ m) {F : IntermediateField 𝕜 (FractionRing R)}
    {S : SeedData F m n} (hS : IsLabeledSeed 𝕜 hmn S)
    (x : Fin m → R) (hx : ∀ i, algebraMap R (FractionRing R) (x i) = S.extCluster i)
    (hcop : ∀ i j : Fin n, i ≠ j → ∀ p : R, Prime p →
      p ∣ x (Fin.castLE hmn i) → ¬ p ∣ x (Fin.castLE hmn j))
    (x' : Fin n → R) (hx' : ∀ k, algebraMap R (FractionRing R) (x' k) =
      (seedMutation hmn S k).extCluster (Fin.castLE hmn k))
    (hcop' : ∀ k : Fin n, ∀ p : R, Prime p → p ∣ x (Fin.castLE hmn k) → ¬ p ∣ x' k)
    {y : F} (hy : y ∈ clusterAlgebraOfSeed 𝕜 hmn S) :
    (y : FractionRing R) ∈ Set.range (algebraMap R (FractionRing R)) := by
  obtain ⟨P, hP, rfl⟩ := exists_isSeedPattern hmn RegularTree.root hS
  refine hP.mem_range_algebraMap_of_forall_mem_range hmn x hx (fun z hz => ?_) hy
  refine mem_range_algebraMap_of_forall_prime _ fun p hp => ?_
  have : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).2 hp
  by_cases h : ∃ k : Fin n, p ∣ x (Fin.castLE hmn k)
  · obtain ⟨k, hk⟩ := h
    obtain ⟨t, ht⟩ := (RegularTree.root : RegularTree n).exists_adj k
    refine hP.exists_mul_eq_of_prod_notMem hmn (Function.update x (Fin.castLE hmn k) (x' k))
      (hP.algebraMap_update_eq_extCluster hmn ht hx (hx' k)) ?_ hz
    rw [Ideal.mem_span_singleton, hp.dvd_finsetProd_iff]
    rintro ⟨j, -, hj⟩
    rcases eq_or_ne j k with rfl | hjk
    · exact hcop' _ p hp hk (by simpa using hj)
    · rw [Function.update_of_ne ((Fin.castLE_injective hmn).ne hjk)] at hj
      exact hcop k j (Ne.symm hjk) p hp hk hj
  · refine hP.exists_mul_eq_of_prod_notMem hmn x hx ?_ hz
    rw [Ideal.mem_span_singleton, hp.dvd_finsetProd_iff]
    exact fun ⟨j, _, hj⟩ => h ⟨j, hj⟩

/-- Two irreducible elements with a common prime factor differ by a nonzero scalar factor, when
every unit of `R` is a scalar. -/
private theorem exists_eq_algebraMap_mul_of_prime_dvd
    (hunit : ∀ u : Rˣ, ∃ c : 𝕜, algebraMap 𝕜 R c = u) {a b p : R} (ha : Irreducible a)
    (hb : Irreducible b) (hp : Prime p) (hpa : p ∣ a) (hpb : p ∣ b) :
    ∃ c : 𝕜, c ≠ 0 ∧ a = algebraMap 𝕜 R c * b := by
  obtain ⟨u, hu⟩ := (hp.irreducible.associated_of_dvd hb hpb).symm.trans
    (hp.irreducible.associated_of_dvd ha hpa)
  obtain ⟨c, hc⟩ := hunit u
  refine ⟨c, ?_, by rw [hc, ← hu, mul_comm]⟩
  rintro rfl
  exact u.ne_zero (by rw [← hc, map_zero])

/-- An equation `a = c b` in `R`, with `c ∈ 𝕜`, gives the same equation between the images of
`a` and `b` in a subfield `F ⊆ Frac(R)`. -/
private theorem eq_algebraMap_mul_of_eq {F : IntermediateField 𝕜 (FractionRing R)} {a b : R}
    {a' b' : F} (c : 𝕜) (ha : algebraMap R (FractionRing R) a = a')
    (hb : algebraMap R (FractionRing R) b = b') (h : a = algebraMap 𝕜 R c * b) :
    a' = algebraMap 𝕜 F c * b' := by
  apply Subtype.val_injective
  simp only [IntermediateField.coe_mul, ← ha, ← hb, h, map_mul, ← IsScalarTower.algebraMap_apply]
  rfl

/-- When every unit of `R` is a scalar, no prime element divides two distinct irreducible cluster
variables `xᵢ`, `xⱼ` of a labeled seed: they would differ by a scalar factor, a linear relation
between two entries of `x̃`. -/
private theorem not_dvd_of_irreducible_extCluster
    (hunit : ∀ u : Rˣ, ∃ c : 𝕜, algebraMap 𝕜 R c = u) (hmn : n ≤ m)
    {F : IntermediateField 𝕜 (FractionRing R)} {S : SeedData F m n} (hS : IsLabeledSeed 𝕜 hmn S)
    (x : Fin m → R) (hx : ∀ i, algebraMap R (FractionRing R) (x i) = S.extCluster i)
    (hirr : ∀ k : Fin n, Irreducible (x (Fin.castLE hmn k))) (i j : Fin n) (hij : i ≠ j) (p : R)
    (hp : Prime p) (hpi : p ∣ x (Fin.castLE hmn i)) : ¬ p ∣ x (Fin.castLE hmn j) := by
  classical
  intro hpj
  obtain ⟨c, -, hc⟩ := exists_eq_algebraMap_mul_of_prime_dvd hunit (hirr i) (hirr j) hp hpi hpj
  have h := eq_algebraMap_mul_of_eq c (hx _) (hx _) hc
  have hij' : Fin.castLE hmn i ≠ Fin.castLE hmn j := (Fin.castLE_injective hmn).ne hij
  have h0 := (injective_iff_map_eq_zero _).1 hS.1.1 (MvPolynomial.X (Fin.castLE hmn i) -
    MvPolynomial.C c * MvPolynomial.X (Fin.castLE hmn j)) (by simp [h])
  have := congrArg (MvPolynomial.coeff (Finsupp.single (Fin.castLE hmn i) 1)) h0
  simp [MvPolynomial.coeff_X, Finsupp.single_left_inj, hij'.symm] at this

/-- When every unit of `R` is a scalar, no prime element divides both an irreducible cluster
variable `xₖ` of a labeled seed and the irreducible entry `x'ₖ` of `μₖ(x̃, B̃)` in position `k`:
`x'ₖ = c xₖ` would turn the exchange relation into an algebraic relation `c xₖ² = M⁺ₖ + M⁻ₖ`
among the entries of `x̃`. -/
private theorem not_dvd_exchanged_of_irreducible
    (hunit : ∀ u : Rˣ, ∃ c : 𝕜, algebraMap 𝕜 R c = u) (hmn : n ≤ m)
    {F : IntermediateField 𝕜 (FractionRing R)} {S : SeedData F m n} (hS : IsLabeledSeed 𝕜 hmn S)
    (x : Fin m → R) (hx : ∀ i, algebraMap R (FractionRing R) (x i) = S.extCluster i)
    (hirr : ∀ k : Fin n, Irreducible (x (Fin.castLE hmn k)))
    (x' : Fin n → R) (hx' : ∀ k, algebraMap R (FractionRing R) (x' k) =
      (seedMutation hmn S k).extCluster (Fin.castLE hmn k))
    (hirr' : ∀ k : Fin n, Irreducible (x' k)) (k : Fin n) (p : R) (hp : Prime p)
    (hpk : p ∣ x (Fin.castLE hmn k)) : ¬ p ∣ x' k := by
  classical
  intro hpk'
  set a := Fin.castLE hmn k
  set B := S.extExchangeMatrix
  obtain ⟨c, hc0, hc⟩ :=
    exists_eq_algebraMap_mul_of_prime_dvd hunit (hirr' k) (hirr k) hp hpk' hpk
  have h := eq_algebraMap_mul_of_eq c (hx' k) (hx _) hc
  have hxa : S.extCluster a ≠ 0 := by
    intro h0
    apply (hirr k).ne_zero
    apply IsFractionRing.injective R (FractionRing R)
    rw [hx, h0, map_zero, ZeroMemClass.coe_zero]
  have hrel : algebraMap 𝕜 F c * S.extCluster a ^ 2 =
      ∏ i, S.extCluster i ^ (B i k).toNat + ∏ i, S.extCluster i ^ (-B i k).toNat := by
    rw [← exchangeMonomialPos_eq_prod, ← exchangeMonomialNeg_eq_prod, pow_two, ← mul_assoc,
      ← h]
    simp [seedMutation, a, B, div_mul_cancel₀ _ hxa]
  let ep : Fin m →₀ ℕ := Finsupp.equivFunOnFinite.symm fun i => (B i k).toNat
  let en : Fin m →₀ ℕ := Finsupp.equivFunOnFinite.symm fun i => (-B i k).toNat
  have hmono : ∀ e : Fin m →₀ ℕ,
      MvPolynomial.aeval S.extCluster (MvPolynomial.monomial e (1 : 𝕜)) =
        ∏ i, S.extCluster i ^ e i := fun e => by
    rw [MvPolynomial.aeval_monomial, map_one, one_mul,
      Finsupp.prod_fintype _ _ fun i => pow_zero _]
  have hBkk : B a k = 0 := hS.extExchangeMatrix_castLE_self hmn k
  have hep : ep ≠ Finsupp.single a 2 := fun he => by
    simpa [ep, hBkk] using DFunLike.congr_fun he a
  have hen : en ≠ Finsupp.single a 2 := fun he => by
    simpa [en, hBkk] using DFunLike.congr_fun he a
  have h0 := (injective_iff_map_eq_zero _).1 hS.1.1 (MvPolynomial.C c * MvPolynomial.X a ^ 2 -
    (MvPolynomial.monomial ep 1 + MvPolynomial.monomial en 1)) (by
      rw [map_sub, map_add, hmono, hmono]
      simpa [ep, en, sub_eq_zero] using hrel)
  have := congrArg (MvPolynomial.coeff (Finsupp.single a 2)) h0
  simp [MvPolynomial.coeff_monomial, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_pow,
    hep, hen, hc0] at this

/-- **The Starfish lemma with irreducible cluster variables.** Let `R` be a `𝕜`-algebra that is a
unique factorization domain whose units all lie in `𝕜`, `𝕜` of characteristic zero, and let
`(x̃, B̃)` be a labeled seed in a subfield `F ⊆ Frac(R)` over `𝕜`, `x̃ = (x₁, …, xₘ)`, such that
`x₁, …, xₘ ∈ R` (they are the images of `x i ∈ R`), and for every `k ∈ [1, n]` the elements `xₖ`
and `x'ₖ` are irreducible in `R`, where `x'ₖ` (the image of `x' k ∈ R`) is the entry of
`μₖ(x̃, B̃)` in position `k`. Then `𝒜(x̃, B̃) ⊆ R`. -/
@[cluster_algebras "prop_starfish_irreducible"]
theorem mem_range_algebraMap_of_mem_clusterAlgebraOfSeed_of_irreducible [CharZero 𝕜]
    [UniqueFactorizationMonoid R] (hunit : ∀ u : Rˣ, ∃ c : 𝕜, algebraMap 𝕜 R c = u)
    (hmn : n ≤ m) {F : IntermediateField 𝕜 (FractionRing R)} {S : SeedData F m n}
    (hS : IsLabeledSeed 𝕜 hmn S)
    (x : Fin m → R) (hx : ∀ i, algebraMap R (FractionRing R) (x i) = S.extCluster i)
    (hirr : ∀ k : Fin n, Irreducible (x (Fin.castLE hmn k)))
    (x' : Fin n → R) (hx' : ∀ k, algebraMap R (FractionRing R) (x' k) =
      (seedMutation hmn S k).extCluster (Fin.castLE hmn k))
    (hirr' : ∀ k : Fin n, Irreducible (x' k))
    {y : F} (hy : y ∈ clusterAlgebraOfSeed 𝕜 hmn S) :
    (y : FractionRing R) ∈ Set.range (algebraMap R (FractionRing R)) :=
  mem_range_algebraMap_of_mem_clusterAlgebraOfSeed hmn hS x hx
    (not_dvd_of_irreducible_extCluster hunit hmn hS x hx hirr) x' hx'
    (not_dvd_exchanged_of_irreducible hunit hmn hS x hx hirr x' hx' hirr') hy

end Starfish

/-! ### Finitely generated cluster algebras -/

section FiniteGeneration

/-- An element of the subalgebra generated by a set lies in the subalgebra generated by a finite
subset of it. -/
private theorem exists_finite_subset_mem_adjoin {K A : Type*} [CommSemiring K] [CommSemiring A]
    [Algebra K A] {W : Set A} {y : A} (hy : y ∈ Algebra.adjoin K W) :
    ∃ Z ⊆ W, Z.Finite ∧ y ∈ Algebra.adjoin K Z := by
  induction hy using Algebra.adjoin_induction with
  | mem y hy => exact ⟨{y}, Set.singleton_subset_iff.2 hy, Set.finite_singleton y,
      Algebra.subset_adjoin rfl⟩
  | algebraMap r => exact ⟨∅, Set.empty_subset _, Set.finite_empty, Subalgebra.algebraMap_mem _ r⟩
  | add y y' _ _ h h' =>
    obtain ⟨Z, hZW, hZ, hyZ⟩ := h
    obtain ⟨Z', hZW', hZ', hyZ'⟩ := h'
    exact ⟨Z ∪ Z', Set.union_subset hZW hZW', hZ.union hZ',
      add_mem (Algebra.adjoin_mono Set.subset_union_left hyZ)
        (Algebra.adjoin_mono Set.subset_union_right hyZ')⟩
  | mul y y' _ _ h h' =>
    obtain ⟨Z, hZW, hZ, hyZ⟩ := h
    obtain ⟨Z', hZW', hZ', hyZ'⟩ := h'
    exact ⟨Z ∪ Z', Set.union_subset hZW hZW', hZ.union hZ',
      mul_mem (Algebra.adjoin_mono Set.subset_union_left hyZ)
        (Algebra.adjoin_mono Set.subset_union_right hyZ')⟩

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

/-- **A finitely generated cluster algebra is generated by finitely many of its variables.** If
the cluster algebra `𝒜` of the seed assignment `P` is finitely generated as a `K`-algebra, there
is a finite set `Z` of frozen and cluster variables of `P` that generates `𝒜` as a `K`-algebra. -/
@[cluster_algebras "prop_finitely_generated_cluster_variables"]
theorem exists_finite_adjoin_eq_clusterAlgebra (hmn : n ≤ m) (P : RegularTree n → SeedData F m n)
    (h : (clusterAlgebra K hmn P).FG) :
    ∃ Z : Set F, Z.Finite ∧ Z ⊆ (⋃ t, frozenVariables (P t)) ∪ patternClusterVariables hmn P ∧
      Algebra.adjoin K Z = clusterAlgebra K hmn P := by
  obtain ⟨T, hT, hTA⟩ := Subalgebra.fg_def.1 h
  rw [clusterAlgebra_eq_adjoin_frozenVariables_union] at hTA ⊢
  have hmem : ∀ t ∈ T, ∃ Z ⊆ (⋃ t, frozenVariables (P t)) ∪ patternClusterVariables hmn P,
      Z.Finite ∧ t ∈ Algebra.adjoin K Z := fun t ht =>
    exists_finite_subset_mem_adjoin (hTA ▸ Algebra.subset_adjoin ht)
  choose! Z hZW hZ htZ using hmem
  refine ⟨⋃ t ∈ T, Z t, hT.biUnion hZ, Set.iUnion₂_subset hZW, le_antisymm
    (Algebra.adjoin_le ((Set.iUnion₂_subset hZW).trans Algebra.subset_adjoin)) ?_⟩
  rw [← hTA]
  exact Algebra.adjoin_le fun t ht =>
    Algebra.adjoin_mono (Set.subset_biUnion_of_mem (u := Z) ht) (htZ t ht)

end FiniteGeneration

end ClusterAlgebras
