/-!
# `ℂ[SL_k]^U` is a cluster algebra

Let `k ≥ 3`, let `D` be a wiring diagram on `k` strands and `λ` a chamber labelling of `D`. The
seed `Σ_SL(D, λ)` has entries the images `π(P_{J(λ(i))}(z))` of the chamber minors in
`ℂ[SL_k] = ℂ[z]/⟨det z - 1⟩`, read in the fraction field of `ℂ[SL_k]`. Its cluster algebra is the
ring `ℂ[SL_k]^U` of `U`-invariants, and it is a labeled seed in the fraction field of `ℂ[SL_k]^U`.

The cluster algebra does not depend on `(D, λ)`, since any two of these seeds are mutation
equivalent; so `D` may be taken to be the special wiring diagram `D₀`. Every iterated mutation of
`Σ(D₀, λ)^{+det z}` has its entries in `ℂ[z]^{U_k}`, by the Starfish lemma; applying `π`, which
sends `det z` to `1`, carries these mutations to those of `Σ_SL(D₀, λ)`, whose entries are thus
images of `U`-invariant polynomials, hence lie in `ℂ[SL_k]^U`. Conversely `ℂ[SL_k]^U` is generated
by the images of the flag minors, each of which is a chamber minor of some wiring diagram, hence
an entry of a seed mutation equivalent to `Σ_SL(D₀, λ)`.

## Main results

* `ClusterAlgebras.extCluster_seedMutationSeq_mem_clusterAlgebraOfSeed`: every entry of every
  iterated mutation `μₛ(S)` lies in the cluster algebra `𝒜(S)`.
* `ClusterAlgebras.clusterAlgebraOfSeed_slWiringSeed_eq`: `𝒜(Σ_SL(D, λ))` does not depend on
  `(D, λ)`.
* `ClusterAlgebras.clusterAlgebraOfSeed_map_slWiringSeed`: `𝒜(Σ_SL(D, λ)) = ℂ[SL_k]^U`, as
  subalgebras of `Frac(ℂ[SL_k])`.
* `ClusterAlgebras.map_val_clusterAlgebraOfSeed_slWiringSeed`: the same, for the seed read in the
  field its entries generate.
* `ClusterAlgebras.adjoin_range_slWiringSeed_eq`: the entries of `Σ_SL(D, λ)` generate the
  subfield of `Frac(ℂ[SL_k])` generated by `ℂ[SL_k]^U`.
* `ClusterAlgebras.exists_isLabeledSeed_slWiringSeed`: `Σ_SL(D, λ)` is a labeled seed in the
  fraction field of `ℂ[SL_k]^U`.

## Implementation notes

* `Σ_SL(D, λ)` is `(slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord k)))`, a seed in
  `Frac(ℂ[SL_k])`; as a labeled seed it lives in the subfield its entries generate, as
  `SeedData.adjoinSelf ℂ`. Its cluster algebra is a subalgebra of that subfield, and the theorem
  `𝒜(Σ_SL(D, λ)) = ℂ[SL_k]^U` compares the two inside `Frac(ℂ[SL_k])`: the cluster algebra is
  mapped there by the inclusion of the subfield, and `ℂ[SL_k]^U ⊆ ℂ[SL_k]` by `algebraMap`, which
  is injective since `ℂ[SL_k]` is a domain.
* The fraction field of `ℂ[SL_k]^U` is taken to be the subfield of `Frac(ℂ[SL_k])` generated by
  the image of `ℂ[SL_k]^U`; it is a fraction field of `ℂ[SL_k]^U`, the inclusion being injective.
* Rather than transporting a seed pattern through `Σ(D₀, λ)^{+det z}` to `Frac(ℂ[SL_k])` along
  `π`, with a trivialization deleting the position of `det z`, the induction is run directly
  along the mutation sequences from `Σ(D₀, λ)` (`exists_seedMutationSeq_slWiringSeed`), using
  that mutation commutes with adding the dummy variable `det z`: no seed pattern, and no
  trivialization, is needed.
* A wiring diagram of `WiringDiagram n'` has `k = n' + 2` strands, so `k ≥ 3` is `1 ≤ n'`.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 6.
-/

@[expose] public section

namespace ClusterAlgebras

/-! ### Generalities -/

section General

variable (K : Type*) {F : Type*} [Field K] [Field F] [Algebra K F] {m n : ℕ}

/-- **Every entry of every iterated mutation lies in the cluster algebra**: an entry of `μₛ(S)`
is a cluster variable of `μₛ(S)` or a frozen variable of `S`. -/
theorem extCluster_seedMutationSeq_mem_clusterAlgebraOfSeed (hmn : n ≤ m) (S : SeedData F m n)
    (s : List (Fin n)) (i : Fin m) :
    (seedMutationSeq hmn S s).extCluster i ∈ clusterAlgebraOfSeed K hmn S := by
  refine Algebra.subset_adjoin ?_
  by_cases hi : (i : ℕ) < n
  · exact Or.inr (Set.mem_iUnion.2 ⟨s, ⟨i, hi⟩, rfl⟩)
  · rw [← frozenVariables_seedMutationSeq hmn S s]
    exact Or.inl ⟨i, not_lt.1 hi, rfl⟩

variable {K} in
/-- The cluster algebra `𝒜(S)` lies in a subalgebra `A` as soon as every entry of every iterated
mutation `μₛ(S)` does. -/
theorem clusterAlgebraOfSeed_le_of_forall (hmn : n ≤ m) {S : SeedData F m n}
    {A : Subalgebra K F} (h : ∀ s i, (seedMutationSeq hmn S s).extCluster i ∈ A) :
    clusterAlgebraOfSeed K hmn S ≤ A := by
  refine Algebra.adjoin_le (Set.union_subset ?_ (Set.iUnion_subset fun s => ?_))
  · rintro _ ⟨i, -, rfl⟩
    exact h [] i
  · rintro _ ⟨j, rfl⟩
    exact h s _

omit [Field K] [Algebra K F] in
/-- **Mutation along a sequence commutes with adding dummy frozen variables**:
`μₛ((x̃, B̃)^{+z}) = (μₛ(x̃, B̃))^{+z}`. -/
theorem seedMutationSeq_extendDummy {d : ℕ} (hmn : n ≤ m) (h : n ≤ m + d) (S : SeedData F m n)
    (z : Fin d → F) (s : List (Fin n)) :
    seedMutationSeq h (S.extendDummy z) s = (seedMutationSeq hmn S s).extendDummy z := by
  induction s generalizing S with
  | nil => rfl
  | cons k s ih =>
    rw [seedMutationSeq_cons, seedMutationSeq_cons, seedMutation_extendDummy hmn h, ih]

variable {K} in
/-- **A labeled seed carried along an isomorphism of fields is a labeled seed.** -/
theorem IsLabeledSeed.map_algEquiv {F' : Type*} [Field F'] [Algebra K F'] (hmn : n ≤ m)
    {S : SeedData F m n} (hS : IsLabeledSeed K hmn S) (e : F ≃ₐ[K] F') :
    IsLabeledSeed K hmn (S.map e) := by
  refine ⟨⟨hS.1.1.map' (f := (e : F →ₐ[K] F')) e.injective, ?_⟩, hS.2⟩
  change IntermediateField.adjoin K (Set.range ((e : F →ₐ[K] F') ∘ S.extCluster)) = ⊤
  rw [Set.range_comp, ← IntermediateField.adjoin_map, hS.1.2, ← AlgHom.fieldRange_eq_map]
  exact AlgHom.fieldRange_eq_top.2 e.surjective

end General

/-! ### The cluster algebra of `Σ_SL(D, λ)` -/

section SL

variable {n' m n : ℕ}

/-- **The iterated mutations of `Σ(D₀, λ)` have entries in `ℂ[z]^{U_k}`.** Every entry of
`μₛ(Σ(D₀, λ))`, for the special wiring diagram `D₀`, is a polynomial invariant under the lower
unitriangular matrices, read in `ℂ(z)`: it is an entry of `μₛ(Σ(D₀, λ)^{+det z})`, which lies in
`𝒜(Σ(D₀, λ)^{+det z}) ⊆ ℂ[z]^{U_k}`. -/
theorem extCluster_seedMutationSeq_wiringSeed_special_mem
    (L : Labelling (specialWiringDiagram n').wiringQuiver m n) (s : List (Fin n)) (i : Fin m) :
    (seedMutationSeq L.le (wiringSeed (specialWiringDiagram n') L) s).extCluster i ∈
      (invariants (n' + 2) (lowerUnitriangular (n' + 2))).map
        (IsScalarTower.toAlgHom ℂ (ComplexPoly (n' + 2) (n' + 2))
          (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) := by
  rw [← SeedData.extendDummy_extCluster_castAdd _ _ i,
    ← seedMutationSeq_extendDummy L.le (L.le.trans (Nat.le_add_right m 1))]
  exact clusterAlgebraOfSeed_wiringSeedDet_le L
    (extCluster_seedMutationSeq_mem_clusterAlgebraOfSeed ℂ _ _ s _)

/-- **Transporting the mutations of `Σ(D₀, λ)` to `SL_k`.** For every sequence `s` there is a
seed `T` with entries in `ℂ[z]^{U_k}` such that `μₛ(Σ(D₀, λ))` is `T` read in `ℂ(z)` and
`μₛ(Σ_SL(D₀, λ))` is `T` read in `Frac(ℂ[SL_k])` along `π`. -/
theorem exists_seedMutationSeq_slWiringSeed
    (L : Labelling (specialWiringDiagram n').wiringQuiver m n) (s : List (Fin n)) :
    ∃ T : SeedData (ComplexPoly (n' + 2) (n' + 2)) m n,
      (∀ i, T.extCluster i ∈ invariants (n' + 2) (lowerUnitriangular (n' + 2))) ∧
      seedMutationSeq L.le (wiringSeed (specialWiringDiagram n') L) s =
        T.map (algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) ∧
      seedMutationSeq L.le ((slWiringSeed (specialWiringDiagram n') L).map
          (algebraMap _ (FractionRing (SLCoord (n' + 2))))) s =
        T.map ((algebraMap (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))).comp
          (slQuot (n' + 2)).toRingHom) := by
  have hg : Function.Injective (algebraMap (ComplexPoly (n' + 2) (n' + 2))
      (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) := IsFractionRing.injective _ _
  let ψ : ComplexPoly (n' + 2) (n' + 2) →+* FractionRing (SLCoord (n' + 2)) :=
    (algebraMap (SLCoord (n' + 2)) _).comp (slQuot (n' + 2)).toRingHom
  have hlab := isLabeledSeed_slWiringSeed (specialWiringDiagram n') L
  induction s using List.reverseRecOn with
  | nil =>
    exact ⟨polyWiringSeed _ L, fun i => flagMinor_mem_invariants _, rfl, rfl⟩
  | append_singleton s k ih =>
    obtain ⟨T, -, hTg, hTψ⟩ := ih
    choose f hf hfg using fun i => Subalgebra.mem_map.1
      (extCluster_seedMutationSeq_wiringSeed_special_mem L (s ++ [k]) i)
    let T' : SeedData (ComplexPoly (n' + 2) (n' + 2)) m n :=
      ⟨f, (seedMutationSeq L.le (wiringSeed _ L) (s ++ [k])).extExchangeMatrix⟩
    have hT'g : T'.map (algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) =
        seedMutationSeq L.le (wiringSeed (specialWiringDiagram n') L) (s ++ [k]) :=
      SeedData.ext (funext hfg) rfl
    have hstep : T'.map (algebraMap _ (FractionRing (ComplexPoly (n' + 2) (n' + 2)))) =
        seedMutation L.le (T.map (algebraMap _ _)) k := by
      rw [hT'g, seedMutationSeq_append, hTg]
      rfl
    have hφ : ψ (T.extCluster (Fin.castLE L.le k)) ≠ 0 := by
      have hne := (hlab.seedMutationSeq L.le s).1.1.ne_zero (Fin.castLE L.le k)
      have heq := congrArg (fun S' => S'.extCluster (Fin.castLE L.le k))
        ((seedMutationSeq_map L.le (IntermediateField.val _)
          (((slWiringSeed (specialWiringDiagram n') L).map
            (algebraMap _ (FractionRing (SLCoord (n' + 2))))).adjoinSelf ℂ) s).trans
          (congrArg (fun S' => seedMutationSeq L.le S' s) (SeedData.map_val_adjoinSelf ℂ _)))
      change (T.map ψ).extCluster (Fin.castLE L.le k) ≠ 0
      rw [← hTψ, ← heq, SeedData.map_extCluster, Function.comp_apply]
      exact (map_ne_zero _).2 hne
    refine ⟨T', hf, hT'g.symm, ?_⟩
    rw [map_eq_seedMutation_map L.le hg ψ hstep hφ, seedMutationSeq_append, hTψ]
    rfl

/-- **`𝒜(Σ_SL(D₀, λ)) ⊆ ℂ[SL_k]^U`.** For the special wiring diagram `D₀`, every entry of every
iterated mutation of `Σ_SL(D₀, λ)` is `π(f)` for a polynomial `f ∈ ℂ[z]^{U_k}`, and so lies in
`ℂ[SL_k]^U`. -/
theorem clusterAlgebraOfSeed_slWiringSeed_special_le
    (L : Labelling (specialWiringDiagram n').wiringQuiver m n) :
    clusterAlgebraOfSeed ℂ L.le ((slWiringSeed (specialWiringDiagram n') L).map
        (algebraMap _ (FractionRing (SLCoord (n' + 2))))) ≤
      (slUInvariants (n' + 2)).map
        (IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))) := by
  refine clusterAlgebraOfSeed_le_of_forall L.le fun s i => ?_
  obtain ⟨T, hT, -, hTψ⟩ := exists_seedMutationSeq_slWiringSeed L s
  rw [hTψ]
  refine ⟨slQuot (n' + 2) (T.extCluster i), mem_slUInvariants.2 ⟨_, rfl, fun u hu => ?_⟩, rfl⟩
  rw [mem_invariants.1 (hT i) u hu, sub_self]
  exact zero_mem _

/-- **`𝒜(Σ_SL(D, λ))` does not depend on `(D, λ)`.** For `k = n' + 2 ≥ 3`, any two wiring
diagrams `D`, `D'` with chamber labellings `λ`, `λ'` give the same cluster algebra
`𝒜(Σ_SL(D, λ)) = 𝒜(Σ_SL(D', λ'))` in `Frac(ℂ[SL_k])`: the seeds are mutation equivalent, and
mutation equivalent seeds have the same cluster algebra. -/
theorem clusterAlgebraOfSeed_slWiringSeed_eq (hk : 1 ≤ n') (D D' : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) (L' : Labelling D'.wiringQuiver m n) :
    clusterAlgebraOfSeed ℂ L.le
        ((slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2))))) =
      clusterAlgebraOfSeed ℂ L'.le
        ((slWiringSeed D' L').map (algebraMap _ (FractionRing (SLCoord (n' + 2))))) := by
  obtain ⟨S₂, hS₂, hequiv⟩ :=
    (isMutationEquivalent_slWiringSeed hk D D' L L').exists_adjoinSelf ℂ L.le
  have h := congrArg (Subalgebra.map (IntermediateField.val _))
    (hequiv.clusterAlgebraOfSeed_eq L.le (isLabeledSeed_slWiringSeed D L))
  rwa [clusterAlgebraOfSeed_map, clusterAlgebraOfSeed_map, SeedData.map_val_adjoinSelf,
    hS₂] at h

/-- **`𝒜(Σ_SL(D, λ)) = ℂ[SL_k]^U` in `Frac(ℂ[SL_k])`.** For `k = n' + 2 ≥ 3`, a wiring diagram
`D` on `k` strands and a chamber labelling `λ`, the cluster algebra of `Σ_SL(D, λ)`, a subalgebra
of `Frac(ℂ[SL_k])`, is the image of `ℂ[SL_k]^U`. -/
theorem clusterAlgebraOfSeed_map_slWiringSeed (hk : 1 ≤ n') (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    clusterAlgebraOfSeed ℂ L.le
        ((slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2))))) =
      (slUInvariants (n' + 2)).map
        (IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))) := by
  obtain ⟨-, L₀, -, -⟩ := WiringDiagram.exists_seedMutationSeq_wiringSeed_of_reflTransGen hk
    (WiringDiagram.reflTransGen_isCommutation_or_isBraidMove D (specialWiringDiagram n')) L
  rw [clusterAlgebraOfSeed_slWiringSeed_eq hk D (specialWiringDiagram n') L L₀]
  refine le_antisymm (clusterAlgebraOfSeed_slWiringSeed_special_le L₀) ?_
  rw [slUInvariants_eq_adjoin_flagMinor (n' + 2) (by omega), AlgHom.map_adjoin]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨_, ⟨J, hJ, hJ', rfl⟩, rfl⟩
  obtain ⟨E, c, hc⟩ := WiringDiagram.exists_chamberSet_eq hJ hJ'
  obtain ⟨-, LE, -, -⟩ := WiringDiagram.exists_seedMutationSeq_wiringSeed_of_reflTransGen hk
    (WiringDiagram.reflTransGen_isCommutation_or_isBraidMove D E) L
  rw [← clusterAlgebraOfSeed_slWiringSeed_eq hk E _ LE L₀]
  have he : (seedMutationSeq LE.le ((slWiringSeed E LE).map
      (algebraMap _ (FractionRing (SLCoord (n' + 2))))) []).extCluster (LE.equiv.symm c) =
        IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))
          (slQuot (n' + 2) (flagMinor (complexGenericMatrix (n' + 2) (n' + 2)) J)) := by
    rw [← hc]
    change algebraMap _ _ (slQuot (n' + 2) (flagMinor (complexGenericMatrix (n' + 2) (n' + 2))
      (LE.equiv (LE.equiv.symm c)).chamberSet)) = _
    rw [Equiv.apply_symm_apply]
    rfl
  rw [SetLike.mem_coe, ← he]
  exact extCluster_seedMutationSeq_mem_clusterAlgebraOfSeed ℂ LE.le _ [] _

/-- **`ℂ[SL_k]^U` is a cluster algebra.** Let `k = n' + 2 ≥ 3`, let `D` be a wiring diagram on
`k` strands and `λ` a chamber labelling of `D`. Then `𝒜(Σ_SL(D, λ)) = ℂ[SL_k]^U`.

Here `Σ_SL(D, λ)` is read as a labeled seed in the subfield of `Frac(ℂ[SL_k])` generated by its
entries (`isLabeledSeed_slWiringSeed`), and its cluster algebra, a subalgebra of that subfield,
is compared with `ℂ[SL_k]^U` inside `Frac(ℂ[SL_k])`. -/
@[cluster_algebras "thm_sl_u_cluster_algebra"]
theorem map_val_clusterAlgebraOfSeed_slWiringSeed (hk : 1 ≤ n') (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    (clusterAlgebraOfSeed ℂ L.le
        (((slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2))))).adjoinSelf
          ℂ)).map (IntermediateField.val _) =
      (slUInvariants (n' + 2)).map
        (IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))) := by
  rw [clusterAlgebraOfSeed_map, SeedData.map_val_adjoinSelf]
  exact clusterAlgebraOfSeed_map_slWiringSeed hk D L

/-! ### `Σ_SL(D, λ)` is a seed in the fraction field of `ℂ[SL_k]^U` -/

/-- **The entries of `Σ_SL(D, λ)` generate the fraction field of `ℂ[SL_k]^U`.** For
`k = n' + 2 ≥ 3`, the subfield of `Frac(ℂ[SL_k])` generated by the entries of `Σ_SL(D, λ)` is the
subfield generated by `ℂ[SL_k]^U`. -/
theorem adjoin_range_slWiringSeed_eq (hk : 1 ≤ n') (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    IntermediateField.adjoin ℂ (Set.range
        ((slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2))))).extCluster) =
      IntermediateField.adjoin ℂ ((slUInvariants (n' + 2)).map
        (IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))) :
          Set (FractionRing (SLCoord (n' + 2)))) := by
  refine le_antisymm (IntermediateField.adjoin_le_iff.2 ?_)
    (IntermediateField.adjoin_le_iff.2 fun y hy => ?_)
  · rintro _ ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin _ _
      ⟨_, slWiringSeed_extCluster_mem_slUInvariants D L i, rfl⟩
  · rw [SetLike.mem_coe, ← map_val_clusterAlgebraOfSeed_slWiringSeed hk D L] at hy
    obtain ⟨x, -, rfl⟩ := hy
    exact x.2

/-- **The seeds of wiring diagrams are seeds in the fraction field of `ℂ[SL_k]^U`.** Let
`k = n' + 2 ≥ 3`, let `D` be a wiring diagram on `k` strands and `λ` a chamber labelling of `D`.
Then `Σ_SL(D, λ)` is a labeled seed over `ℂ` in the fraction field of `ℂ[SL_k]^U`, the subfield of
`Frac(ℂ[SL_k])` generated by `ℂ[SL_k]^U`: there is a labeled seed in that subfield which, read in
`Frac(ℂ[SL_k])`, is `Σ_SL(D, λ)`. -/
@[cluster_algebras "thm_sl_u_seed"]
theorem exists_isLabeledSeed_slWiringSeed (hk : 1 ≤ n') (D : WiringDiagram n')
    (L : Labelling D.wiringQuiver m n) :
    ∃ S : SeedData (IntermediateField.adjoin ℂ ((slUInvariants (n' + 2)).map
        (IsScalarTower.toAlgHom ℂ (SLCoord (n' + 2)) (FractionRing (SLCoord (n' + 2)))) :
          Set (FractionRing (SLCoord (n' + 2))))) m n,
      IsLabeledSeed ℂ L.le S ∧ S.map (IntermediateField.val _) =
        (slWiringSeed D L).map (algebraMap _ (FractionRing (SLCoord (n' + 2)))) :=
  ⟨_, (isLabeledSeed_slWiringSeed D L).map_algEquiv L.le
    (IntermediateField.equivOfEq (adjoin_range_slWiringSeed_eq hk D L)), rfl⟩

end SL

end ClusterAlgebras
