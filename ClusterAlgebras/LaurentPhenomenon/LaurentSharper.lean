module

public import ClusterAlgebras.Laurent.Mixed
public import ClusterAlgebras.LaurentPhenomenon.Laurent
public import ClusterAlgebras.LaurentPhenomenon.SharperStep

/-!
# Frozen variables do not appear in denominators

Let `(x̃, B̃)` be a labeled seed in a field `F` over a field `𝕜` of characteristic zero, with
extended cluster `x̃ = (x₁, …, x_m)` of which the first `n` entries are mutable. The Laurent
phenomenon says that every entry of the extended cluster of `μ_s(x̃, B̃)` lies in
`ℤ[x̃^{±1}]`. This file sharpens it: such an entry lies in the mixed ring
`ℤ[x₁^{±1}, …, x_n^{±1}, x_{n+1}, …, x_m]`, in which the frozen variables occur only with
nonnegative exponents.

For a frozen position `r`, write `L_r = ℤ[x̃_r̂^{±1}]` for the integer Laurent polynomials in
the entries other than `x_r`. Given the Laurent phenomenon, every entry `z` in a position
`i ≠ r` of the extended cluster of `μ_s(x̃, B̃)` satisfies `z - c = x_r w` with
`c ∈ L_r ∩ ℚ_sf(x̃_r̂)` and `w` in the subring `L_r[x_r]` generated by `L_r` and `x_r`; in
particular `z ∈ L_r[x_r]`. As this holds for every frozen `r`, and `x̃` is algebraically
independent over `ℚ`, the entry `z` lies in the mixed ring. For a seed pattern, the path
between two vertices of the regular tree is a sequence of mutations, which gives the statement
for cluster variables.

## Main results

* `ClusterAlgebras.IsLabeledSeed.exists_sub_eq_mul_of_frozen`: the entry `z` in a position
  `i ≠ r` of the extended cluster of `μ_s(x̃, B̃)` satisfies `z - c = x_r w` with
  `c ∈ L_r ∩ ℚ_sf(x̃_r̂)` and `w ∈ L_r[x_r]`.
* `ClusterAlgebras.IsLabeledSeed.seedMutationSeq_extCluster_mem_mixedLaurentSubring`: the sharp
  Laurent phenomenon along a sequence of mutations.
* `ClusterAlgebras.IsSeedPattern.clusterVariables_subset_mixedLaurentSubring`: the sharp
  Laurent phenomenon for a seed pattern.

## Implementation notes

FWZ index the frozen positions by `[n + 1, m]`; here the extended cluster is indexed by
`Fin m`, so the frozen positions are the `r` with `n ≤ r`. FWZ treat the frozen
positions of the extended cluster of `μ_s(x̃, B̃)` separately, as they hold the frozen
variables; here every position is handled at once, since every entry, frozen or not, lies in
`L_r[x_r]` for each frozen `r`.

## References

* [S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras.
  Chapters 1–3*][FWZ16]
-/

@[expose] public section

namespace ClusterAlgebras

universe u v

variable {K : Type v} [Field K] {F : Type u} [Field F] [Algebra K F] [CharZero K] {m n : ℕ}

/-- **Cluster variables are polynomial in a frozen variable, with subtraction-free constant
term.** Let `(x̃, B̃)` be a labeled seed, `r` a frozen position and `L_r = ℤ[x̃_r̂^{±1}]`. For
every sequence `s` and every position `i ≠ r`, the entry `z` in position `i` of the extended
cluster of `μ_s(x̃, B̃)` satisfies `z - c = x_r w` for some `c ∈ L_r ∩ ℚ_sf(x̃_r̂)` and some `w`
in the subring `L_r[x_r]` generated by `L_r` and `x_r`. -/
@[cluster_algebras "lem_sharper_frozen_step"]
theorem IsLabeledSeed.exists_sub_eq_mul_of_frozen (hmn : n ≤ m) {S : SeedData F m n}
    (hS : IsLabeledSeed K hmn S) {r : Fin m} (hr : n ≤ (r : ℕ)) (s : List (Fin n))
    {i : Fin m} (hi : i ≠ r) :
    ∃ c ∈ laurentSubringExcept S.extCluster r,
      c ∈ universalSemifield (fun i : {i // i ≠ r} => S.extCluster i) ∧
      ∃ w ∈ Subring.closure (insert (S.extCluster r) (laurentSubringExcept S.extCluster r : Set F)),
        (ClusterAlgebras.seedMutationSeq hmn S s).extCluster i - c = S.extCluster r * w :=
  hS.exists_sub_eq_mul_of_frozen_of_laurent hmn hr
    (hS.seedMutationSeq_extCluster_mem_laurentSubring hmn) s hi

/-- **The sharp Laurent phenomenon along a sequence of mutations.** Let `(x̃, B̃)` be a labeled
seed in `F` over a field of characteristic zero, and let `s` be a finite sequence of
directions. Then every entry of the extended cluster of `μ_s(x̃, B̃)` lies in
`ℤ[x₁^{±1}, …, x_n^{±1}, x_{n+1}, …, x_m]`. -/
@[cluster_algebras "prop_laurent_sharper_sequences"]
theorem IsLabeledSeed.seedMutationSeq_extCluster_mem_mixedLaurentSubring (hmn : n ≤ m)
    {S : SeedData F m n} (hS : IsLabeledSeed K hmn S) (s : List (Fin n)) (i : Fin m) :
    (ClusterAlgebras.seedMutationSeq hmn S s).extCluster i ∈
      mixedLaurentSubring S.extCluster n := by
  haveI : CharZero F := Algebra.charZero_of_charZero K F
  exact mem_mixedLaurentSubring_of_forall_mem_closure_insert (hS.algebraicIndependent_rat hmn)
    (hS.seedMutationSeq_extCluster_mem_laurentSubring hmn s i) fun r hr =>
      hS.seedMutationSeq_extCluster_mem_closure_insert_of_laurent hmn hr
        (hS.seedMutationSeq_extCluster_mem_laurentSubring hmn) s i

/-- **The sharp Laurent phenomenon**, per cluster variable. In a seed pattern `Σ` of rank `n`
over a field of characteristic zero, the `i`-th cluster variable of `Σ(t)` lies in
`ℤ[x₁^{±1}, …, x_n^{±1}, x_{n+1}, …, x_m]`, where `(x₁, …, x_m)` is the extended cluster of
`Σ(t₀)`. -/
theorem IsSeedPattern.cluster_mem_mixedLaurentSubring (hmn : n ≤ m)
    {P : RegularTree n → SeedData F m n} (hP : IsSeedPattern K hmn P) (t₀ t : RegularTree n)
    (i : Fin n) :
    cluster hmn (P t) i ∈ mixedLaurentSubring (P t₀).extCluster n := by
  obtain ⟨s, hs⟩ := hP.exists_seedMutationSeq_eq hmn t₀ t
  rw [cluster, hs]
  exact (hP.1 t₀).seedMutationSeq_extCluster_mem_mixedLaurentSubring hmn s _

/-- **Frozen variables do not appear in denominators.** Let `Σ` be a seed pattern of rank `n`
in `F` over a field of characteristic zero, let `t₀, t` be vertices of `𝕋ₙ`, and let `Σ(t₀)`
have extended cluster `(x₁, …, x_m)`. Then every cluster variable of `Σ(t)` lies in
`ℤ[x₁^{±1}, …, x_n^{±1}, x_{n+1}, …, x_m]`. -/
@[cluster_algebras "thm_laurent_sharper"]
theorem IsSeedPattern.clusterVariables_subset_mixedLaurentSubring (hmn : n ≤ m)
    {P : RegularTree n → SeedData F m n} (hP : IsSeedPattern K hmn P) (t₀ t : RegularTree n) :
    clusterVariables hmn (P t) ⊆ mixedLaurentSubring (P t₀).extCluster n := by
  rintro _ ⟨i, rfl⟩
  exact hP.cluster_mem_mixedLaurentSubring hmn t₀ t i

end ClusterAlgebras
