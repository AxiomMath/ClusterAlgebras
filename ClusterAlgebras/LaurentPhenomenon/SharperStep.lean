/-!
# Cluster variables are polynomial in a frozen variable

Let `(x̃, B̃)` be a labeled seed in a field `F` over a field `𝕜` of characteristic zero, let `r`
be a frozen position, and write `L_r = ℤ[x̃_r̂^{±1}]` for the integer Laurent polynomials in the
entries other than `x_r`, and `L_r[x_r]` for the subring of `F` generated by `L_r` and `x_r`.
Say that `z ∈ L_r[x_r]` has *constant term* `c ∈ L_r` when `z - c ∈ x_r L_r[x_r]`. Since
`x_r L_r[x_r]` is an ideal of `L_r[x_r]`, constant terms add and multiply.

This file shows that, provided every entry of every extended cluster obtained from `(x̃, B̃)` by
mutations is an integer Laurent polynomial in `x̃` (the Laurent phenomenon), every entry in a
position `i ≠ r` of the extended cluster of `μ_s(x̃, B̃)` lies in `L_r[x_r]` and has a constant
term which lies in `L_r ∩ ℚ_sf(x̃_r̂)`. The proof is by induction on `s`. The frozen entry `x_r`
never changes, so the exchange monomial containing it has constant term `0` or in `ℚ_sf(x̃_r̂)`,
and the other one has constant term in `ℚ_sf(x̃_r̂)`; the exchange binomial `P = M⁺ + M⁻`
therefore has a constant term `a ∈ L_r ∩ ℚ_sf(x̃_r̂)`, and so does the old entry `x'`, say `b`.
The new entry `z` satisfies `P = x' z`. Through the isomorphism of `ℤ[x̃^{±1}]` with the Laurent
polynomials in one variable over `L_r`, sending the variable to `x_r`, this is an identity
`P = x' z` with `P`, `x'` polynomials and `x'` of nonzero constant term `b`, since `0 ∉ ℚ_sf`;
so `z` is a polynomial whose constant term `c` satisfies `b c = a`, and `c = a / b` lies in
`ℚ_sf(x̃_r̂)`.

## Main results

* `ClusterAlgebras.IsLabeledSeed.exists_sub_eq_mul_of_frozen_of_laurent`: given the Laurent
  phenomenon, `z - c = x_r w` with `c ∈ L_r ∩ ℚ_sf(x̃_r̂)` and `w ∈ L_r[x_r]`.
* `ClusterAlgebras.IsLabeledSeed.seedMutationSeq_extCluster_mem_closure_insert_of_laurent`:
  given the Laurent phenomenon, every entry of the extended cluster of `μ_s(x̃, B̃)` lies in
  `L_r[x_r]`.

Along the way:

* `ClusterAlgebras.seedMutationSeq_extCluster_of_le`: mutation does not change a frozen entry.
* `ClusterAlgebras.exists_sub_eq_mul_add`, `ClusterAlgebras.exists_sub_eq_mul_mul`,
  `ClusterAlgebras.exists_prod_pow_sub_eq_mul`: constant terms add and multiply.
* `ClusterAlgebras.closure_insert_laurentSubringExcept_eq_range`: `L_r[x_r]` is the image of
  the polynomials over `L_r` under evaluation at `x_r`.
* `ClusterAlgebras.exists_mul_eq_of_mul_eq`: in `ℤ[x̃^{±1}]`, if `P = x' z` with `P`, `x'` in
  `L_r[x_r]` of constant terms `a`, `b` and `b ≠ 0`, then `z ∈ L_r[x_r]` has a constant term `c`
  with `b c = a`.

## Implementation notes

FWZ index the frozen positions by `[n + 1, m]`; here the extended cluster is indexed by
`Fin m`, whose positions are `0, …, m - 1`, so the frozen positions are the `r` with `n ≤ r`.
FWZ's proof invokes the Laurent phenomenon along sequences for `(x̃, B̃)` itself; here it
is the hypothesis `hL`, so that the lemma does not depend on the file proving the Laurent
phenomenon. The membership in `L_r[x_r]` holds in every position, including `r`, where the
entry is `x_r`, so the corollary is stated for every position.

## References

* [FWZ] S. Fomin, L. Williams, A. Zelevinsky, *Introduction to Cluster Algebras*, Chapter 3.
-/

@[expose] public section

namespace ClusterAlgebras

open Polynomial

variable {F : Type*} [Field F]

/-! ### Constant terms -/

section ConstantTerm

variable {L : Subring F} {x z z' c c' : F}

/-- An element with a constant term lies in the subring generated by `L` and `x`. -/
theorem mem_closure_insert_of_sub_eq_mul (hc : c ∈ L)
    (h : ∃ w ∈ Subring.closure (insert x (L : Set F)), z - c = x * w) :
    z ∈ Subring.closure (insert x (L : Set F)) := by
  obtain ⟨w, hw, h⟩ := h
  rw [sub_eq_iff_eq_add'.1 h]
  exact add_mem (Subring.subset_closure (Set.mem_insert_of_mem _ hc))
    (mul_mem (Subring.subset_closure (Set.mem_insert _ _)) hw)

/-- **Constant terms add.** -/
theorem exists_sub_eq_mul_add
    (h : ∃ w ∈ Subring.closure (insert x (L : Set F)), z - c = x * w)
    (h' : ∃ w ∈ Subring.closure (insert x (L : Set F)), z' - c' = x * w) :
    ∃ w ∈ Subring.closure (insert x (L : Set F)), z + z' - (c + c') = x * w := by
  obtain ⟨w, hw, h⟩ := h
  obtain ⟨w', hw', h'⟩ := h'
  exact ⟨w + w', add_mem hw hw', by linear_combination h + h'⟩

/-- **Constant terms multiply.** -/
theorem exists_sub_eq_mul_mul (hc : c ∈ L) (hc' : c' ∈ L)
    (h : ∃ w ∈ Subring.closure (insert x (L : Set F)), z - c = x * w)
    (h' : ∃ w ∈ Subring.closure (insert x (L : Set F)), z' - c' = x * w) :
    ∃ w ∈ Subring.closure (insert x (L : Set F)), z * z' - c * c' = x * w := by
  have hz' := mem_closure_insert_of_sub_eq_mul hc' h'
  obtain ⟨w, hw, h⟩ := h
  obtain ⟨w', hw', h'⟩ := h'
  refine ⟨w * z' + c * w', add_mem (mul_mem hw hz')
    (mul_mem (Subring.subset_closure (Set.mem_insert_of_mem _ hc)) hw'), ?_⟩
  linear_combination z' * h + c * h'

/-- **Constant terms of powers.** -/
theorem exists_pow_sub_eq_mul (hc : c ∈ L)
    (h : ∃ w ∈ Subring.closure (insert x (L : Set F)), z - c = x * w) (e : ℕ) :
    ∃ w ∈ Subring.closure (insert x (L : Set F)), z ^ e - c ^ e = x * w := by
  induction e with
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | succ e ih =>
    simpa only [pow_succ] using exists_sub_eq_mul_mul (pow_mem hc e) hc ih h

/-- **Constant terms of products of powers.** -/
theorem exists_prod_pow_sub_eq_mul {α : Type*} (s : Finset α) {f g : α → F} (e : α → ℕ)
    (hg : ∀ i ∈ s, g i ∈ L)
    (h : ∀ i ∈ s, ∃ w ∈ Subring.closure (insert x (L : Set F)), f i - g i = x * w) :
    ∃ w ∈ Subring.closure (insert x (L : Set F)),
      ∏ i ∈ s, f i ^ e i - ∏ i ∈ s, g i ^ e i = x * w := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, zero_mem _, by simp⟩
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    exact exists_sub_eq_mul_mul (pow_mem (hg a (Finset.mem_insert_self a s)) _)
      (prod_mem fun i hi => pow_mem (hg i (Finset.mem_insert_of_mem hi)) _)
      (exists_pow_sub_eq_mul (hg a (Finset.mem_insert_self a s))
        (h a (Finset.mem_insert_self a s)) _)
      (ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))
        fun i hi => h i (Finset.mem_insert_of_mem hi))

end ConstantTerm

/-! ### Polynomials in one variable over `L_r` -/

section Polynomiality

variable {ι : Type*} {y : ι → F} {r : ι}

/-- The subring `L_r[y_r]` generated by `L_r = ℤ[ỹ_r̂^{±1}]` and `y_r` is the image of the
polynomials over `L_r` under evaluation at `y_r`. -/
theorem closure_insert_laurentSubringExcept_eq_range (y : ι → F) (r : ι) :
    Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)) =
      (aeval (R := laurentSubringExcept y r) (y r)).range.toSubring := by
  refine le_antisymm (Subring.closure_le.2 (Set.insert_subset ⟨X, aeval_X _⟩
    fun a ha => ⟨C ⟨a, ha⟩, aeval_C _ _⟩)) ?_
  rintro _ ⟨P, rfl⟩
  change aeval (y r) P ∈ _
  rw [aeval_eq_sum_range]
  refine sum_mem fun e _ => ?_
  rw [Subring.smul_def, smul_eq_mul]
  exact mul_mem (Subring.subset_closure (Set.mem_insert_of_mem _ (P.coeff e).2))
    (pow_mem (Subring.subset_closure (Set.mem_insert _ _)) e)

/-- The value at `y_r` of a polynomial over `L_r` lies in `L_r[y_r]`. -/
theorem aeval_mem_closure_insert_laurentSubringExcept (P : (laurentSubringExcept y r)[X]) :
    aeval (y r) P ∈ Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)) := by
  rw [closure_insert_laurentSubringExcept_eq_range]
  exact ⟨P, rfl⟩

/-- An element of `L_r[y_r]` of constant term `a` is the value at `y_r` of a polynomial over
`L_r` whose constant coefficient is `a`. -/
theorem exists_aeval_eq_of_sub_eq_mul {z a : F} (ha : a ∈ laurentSubringExcept y r)
    (h : ∃ w ∈ Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)),
      z - a = y r * w) :
    ∃ P : (laurentSubringExcept y r)[X], aeval (y r) P = z ∧ (P.coeff 0 : F) = a := by
  obtain ⟨w, hw, h⟩ := h
  rw [closure_insert_laurentSubringExcept_eq_range] at hw
  obtain ⟨W, rfl⟩ := hw
  change z - a = y r * aeval (y r) W at h
  refine ⟨C ⟨a, ha⟩ + X * W, ?_, by simp⟩
  have hC : algebraMap (laurentSubringExcept y r) F ⟨a, ha⟩ = a := rfl
  simp only [map_add, aeval_C, map_mul, aeval_X, hC]
  linear_combination -h

/-- **Polynomiality of a quotient.** Let `ỹ` be algebraically independent over `ℚ`, and let
`P`, `x'` be elements of `L_r[y_r]` with constant terms `a` and `b ≠ 0`. If `P = x' z` for an
integer Laurent polynomial `z` in `ỹ`, then `z ∈ L_r[y_r]`, with a constant term `c` satisfying
`b c = a`. -/
theorem exists_mul_eq_of_mul_eq [CharZero F] (hy : AlgebraicIndependent ℚ y) {P x' z a b : F}
    (ha : a ∈ laurentSubringExcept y r) (hb : b ∈ laurentSubringExcept y r) (hb0 : b ≠ 0)
    (hP : ∃ w ∈ Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)),
      P - a = y r * w)
    (hx' : ∃ w ∈ Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)),
      x' - b = y r * w)
    (hz : z ∈ laurentSubring y) (h : P = x' * z) :
    ∃ c ∈ laurentSubringExcept y r, b * c = a ∧
      ∃ w ∈ Subring.closure (insert (y r) (laurentSubringExcept y r : Set F)),
        z - c = y r * w := by
  obtain ⟨PP, hPP, hPP0⟩ := exists_aeval_eq_of_sub_eq_mul ha hP
  obtain ⟨XX, hXX, hXX0⟩ := exists_aeval_eq_of_sub_eq_mul hb hx'
  set E := laurentEquivOfExcept hy r
  have hXX0' : XX.coeff 0 ≠ 0 := fun h0 => hb0 (by rw [← hXX0, h0, ZeroMemClass.coe_zero])
  have hEz : (E (E.symm ⟨z, hz⟩) : F) = z := by rw [RingEquiv.apply_symm_apply]
  have hmul : PP.toLaurent = XX.toLaurent * E.symm ⟨z, hz⟩ := by
    refine E.injective (Subtype.ext ?_)
    rw [map_mul, Subring.coe_mul, coe_laurentEquivOfExcept_toLaurent,
      coe_laurentEquivOfExcept_toLaurent, hEz, hPP, hXX, h]
  obtain ⟨p, hp, hp0⟩ := exists_eq_toLaurent_of_eq_mul hXX0' hmul
  have hzp : z = aeval (y r) p := by
    rw [← hEz, hp, coe_laurentEquivOfExcept_toLaurent]
  refine ⟨p.coeff 0, (p.coeff 0).2, ?_, aeval (y r) p.divX,
    aeval_mem_closure_insert_laurentSubringExcept _, ?_⟩
  · rw [← hXX0, ← hPP0, ← hp0, Subring.coe_mul]
  · have hp' := congrArg (aeval (y r)) (X_mul_divX_add p)
    have hC : algebraMap (laurentSubringExcept y r) F (p.coeff 0) = p.coeff 0 := rfl
    simp only [map_add, map_mul, aeval_X, aeval_C, hC] at hp'
    rw [hzp]
    linear_combination -hp'

end Polynomiality

/-! ### The frozen entries do not change -/

section Frozen

variable {m n : ℕ}

/-- **Mutation along a sequence does not change a frozen entry** of the extended cluster: it
only replaces entries in the first `n` positions. -/
theorem seedMutationSeq_extCluster_of_le (hmn : n ≤ m) (S : SeedData F m n) (s : List (Fin n))
    {r : Fin m} (hr : n ≤ (r : ℕ)) :
    (seedMutationSeq hmn S s).extCluster r = S.extCluster r := by
  induction s generalizing S with
  | nil => rfl
  | cons k s ih =>
    rw [seedMutationSeq_cons, ih, seedMutation_extCluster_of_ne hmn S]
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_castLE] at this
    omega

end Frozen

/-! ### Constant terms of cluster variables in a frozen variable -/

section Sharper

variable {K : Type*} [Field K] [Algebra K F] {m n : ℕ}

/-- The sum of an element of `ℚ_sf(y)` and an element of `ℚ_sf(y)` or `0` lies in
`ℚ_sf(y)`. -/
private theorem add_mem_universalSemifield_of_or {κ : Type*} {y : κ → F} {u v : F}
    (hu : u ∈ universalSemifield y ∨ u = 0) (hv : v ∈ universalSemifield y) :
    u + v ∈ universalSemifield y := by
  rcases hu with hu | rfl
  · exact add_mem_universalSemifield hu hv
  · rwa [zero_add]

/-- A product `∏ⱼ cⱼ ^ eⱼ` lies in `ℚ_sf(y)` or vanishes, when `c_r = 0` and every other `cⱼ`
lies in `ℚ_sf(y)`; it lies in `ℚ_sf(y)` when moreover `e_r = 0`. -/
private theorem prod_pow_mem_universalSemifield {κ : Type*} {y : κ → F} {c : Fin m → F}
    {r : Fin m} (hc0 : c r = 0) (hcQ : ∀ j, j ≠ r → c j ∈ universalSemifield y)
    (e : Fin m → ℕ) :
    (e r = 0 → ∏ j, c j ^ e j ∈ universalSemifield y) ∧
      (∏ j, c j ^ e j ∈ universalSemifield y ∨ ∏ j, c j ^ e j = 0) := by
  have h : e r = 0 → ∏ j, c j ^ e j ∈ universalSemifield y := fun he =>
    prod_mem_universalSemifield fun j _ => by
      rcases eq_or_ne j r with rfl | hj
      · rw [he, pow_zero]
        exact one_mem_universalSemifield
      · exact pow_mem_universalSemifield (hcQ j hj) _
  refine ⟨h, ?_⟩
  rcases eq_or_ne (e r) 0 with he | he
  · exact Or.inl (h he)
  · exact Or.inr (Finset.prod_eq_zero (Finset.mem_univ r) (by rw [hc0, zero_pow he]))

/-- **Cluster variables have a subtraction-free constant term in a frozen variable**, given
the Laurent phenomenon. Let `(x̃, B̃)` be a labeled seed, `r` a frozen position,
`L_r = ℤ[x̃_r̂^{±1}]`, and suppose every entry of every extended cluster `μ_s(x̃, B̃)` lies in
`ℤ[x̃^{±1}]`. Then for every sequence `s` and every position `i ≠ r`, the entry `z` in position
`i` of `μ_s(x̃, B̃)` satisfies `z - c = x_r w` for some `c ∈ L_r ∩ ℚ_sf(x̃_r̂)` and some `w` in
the subring `L_r[x_r]` generated by `L_r` and `x_r`. -/
theorem IsLabeledSeed.exists_sub_eq_mul_of_frozen_of_laurent [CharZero K] (hmn : n ≤ m)
    {S : SeedData F m n} (hS : IsLabeledSeed K hmn S) {r : Fin m} (hr : n ≤ (r : ℕ))
    (hL : ∀ (s : List (Fin n)) (i : Fin m),
      (ClusterAlgebras.seedMutationSeq hmn S s).extCluster i ∈ laurentSubring S.extCluster)
    (s : List (Fin n)) {i : Fin m} (hi : i ≠ r) :
    ∃ c ∈ laurentSubringExcept S.extCluster r,
      c ∈ universalSemifield (fun i : {i // i ≠ r} => S.extCluster i) ∧
      ∃ w ∈ Subring.closure (insert (S.extCluster r) (laurentSubringExcept S.extCluster r : Set F)),
        (ClusterAlgebras.seedMutationSeq hmn S s).extCluster i - c = S.extCluster r * w := by
  haveI : CharZero F := Algebra.charZero_of_charZero K F
  have hy := hS.algebraicIndependent_rat hmn
  have hQ0 : (0 : F) ∉ universalSemifield (fun i : {i // i ≠ r} => S.extCluster i) :=
    zero_notMem_universalSemifield (algebraicIndependent_except hy r)
  induction s using List.reverseRecOn generalizing i with
  | nil =>
    exact ⟨S.extCluster i, mem_laurentSubringExcept _ hi,
      mem_universalSemifield_self (fun j : {j // j ≠ r} => S.extCluster j) ⟨i, hi⟩, 0,
      zero_mem _, by simp⟩
  | append_singleton s k ih =>
    have hLk := hL (s ++ [k]) i
    rw [seedMutationSeq_append, seedMutationSeq_cons, seedMutationSeq_nil] at hLk ⊢
    set T := ClusterAlgebras.seedMutationSeq hmn S s with hT
    rcases eq_or_ne i (Fin.castLE hmn k) with rfl | hik
    swap
    · rw [seedMutation_extCluster_of_ne hmn T hik]
      exact ih hi
    -- constant terms of all entries of `T`, with `0` in position `r`
    have ih' : ∀ j, ∃ c ∈ laurentSubringExcept S.extCluster r,
        (j ≠ r → c ∈ universalSemifield (fun i : {i // i ≠ r} => S.extCluster i)) ∧
        (j = r → c = 0) ∧
        ∃ w ∈ Subring.closure
          (insert (S.extCluster r) (laurentSubringExcept S.extCluster r : Set F)),
          T.extCluster j - c = S.extCluster r * w := by
      intro j
      rcases eq_or_ne j r with rfl | hj
      · refine ⟨0, zero_mem _, fun h => absurd rfl h, fun _ => rfl, 1, one_mem _, ?_⟩
        rw [hT, seedMutationSeq_extCluster_of_le hmn S s hr]
        ring
      · obtain ⟨c, hcL, hcQ, hc⟩ := ih hj
        exact ⟨c, hcL, fun _ => hcQ, fun h => absurd h hj, hc⟩
    choose c hcL hcQ hc0 hc using ih'
    set B := T.extExchangeMatrix
    have hrk : r ≠ Fin.castLE hmn k := fun h => by
      have := congrArg Fin.val h
      simp only [Fin.val_castLE] at this
      omega
    -- the constant term `a` of the exchange binomial
    set a := ∏ j, c j ^ (B j k).toNat + ∏ j, c j ^ (-B j k).toNat with ha
    have haL : a ∈ laurentSubringExcept S.extCluster r :=
      add_mem (prod_mem fun j _ => pow_mem (hcL j) _) (prod_mem fun j _ => pow_mem (hcL j) _)
    have haQ : a ∈ universalSemifield (fun i : {i // i ≠ r} => S.extCluster i) := by
      have hpos := prod_pow_mem_universalSemifield (hc0 r rfl) hcQ fun j => (B j k).toNat
      have hneg := prod_pow_mem_universalSemifield (hc0 r rfl) hcQ fun j => (-B j k).toNat
      rcases le_total (B r k) 0 with h | h
      · rw [ha, add_comm]
        exact add_mem_universalSemifield_of_or hneg.2 (hpos.1 (Int.toNat_eq_zero.2 h))
      · exact add_mem_universalSemifield_of_or hpos.2
          (hneg.1 (Int.toNat_eq_zero.2 (by omega)))
    have hP : ∃ w ∈ Subring.closure
        (insert (S.extCluster r) (laurentSubringExcept S.extCluster r : Set F)),
        exchangeMonomialPos T.extCluster B k + exchangeMonomialNeg T.extCluster B k - a =
          S.extCluster r * w := by
      rw [exchangeMonomialPos_eq_prod, exchangeMonomialNeg_eq_prod]
      exact exists_sub_eq_mul_add
        (exists_prod_pow_sub_eq_mul _ _ (fun j _ => hcL j) fun j _ => hc j)
        (exists_prod_pow_sub_eq_mul _ _ (fun j _ => hcL j) fun j _ => hc j)
    -- the constant term `b` of the old entry
    have hbQ := hcQ (Fin.castLE hmn k) hrk.symm
    have hb0 : c (Fin.castLE hmn k) ≠ 0 := fun h => hQ0 (h ▸ hbQ)
    have hx0 : T.extCluster (Fin.castLE hmn k) ≠ 0 :=
      hS.seedMutationSeq_extCluster_ne_zero hmn s _
    rw [seedMutation_extCluster_castLE_self] at hLk ⊢
    obtain ⟨c', hc'L, hbc, hc'⟩ := exists_mul_eq_of_mul_eq hy haL (hcL _) hb0 hP (hc _) hLk
      (mul_div_cancel₀ _ hx0).symm
    refine ⟨c', hc'L, ?_, hc'⟩
    have hc' : c' = a / c (Fin.castLE hmn k) :=
      eq_div_of_mul_eq hb0 (by rw [mul_comm]; exact hbc)
    rw [hc']
    exact div_mem_universalSemifield haQ hbQ

/-- **Cluster variables are polynomial in a frozen variable**, given the Laurent phenomenon.
Let `(x̃, B̃)` be a labeled seed, `r` a frozen position, and suppose every entry of every
extended cluster `μ_s(x̃, B̃)` lies in `ℤ[x̃^{±1}]`. Then every entry of the extended cluster of
`μ_s(x̃, B̃)` lies in the subring generated by `ℤ[x̃_r̂^{±1}]` and `x_r`. -/
theorem IsLabeledSeed.seedMutationSeq_extCluster_mem_closure_insert_of_laurent [CharZero K]
    (hmn : n ≤ m) {S : SeedData F m n} (hS : IsLabeledSeed K hmn S) {r : Fin m}
    (hr : n ≤ (r : ℕ))
    (hL : ∀ (s : List (Fin n)) (i : Fin m),
      (ClusterAlgebras.seedMutationSeq hmn S s).extCluster i ∈ laurentSubring S.extCluster)
    (s : List (Fin n)) (i : Fin m) :
    (ClusterAlgebras.seedMutationSeq hmn S s).extCluster i ∈
      Subring.closure (insert (S.extCluster r) (laurentSubringExcept S.extCluster r : Set F)) := by
  rcases eq_or_ne i r with rfl | hi
  · rw [seedMutationSeq_extCluster_of_le hmn S s hr]
    exact Subring.subset_closure (Set.mem_insert _ _)
  · obtain ⟨c, hcL, -, hc⟩ := hS.exists_sub_eq_mul_of_frozen_of_laurent hmn hr hL s hi
    exact mem_closure_insert_of_sub_eq_mul hcL hc

end Sharper

end ClusterAlgebras
